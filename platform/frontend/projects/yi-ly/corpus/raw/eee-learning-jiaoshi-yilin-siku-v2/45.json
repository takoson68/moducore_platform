  "entryCount": 64,
  "missingTargets": [],
  "entries": [
    {
      "baseHexagramNumber": 45,
      "changedHexagramNumber": 45,
      "sourceEntryNumber": 45,
      "sourceIconHexagramNumber": 45,
      "hexagramName": "萃",
      "poemText": "蒙慶受福，有所獲得。不利出城，疾人困極。",
      "sourceParagraphSha256": "sha256:9c0bcbb267186d50cd9d8fdb2d2dfe136ca472e023b2b9295ace4b8bb8f4b709",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:d5171e24018d3f3d3dfda9ab160d3f53832bfe8f8af2c317c0c18a706caea3c7"
    },
    {
      "baseHexagramNumber": 45,
      "changedHexagramNumber": 1,
      "sourceEntryNumber": 1,
      "sourceIconHexagramNumber": 1,
      "hexagramName": "乾",
      "poemText": "碩鼠四足，飛不上屋。顏氏淵德，未有爵祿。",
      "sourceParagraphSha256": "sha256:754d8c0ff4c8ec9b2898123cd2177f0c9298d9983319862acb35775bdfcbf871",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:b066e1edfc1efb5cc277caf18356648f0a02296d5dd9ca22672b1d0b69087f8c"
    },
    {
      "baseHexagramNumber": 45,
      "changedHexagramNumber": 2,
      "sourceEntryNumber": 2,
      "sourceIconHexagramNumber": 2,
      "hexagramName": "坤",
      "poemText": "新受大喜，福優重職，樂且日富。",
      "sourceParagraphSha256": "sha256:2400e5e10cc756a770dc28706a07b8ceeb1333664df6b75e44061de94229f3bc",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:694a18b54b5872b2823dbfc215fbaed05df850424160294879370b451903a401"
    },
    {
      "baseHexagramNumber": 45,
      "changedHexagramNumber": 3,
      "sourceEntryNumber": 3,
      "sourceIconHexagramNumber": 3,
      "hexagramName": "屯",
      "poemText": "克身潔己，逢禹巡狩。錫我元圭，拜受福祉。",
      "sourceParagraphSha256": "sha256:293b2cc728039347f7667de77244bc989d6a82541c339dba560fb81d88d2e0d1",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:255a22365c7f9a44e3382ffbd44d89fb51ff4d0cdd84489ab5e306b0c2a441e9"
    },
    {
      "baseHexagramNumber": 45,
      "changedHexagramNumber": 4,
      "sourceEntryNumber": 4,
      "sourceIconHexagramNumber": 4,
      "hexagramName": "蒙",
      "poemText": "置筐失筥，輪破無輔。家伯為政，病我下土。",
      "sourceParagraphSha256": "sha256:8e041504c0a9a48ba9b6167bee4b79e41739287d8e2ac5fb8b0114ddf87901bc",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:f21c02d63a1c80d5a307a1cc19443041febfaf468081ea8f75305a2554c90904"
    },
    {
      "baseHexagramNumber": 45,
      "changedHexagramNumber": 5,
      "sourceEntryNumber": 5,
      "sourceIconHexagramNumber": 5,
      "hexagramName": "需",
      "poemText": "機言不發，頑不能達。齊魯為仇，亡我葵丘。",
      "sourceParagraphSha256": "sha256:26ed4d041567c1e68dd012a829a6e8ee9ee2b800903b5359b6c667ef7525e891",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:02ec70bf4e4b057353989d6615c68e1e7217af963b36fdb7bf8e7de7515d1eae"
    },
    {
      "baseHexagramNumber": 45,
      "changedHexagramNumber": 6,
      "sourceEntryNumber": 6,
      "sourceIconHexagramNumber": 6,
      "hexagramName": "訟",
      "poemText": "亡錐失斧，公輸無輔。抱其彝器，適君子處。",
      "sourceParagraphSha256": "sha256:adb787fd8f0f24cf32ec8a5f0610d795dae251db03fddd0f9e0b99f9d8312393",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:9a5bed8dbb45e81dfa2bb2ada66581d90bb06b7b71b9e78acb6d2163b582fa18"
    },
    {
      "baseHexagramNumber": 45,
      "changedHexagramNumber": 7,
      "sourceEntryNumber": 7,
      "sourceIconHexagramNumber": 7,
      "hexagramName": "師",
      "poemText": "家在海隅，橈短深流。伯氏難行，無木以超。",
      "sourceParagraphSha256": "sha256:c98a274831afa3be693a473172fff8c5548bec3b3cbd04d4c49dc19380eff099",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:7c85d3db4c3475ca2d5aaf076218a27b29cbe34d7209e1e74c81b71e7032c288"
    },
    {
      "baseHexagramNumber": 45,
      "changedHexagramNumber": 8,
      "sourceEntryNumber": 8,
      "sourceIconHexagramNumber": 8,
      "hexagramName": "比",
      "poemText": "德施流行，利之四鄉。雨師灑道，風伯逐殃。巡狩封禪，以告成功。",
      "sourceParagraphSha256": "sha256:9d88baf5fe12bffef8a14a9bb031a05d681a57b919a82cef7ab86f712d2e41c7",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:b220806cfee504b64803dbaa11768af4d643c83430004e0b408e26ece5d6cc18"
    },
    {
      "baseHexagramNumber": 45,
      "changedHexagramNumber": 9,
      "sourceEntryNumber": 9,
      "sourceIconHexagramNumber": 9,
      "hexagramName": "小畜",
      "poemText": "筐傾筥覆，畏我公置。簡伯無禮，太師正食。",
      "sourceParagraphSha256": "sha256:058b83a8345bdc2b633fc37fe776edcc0571d7da16b416aafa095c49a7cf747a",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:8b8f392c435e2fd2057d2c085458d68e461151aed459f34a4d68b057ca91482d"
    },
    {
      "baseHexagramNumber": 45,
      "changedHexagramNumber": 10,
      "sourceEntryNumber": 10,
      "sourceIconHexagramNumber": 10,
      "hexagramName": "履",
      "poemText": "泥滓污辱，棄捐溝瀆。為眾所笑，終不顯祿。",
      "sourceParagraphSha256": "sha256:7e154bd7af7567ce9034948134c5d7feaed8df6a7d8f41ac57896b4e7efe2812",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:dbd1c39a54b45d11bd901ed854730645bf7e4e0ae212a1f5c92ea3186c485b40"
    },
    {
      "baseHexagramNumber": 45,
      "changedHexagramNumber": 11,
      "sourceEntryNumber": 11,
      "sourceIconHexagramNumber": 11,
      "hexagramName": "泰",
      "poemText": "獮猴兔走，腥臊少肉。漏卮盛酒，利無所有。",
      "sourceParagraphSha256": "sha256:0806ef2b54b1bbaa880b1a09ef0d275a914980e14c326047fc9c66afeabb2f96",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:4fd992ba08ca2113480546105a96fb56cd9115da39fad6cb626a9fc1041dd374"
    },
    {
      "baseHexagramNumber": 45,
      "changedHexagramNumber": 12,
      "sourceEntryNumber": 12,
      "sourceIconHexagramNumber": 12,
      "hexagramName": "否",
      "poemText": "鹿畏人藏，俱入深谷。命短不長，為虎所得。死於牙腹。",
      "sourceParagraphSha256": "sha256:ba4daa01c0e26e272e961f18a6c494a8d94a342a1fb3da44b83670eb6a725bcf",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:565864b8e25766a0346b752cc5de5b7e8bc3c3b3c88d26a8abb6ab776264f552"
    },
    {
      "baseHexagramNumber": 45,
      "changedHexagramNumber": 13,
      "sourceEntryNumber": 13,
      "sourceIconHexagramNumber": 13,
      "hexagramName": "同人",
      "poemText": "南山芝蘭，君子所有。東家淑女，生我王室。",
      "sourceParagraphSha256": "sha256:7310ef845e0f37ef7cacf4b26a7dda213874e1a0d3c3fef672571c71d6df5758",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:4bf293130b8c46517ead400ab2065f515ba6ffc2ab3d6a68073a73edac309f84"
    },
    {
      "baseHexagramNumber": 45,
      "changedHexagramNumber": 14,
      "sourceEntryNumber": 14,
      "sourceIconHexagramNumber": 14,
      "hexagramName": "大有",
      "poemText": "左指右揮，邪望侈靡。執節無良，靈君以亡。",
      "sourceParagraphSha256": "sha256:3502a2498ba9e04adc0e0b552c3e247327bb567ad7ade8ce259c832ac8a6485c",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:0156a5c1edbf70d0d154c6c3cc7c698366526c1758e22d2988e5cc25819b578a"
    },
    {
      "baseHexagramNumber": 45,
      "changedHexagramNumber": 15,
      "sourceEntryNumber": 15,
      "sourceIconHexagramNumber": 15,
      "hexagramName": "謙",
      "poemText": "爵秩不明，為臣所傷。眾陰群聚，共奪日光。",
      "sourceParagraphSha256": "sha256:cc939d8dfab3a453bf60ed379bb973442625681193f74c85c9bfa284a7a1aa42",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:fc4194d771e5b6f6bc712e83132cef04cfecf6a0ee93f17dec07ea660211882e"
    },
    {
      "baseHexagramNumber": 45,
      "changedHexagramNumber": 16,
      "sourceEntryNumber": 16,
      "sourceIconHexagramNumber": 16,
      "hexagramName": "豫",
      "poemText": "穿鼻繫株，為虎所拘。王母祝禱，禍不成災。突然自來。",
      "sourceParagraphSha256": "sha256:145a8b3ec6c9813861871e2b191f25b3cf889145f73055e9f59313acea0d62ce",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:8b469e40b137d762195aa1645c08fafa78138a94f9c0f91d9925b13c725edb32"
    },
    {
      "baseHexagramNumber": 45,
      "changedHexagramNumber": 17,
      "sourceEntryNumber": 17,
      "sourceIconHexagramNumber": 17,
      "hexagramName": "隨",
      "poemText": "貧鬼守門，日破我盆。毀鼠傷綬，空虛無子。",
      "sourceParagraphSha256": "sha256:a9a5fdee8bed6b8c53a2b78d5b44866333af64529a9151f77334ffa02fe889eb",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:28acf5c5f117be93fb4d8878eea3be902dd5c45be39294d96622e463b6dbcaf1"
    },
    {
      "baseHexagramNumber": 45,
      "changedHexagramNumber": 18,
      "sourceEntryNumber": 18,
      "sourceIconHexagramNumber": 18,
      "hexagramName": "蠱",
      "poemText": "襄王束帶，鄭人是賴。莊公卿士，王母憂喜。",
      "sourceParagraphSha256": "sha256:09906b4c4608c5c61e9aba5bbbd8956ac52ca3d0af164e4093cac1a0837f919b",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:db851a0ee2b61bd5b568ab727a667296a4ec681d478ab2e87caaba5ba36ace11"
    },
    {
      "baseHexagramNumber": 45,
      "changedHexagramNumber": 19,
      "sourceEntryNumber": 19,
      "sourceIconHexagramNumber": 19,
      "hexagramName": "臨",
      "poemText": "昭君守國，諸夏蒙德。異類既同，崇我王室。",
      "sourceParagraphSha256": "sha256:852c1e1e9e8dbbfa7e31ca92ab577619cdbcbc1847536637e4f4cdf4fa9244df",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:a73f194ef270fca700b1a4a76ab21fca32efee2418e88988520fe2205c59f008"
    },
    {
      "baseHexagramNumber": 45,
      "changedHexagramNumber": 20,
      "sourceEntryNumber": 20,
      "sourceIconHexagramNumber": 20,
      "hexagramName": "觀",
      "poemText": "冬藪朽腐，當風於道。蒙被塵埃，左右勞苦。",
      "sourceParagraphSha256": "sha256:c403bc734f4e54e5e059ae5745b61b9151797e9b3a9a116d15f0bb8cb1f8a99e",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:9c5ac4572386c3a459c597ab7719fc5b00e8c5710a6071905493d841e1b35760"
    },
    {
      "baseHexagramNumber": 45,
      "changedHexagramNumber": 21,
      "sourceEntryNumber": 21,
      "sourceIconHexagramNumber": 21,
      "hexagramName": "噬嗑",
      "poemText": "六爻既立，神明所告。文定吉祥，康叔受福。",
      "sourceParagraphSha256": "sha256:47f5cc2cf7a252d44f9f59f63273a0d82a7c86e559bbd612fe8e9126e47516c7",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:6b05370bf0de5b020710028efd96730cef6e9a877c6102658e1fc2f4ce0796cf"
    },
    {
      "baseHexagramNumber": 45,
      "changedHexagramNumber": 22,
      "sourceEntryNumber": 22,
      "sourceIconHexagramNumber": 22,
      "hexagramName": "賁",
      "poemText": "泣涕長訣，我心不悅。遠送衛野，歸寧無咎。",
      "sourceParagraphSha256": "sha256:dfe57799c1c7bf0673b34ac9c9e3fba8edb9fa24af24b6a807f970b340d39893",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:bfcd5941e42f39e0ab292562aaf8935987f13736956e32d8b61bc97002f931d0"
    },
    {
      "baseHexagramNumber": 45,
      "changedHexagramNumber": 23,
      "sourceEntryNumber": 23,
      "sourceIconHexagramNumber": 23,
      "hexagramName": "剝",
      "poemText": "三宿無主，南行勞苦。東里失利，喪其珍寶。本卦遯同）",
      "sourceParagraphSha256": "sha256:8ba42dcf6d1e1d414839b15c7a9cdee6c9a6b32ad320b017596595ea707c0ec0",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:7863c3e82d9881a3ddd01d1305507fb790527ea16656e850852a9a09cecd395f"
    },
    {
      "baseHexagramNumber": 45,
      "changedHexagramNumber": 24,
      "sourceEntryNumber": 24,
      "sourceIconHexagramNumber": 24,
      "hexagramName": "復",
      "poemText": "大斧砍木，讒佞敗國。東關良工，禍及三子。晉人亂邑，懷公出走。",
      "sourceParagraphSha256": "sha256:02e99208fc1b0f978b629daee5d66d458abcd2c4c5fd3eade69847c4089c70fc",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:eb9b9773f2fd90466cd20550e8fcf5b873f8ec4b1a5e807f33cdccfa95fd60f8"
    },
    {
      "baseHexagramNumber": 45,
      "changedHexagramNumber": 25,
      "sourceEntryNumber": 25,
      "sourceIconHexagramNumber": 25,
      "hexagramName": "无妄",
      "poemText": "乘風上天，為時服軒。周旋萬里，無有患難。",
      "sourceParagraphSha256": "sha256:170ae94143c14262e12a6fd9d56d8b5be4c8d6b3baaedad3fa3fbda058523ce1",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:147c27933de41cd3ac70817a7d90adff516f889b1025addd29e28735f84b008b"
    },
    {
      "baseHexagramNumber": 45,
      "changedHexagramNumber": 26,
      "sourceEntryNumber": 26,
      "sourceIconHexagramNumber": 26,
      "hexagramName": "大畜",
      "poemText": "大樹百根，比與山連。文君作義，受福萬年。",
      "sourceParagraphSha256": "sha256:1e990294aa0f7132b5996847c929901468dc0080ef16cbb76df805fe409df79e",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:110b302da9d000c95f3f977cc4dd1f9d08171fff8d85e3a50f6ef69644635a5c"
    },
    {
      "baseHexagramNumber": 45,
      "changedHexagramNumber": 27,
      "sourceEntryNumber": 27,
      "sourceIconHexagramNumber": 27,
      "hexagramName": "頤",
      "poemText": "陽伏在下，陰制祐福。生不逢時，潛龍隱處。",
      "sourceParagraphSha256": "sha256:1ff214c7b569335df9215ecf73a0babc777e0bc251ea9f1368d006094ee1bbe7",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:03ef6b48eaed715fcf4a6b610952c5341b7fb782facd94821ed374385e941f50"
    },
    {
      "baseHexagramNumber": 45,
      "changedHexagramNumber": 28,
      "sourceEntryNumber": 28,
      "sourceIconHexagramNumber": 28,
      "hexagramName": "大過",
      "poemText": "亂頭多憂，搔虱生愁。膳夫仲年，使我無聊。",
      "sourceParagraphSha256": "sha256:08b6d36513a52b2f29d51d33a10de44440d5dd8fb85338d8f11acbc0f4b1d43f",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:3e980b373a7fda30434e50fd933b030755fbc85264f7114acb8f597da5d61da9"
    },
    {
      "baseHexagramNumber": 45,
      "changedHexagramNumber": 29,
      "sourceEntryNumber": 29,
      "sourceIconHexagramNumber": 29,
      "hexagramName": "坎",
      "poemText": "江河淮海，天之都市。商人受福，國家富有。",
      "sourceParagraphSha256": "sha256:cfdcade62dcd71a9e49aecbf4715973ab2097ee174d004ab66d1d298d07bc1a0",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:b042aa1c384ad1ffb8d746204c93035ce2a1e3096ddc590687a983de86677750"
    },
    {
      "baseHexagramNumber": 45,
      "changedHexagramNumber": 30,
      "sourceEntryNumber": 30,
      "sourceIconHexagramNumber": 30,
      "hexagramName": "離",
      "poemText": "泰山幽谷，鳳凰游宿。禮義有序，可以求福。",
      "sourceParagraphSha256": "sha256:099e06228a04d91a7990c91bece032f416e98189dc02f7126c7289681c8c7762",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:2df3aeebcc665c5e314e44e8a380239bda92c6eff2b639d9b9708aa63e81f36f"
    },
    {
      "baseHexagramNumber": 45,
      "changedHexagramNumber": 31,
      "sourceEntryNumber": 31,
      "sourceIconHexagramNumber": 31,
      "hexagramName": "咸",
      "poemText": "水山暴怒，壞梁折柱。稽難行旅，留連愁苦。",
      "sourceParagraphSha256": "sha256:4eb7c20f5a7d31f5a136d060feae1a21202ba82eb451b92ef02e062a405fc81d",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:33c4ec0504e02d17f75135617af14c23405159338e73241aacf1299b6e1fb781"
    },
    {
      "baseHexagramNumber": 45,
      "changedHexagramNumber": 32,
      "sourceEntryNumber": 32,
      "sourceIconHexagramNumber": 32,
      "hexagramName": "恒",
      "poemText": "阿衡服箱，太乙載行。延時歷舍，所之吉昌。",
      "sourceParagraphSha256": "sha256:e95b2c03f57aa34aed4daff9bc48655f96bc5f83e4f5647aa21ab4a02252cfc2",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:44bd08cc5916cfcf8c3d0691d89f0c248ffe30dc29943d5169b58348a23d111b"
    },
    {
      "baseHexagramNumber": 45,
      "changedHexagramNumber": 33,
      "sourceEntryNumber": 33,
      "sourceIconHexagramNumber": 33,
      "hexagramName": "遯",
      "poemText": "三宿無主，南行勞苦。東里失利，喪其珍寶。",
      "sourceParagraphSha256": "sha256:af6328bc032d768e3e9ef90433c0708c8509598366beaf76cc7ef1c6f363f0a1",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:33c7064e62a32b09c1922a3ba0f42b13a65be31d0ef465b11afa4c488622daef"
    },
    {
      "baseHexagramNumber": 45,
      "changedHexagramNumber": 34,
      "sourceEntryNumber": 34,
      "sourceIconHexagramNumber": 34,
      "hexagramName": "大壯",
      "poemText": "生無父母，出門不喜。買椒失粟，亡我大利。",
      "sourceParagraphSha256": "sha256:e2046fe8fece1e4df8fb454dcdb85335787ceaf9bb007234e1f3f15c84f76a7e",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:9d6c4541a30cab2aa4c883a76cfff384b511ab287f56e1576cc9fa1d1b18f420"
    },
    {
      "baseHexagramNumber": 45,
      "changedHexagramNumber": 35,
      "sourceEntryNumber": 35,
      "sourceIconHexagramNumber": 35,
      "hexagramName": "晉",
      "poemText": "安坐玉堂，聽樂行觴。飲福萬鍾，日受無疆。",
      "sourceParagraphSha256": "sha256:c051eb6d730fbcc59219a16dd654731ee1908b242d8afeacc836c04f04428583",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:b67ed14c6ef8ec3327e01223b9e4783058bdc72c89e555b8a09adeeef06988f9"
    },
    {
      "baseHexagramNumber": 45,
      "changedHexagramNumber": 36,
      "sourceEntryNumber": 36,
      "sourceIconHexagramNumber": 36,
      "hexagramName": "明夷",
      "poemText": "登危入厄，四時變易。春霜夏雪，物皆凋落。",
      "sourceParagraphSha256": "sha256:dde3f46886555823c90f9c8698636f61dfe97f464b8f9c7d6555d1dbe54e619d",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:21e61200da839cea01be9ab050050d8f0de6017dee30c075f06f3022929db6c1"
    },
    {
      "baseHexagramNumber": 45,
      "changedHexagramNumber": 37,
      "sourceEntryNumber": 37,
      "sourceIconHexagramNumber": 37,
      "hexagramName": "家人",
      "poemText": "衣空履穿，無以禦寒。細小貧窶，不能自好。",
      "sourceParagraphSha256": "sha256:2c514b5630336f030a49a066f44e18870190cba34741331a04cf27fb941e5678",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ca618df6d98d67addb9724d69c4ff75f450be8d8ebafbdb0b11fe7278869d79e"
    },
    {
      "baseHexagramNumber": 45,
      "changedHexagramNumber": 38,
      "sourceEntryNumber": 38,
      "sourceIconHexagramNumber": 38,
      "hexagramName": "睽",
      "poemText": "目不可合，憂來搔足。怵惕恐懼，去其邦域。",
      "sourceParagraphSha256": "sha256:81b1dcfd011b0b1ab43d2024eaa4c60ccfbfb9361f393d364a4fb654e765a8e3",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:4ac6b127cc584fee6bc89434bca1201fc6caaca38d4de534d6032101dcae6895"
    },
    {
      "baseHexagramNumber": 45,
      "changedHexagramNumber": 39,
      "sourceEntryNumber": 39,
      "sourceIconHexagramNumber": 39,
      "hexagramName": "蹇",
      "poemText": "齎貝贖狸，不聽我辭。繫於虎鬚，牽不得來。",
      "sourceParagraphSha256": "sha256:cd05952230de41dce9a5564e2619d92b5e0d1ba4633a9914f1abcd8e14f9f854",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:5736044c886365c2eb3863a079c6a9b15ae50937e94ec18f59042eccb8aa90dc"
    },
    {
      "baseHexagramNumber": 45,
      "changedHexagramNumber": 40,
      "sourceEntryNumber": 40,
      "sourceIconHexagramNumber": 40,
      "hexagramName": "解",
      "poemText": "伯夷叔齊，貞廉之師。以德防患，憂禍不存。芳聲後時。",
      "sourceParagraphSha256": "sha256:f4bc1e61dfd94cf70136b9dfe616963502b73119e65dedc50f1a98acf8af9206",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:c53c4021f247751259019fd12e73bcac17a8993aa8006b87aea73bf9a48b670b"
    },
    {
      "baseHexagramNumber": 45,
      "changedHexagramNumber": 41,
      "sourceEntryNumber": 41,
      "sourceIconHexagramNumber": 41,
      "hexagramName": "損",
      "poemText": "張王子季，爭財相制。商君頑嚚，不知所由。",
      "sourceParagraphSha256": "sha256:84f1757f9de380a59adcba0926027de4860ff556df4eff1001755ea87e065f1c",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:c5d463d4354e82f4dd78f561314524c5846b3f21ccec04c23bcbeee324903c89"
    },
    {
      "baseHexagramNumber": 45,
      "changedHexagramNumber": 42,
      "sourceEntryNumber": 42,
      "sourceIconHexagramNumber": 42,
      "hexagramName": "益",
      "poemText": "長城既立，四夷賓服。交和結好，昭君是福。",
      "sourceParagraphSha256": "sha256:5551a6b67345b3852087c7128d89d0937697e075fd795472bc4422acbd373907",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:d921859017e0b4dea8c3cc12e48623b18a4b2d4d4a519a19f84cac15792043c4"
    },
    {
      "baseHexagramNumber": 45,
      "changedHexagramNumber": 43,
      "sourceEntryNumber": 43,
      "sourceIconHexagramNumber": 43,
      "hexagramName": "夬",
      "poemText": "千歡萬悅，舉事為決。獲受嘉慶，動作有福。",
      "sourceParagraphSha256": "sha256:1ab571ff4c93eefea48b051e4cc019b20e8ce5f7127b86253bc5817de936df2c",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ed90de244c3a9e72ef6598e0ac8531d7e50250b0962b3c4907614da056827181"
    },
    {
      "baseHexagramNumber": 45,
      "changedHexagramNumber": 44,
      "sourceEntryNumber": 44,
      "sourceIconHexagramNumber": 44,
      "hexagramName": "姤",
      "poemText": "種一得十，日益有息。仁政獲民，四國親睦。",
      "sourceParagraphSha256": "sha256:bab0e215ca580d429d18016a47cca8d0cf3a0f5be73ad77146e2596ee4510a82",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:87fbf19337439f0679cde6062308a9621063bd77042d7ad01acc072c06b733f4"
    },
    {
      "baseHexagramNumber": 45,
      "changedHexagramNumber": 46,
      "sourceEntryNumber": 46,
      "sourceIconHexagramNumber": 46,
      "hexagramName": "升",
      "poemText": "安子富有，東國不殃。齊鄭和親，顯比以喜。",
      "sourceParagraphSha256": "sha256:9027f719a8776bfd1178bc0586456beb5c8d92dc60db1a8e12b4082ae79d7c7c",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:b7683d36aeea3636e0b456fc0416d781481e3d13de6b6fc6004e1a132d96f1ab"
    },
    {
      "baseHexagramNumber": 45,
      "changedHexagramNumber": 47,
      "sourceEntryNumber": 47,
      "sourceIconHexagramNumber": 47,
      "hexagramName": "困",
      "poemText": "九里十山，道仰峻難。牛馬不前，復反來還。",
      "sourceParagraphSha256": "sha256:1d62692a83137ec47fe934861a2964bea27934cfa159804deedbbff86a0e0c15",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:3abec04ad8961aedd386fa01ea845ae9ea8ca99132e888a1d2a41fa472163a2a"
    },
    {
      "baseHexagramNumber": 45,
      "changedHexagramNumber": 48,
      "sourceEntryNumber": 48,
      "sourceIconHexagramNumber": 48,
      "hexagramName": "井",
      "poemText": "鳩杖扶老，衣食百口。曾孫壽考，凶惡不起。",
      "sourceParagraphSha256": "sha256:6fb5129d57a1f8c942a6526748796175bc1fbab72f7f8c50be8b12ac60564043",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:a12af406fabec8297fb9906334c75453d7ac5e95ad2f339bc44a813fbf2d4e5f"
    },
    {
      "baseHexagramNumber": 45,
      "changedHexagramNumber": 49,
      "sourceEntryNumber": 49,
      "sourceIconHexagramNumber": 49,
      "hexagramName": "革",
      "poemText": "霧露雪霜，日暗不明。陰孽為疾，年穀大傷。",
      "sourceParagraphSha256": "sha256:d1299e061b8c6829eae4144b5bf707578d5c4e0d06eae29fe4792c75195f3ca4",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:4ec41283fae2aee3d5e25e40f0fd0829d5d25c3a680c55664a59c4c006b2a4ca"
    },
    {
      "baseHexagramNumber": 45,
      "changedHexagramNumber": 50,
      "sourceEntryNumber": 50,
      "sourceIconHexagramNumber": 50,
      "hexagramName": "鼎",
      "poemText": "迷行數卻，不知西東。陰疆暴逆，道理不通。",
      "sourceParagraphSha256": "sha256:6ee4bc86c6baba048ed625052a6d1214c09e08529e2ece5a67aae0010cf837f0",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:322a1c03545817fc7f9edf154233a462b5bccfcd4946c63dc8e80f3c3285cfd0"
    },
    {
      "baseHexagramNumber": 45,
      "changedHexagramNumber": 51,
      "sourceEntryNumber": 51,
      "sourceIconHexagramNumber": 51,
      "hexagramName": "震",
      "poemText": "登高上山，見王自言。信理我冤，得職蒙恩。",
      "sourceParagraphSha256": "sha256:953ce9e71d6ad923a8014b0ac23890da04e8f67be76ac919472596215311379f",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:5f7dca6f1557550dbab44263bfe1b7fa41f7c81cad098ef40cc8b7a591b0e626"
    },
    {
      "baseHexagramNumber": 45,
      "changedHexagramNumber": 52,
      "sourceEntryNumber": 52,
      "sourceIconHexagramNumber": 52,
      "hexagramName": "艮",
      "poemText": "三世為德，天祚以國。封建少昊，魯侯之福。",
      "sourceParagraphSha256": "sha256:3d8ee8b84b09b400be9a4680313ffa5523753d27055e00931fdee2d57f8d52db",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:12dea2a45eb895c094d6c7bc45e27faf1a9e46328ccae20d76a511fffba2ebd3"
    },
    {
      "baseHexagramNumber": 45,
      "changedHexagramNumber": 53,
      "sourceEntryNumber": 53,
      "sourceIconHexagramNumber": 53,
      "hexagramName": "漸",
      "poemText": "喬木無息，漢女難得。禱神請佩，反手離汝。",
      "sourceParagraphSha256": "sha256:b65fb0da93a84e30da2689bd46a1846eb76e29866a4939ac6ec65944365ef93c",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:b4dcc52349679c2b4d1899cda8dc85e6105ff48d3b62f49d450dfb76538c716f"
    },
    {
      "baseHexagramNumber": 45,
      "changedHexagramNumber": 54,
      "sourceEntryNumber": 54,
      "sourceIconHexagramNumber": 54,
      "hexagramName": "歸妹",
      "poemText": "東鄰西家，來即我謀。中告吉誠，使君安寧。",
      "sourceParagraphSha256": "sha256:e1c36b52ec5eba4c3b891caecae6d6feaa94554ae8d95c0497b12537f70f86cd",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:0f247a83b82be4d63ffc963f9aa281e161795e751405ec7c81d6b32614648a23"
    },
    {
      "baseHexagramNumber": 45,
      "changedHexagramNumber": 55,
      "sourceEntryNumber": 55,
      "sourceIconHexagramNumber": 55,
      "hexagramName": "豐",
      "poemText": "褰衣出戶，心欲奔走。王孫毋驚，使我長生。",
      "sourceParagraphSha256": "sha256:7f42986bc06c8916a536a296603f6c4aaa94f97a184a8b4cc3ac736d2ae037cf",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:1292163859b5ad2be2c07c3c424c8a3f791b32eddf9b169c4f2cb99f9ad9accc"
    },
    {
      "baseHexagramNumber": 45,
      "changedHexagramNumber": 56,
      "sourceEntryNumber": 56,
      "sourceIconHexagramNumber": 56,
      "hexagramName": "旅",
      "poemText": "三日不飲，遠水無酒。晝夜焦喉，使我為咎。",
      "sourceParagraphSha256": "sha256:cc5dce49df84ecbd40bd13310b52b21d2699e7625233155446d4a96538d31938",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:c70d0c0c4d751543619eb6d06b90f6a479d003d26d7c92c98f305ad977a86f6c"
    },
    {
      "baseHexagramNumber": 45,
      "changedHexagramNumber": 57,
      "sourceEntryNumber": 57,
      "sourceIconHexagramNumber": 57,
      "hexagramName": "巽",
      "poemText": "眾口銷金，愆言不驗。腐臭敗兔，入市不售。",
      "sourceParagraphSha256": "sha256:9d432808fa8afa7c71ce764b730e9059fb3bae7ed2adcc4430c4cc3008d45234",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:2659ad368506094477da56d0a490bbcd0b02aea8fc2ebb02c80104e81166b755"
    },
    {
      "baseHexagramNumber": 45,
      "changedHexagramNumber": 58,
      "sourceEntryNumber": 58,
      "sourceIconHexagramNumber": 58,
      "hexagramName": "兌",
      "poemText": "嫗冠應門，與伯爭言。東家失狗，意在不存。爭亂無怠，絕無所歡。",
      "sourceParagraphSha256": "sha256:a1c9c71e427d5d6a247f3319f0786f049f2841aad0b50204eb4f9203f307056b",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:7214e8f5863b1fd2696236c816a6153caf57459ac02b2a004db0f9a4a32c276e"
    },
    {
      "baseHexagramNumber": 45,
      "changedHexagramNumber": 59,
      "sourceEntryNumber": 59,
      "sourceIconHexagramNumber": 59,
      "hexagramName": "渙",
      "poemText": "祚加明德，與我周國。公劉文母，福流子孫。",
      "sourceParagraphSha256": "sha256:f8166a678051ab37f526b01bb6228b05ae54ced1f680d1616d355ee2ff956aac",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:0781e8fa461a7ca0cd0de82626655c64dde4dad8711e57f97abb7b565313f1ab"
    },
    {
      "baseHexagramNumber": 45,
      "changedHexagramNumber": 60,
      "sourceEntryNumber": 60,
      "sourceIconHexagramNumber": 60,
      "hexagramName": "節",
      "poemText": "針頭刺手，百病瘳愈。抑按捫灸，死人復起。",
      "sourceParagraphSha256": "sha256:82fe617f4ec21265d7b6204093e81c2c2d05bcea75247be126b540bad216e16a",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:7c4f2cfd87fa9b6a13cc4fdbf2d731d46742437c2fa3571507af0a18791ea693"
    },
    {
      "baseHexagramNumber": 45,
      "changedHexagramNumber": 61,
      "sourceEntryNumber": 61,
      "sourceIconHexagramNumber": 61,
      "hexagramName": "中孚",
      "poemText": "元龜象齒，大賂為寶。稽疑當否，衰微復起。",
      "sourceParagraphSha256": "sha256:eab7597a15162297cf3c3e2375f843dfef470d777b0c5107200a78c2069bee03",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:d0f7e4335c7de02aa4aac93f82b8ea26ed4b3cc152dbc9a6226a64c6c1ade7fb"
    },
    {
      "baseHexagramNumber": 45,
      "changedHexagramNumber": 62,
      "sourceEntryNumber": 62,
      "sourceIconHexagramNumber": 62,
      "hexagramName": "小過",
      "poemText": "故室舊廬，消散無餘。不如新創，可以樂居。",
      "sourceParagraphSha256": "sha256:a05709b38fdb380779459556a45a5df6402e4da87ffc5cbed9c87b9caca3d1bd",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:1f5d56102bcf4b62b4029abd255fb0c886ffa1c51b2b7af43e17fc0ca2b17c3d"
    },
    {
      "baseHexagramNumber": 45,
      "changedHexagramNumber": 63,
      "sourceEntryNumber": 63,
      "sourceIconHexagramNumber": 63,
      "hexagramName": "既濟",
      "poemText": "老狐多態，行為蠱恠。為魅為妖，驚我王母。終無咎悔。",
      "sourceParagraphSha256": "sha256:cb80de910ea50f35f7c031da8986ec5df23ac541bc4aaa87ab72698ef70d5f7b",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:2c9167e460771880db6362b892653f69287698979df8ba08ff1f079be730d475"
    },
    {
      "baseHexagramNumber": 45,
      "changedHexagramNumber": 64,
      "sourceEntryNumber": 64,
      "sourceIconHexagramNumber": 64,
      "hexagramName": "未濟",
      "poemText": "愛子多材，起跡空虛。避害如神，水不能濡。",
      "sourceParagraphSha256": "sha256:ce8c27951bf5778168c1f3def476ada2dbfdeee37e911404011286c6172451aa",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:b75ff17bca8fd784a3c218dc371cbeef651a6929764dfd799355a46988c183f3"
    }
  ]
}
