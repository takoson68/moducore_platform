  "attribution": "來源：《焦氏易林》，易學網《焦氏易林［四庫全書版］》（依據版本：《欽定四庫全書》子部術數類），https://www.eee-learning.com/book/giauii 。依來源要求標示出處及原網頁連結；本站僅整理林辭原文，並記錄收錄、標點及文字整理修改。",
  "entryCount": 64,
  "missingTargets": [],
  "entries": [
    {
      "baseHexagramNumber": 38,
      "changedHexagramNumber": 38,
      "sourceEntryNumber": 38,
      "sourceIconHexagramNumber": 38,
      "hexagramName": "睽",
      "poemText": "倉盈庾億，宜稼黍稷。年豐歲熟，民得安息。",
      "sourceParagraphSha256": "sha256:7084dc0d95047b8334bf941e3106037c4d14769b1a3dbfb7f51c6ef67838b3d1",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:1e4c4d5a53779ce45751599650d9174d05d43ba33638290b442b52c156b58dcc"
    },
    {
      "baseHexagramNumber": 38,
      "changedHexagramNumber": 1,
      "sourceEntryNumber": 1,
      "sourceIconHexagramNumber": 1,
      "hexagramName": "乾",
      "poemText": "被服文衣，遊視酒池。上堂見觴，喜為吾兄。使我憂忘。",
      "sourceParagraphSha256": "sha256:37cddce414609648356da2f1f1316ff94258534a367f33bae4c12904208082e7",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:df9211d51a37e4087e0ad067879e739f1c0336b3e4074637c4ddda09ed4b4660"
    },
    {
      "baseHexagramNumber": 38,
      "changedHexagramNumber": 2,
      "sourceEntryNumber": 2,
      "sourceIconHexagramNumber": 2,
      "hexagramName": "坤",
      "poemText": "邑姜叔子，天文在手。實沈參墟，封為晉侯。",
      "sourceParagraphSha256": "sha256:a8a3a54ba2dc76ed45922e82d8d696f2ce5cfc30b17fc401a3f6f72fa6542bd0",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:33e462e82a8939cc628833b800f86a48289258ff7b1c5df419fa1643f7a1cc77"
    },
    {
      "baseHexagramNumber": 38,
      "changedHexagramNumber": 3,
      "sourceEntryNumber": 3,
      "sourceIconHexagramNumber": 3,
      "hexagramName": "屯",
      "poemText": "改柯易葉，飯溫不食。豪雄爭彊，先者受福。",
      "sourceParagraphSha256": "sha256:307614da91c75b6be89a5395459453ce8a49046c80f4191c84adc3585f03b6e1",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:5e062249396908c8f0f1d73c5fdd09e5b0a74b8d72717e63d85c4c27f9b13038"
    },
    {
      "baseHexagramNumber": 38,
      "changedHexagramNumber": 4,
      "sourceEntryNumber": 4,
      "sourceIconHexagramNumber": 4,
      "hexagramName": "蒙",
      "poemText": "馨香陟降，明德上登。社神佑顧，命為大鄰。",
      "sourceParagraphSha256": "sha256:f19ff5f6943cf14203f37bf4af2942050588196cd653633c2830983a0fb8fcc2",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:4af668782e8be3602ec0cee9bae61fdafd0a26aa262d123e00477a830f0f4f9a"
    },
    {
      "baseHexagramNumber": 38,
      "changedHexagramNumber": 5,
      "sourceEntryNumber": 5,
      "sourceIconHexagramNumber": 5,
      "hexagramName": "需",
      "poemText": "老狼白駒，長尾大狐。前顛卻躓，進退遇祟。",
      "sourceParagraphSha256": "sha256:9993b57451f6f81bd45362b10f7d5d58ec25f2013f428c9f053875d8c471aadf",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:180b8b3c2d654f40f91c9f2519ba4349145b4b018309d4e89d43bd236cee8b90"
    },
    {
      "baseHexagramNumber": 38,
      "changedHexagramNumber": 6,
      "sourceEntryNumber": 6,
      "sourceIconHexagramNumber": 6,
      "hexagramName": "訟",
      "poemText": "山沒丘浮，陵為水魚，燕雀無廬。",
      "sourceParagraphSha256": "sha256:0a669f8ffcb51c21eb84d980b76e7686e5699e8d5c62c715f35ef4c4142d74d2",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:473dfb1500d83acdf5b325eb33c282f85e676ea2f54d104d37ca8f8c0880cec5"
    },
    {
      "baseHexagramNumber": 38,
      "changedHexagramNumber": 7,
      "sourceEntryNumber": 7,
      "sourceIconHexagramNumber": 7,
      "hexagramName": "師",
      "poemText": "懿公淺愚，不受深謀。無援失國，為狄所滅。",
      "sourceParagraphSha256": "sha256:ae9e1235c26a39dcd226f177fadc08d0f78b867bfab430d0bc993acc849ee046",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:d0cb68001c7320bbd65bc617837573f14711d517970d185ba125cc61793d6f8e"
    },
    {
      "baseHexagramNumber": 38,
      "changedHexagramNumber": 8,
      "sourceEntryNumber": 8,
      "sourceIconHexagramNumber": 8,
      "hexagramName": "比",
      "poemText": "鼎易其耳，熱不可舉。大塗壅塞，旅人心苦。",
      "sourceParagraphSha256": "sha256:dc9bf51c67629dc7905d6f93ef782d2e7a463c690dfe0a3bbaffe45e79be6023",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:793c8d9fe75560d1b07a66f6182c6277ba7f31370af45dfc4c28cd8e2d10d082"
    },
    {
      "baseHexagramNumber": 38,
      "changedHexagramNumber": 9,
      "sourceEntryNumber": 9,
      "sourceIconHexagramNumber": 9,
      "hexagramName": "小畜",
      "poemText": "凶聲醜言，要不可聞。君子舍之，往恨我心。",
      "sourceParagraphSha256": "sha256:978e4b23598437ab0e239e44a1742d69012e42866dc788651857903cda14ae8a",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:566d0da47d967943538e7ab0dd810937b7859d1d455f8bd81f72781fb13c8674"
    },
    {
      "baseHexagramNumber": 38,
      "changedHexagramNumber": 10,
      "sourceEntryNumber": 10,
      "sourceIconHexagramNumber": 10,
      "hexagramName": "履",
      "poemText": "昧暮乘車，履危蹈溝。亡失群物，摧折兩軸。",
      "sourceParagraphSha256": "sha256:dfde07bb7d3cf6f5b631a00b608459c4f3d7eeedd9e08b60a2b7c71f50882b52",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:b3a85586f583114d7d634ed99bd700bc82ec48d2840a3d8eb6a4411fe1d8e0f7"
    },
    {
      "baseHexagramNumber": 38,
      "changedHexagramNumber": 11,
      "sourceEntryNumber": 11,
      "sourceIconHexagramNumber": 11,
      "hexagramName": "泰",
      "poemText": "南有嘉魚，駕黃取 。魴鱮詡詡，利來毋憂。",
      "sourceParagraphSha256": "sha256:bc1f1cabda3dacc17d9c19ebd7edaed975198efe5127c6b0d87b68f578386961",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:46cba86cf7686de3969d33b61a68cae70c8fb1944421222d5c85e17923102904"
    },
    {
      "baseHexagramNumber": 38,
      "changedHexagramNumber": 12,
      "sourceEntryNumber": 12,
      "sourceIconHexagramNumber": 12,
      "hexagramName": "否",
      "poemText": "隔在九山，往來勞難。心結不通，失其所歡。",
      "sourceParagraphSha256": "sha256:a1009e5d8f07ef4c788a3fee79df0b83c2fd295932f0655302a0718610e9b07f",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:0db805c3828c7a48e0d8fb01f96a8a1d122807beba2b85e620fa4b447e64910b"
    },
    {
      "baseHexagramNumber": 38,
      "changedHexagramNumber": 13,
      "sourceEntryNumber": 13,
      "sourceIconHexagramNumber": 13,
      "hexagramName": "同人",
      "poemText": "下流難居，任失多態。貞良溫柔，年歲不富。",
      "sourceParagraphSha256": "sha256:33e47713c0ebf522a2d10cadf59072b37f21b5fa95f009ca5f2aee8bd63c7aa6",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:c2a99e5eb6e8c96133e87ac22ee25d7f5fc9d43eea5721e76014e96cc325279b"
    },
    {
      "baseHexagramNumber": 38,
      "changedHexagramNumber": 14,
      "sourceEntryNumber": 14,
      "sourceIconHexagramNumber": 14,
      "hexagramName": "大有",
      "poemText": "狐狸雉兔，畏人逃去。分首竄匿，不知所處。",
      "sourceParagraphSha256": "sha256:5e44ff35cbf1b9d60f7aa8dd06544c4390bd5eb11aa4263c2efe2a0fdd9accb1",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:b96170614f16ade537488e517560e87542d57edbb3950a4eace2c1321aa2c11a"
    },
    {
      "baseHexagramNumber": 38,
      "changedHexagramNumber": 15,
      "sourceEntryNumber": 15,
      "sourceIconHexagramNumber": 15,
      "hexagramName": "謙",
      "poemText": "異體殊俗，各有所屬。西鄰孤嫗，欲寄我室。主母罵詈，終不可得。",
      "sourceParagraphSha256": "sha256:e56d39a56273b2d7a055644108c483a102afd1ee3bf23f746cf7982d12cfec2a",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:af0e1efe63e9fbef8bf7e0c011c0f3f3a4760e0f2eb9a362f113f46846edc84f"
    },
    {
      "baseHexagramNumber": 38,
      "changedHexagramNumber": 16,
      "sourceEntryNumber": 16,
      "sourceIconHexagramNumber": 16,
      "hexagramName": "豫",
      "poemText": "怒非怨妒，貪得腐鼠。而呼鷹鸇，自今失餌。倒被困患。",
      "sourceParagraphSha256": "sha256:db2a8cc093179da820471d85e04ef0718c63fa91a0273010712084d581de2241",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:f833b46c662518ac76b45d4e591ac60657836cbb4b4550f3d10f577d37606fb6"
    },
    {
      "baseHexagramNumber": 38,
      "changedHexagramNumber": 17,
      "sourceEntryNumber": 17,
      "sourceIconHexagramNumber": 17,
      "hexagramName": "隨",
      "poemText": "五心六意，岐道多怪。非君本心，生我恨悔。",
      "sourceParagraphSha256": "sha256:170b5be7c28cb44dbe1ed1ff4b93d77189133ec3b51373f009e1bbf45747e1b5",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:b7a85352526575acbfa6678387cbc97a91acea2566e409e2da1f2771c911e534"
    },
    {
      "baseHexagramNumber": 38,
      "changedHexagramNumber": 18,
      "sourceEntryNumber": 18,
      "sourceIconHexagramNumber": 18,
      "hexagramName": "蠱",
      "poemText": "三班六黑，同室共食。日長月息，我家有德。",
      "sourceParagraphSha256": "sha256:3db3abecdc4ab062162d0f087d58ef9e74c0462e75ce15f7ce3a6999b1b5454e",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:9d68940dc4985bd7e2eb49ee67e690a396dffc18f06bb8193394316964bbc08f"
    },
    {
      "baseHexagramNumber": 38,
      "changedHexagramNumber": 19,
      "sourceEntryNumber": 19,
      "sourceIconHexagramNumber": 19,
      "hexagramName": "臨",
      "poemText": "方船備水，旁河燃火，終身無禍。",
      "sourceParagraphSha256": "sha256:6642f3872fde1cd365de39f3799a3ae6a13c7f008ac338247aea72ef1c218e9b",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:a662121a9b3dc7d89764ffaeadf8840be54fdfd1cdde0882bf55771a495f1cdf"
    },
    {
      "baseHexagramNumber": 38,
      "changedHexagramNumber": 20,
      "sourceEntryNumber": 20,
      "sourceIconHexagramNumber": 20,
      "hexagramName": "觀",
      "poemText": "翳屏獨語，不聞朝市，利以居言，究被後門。",
      "sourceParagraphSha256": "sha256:bf8894352ced585e038aff4b0b38bafbff274432e23ee72158346bb736928609",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:16e5fe2440c0edf5240fbf39fc06ddadf540c2ba0e2679866b6b66c26f96f13d"
    },
    {
      "baseHexagramNumber": 38,
      "changedHexagramNumber": 21,
      "sourceEntryNumber": 21,
      "sourceIconHexagramNumber": 21,
      "hexagramName": "噬嗑",
      "poemText": "居處不安，徒反觸患。",
      "sourceParagraphSha256": "sha256:341e066c802cd855ca4b8aa13d01f0d1331e1158be46123a81c3bb8cac7e5130",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ca147ad9372aeb6def66a6bceb5f0acc4588552d449743cb7c49ce092e7159a0"
    },
    {
      "baseHexagramNumber": 38,
      "changedHexagramNumber": 22,
      "sourceEntryNumber": 22,
      "sourceIconHexagramNumber": 22,
      "hexagramName": "賁",
      "poemText": "刺刖髡劓，人所賤棄。批捍之言，我心不快。",
      "sourceParagraphSha256": "sha256:8cad67820101cfda0d9238b4728b794494876556dd3c9645430266f4cdf69831",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:8a7498893097c28f5eb2e2efe61b90f041f59a7e7e9d820e2e6fa325ec0ecad5"
    },
    {
      "baseHexagramNumber": 38,
      "changedHexagramNumber": 23,
      "sourceEntryNumber": 23,
      "sourceIconHexagramNumber": 23,
      "hexagramName": "剝",
      "poemText": "皋田禾黍，堆壤麻阜。衣食我躬，室家饒有。",
      "sourceParagraphSha256": "sha256:f23c7f09f91b85c95bdbe15b332e66faeefad79307a3b09a860f45cb4931950c",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:95c42dc63485c7e08fa61350672dacc5c7854420ff7a17465817ee06959f7b72"
    },
    {
      "baseHexagramNumber": 38,
      "changedHexagramNumber": 24,
      "sourceEntryNumber": 24,
      "sourceIconHexagramNumber": 24,
      "hexagramName": "復",
      "poemText": "兩目失明，日奪無光。脛足跛踦，不可以行。頓於丘傍。",
      "sourceParagraphSha256": "sha256:91d2497d90cc76f11c0dd2ab4d022ec0054368913985101956523ac06decc826",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:1eaddbf410f80118a87561fbee889323c9a03a106685a33414152e1a87e3df4f"
    },
    {
      "baseHexagramNumber": 38,
      "changedHexagramNumber": 25,
      "sourceEntryNumber": 25,
      "sourceIconHexagramNumber": 25,
      "hexagramName": "无妄",
      "poemText": "金城朔方，外國多羊。履霜不時，去復為憂。",
      "sourceParagraphSha256": "sha256:3d55a493d59da197ef46b9920af2cdd1bf8c2d142fba057039639c3b0933afe8",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:af63cbb59f1984a02ec30f32a268c5c1b45d55f584d5a77896f18a3e8c7dcf54"
    },
    {
      "baseHexagramNumber": 38,
      "changedHexagramNumber": 26,
      "sourceEntryNumber": 26,
      "sourceIconHexagramNumber": 26,
      "hexagramName": "大畜",
      "poemText": "匿痼不醫，亂政生災。紂作淫虐，商破其墟。",
      "sourceParagraphSha256": "sha256:a358a0d5ca369345e0cdd5ce011654569d380dcfdcf83b15afe678205afccabc",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:bb3e99d0cbc5f3ae0bb0733f1dbf229a3487de9aea6e5fa4414504910e2dc9a7"
    },
    {
      "baseHexagramNumber": 38,
      "changedHexagramNumber": 27,
      "sourceEntryNumber": 27,
      "sourceIconHexagramNumber": 27,
      "hexagramName": "頤",
      "poemText": "鬼哭泣社，悲傷無後。甲子昧爽，殷湯絕祀。",
      "sourceParagraphSha256": "sha256:922b5201ad838b70f58baf83e63d079fc896ed5d3beefbeafebdee1efd16efbc",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:3a1593c2d528a38e1fb9bf124e87a66963ad8cd0cdd3c7e9ad7c7ca1a134f79a"
    },
    {
      "baseHexagramNumber": 38,
      "changedHexagramNumber": 28,
      "sourceEntryNumber": 28,
      "sourceIconHexagramNumber": 28,
      "hexagramName": "大過",
      "poemText": "焱風卒起，車馳袍褐。棄古追亡，失其和節。憂心惙惙。",
      "sourceParagraphSha256": "sha256:3a63da67501d512a83e19bbbf8877c19e5eb686279f70930192e54c71c81fdac",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ab7d27ac944b964126ff57c63f7f26df32208057ab39a0cd95d416bfb36184a3"
    },
    {
      "baseHexagramNumber": 38,
      "changedHexagramNumber": 29,
      "sourceEntryNumber": 29,
      "sourceIconHexagramNumber": 29,
      "hexagramName": "坎",
      "poemText": "耄老失明，聞善不從。自今顛沛，反為咎殃。",
      "sourceParagraphSha256": "sha256:933840e98160d68cd9876eb5655d88b743840b4391c896242b617cbd30596ccb",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:14358f70453b647b02f8dc64789d448551376e7daf8bef6887b2d5e23880d2e4"
    },
    {
      "baseHexagramNumber": 38,
      "changedHexagramNumber": 30,
      "sourceEntryNumber": 30,
      "sourceIconHexagramNumber": 30,
      "hexagramName": "離",
      "poemText": "隨風騎龍，與利相逢。日獲三狐，商伯有功。衢衢之邑，長安無他。",
      "sourceParagraphSha256": "sha256:19c1e8badced4f03aeb2aa562703814b9d7364ca32f494cd22583cf701a3156b",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:f36fa37b98f75f5bb6c0b73dc7a199d7542a19df4496fb2853ffbe5d9022c8b5"
    },
    {
      "baseHexagramNumber": 38,
      "changedHexagramNumber": 31,
      "sourceEntryNumber": 31,
      "sourceIconHexagramNumber": 31,
      "hexagramName": "咸",
      "poemText": "三牛五牂，重明作福。使我有得，疾入官獄。憂在心腹。",
      "sourceParagraphSha256": "sha256:eceb54d465dd95dc94be63f4528e1ff51de8c5be5f226fa5b1fb1d76562e3059",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:0b92e61b6a6428621e13bf5a3719657a41b1632366d00bfaea08f350913aa519"
    },
    {
      "baseHexagramNumber": 38,
      "changedHexagramNumber": 32,
      "sourceEntryNumber": 32,
      "sourceIconHexagramNumber": 32,
      "hexagramName": "恒",
      "poemText": "孟巳乙丑，哀呼尼父。明德訖終，亂虐滋起。",
      "sourceParagraphSha256": "sha256:d234eb58734500a1e5f638ea4ab57d86e06f9429b4f466cf298c1cdb0f0b5395",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:d0b56577a11c5691163dc51706bf329eefe652305e5095f931322ab3857c6967"
    },
    {
      "baseHexagramNumber": 38,
      "changedHexagramNumber": 33,
      "sourceEntryNumber": 33,
      "sourceIconHexagramNumber": 33,
      "hexagramName": "遯",
      "poemText": "華燈百枝，消暗衰微。精光訖盡，奄如灰糜。",
      "sourceParagraphSha256": "sha256:c794d42594522f216ccbc91095e9d05970fd964ab9a7ebae2be6ec3fe89519fc",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:66148b01f63d9c91279498c0011afdda42c4af0d2d3d7d6722a22165cba787d7"
    },
    {
      "baseHexagramNumber": 38,
      "changedHexagramNumber": 34,
      "sourceEntryNumber": 34,
      "sourceIconHexagramNumber": 34,
      "hexagramName": "大壯",
      "poemText": "鷹飛雉退，兔伏不起。狐張狼鳴，野雞驚駭。",
      "sourceParagraphSha256": "sha256:78635693bc1453ab9ba0fea15950973c7a7c4c5031637123d0cb90fec0815d8b",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:dab2000a77d3b3d2fd7c24c22809b31d579585fa33a80b6916d9f2d143a41d1d"
    },
    {
      "baseHexagramNumber": 38,
      "changedHexagramNumber": 35,
      "sourceEntryNumber": 35,
      "sourceIconHexagramNumber": 35,
      "hexagramName": "晉",
      "poemText": "鬥身戰天，門有何患。室家具在，不失其歡。",
      "sourceParagraphSha256": "sha256:9ad9048962f2345beee94a118eaaf7358a01539850ffaa4aded4198bf87e5222",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:1dedad03dbf5e13df8239d2f2423bc951b2f00147bcc340681cb690e2a0a7841"
    },
    {
      "baseHexagramNumber": 38,
      "changedHexagramNumber": 36,
      "sourceEntryNumber": 36,
      "sourceIconHexagramNumber": 36,
      "hexagramName": "明夷",
      "poemText": "東家殺牛，污臰腥臊。神背西顧，命絕衰周。亳社災燒，宋人夷誅。",
      "sourceParagraphSha256": "sha256:6f52cccd49f405d07053b8d8d9d7581d7e79d48a819b762b14b685886b06f0ac",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:607eecbbade144e6ae0d9c071f14bdad695be7534ca153702e14c6eb4ea73238"
    },
    {
      "baseHexagramNumber": 38,
      "changedHexagramNumber": 37,
      "sourceEntryNumber": 37,
      "sourceIconHexagramNumber": 37,
      "hexagramName": "家人",
      "poemText": "陰陽辨舒，二姓相合。婚姻孔云，生我利福。",
      "sourceParagraphSha256": "sha256:ba56b75f3f1b572baa02ffa9c67182e2352baf2403224c725e9327ec39a12a8f",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:6961527e252e5347807e5b26f699ef605d83e0d83d4e5a2f204702097170935a"
    },
    {
      "baseHexagramNumber": 38,
      "changedHexagramNumber": 39,
      "sourceEntryNumber": 39,
      "sourceIconHexagramNumber": 39,
      "hexagramName": "蹇",
      "poemText": "東入海口，循流北走。一高一下，五色無主。十日六夜，死於水涘。",
      "sourceParagraphSha256": "sha256:6421a3ed73cef2a5fbaf9efba42d54ab8b0163e73ef07a5cdf8eca3ec595fae0",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:edb025de63843c552ca290e1ae6b43046421022ded2a2fc86124f4d195d391bd"
    },
    {
      "baseHexagramNumber": 38,
      "changedHexagramNumber": 40,
      "sourceEntryNumber": 40,
      "sourceIconHexagramNumber": 40,
      "hexagramName": "解",
      "poemText": "孤竹之墟，失婦無夫。傷於蒺藜，不見其妻。東郭棠姜，武子以亡。",
      "sourceParagraphSha256": "sha256:0bc33e3ccee2286d1bb0d918caf12994d9a12cee93544aec0ec38af23cec6692",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:148f7c48dce4f483cf2e6d70796c7d84181de1ee8a0702596d98dd0c25edb13c"
    },
    {
      "baseHexagramNumber": 38,
      "changedHexagramNumber": 41,
      "sourceEntryNumber": 41,
      "sourceIconHexagramNumber": 41,
      "hexagramName": "損",
      "poemText": "天門東墟，盡既為災。跡 喑聾，秦伯受殃。",
      "sourceParagraphSha256": "sha256:c87e06d71b178b1977bf1e71b08281a1171dd8ea5fb1b784dc99ee38e76c1c51",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:1463339d373bce091552966532c8e41a497fb07e367ccda0399b76b923796f0b"
    },
    {
      "baseHexagramNumber": 38,
      "changedHexagramNumber": 42,
      "sourceEntryNumber": 42,
      "sourceIconHexagramNumber": 42,
      "hexagramName": "益",
      "poemText": "賴生光水，受福之祉。雖遭亂潰，獨不危殆。",
      "sourceParagraphSha256": "sha256:7f27e8ec2ddf335ad36ce49349749249e9bc03df8f9d70df69bef442bd6a4e3f",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:443e4e5166e999ef0fd08c0667638e5733fc451e0086c8263482fac63e019995"
    },
    {
      "baseHexagramNumber": 38,
      "changedHexagramNumber": 43,
      "sourceEntryNumber": 43,
      "sourceIconHexagramNumber": 43,
      "hexagramName": "夬",
      "poemText": "折舌閉目，不見稚叔。三足孤烏，遠其無失。",
      "sourceParagraphSha256": "sha256:df9547611849810c7554d60ffdbf1bf1dbee1c031fbb70cb5fcdc81481d205c8",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:2bd250d5ea52c79fd1c763e1a5c0d6a3d17bfae7453ee8a6878901c0e9072bd9"
    },
    {
      "baseHexagramNumber": 38,
      "changedHexagramNumber": 44,
      "sourceEntryNumber": 44,
      "sourceIconHexagramNumber": 44,
      "hexagramName": "姤",
      "poemText": "七人同室，兄弟合食。和樂相好，各得所欲。",
      "sourceParagraphSha256": "sha256:0982f000ad5993ea0d821a483c45dd12905bfdea47f24b178ade2516ee16a901",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:7d3e0ac5563ec212c1e6cc73c78cff88fcd8a534650a0a94f7ec7761104a8e9c"
    },
    {
      "baseHexagramNumber": 38,
      "changedHexagramNumber": 45,
      "sourceEntryNumber": 45,
      "sourceIconHexagramNumber": 45,
      "hexagramName": "萃",
      "poemText": "繼體守藩，縱欲廢賢。君臣淫佚，夏氏失身。側室之門，福祿來存。",
      "sourceParagraphSha256": "sha256:1662284f54fa03718d08ba400d0ec64ad0d8cb3e4676442a41cf9ff5ad64544c",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:c05cc1cf1f21646e5ea4a0d5eb50f4431f3b4101b8efed6657c443b35254e50d"
    },
    {
      "baseHexagramNumber": 38,
      "changedHexagramNumber": 46,
      "sourceEntryNumber": 46,
      "sourceIconHexagramNumber": 46,
      "hexagramName": "升",
      "poemText": "老狐屈尾，東西為鬼。病我長女，哭涕詘指。或西或東，大革易誘。",
      "sourceParagraphSha256": "sha256:d36dcf160430ec25cbd8ee040e63e3043eb2c09213fa94250277e0839b0c9122",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:cf5798fff3dd4621eb27aa6b2579d4f0bc20d2c9add106d1347a29c180b72777"
    },
    {
      "baseHexagramNumber": 38,
      "changedHexagramNumber": 47,
      "sourceEntryNumber": 47,
      "sourceIconHexagramNumber": 47,
      "hexagramName": "困",
      "poemText": "大樹之子，百條共母。當夏六月，枝葉茂盛。鸞鳳以庇，召伯避暑。穉穉卭甚，各得其所。",
      "sourceParagraphSha256": "sha256:648d3a2b23991d2706d4bb2d58f562529292ed5562ae09a92278e2ef6fa48b72",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:53c8f325d481db26df621b4c0886e111af86080ffd728b387900c9ad959e1b25"
    },
    {
      "baseHexagramNumber": 38,
      "changedHexagramNumber": 48,
      "sourceEntryNumber": 48,
      "sourceIconHexagramNumber": 48,
      "hexagramName": "井",
      "poemText": "井堙木刊，國多暴殘。秦王失所，壞我大壇。",
      "sourceParagraphSha256": "sha256:cd150f7741a94af53051744750cc70f46eaf2a12b2b88fede3cdda52242b7d4e",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:604b938953de87e29bd8266c13ea13f9bec5c0ac3931b0847fe90f9d77c5bf4b"
    },
    {
      "baseHexagramNumber": 38,
      "changedHexagramNumber": 49,
      "sourceEntryNumber": 49,
      "sourceIconHexagramNumber": 49,
      "hexagramName": "革",
      "poemText": "駕黃買蒼，與利相迎。心獲所守，不累弟兄。",
      "sourceParagraphSha256": "sha256:24a2ec26a6d50945032973f4ef7dcd2404307db7023d0b0fdf17dacdf209fbfb",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:7f0bb596f47f618344ad8a823333e507fde91eed3d1b600bf932e4a153dfd14b"
    },
    {
      "baseHexagramNumber": 38,
      "changedHexagramNumber": 50,
      "sourceEntryNumber": 50,
      "sourceIconHexagramNumber": 50,
      "hexagramName": "鼎",
      "poemText": "倉盈庾億，宜稼黍稷。年豐歲熟，民得安息。",
      "sourceParagraphSha256": "sha256:c49b3ed1fc1378817690c3854cc2c0f67e48d3beb85cdd9914951412b7e06282",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:1e4c4d5a53779ce45751599650d9174d05d43ba33638290b442b52c156b58dcc"
    },
    {
      "baseHexagramNumber": 38,
      "changedHexagramNumber": 51,
      "sourceEntryNumber": 51,
      "sourceIconHexagramNumber": 51,
      "hexagramName": "震",
      "poemText": "人生馬淵，壽考且神。飛騰上天，舍宿軒轅。居常樂安。",
      "sourceParagraphSha256": "sha256:29110fb9a2a234e559345ed7ac91dd699d9f4878f294ac4bab4d5384a265b3f3",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:bd82cabdf108ba075ad66dea2b8008d4230cfaa31c0b4065e042a930abb48753"
    },
    {
      "baseHexagramNumber": 38,
      "changedHexagramNumber": 52,
      "sourceEntryNumber": 52,
      "sourceIconHexagramNumber": 52,
      "hexagramName": "艮",
      "poemText": "思願所之，今乃逢時。洗我故憂，拜我歡來。",
      "sourceParagraphSha256": "sha256:4f855b6252a69f09fab28997b3257613eced4df7f767114371f6a2a3df8a5b1a",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:f0cfced0a7a3d85f45434a4ed403475b6d6add636ca9d63c4baa34731ec2251d"
    },
    {
      "baseHexagramNumber": 38,
      "changedHexagramNumber": 53,
      "sourceEntryNumber": 53,
      "sourceIconHexagramNumber": 53,
      "hexagramName": "漸",
      "poemText": "魁罡所當，初為敗殃。君子留連，困於水漿。求金東山，利在茂鄉。賈市有息，子載母行。",
      "sourceParagraphSha256": "sha256:e31f2548fe26b0b4556aa531f6b08699a7fdcda66ed4ad8ceb6480ccbb2f9b54",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:8b0df9f1655882e689a15aff2cce98d8c0c306c8b2f8bc9448d5243842bdcc13"
    },
    {
      "baseHexagramNumber": 38,
      "changedHexagramNumber": 54,
      "sourceEntryNumber": 54,
      "sourceIconHexagramNumber": 54,
      "hexagramName": "歸妹",
      "poemText": "鉛刀攻玉，無不鑽鑿。龍體具舉，魯般為輔。三聖翼事，所求必喜。",
      "sourceParagraphSha256": "sha256:bcee84904e703d38a690bbd698606f45c672eee1d6fcbe4a837441bc7e020609",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:163f5aacbe7961d8684542f5a5c479f89ee89bb0a63739337b8164c9333c1cd3"
    },
    {
      "baseHexagramNumber": 38,
      "changedHexagramNumber": 55,
      "sourceEntryNumber": 55,
      "sourceIconHexagramNumber": 55,
      "hexagramName": "豐",
      "poemText": "喜來如雲，舉家歡忻。眾才君子，駕福盈門。",
      "sourceParagraphSha256": "sha256:f794f670de7d72a701dfe1104458bf07a4baf7726e588fe55510e88230be03eb",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:28aeca0354b012cb483d670470fb3350ccd84f57f59cfd9b0ac6fbedfb232332"
    },
    {
      "baseHexagramNumber": 38,
      "changedHexagramNumber": 56,
      "sourceEntryNumber": 56,
      "sourceIconHexagramNumber": 56,
      "hexagramName": "旅",
      "poemText": "響像無形，骨體不成。微行衰索，消滅無名。",
      "sourceParagraphSha256": "sha256:e29742f11f958ee9353fde289a50178f864749c8833b3456b0d660fdbff5962f",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:f26e612597aa5741187b8464acbd1bd8ee18f729b2c84ed9dacff29d18b0f548"
    },
    {
      "baseHexagramNumber": 38,
      "changedHexagramNumber": 57,
      "sourceEntryNumber": 57,
      "sourceIconHexagramNumber": 57,
      "hexagramName": "巽",
      "poemText": "積水不溫，北陸苦寒。露宿多風，君子傷心。",
      "sourceParagraphSha256": "sha256:d9cb07a664aa8ea1bb0974ed01200bd63c6885d0fa8096e4d41a11c9635a0278",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:01a1a57bcff62b4a005100107a36f5f83bb39b52c74dba1a01187caa26c655b1"
    },
    {
      "baseHexagramNumber": 38,
      "changedHexagramNumber": 58,
      "sourceEntryNumber": 58,
      "sourceIconHexagramNumber": 58,
      "hexagramName": "兌",
      "poemText": "黃馬綠車，駕之大都。讚達才能，使我無憂。",
      "sourceParagraphSha256": "sha256:7ca4cdb5b43210851a936245f4fb9b1ea84456ccc5364e015c72693efc60041e",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:5b357b0f17214641b8a8014e0c7fccfd76c11531434172da56b21afe05651016"
    },
    {
      "baseHexagramNumber": 38,
      "changedHexagramNumber": 59,
      "sourceEntryNumber": 59,
      "sourceIconHexagramNumber": 59,
      "hexagramName": "渙",
      "poemText": "從風放火，芝艾俱死。三害集聚，叔子中傷。",
      "sourceParagraphSha256": "sha256:ec79b6cf715e08371c2dab198c2481b9beffe94266798ef6a32dc040fa7df415",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:cc38bf999799ec7bab748e366c158bdc724a40a98f1118cf319804fdff322d6e"
    },
    {
      "baseHexagramNumber": 38,
      "changedHexagramNumber": 60,
      "sourceEntryNumber": 60,
      "sourceIconHexagramNumber": 60,
      "hexagramName": "節",
      "poemText": "一身三手，無益於輔。兩足共節，不能克敏。",
      "sourceParagraphSha256": "sha256:c23a7456ff9babadc7977473381629ce715ed598ef40992424185d9733c2b492",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:61a2e157a2d9cb8bbbb2891a81b5d72550d501216655378aacc29b3131b9bf34"
    },
    {
      "baseHexagramNumber": 38,
      "changedHexagramNumber": 61,
      "sourceEntryNumber": 61,
      "sourceIconHexagramNumber": 61,
      "hexagramName": "中孚",
      "poemText": "南向陋室，風雨並入。埃塵積溼，王母盲痹。偏枯心疾，亂我家次。",
      "sourceParagraphSha256": "sha256:a24cfaf5e580acc7e1d1338b2753839726b7d8fbd9d5691f014b70bace41f66d",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:c886eaa9a4aa2739b440ce5b3b7b6510c3f60a486569b935621a23a8781fdff2"
    },
    {
      "baseHexagramNumber": 38,
      "changedHexagramNumber": 62,
      "sourceEntryNumber": 62,
      "sourceIconHexagramNumber": 62,
      "hexagramName": "小過",
      "poemText": "采薇出車，魚麗思初。上下促急，君子懷憂。",
      "sourceParagraphSha256": "sha256:911260d14982e8d0cb5a00e987bc2ea0b8b0b8a262a3b1655c3f6962e428cef3",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:a9b6487c4247aa34b85f820af0a05409835852c4ce804fd36f6031e3f131390d"
    },
    {
      "baseHexagramNumber": 38,
      "changedHexagramNumber": 63,
      "sourceEntryNumber": 63,
      "sourceIconHexagramNumber": 63,
      "hexagramName": "既濟",
      "poemText": "先易後否，告我利市。騷蘇自苦，思再故止。",
      "sourceParagraphSha256": "sha256:4a57b63d8c52cc3aa70dad3f0c4ed88074dd85c24aa57d3afa96c7f2ba5df907",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:3c676b9d7c4e63650c76e8a658ba1261cf410f042ae868e07e4c67fb60acaabf"
    },
    {
      "baseHexagramNumber": 38,
      "changedHexagramNumber": 64,
      "sourceEntryNumber": 64,
      "sourceIconHexagramNumber": 64,
      "hexagramName": "未濟",
      "poemText": "生宜地乳，上皇大喜。隆我祉福，貴壽無極。",
      "sourceParagraphSha256": "sha256:fdfb209b3878279be47fab51a9a045a896d69d850bb6fa9611fa990d2e19f57b",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:eff343ca221741650b68825b2533d7636a3c4538b2f6018fedc02a5e589d5e6e"
    }
  ]
}
