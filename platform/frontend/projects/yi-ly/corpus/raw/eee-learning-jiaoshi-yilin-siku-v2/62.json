  "attribution": "來源：《焦氏易林》，易學網《焦氏易林［四庫全書版］》（依據版本：《欽定四庫全書》子部術數類），https://www.eee-learning.com/book/giauii 。依來源要求標示出處及原網頁連結；本站僅整理林辭原文，並記錄收錄、標點及文字整理修改。",
  "entryCount": 64,
  "missingTargets": [],
  "entries": [
    {
      "baseHexagramNumber": 62,
      "changedHexagramNumber": 62,
      "sourceEntryNumber": 62,
      "sourceIconHexagramNumber": 62,
      "hexagramName": "小過",
      "poemText": "初雖驚惶，後乃無傷。受其福慶，永永其祥。",
      "sourceParagraphSha256": "sha256:b13dd945b00ddf493fd2b83907653143d966cb3a89f900b31523a3a0b7691fd7",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:4090d89611a0d8811234dd0ee1f321e0b47ac0e8fd5a5cefe8300128ea9823ec"
    },
    {
      "baseHexagramNumber": 62,
      "changedHexagramNumber": 1,
      "sourceEntryNumber": 1,
      "sourceIconHexagramNumber": 1,
      "hexagramName": "乾",
      "poemText": "積德累仁，靈祐順信，福祉日增。",
      "sourceParagraphSha256": "sha256:6ea7706e84d21602d7beb84fd71f152756af6a407172baa7c4a517fab31896e8",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:6d88eeaf4d82b41924b05c09ee11bd3116e77c115148cf7875de726f1976749d"
    },
    {
      "baseHexagramNumber": 62,
      "changedHexagramNumber": 2,
      "sourceEntryNumber": 2,
      "sourceIconHexagramNumber": 2,
      "hexagramName": "坤",
      "poemText": "謹慎重言，不幸遭患。周召述職，脫免牢門。",
      "sourceParagraphSha256": "sha256:4ccf031d928ad1c02206e60eb2c82dcb0b17873f7d98dc8edeff559760740901",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:46c17dc97b73e8da186ac1d617988967a6277d277b197b3fcae50c1420c402cf"
    },
    {
      "baseHexagramNumber": 62,
      "changedHexagramNumber": 3,
      "sourceEntryNumber": 3,
      "sourceIconHexagramNumber": 3,
      "hexagramName": "屯",
      "poemText": "鳥飛鼓翼，喜樂堯德。虞夏著功，要荒賓服。",
      "sourceParagraphSha256": "sha256:9f6b996f413487b2dcd3f3b44d3dbb1dfdf15240ef898c600710ede4ee207d07",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:dbfe2806d85689b5c425785c97fd6c37bfd417265ca451a8c66070b7fa0adf79"
    },
    {
      "baseHexagramNumber": 62,
      "changedHexagramNumber": 4,
      "sourceEntryNumber": 4,
      "sourceIconHexagramNumber": 4,
      "hexagramName": "蒙",
      "poemText": "牙孽生齒，室堂啟戶。幽人利貞，鼓翼起舞。",
      "sourceParagraphSha256": "sha256:a6db62dd78360e29a21d5791d0e285e1ae59d04ec0fa908ec6d02196ce68aafe",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:89c898ef7ad8eb697c0fdb1b9ca3eb9ad6339185e6fd8526610924203cd6a832"
    },
    {
      "baseHexagramNumber": 62,
      "changedHexagramNumber": 5,
      "sourceEntryNumber": 5,
      "sourceIconHexagramNumber": 5,
      "hexagramName": "需",
      "poemText": "使伯東求，拒不肯行。與叔爭訟，更相毀傷。",
      "sourceParagraphSha256": "sha256:cd1eeacf604590dcbfe0cc835739fc158bc5395af3e800c5d60ed2fcfe6b4b1a",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:add4c10fcff02a76b67bd1cf6eec621c4bc25c733faf13e2b9c32266452a3f78"
    },
    {
      "baseHexagramNumber": 62,
      "changedHexagramNumber": 6,
      "sourceEntryNumber": 6,
      "sourceIconHexagramNumber": 6,
      "hexagramName": "訟",
      "poemText": "手足易處，頭尾顛倒。公為雌嫗，亂其蠶織。",
      "sourceParagraphSha256": "sha256:bbae778ecf50758e0aa5a76c611eeacd29a08222e24c2b1631e88a4ba118872d",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:2fbdf2650271de11e8b83411640dca25505f06d241d12764ee79469080056c09"
    },
    {
      "baseHexagramNumber": 62,
      "changedHexagramNumber": 7,
      "sourceEntryNumber": 7,
      "sourceIconHexagramNumber": 7,
      "hexagramName": "師",
      "poemText": "匠卿操斧，豫章危殆。袍衣既剝，祿命訖已。",
      "sourceParagraphSha256": "sha256:ade6cda6b2092819f8738283bc364f6b41aa236abbabdaa1d5382a8eb10282ed",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:505068932f1e22df1ccfd5ecb5d06dd9fba4622df400ad9ba18ea3403bd51f8b"
    },
    {
      "baseHexagramNumber": 62,
      "changedHexagramNumber": 8,
      "sourceEntryNumber": 8,
      "sourceIconHexagramNumber": 8,
      "hexagramName": "比",
      "poemText": "天女踞床，不成文章。南箕無舌，飯多砂糠。虐眾盜名，雌雄折頸。",
      "sourceParagraphSha256": "sha256:5be13321b79b835a36917f080e0c14ceb7e4e5f4c49f2008ddef954ccdedb7e5",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:c33d9546e6f3f3a3987e94ad6536977b76f2b6289d8c2cc66e280371c3e528d1"
    },
    {
      "baseHexagramNumber": 62,
      "changedHexagramNumber": 9,
      "sourceEntryNumber": 9,
      "sourceIconHexagramNumber": 9,
      "hexagramName": "小畜",
      "poemText": "大椎破轂，長舌亂國。床笫之言，三世不安。",
      "sourceParagraphSha256": "sha256:a7dfe258317af3c387503b538bb98e4f1ddfb2f176b6f1c73cbbefd136e5f696",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:68ddd628640adc72763aaa72e8a4b53f82f243af66d1b3df29cdf90a866a0b79"
    },
    {
      "baseHexagramNumber": 62,
      "changedHexagramNumber": 10,
      "sourceEntryNumber": 10,
      "sourceIconHexagramNumber": 10,
      "hexagramName": "履",
      "poemText": "銜命辱使，不堪厥事。中墜落去，更為負載。",
      "sourceParagraphSha256": "sha256:7f6860961b24900fc9ce73867917c3a42d8ff1352f3bc9e4b4f249202c9a3127",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:56832598255c593bb37ce4fed2cade590a7172d64f9076c2220de57c5ea3665a"
    },
    {
      "baseHexagramNumber": 62,
      "changedHexagramNumber": 11,
      "sourceEntryNumber": 11,
      "sourceIconHexagramNumber": 11,
      "hexagramName": "泰",
      "poemText": "三蛇共室，同類相得。甘露時降，生我百穀。",
      "sourceParagraphSha256": "sha256:5fbe0c638130feb931ad693e3df84129a8cc47d8fa2896da5aaf791ff8cf43f0",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:114a6df61828ed96ea3cad22cc008a152ac6bf3e3753b3ccb33dc4623326629b"
    },
    {
      "baseHexagramNumber": 62,
      "changedHexagramNumber": 12,
      "sourceEntryNumber": 12,
      "sourceIconHexagramNumber": 12,
      "hexagramName": "否",
      "poemText": "衣繡夜遊，與君相逢。除患解惑，使君不憂。",
      "sourceParagraphSha256": "sha256:488d10bb02146fe2f7846bf7b61bfdb2fa4ca7e20b5a018bf3448dff62eeb993",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:23800bbebc9555bf3796adf5eb50fead574c6d4ab3c001b4b953c7d6a812b1cf"
    },
    {
      "baseHexagramNumber": 62,
      "changedHexagramNumber": 13,
      "sourceEntryNumber": 13,
      "sourceIconHexagramNumber": 13,
      "hexagramName": "同人",
      "poemText": "被髮獸心，難與為鄰。來如風雨，去如絕絃，為狼所殘。",
      "sourceParagraphSha256": "sha256:c2d7665ea47bb80dd1615286a4c17082e4ac1bbc104a3477814c63b82b22b65f",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:372494a0281aa21e8884c97f9bcc59a3969c86811d309cafde0ad0dcbe53da1d"
    },
    {
      "baseHexagramNumber": 62,
      "changedHexagramNumber": 14,
      "sourceEntryNumber": 14,
      "sourceIconHexagramNumber": 14,
      "hexagramName": "大有",
      "poemText": "剛柔相呼，二姓為家。霜降既同，惠我以仁。",
      "sourceParagraphSha256": "sha256:f6b9a9417b7a1d1d20cf390c7925d50442565b5106b0907a4f356aeaba275559",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:d0e7bee824993c1d1d4f602f34c067bf30ead539dcd1e89621392e89cdb579e9"
    },
    {
      "baseHexagramNumber": 62,
      "changedHexagramNumber": 15,
      "sourceEntryNumber": 15,
      "sourceIconHexagramNumber": 15,
      "hexagramName": "謙",
      "poemText": "牛耳聾瞶，不曉聲味。委以鼎俎，治亂潰潰。",
      "sourceParagraphSha256": "sha256:29ee3ea7d26c49f3b9cd6cb7a1f77fd41931f31e6838795cd8e7682f970a7cd2",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:0d427c5219590f27825310bddf2642da0d6198772641a6ee6b0afe832769c996"
    },
    {
      "baseHexagramNumber": 62,
      "changedHexagramNumber": 16,
      "sourceEntryNumber": 16,
      "sourceIconHexagramNumber": 16,
      "hexagramName": "豫",
      "poemText": "低頭竊視，有所畏避。行旅不利，酒酸魚餒，眾莫貪嗜。",
      "sourceParagraphSha256": "sha256:5a6fd9b595a35b1de18a5ab56d01e391b6b504d24f18307d4c8ec8fc1f0135c0",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ff5e15334fc0348b45fced5ed450328a51b4526d01da5fb76eb0b252c56899a5"
    },
    {
      "baseHexagramNumber": 62,
      "changedHexagramNumber": 17,
      "sourceEntryNumber": 17,
      "sourceIconHexagramNumber": 17,
      "hexagramName": "隨",
      "poemText": "雨師娶婦，黃巖季子。成禮既婚，相呼南上。膏我下土，年歲大有。",
      "sourceParagraphSha256": "sha256:f3816b805c361924a0e2907e4b97f63aa417f92dde41a2409b21cd384e934216",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:e8b0215d6b3f1b138460efaae3ea5c7deeb030c2359b3c84fc410e88d7e38623"
    },
    {
      "baseHexagramNumber": 62,
      "changedHexagramNumber": 18,
      "sourceEntryNumber": 18,
      "sourceIconHexagramNumber": 18,
      "hexagramName": "蠱",
      "poemText": "戴盆望天，不見星辰。顧小失大，遁逃牆外。",
      "sourceParagraphSha256": "sha256:0645ee37bfa564a30b8cfd438cdd935cb911ae08df6ca9478d94e40972296a4c",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:28266f61e65e49943e4c7f77aad4b79207929c64dcc28e67fedd0973da7e7b4c"
    },
    {
      "baseHexagramNumber": 62,
      "changedHexagramNumber": 19,
      "sourceEntryNumber": 19,
      "sourceIconHexagramNumber": 19,
      "hexagramName": "臨",
      "poemText": "二人輦車，徙去其家。井沸釜鳴，不可以居。",
      "sourceParagraphSha256": "sha256:f4cf1c1e0fbc0770250ad8766fa0c05d327aadc0e39309452046857d842835e1",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:d2c8917897d91dfdccc46e0c4bc957e286af002f9ff05da9a926a7757cda88d7"
    },
    {
      "baseHexagramNumber": 62,
      "changedHexagramNumber": 20,
      "sourceEntryNumber": 20,
      "sourceIconHexagramNumber": 20,
      "hexagramName": "觀",
      "poemText": "攘臂反肘，怒不可止。狼戾腹心，無與為市。",
      "sourceParagraphSha256": "sha256:7996bbe1f140aa40ce50d2aead47e70cd0b96c51029c403d7155f1cc4f74d7e3",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:dadada1da75746c9df3843d5884677aaf846b80553f43437cad239b08e84968f"
    },
    {
      "baseHexagramNumber": 62,
      "changedHexagramNumber": 21,
      "sourceEntryNumber": 21,
      "sourceIconHexagramNumber": 21,
      "hexagramName": "噬嗑",
      "poemText": "湯火之憂，轉解喜來。",
      "sourceParagraphSha256": "sha256:752bc583fb6d4d6e1044f8c0deb99393bcaa324a2037b01fd39ec3e0db441e46",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:815729799e7a15228960c25a40f988035abc1b3a3d7b44a5ad1b57c325d4da40"
    },
    {
      "baseHexagramNumber": 62,
      "changedHexagramNumber": 22,
      "sourceEntryNumber": 22,
      "sourceIconHexagramNumber": 22,
      "hexagramName": "賁",
      "poemText": "忠信輔成，王政不傾。公劉肇基，文武綏之。",
      "sourceParagraphSha256": "sha256:bb24a85d292b001f84ec1117acf8f3321452799d1fe3eed17df929580577cb9f",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:39ff7df24ff685d5974d2111c161eb3b5065d4bb01b97529c7cd784cc7af80e8"
    },
    {
      "baseHexagramNumber": 62,
      "changedHexagramNumber": 23,
      "sourceEntryNumber": 23,
      "sourceIconHexagramNumber": 23,
      "hexagramName": "剝",
      "poemText": "登高折木，頓躓蹈險。車傾馬疲，叔伯嗟噓。",
      "sourceParagraphSha256": "sha256:13f3fbfc40566f374a9232923e8cd17c686d0e67dd41f3b0b9dd54a61470bdff",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:fbbf43dcf9f8a8a8423eaa0251242b6669268e3ea87399a97f94b168dd5475b9"
    },
    {
      "baseHexagramNumber": 62,
      "changedHexagramNumber": 24,
      "sourceEntryNumber": 24,
      "sourceIconHexagramNumber": 24,
      "hexagramName": "復",
      "poemText": "桑方隕落，黃葉敗散。失勢傾側，如無所立。",
      "sourceParagraphSha256": "sha256:b87c808b269e3631e0a70a58260e4cb8b935698e0cd135ffefb32e787706a1ae",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:cff9b946a84e59622fd78823308abcc80eb56f932ab284933755f35dbbd56e5e"
    },
    {
      "baseHexagramNumber": 62,
      "changedHexagramNumber": 25,
      "sourceEntryNumber": 25,
      "sourceIconHexagramNumber": 25,
      "hexagramName": "无妄",
      "poemText": "鸞鳳翱翔，集于家國。念我伯姊，與母相得。",
      "sourceParagraphSha256": "sha256:372bb4d2768169f43ef36e5bcbd274ef1023a61d989a2b3caa09ec268ccba4e1",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:c234a2d15f5b2de9c47e14ba1c2e5c12b20541e7d4e99345037d94fe035f3118"
    },
    {
      "baseHexagramNumber": 62,
      "changedHexagramNumber": 26,
      "sourceEntryNumber": 26,
      "sourceIconHexagramNumber": 26,
      "hexagramName": "大畜",
      "poemText": "陰淫所居，盈溢過度，傷害禾稼。",
      "sourceParagraphSha256": "sha256:d7148a08fc185e88860a5f386ba026d7e06a4c17d740b40e6360aa8d2da25f83",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:2f7e019df8843f8e3111b0f5c3c42d38cbdc3c23faa420b5e178cf84167044e2"
    },
    {
      "baseHexagramNumber": 62,
      "changedHexagramNumber": 27,
      "sourceEntryNumber": 27,
      "sourceIconHexagramNumber": 27,
      "hexagramName": "頤",
      "poemText": "霄冥高山，道險峻難。王孫罷極，困於阪間。",
      "sourceParagraphSha256": "sha256:29b6151c2abaeb860614d0b20e02610106a5dba861d130c31fbf749ca62a8fb2",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:03989bd68b891aa1c6873d867ad41ab4b6d4b09a3ffc21fa27b8ba12a38e8324"
    },
    {
      "baseHexagramNumber": 62,
      "changedHexagramNumber": 28,
      "sourceEntryNumber": 28,
      "sourceIconHexagramNumber": 28,
      "hexagramName": "大過",
      "poemText": "和璧隋珠，為火所燒。冥昧失明，奪精無光，棄於道傍。",
      "sourceParagraphSha256": "sha256:549aa75da77504c4d9da24044a79521299644bf47848c5c10f0de9ef97ef8c29",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:66f3373dc5e24983afa131f08c931162487785e3200efc8d266004866dbc48ff"
    },
    {
      "baseHexagramNumber": 62,
      "changedHexagramNumber": 29,
      "sourceEntryNumber": 29,
      "sourceIconHexagramNumber": 29,
      "hexagramName": "坎",
      "poemText": "虞君好田，惠我老親。恭承宗廟，長慍不去，復我內事。",
      "sourceParagraphSha256": "sha256:6c2dda7ffad7d4f778a419dd91877659dd361d97546db27f8d9a94e4260bcc2f",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:715d63885f27b111306d8525da586dbdfa716f472cb3163198b2af20298070d5"
    },
    {
      "baseHexagramNumber": 62,
      "changedHexagramNumber": 30,
      "sourceEntryNumber": 30,
      "sourceIconHexagramNumber": 30,
      "hexagramName": "離",
      "poemText": "爪牙之士，怨毒祈父。轉憂與己，傷不及母。",
      "sourceParagraphSha256": "sha256:0878ee21255463738685bf02e93ff0948068af9c0d6a3d715861c21a593efd99",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:fc5a91b5366bbd9581df26e20b7f7624445f0a91c4e33c08a5e8ee32fbbff651"
    },
    {
      "baseHexagramNumber": 62,
      "changedHexagramNumber": 31,
      "sourceEntryNumber": 31,
      "sourceIconHexagramNumber": 31,
      "hexagramName": "咸",
      "poemText": "倉盈庾億，宜稼黍稷，年歲有息。",
      "sourceParagraphSha256": "sha256:604bd9f7a849e9e086b0411575299d61672df2841cc4ba4d55a533bf7773ae4f",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:f8880ca88e57d7492b25b1baae298198242ebd3bb815ae2527e37335040b6cba"
    },
    {
      "baseHexagramNumber": 62,
      "changedHexagramNumber": 32,
      "sourceEntryNumber": 32,
      "sourceIconHexagramNumber": 32,
      "hexagramName": "恒",
      "poemText": "窗牖戶傍，通利明光。賢智輔聖，仁德大行。家給人足，海內殷昌。",
      "sourceParagraphSha256": "sha256:8d09f52a902dc62b6398e4957a11c6a2d8894f542a2a82345263717dd52ac10e",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:1202f123619a537dfbf96268a84bce8f513b53cdcfe24e387a98c343534075cd"
    },
    {
      "baseHexagramNumber": 62,
      "changedHexagramNumber": 33,
      "sourceEntryNumber": 33,
      "sourceIconHexagramNumber": 33,
      "hexagramName": "遯",
      "poemText": "忉忉之患，凶重與薦，為虎所吞。",
      "sourceParagraphSha256": "sha256:9d4c79dd3179a5f520a465c62096b7ab566d6cddfffbebe49402cfdb50e7f6e1",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:8d5e876472139bae0f6e6dff163ea8dbdda6241d4b7abf7a214621912a368fdc"
    },
    {
      "baseHexagramNumber": 62,
      "changedHexagramNumber": 34,
      "sourceEntryNumber": 34,
      "sourceIconHexagramNumber": 34,
      "hexagramName": "大壯",
      "poemText": "水無魚滋，陸為海涯。君子失居，小人相攜。",
      "sourceParagraphSha256": "sha256:65ec7e78a552dafcafdbee3bdc428a3b5a32668ad97f4c04cf345841cd3065ae",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ab638ec2dc47724ea5d13409992d6ff84f8bcf817c7f51978396dbc920cf8a25"
    },
    {
      "baseHexagramNumber": 62,
      "changedHexagramNumber": 35,
      "sourceEntryNumber": 35,
      "sourceIconHexagramNumber": 35,
      "hexagramName": "晉",
      "poemText": "九疑鬱林，沮濕不中。鸞鳳所惡，君子攸去。",
      "sourceParagraphSha256": "sha256:2c3a4efd587d3f4d828d55a555358fb40cca7db605fbd577123891350585dc80",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:c365a174e5b8fed9ed9ae98712d57334b32cb4b6e3c395a349481e7e1f48e242"
    },
    {
      "baseHexagramNumber": 62,
      "changedHexagramNumber": 36,
      "sourceEntryNumber": 36,
      "sourceIconHexagramNumber": 36,
      "hexagramName": "明夷",
      "poemText": "六翮泛飛，走歸不及。脫歸王室，上其騂特。",
      "sourceParagraphSha256": "sha256:57ee1b3a5f831c2c7a380fbee6942f2205692cf2433f384ef416aff80a138437",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:976262dddf6f2203872126fd204d45ac678875ec6f7792e83a246bf7c8008277"
    },
    {
      "baseHexagramNumber": 62,
      "changedHexagramNumber": 37,
      "sourceEntryNumber": 37,
      "sourceIconHexagramNumber": 37,
      "hexagramName": "家人",
      "poemText": "不直莊公，與我爭訟。媒伯無禮，自令壅塞。",
      "sourceParagraphSha256": "sha256:ed5fc2b9878d0cbd5a65b475fed7e326b5edf09b484127c8c2cfca02cd4bbde2",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:70573668daeac8e3b1ac73fbcc5869c6d5e1dc8f4028f6c965ec841430727a48"
    },
    {
      "baseHexagramNumber": 62,
      "changedHexagramNumber": 38,
      "sourceEntryNumber": 38,
      "sourceIconHexagramNumber": 38,
      "hexagramName": "睽",
      "poemText": "倉庚多億，宋公危殆。吳子巢門，殞命失所。",
      "sourceParagraphSha256": "sha256:42aa158930f986e4aa7667895ccbbd50f78d61c85c5feb1a33f4e9b1e4336ab6",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:dfcede5aaf010937705abcd3627a4648caca299984d22d8dc87a7bff9c00c2f6"
    },
    {
      "baseHexagramNumber": 62,
      "changedHexagramNumber": 39,
      "sourceEntryNumber": 39,
      "sourceIconHexagramNumber": 39,
      "hexagramName": "蹇",
      "poemText": "失羊捕牛，無損無憂。",
      "sourceParagraphSha256": "sha256:0f7ede91a296f87afd67f43a9da7e4aca535b4866730c0f73182d37fec092884",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ef4721ee15bb338151fcde54be03905cbef186d916358c5cb06b052e97699e08"
    },
    {
      "baseHexagramNumber": 62,
      "changedHexagramNumber": 40,
      "sourceEntryNumber": 40,
      "sourceIconHexagramNumber": 40,
      "hexagramName": "解",
      "poemText": "夏麥麩䵃，霜擊其芒。疾君敗國，使我誅傷。",
      "sourceParagraphSha256": "sha256:b6634a103684a3d0ad4122c9c9cfdb2a11dc054743f6fe4d469fd57197f000fb",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:9ac73ef71b8ed6c0308688ec6287ceab269de03fb370f736d9b29f1b1be64519"
    },
    {
      "baseHexagramNumber": 62,
      "changedHexagramNumber": 41,
      "sourceEntryNumber": 41,
      "sourceIconHexagramNumber": 41,
      "hexagramName": "損",
      "poemText": "昧昧暗暗，不知白黑。風雨亂擾，光明伏匿，幽王失國。",
      "sourceParagraphSha256": "sha256:1e1d0a54a8724d16e35c49b73f248c56d9e7f0c75797d606e598402265d002f4",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:2b73b994ab0a7fb96924b5175b5bdac75060cd6f3b3d10ae19678669c80c8008"
    },
    {
      "baseHexagramNumber": 62,
      "changedHexagramNumber": 42,
      "sourceEntryNumber": 42,
      "sourceIconHexagramNumber": 42,
      "hexagramName": "益",
      "poemText": "執斧破薪，使媒求婦。和合二姓，親御飲酒。色比毛嬙，姑公悅喜。",
      "sourceParagraphSha256": "sha256:af2e27c8dd3ec4d1a6bd4dd2d53b438e785b6e56e7972448d1173d79be02a647",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:578b879710640ef33ddeaee4ab2740cd53e84d7b0503f8f1d2febe2f78471a1e"
    },
    {
      "baseHexagramNumber": 62,
      "changedHexagramNumber": 43,
      "sourceEntryNumber": 43,
      "sourceIconHexagramNumber": 43,
      "hexagramName": "夬",
      "poemText": "六疾生狂，癡走妄行。北入患門，與禍為鄰。",
      "sourceParagraphSha256": "sha256:4a00c8335224170795750dfa4e28cc7625a7822dff36e0920a1ac456c6e12e9a",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:f1e22a071abc49df2a59ce706c38f2ce3787b0af0de7a6030b374a6faa86f3b5"
    },
    {
      "baseHexagramNumber": 62,
      "changedHexagramNumber": 44,
      "sourceEntryNumber": 44,
      "sourceIconHexagramNumber": 44,
      "hexagramName": "姤",
      "poemText": "驅羊就群，狼不肯前。慶季愎諫，子之被患。",
      "sourceParagraphSha256": "sha256:78e15e9222d115eee68afeb4b083b4fbab98af97ed9efe5c019c9c46634a5b17",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:40ef84a07a73ffb8a9a0ebdd1be0c0d3ddb86895cb8999b996f7302a7ae7ab30"
    },
    {
      "baseHexagramNumber": 62,
      "changedHexagramNumber": 45,
      "sourceEntryNumber": 45,
      "sourceIconHexagramNumber": 45,
      "hexagramName": "萃",
      "poemText": "二人異路，東趍西步。十里之外，不知相處。",
      "sourceParagraphSha256": "sha256:413fb92439f254001aaec0fb2cacb85fd4f434303fe4665f3f064c071e2c07f4",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:8d1b6b4b1ef44dcba5a36ee6b9b39d5eb28973d96b429fc64438acf6c043d6ed"
    },
    {
      "baseHexagramNumber": 62,
      "changedHexagramNumber": 46,
      "sourceEntryNumber": 46,
      "sourceIconHexagramNumber": 46,
      "hexagramName": "升",
      "poemText": "義不勝情，以欲自營。睹利為躬，折角摧頸。",
      "sourceParagraphSha256": "sha256:47ad59d614b9953d629cd2179ae55a76dc1c2cf525a150006351fa6df963e4ff",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:87de50f8e305a1d99f00a69f7ddb0673300a8c1a9d87b49c9fdebd6b1332c714"
    },
    {
      "baseHexagramNumber": 62,
      "changedHexagramNumber": 47,
      "sourceEntryNumber": 47,
      "sourceIconHexagramNumber": 47,
      "hexagramName": "困",
      "poemText": "騷騷擾擾，不安其類。疾在頸項，凶危為憂。",
      "sourceParagraphSha256": "sha256:f643678f3e011435bea16e7995f5197de1f5716fac4135e494269a3e8cbd00e6",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:0d8ccb7c63c59105c8214a876a0a0b773fa28c61fdaf8b46d87a113a11645d55"
    },
    {
      "baseHexagramNumber": 62,
      "changedHexagramNumber": 48,
      "sourceEntryNumber": 48,
      "sourceIconHexagramNumber": 48,
      "hexagramName": "井",
      "poemText": "三河俱合，水怒湧躍。壞我王室，民困於食。",
      "sourceParagraphSha256": "sha256:f57975b23d6d07bb34f1e488bb79869bf821ba332d412e9668dcdadbe6cd5f32",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:9188fb9f1cefb3df6dfbc91a7f333210b909c22036cc4b6081c08548d05b9515"
    },
    {
      "baseHexagramNumber": 62,
      "changedHexagramNumber": 49,
      "sourceEntryNumber": 49,
      "sourceIconHexagramNumber": 49,
      "hexagramName": "革",
      "poemText": "陽曜旱疾，傷病稼穡，農人無食。",
      "sourceParagraphSha256": "sha256:8694987dc8a5b1c323cb1e098364b0a60c8f650ded120642351d4c8cd0c4ea19",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:f3d00091528a82adf86be22ce4dcb7cf40a772374213f769ba7573130f71128b"
    },
    {
      "baseHexagramNumber": 62,
      "changedHexagramNumber": 50,
      "sourceEntryNumber": 50,
      "sourceIconHexagramNumber": 50,
      "hexagramName": "鼎",
      "poemText": "流浮出食，載豢入屋。釋轡繫馬，西南廡下。",
      "sourceParagraphSha256": "sha256:d33d408b0f9d1560e30528f6be710841092d1629c59ca92a474767970356f778",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:77cc33284b6f966074b7be98ccd50287f6ce0c759fb045d6d2d233795f1a2dd6"
    },
    {
      "baseHexagramNumber": 62,
      "changedHexagramNumber": 51,
      "sourceEntryNumber": 51,
      "sourceIconHexagramNumber": 51,
      "hexagramName": "震",
      "poemText": "門戶之居，可以止舍。進士不殆，安樂相保。",
      "sourceParagraphSha256": "sha256:ee3499a4a7ff1016d8af75047eea1220ca7cfbd886dff61c2bc80d8f828d44b0",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:a27c98cf5a39c229f967857221cf02be7ee41f1c389e61ab1ae7ef03ea3a4a27"
    },
    {
      "baseHexagramNumber": 62,
      "changedHexagramNumber": 52,
      "sourceEntryNumber": 52,
      "sourceIconHexagramNumber": 52,
      "hexagramName": "艮",
      "poemText": "過時不歸，雌雄苦悲。徘徊外國，與母分離。",
      "sourceParagraphSha256": "sha256:3b5b2b1bd8f2a051fe13fb0d743fa8909a665a3ed60d4b787c8df27aa81fa8c6",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:dd7ce76f843f6e834c8ad5da389388c8ff7a74391018c5af6e886ee21bfcfaf2"
    },
    {
      "baseHexagramNumber": 62,
      "changedHexagramNumber": 53,
      "sourceEntryNumber": 53,
      "sourceIconHexagramNumber": 53,
      "hexagramName": "漸",
      "poemText": "中田有廬，疆埸有瓜。獻進皇祖，曾孫壽考。",
      "sourceParagraphSha256": "sha256:49fa512bf873f6409591daa3a86c658d161fa0d37010a4ce715f3fe9c2a6967b",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:7f761feadc47eb4f00086490f6841b01f4254229900f200064869acb88ac54f6"
    },
    {
      "baseHexagramNumber": 62,
      "changedHexagramNumber": 54,
      "sourceEntryNumber": 54,
      "sourceIconHexagramNumber": 54,
      "hexagramName": "歸妹",
      "poemText": "失時無友，覆家出走，何如喪狗。",
      "sourceParagraphSha256": "sha256:ad9736b2266d50a9cc22e5784f9855aa5a9b4eb383872aa2e3fd91131a8e07cb",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:3579bee493f9e2664068c05d91bf93404ffa1ae46f884b3fb1643ac2fe4d6513"
    },
    {
      "baseHexagramNumber": 62,
      "changedHexagramNumber": 55,
      "sourceEntryNumber": 55,
      "sourceIconHexagramNumber": 55,
      "hexagramName": "豐",
      "poemText": "反鼻岐頭，三寡獨居。",
      "sourceParagraphSha256": "sha256:edb4d1fa2e96028ceab24eacf27417455e5185506b2404cec85c78c69314d8a9",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:e1467353271be9708f8ab829ac3bc663bfb075803bc70d3da0cbfa901b3bab66"
    },
    {
      "baseHexagramNumber": 62,
      "changedHexagramNumber": 56,
      "sourceEntryNumber": 56,
      "sourceIconHexagramNumber": 56,
      "hexagramName": "旅",
      "poemText": "衣裳顛倒，為王來呼。成就東周，封受大福。",
      "sourceParagraphSha256": "sha256:5e9fbcf88e7cbe6ef82cde6f49741daef246aeddbed2280c340475d35e2c73bd",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:befba226924a3ae5a9db0522f4baab96e9acd02055df8c6eff27a05d418a6498"
    },
    {
      "baseHexagramNumber": 62,
      "changedHexagramNumber": 57,
      "sourceEntryNumber": 57,
      "sourceIconHexagramNumber": 57,
      "hexagramName": "巽",
      "poemText": "飛不遠去，還歸故處，興事多悔。",
      "sourceParagraphSha256": "sha256:cd885f021acb4cf301ed1a50cea6c2f844eec3dc034f2089f757813c05cb1145",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:2228a5351c1fdc2884a670da13889bf3faacfbb6e9a80760c1afd76d7fb117ec"
    },
    {
      "baseHexagramNumber": 62,
      "changedHexagramNumber": 58,
      "sourceEntryNumber": 58,
      "sourceIconHexagramNumber": 58,
      "hexagramName": "兌",
      "poemText": "含血走禽，不曉五音。匏巴鼓瑟，不悅於心。",
      "sourceParagraphSha256": "sha256:65820e9fe28b3b1acdbbc3973240cc8ebebce23850d009d537670fa34b9a8124",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:63c6ae297db057b3424dfb766b26b663ba1e63464f8e0d715437606060c06064"
    },
    {
      "baseHexagramNumber": 62,
      "changedHexagramNumber": 59,
      "sourceEntryNumber": 59,
      "sourceIconHexagramNumber": 59,
      "hexagramName": "渙",
      "poemText": "求玉獲石，非心所欲，祝願不得。",
      "sourceParagraphSha256": "sha256:3b269185b559556e6037d2c7aeb02b499e28abb1c146537b805a8d9595df65e3",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:5835dadba57c2cdb325f23e9879ec7f8b06ff7e35e614653e4ce3e3bdd405289"
    },
    {
      "baseHexagramNumber": 62,
      "changedHexagramNumber": 60,
      "sourceEntryNumber": 60,
      "sourceIconHexagramNumber": 60,
      "hexagramName": "節",
      "poemText": "山崩谷絕，大福盡歇。涇渭失紀，玉石既已。",
      "sourceParagraphSha256": "sha256:fc18eee829c21444344650c9774dcbb077162baec68d61ff26dfdfdb06881c3b",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:e2ab312acfdc68cc2ad554a4d284bf738c36a14ed064324fcf463eb686ea8289"
    },
    {
      "baseHexagramNumber": 62,
      "changedHexagramNumber": 61,
      "sourceEntryNumber": 61,
      "sourceIconHexagramNumber": 61,
      "hexagramName": "中孚",
      "poemText": "雜目懼怒，不安其居。散漫府藏，無有利得。",
      "sourceParagraphSha256": "sha256:18ee1ff3919d217dbd15a307e5e941cd884799f5f54b10aad80fc93390d52d40",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:28a28bd0907552ff2ccf01e138640187be694adff280700606be9ed4710ed539"
    },
    {
      "baseHexagramNumber": 62,
      "changedHexagramNumber": 63,
      "sourceEntryNumber": 63,
      "sourceIconHexagramNumber": 63,
      "hexagramName": "既濟",
      "poemText": "眾邪充側，鳳凰折翼。微子復北，去其邦國。",
      "sourceParagraphSha256": "sha256:9d1be617d68dcb422155b00e86710e7b59f52e69c7e8a67d024dfc38d0fa8724",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:65d70b5c91a4379fcbd09b43805f9d262587de7060b8eb88c5195b30882fe3b7"
    },
    {
      "baseHexagramNumber": 62,
      "changedHexagramNumber": 64,
      "sourceEntryNumber": 64,
      "sourceIconHexagramNumber": 64,
      "hexagramName": "未濟",
      "poemText": "六月采芑，征伐無道。張仲季叔，孝友飲酒。",
      "sourceParagraphSha256": "sha256:c79a42d10ef918c284932badb5b9da6c6d3ceac8dbb8d31dc98e3314b0076bdb",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:96ffc9ebb07dd6ecbc9754b92e704493e77b5f872d768b216b833d88ad8e01f3"
    }
  ]
}
