  "attribution": "來源：《焦氏易林》，易學網《焦氏易林［四庫全書版］》（依據版本：《欽定四庫全書》子部術數類），https://www.eee-learning.com/book/giauii 。依來源要求標示出處及原網頁連結；本站僅整理林辭原文，並記錄收錄、標點及文字整理修改。",
  "entryCount": 64,
  "missingTargets": [],
  "entries": [
    {
      "baseHexagramNumber": 44,
      "changedHexagramNumber": 44,
      "sourceEntryNumber": 44,
      "sourceIconHexagramNumber": 44,
      "hexagramName": "姤",
      "poemText": "河伯大呼，津不可渡。往復示故，乃無大悔。",
      "sourceParagraphSha256": "sha256:80ed3b62f89d0e4fa4d1e2e4d6dfeecbc35c91adac6334a79b85f82f58c8b4d9",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:584bd9f940eeaeacbaf91bd5aff6593ad9ef6be0d91f899800e0d85084310eb5"
    },
    {
      "baseHexagramNumber": 44,
      "changedHexagramNumber": 1,
      "sourceEntryNumber": 1,
      "sourceIconHexagramNumber": 1,
      "hexagramName": "乾",
      "poemText": "蒙被恩澤，長大成就。柔順利貞，君臣合好。",
      "sourceParagraphSha256": "sha256:638f37a9f0596f653cfe104ea6330665f79eeb5717ecf5695c04e44c3571c07e",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:cd2e0f7fa5935432a9487493ebf09d0424b2ca18dab9e3d450614d3d12ad8a40"
    },
    {
      "baseHexagramNumber": 44,
      "changedHexagramNumber": 2,
      "sourceEntryNumber": 2,
      "sourceIconHexagramNumber": 2,
      "hexagramName": "坤",
      "poemText": "東山西土，各自止安。雖欲登望，竟不同堂。",
      "sourceParagraphSha256": "sha256:03cea9a79f8b6e814cb3c4576c01f82ac8ecb5bc99117fb3836cc115cbb8e021",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:16c6f4df6bc49f154447c5ae6bedd1293bb4eca6dc561de30391d1617715488b"
    },
    {
      "baseHexagramNumber": 44,
      "changedHexagramNumber": 3,
      "sourceEntryNumber": 3,
      "sourceIconHexagramNumber": 3,
      "hexagramName": "屯",
      "poemText": "登山上谷，與虎相觸。猬為功曹，班叔奔北。脫之嘉同。",
      "sourceParagraphSha256": "sha256:9eb2fc67bd49f1319dc5c5831d134da4920e0a2f45a73febd976c46b0f4c76aa",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:9dd29b736f7fdae55cfa846d056767fd43a89ba4c4e0674c525f621c57ad4ffb"
    },
    {
      "baseHexagramNumber": 44,
      "changedHexagramNumber": 4,
      "sourceEntryNumber": 4,
      "sourceIconHexagramNumber": 4,
      "hexagramName": "蒙",
      "poemText": "躓跌未起，失利後市。不得鹿子。",
      "sourceParagraphSha256": "sha256:8e7d806199edf1f2d2fb7a5869f8698ea553a8cfa3f24664d73cb1ec63d4c748",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:54a07d8bdb4215c8c3f8cd95fbf4ef43156353df19f155163b0c16d4f69477d4"
    },
    {
      "baseHexagramNumber": 44,
      "changedHexagramNumber": 5,
      "sourceEntryNumber": 5,
      "sourceIconHexagramNumber": 5,
      "hexagramName": "需",
      "poemText": "結珠懷履，卓斯以思。為君奴婢。",
      "sourceParagraphSha256": "sha256:467085af46fb77fb29e1fec2067ed618e323a7e15d33831e6406f1635d848188",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:3e0cd97a452e9393248351468511b56671469ba9baf4f1c0a3829458bd09c2c1"
    },
    {
      "baseHexagramNumber": 44,
      "changedHexagramNumber": 6,
      "sourceEntryNumber": 6,
      "sourceIconHexagramNumber": 6,
      "hexagramName": "訟",
      "poemText": "雞鳴失時，民作勞苦。犬吠不休，行者稽留。",
      "sourceParagraphSha256": "sha256:73a8f1c0ecd746ccf2c55f580d1ea62131c29ed8b52d00adadd7144579d5a774",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ef44ab65e4f76e250bdcdf3abf057d28544cdc47354ee2862207a391bab49d90"
    },
    {
      "baseHexagramNumber": 44,
      "changedHexagramNumber": 7,
      "sourceEntryNumber": 7,
      "sourceIconHexagramNumber": 7,
      "hexagramName": "師",
      "poemText": "陳媯敬仲，逃興齊姜。營丘立適，八世大昌。",
      "sourceParagraphSha256": "sha256:b4d2f0ce92e32fd047aa9e3ac62c4664cdfb059861a02f138d1c085d82757f1c",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:0a3528494be0e1cb8184b4178aeac16c1f4bc93d438d25713208336ce20ae4cf"
    },
    {
      "baseHexagramNumber": 44,
      "changedHexagramNumber": 8,
      "sourceEntryNumber": 8,
      "sourceIconHexagramNumber": 8,
      "hexagramName": "比",
      "poemText": "鹿畏人匿，俱入深谷。短命不長，為虎所得。死於牙腹。",
      "sourceParagraphSha256": "sha256:89505ecb2c1a4886afaafc4b8f5b4ea8d14952b5d1fd0532980c3bfedac693ac",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:1d1a0fb6dc979bd692c14bb6d6d583ef0de81ac076f578786bc90ff52e2c0051"
    },
    {
      "baseHexagramNumber": 44,
      "changedHexagramNumber": 9,
      "sourceEntryNumber": 9,
      "sourceIconHexagramNumber": 9,
      "hexagramName": "小畜",
      "poemText": "言無約結，不成券契。殷叔季姬，公孫爭之。強入委禽，不悅於心，乃適子南。",
      "sourceParagraphSha256": "sha256:e8fd0818268ffb39adcf89917edbb1d09df4778f3fb14c74c579d4ca305775bf",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:5aacb6c7039826dc6afb3e8a4df7c89b9557fc0fd0df5cf9ab145196842f529e"
    },
    {
      "baseHexagramNumber": 44,
      "changedHexagramNumber": 10,
      "sourceEntryNumber": 10,
      "sourceIconHexagramNumber": 10,
      "hexagramName": "履",
      "poemText": "鼓瑟歌舞，懽悅於酒。龍喜張口，大悅在後。",
      "sourceParagraphSha256": "sha256:e5d8db5a65e1b67e724652398fde7fa8459e812fae4e0a0ecfd3e054706d1d01",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:42f8afbeeb14b920ccb21bb8e2dda99e30af104ae412edabb193e073792f753e"
    },
    {
      "baseHexagramNumber": 44,
      "changedHexagramNumber": 11,
      "sourceEntryNumber": 11,
      "sourceIconHexagramNumber": 11,
      "hexagramName": "泰",
      "poemText": "凶憂災殃，日益明章。禍不可救，王卻夷傷。",
      "sourceParagraphSha256": "sha256:9ba8ba7974dc457d5e2104aa2b344a0d717c7060ce32361cf23ba72039bba5df",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:30cb88816541afef2412710f584432353db18f3d2aef0e22552ced7e79cf44ac"
    },
    {
      "baseHexagramNumber": 44,
      "changedHexagramNumber": 12,
      "sourceEntryNumber": 12,
      "sourceIconHexagramNumber": 12,
      "hexagramName": "否",
      "poemText": "水流趍下，遂成東海。求我所有，貿鱣與鯉。",
      "sourceParagraphSha256": "sha256:16562eb368289bcc6154947d0186125162bdddde4121017d2876bd803fefac2b",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ab93e9d47ad2a201ba0498e1cf137d65ecf3f8875031ee13f0b463bd16e4a58a"
    },
    {
      "baseHexagramNumber": 44,
      "changedHexagramNumber": 13,
      "sourceEntryNumber": 13,
      "sourceIconHexagramNumber": 13,
      "hexagramName": "同人",
      "poemText": "陰為陽賊，君不能克。舉動失常，利無所得。",
      "sourceParagraphSha256": "sha256:23699fd35c13a9e7d69b02314035f774a08b2951de59a1da59a6917abe062515",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:0c94d0cc125ef50885a329cc531e39b7ad7b318368f40f5237396ed1e6643da9"
    },
    {
      "baseHexagramNumber": 44,
      "changedHexagramNumber": 14,
      "sourceEntryNumber": 14,
      "sourceIconHexagramNumber": 14,
      "hexagramName": "大有",
      "poemText": "離床失案，龜喪其願。都市無會，叔季懷恨。",
      "sourceParagraphSha256": "sha256:1c04dcf598b7284623bdbe8d9ecaef23072f9ec6538106a380823e1b50849f28",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:4985d308b0c1ff05e929fa739142888d97ba65b1383fc91f3e6aa944aecdfe1d"
    },
    {
      "baseHexagramNumber": 44,
      "changedHexagramNumber": 15,
      "sourceEntryNumber": 15,
      "sourceIconHexagramNumber": 15,
      "hexagramName": "謙",
      "poemText": "壅遏隄防，水不得行。大慎陽光，陰霓伏藏。走歸其鄉。",
      "sourceParagraphSha256": "sha256:e41d7fe0cd331653a0a3ea3c5227c443716a8890c4684401d62149153408c22e",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:26b08866c066c582c04240c1d44c5bd892fe827ac647f1830f978d84a9a43f34"
    },
    {
      "baseHexagramNumber": 44,
      "changedHexagramNumber": 16,
      "sourceEntryNumber": 16,
      "sourceIconHexagramNumber": 16,
      "hexagramName": "豫",
      "poemText": "躄屈腹伸，東乘浮雲，貴寵母前。",
      "sourceParagraphSha256": "sha256:d1a7505622bb7af89563dd79e72a481a15dcaedf977f45258dfdf01b195cba86",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:15a5efae06dc8475fd2331a8d8835974cc795074af0ed630420498c868a8b9dc"
    },
    {
      "baseHexagramNumber": 44,
      "changedHexagramNumber": 17,
      "sourceEntryNumber": 17,
      "sourceIconHexagramNumber": 17,
      "hexagramName": "隨",
      "poemText": "實沈參伐，以義斷割。次陸服刑，成我霸功。",
      "sourceParagraphSha256": "sha256:5498db51227960479c60e8da276a26bb78f6b866041d2b01bc81f8dd1b489352",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:b8954a31fc3fb195207379af4dc8d9c3ad02aa8957d76ed18d32138b27ba9004"
    },
    {
      "baseHexagramNumber": 44,
      "changedHexagramNumber": 18,
      "sourceEntryNumber": 18,
      "sourceIconHexagramNumber": 18,
      "hexagramName": "蠱",
      "poemText": "金泉黃寶，宜與我市。娶嫁有息，利後過母。",
      "sourceParagraphSha256": "sha256:501719ad728a9daf033ac0a6647dc4bfd5fecb7fef13b37e20d0d93da5773511",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:5350705237f0e88a44982cc3ee44f67ffef616925ff57509e01ba4f72d95f0c3"
    },
    {
      "baseHexagramNumber": 44,
      "changedHexagramNumber": 19,
      "sourceEntryNumber": 19,
      "sourceIconHexagramNumber": 19,
      "hexagramName": "臨",
      "poemText": "禹召諸神，會稽南山。執玉萬國，天下安寧。",
      "sourceParagraphSha256": "sha256:8a1a8042e545376664af889f469cfb5ac58f07d0bc84b143a5a7950b098d1fb7",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:856d7c30dfd7e424c72429ac9700aa75de64e9bdebcd720e4ba079affd21989d"
    },
    {
      "baseHexagramNumber": 44,
      "changedHexagramNumber": 20,
      "sourceEntryNumber": 20,
      "sourceIconHexagramNumber": 20,
      "hexagramName": "觀",
      "poemText": "三蟲作蠱，踐跡無與。勝母盜泉，君子不處。",
      "sourceParagraphSha256": "sha256:b47d439d5a49628846c3ed8db7a7e85a437f70ac5693aee47031ee42ee2f92e1",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:729f1c581245dd9c54fee29cf7a878e9316153b46bef731e4a351657c2f6a89d"
    },
    {
      "baseHexagramNumber": 44,
      "changedHexagramNumber": 21,
      "sourceEntryNumber": 21,
      "sourceIconHexagramNumber": 21,
      "hexagramName": "噬嗑",
      "poemText": "花葉隕落，公歸樞宅。夷子失民，潔己不食。",
      "sourceParagraphSha256": "sha256:0b5b3f546e54ea827ac3f1f6a89949e5b5b258d5ce59db7c98352ebe1744db80",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:bf8530550975159734b7795e4d6d32e39eee96e529937d321abc669e4f208cf8"
    },
    {
      "baseHexagramNumber": 44,
      "changedHexagramNumber": 22,
      "sourceEntryNumber": 22,
      "sourceIconHexagramNumber": 22,
      "hexagramName": "賁",
      "poemText": "履機懼毀，身王子廢。終得所欲，無有凶害。",
      "sourceParagraphSha256": "sha256:f36867c5e53624524399532572b299bfdb9ef187be2ddcc8217b009256266804",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:0fdf3fefa53f8f676a6b4da00c61063008b1a83f3142e63684a1b541b1c6a30a"
    },
    {
      "baseHexagramNumber": 44,
      "changedHexagramNumber": 23,
      "sourceEntryNumber": 23,
      "sourceIconHexagramNumber": 23,
      "hexagramName": "剝",
      "poemText": "道理和得，仁不相賊。君子攸往，我有利福。",
      "sourceParagraphSha256": "sha256:b63112d77d503635e4cb45048f0c6f352d35aff08edd1e42a5b591d9811cc746",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:2c416477545d974ebbf530f9ee66d8c91e7a64591c1b694f05df573004e00a50"
    },
    {
      "baseHexagramNumber": 44,
      "changedHexagramNumber": 24,
      "sourceEntryNumber": 24,
      "sourceIconHexagramNumber": 24,
      "hexagramName": "復",
      "poemText": "合匏同牢，姬姜並居，壽考長久。",
      "sourceParagraphSha256": "sha256:dfcfc1307316e02da582cfcabf33ca92bb86f190f84625d071520f6f56406a09",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:b2f778caa72d0d4fc768770a3ae1014d61115a63b2c8f9c25c6af441eaac2660"
    },
    {
      "baseHexagramNumber": 44,
      "changedHexagramNumber": 25,
      "sourceEntryNumber": 25,
      "sourceIconHexagramNumber": 25,
      "hexagramName": "无妄",
      "poemText": "關雎淑女，賢妃聖偶。宜家壽母，福祿長久。",
      "sourceParagraphSha256": "sha256:16c78a972d227f93fc89371b9cdc2311afc319dda6c32903351b6db21063cf3a",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:d330cbf0523e3adc48008a44d8d4dcd99f0c38c81e336f50aefa00d1d541eb5a"
    },
    {
      "baseHexagramNumber": 44,
      "changedHexagramNumber": 26,
      "sourceEntryNumber": 26,
      "sourceIconHexagramNumber": 26,
      "hexagramName": "大畜",
      "poemText": "騅驥脫乳，不知子處。旋踵悲鳴，痛傷我心。",
      "sourceParagraphSha256": "sha256:965c8aa2514378300457e9ca80a0d6350a213fdff7f294fa8b46e0fe3e7aaf02",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:fe88c41b47d4f214d051e0a15d26d7678dacfaea7791746a3debb34028258b50"
    },
    {
      "baseHexagramNumber": 44,
      "changedHexagramNumber": 27,
      "sourceEntryNumber": 27,
      "sourceIconHexagramNumber": 27,
      "hexagramName": "頤",
      "poemText": "知嚴絕理，陰孽謀主。十日不食，困於申亥。",
      "sourceParagraphSha256": "sha256:fdf0a5149e4b28985855ffbed73b3e0a2d717195e765226c5406bb0b7cefcda3",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:17c71db6e8406e0b1ed4e00fba80b08e4f01a1e133b9089d1dc0d18ed3b30319"
    },
    {
      "baseHexagramNumber": 44,
      "changedHexagramNumber": 28,
      "sourceEntryNumber": 28,
      "sourceIconHexagramNumber": 28,
      "hexagramName": "大過",
      "poemText": "鑿諸攻玉，無不宜鑿。麟鳳成形，得象君子。三人翼事，所求必喜。",
      "sourceParagraphSha256": "sha256:0752627557ca1c944c165caa56f9dbf73f0585e35c45f87e762f0d3e3ccf7b9f",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:a4714d54efb8ed21af0fce521f142235b6667517535755e5cfcf9563a6c958ce"
    },
    {
      "baseHexagramNumber": 44,
      "changedHexagramNumber": 29,
      "sourceEntryNumber": 29,
      "sourceIconHexagramNumber": 29,
      "hexagramName": "坎",
      "poemText": "昧暮乘車，以至伯家。踰梁渡河，濟脫無他。",
      "sourceParagraphSha256": "sha256:122eaf5d30549d2de42a5fb8646e3bb60934bf7973fbaed185761f9f5bbac6ae",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:b2dc2e35e7a8d743482a71798b3ee912214004340eac702b782150cbb33e00aa"
    },
    {
      "baseHexagramNumber": 44,
      "changedHexagramNumber": 30,
      "sourceEntryNumber": 30,
      "sourceIconHexagramNumber": 30,
      "hexagramName": "離",
      "poemText": "吾有黍稷，委積外場。有角服箱，運致我藏。富於嘉糧。",
      "sourceParagraphSha256": "sha256:3e12ee59ca45fe958971ec534a6bb5bf1d0c30224f25a223b6980c104599e7a5",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:e003211360dd7aff496bf980432ef83da3cd49355f80ff0828d87acb01c9cd9b"
    },
    {
      "baseHexagramNumber": 44,
      "changedHexagramNumber": 31,
      "sourceEntryNumber": 31,
      "sourceIconHexagramNumber": 31,
      "hexagramName": "咸",
      "poemText": "喜笑且語，不能掩口。官爵並至，慶賀盈門。",
      "sourceParagraphSha256": "sha256:ca290438919e97e8f272621ceb5f6aa5ec1b65b5f7a8ee38ce19433c62746c3c",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:3f7fc1bc83080ae72b76926772e59410bcf7073657aa816798649b29accf1852"
    },
    {
      "baseHexagramNumber": 44,
      "changedHexagramNumber": 32,
      "sourceEntryNumber": 32,
      "sourceIconHexagramNumber": 32,
      "hexagramName": "恒",
      "poemText": "霧露雪霜，日暗不明。陰孽為疾，年穀大傷。",
      "sourceParagraphSha256": "sha256:217e5683bdbeb53934ea3973a7f1401f859054ff529c94df1d971b1520bc72fd",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:4ec41283fae2aee3d5e25e40f0fd0829d5d25c3a680c55664a59c4c006b2a4ca"
    },
    {
      "baseHexagramNumber": 44,
      "changedHexagramNumber": 33,
      "sourceEntryNumber": 33,
      "sourceIconHexagramNumber": 33,
      "hexagramName": "遯",
      "poemText": "伯去我東，髮如飛蓬。寤寐長歎，展轉空床。內懷悵恨，心摧肝腸。",
      "sourceParagraphSha256": "sha256:6dd8187a36ed30c0b3c7eb10a69de968f78543ba706dcbd1b332582fa05581bf",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:75ff5b4c25f5cced5e12535c0087bdce0f9d1d2c8315ed824bcd1cfba4bbd7d8"
    },
    {
      "baseHexagramNumber": 44,
      "changedHexagramNumber": 34,
      "sourceEntryNumber": 34,
      "sourceIconHexagramNumber": 34,
      "hexagramName": "大壯",
      "poemText": "亡羊補牢，張氏失牛。騂駟奔走，鵠盜我魚。",
      "sourceParagraphSha256": "sha256:9f35acb51823f910b7495062a56545ce2fc58d482224c7096c7f5669b0ea32fd",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:72bf92518c2566d9691b3a68b69f844f447b3baecee00b65979d1230b3f69e3f"
    },
    {
      "baseHexagramNumber": 44,
      "changedHexagramNumber": 35,
      "sourceEntryNumber": 35,
      "sourceIconHexagramNumber": 35,
      "hexagramName": "晉",
      "poemText": "販鼠賣蛙，利少無謀，難以得家。",
      "sourceParagraphSha256": "sha256:8bba7c6278bb58ab624b7583c07c5ef90298ee75112459515ae73b4f957b4a61",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:2b26fd90bb5fbf895ff1358b3bdb156b4e41cef0c516930061ee2785aafc3a82"
    },
    {
      "baseHexagramNumber": 44,
      "changedHexagramNumber": 36,
      "sourceEntryNumber": 36,
      "sourceIconHexagramNumber": 36,
      "hexagramName": "明夷",
      "poemText": "西戎為秩，幽君去室。陳子發難，項伯成亂。",
      "sourceParagraphSha256": "sha256:4085515b1bf70b2a85d5e40f4425dead7824ef6cb3948e9dbc2302e8d7069e0a",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:d2b4a6d8e502424ca6693147a541debfd06b42e94f9ee6afd3658f326d264c3d"
    },
    {
      "baseHexagramNumber": 44,
      "changedHexagramNumber": 37,
      "sourceEntryNumber": 37,
      "sourceIconHexagramNumber": 37,
      "hexagramName": "家人",
      "poemText": "秋風生哀，花落心悲。公室多難，羊舌氏衰。",
      "sourceParagraphSha256": "sha256:14030a56c8e27dc360cfcd69d111f21fb8619edd501e6cebc762ec27cbda6c77",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:c20f0944bd1d90035c97eeba98b5b864a2b473c37de89cebaef7ed74f8d8493c"
    },
    {
      "baseHexagramNumber": 44,
      "changedHexagramNumber": 38,
      "sourceEntryNumber": 38,
      "sourceIconHexagramNumber": 38,
      "hexagramName": "睽",
      "poemText": "持福厭患，去除大殘。日長夜盡，嘉世蒙恩。",
      "sourceParagraphSha256": "sha256:a06fc3f658df3031085a74e282528210850c27676d8ca0bc1502b10efab0c520",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:1a5644cd59ea7e0fc6f9304b7fe0a767c792f72ea3bca0254346e46d749d097e"
    },
    {
      "baseHexagramNumber": 44,
      "changedHexagramNumber": 39,
      "sourceEntryNumber": 39,
      "sourceIconHexagramNumber": 39,
      "hexagramName": "蹇",
      "poemText": "新受大喜，福履重來。樂且日富，足用豐財。",
      "sourceParagraphSha256": "sha256:2ba0e8478abf877c6f36adf1f601a143b06510ea11aa80c32d205aeeda1801ec",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:f18ad1f1a6249154cb63d39b987a82ef4e535468f3054d1bd9f25ed23e315822"
    },
    {
      "baseHexagramNumber": 44,
      "changedHexagramNumber": 40,
      "sourceEntryNumber": 40,
      "sourceIconHexagramNumber": 40,
      "hexagramName": "解",
      "poemText": "前頓卻躓，左跌右逆。登高安梯，復反來歸。",
      "sourceParagraphSha256": "sha256:fc784d339dde8044cbee1ee083493821da99b41231ffe01af696e12653bf8186",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:c3b0c66ebcb3ddab900bbf6addc81257dc204fef81b5f218e30d47698ac02eea"
    },
    {
      "baseHexagramNumber": 44,
      "changedHexagramNumber": 41,
      "sourceEntryNumber": 41,
      "sourceIconHexagramNumber": 41,
      "hexagramName": "損",
      "poemText": "夢飯不飽，酒來入口。嬰女難好，媒應不許。",
      "sourceParagraphSha256": "sha256:37764083e352329ef608714da6ff79d5c0fe54962203e56e9c7c254d270a6eaf",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:aa18767d19c52fe1cf0145104b524a0df394e1a904d31451eff4737a184aca61"
    },
    {
      "baseHexagramNumber": 44,
      "changedHexagramNumber": 42,
      "sourceEntryNumber": 42,
      "sourceIconHexagramNumber": 42,
      "hexagramName": "益",
      "poemText": "大都王市，稠人多寶。公孫宜買，資禍萬倍。",
      "sourceParagraphSha256": "sha256:cfd4a4a26ed98f912d3a8fc4ae81e592af969021d76d1e5a9c48cc9b7d83fa4b",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:f11924b8e66671b3d8688480ebe61ecaf469929759d840e02d0b60806566e2c0"
    },
    {
      "baseHexagramNumber": 44,
      "changedHexagramNumber": 43,
      "sourceEntryNumber": 43,
      "sourceIconHexagramNumber": 43,
      "hexagramName": "夬",
      "poemText": "兩人俱醉，相與悖戾。心乖不同，爭訟恟恟。",
      "sourceParagraphSha256": "sha256:1d6b79aa545f6c38fdf874462d194bedf27913af26cd2c4cb98970ff4dec58dd",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:98cfd5c12166a0d18fc710d36133241084b41ae466d31ae915972b84a4d9b649"
    },
    {
      "baseHexagramNumber": 44,
      "changedHexagramNumber": 45,
      "sourceEntryNumber": 45,
      "sourceIconHexagramNumber": 45,
      "hexagramName": "萃",
      "poemText": "身無頭足，超蹠庶乖。不能遠中，之道疲休。失利後市。",
      "sourceParagraphSha256": "sha256:63e8ff2da228c9eafdbc95512f861303bebe45231cd6cbb78b1b207b22ffea6f",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:6e70ba50df6bf894e006473182fee2187929267171c04e7cc23ed151f079682f"
    },
    {
      "baseHexagramNumber": 44,
      "changedHexagramNumber": 46,
      "sourceEntryNumber": 46,
      "sourceIconHexagramNumber": 46,
      "hexagramName": "升",
      "poemText": "三人俱行，六目光明。道逢淑女，與我驥子。",
      "sourceParagraphSha256": "sha256:a54e638e88b69beda0492a672fae448ea73242ea188941cbe7d3204fcb110de1",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:7321a1d845e593e42340654267375b7dfa3c6d1e2aaa3a091148a4dad67eb9bf"
    },
    {
      "baseHexagramNumber": 44,
      "changedHexagramNumber": 47,
      "sourceEntryNumber": 47,
      "sourceIconHexagramNumber": 47,
      "hexagramName": "困",
      "poemText": "進士為官，不若復田，獲壽保年。",
      "sourceParagraphSha256": "sha256:3fba39179f8efb0f48c9d59e840425c3af55f881d7ef1ad90644f0cfe843e797",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:9c355ac2b19aa69533a837fbfb54006b61b70fd8c6aed3a36fcaa616a4f0d5b9"
    },
    {
      "baseHexagramNumber": 44,
      "changedHexagramNumber": 48,
      "sourceEntryNumber": 48,
      "sourceIconHexagramNumber": 48,
      "hexagramName": "井",
      "poemText": "先易後否，失我所市。騷蘇自苦，思吾故事。",
      "sourceParagraphSha256": "sha256:36f8797ba05aa5447d395195186a0ebf878513e49f918a907417cc579dbf8c38",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:8b14c7cbda9f67f9a647f7cc1cfcbcf95dd422a87fa7dd6b0d0dbec4676c576e"
    },
    {
      "baseHexagramNumber": 44,
      "changedHexagramNumber": 49,
      "sourceEntryNumber": 49,
      "sourceIconHexagramNumber": 49,
      "hexagramName": "革",
      "poemText": "蘇秦發言，韓魏無患。張子馳說，燕齊以安。",
      "sourceParagraphSha256": "sha256:a671b32f2220d260bacc49f1606c586e00bd28d02ba05d4c6f0be42dc62d3fd9",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:9f4556acd6b3216469791f827e8f12c092729cc80b19c3b626b10c482dd83b6f"
    },
    {
      "baseHexagramNumber": 44,
      "changedHexagramNumber": 50,
      "sourceEntryNumber": 50,
      "sourceIconHexagramNumber": 50,
      "hexagramName": "鼎",
      "poemText": "武庫軍府，甲兵所聚。非里邑居，不可舍止。",
      "sourceParagraphSha256": "sha256:324f8f2591256e64237472091c320eeb2cb242d1af0abc8876c805053738f083",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:14bbf7f431c266f59719fd8352f087848ade659b7b47a41906d77613c8e32b63"
    },
    {
      "baseHexagramNumber": 44,
      "changedHexagramNumber": 51,
      "sourceEntryNumber": 51,
      "sourceIconHexagramNumber": 51,
      "hexagramName": "震",
      "poemText": "三桃三口，莫適所與。為孺子牛，西氏生咎。",
      "sourceParagraphSha256": "sha256:3ebe14d5c827273c40d780f87b1790ee1976de0fb5df619a22be921f598caedf",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:56a4901464d3f96e7f8427d70b9774bf42a2156ccfd8a8cf29177a420cea1737"
    },
    {
      "baseHexagramNumber": 44,
      "changedHexagramNumber": 52,
      "sourceEntryNumber": 52,
      "sourceIconHexagramNumber": 52,
      "hexagramName": "艮",
      "poemText": "西山東山，各自止安。雖相登望，竟不同堂。",
      "sourceParagraphSha256": "sha256:bcac7c5949bcf894773aecebe18a95a381f8d26a0a2f8d30683fca10fa96d92b",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:c4d675ef2ce9754cbfe0b351216dbe1b3ef5940e566632c7cc5234ad780ee4c5"
    },
    {
      "baseHexagramNumber": 44,
      "changedHexagramNumber": 53,
      "sourceEntryNumber": 53,
      "sourceIconHexagramNumber": 53,
      "hexagramName": "漸",
      "poemText": "不改柯葉，和氣沖適。君子所在，安無怵惕。",
      "sourceParagraphSha256": "sha256:24efec22aa3c8947fc752a8da6de3f90f126d098088822c1ec0afcbedbc4bd4a",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:e3f24774cd19d38e46b8ff278464f9f7d6c3dbc63938df1a9219f98fbb82f729"
    },
    {
      "baseHexagramNumber": 44,
      "changedHexagramNumber": 54,
      "sourceEntryNumber": 54,
      "sourceIconHexagramNumber": 54,
      "hexagramName": "歸妹",
      "poemText": "將戌繫亥，陽藏不起。君子散亂，大上危殆。",
      "sourceParagraphSha256": "sha256:a1823c000cacf8e5e271949b08b2faa9b3c24e7adf734e37f0b8222d0bff1fee",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:f0c898598c3742ce3cc73c646bd0eea4db76bf0471efaf038c1a4908ad06b96c"
    },
    {
      "baseHexagramNumber": 44,
      "changedHexagramNumber": 55,
      "sourceEntryNumber": 55,
      "sourceIconHexagramNumber": 55,
      "hexagramName": "豐",
      "poemText": "天官列宿，五神舍室。宮闕完堅，君安其居。",
      "sourceParagraphSha256": "sha256:d21b321cc89eaf09caee1e5330a0e41d126245a032b83cb94ba22ec5864dba36",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:a8d7e20d5716213924b0eba5820fda93454745f221a5b5e8812fbba5a9747a03"
    },
    {
      "baseHexagramNumber": 44,
      "changedHexagramNumber": 56,
      "sourceEntryNumber": 56,
      "sourceIconHexagramNumber": 56,
      "hexagramName": "旅",
      "poemText": "左手把水，如光與鬼，不可得徙。",
      "sourceParagraphSha256": "sha256:996f6b97bada4f96cfc07eb2f67a474ab9d3c201ff5a76003481fca83087b298",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:37da71ebd2877516f011f78860de78903a51706d8fa15c50961f7c982d6a8796"
    },
    {
      "baseHexagramNumber": 44,
      "changedHexagramNumber": 57,
      "sourceEntryNumber": 57,
      "sourceIconHexagramNumber": 57,
      "hexagramName": "巽",
      "poemText": "逐狐東山，水遏我前。深不可涉，失利後便。",
      "sourceParagraphSha256": "sha256:20024e6cb17b023e5b9292b728b52b6fc7138389766fb7884409508d8bbe7338",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:e41d77104e8486e8482f01e6abf600ff1cff96661e18a805f5a448abf3a9fdda"
    },
    {
      "baseHexagramNumber": 44,
      "changedHexagramNumber": 58,
      "sourceEntryNumber": 58,
      "sourceIconHexagramNumber": 58,
      "hexagramName": "兌",
      "poemText": "水瀆魚室，來灌吾邑。衝破我家，與狗俱游。",
      "sourceParagraphSha256": "sha256:590db395ffac263880e45decff191093018fbbcbc740e26538e4a224a727fa1d",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:3ff59068f228ee13ac6e455056496d2cd330eb45da17dfaa79e62f39b42ba281"
    },
    {
      "baseHexagramNumber": 44,
      "changedHexagramNumber": 59,
      "sourceEntryNumber": 59,
      "sourceIconHexagramNumber": 59,
      "hexagramName": "渙",
      "poemText": "山險難登，澗中多石。車馳轊繫，重載傷軸。擔負善躓，跌踒右足。",
      "sourceParagraphSha256": "sha256:2bd271fa5e1079d0d8f077207857780e981f0409c3db8eeb769a9491442e7bf9",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:9b7e7782baf77f898adce3b005aed46f86e4215c2ea5c9d5debfbf9bfe8a8bb5"
    },
    {
      "baseHexagramNumber": 44,
      "changedHexagramNumber": 60,
      "sourceEntryNumber": 60,
      "sourceIconHexagramNumber": 60,
      "hexagramName": "節",
      "poemText": "槽空無實，豚彘不食。庶民屈竭，離其居室。",
      "sourceParagraphSha256": "sha256:70b63fd678df378803850541c3784cc2831a27a6cad406f9ec98c91142b0ba3b",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:2d777cce7d19c6eadd011cba872451fd076510a95bf0a8c4ead60adff1cc2f04"
    },
    {
      "baseHexagramNumber": 44,
      "changedHexagramNumber": 61,
      "sourceEntryNumber": 61,
      "sourceIconHexagramNumber": 61,
      "hexagramName": "中孚",
      "poemText": "執熱爛手，大為災咎。公孫無賴，敗我王室。",
      "sourceParagraphSha256": "sha256:dd2b8edd1af9512722481c9288084f5f1ef923c86f6ea558762d01cbb7cb65f3",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:4f9fdc7fb54921c15e01182480cf3870bfb7fae55183fe7cf32ec2cc6fdb684d"
    },
    {
      "baseHexagramNumber": 44,
      "changedHexagramNumber": 62,
      "sourceEntryNumber": 62,
      "sourceIconHexagramNumber": 62,
      "hexagramName": "小過",
      "poemText": "三虎上山，更相噬囓。心志不親，如仇如怨。",
      "sourceParagraphSha256": "sha256:057a6c202e80505bdedb6a71c49cd8eded6702fe68fcce7f102fbf695ad5eb24",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:3f425f615ba3ec1f4b0ed533dcb80a0e067ac8c30d7f3b2dfde411bf5a659e68"
    },
    {
      "baseHexagramNumber": 44,
      "changedHexagramNumber": 63,
      "sourceEntryNumber": 63,
      "sourceIconHexagramNumber": 63,
      "hexagramName": "既濟",
      "poemText": "西家嫁女，借鄰送女。嘉我淑姬，賓主俱喜。",
      "sourceParagraphSha256": "sha256:acaecb5369fdcfec03b9615de20276d74d39b5e18f74ac6e17fcb342ed4452a5",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:4510407937e4a85df4a57ba2cae1765a6da2a5821f022a6600eb936aaf27033c"
    },
    {
      "baseHexagramNumber": 44,
      "changedHexagramNumber": 64,
      "sourceEntryNumber": 64,
      "sourceIconHexagramNumber": 64,
      "hexagramName": "未濟",
      "poemText": "克身潔己，逢禹巡狩。錫我元圭，拜受福祉。",
      "sourceParagraphSha256": "sha256:4540fd7d002d01b1be979809537c13df8a603f4fe74eb0679b265c2d3a922e86",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:255a22365c7f9a44e3382ffbd44d89fb51ff4d0cdd84489ab5e306b0c2a441e9"
    }
  ]
}
