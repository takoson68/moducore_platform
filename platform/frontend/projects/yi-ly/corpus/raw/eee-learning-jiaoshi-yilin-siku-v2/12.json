  "attribution": "來源：《焦氏易林》，易學網《焦氏易林［四庫全書版］》（依據版本：《欽定四庫全書》子部術數類），https://www.eee-learning.com/book/giauii 。依來源要求標示出處及原網頁連結；本站僅整理林辭原文，並記錄收錄、標點及文字整理修改。",
  "entryCount": 64,
  "missingTargets": [],
  "entries": [
    {
      "baseHexagramNumber": 12,
      "changedHexagramNumber": 12,
      "sourceEntryNumber": 12,
      "sourceIconHexagramNumber": 12,
      "hexagramName": "否",
      "poemText": "秦為狼虎，與晉爭強。并吞其國，號曰始皇。",
      "sourceParagraphSha256": "sha256:3f0510db2edfdb50bb2e351f09d9c492336ab0763476788fe7e3df3918782a7d",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:30c701a9de6c232fd4c390fc7d60016ff5cdfa6beb155d549fe1153032b14602"
    },
    {
      "baseHexagramNumber": 12,
      "changedHexagramNumber": 1,
      "sourceEntryNumber": 1,
      "sourceIconHexagramNumber": 1,
      "hexagramName": "乾",
      "poemText": "江河淮濟，天之奧府。眾利所聚，可以饒有。樂我君子。",
      "sourceParagraphSha256": "sha256:cdb366d96a26fe7da0c190d0728f7b4bc2e55ddfa38c4d008834846eef0ddbb2",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:0f18a345522d8bd884d04f6a6114bb31e2822818f465568f772453b5f3398c12"
    },
    {
      "baseHexagramNumber": 12,
      "changedHexagramNumber": 2,
      "sourceEntryNumber": 2,
      "sourceIconHexagramNumber": 2,
      "hexagramName": "坤",
      "poemText": "天之所災，凶不可居。轉徙獲福，留止憂危。",
      "sourceParagraphSha256": "sha256:8596864552c54fa7d604077291675a71ad8aacc1d51126a404217c99714bb0bb",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:e43bb592d0d951955c61f74e210ac38311ac884c02ea49e61776ddb2e755b713"
    },
    {
      "baseHexagramNumber": 12,
      "changedHexagramNumber": 3,
      "sourceEntryNumber": 3,
      "sourceIconHexagramNumber": 3,
      "hexagramName": "屯",
      "poemText": "名成德就，項領不試。景公耋老，尼父逝去。",
      "sourceParagraphSha256": "sha256:ae29009f8a1f79541b06318895f03d5e96394368dae5d661503cbb874c7e4b33",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:2b216dee4e0a38b56e44209202913585c587276286e610cd060ee928d70b742d"
    },
    {
      "baseHexagramNumber": 12,
      "changedHexagramNumber": 4,
      "sourceEntryNumber": 4,
      "sourceIconHexagramNumber": 4,
      "hexagramName": "蒙",
      "poemText": "持善避惡，福祿常存。雖有豺虎，不能危患。",
      "sourceParagraphSha256": "sha256:1c90d1ba2d0a6b073d9ff8d84edc2d3b98038315dc83a3408e9c94dbdd586a22",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:65c3d1956e325ce4983dec90ec6efaf009e6fbb22385519433895262c74b2e36"
    },
    {
      "baseHexagramNumber": 12,
      "changedHexagramNumber": 5,
      "sourceEntryNumber": 5,
      "sourceIconHexagramNumber": 5,
      "hexagramName": "需",
      "poemText": "避患東西，反入禍門。糟糠不足，憂動我心。",
      "sourceParagraphSha256": "sha256:c1369296325559e479414e2dc1a3cca86ea809a323f0b8af9dfef9fa381ac12e",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:1ea86328a4f0c9bad585306f0ee601826256d7b7859784562a763d16f58e2bb8"
    },
    {
      "baseHexagramNumber": 12,
      "changedHexagramNumber": 6,
      "sourceEntryNumber": 6,
      "sourceIconHexagramNumber": 6,
      "hexagramName": "訟",
      "poemText": "珪璧琮璋，執贄見王。百里甯戚，應聘齊秦。",
      "sourceParagraphSha256": "sha256:f186ce316f624180658411ad0e52f094fcae9605ad7c1d05b8660086fa0d7344",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:d475a6c5b335f491d2294ef7a40d9685b59536c3d13c6d3ef039e0037e86a673"
    },
    {
      "baseHexagramNumber": 12,
      "changedHexagramNumber": 7,
      "sourceEntryNumber": 7,
      "sourceIconHexagramNumber": 7,
      "hexagramName": "師",
      "poemText": "揚水潛鑿，使石潔白。衣素表朱，戲遊皋沃。得君所願，心志娛樂。",
      "sourceParagraphSha256": "sha256:e939037d785bd6c9154341cc68f31f8090097d4148446b3dec353900767e16a2",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:5357a5e6edb268e714124780aaf710bb7f3e4aabba9fa4039771b825eb260c33"
    },
    {
      "baseHexagramNumber": 12,
      "changedHexagramNumber": 8,
      "sourceEntryNumber": 8,
      "sourceIconHexagramNumber": 8,
      "hexagramName": "比",
      "poemText": "官爵相保，居之無咎。求免不得，使伯恨悔。",
      "sourceParagraphSha256": "sha256:87b5479f2bec28e345111f1e5ee59a3a125b608c074416e362493e631732e35e",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:f904bffbfc7a9056351ecf5399ad8e8180733e2b4804ade0b65ea07abb43b58b"
    },
    {
      "baseHexagramNumber": 12,
      "changedHexagramNumber": 9,
      "sourceEntryNumber": 9,
      "sourceIconHexagramNumber": 9,
      "hexagramName": "小畜",
      "poemText": "載車無褌，裸裎出門。小兒作笑，君子憂患。",
      "sourceParagraphSha256": "sha256:7ac39c45f4c5c5631598e195618e74a8dc0295cd9f15402a0572f9e320096588",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:2f96b7ffd64c39e3feb8e51b78363196bd59abcd0265ff6e39d879d7972e8c38"
    },
    {
      "baseHexagramNumber": 12,
      "changedHexagramNumber": 10,
      "sourceEntryNumber": 10,
      "sourceIconHexagramNumber": 10,
      "hexagramName": "履",
      "poemText": "把珠入口，為我利寶。得吾所有，欣然嘉喜。",
      "sourceParagraphSha256": "sha256:0e5214286e9a317181104c5dcd3e0a00cfea2f120528f2bea6eddd9d6afb8752",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:65e00547dbcc854624588b77005e2e57c8968ae7212eea0bc6896dbab906057e"
    },
    {
      "baseHexagramNumber": 12,
      "changedHexagramNumber": 11,
      "sourceEntryNumber": 11,
      "sourceIconHexagramNumber": 11,
      "hexagramName": "泰",
      "poemText": "行不如止，直不可曲。進不如退，可以安吉。",
      "sourceParagraphSha256": "sha256:94eaa67aaaadb404c10481a2f4d83951347547f5b26f4fbf794426aa8971a457",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:fabf7212fe6c09feff12dfe35a22ee2c05471f9ff87b8e49024d39fffdea6c60"
    },
    {
      "baseHexagramNumber": 12,
      "changedHexagramNumber": 13,
      "sourceEntryNumber": 13,
      "sourceIconHexagramNumber": 13,
      "hexagramName": "同人",
      "poemText": "眾鬼瓦聚，中有大怪。九身無頭，魂驚魄去。不可以居。",
      "sourceParagraphSha256": "sha256:0a966a82e8e707fc7ed2a8e03b72579f30654b46cf118f6060a22001364e14ce",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:6a0860e71714409a0b69d6aa1e887102a21f29de52c1e5906d546e68751ba744"
    },
    {
      "baseHexagramNumber": 12,
      "changedHexagramNumber": 14,
      "sourceEntryNumber": 14,
      "sourceIconHexagramNumber": 14,
      "hexagramName": "大有",
      "poemText": "家給人足，頌聲並作。四夷賓服，干戈橐閣。",
      "sourceParagraphSha256": "sha256:a830e11f686eb7d10d2171362b4c45afbdddca96fe66f5e07a6f76efa52fd974",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:3a7d51d4e1aeb136027c3ad8f510b95b56572a0df02fccc49465d49657a51a18"
    },
    {
      "baseHexagramNumber": 12,
      "changedHexagramNumber": 15,
      "sourceEntryNumber": 15,
      "sourceIconHexagramNumber": 15,
      "hexagramName": "謙",
      "poemText": "人面鬼口，長舌如斧。斲破瑚璉，殷商絕祀。",
      "sourceParagraphSha256": "sha256:c0e694db586b7a332ccd5ee61aba3a0b16fd67d07561a20d9c2c7613ef7eda9c",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:03b44fe2ebf021e3adf47063cdeddd3018360ebae073142347f0234e768250cd"
    },
    {
      "baseHexagramNumber": 12,
      "changedHexagramNumber": 16,
      "sourceEntryNumber": 16,
      "sourceIconHexagramNumber": 16,
      "hexagramName": "豫",
      "poemText": "南山之峻，真人所在。德配唐虞，天命為子。保佑飲享，身受大慶。",
      "sourceParagraphSha256": "sha256:0bc03d0b1de8edcb46250840bf6efb253a44115b6c58c1de22391a8dd299cf3d",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:d5c434cbd9051afa47a17c10013cab72730060bf416cc6bea1d8379c3af910ad"
    },
    {
      "baseHexagramNumber": 12,
      "changedHexagramNumber": 17,
      "sourceEntryNumber": 17,
      "sourceIconHexagramNumber": 17,
      "hexagramName": "隨",
      "poemText": "春桃生花，季女宜家。受福多年，男為邦君。",
      "sourceParagraphSha256": "sha256:0d0285f4f45c8e1a4eaa92259f0a5054c7769528b37efa44b84a88651dde5ca1",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:96f48e9ef2eec19db6c297fffddad2b44fc1350e32ed7a2909d1b9ce9a3760ad"
    },
    {
      "baseHexagramNumber": 12,
      "changedHexagramNumber": 18,
      "sourceEntryNumber": 18,
      "sourceIconHexagramNumber": 18,
      "hexagramName": "蠱",
      "poemText": "鴟鴞破斧，沖人危殆。賴其忠德，轉禍為福。傾危復立。",
      "sourceParagraphSha256": "sha256:0c9cd38743f2188ba40030458c9573af2d8650e391fb34ce62307a2a660d5958",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:d4c7c3a86bd884dd86827dc92c674a4c8c5db7d9c3ee1b62c7f53a935bb51ea0"
    },
    {
      "baseHexagramNumber": 12,
      "changedHexagramNumber": 19,
      "sourceEntryNumber": 19,
      "sourceIconHexagramNumber": 19,
      "hexagramName": "臨",
      "poemText": "猿墮高木，不踒手足。保我金玉，還歸其室。",
      "sourceParagraphSha256": "sha256:80658045c3614ccd7187ef667dde7b7809417b1213447f4b22225e24f1c78601",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ab1454aee0a592d0a246801d879b9d694377d8b6fc51fda3beb11adbfd0d511d"
    },
    {
      "baseHexagramNumber": 12,
      "changedHexagramNumber": 20,
      "sourceEntryNumber": 20,
      "sourceIconHexagramNumber": 20,
      "hexagramName": "觀",
      "poemText": "天之奧隅，堯舜所居。可以存身，保我邦家。",
      "sourceParagraphSha256": "sha256:134e4ebff880b199f2e13b1c04485b29a5ce0b2f1f7d2785f8d7c880e6b1a787",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:703b825deb70f3b93b46743067409e19f2d61cfee88fc6c0f7ed3f32598d311c"
    },
    {
      "baseHexagramNumber": 12,
      "changedHexagramNumber": 21,
      "sourceEntryNumber": 21,
      "sourceIconHexagramNumber": 21,
      "hexagramName": "噬嗑",
      "poemText": "伯蹇叔盲，足痛難行。終日至暮，不離其鄉。",
      "sourceParagraphSha256": "sha256:02d5c9384efe268795ec883db82df7297e63c888bb7fe21fc5aad30dd90540ea",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:30f6c1b639794bf9d5a63363aeb298c561540763a9387e2e64c6e01b2435e208"
    },
    {
      "baseHexagramNumber": 12,
      "changedHexagramNumber": 22,
      "sourceEntryNumber": 22,
      "sourceIconHexagramNumber": 22,
      "hexagramName": "賁",
      "poemText": "日月相望，光明盛昌。三聖成功，仁德大隆。師之節，蒙之謙。一作蒙之訟）",
      "sourceParagraphSha256": "sha256:c9038b85090024609ec751ad905722dcf8eb944e66883bc5a02b15790bfe219c",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:3b1cbdcd8148250b356d924889144ee752a515057ce41ae1a4593eb0a0546b9d"
    },
    {
      "baseHexagramNumber": 12,
      "changedHexagramNumber": 23,
      "sourceEntryNumber": 23,
      "sourceIconHexagramNumber": 23,
      "hexagramName": "剝",
      "poemText": "桃李花實，纍纍日息。長大成就，甘美可食。為我利福。泰之小過）",
      "sourceParagraphSha256": "sha256:c61d50ae6a1955b5eee882a7faa2f7a7af996958b23a3c0f69efb2f5f0a75c7b",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:a8cb4441d8d415a4925716e911f149b0560d1e11ef885c2e6a780f1d03c564b7"
    },
    {
      "baseHexagramNumber": 12,
      "changedHexagramNumber": 24,
      "sourceEntryNumber": 24,
      "sourceIconHexagramNumber": 24,
      "hexagramName": "復",
      "poemText": "入和出明，動作有光。運轉休息，所為允康。",
      "sourceParagraphSha256": "sha256:ebabc49799dec9836345d952e74f92fea2922fa9c4cfd2454b4e72f4da954b6b",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:d7f7963dfc1b1a9c81447676f955d05f5b52060568dc4307f3bacef1d1b3cd74"
    },
    {
      "baseHexagramNumber": 12,
      "changedHexagramNumber": 25,
      "sourceEntryNumber": 25,
      "sourceIconHexagramNumber": 25,
      "hexagramName": "无妄",
      "poemText": "陰衰老極，陽見其德。履離載光，天下昭明。功業不長，蝦蟆大王",
      "sourceParagraphSha256": "sha256:dc4b71637e0048305590f71e76ff6480e8cbee766058c247a6ce3c847a7d159f",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:fbf47547e4c5142161845632da0868f2429767462ff720b157126c895167c276"
    },
    {
      "baseHexagramNumber": 12,
      "changedHexagramNumber": 26,
      "sourceEntryNumber": 26,
      "sourceIconHexagramNumber": 26,
      "hexagramName": "大畜",
      "poemText": "行役未巳，新事復起。姬姜勞苦，不得休止。",
      "sourceParagraphSha256": "sha256:af2684db8c7cbf1bacad8082bff91b5d4438231240d1f57919686af13cb5b631",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:722c146d2d2fadac9bae4e7e51b026b2c0ac28e8dcaa254a8295006086f0dc50"
    },
    {
      "baseHexagramNumber": 12,
      "changedHexagramNumber": 27,
      "sourceEntryNumber": 27,
      "sourceIconHexagramNumber": 27,
      "hexagramName": "頤",
      "poemText": "狐鳴室北，飢無所食。困於空丘，莫與同力。",
      "sourceParagraphSha256": "sha256:afcd8035b5ac5aac8978b57cbc3be2d35dd72dfe66e123b8eafba6bf15b389f6",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:703f95537160a480e0e5ad0efdc8c555ec109858c2db3096452abdeac6617c37"
    },
    {
      "baseHexagramNumber": 12,
      "changedHexagramNumber": 28,
      "sourceEntryNumber": 28,
      "sourceIconHexagramNumber": 28,
      "hexagramName": "大過",
      "poemText": "雄聖伏名，人匿麟遠。走鳳飛北，擾亂未息。",
      "sourceParagraphSha256": "sha256:6041574360e66e98354c8ac7d4f72763a3f2757a11f1eedd2bd79f2b8e8e3d0c",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:7c4b3c85e41e7d2eeca305541fcf3bb2a0434704e8941f53bd924d9af6e5d9d7"
    },
    {
      "baseHexagramNumber": 12,
      "changedHexagramNumber": 29,
      "sourceEntryNumber": 29,
      "sourceIconHexagramNumber": 29,
      "hexagramName": "坎",
      "poemText": "疾貧望幸，使伯行販。開牢擇羊，多得大牂。",
      "sourceParagraphSha256": "sha256:05b8c21528b7bdd8e1ebea100b8a041cf1d7643ece9a0b2616ae284e07ee270e",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:fd9e499d08631db76cc877ef9d85492ca458425103fa64576494740a6413ecc2"
    },
    {
      "baseHexagramNumber": 12,
      "changedHexagramNumber": 30,
      "sourceEntryNumber": 30,
      "sourceIconHexagramNumber": 30,
      "hexagramName": "離",
      "poemText": "翕翕 ，隕墜顛崩。滅其令名，長沒不存。",
      "sourceParagraphSha256": "sha256:87c7dda1b75cbe2e7dff9457c7aa38b5aaaf9165eaff9143a4a0549d25dc280c",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:529484f9767ec4b23107cc7e2d27fc1168f91d72ab3599204b2fa97ae1cd34b1"
    },
    {
      "baseHexagramNumber": 12,
      "changedHexagramNumber": 31,
      "sourceEntryNumber": 31,
      "sourceIconHexagramNumber": 31,
      "hexagramName": "咸",
      "poemText": "華薄實槁，衣敝如絡。女巧不成，絲布為玉。",
      "sourceParagraphSha256": "sha256:bf4eabf0f2a76351309da42cba386097963fdd27e0f8eef650b60ea99d823300",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:e327cfa3c724a0b1b37e1b201fbf912dd46116bf98657c71d85a5ef2de501764"
    },
    {
      "baseHexagramNumber": 12,
      "changedHexagramNumber": 32,
      "sourceEntryNumber": 32,
      "sourceIconHexagramNumber": 32,
      "hexagramName": "恒",
      "poemText": "溫山松柏，常茂不落。鸞鳳所庇，得其歡樂。",
      "sourceParagraphSha256": "sha256:6946363f3d32252a8e6f9765ade2207b1e563334dd7e0d46c7eb3edf31a0f8a1",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:9279dd08a4833cb3f6347bf412545c435711275cccae8629d7e4e51bf5095c47"
    },
    {
      "baseHexagramNumber": 12,
      "changedHexagramNumber": 33,
      "sourceEntryNumber": 33,
      "sourceIconHexagramNumber": 33,
      "hexagramName": "遯",
      "poemText": "失持母教，嘉偶出走。攫如失老，如喪家狗。",
      "sourceParagraphSha256": "sha256:5a78f697bba1726fd95774ecadeec26a92f3518bb14a42d9b8dae029938bbd7f",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:065fbcc3b4412f14f6aa07db3983ac9059e06767f3c9d36f900c8edf64345501"
    },
    {
      "baseHexagramNumber": 12,
      "changedHexagramNumber": 34,
      "sourceEntryNumber": 34,
      "sourceIconHexagramNumber": 34,
      "hexagramName": "大壯",
      "poemText": "太乙駕騮，從天上來。徵我季叔，封為魯侯。",
      "sourceParagraphSha256": "sha256:18c9d7e3c94aedf6e287d24181f41b18539429861ac961684bfb86e789b99d94",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:93f98e48f5ab356fba398ea935b8a7b596503d5375eb4559957e1016f8aba90a"
    },
    {
      "baseHexagramNumber": 12,
      "changedHexagramNumber": 35,
      "sourceEntryNumber": 35,
      "sourceIconHexagramNumber": 35,
      "hexagramName": "晉",
      "poemText": "雙鳧俱飛，欲歸稻池。徑涉藿澤，為矢所射。傷我胸臆。屯之旅）",
      "sourceParagraphSha256": "sha256:eea1c5351942417a66d5a4098eb6901b6da056f48d3ffc37881ab995ac9e275c",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:6f786411ebaf2d7cbcc25b1891f16e9143800a77bc304012700cf2142a8905a1"
    },
    {
      "baseHexagramNumber": 12,
      "changedHexagramNumber": 36,
      "sourceEntryNumber": 36,
      "sourceIconHexagramNumber": 36,
      "hexagramName": "明夷",
      "poemText": "深坑復平，天下安寧。意娛心樂，賴福長生。",
      "sourceParagraphSha256": "sha256:a2b7fa4ed97345a2d6ca2e4a134a9303d92a8e1f94a1359c807dc833f41d1ee5",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:541ce58465001c7d4b6187701c9f0986b522632164e503d73b2b3f5649490a74"
    },
    {
      "baseHexagramNumber": 12,
      "changedHexagramNumber": 37,
      "sourceEntryNumber": 37,
      "sourceIconHexagramNumber": 37,
      "hexagramName": "家人",
      "poemText": "俱為天民，雲過吾西。風伯疾雨，與我無恩。",
      "sourceParagraphSha256": "sha256:be17dac524db037fc0863d9b72f180db1bca25bac058c788f0e7d51df4c62d1b",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:1948195943b20d942648a9d1db525e977ecaa876db5e92c66096a2f763ea9b17"
    },
    {
      "baseHexagramNumber": 12,
      "changedHexagramNumber": 38,
      "sourceEntryNumber": 38,
      "sourceIconHexagramNumber": 38,
      "hexagramName": "睽",
      "poemText": "野鳥山鵲，來集六博。三梟四散，主人勝客。",
      "sourceParagraphSha256": "sha256:fc8891b9a7ac240c59c942d74c6ef49c9b8047472a9dc51eb8ce792c2df93f28",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:8ba72d7ed10076c00c52e4fab8ecb90cbe298701818854354d419d120c10cc92"
    },
    {
      "baseHexagramNumber": 12,
      "changedHexagramNumber": 39,
      "sourceEntryNumber": 39,
      "sourceIconHexagramNumber": 39,
      "hexagramName": "蹇",
      "poemText": "北陰司寒，堅冰不溫。凌人惰怠，大雹為災。",
      "sourceParagraphSha256": "sha256:9c48907ee46df68c18a53367ae72862af2c691af92f97f0ae31b3d4f9aef2c67",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:91909298ea30f5e46d75411992827c649b7d9b321e1435095ff7028b0ab26d0e"
    },
    {
      "baseHexagramNumber": 12,
      "changedHexagramNumber": 40,
      "sourceEntryNumber": 40,
      "sourceIconHexagramNumber": 40,
      "hexagramName": "解",
      "poemText": "伊伯致仕，去桀耕野。執順以待，反和無咎。",
      "sourceParagraphSha256": "sha256:b4b865883cc600261e1e62d5e181830209cc6144e4cc0d61838682dccb0a4be3",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:5b697bfc5c03964299d90d3d2017d383f6681c2943b732d173f7f049488447d5"
    },
    {
      "baseHexagramNumber": 12,
      "changedHexagramNumber": 41,
      "sourceEntryNumber": 41,
      "sourceIconHexagramNumber": 41,
      "hexagramName": "損",
      "poemText": "秋風牽手，相提笑語。伯歌季舞，燕樂以喜。",
      "sourceParagraphSha256": "sha256:4ef337f33a98b83ee5353577d875d4e4989ac108fc04fbc885868e2882d12911",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:6a77c3c318c365d1a9224381a220632dd84ba7939006d1cda6be626621c65972"
    },
    {
      "baseHexagramNumber": 12,
      "changedHexagramNumber": 42,
      "sourceEntryNumber": 42,
      "sourceIconHexagramNumber": 42,
      "hexagramName": "益",
      "poemText": "徙巢去家，南過白馬。東西受福，與母相得。",
      "sourceParagraphSha256": "sha256:9d754b7942704dbf276d53516a2d999c297acccd8de68b17d52933475b8f2cac",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:6f82f68ca583943f0625d63de23b407dbbdf633958d5587a753d7385fd1f3af0"
    },
    {
      "baseHexagramNumber": 12,
      "changedHexagramNumber": 43,
      "sourceEntryNumber": 43,
      "sourceIconHexagramNumber": 43,
      "hexagramName": "夬",
      "poemText": "鳥飛跌跛，兩兩相和。不病四肢，但去莫疑。",
      "sourceParagraphSha256": "sha256:f8ebfa8bfa322cf3d479837574613accba092a3afa03994e9b084d304e6e9ef3",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:dca52994758b32a6eb22dc9112d2751fa8a2a591925f1b43f34dc5d88550889d"
    },
    {
      "baseHexagramNumber": 12,
      "changedHexagramNumber": 44,
      "sourceEntryNumber": 44,
      "sourceIconHexagramNumber": 44,
      "hexagramName": "姤",
      "poemText": "三年生狗，以戌為母。荊夷上侵，姬伯出走。",
      "sourceParagraphSha256": "sha256:83c880d8b913ea358e93eb31957533e27935467f9cf7d92c028d70f07ff8f08c",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:53387b306303355a330459c8130e4c8e53d5edc65a720a13251d48f506b71fb7"
    },
    {
      "baseHexagramNumber": 12,
      "changedHexagramNumber": 45,
      "sourceEntryNumber": 45,
      "sourceIconHexagramNumber": 45,
      "hexagramName": "萃",
      "poemText": "破筐敝筥，棄捐於道。壞落穿敗，不復所寶。",
      "sourceParagraphSha256": "sha256:b123ec61b9b437418e488a3727be1c50f1cace7a3ce5341795e3ead4e589d073",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:590698341c5acc607c7783cd97793e9a6aa73843bf62e4bd3338b1f5bb5744a5"
    },
    {
      "baseHexagramNumber": 12,
      "changedHexagramNumber": 46,
      "sourceEntryNumber": 46,
      "sourceIconHexagramNumber": 46,
      "hexagramName": "升",
      "poemText": "結紉得解，憂不為禍。食利僊家，受福安坐。",
      "sourceParagraphSha256": "sha256:1725064bc7004d60d45ea1ae6f674076721512edfe1ac5a0c7cf98e7aacd5219",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:1d03275728e25a7c6b7acddaf7de258a315df45e0df6a504af7dcefcf7de0c50"
    },
    {
      "baseHexagramNumber": 12,
      "changedHexagramNumber": 47,
      "sourceEntryNumber": 47,
      "sourceIconHexagramNumber": 47,
      "hexagramName": "困",
      "poemText": "白日揚光，雷車避藏。雲雨不行，各自還鄉。",
      "sourceParagraphSha256": "sha256:0be777dd8f3d27bfa0a9875a42897077c508bc2def2fe5d1635a3d65ad0b8257",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:acc2e36a4846f77140e0c15db9be25f53753de99b4e1fc61610b5dc15ae80903"
    },
    {
      "baseHexagramNumber": 12,
      "changedHexagramNumber": 48,
      "sourceEntryNumber": 48,
      "sourceIconHexagramNumber": 48,
      "hexagramName": "井",
      "poemText": "杜口結舌，心中怫鬱。去災生患，無所告冤。",
      "sourceParagraphSha256": "sha256:47d3eeb6329f756c9f10a2cfb26c50c9a76a4d0e3498eb53a0204cda9442c998",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:5b7e48d77354c208f6565a12f5d11b9e5f3e3be5000578a656b429905be69f2c"
    },
    {
      "baseHexagramNumber": 12,
      "changedHexagramNumber": 49,
      "sourceEntryNumber": 49,
      "sourceIconHexagramNumber": 49,
      "hexagramName": "革",
      "poemText": "齎貝贖狸，不聽我辭。繫於虎鬚，牽不得來。",
      "sourceParagraphSha256": "sha256:40a1ca09f15daef11068c4d0535738901316bb608007867331743de42a71e704",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:5736044c886365c2eb3863a079c6a9b15ae50937e94ec18f59042eccb8aa90dc"
    },
    {
      "baseHexagramNumber": 12,
      "changedHexagramNumber": 50,
      "sourceEntryNumber": 50,
      "sourceIconHexagramNumber": 50,
      "hexagramName": "鼎",
      "poemText": "如鶴抱子，見蛇何咎。室家俱在，不失其所。",
      "sourceParagraphSha256": "sha256:f20aa53e3f2a3fbb6ccecd469a0d1c89034471b21b4e4dc081141aee563ea829",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:e5849dc860d849674c0c6560207897841318b885214fd0fbc246992e0c6965a4"
    },
    {
      "baseHexagramNumber": 12,
      "changedHexagramNumber": 51,
      "sourceEntryNumber": 51,
      "sourceIconHexagramNumber": 51,
      "hexagramName": "震",
      "poemText": "逐兔山西，利走入門。賴我仁德，獲為我福。",
      "sourceParagraphSha256": "sha256:1425d0f1dd0390cb8dcb52615b47a544ab782916eafebe22bc632bcfdc886025",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:bb0fc207a6e62c46e5524a16f5cf3a488b02dcb90385508825a21d90aa2aef00"
    },
    {
      "baseHexagramNumber": 12,
      "changedHexagramNumber": 52,
      "sourceEntryNumber": 52,
      "sourceIconHexagramNumber": 52,
      "hexagramName": "艮",
      "poemText": "興役不休，與民爭時。牛生五趾，行危為憂。",
      "sourceParagraphSha256": "sha256:9bc345df31bfdffaa0858c97068d3aa89eac1658d0865121f5bafc7aa14bbdd4",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:76ea2fbd6e812495bf061553ea39a2a7de0cae0e92331f5c16b02615346bb239"
    },
    {
      "baseHexagramNumber": 12,
      "changedHexagramNumber": 53,
      "sourceEntryNumber": 53,
      "sourceIconHexagramNumber": 53,
      "hexagramName": "漸",
      "poemText": "春栗夏梨，少鮮希有。斗千石萬，貴不可求。",
      "sourceParagraphSha256": "sha256:2c69360ecbc3d51ac91caffe6d9dab7d1a0ee203703eb9ed63a981194a9b35cb",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:5fe5b6863232ce1c015d1db171e65dbdd3e0b48a91000b5c5cf8f0c59d8004d7"
    },
    {
      "baseHexagramNumber": 12,
      "changedHexagramNumber": 54,
      "sourceEntryNumber": 54,
      "sourceIconHexagramNumber": 54,
      "hexagramName": "歸妹",
      "poemText": "悲號北行，失其長兄。伯仲不幸，骸骨敗亡。",
      "sourceParagraphSha256": "sha256:bef9aaf29d42deecdabd21f3ac26b81a1f580d3a5cd1e7dbd6db7bc38ab71a3e",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:f67e2722a78c479e9c15d7bb015b6339a55ecf3e332aabbe4e07ee1b493c1898"
    },
    {
      "baseHexagramNumber": 12,
      "changedHexagramNumber": 55,
      "sourceEntryNumber": 55,
      "sourceIconHexagramNumber": 55,
      "hexagramName": "豐",
      "poemText": "賦斂重數，政為民賊。杼軸空盡，家去其室。",
      "sourceParagraphSha256": "sha256:1603016fdb4e4d79cfeb5eb0269a4230c169214ed5b51959e9700c61ac855d7b",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:a143f9031492873c078b55b93c2b15752d190bb3211e83e73c0ed53c3ccf43d5"
    },
    {
      "baseHexagramNumber": 12,
      "changedHexagramNumber": 56,
      "sourceEntryNumber": 56,
      "sourceIconHexagramNumber": 56,
      "hexagramName": "旅",
      "poemText": "履服自敝，殃咎並到，憂不能笑。",
      "sourceParagraphSha256": "sha256:9129dcf5a2eccdb5802b4df6aa0729496e07411ece74d6e205dd91156c26999c",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:cb008810ae9f6b663b8fa17cb6f8285c3e57edafa69033d83a3e487f2ec6ce2d"
    },
    {
      "baseHexagramNumber": 12,
      "changedHexagramNumber": 57,
      "sourceEntryNumber": 57,
      "sourceIconHexagramNumber": 57,
      "hexagramName": "巽",
      "poemText": "杜口結舌，言為禍母。代伯受患，無所禱免。",
      "sourceParagraphSha256": "sha256:f6c478238188ff52466c69ed0f545a326c91feb7b0dd1af1cd252b1c9c062a16",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:1a9f5fa8d0e45144b329b49fe93e5f4e3e51fbbecc47d173e34d666fd4db6210"
    },
    {
      "baseHexagramNumber": 12,
      "changedHexagramNumber": 58,
      "sourceEntryNumber": 58,
      "sourceIconHexagramNumber": 58,
      "hexagramName": "兌",
      "poemText": "免冠進賢，步出朝門。儀體不正，賊孽為患。",
      "sourceParagraphSha256": "sha256:10be1bee508cb5af7418fbc42be09fc8e09f09bf8af8758018f1624ec453c9b9",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:fa8a233889ceb34961a4970de969058ec03e06047e42e334c80da1eec3efe4f2"
    },
    {
      "baseHexagramNumber": 12,
      "changedHexagramNumber": 59,
      "sourceEntryNumber": 59,
      "sourceIconHexagramNumber": 59,
      "hexagramName": "渙",
      "poemText": "娶於姜女，駕迎新婦。少妻在門，之子悅喜。",
      "sourceParagraphSha256": "sha256:ab61c2aafc7ea1142769ccff68845891a97ea248008402b151f8ae975775b362",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:1f0cef97da901b889a1225abb7f35e076d3f601fde9ab1757af49ba13d745a8f"
    },
    {
      "baseHexagramNumber": 12,
      "changedHexagramNumber": 60,
      "sourceEntryNumber": 60,
      "sourceIconHexagramNumber": 60,
      "hexagramName": "節",
      "poemText": "牧羊稻園，聞虎喧讙。畏恐悚息，終無禍患。",
      "sourceParagraphSha256": "sha256:b02f8b60c45391dfee58cb010b6148b283bf70c655ddc95b167221ccad1b7e0f",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:06c84e457578f2061ba0e9fd59efa98376e09852dc23d7a072e476fc7dca14be"
    },
    {
      "baseHexagramNumber": 12,
      "changedHexagramNumber": 61,
      "sourceEntryNumber": 61,
      "sourceIconHexagramNumber": 61,
      "hexagramName": "中孚",
      "poemText": "老妾踞機，緯絕不知。女功不成，冬寒無衣。",
      "sourceParagraphSha256": "sha256:4e25798a2b0b3be7a9be4809f0eaba4bca3bc8329565f972a7b32e6bc0b368f1",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:8bfb757bcaf40173a012bd4e09ca42d220946ce1f91d66baa27578cef333a66a"
    },
    {
      "baseHexagramNumber": 12,
      "changedHexagramNumber": 62,
      "sourceEntryNumber": 62,
      "sourceIconHexagramNumber": 62,
      "hexagramName": "小過",
      "poemText": "黑龍吐光，使陰復陽。熊獵載聖，六師以昌。",
      "sourceParagraphSha256": "sha256:9e072b7e512360e1d85e8eea27805f9ba2f316caa15544aee33cf94d825f7eb6",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:a1bf169169ddf7c921f17aac68f1b022bc95c93b86f43fa8a9da757421b7f3d1"
    },
    {
      "baseHexagramNumber": 12,
      "changedHexagramNumber": 63,
      "sourceEntryNumber": 63,
      "sourceIconHexagramNumber": 63,
      "hexagramName": "既濟",
      "poemText": "東鄰嫁女，為王妃后。莊公築館，以尊王母。歸於京師，姬姜悅喜。",
      "sourceParagraphSha256": "sha256:be18bdcf9f2f60624013c9f860e2daadab21ebca6b49fe97b233bb989c58bf74",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:e688a50ac9fa495fb3d99895e1c998b027ac38b09ef8a67665d0573c20a7fe64"
    },
    {
      "baseHexagramNumber": 12,
      "changedHexagramNumber": 64,
      "sourceEntryNumber": 64,
      "sourceIconHexagramNumber": 64,
      "hexagramName": "未濟",
      "poemText": "灌頡同徒，道頓跌踦。日辰不良，病為身禍。",
      "sourceParagraphSha256": "sha256:065e7489964cfe906d74dd7a95efbfa3d104584cd37e6ad165eb4f8c85c538e8",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:d29fa488451f6f236818192e26ed4d07174e2c46004eda116b1e682d4f259d6f"
    }
  ]
}
