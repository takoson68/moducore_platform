  "attribution": "來源：《焦氏易林》，易學網《焦氏易林［四庫全書版］》（依據版本：《欽定四庫全書》子部術數類），https://www.eee-learning.com/book/giauii 。依來源要求標示出處及原網頁連結；本站僅整理林辭原文，並記錄收錄、標點及文字整理修改。",
  "entryCount": 64,
  "missingTargets": [],
  "entries": [
    {
      "baseHexagramNumber": 4,
      "changedHexagramNumber": 4,
      "sourceEntryNumber": 4,
      "sourceIconHexagramNumber": 4,
      "hexagramName": "蒙",
      "poemText": "何草不黃，至未盡玄。室家分離，悲愁於心。",
      "sourceParagraphSha256": "sha256:c688da58d13f956bedea40622ee173da8f48989a28a90b1ca510e758bacb45e6",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:a464afda3611a0aed9b64d71e3772bab34dffda3fd36dc95a374de4399ec6d8e"
    },
    {
      "baseHexagramNumber": 4,
      "changedHexagramNumber": 1,
      "sourceEntryNumber": 1,
      "sourceIconHexagramNumber": 1,
      "hexagramName": "乾",
      "poemText": "海為水王，聰聖且明。百流歸德，無有畔逆。常饒優足。",
      "sourceParagraphSha256": "sha256:ebf3b034f9cd0a857f38a4ef095829d75f13d463d0f085ff312c0d7088a6066c",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:589bae223c7785a19787198247b2e0781ddfbc1d958b35165625373a323c0285"
    },
    {
      "baseHexagramNumber": 4,
      "changedHexagramNumber": 2,
      "sourceEntryNumber": 2,
      "sourceIconHexagramNumber": 2,
      "hexagramName": "坤",
      "poemText": "天之所佑，禍不過家。左輔右弼，金玉滿匱。常盈不亡，富如廒倉。",
      "sourceParagraphSha256": "sha256:b54a0bb5e5eac0fe85b0e419af93fbc72332612ee30ece2627953490f67bbbf2",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:06b295e00d4d36514ae5e021f7c033984ee202198a1c66cae1d1e9d3165312b0"
    },
    {
      "baseHexagramNumber": 4,
      "changedHexagramNumber": 3,
      "sourceEntryNumber": 3,
      "sourceIconHexagramNumber": 3,
      "hexagramName": "屯",
      "poemText": "安息康居，異國穹廬。非吾習俗，使我心憂。",
      "sourceParagraphSha256": "sha256:697ca73b50f31d21a3e90fb6b52679b54b2ea0cdc3a47ee63e7450577ed0175a",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:31234adfbbb6b16cf5a7af8715c394f59df774910fb75697ea74966fa558ea3d"
    },
    {
      "baseHexagramNumber": 4,
      "changedHexagramNumber": 5,
      "sourceEntryNumber": 5,
      "sourceIconHexagramNumber": 5,
      "hexagramName": "需",
      "poemText": "范公陶夷，善賈飾資。東之營丘，易字子皮。把珠載金，多福利歸。",
      "sourceParagraphSha256": "sha256:927f00a6ac25c34831adc42f453ba5ce0eed6588fd81b5d59a0a16c9a01d2503",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:2cead9a551a8ebede397545e5280d85db3f805655852bb3f6b1346de284480fd"
    },
    {
      "baseHexagramNumber": 4,
      "changedHexagramNumber": 6,
      "sourceEntryNumber": 6,
      "sourceIconHexagramNumber": 6,
      "hexagramName": "訟",
      "poemText": "老楊日衰，條多枯枝。爵級不造，遂乃摧隤。",
      "sourceParagraphSha256": "sha256:68ea1ae84f7619edbce0cebff41958a7665d0af85880ebc92708699027c7ee0c",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:d301c23bd743352b84e6e4305af03678304bd0e0cb5c7cf76f03c278e018d981"
    },
    {
      "baseHexagramNumber": 4,
      "changedHexagramNumber": 7,
      "sourceEntryNumber": 7,
      "sourceIconHexagramNumber": 7,
      "hexagramName": "師",
      "poemText": "小狐渡水，汙濡其尾。稍得其幾，與道合符。",
      "sourceParagraphSha256": "sha256:2a2c2365f6f029f972fa2dcd65c1a9b0fe4b660d64164f3f9155b93be484d2fa",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:e0926b633e13c11995a855482d4cad8ab16c8ce790861e86f72c6a60aa6f4e00"
    },
    {
      "baseHexagramNumber": 4,
      "changedHexagramNumber": 8,
      "sourceEntryNumber": 8,
      "sourceIconHexagramNumber": 8,
      "hexagramName": "比",
      "poemText": "豕生如魴，鼠舞庭堂。雄俟施姜，上下昏黃。君失其邦。",
      "sourceParagraphSha256": "sha256:f964acc0ee72b4392a109a6abb10f1855bcfd7dfa9094a5feddf0c68b887600e",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:c01d79bad892e3ede8de8468211bf82b5a9443cb9d4b44bdc4fb94de112e15b4"
    },
    {
      "baseHexagramNumber": 4,
      "changedHexagramNumber": 9,
      "sourceEntryNumber": 9,
      "sourceIconHexagramNumber": 9,
      "hexagramName": "小畜",
      "poemText": "天地配享，六位光明。陰陽順序，以成厥功。",
      "sourceParagraphSha256": "sha256:71e1824c3023fc29d191be93ae5d9db667a16b26924b7caed92ccea2b0a4004e",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:617b9c004527b4bc8fb30a8b02e55df7b50e3ac7f62601404705dd4f0e995843"
    },
    {
      "baseHexagramNumber": 4,
      "changedHexagramNumber": 10,
      "sourceEntryNumber": 10,
      "sourceIconHexagramNumber": 10,
      "hexagramName": "履",
      "poemText": "踝踵足傷，右指病癰。失旅後時，利不走歸。",
      "sourceParagraphSha256": "sha256:7aeaecc447880ebc618617c608c051ef8dc645b462df7bb28e2f753e0792e3f3",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:6befa3c7bf79e02430400686e7d0cf6933783bfc075d6d5007a8802ab9c54e51"
    },
    {
      "baseHexagramNumber": 4,
      "changedHexagramNumber": 11,
      "sourceEntryNumber": 11,
      "sourceIconHexagramNumber": 11,
      "hexagramName": "泰",
      "poemText": "思體同恩，各有所屬。西鄰孤媼，欲寄我室。主母罵詈，求子不得。",
      "sourceParagraphSha256": "sha256:68fa8be210b324a74e11f1e16215ff14b718bfa547392a8b0fd2ee99ce3a465c",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:19a39ca73b04d8a3bdbce5bb5682df19a4575f4140642984bc25bc9ae98a8e82"
    },
    {
      "baseHexagramNumber": 4,
      "changedHexagramNumber": 12,
      "sourceEntryNumber": 12,
      "sourceIconHexagramNumber": 12,
      "hexagramName": "否",
      "poemText": "操鄉畝，祈貸稷黍。飲食充中，安和无咎。",
      "sourceParagraphSha256": "sha256:776ff7d0bd41e71063e02207b733611a4fbcebef7132684752d1256fcde39f8a",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:f7cc429754f5ba87574bda022bb6356810b6bfcb275a603030ac820e54cec00b"
    },
    {
      "baseHexagramNumber": 4,
      "changedHexagramNumber": 13,
      "sourceEntryNumber": 13,
      "sourceIconHexagramNumber": 13,
      "hexagramName": "同人",
      "poemText": "新受大寵，福祿重來。樂且日富，蒙慶得財。",
      "sourceParagraphSha256": "sha256:7992063fdde5a061e6c10a18534547f412f9293167b1e0ee4d048371c18f76e2",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:64353a4f981554cf7b6bd8cac313252001d154bc37dd9d834a2c72a05d45311b"
    },
    {
      "baseHexagramNumber": 4,
      "changedHexagramNumber": 14,
      "sourceEntryNumber": 14,
      "sourceIconHexagramNumber": 14,
      "hexagramName": "大有",
      "poemText": "舉盃飲酒，指宜失取。無益溫寒，亡利不懽。",
      "sourceParagraphSha256": "sha256:447721e4e95cf6e6babdac8d27e4c2cd3d7f58fd7255b8fd5d3d567fb5b42e14",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:3296b4d09f0d334cf041d2aeac5989155f9507abe4752508b2607f8ef25c2358"
    },
    {
      "baseHexagramNumber": 4,
      "changedHexagramNumber": 15,
      "sourceEntryNumber": 15,
      "sourceIconHexagramNumber": 15,
      "hexagramName": "謙",
      "poemText": "日月相望，光明盛昌。三聖茂承，功德大隆。",
      "sourceParagraphSha256": "sha256:3cf777dcf2cb6503414aa5d989427d605bd4a3d456b86ef70b4639b5974047b7",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:df4849cdcc560d242cafa9d7643147f42511ad9f39b64c4c70123a8d9836014e"
    },
    {
      "baseHexagramNumber": 4,
      "changedHexagramNumber": 16,
      "sourceEntryNumber": 16,
      "sourceIconHexagramNumber": 16,
      "hexagramName": "豫",
      "poemText": "猾夫爭強，民去其鄉。公孫叔子，戰於城南。",
      "sourceParagraphSha256": "sha256:ecde211245ea7efe1b2fb7f0dfd510ceeb4e660d81036d9379eed28ecfc06648",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:9ee8b5f350bd904133e36fdfb10ed22f2130df177de5a17394262193764eb948"
    },
    {
      "baseHexagramNumber": 4,
      "changedHexagramNumber": 17,
      "sourceEntryNumber": 17,
      "sourceIconHexagramNumber": 17,
      "hexagramName": "隨",
      "poemText": "猿墮高木，不踒手足。保我全生，還歸其室。",
      "sourceParagraphSha256": "sha256:4ea07ab1a3d3b9a3f272143720b0391b48cb66351acc68b69132bd38587bbef4",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:49bc876bfd854952ea8e0f8991f2cae5a05520bed48c589a3814bcf8ac1a0b7c"
    },
    {
      "baseHexagramNumber": 4,
      "changedHexagramNumber": 18,
      "sourceEntryNumber": 18,
      "sourceIconHexagramNumber": 18,
      "hexagramName": "蠱",
      "poemText": "逐狐東山，水過我前。深不可涉，失利後便。",
      "sourceParagraphSha256": "sha256:f9ea4fc8741b6e7ddcd235452687d4a89aaf363b7d3fb4def5646357e500e7ae",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:157864d01ae03c2f2b0c195c9a43201049cb2955baa4d7f29a7b75d7b2ad1100"
    },
    {
      "baseHexagramNumber": 4,
      "changedHexagramNumber": 19,
      "sourceEntryNumber": 19,
      "sourceIconHexagramNumber": 19,
      "hexagramName": "臨",
      "poemText": "鑿井求玉，非卞氏寶。名困身辱，勞無所得。",
      "sourceParagraphSha256": "sha256:45ea1c3526c7a4cab1e737e1dd26847ed3f9e7067f44219ee8c6041a05314ec8",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:f2f4df3fada0ff3e9f5155b60b0f66339b14f859c646583d93a2da4db53ec341"
    },
    {
      "baseHexagramNumber": 4,
      "changedHexagramNumber": 20,
      "sourceEntryNumber": 20,
      "sourceIconHexagramNumber": 20,
      "hexagramName": "觀",
      "poemText": "黃玉溫德，君子所服。甘露溽暑，萬物生茂。",
      "sourceParagraphSha256": "sha256:5a25485ead9a5a0134641e35bfb2fd92c7709f1cd95d2e8abed0ea2788a45ed3",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:81a528c4bf9ee3227e7b0021eb5739cc3db3264e09db0553624a96874aec4b08"
    },
    {
      "baseHexagramNumber": 4,
      "changedHexagramNumber": 21,
      "sourceEntryNumber": 21,
      "sourceIconHexagramNumber": 21,
      "hexagramName": "噬嗑",
      "poemText": "畫龍頭頸，文章不成。甘言美語，說辭無名。",
      "sourceParagraphSha256": "sha256:292b08a4deda12cd21b3f6c73ea0b185a385ad0eb39961445ef4bdb8a2da1312",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:6efa10c36750cfa23e38416accfc670a6b5dca51301189fbb4b5e209fc2f538a"
    },
    {
      "baseHexagramNumber": 4,
      "changedHexagramNumber": 22,
      "sourceEntryNumber": 22,
      "sourceIconHexagramNumber": 22,
      "hexagramName": "賁",
      "poemText": "招禍致凶，來弊我邦。病在手足，不得安息。",
      "sourceParagraphSha256": "sha256:6bf785ce3881bd65854be21fc593aaeb41481ec784f0b344975600d5b77d2539",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:912d5ca5dacee955458c5e716cb92ef8a12fcc16590bce0b944cde3cd7d13519"
    },
    {
      "baseHexagramNumber": 4,
      "changedHexagramNumber": 23,
      "sourceEntryNumber": 23,
      "sourceIconHexagramNumber": 23,
      "hexagramName": "剝",
      "poemText": "履位束勢，靡有絕斃。贊為隸圖，與眾庶伍。",
      "sourceParagraphSha256": "sha256:e946b1988b6c5663a92ab521075bbaac36fb4e620879c3ff36e02a3ec2298781",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:324bb43d629b65257a36fed30b56c792579d4f01c2694fe92541d49a245e912b"
    },
    {
      "baseHexagramNumber": 4,
      "changedHexagramNumber": 24,
      "sourceEntryNumber": 24,
      "sourceIconHexagramNumber": 24,
      "hexagramName": "復",
      "poemText": "獐鹿雉兔，群聚東圃。盧黃白脊，俱往追逐。九齚十得，君子有喜。",
      "sourceParagraphSha256": "sha256:ead8bbc8140e7775f9e8f4f2906edb16bc3ad33003116efeab26877457a8c67a",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:c262c2dca78ff2e5d5cdc78c241a8d0efa11159057ffdb07200a3e6843226b2e"
    },
    {
      "baseHexagramNumber": 4,
      "changedHexagramNumber": 25,
      "sourceEntryNumber": 25,
      "sourceIconHexagramNumber": 25,
      "hexagramName": "无妄",
      "poemText": "織金未成，緯畫無名。長子逐兔，鹿失先路。見利不得。",
      "sourceParagraphSha256": "sha256:0de3955162c1bad85136b0f40bb4e61a78ef29e40521a19eb7fc1148237ba876",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:5a32f05fbf770b09740d53b425cc2362cd8a717177d32c1839e6740415080bf8"
    },
    {
      "baseHexagramNumber": 4,
      "changedHexagramNumber": 26,
      "sourceEntryNumber": 26,
      "sourceIconHexagramNumber": 26,
      "hexagramName": "大畜",
      "poemText": "天厭周德，命與仁國。以禮靖民，兵革休息。",
      "sourceParagraphSha256": "sha256:e26a2810d8e64d979c008ddf781342c96d02e36c670224b52b81dd7027d1fdb1",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:f30677f2a4008af1a8a5651fa60ce87c5f2d2f2b576182882fe88b6d4c191ffb"
    },
    {
      "baseHexagramNumber": 4,
      "changedHexagramNumber": 27,
      "sourceEntryNumber": 27,
      "sourceIconHexagramNumber": 27,
      "hexagramName": "頤",
      "poemText": "重譯買芝，來除我憂。善說遂良，與喜相求。",
      "sourceParagraphSha256": "sha256:cd060c94817d567f342f66e1de8cfb46d8970c249ecdd99dffa908a6025bf45b",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:8400e9a43191778f5cac5c33d370bae4b36e18588b2df37a0386ed2250e6cac0"
    },
    {
      "baseHexagramNumber": 4,
      "changedHexagramNumber": 28,
      "sourceEntryNumber": 28,
      "sourceIconHexagramNumber": 28,
      "hexagramName": "大過",
      "poemText": "膏澤肥壤，人民安樂。宜利俱止，長安富有。",
      "sourceParagraphSha256": "sha256:fe48d75a2c365fe3e3cb4bdf6fc4ee3e7aaf8cd612a6afd7084ea246fcc75f8e",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:a3a86cadd8b5f4a79acce8097cd3ce922c748b7b02c7339c869f908e242fcdb7"
    },
    {
      "baseHexagramNumber": 4,
      "changedHexagramNumber": 29,
      "sourceEntryNumber": 29,
      "sourceIconHexagramNumber": 29,
      "hexagramName": "坎",
      "poemText": "白龍黑虎，起伏暴怒。戰於阪泉，蚩尤敗走。居上不殆，君安其所。",
      "sourceParagraphSha256": "sha256:488e496b321800364b1c26f8ce143a21bf5ea7835ec66637dd1c73be619414e2",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:139ecd0fc8090ba415538e36699550befc30b8ad8293b9164bd852815d9138ad"
    },
    {
      "baseHexagramNumber": 4,
      "changedHexagramNumber": 30,
      "sourceEntryNumber": 30,
      "sourceIconHexagramNumber": 30,
      "hexagramName": "離",
      "poemText": "抱關傳言，聾跛摧筋。破賊無灾，不安其所。",
      "sourceParagraphSha256": "sha256:19672cba51e2b6de5f9d34083c256d05dce95ff2ec46cfceee051a68be999651",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:d8cd6e09c4c570d3cfb05ca1798f4925f3b0d7723f2a4730848c6d528b7ba59e"
    },
    {
      "baseHexagramNumber": 4,
      "changedHexagramNumber": 31,
      "sourceEntryNumber": 31,
      "sourceIconHexagramNumber": 31,
      "hexagramName": "咸",
      "poemText": "憂禍解除，喜至慶來。坐立歡門，與樂為鄰。",
      "sourceParagraphSha256": "sha256:0f238348123c7722ae307db9367a433d6e179b717a84dd40210c7094d109b7df",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:9b5eabb72a0fb82c790dea9534a2a989fe75e2ac8b2f1d57bb911d383d6aed2e"
    },
    {
      "baseHexagramNumber": 4,
      "changedHexagramNumber": 32,
      "sourceEntryNumber": 32,
      "sourceIconHexagramNumber": 32,
      "hexagramName": "恒",
      "poemText": "折鋒載殳，與馬放休。狩軍褒營，天下安寧。",
      "sourceParagraphSha256": "sha256:256243218cad3cbb86deb7db5cefee3749e6389f1400b49b988e148922f54e5b",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:059ed9f5fc3ce275e4568a452fe167f1aba7aeb48f5550adb710561328a776f6"
    },
    {
      "baseHexagramNumber": 4,
      "changedHexagramNumber": 33,
      "sourceEntryNumber": 33,
      "sourceIconHexagramNumber": 33,
      "hexagramName": "遯",
      "poemText": "至德之君，仁政且溫。伊呂股肱，國富長安。",
      "sourceParagraphSha256": "sha256:2417aa404ad82ae5b83b96156afd02111c0e9d708f73de1c39e46e5681d8bc80",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ee99026c230595417b3abf9b8bfaa0f60a2a6637e4d8429a8d26549be8fd2073"
    },
    {
      "baseHexagramNumber": 4,
      "changedHexagramNumber": 34,
      "sourceEntryNumber": 34,
      "sourceIconHexagramNumber": 34,
      "hexagramName": "大壯",
      "poemText": "千里望城，不見青山。老兔蝦蟆，遠絕無家。",
      "sourceParagraphSha256": "sha256:f333d41f40bc98715e33b0aa4cfd4daac1571b07ece3dcdca6beff082a9653ce",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:e3010d902dc9b35b3e856256cf6c184dc310596d2a3f3744fff78ee25c42d389"
    },
    {
      "baseHexagramNumber": 4,
      "changedHexagramNumber": 35,
      "sourceEntryNumber": 35,
      "sourceIconHexagramNumber": 35,
      "hexagramName": "晉",
      "poemText": "有莘季女，為夏妃后。貴夫壽子，母于四海。",
      "sourceParagraphSha256": "sha256:d45ad289bad9852e411c5f1f85200c731585efa80a0b462aeb6345a3de635ccc",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:74e3d17c6c5d85bf6c4a9d59381bc2c5eaafb847cae7dd4356695d6596994e4b"
    },
    {
      "baseHexagramNumber": 4,
      "changedHexagramNumber": 36,
      "sourceEntryNumber": 36,
      "sourceIconHexagramNumber": 36,
      "hexagramName": "明夷",
      "poemText": "不虞之患，禍至無門。奄忽暴卒，痛傷我心。",
      "sourceParagraphSha256": "sha256:5fce3c579db92458617cff91955457bd2888212450da85cfe96098234338892a",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:192e4248a3a06562085e917184a03f76bd05796d9c21d2553d9721e06ae398ea"
    },
    {
      "baseHexagramNumber": 4,
      "changedHexagramNumber": 37,
      "sourceEntryNumber": 37,
      "sourceIconHexagramNumber": 37,
      "hexagramName": "家人",
      "poemText": "飛鷹退去，不食雉雞。憂患心解，君主安居。",
      "sourceParagraphSha256": "sha256:a6858622833979dacc8141016bf413d5e989376d599d3f0988c62d92b652d3da",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:1606298b06b3ba0c3f9bcdb00bed6b2670757a061963aa64099522f27e83716a"
    },
    {
      "baseHexagramNumber": 4,
      "changedHexagramNumber": 38,
      "sourceEntryNumber": 38,
      "sourceIconHexagramNumber": 38,
      "hexagramName": "睽",
      "poemText": "跮蹉側跌，申酉為祟。戌亥滅明，顏子隱藏。",
      "sourceParagraphSha256": "sha256:bb08d16ecc560b27ff24302c553b4af655b514b9950f18e2e97f4d29e2fe0fcd",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:3ce4a22691130e6801a6dabcfb39e9882a6b6e5e0a751c87532ff691b8deb385"
    },
    {
      "baseHexagramNumber": 4,
      "changedHexagramNumber": 39,
      "sourceEntryNumber": 39,
      "sourceIconHexagramNumber": 39,
      "hexagramName": "蹇",
      "poemText": "司錄憑怒，謀議無道。商民失政，殷人乏祀。",
      "sourceParagraphSha256": "sha256:09857c45377ef4c8d7b49973c99f35f5c1a7ea39597b5ecdabcf7d92cf2a6631",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:3ef60183a02316db9497eddcb4ccfb075dfa894029036855097d34a5dcaa2e32"
    },
    {
      "baseHexagramNumber": 4,
      "changedHexagramNumber": 40,
      "sourceEntryNumber": 40,
      "sourceIconHexagramNumber": 40,
      "hexagramName": "解",
      "poemText": "望雞得雛，求馬獲駒。大德生少，有廖從居。",
      "sourceParagraphSha256": "sha256:90af16bb84f2e2553a0a652fb3db271cace409e1eac87b38f59430aa7fe2200a",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:8be274d2fb271f00a8a27c17c44b682d48596c1be37628d0ffead5b5b9dc5197"
    },
    {
      "baseHexagramNumber": 4,
      "changedHexagramNumber": 41,
      "sourceEntryNumber": 41,
      "sourceIconHexagramNumber": 41,
      "hexagramName": "損",
      "poemText": "切切恒恒，如將不活。黍稷之恩，靈輙以存。獲生保年。",
      "sourceParagraphSha256": "sha256:44e32200abc6572252048cb585375de8b4d7f0cc303f42c73953a85aaf227b65",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:2419b4bf277d9ceefa5fc1cae3c20046be6fb0bd38a2d0f46348a6bebb32da16"
    },
    {
      "baseHexagramNumber": 4,
      "changedHexagramNumber": 42,
      "sourceEntryNumber": 42,
      "sourceIconHexagramNumber": 42,
      "hexagramName": "益",
      "poemText": "莫莫輯輯，夜作晝匿。謀議我資，來攻我室。空盡我財，幾無我食。",
      "sourceParagraphSha256": "sha256:189eec81d7d7dcf4d486408badb86ae10d24a674a69793915466968064bc6fdd",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:85603a2de2702e018bc151be5d3a23b36a9557cf09a9da4186aba35ed39f3dc2"
    },
    {
      "baseHexagramNumber": 4,
      "changedHexagramNumber": 43,
      "sourceEntryNumber": 43,
      "sourceIconHexagramNumber": 43,
      "hexagramName": "夬",
      "poemText": "天之所壞，不可強支。眾口遭笑，雖貴必危。",
      "sourceParagraphSha256": "sha256:d7018e1b3dffb3bdcc3b68e350a58834f2e235241c23e2862e193df3c9bdeaec",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:891675e0eb7a03208c307aa63d5264667db4b47942a9b6a745b9775d45b9b657"
    },
    {
      "baseHexagramNumber": 4,
      "changedHexagramNumber": 44,
      "sourceEntryNumber": 44,
      "sourceIconHexagramNumber": 44,
      "hexagramName": "姤",
      "poemText": "目動頰瞤，喜來加身。舉家蒙歡，吉利無殃。",
      "sourceParagraphSha256": "sha256:2508bb048d334b8fa3b906b363e68cee69ff24b1d38441f5a2f1b3bdcc0f1e16",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:9937580350c6ebc2e11336db53d1365d7213a662c454f781a751f9cc30980afc"
    },
    {
      "baseHexagramNumber": 4,
      "changedHexagramNumber": 45,
      "sourceEntryNumber": 45,
      "sourceIconHexagramNumber": 45,
      "hexagramName": "萃",
      "poemText": "黿羹芬香，染指拂裳。口飢打手，公子恨讒。",
      "sourceParagraphSha256": "sha256:9eff0b3546ecaeb49ea95ab0b07216fc217f4f83e96b1226c19bdb60eb2b19f8",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:8ad41fa809b994ac4961465ff0a246f739b851ef9bcf2720ea3e37a5d0302cc8"
    },
    {
      "baseHexagramNumber": 4,
      "changedHexagramNumber": 46,
      "sourceEntryNumber": 46,
      "sourceIconHexagramNumber": 46,
      "hexagramName": "升",
      "poemText": "天福所酆，兆知飛龍。成予得志，六二已興。",
      "sourceParagraphSha256": "sha256:6d7c5790605f2757e26be771169d4e7c96c3487382ea4fca42224d117d58f268",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:c5f687fc6a8dc345b56fd3b4f01d5bfcc8541891572bf49700c3dfc2f3dfe855"
    },
    {
      "baseHexagramNumber": 4,
      "changedHexagramNumber": 47,
      "sourceEntryNumber": 47,
      "sourceIconHexagramNumber": 47,
      "hexagramName": "困",
      "poemText": "氓伯以婚，抱布自媒。棄禮急情，卒罹悔憂。",
      "sourceParagraphSha256": "sha256:206dba8ca444a6dd0fd55e0fe75ec1443566a0041adfb6d947b7a527bbe2e0a4",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:592f734408362b451fe6f0141f2dad7751f3515425bc8247d76bb8a00a0daec6"
    },
    {
      "baseHexagramNumber": 4,
      "changedHexagramNumber": 48,
      "sourceEntryNumber": 48,
      "sourceIconHexagramNumber": 48,
      "hexagramName": "井",
      "poemText": "夏姒親附，心聽悅喜。利以博取，無言不許。",
      "sourceParagraphSha256": "sha256:a65760fb436f965890c6c2e789ba53b7b1365973c54fe4afa2b3bc81134e9240",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:d6379e288e2ea2bff482f95d1a68ab175e837219e9cb7e32b5595397f1a98183"
    },
    {
      "baseHexagramNumber": 4,
      "changedHexagramNumber": 49,
      "sourceEntryNumber": 49,
      "sourceIconHexagramNumber": 49,
      "hexagramName": "革",
      "poemText": "南山旻天，刺政閔身。疾悲無辜，背憎為仇。",
      "sourceParagraphSha256": "sha256:c554ea51b7c097c048d84c7ba75db64c24baaa22807e14c627f64394ce518ca9",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ec52d6e6b0db5da7144e86cc3a9e2f1dc93aa890b247690d31f1fdaabfaa6fde"
    },
    {
      "baseHexagramNumber": 4,
      "changedHexagramNumber": 50,
      "sourceEntryNumber": 50,
      "sourceIconHexagramNumber": 50,
      "hexagramName": "鼎",
      "poemText": "三人為旅，俱歸北海。入門上堂，拜謁王母。勞賜我酒。",
      "sourceParagraphSha256": "sha256:0485f3d983f3aa55daa8ecbe702fdd6db933fec861616a620f58249e6dd6cd64",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:e34c34e91274b4bf6a2aaca47628a286ba2dba476790ed21d4cbdb2a79d2e39b"
    },
    {
      "baseHexagramNumber": 4,
      "changedHexagramNumber": 51,
      "sourceEntryNumber": 51,
      "sourceIconHexagramNumber": 51,
      "hexagramName": "震",
      "poemText": "陽淫旱病，傷害稼穡。喪刈病來，農人無食。",
      "sourceParagraphSha256": "sha256:d7347fc662484053eac948901a3e3b99ad2768b58e13656d4041556afeb6f389",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:40c620ef7255305f0302d8e2c85637c92fa6dc18832020abbdab4845544c6ec5"
    },
    {
      "baseHexagramNumber": 4,
      "changedHexagramNumber": 52,
      "sourceEntryNumber": 52,
      "sourceIconHexagramNumber": 52,
      "hexagramName": "艮",
      "poemText": "攫飯把肉，以就口食。所往必得，無有虛乏。",
      "sourceParagraphSha256": "sha256:d2c72c27e2f28f071367bc5b2cebebe0069c452fbafdfa5e4dd3ffdae17a1de8",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:e84931c205f1029c01c2152eeef357a82f93dc4ae8e6cfb4a57c67e4e6f87ce0"
    },
    {
      "baseHexagramNumber": 4,
      "changedHexagramNumber": 53,
      "sourceEntryNumber": 53,
      "sourceIconHexagramNumber": 53,
      "hexagramName": "漸",
      "poemText": "烏飛無翼，兔走折足。雖欲會同，未得己惑。",
      "sourceParagraphSha256": "sha256:0da332b5c7dea9e174a95ca29f1d0dee733d71960fa49d253851587b05e8d1a0",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:bee65f1dadae7b09d2b4e88009a7da703e287df745e447ad6b9f4da227e13e7f"
    },
    {
      "baseHexagramNumber": 4,
      "changedHexagramNumber": 54,
      "sourceEntryNumber": 54,
      "sourceIconHexagramNumber": 54,
      "hexagramName": "歸妹",
      "poemText": "體重飛難，不得踰關。行坐憂愁，不離室垣。",
      "sourceParagraphSha256": "sha256:fafddede878b931d443aca71ab0a0ba774eb18f416bdab29062f8552bc263218",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:940529c9362d06a6eb6b2152e93dc83ba19cd7068b6c0b912b263b7a78bef010"
    },
    {
      "baseHexagramNumber": 4,
      "changedHexagramNumber": 55,
      "sourceEntryNumber": 55,
      "sourceIconHexagramNumber": 55,
      "hexagramName": "豐",
      "poemText": "四雄並處，人民愁苦。擁兵東西，不得安所。",
      "sourceParagraphSha256": "sha256:15777544f0234e883efe46787e84146895d096f3ee1af34e4ccf1dcd470ac7b8",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:5468d79452e25870e9f780ea1e7e73f48bfb8e947441c3bfc78e75648b7061cc"
    },
    {
      "baseHexagramNumber": 4,
      "changedHexagramNumber": 56,
      "sourceEntryNumber": 56,
      "sourceIconHexagramNumber": 56,
      "hexagramName": "旅",
      "poemText": "譯重開牢，求解己憂。心感乃成，與善俱居。",
      "sourceParagraphSha256": "sha256:cfad91463ed7a41b49032a1b52a0fdcfaee2ef6ea49b98efcda6c239f2beddcb",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:05d0387d82de6fc66317f205c052ea48c7f7bd5d08d9008fdbf3f5556554b526"
    },
    {
      "baseHexagramNumber": 4,
      "changedHexagramNumber": 57,
      "sourceEntryNumber": 57,
      "sourceIconHexagramNumber": 57,
      "hexagramName": "巽",
      "poemText": "患解憂除，王母相予。與喜俱來，使我安居。",
      "sourceParagraphSha256": "sha256:aab1fb7242d9cee65b2cfe105af0d98e4e796805c9bb34152dfaed9140afd2b9",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:5cf6153d9782d51405fea709cedaf9cd1cb8b916c3f44eebacfc687b35874fb3"
    },
    {
      "baseHexagramNumber": 4,
      "changedHexagramNumber": 58,
      "sourceEntryNumber": 58,
      "sourceIconHexagramNumber": 58,
      "hexagramName": "兌",
      "poemText": "冬生不花，老女無家。霜冷蓬室，競為枯株。",
      "sourceParagraphSha256": "sha256:17317f24a92ea9534baa09dff6be5ff2444aaa605237ab9a4c402983aef693bf",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ae348fe189db08b9ee0e3267b928c5745e7e9e03da7f5e9cabda32a1f7ad0248"
    },
    {
      "baseHexagramNumber": 4,
      "changedHexagramNumber": 59,
      "sourceEntryNumber": 59,
      "sourceIconHexagramNumber": 59,
      "hexagramName": "渙",
      "poemText": "震慄恐懼，多所畏惡。行道留難，不可以涉。",
      "sourceParagraphSha256": "sha256:34df47049c691d1e78caaf09164fa257e3bc98c2afc57e69c287217a8caa9c31",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:5e7f03da3b1012adcafb1997d522e67fbe3f4379303479eb75e66e431f41481e"
    },
    {
      "baseHexagramNumber": 4,
      "changedHexagramNumber": 60,
      "sourceEntryNumber": 60,
      "sourceIconHexagramNumber": 60,
      "hexagramName": "節",
      "poemText": "三夫共妻，莫適為雌。子無名氏，翁不可知。",
      "sourceParagraphSha256": "sha256:29c2242877209a507f78e270b740de92d0cb6b892a40c44b52a3bcd07c3d06e4",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:77d39c77033402b7c7420de415a2a05d8ea843cbe98b8e9ef903538a0ad87c7d"
    },
    {
      "baseHexagramNumber": 4,
      "changedHexagramNumber": 61,
      "sourceEntryNumber": 61,
      "sourceIconHexagramNumber": 61,
      "hexagramName": "中孚",
      "poemText": "早凋被霜，花葉不長。非時為灾，家受其殃。",
      "sourceParagraphSha256": "sha256:cca2e9b51332bf8ec20cf140001abf236d453900c85ce8a2719d7218ba04d54c",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:5f3f0ccab9e52c4529ca9247d33dff0a3d425f450c494478c1c5c1fe588a614c"
    },
    {
      "baseHexagramNumber": 4,
      "changedHexagramNumber": 62,
      "sourceEntryNumber": 62,
      "sourceIconHexagramNumber": 62,
      "hexagramName": "小過",
      "poemText": "雉兔之東，狼虎所食。貪饕凶惡，不可止息。",
      "sourceParagraphSha256": "sha256:274ab629c012b0e8644f35f24ef7e36f61c08b56c1cff3bf501b3741c463ab40",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:07aa23bcfb417aa59b51496dcb60e1b516245a74b1df0dad9cac386438170cdd"
    },
    {
      "baseHexagramNumber": 4,
      "changedHexagramNumber": 63,
      "sourceEntryNumber": 63,
      "sourceIconHexagramNumber": 63,
      "hexagramName": "既濟",
      "poemText": "馬驚破車，王墮深溝。身死魂去，離其室廬。",
      "sourceParagraphSha256": "sha256:ef343c0bd21f558acb53cb5193bbe2b5da29f3d25de9d634f9d6a2ff904603e6",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:315145354680a464e08c513edfed8ed4317ad956ad33134945f6f247bc371ea9"
    },
    {
      "baseHexagramNumber": 4,
      "changedHexagramNumber": 64,
      "sourceEntryNumber": 64,
      "sourceIconHexagramNumber": 64,
      "hexagramName": "未濟",
      "poemText": "山林麓藪，兆人所往。鳥獸無禮，使我心苦。",
      "sourceParagraphSha256": "sha256:9c93a828fa7606dcc0082fd3f52aef1c43205a105c8170338bae496c9ae32a1d",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:25f6d095d461bae827cc362f3aa9b91cdce00f8af9d22f4e665c0e50f96ca325"
    }
  ]
}
