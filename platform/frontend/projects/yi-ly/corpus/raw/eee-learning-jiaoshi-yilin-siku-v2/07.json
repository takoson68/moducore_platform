  "attribution": "來源：《焦氏易林》，易學網《焦氏易林［四庫全書版］》（依據版本：《欽定四庫全書》子部術數類），https://www.eee-learning.com/book/giauii 。依來源要求標示出處及原網頁連結；本站僅整理林辭原文，並記錄收錄、標點及文字整理修改。",
  "entryCount": 64,
  "missingTargets": [],
  "entries": [
    {
      "baseHexagramNumber": 7,
      "changedHexagramNumber": 7,
      "sourceEntryNumber": 7,
      "sourceIconHexagramNumber": 7,
      "hexagramName": "師",
      "poemText": "鳥鳴呼子，哺以酒脯。高樓之處，子來歸母。嗇人成功，年歲大有。妒婦無子。",
      "sourceParagraphSha256": "sha256:ea8d7ca4247a6dba36b15fe4fd5fa0558bbcd2df9e0c6f30d3d0b6d85e5ff9bd",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:a25172564c5b8b5e00c8d1f4c23c6d5dc7a50b718de014b24f36fd99be1c33e5"
    },
    {
      "baseHexagramNumber": 7,
      "changedHexagramNumber": 1,
      "sourceEntryNumber": 1,
      "sourceIconHexagramNumber": 1,
      "hexagramName": "乾",
      "poemText": "一簧兩舌，佞言諂語。三姦成虎，曾母投杼。",
      "sourceParagraphSha256": "sha256:81b6a7c53cd4a3ffdb91ea8c01ea0c8a1df58e243e35520194352f6e2e2839bf",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:61b2402801a961cbed44156570241629c3cead63e0811dceae21991098ef7053"
    },
    {
      "baseHexagramNumber": 7,
      "changedHexagramNumber": 2,
      "sourceEntryNumber": 2,
      "sourceIconHexagramNumber": 2,
      "hexagramName": "坤",
      "poemText": "春桃生花，季女宜家。受福且多，在師中吉。男為邦君。",
      "sourceParagraphSha256": "sha256:4fd32b6924d7eac02e7e4da92778dafcee984af7a6133b9fb978bf9479c9ac26",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:b59d815ac3d401032f749210ff8227ea167fb9db82e1009222639f7f40442bfb"
    },
    {
      "baseHexagramNumber": 7,
      "changedHexagramNumber": 3,
      "sourceEntryNumber": 3,
      "sourceIconHexagramNumber": 3,
      "hexagramName": "屯",
      "poemText": "殊類異路，心不相慕。牝牛牡豭，獨無室家。",
      "sourceParagraphSha256": "sha256:1613ec0f3da73729bc8ccde564ac48d0168d8de25790d820c7b2ab0c7117fc8f",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:864c09bcb88b8d1d67f93fcebef2ef67f009afcbe32be607be3651622cc0eef5"
    },
    {
      "baseHexagramNumber": 7,
      "changedHexagramNumber": 4,
      "sourceEntryNumber": 4,
      "sourceIconHexagramNumber": 4,
      "hexagramName": "蒙",
      "poemText": "拆葉蔽目，不見稚叔。三足孤鳥，遠其元夫。",
      "sourceParagraphSha256": "sha256:cb87af6b53ab1a94aa98575fa3bbda8fa09509fb74c37e8932806ab86020fa7b",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:3dbb4887c2f98db148ea74e75f2f52df101aca53dbbe2eed4a57992069f6dce2"
    },
    {
      "baseHexagramNumber": 7,
      "changedHexagramNumber": 5,
      "sourceEntryNumber": 5,
      "sourceIconHexagramNumber": 5,
      "hexagramName": "需",
      "poemText": "雀東求粒，誤入罔域。賴逢君子，脫復歸息。",
      "sourceParagraphSha256": "sha256:312615113f8558e9726540afadb1aaec637623d1a70586f6ec282d966a7c1f62",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:a5235d610680097ead79298e5da8f5aef07618272d6a34a83871457f22cb1f81"
    },
    {
      "baseHexagramNumber": 7,
      "changedHexagramNumber": 6,
      "sourceEntryNumber": 6,
      "sourceIconHexagramNumber": 6,
      "hexagramName": "訟",
      "poemText": "五孫季子，相與孝友。明允篤誠，升擢薦舉。為國藩輔。",
      "sourceParagraphSha256": "sha256:b0529f4c7a19b103eaecb46c3b20b505b2594d475d42ff37b3adc63e5e64ed22",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:c02191d5278481dd1a8a98229ad8e2a343f51547a1cdfebe47c3a2a51e14b731"
    },
    {
      "baseHexagramNumber": 7,
      "changedHexagramNumber": 8,
      "sourceEntryNumber": 8,
      "sourceIconHexagramNumber": 8,
      "hexagramName": "比",
      "poemText": "削木無枝，與子分離。飢寒莫食，獨立哀悲。",
      "sourceParagraphSha256": "sha256:c995f91e887fe4840b9b365dab34a05b0929532dcc7cbd42c530c7bf637be979",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:9f055952ee66e7f6125a2a11d56fbb68aa04d7dfb35f4914bd547989d9e59f04"
    },
    {
      "baseHexagramNumber": 7,
      "changedHexagramNumber": 9,
      "sourceEntryNumber": 9,
      "sourceIconHexagramNumber": 9,
      "hexagramName": "小畜",
      "poemText": "舜升大禹，石夷之野。徵詣王闕，拜治水土。",
      "sourceParagraphSha256": "sha256:85a7199cd257228cff249d124fdf73770d576408bd30eced27fec15de99bd6b6",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:c799fd3391e10de51a247df833b709a6a01d4fc488b1704afa7291a2bc40c112"
    },
    {
      "baseHexagramNumber": 7,
      "changedHexagramNumber": 10,
      "sourceEntryNumber": 10,
      "sourceIconHexagramNumber": 10,
      "hexagramName": "履",
      "poemText": "義不勝情，以欲自營。見利危寵，滅君令名。",
      "sourceParagraphSha256": "sha256:0bdc77f3345b7da738b572ce8f764cb4b1042cb74d07bb447a862335a0e98162",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:a29d72e6c19b4c1c80e931be8743af46ec7ad53970e9d8e1e72053f5e36bd69f"
    },
    {
      "baseHexagramNumber": 7,
      "changedHexagramNumber": 11,
      "sourceEntryNumber": 11,
      "sourceIconHexagramNumber": 11,
      "hexagramName": "泰",
      "poemText": "三人北行，六位光明。道逢淑女，與我驥子。",
      "sourceParagraphSha256": "sha256:7e4bed81b6b69c0b525eecea0d7e232d41889f29836455fecb462ecdaf6f1e9f",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:651bb7369962f394f72f5b2f5314c2409ea2343553a3817eee4f4e36c1375070"
    },
    {
      "baseHexagramNumber": 7,
      "changedHexagramNumber": 12,
      "sourceEntryNumber": 12,
      "sourceIconHexagramNumber": 12,
      "hexagramName": "否",
      "poemText": "羿張烏號，彀射天狼。柱國雄勇，鬥死滎陽。",
      "sourceParagraphSha256": "sha256:5d11765568993d7dcffe7f02f90e21b372198aa6597c137c5ca89fb0dcb4f418",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ec1b07c3dfe85ed9a364eb5c89c7649eaa8a5b3eb695233bbe9a57d5edf49636"
    },
    {
      "baseHexagramNumber": 7,
      "changedHexagramNumber": 13,
      "sourceEntryNumber": 13,
      "sourceIconHexagramNumber": 13,
      "hexagramName": "同人",
      "poemText": "季姬踟躕，結衿待時。終日至暮，百兩不來。",
      "sourceParagraphSha256": "sha256:63016dd8749f4c99ffc02acde08f8908844e110d78a5ca8be2417d370c47c2da",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:35d69524c80fe13733fb9cb4875e3e96ba5bf91eea28bf20afbc4e1ec2d136ad"
    },
    {
      "baseHexagramNumber": 7,
      "changedHexagramNumber": 14,
      "sourceEntryNumber": 14,
      "sourceIconHexagramNumber": 14,
      "hexagramName": "大有",
      "poemText": "鴻鴈翩翩，始若勞苦。炎疫病民，鰥寡愁憂。",
      "sourceParagraphSha256": "sha256:ff62ec8ff0c77b25b482f8c33cc3c88b61efa8d2e2714fd52d24c626809c70ab",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:83ddc7b482c14efb300e14f38b130f00dd89cbd28bb2b18cc8c052b5b79fa79c"
    },
    {
      "baseHexagramNumber": 7,
      "changedHexagramNumber": 15,
      "sourceEntryNumber": 15,
      "sourceIconHexagramNumber": 15,
      "hexagramName": "謙",
      "poemText": "穿胸狗邦，僵離旁舂。天地易紀，日月更始。",
      "sourceParagraphSha256": "sha256:847b8c375654095c9b43665641d4f906e5708f42688cfaeee01c4d542476a7f2",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:00ad53e596ca54112bbb93d3c0bfafc378ccee80bbe5c2eace13abbfb4395a71"
    },
    {
      "baseHexagramNumber": 7,
      "changedHexagramNumber": 16,
      "sourceEntryNumber": 16,
      "sourceIconHexagramNumber": 16,
      "hexagramName": "豫",
      "poemText": "北山有棗，使叔壽考。東嶺多栗，宜行賈市。陸梁雌雉，所至利喜。",
      "sourceParagraphSha256": "sha256:7b414348a31f45f66ca3797619e8e25202062dfaadb4dfd351d4c30fe14a4527",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:59d772af6ef76a195981657ac0a5fd125a34f0c7785bf47c891f2a8935629435"
    },
    {
      "baseHexagramNumber": 7,
      "changedHexagramNumber": 17,
      "sourceEntryNumber": 17,
      "sourceIconHexagramNumber": 17,
      "hexagramName": "隨",
      "poemText": "干旄旌旗，執幟在郊。雖有寶珠，無路致之。",
      "sourceParagraphSha256": "sha256:77855dc2aa4b5ffd904a846bce4f20f2f18633775f91a8e700e9e2c9d9cd3ff3",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:6edcb5d79b7c334c36303a2389bf5ab0e16b7147bc3ce28c78447f910ecbb85c"
    },
    {
      "baseHexagramNumber": 7,
      "changedHexagramNumber": 18,
      "sourceEntryNumber": 18,
      "sourceIconHexagramNumber": 18,
      "hexagramName": "蠱",
      "poemText": "精潔淵塞，為讒所言。證訊詰請，繫於枳溫。甘棠聽斷，怡然蒙恩。",
      "sourceParagraphSha256": "sha256:5861685d212cfbd132ef6f1dd1f8aca8bba136096ef09ac361a6195d0b3bca46",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:45dffa5a771a8de91be80345d3ac99980117a6953125987ab550ad55986a3803"
    },
    {
      "baseHexagramNumber": 7,
      "changedHexagramNumber": 19,
      "sourceEntryNumber": 19,
      "sourceIconHexagramNumber": 19,
      "hexagramName": "臨",
      "poemText": "元黃虺隤，行者勞罷。役夫憔悴，踰時不歸。",
      "sourceParagraphSha256": "sha256:67cbd3991978014f98072ad71afa36cfd31071b7eb132d8ba785af006f3fed56",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:9f38c8dc2adc4b6145e763d2f05171b27bdbf7f358db222789f6a92ab9741e62"
    },
    {
      "baseHexagramNumber": 7,
      "changedHexagramNumber": 20,
      "sourceEntryNumber": 20,
      "sourceIconHexagramNumber": 20,
      "hexagramName": "觀",
      "poemText": "膚敏之德，發憤忘食。虜豹禽越，為王求福。以成主德。",
      "sourceParagraphSha256": "sha256:3a8becb1e9fded8b4f4ac1f599abcf0e89808f9f1d46e917ff92782dd6e91213",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:c19f37255c904157ce1ba8ec61d811e096f561047f50b3d880aa26622fa26bf8"
    },
    {
      "baseHexagramNumber": 7,
      "changedHexagramNumber": 21,
      "sourceEntryNumber": 21,
      "sourceIconHexagramNumber": 21,
      "hexagramName": "噬嗑",
      "poemText": "采庸沫鄉，要我桑中。失信不會，憂思約帶。",
      "sourceParagraphSha256": "sha256:3de671c0cb3c9b9e1354ebea92b6f01fb8d2f389db72631249fe1a16568611be",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:26197920923639553aa368f80d404a1e78ffefcb810425ec9595925f98bb11d5"
    },
    {
      "baseHexagramNumber": 7,
      "changedHexagramNumber": 22,
      "sourceEntryNumber": 22,
      "sourceIconHexagramNumber": 22,
      "hexagramName": "賁",
      "poemText": "伯寧子福，惠我邦國。蠲除苛殘，使季無患。",
      "sourceParagraphSha256": "sha256:485e44300b4deb1a8ec74738569f9706e89e62fbda4723825bcce8b0a4078e6c",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:4e222295204658f481ee28142e2aa5f307c309b29b6dc34d4d3ac03a002da8ff"
    },
    {
      "baseHexagramNumber": 7,
      "changedHexagramNumber": 23,
      "sourceEntryNumber": 23,
      "sourceIconHexagramNumber": 23,
      "hexagramName": "剝",
      "poemText": "讒父佞雄，賊亂邦國。生離忠孝，敗困不福。",
      "sourceParagraphSha256": "sha256:1b23303d31470a1572875820014da8c29fdf3e60013fece5d871b8b38b55258f",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:b4f9558846a7d07af1bc941cd573a8f2a4b408e009e12da3e27fa7345aa2e329"
    },
    {
      "baseHexagramNumber": 7,
      "changedHexagramNumber": 24,
      "sourceEntryNumber": 24,
      "sourceIconHexagramNumber": 24,
      "hexagramName": "復",
      "poemText": "淵泉隄防，水道通利。順注湖海，邦國富有。",
      "sourceParagraphSha256": "sha256:740f358270f97bb1cf3eae38bd2c4067495758304482995546c129a8694f72ea",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:cb2d5a79f5a6b1be94bc41b5a65bd14b3473951e9a3b761ec543c39dc369ebef"
    },
    {
      "baseHexagramNumber": 7,
      "changedHexagramNumber": 25,
      "sourceEntryNumber": 25,
      "sourceIconHexagramNumber": 25,
      "hexagramName": "无妄",
      "poemText": "江旁多蝮，螫我手足。冤繫詰屈，痛徹心腹。",
      "sourceParagraphSha256": "sha256:2bfd5274c1691f35921218a44ff924c7d56843b35283ca7046d25c18a5819046",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:6a5e56b00e74f1211a60464d02ffd9540ae9c14cf32077bbec4126c25c0244a2"
    },
    {
      "baseHexagramNumber": 7,
      "changedHexagramNumber": 26,
      "sourceEntryNumber": 26,
      "sourceIconHexagramNumber": 26,
      "hexagramName": "大畜",
      "poemText": "三人俱行，別離獨宿。一身五心，反覆迷惑。亂無所得。",
      "sourceParagraphSha256": "sha256:5a87619061424caf3aed85617121bac6199596b31744fe485118ba4e3a54d056",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:6ea9ee2653b3f89717b669a804c73b23f20b2904997bfdeb39cdb7cf0109cdb5"
    },
    {
      "baseHexagramNumber": 7,
      "changedHexagramNumber": 27,
      "sourceEntryNumber": 27,
      "sourceIconHexagramNumber": 27,
      "hexagramName": "頤",
      "poemText": "鶩鳴庭中，以戒災凶。重門擊柝，備不速客。",
      "sourceParagraphSha256": "sha256:0231f3f41e681f818c072dbbf589fb10e6ab83e59ee0a5b9bf30704ad89c25e2",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:5859fbca52097febeadf193754d89eaae2a22fba201a870996538f9c461a74ac"
    },
    {
      "baseHexagramNumber": 7,
      "changedHexagramNumber": 28,
      "sourceEntryNumber": 28,
      "sourceIconHexagramNumber": 28,
      "hexagramName": "大過",
      "poemText": "功成事就，拱手安居。立德有言，坐飭貢賦。",
      "sourceParagraphSha256": "sha256:ff430e3064a49466cb025a79ee3ca17ecf6055589cddca0487e58fe9715944f8",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:92c2b5aa090bcbb09bdd7b506cb91d0d4491a26bda0a89f9f922084a70258718"
    },
    {
      "baseHexagramNumber": 7,
      "changedHexagramNumber": 29,
      "sourceEntryNumber": 29,
      "sourceIconHexagramNumber": 29,
      "hexagramName": "坎",
      "poemText": "國亂不安，兵革為患。掠我妻子，家中飢寒。",
      "sourceParagraphSha256": "sha256:acf64642eeacf0f54300d269caf11ffe7e8746ab3866ba0dc03969127be7e4ac",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:b4127afc9ab02cd00a7bccd9e109b28cc7a37f1053fc73b1f94dceb93b6adb5e"
    },
    {
      "baseHexagramNumber": 7,
      "changedHexagramNumber": 30,
      "sourceEntryNumber": 30,
      "sourceIconHexagramNumber": 30,
      "hexagramName": "離",
      "poemText": "戴堯扶禹，從喬彭祖。西遇王母，道路夷易。無敢難者。",
      "sourceParagraphSha256": "sha256:dcedb975b08cae8d52e3dfcf38e46a58cbb34adffcadd0ca82e1d3323fcd3f98",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ca3112909b0467fa84d2e0fbdcb23e109958e17068255c7352e809632a3f427d"
    },
    {
      "baseHexagramNumber": 7,
      "changedHexagramNumber": 31,
      "sourceEntryNumber": 31,
      "sourceIconHexagramNumber": 31,
      "hexagramName": "咸",
      "poemText": "長尾委蛇，畫地成河。深不可涉，絕無以北。惆然嘳思。",
      "sourceParagraphSha256": "sha256:80c88d0c00bfcff4c22ac2300db1376db11c9ae9eca7eca824bfcc5c788575a6",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:0b3d7f700266039c976091734638a39ca20c168071209ab1ae0614a7a313420c"
    },
    {
      "baseHexagramNumber": 7,
      "changedHexagramNumber": 32,
      "sourceEntryNumber": 32,
      "sourceIconHexagramNumber": 32,
      "hexagramName": "恒",
      "poemText": "乘龍從蜺，徵詣北闕。乃見宣室，拜守東域。鎮慰黎元，舉家蒙福。",
      "sourceParagraphSha256": "sha256:42b690a290ac3a9cd61e147576f09e081e99827b566e543a7de21ec14598ea1d",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:492003c98fa1f1e0fd2bc4c8eb8b36547db282b3cb1dd57f7f1f25ebdb11021a"
    },
    {
      "baseHexagramNumber": 7,
      "changedHexagramNumber": 33,
      "sourceEntryNumber": 33,
      "sourceIconHexagramNumber": 33,
      "hexagramName": "遯",
      "poemText": "土與山連，終身無患。天地高明，萬歲長安。",
      "sourceParagraphSha256": "sha256:bab0042d7370e6384103501ccf72b2f8529d36a6593e28693722a5faedaf11a5",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:fbe098cbbcda44f2583e9fb73b0c487c330498543e365fdde9df3e6fe2d89835"
    },
    {
      "baseHexagramNumber": 7,
      "changedHexagramNumber": 34,
      "sourceEntryNumber": 34,
      "sourceIconHexagramNumber": 34,
      "hexagramName": "大壯",
      "poemText": "久旱水涸，枯槁無澤。虛修其德，未有所獲。",
      "sourceParagraphSha256": "sha256:a49bb7e34b356e34155b8bc4b073d5d912ea3a002fb6f10255022647acdd233a",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:c2b006559fb8366c657b50f67d9ac111d5c1103e40104d34e0f628e929c65e78"
    },
    {
      "baseHexagramNumber": 7,
      "changedHexagramNumber": 35,
      "sourceEntryNumber": 35,
      "sourceIconHexagramNumber": 35,
      "hexagramName": "晉",
      "poemText": "依山倚地，凶危不至。上清下降，君受其利。",
      "sourceParagraphSha256": "sha256:2b7d2b120a39ea5a37bc83f64e3a27eb8f7655a5b894e97d84fe169cd53927ec",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:01574ca885e763da70ca67d164c3ebf219e469e6ba025c1c43264323d713dfcb"
    },
    {
      "baseHexagramNumber": 7,
      "changedHexagramNumber": 36,
      "sourceEntryNumber": 36,
      "sourceIconHexagramNumber": 36,
      "hexagramName": "明夷",
      "poemText": "火烈不去，必殪僵仆。燔我衣裾，禍不可悔。",
      "sourceParagraphSha256": "sha256:5783193ad1736e9448e7a7d4921bd5f80dd00f782a8b9ad9a6a26c67f1908803",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:d4a8451d391582f30b188a91a66be0ab271da398ad7f543c0c67c6a5266d3d85"
    },
    {
      "baseHexagramNumber": 7,
      "changedHexagramNumber": 37,
      "sourceEntryNumber": 37,
      "sourceIconHexagramNumber": 37,
      "hexagramName": "家人",
      "poemText": "配合相迎，利之四鄉。欣喜興懌，所言得當。",
      "sourceParagraphSha256": "sha256:40f2380d223b13e5a04cf54c8ce0fc153ae36f84af6b72cb5b804021fa1cb905",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:cb56e903412dbacf119bbbbc8806b83ff44c34680ab9130d3c4a35a000eb3dab"
    },
    {
      "baseHexagramNumber": 7,
      "changedHexagramNumber": 38,
      "sourceEntryNumber": 38,
      "sourceIconHexagramNumber": 38,
      "hexagramName": "睽",
      "poemText": "清人高子，久屯外野。逍遙不歸，思我慈母。",
      "sourceParagraphSha256": "sha256:e48af386d91bfc2d41301dd4e356932dc98984a82c398f770d40f8b375367398",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ca87c900bee02ae912b172fa31b4a17ab20a163343be4491ad7b47e5135d8c48"
    },
    {
      "baseHexagramNumber": 7,
      "changedHexagramNumber": 39,
      "sourceEntryNumber": 39,
      "sourceIconHexagramNumber": 39,
      "hexagramName": "蹇",
      "poemText": "武庫軍府，甲兵所聚。非里邑居，不可舍止。",
      "sourceParagraphSha256": "sha256:4c16c494ea9f04152924b1e08112f20e2c0e598f24b89e0dc175ed48fc2bb8b4",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:14bbf7f431c266f59719fd8352f087848ade659b7b47a41906d77613c8e32b63"
    },
    {
      "baseHexagramNumber": 7,
      "changedHexagramNumber": 40,
      "sourceEntryNumber": 40,
      "sourceIconHexagramNumber": 40,
      "hexagramName": "解",
      "poemText": "王德五材，和合四時。陰陽順序，國無咎災。",
      "sourceParagraphSha256": "sha256:0a4c5548d7769d940bdf6134161818ed6a15c121f18a8e125df6b2138ac1b134",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:43694c4b91deddc2375da30399e153c960d8d5854402373c8b651ae7583bc24d"
    },
    {
      "baseHexagramNumber": 7,
      "changedHexagramNumber": 41,
      "sourceEntryNumber": 41,
      "sourceIconHexagramNumber": 41,
      "hexagramName": "損",
      "poemText": "解衣毛羽，飛入大都。晨門戒守，鄭忽失家。",
      "sourceParagraphSha256": "sha256:9a5d14719d71c87a6089efa5afbadc42d69b661feddc6ed85d76cca406c5a389",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:8a988cf759907d8ab5779e6e99e729d62a0ac06d5f53a81cac26d1b9e9686590"
    },
    {
      "baseHexagramNumber": 7,
      "changedHexagramNumber": 42,
      "sourceEntryNumber": 42,
      "sourceIconHexagramNumber": 42,
      "hexagramName": "益",
      "poemText": "削根燒株，不生肌膚。病在心腹，日以焦枯。",
      "sourceParagraphSha256": "sha256:55c0f89f4085ba4afda26891c5428f3deea6a1e0d0939f0d2b6e7020c5148c91",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:2f85555dfe36716dfd7ce2da62a2ba645a2d194f4d5899df6a4af19b2f6e3dc3"
    },
    {
      "baseHexagramNumber": 7,
      "changedHexagramNumber": 43,
      "sourceEntryNumber": 43,
      "sourceIconHexagramNumber": 43,
      "hexagramName": "夬",
      "poemText": "文山紫芝，雍梁朱草。生長和氣，福祿來處。",
      "sourceParagraphSha256": "sha256:cae521937e59f50036ed4779f66f6fde3b3877f0b44f51e3f7c460c2bd3e95d9",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:e09e2cfb4a3f305c65a0f90cea3e08f00ab1dca5e98c0dbc6225e6cc04aa66ac"
    },
    {
      "baseHexagramNumber": 7,
      "changedHexagramNumber": 44,
      "sourceEntryNumber": 44,
      "sourceIconHexagramNumber": 44,
      "hexagramName": "姤",
      "poemText": "多載重負，捐棄于野。小任其大，但自勞苦。",
      "sourceParagraphSha256": "sha256:0670afed679dc32011c9e9c3407a11bdc520063f07d634fc9949060c25ab5c6e",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:7b014c5400ebf1e2b9b13aed56aa36d86a4d420ab5375f172bfab42279b3d4f1"
    },
    {
      "baseHexagramNumber": 7,
      "changedHexagramNumber": 45,
      "sourceEntryNumber": 45,
      "sourceIconHexagramNumber": 45,
      "hexagramName": "萃",
      "poemText": "鳧雁啞啞，以水為家。雌雄相和，心志娛樂。得其歡欲。",
      "sourceParagraphSha256": "sha256:37e047c6776953ce54fc77aa726ede07d4f626479d6b41bc695019d690d44ad9",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:1b59ee4263d19ef86d98eba09bf49879f4a01baf5b0fad2883eb2fdf1c3e1830"
    },
    {
      "baseHexagramNumber": 7,
      "changedHexagramNumber": 46,
      "sourceEntryNumber": 46,
      "sourceIconHexagramNumber": 46,
      "hexagramName": "升",
      "poemText": "耳目盲聾，所言不通。佇立以泣，事無成功。",
      "sourceParagraphSha256": "sha256:433c520b77f332c4cde7651aae552ff37b9ca36679a233c01181aebb2d65b455",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:c891cd114adc497763da27fd13cc0b5188c5d86835fc3a20be405171f14d25f0"
    },
    {
      "baseHexagramNumber": 7,
      "changedHexagramNumber": 47,
      "sourceEntryNumber": 47,
      "sourceIconHexagramNumber": 47,
      "hexagramName": "困",
      "poemText": "天宮列宿，五神所舍。宮闕堅固，君安其居。",
      "sourceParagraphSha256": "sha256:effd30847fd0ce0dcac04a12a0ac74453bcc88080408b67abe23fdd3c780a417",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:883b731e1cfd3d90ebfca4ccc7990e85c20a70d75df55f730306c1d0b65e9e96"
    },
    {
      "baseHexagramNumber": 7,
      "changedHexagramNumber": 48,
      "sourceEntryNumber": 48,
      "sourceIconHexagramNumber": 48,
      "hexagramName": "井",
      "poemText": "范子妙材，戮辱傷膚。然後相國，封為應侯。",
      "sourceParagraphSha256": "sha256:80eabe2dc125930ff8ad2d3b15b9bfb60c708568b48ba458627b044ba96f3234",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:c91051e08d5ebb70f2368fba0fcdb46737d159c7a153616d1bfe36371e9b7b19"
    },
    {
      "baseHexagramNumber": 7,
      "changedHexagramNumber": 49,
      "sourceEntryNumber": 49,
      "sourceIconHexagramNumber": 49,
      "hexagramName": "革",
      "poemText": "秋冬探巢，不得鵲雛。御指北去，慚我少夫。",
      "sourceParagraphSha256": "sha256:130e34de8f6005c270cc7fa3d6953d3c54c0d9bc6cf3c99bb9cd209ab4054fb2",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:c83e87aa73b325e2fd85c4e50873ace137ad7932b2daf9ca21965a60745dbae1"
    },
    {
      "baseHexagramNumber": 7,
      "changedHexagramNumber": 50,
      "sourceEntryNumber": 50,
      "sourceIconHexagramNumber": 50,
      "hexagramName": "鼎",
      "poemText": "子畏於匡，厄困陳蔡。德行不危，竟脫厄害。",
      "sourceParagraphSha256": "sha256:7bb7952bf1fd7e017a577c92d421975503e7042062a8217d87ac903b6b0beeb2",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:816a33ef7d7ecb6d5fec8c00a1514c6d4f6e66e9c4defef704f2fb8331d4703f"
    },
    {
      "baseHexagramNumber": 7,
      "changedHexagramNumber": 51,
      "sourceEntryNumber": 51,
      "sourceIconHexagramNumber": 51,
      "hexagramName": "震",
      "poemText": "鴻飛在陸，公出不復。仲氏任只，伯氏客宿。",
      "sourceParagraphSha256": "sha256:2a56706df93fe39816ab7bcf9ddcf8f4a37e19d97e71c477cc8f6d4664353a10",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:df7f7f710f5dcf63cc13baafa6ddd34315afd6c9f86cdb48ca29c1e214235a8e"
    },
    {
      "baseHexagramNumber": 7,
      "changedHexagramNumber": 52,
      "sourceEntryNumber": 52,
      "sourceIconHexagramNumber": 52,
      "hexagramName": "艮",
      "poemText": "鶴鳴九皋，避世隱居。抱樸守貞，竟不相隨。",
      "sourceParagraphSha256": "sha256:aa9c4cd83561b61eabfcaee194919f80916dc2ea9012875c6227e3e981c06363",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:9a86a72d2e5c6d17b540cbbbb332e7673520e0b3319c7bde088361aee50f3cea"
    },
    {
      "baseHexagramNumber": 7,
      "changedHexagramNumber": 53,
      "sourceEntryNumber": 53,
      "sourceIconHexagramNumber": 53,
      "hexagramName": "漸",
      "poemText": "舜升大禹，石夷之野。徵詣王闕，拜治水土。",
      "sourceParagraphSha256": "sha256:f732eafbcfd47bc592a89b11fd1a13e5a79acfb4df77de0cb54430c478d12516",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:c799fd3391e10de51a247df833b709a6a01d4fc488b1704afa7291a2bc40c112"
    },
    {
      "baseHexagramNumber": 7,
      "changedHexagramNumber": 54,
      "sourceEntryNumber": 54,
      "sourceIconHexagramNumber": 54,
      "hexagramName": "歸妹",
      "poemText": "左輔右弼，金玉滿匱。常盈不亡，富如 倉。",
      "sourceParagraphSha256": "sha256:049ffac97ea6e2d84655060879f160a9b8e34cebd73cdcbc96512c4e93aebd1a",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:22b6b325fda4b043ad619e206888647c90009418d960d7709e969f0ae79c700a"
    },
    {
      "baseHexagramNumber": 7,
      "changedHexagramNumber": 55,
      "sourceEntryNumber": 55,
      "sourceIconHexagramNumber": 55,
      "hexagramName": "豐",
      "poemText": "崔嵬北嶽，天神貴客。衣冠不已，蒙被恩德。",
      "sourceParagraphSha256": "sha256:c569e5fc58b797791501e3a319bdbd0081d41857f0f9339dd480962cd81ba1bc",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:b7e4956deda8692c45f159ccfa150f54855a1dd21ce0f9e9c26accac1a4428d1"
    },
    {
      "baseHexagramNumber": 7,
      "changedHexagramNumber": 56,
      "sourceEntryNumber": 56,
      "sourceIconHexagramNumber": 56,
      "hexagramName": "旅",
      "poemText": "空槽住豬，彘不到。張弓視雞，雄鳩飛去。",
      "sourceParagraphSha256": "sha256:5d9eba10b23d50bcfccb75f5273514854db4737287aa7f08140e819f72f74b85",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:fb521a6fcca00b60782ff922aa7f307f683ce07acce9b63cbefadd2faa17ff74"
    },
    {
      "baseHexagramNumber": 7,
      "changedHexagramNumber": 57,
      "sourceEntryNumber": 57,
      "sourceIconHexagramNumber": 57,
      "hexagramName": "巽",
      "poemText": "胡蠻戎狄，太陰所積。涸冰凍寒，君子不存。",
      "sourceParagraphSha256": "sha256:ff7ff1e746330e45d664e7c0376746a72442d898e46224f69e69c48f639bc24c",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:d8fd8243a9ed8a5b6a476d5ba655e41daf795ee585f1168734e403e2711093ca"
    },
    {
      "baseHexagramNumber": 7,
      "changedHexagramNumber": 58,
      "sourceEntryNumber": 58,
      "sourceIconHexagramNumber": 58,
      "hexagramName": "兌",
      "poemText": "甘露醴泉，太平機關。仁德感應，歲樂民安。",
      "sourceParagraphSha256": "sha256:834ca6e9567a5b9e5f26a8739a03af20f6bc10fcfa996885bee4527c370bd86b",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:3470f5fbb8955747676dfa44a292e438454755f30e88f79f7bf02df9d64cbe92"
    },
    {
      "baseHexagramNumber": 7,
      "changedHexagramNumber": 59,
      "sourceEntryNumber": 59,
      "sourceIconHexagramNumber": 59,
      "hexagramName": "渙",
      "poemText": "惡來呼伯，煩驚外客。中守閉宅，以備凶黠。臨拆之憂，雖滅無災。",
      "sourceParagraphSha256": "sha256:d5af583e3a0b1be13f6bf71c49c384737b4e8228c9814674096295b9995dea07",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:e3a65c332bd33abeb3be9f307f97212ab584835b6ecf6104251eccdd8e6d3db6"
    },
    {
      "baseHexagramNumber": 7,
      "changedHexagramNumber": 60,
      "sourceEntryNumber": 60,
      "sourceIconHexagramNumber": 60,
      "hexagramName": "節",
      "poemText": "日月相望，光明盛昌。三聖茂功，仁德大隆。",
      "sourceParagraphSha256": "sha256:fbd0c6a9f71db3591d3354d8191eb9e70436519bc7e5ea0a531c5ce1dfc75f50",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:cbfc776ae2a257ee6d4aa1bb2cb5ff55a6011e2f6ca7459fa870b196ba5febd9"
    },
    {
      "baseHexagramNumber": 7,
      "changedHexagramNumber": 61,
      "sourceEntryNumber": 61,
      "sourceIconHexagramNumber": 61,
      "hexagramName": "中孚",
      "poemText": "葛藟蒙棘，花不得實。讒佞亂政，使恩壅塞。",
      "sourceParagraphSha256": "sha256:0e9bf3fc1b900b64434691939a2630596e0dfd61df759bbfd270bd4d54054447",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:122b979cccf165f35460ccdc9992a585f7f5c3c54e53ca4386cdaf9371bf5faa"
    },
    {
      "baseHexagramNumber": 7,
      "changedHexagramNumber": 62,
      "sourceEntryNumber": 62,
      "sourceIconHexagramNumber": 62,
      "hexagramName": "小過",
      "poemText": "鄰不我顧，面望玉女。身多癩疾，誰肯婦者。",
      "sourceParagraphSha256": "sha256:36938019bab80634645a05c27c5adb5f179ecd7071604069c9266a34fac6a9db",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:3da137e12db79316065c5df12ba329eda00b7bf3d58d53e4fdcac92fed9c2775"
    },
    {
      "baseHexagramNumber": 7,
      "changedHexagramNumber": 63,
      "sourceEntryNumber": 63,
      "sourceIconHexagramNumber": 63,
      "hexagramName": "既濟",
      "poemText": "精誠所在，神為之輔。德教尚中，彌世長久。三聖與為，多受福祉。",
      "sourceParagraphSha256": "sha256:832489e0bc284e7be4c15676eea975acb5566ececfe8af09801d35d15fdb89ae",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:7cdbc2da61fedc7985fa4e1581627eea1502c6d838cebea2feb0d1a19c51cad6"
    },
    {
      "baseHexagramNumber": 7,
      "changedHexagramNumber": 64,
      "sourceEntryNumber": 64,
      "sourceIconHexagramNumber": 64,
      "hexagramName": "未濟",
      "poemText": "鑽木取火，掘地索泉。主母飢渴，子為心福。",
      "sourceParagraphSha256": "sha256:2c29a8ee59203089e61c9ec5087209d1162998bda846ed04ae2e826eaade0bc4",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:d39488d05167ebaa512123f7d10844b956244380419bf7dc5d1ca0731d5ef15c"
    }
  ]
}
