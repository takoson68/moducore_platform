  "entryCount": 64,
  "missingTargets": [],
  "entries": [
    {
      "baseHexagramNumber": 17,
      "changedHexagramNumber": 17,
      "sourceEntryNumber": 17,
      "sourceIconHexagramNumber": 17,
      "hexagramName": "隨",
      "poemText": "鳥鳴東西，迎其群侶。似有所屬，不得自專。空返獨還。",
      "sourceParagraphSha256": "sha256:96d1cc47285ca68e4de7100462fdd52c95ecbe9ea04772dce104f5a0027f0ace",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:b1050aead75352cb2af6983c82c627b0fd329158a4f386ae68d8f8ef10e6ba48"
    },
    {
      "baseHexagramNumber": 17,
      "changedHexagramNumber": 1,
      "sourceEntryNumber": 1,
      "sourceIconHexagramNumber": 1,
      "hexagramName": "乾",
      "poemText": "鼻目易處，不知香臭。君迷於事，失其寵位。",
      "sourceParagraphSha256": "sha256:8a9c6a3e816fbcc75e18f930ba7f575da137852552cace870c7fe0a98f19f2cd",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:59670e7b5832f0620646f6446042c7a645baf40b08fdc0fc4de5e26b1dda704b"
    },
    {
      "baseHexagramNumber": 17,
      "changedHexagramNumber": 2,
      "sourceEntryNumber": 2,
      "sourceIconHexagramNumber": 2,
      "hexagramName": "坤",
      "poemText": "唐虞相輔，鳥獸喜舞。安康無事，國家富有。",
      "sourceParagraphSha256": "sha256:d3ede08ab6fb3b4e9f6873324314fc9faae28b8f71332f6cd40a3d89c1154961",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:25d31ae85baed22833b8445db8e44e2733829ee204a34a094d9bd04d9bdcac47"
    },
    {
      "baseHexagramNumber": 17,
      "changedHexagramNumber": 3,
      "sourceEntryNumber": 3,
      "sourceIconHexagramNumber": 3,
      "hexagramName": "屯",
      "poemText": "左輔右弼，金玉滿匱。常盈不亡，富如敖倉。",
      "sourceParagraphSha256": "sha256:fda00f7b46fc96e01ab69d3e9fc5fa1e8e0f9f04de20780e20869f5f6f7a8a95",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:4d8164a047f351356d92c660bc540ec1dc92d08cf71993a9d3b9fa73ce9c688f"
    },
    {
      "baseHexagramNumber": 17,
      "changedHexagramNumber": 4,
      "sourceEntryNumber": 4,
      "sourceIconHexagramNumber": 4,
      "hexagramName": "蒙",
      "poemText": "東龍見獨，與石相觸，摧折兩角。",
      "sourceParagraphSha256": "sha256:035a6ec755446914a9ca2eb4bb9289f717547e899830b1e36784169953ccc312",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:c848764b806d06968d11054bb73697a7b6a152b8e79f030c386b550beb5b422e"
    },
    {
      "baseHexagramNumber": 17,
      "changedHexagramNumber": 5,
      "sourceEntryNumber": 5,
      "sourceIconHexagramNumber": 5,
      "hexagramName": "需",
      "poemText": "釣日厭部，善逐人走。來嫁無夫，不安其廬。",
      "sourceParagraphSha256": "sha256:5ceaab96599aa20dca094c4869e9fefdadd45bf6234c70daf3473969262c1871",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:dd7b1fe3d78c7ea0933098aeb3da528a1d1911390576afe6fc0ccf019cbbf473"
    },
    {
      "baseHexagramNumber": 17,
      "changedHexagramNumber": 6,
      "sourceEntryNumber": 6,
      "sourceIconHexagramNumber": 6,
      "hexagramName": "訟",
      "poemText": "逐兔驅狼，避去不祥。凶惡北行，與善相逢。",
      "sourceParagraphSha256": "sha256:4fb43f050a7ac3fc959de29af5bf6ff8e097b061ef076a10e5104823b87ed2fd",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:a086ab1601c79237fdb91c942d1037ae7fc0e5df0af3a3a1bae1b8bf93965d0a"
    },
    {
      "baseHexagramNumber": 17,
      "changedHexagramNumber": 7,
      "sourceEntryNumber": 7,
      "sourceIconHexagramNumber": 7,
      "hexagramName": "師",
      "poemText": "齎貝贖狸，不聽我辭。繫於虎鬚，牽不得來。",
      "sourceParagraphSha256": "sha256:abc2f7c609e81a45ffa6b2b9294f382f98370765c548fd74750d5716c33ce63e",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:5736044c886365c2eb3863a079c6a9b15ae50937e94ec18f59042eccb8aa90dc"
    },
    {
      "baseHexagramNumber": 17,
      "changedHexagramNumber": 8,
      "sourceEntryNumber": 8,
      "sourceIconHexagramNumber": 8,
      "hexagramName": "比",
      "poemText": "同載共輿，中道別去。喪我元夫，獨與孤居。",
      "sourceParagraphSha256": "sha256:5914a4e42e3e029a351c06a42bff7c2ab86a0bfef2009b0dbb119cb1d2fd1de4",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:09b0b1513ab5e9891748f8c76c325912ce8b563a648d6888bb2f445ee3305146"
    },
    {
      "baseHexagramNumber": 17,
      "changedHexagramNumber": 9,
      "sourceEntryNumber": 9,
      "sourceIconHexagramNumber": 9,
      "hexagramName": "小畜",
      "poemText": "奮翅鼓翼，將之嘉國。愆期失時，乃得所欲。",
      "sourceParagraphSha256": "sha256:d56cbe7b850e9528ff4c6922b6cfe368584285a4997885a9f27e228da4275069",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:859cf80afb1344d1504763f2788cad28d2123def31a91de0959cfc4aadc316df"
    },
    {
      "baseHexagramNumber": 17,
      "changedHexagramNumber": 10,
      "sourceEntryNumber": 10,
      "sourceIconHexagramNumber": 10,
      "hexagramName": "履",
      "poemText": "目傾心惑，夏姬在側。申公顛倒，巫臣亂國。",
      "sourceParagraphSha256": "sha256:6f344656d55dba47654a3423c299519a081683a851543715160caa3bd731a9b2",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:eb7e26dd7b15b413f2598abb798afdc9adde9e4287377930c7c7f04f0b00e854"
    },
    {
      "baseHexagramNumber": 17,
      "changedHexagramNumber": 11,
      "sourceEntryNumber": 11,
      "sourceIconHexagramNumber": 11,
      "hexagramName": "泰",
      "poemText": "搏鳩彈鵲，獵兔山北。丸盡日暮，失獲無得。",
      "sourceParagraphSha256": "sha256:807343dcc8c9f3cd048335ea0cabd8595e5f90adae6e05d2e054a2a9859a17b5",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:fe43912a1eeb85fbcde2b9668c96af7aac199a203d560b6b0c4fb3c367b15e84"
    },
    {
      "baseHexagramNumber": 17,
      "changedHexagramNumber": 12,
      "sourceEntryNumber": 12,
      "sourceIconHexagramNumber": 12,
      "hexagramName": "否",
      "poemText": "鹿求其子，虎廬之里。唐伯李耳，貪不我許。",
      "sourceParagraphSha256": "sha256:5be3e4347da0010fa99eeb6c9e51e8f3e7b607de98fc07cfc489656581845085",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:1841b8b6318acf0a85bf15645eaa6667f93b6925b99cff7eee0f4d3f944ba054"
    },
    {
      "baseHexagramNumber": 17,
      "changedHexagramNumber": 13,
      "sourceEntryNumber": 13,
      "sourceIconHexagramNumber": 13,
      "hexagramName": "同人",
      "poemText": "敗魚鮑室，臭不可息。上山履塗，歸傷我足。",
      "sourceParagraphSha256": "sha256:ccb0fe4bc0230b9ddd162c4d2896d770abba6d2afa16505f26571f4784abf337",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:5a7aa62d61f539df80e22d1f091e299ef86a09f0333158ddda0b52c02bb86dda"
    },
    {
      "baseHexagramNumber": 17,
      "changedHexagramNumber": 14,
      "sourceEntryNumber": 14,
      "sourceIconHexagramNumber": 14,
      "hexagramName": "大有",
      "poemText": "花燈百枝，消暗衰微。精光訖盡，奄有灰飛。",
      "sourceParagraphSha256": "sha256:ac78f3662fb713bbf23cec6c62174fd6491c76b4c45e069f142dab944a95a8a0",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:0848bfc8b69ddab6ecf5b3befa0358e19b749d5187e7f2c7814302294774a2f4"
    },
    {
      "baseHexagramNumber": 17,
      "changedHexagramNumber": 15,
      "sourceEntryNumber": 15,
      "sourceIconHexagramNumber": 15,
      "hexagramName": "謙",
      "poemText": "顏叔子夏，遊遨仁宇。溫良受福，不失其所。",
      "sourceParagraphSha256": "sha256:e171ae270876ddb7906dd5c3768b37227e7d165018e5dc3d5decb058e618b22d",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:3d1e74996ca50f7da58590d49001c4df506e8c50494225def4bd0c69c10ec7e1"
    },
    {
      "baseHexagramNumber": 17,
      "changedHexagramNumber": 16,
      "sourceEntryNumber": 16,
      "sourceIconHexagramNumber": 16,
      "hexagramName": "豫",
      "poemText": "梁柱堅固，子孫蕃熾。福喜盈積，終無禍悔。",
      "sourceParagraphSha256": "sha256:c62a395faa4e6c3a79dca600b6035d99ea011db07bd984e3118dcb0ec2298704",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:946ee386fa6760d6f51fc3387ab40395d272e265da5272171215c6b687df8b1c"
    },
    {
      "baseHexagramNumber": 17,
      "changedHexagramNumber": 18,
      "sourceEntryNumber": 18,
      "sourceIconHexagramNumber": 18,
      "hexagramName": "蠱",
      "poemText": "邊鄙不寧，民狎於野。嗇人成功，年歲大有。",
      "sourceParagraphSha256": "sha256:ecad1d9d48c8a5fa9bb168ff50b23b9cc03829c9d6211037a920e66939dd6005",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:969f4cd966ee85e7d33ca611791ebd5783f9af45712309a293db8cbd94db7ad5"
    },
    {
      "baseHexagramNumber": 17,
      "changedHexagramNumber": 19,
      "sourceEntryNumber": 19,
      "sourceIconHexagramNumber": 19,
      "hexagramName": "臨",
      "poemText": "蝸池鳴呵，呼我水潦。雲雨大會，流成河海。",
      "sourceParagraphSha256": "sha256:a716150b674d70559bec1479b759be09c45734a659fbefc4753c84fee0c7217f",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:48d8215d5b0ce6fc1e01f72172ff902ab5bdb483b8791099bd9179338db162c4"
    },
    {
      "baseHexagramNumber": 17,
      "changedHexagramNumber": 20,
      "sourceEntryNumber": 20,
      "sourceIconHexagramNumber": 20,
      "hexagramName": "觀",
      "poemText": "志合意同，姬姜相從。嘉偶在門，夫子悅喜。",
      "sourceParagraphSha256": "sha256:9d2fa5da70bc7b1bf53c0b6b87d1ec04eeceb0875cc7c549e11f2246f0626383",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:2f80fb60a35c2849fd62315ec39bd7ba2710f21907dc1cc0de0b106862a97801"
    },
    {
      "baseHexagramNumber": 17,
      "changedHexagramNumber": 21,
      "sourceEntryNumber": 21,
      "sourceIconHexagramNumber": 21,
      "hexagramName": "噬嗑",
      "poemText": "白馬騮駮，更生不休。富有商人，利得如丘。",
      "sourceParagraphSha256": "sha256:ead7ec68614aa7adbe8c3693bebb9dec827d650e432b528422832457eb399e50",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:8e5324614729c9fd2a18f79ecc93511d60ca54270f102fc8a7ceae1058be7fec"
    },
    {
      "baseHexagramNumber": 17,
      "changedHexagramNumber": 22,
      "sourceEntryNumber": 22,
      "sourceIconHexagramNumber": 22,
      "hexagramName": "賁",
      "poemText": "大似夏禹，經啟九道。各有攸處，民得安所。",
      "sourceParagraphSha256": "sha256:f313a4edeaccd6304c94fdfc5027c21f81b11da82ffd01ce9091b74508a5590d",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:f0f10942638098200e91b233e976dd33ccb360e5178d33d0aef91850877043cc"
    },
    {
      "baseHexagramNumber": 17,
      "changedHexagramNumber": 23,
      "sourceEntryNumber": 23,
      "sourceIconHexagramNumber": 23,
      "hexagramName": "剝",
      "poemText": "甲戊己庚，隨時轉行。不失其心，唐季發憤。擒滅子嬰。",
      "sourceParagraphSha256": "sha256:610d01d0fa1615a10498adbacd2d5437f8a26bb9e38f9dea40d0ac3cad12e8fd",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:dc3febb93d57adb687febfe7238a35d59e5b5cf2b454ed52a93316f4ebc1127e"
    },
    {
      "baseHexagramNumber": 17,
      "changedHexagramNumber": 24,
      "sourceEntryNumber": 24,
      "sourceIconHexagramNumber": 24,
      "hexagramName": "復",
      "poemText": "穆違百里，使明厲武。將帥襲戰，敗於殽右。",
      "sourceParagraphSha256": "sha256:c3c9932649544f8a672aeffb88bdfb0ed750389e51489ccdf4270343c192b13c",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:23edfae7ddbbf0108a894eec2fb55d3f33d4f1d75b531d09a9efbf07bee2dc16"
    },
    {
      "baseHexagramNumber": 17,
      "changedHexagramNumber": 25,
      "sourceEntryNumber": 25,
      "sourceIconHexagramNumber": 25,
      "hexagramName": "无妄",
      "poemText": "茆如本居，與類相投。願慕群旅，不離其巢。",
      "sourceParagraphSha256": "sha256:8ee4651626a852f1a915d0cf20e6eba59fb897b60c8f362be1bfe8aef2549026",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:79a28808a401ad5ba8f5693fc2709c47c0be868e538a0d204b2418b4c833bf52"
    },
    {
      "baseHexagramNumber": 17,
      "changedHexagramNumber": 26,
      "sourceEntryNumber": 26,
      "sourceIconHexagramNumber": 26,
      "hexagramName": "大畜",
      "poemText": "伯仲叔季，日暮寢寐。坐臥失明，喪其貝囊。",
      "sourceParagraphSha256": "sha256:dfe9d570572dce1f66b9b091ee8aefe83f6f1c8ab151009528f1eb0bb304ad90",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:bfa94e4f1afa5b0a87bf017623878cf229d4cef248f5ec955fbb995662690c71"
    },
    {
      "baseHexagramNumber": 17,
      "changedHexagramNumber": 27,
      "sourceEntryNumber": 27,
      "sourceIconHexagramNumber": 27,
      "hexagramName": "頤",
      "poemText": "亡羊捕牢，張氏失牛。騂駟奔走，鵠盜我魚。",
      "sourceParagraphSha256": "sha256:29cb3c8a09cdc30313c4fd7992aaf7e3ce9a8b177c57d11f6be494d69ff769f7",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:8db1576931d164788d6c7d961872188380438cc7eda62a06c38b26348118ffc3"
    },
    {
      "baseHexagramNumber": 17,
      "changedHexagramNumber": 28,
      "sourceEntryNumber": 28,
      "sourceIconHexagramNumber": 28,
      "hexagramName": "大過",
      "poemText": "雀目燕顙，畏昏無光。思我狡童，不見子充。",
      "sourceParagraphSha256": "sha256:7ed4128855281a4fcb5d369ad9ded3ec5c285edb6f04571546250d25938f945c",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:36661614c4279be08e28ef9ad1579a97d117896683f9b284f5df348e444ca736"
    },
    {
      "baseHexagramNumber": 17,
      "changedHexagramNumber": 29,
      "sourceEntryNumber": 29,
      "sourceIconHexagramNumber": 29,
      "hexagramName": "坎",
      "poemText": "入和出明，動作有光。運轉休息，常樂允康。",
      "sourceParagraphSha256": "sha256:2a65feab1dc71df949ea1783e7e9450b1805226aec84536c946075b67c48542a",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:3d031251439dc59e509eccfe7fb769363cd8660d9407ddeda058a7c245ce542e"
    },
    {
      "baseHexagramNumber": 17,
      "changedHexagramNumber": 30,
      "sourceEntryNumber": 30,
      "sourceIconHexagramNumber": 30,
      "hexagramName": "離",
      "poemText": "不勝私情，以利自嬰。北室出孤，毀其良家。",
      "sourceParagraphSha256": "sha256:d6a3f23e3769418080a489277db99a08655fcf0105b5b920b79fdcc3b132db53",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:92a4fa6db8229b3d451538ff5cd22abfb51cbf11e683fc97b5b8db4f68dfd74f"
    },
    {
      "baseHexagramNumber": 17,
      "changedHexagramNumber": 31,
      "sourceEntryNumber": 31,
      "sourceIconHexagramNumber": 31,
      "hexagramName": "咸",
      "poemText": "稱幸上靈，媚悅於神。受福重重，子孫蕃功。",
      "sourceParagraphSha256": "sha256:4aac774bef8890b3448bb584d617ac882407fbe5edf127911dabcf89ccc8a59a",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:5780f5ef0263f356d71affc99d9efe2de94168287dd29c3d346fc18b2ef55b2d"
    },
    {
      "baseHexagramNumber": 17,
      "changedHexagramNumber": 32,
      "sourceEntryNumber": 32,
      "sourceIconHexagramNumber": 32,
      "hexagramName": "恒",
      "poemText": "齊姜叔子，天命在位。實沈參墟，封為康侯。",
      "sourceParagraphSha256": "sha256:d6123dd4bb9ea252c182fa8f4ea994755434890f063580881d5d0def56f2e9d1",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:3a805a298d649ece30fa25d4e108c23db3c1b3f3eb940c4fc78c2788ea59d659"
    },
    {
      "baseHexagramNumber": 17,
      "changedHexagramNumber": 33,
      "sourceEntryNumber": 33,
      "sourceIconHexagramNumber": 33,
      "hexagramName": "遯",
      "poemText": "遨遊無患，出入安全。長受其懽，君子萬年。",
      "sourceParagraphSha256": "sha256:c113f233ee0128523752121181f3bb69d1bee82f144e339e32c37cf663bd42b4",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:4b140becd623ead3d796be2b36a9e0dd94031d13133f30ebc0f98200c7da720b"
    },
    {
      "baseHexagramNumber": 17,
      "changedHexagramNumber": 34,
      "sourceEntryNumber": 34,
      "sourceIconHexagramNumber": 34,
      "hexagramName": "大壯",
      "poemText": "被服文德，升入大麓。四門雍肅，登受大福。慈烏鳴鳩，執一無尤。寢門內治，君子悅喜。",
      "sourceParagraphSha256": "sha256:4b14f0097641c9f8c280a8f8f727fdcff07a5f220ddd52cf04c6fc0e37bab715",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:9f46f232fd39b08d012eb4331d09e2add12e8b3a1589b8e96b143570763889d6"
    },
    {
      "baseHexagramNumber": 17,
      "changedHexagramNumber": 35,
      "sourceEntryNumber": 35,
      "sourceIconHexagramNumber": 35,
      "hexagramName": "晉",
      "poemText": "負金懷玉，南歸嘉國。蜂蠆不螫，利入我室。",
      "sourceParagraphSha256": "sha256:d1d01e5dd8367b8031366dc111842141b3dd74d088970f8eb7aa1b60906a5f49",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:25784e99f4d9ee96c561515064e4d8e10449903f41c3108af62c08ce97cc53f6"
    },
    {
      "baseHexagramNumber": 17,
      "changedHexagramNumber": 36,
      "sourceEntryNumber": 36,
      "sourceIconHexagramNumber": 36,
      "hexagramName": "明夷",
      "poemText": "日在阜顛，嚮昧為昏。小人成群，君子傷倫。",
      "sourceParagraphSha256": "sha256:34bb556929010ea5361b9b7ba53d94fe138a6f86f3a4206d7333dfb91387754c",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:20353ad56dcd99729840359efefb6a92f132bff39651b3a78b823910a7d35469"
    },
    {
      "baseHexagramNumber": 17,
      "changedHexagramNumber": 37,
      "sourceEntryNumber": 37,
      "sourceIconHexagramNumber": 37,
      "hexagramName": "家人",
      "poemText": "水火父母，先來鳴呴。澤皋之上，從高而處。",
      "sourceParagraphSha256": "sha256:da8495ca539048602b36da93d404af385991a1ec5d3d369a6a09d9c11bb50e7d",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:7df9e388a22ba7f67f735cd001158bd6224bcb0b43230e02970cfd1395ec7ce9"
    },
    {
      "baseHexagramNumber": 17,
      "changedHexagramNumber": 38,
      "sourceEntryNumber": 38,
      "sourceIconHexagramNumber": 38,
      "hexagramName": "睽",
      "poemText": "東鄰少女，為王長婦。柔順利貞，宜夫壽子。",
      "sourceParagraphSha256": "sha256:f19424013ed56f533e6a13bcc4425e1c9037647c2b99cb8ce53b323ae740844c",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:53c9352e5417ff3af7057a9c6e95cf71dd3c0de37ed5cbe6e76fb58e32a88d98"
    },
    {
      "baseHexagramNumber": 17,
      "changedHexagramNumber": 39,
      "sourceEntryNumber": 39,
      "sourceIconHexagramNumber": 39,
      "hexagramName": "蹇",
      "poemText": "戴缾望天，不見星辰。願小失大，福逃於外。",
      "sourceParagraphSha256": "sha256:dc3271f53e78fce4726468c69e59f7c7443e7f7b685f199968e72a07f3c455d6",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:66b59a94ccf2045b541d9117950553b24c9d27a6b07f9a02f1f8ef7dcdd850ee"
    },
    {
      "baseHexagramNumber": 17,
      "changedHexagramNumber": 40,
      "sourceEntryNumber": 40,
      "sourceIconHexagramNumber": 40,
      "hexagramName": "解",
      "poemText": "王喬無病，狗頭不痛。亡跛失履，乏我徒從。",
      "sourceParagraphSha256": "sha256:4007dafa5101cc7fe391521ff1c2bfc87e60af9988fca2b10f5b537b11fbfb19",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:9f1bf30bf14f8575d5cd8a5afc4bd0d561b55cbfd247c0b07663c7dd042beecf"
    },
    {
      "baseHexagramNumber": 17,
      "changedHexagramNumber": 41,
      "sourceEntryNumber": 41,
      "sourceIconHexagramNumber": 41,
      "hexagramName": "損",
      "poemText": "使燕築室，身無庇宿。家不容車，後我衣服。",
      "sourceParagraphSha256": "sha256:6b701cab3d636c773e90f82c1f83d851c795fc6db849556a1b94ab95a838ae9c",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:5b207b276bceef3e9592bd02f797da51a5d60f1d03c599208b3508fcac5efa72"
    },
    {
      "baseHexagramNumber": 17,
      "changedHexagramNumber": 42,
      "sourceEntryNumber": 42,
      "sourceIconHexagramNumber": 42,
      "hexagramName": "益",
      "poemText": "威權分離，烏夜徘徊。爭蔽月光，大人誅傷。",
      "sourceParagraphSha256": "sha256:7d71543862f63dae1d8bd9efff64aca8fdde7f582a0237f815f1d855be43cc4b",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:8a5e6820bfc6c77e24993051ff8b9f8b5925d1886a66e6421ef5c873d6a4445d"
    },
    {
      "baseHexagramNumber": 17,
      "changedHexagramNumber": 43,
      "sourceEntryNumber": 43,
      "sourceIconHexagramNumber": 43,
      "hexagramName": "夬",
      "poemText": "辨變白黑，巧言亂國。大人失福，君子迷惑。",
      "sourceParagraphSha256": "sha256:126b0cd69df43ebd7d0326595b2b3951dea70741e1a2280be45a81bdadd8e697",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:629467f50d0bb54df089e761e69724b16a4ac23848443e365c845495e499dbdb"
    },
    {
      "baseHexagramNumber": 17,
      "changedHexagramNumber": 44,
      "sourceEntryNumber": 44,
      "sourceIconHexagramNumber": 44,
      "hexagramName": "姤",
      "poemText": "衣鋸甲鎧，敝筐為具。大人不顧，少婦不取。棄捐於道。",
      "sourceParagraphSha256": "sha256:d2008e91b0f8ebd30e3b948e2183eaf8f7312bee1e31b79e40d23b04a1a9246f",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:3437fd46c5de6f45fc323c54d5f0c1cdf1a51c6f0bb7b7288583dc0f4e8da278"
    },
    {
      "baseHexagramNumber": 17,
      "changedHexagramNumber": 45,
      "sourceEntryNumber": 45,
      "sourceIconHexagramNumber": 45,
      "hexagramName": "萃",
      "poemText": "燕雀御泥，以生孚乳。兄弟六人，交好孝悌。得心歡欣，和悅相樂。",
      "sourceParagraphSha256": "sha256:fd358ee97b07b0823d3b662c53a77b3c4e75ea549f46d5d666ec71aec7ae0886",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:d140ac18798542551a99c0f54140f54818cb849959d03a17f2fb44288f6fd0ca"
    },
    {
      "baseHexagramNumber": 17,
      "changedHexagramNumber": 46,
      "sourceEntryNumber": 46,
      "sourceIconHexagramNumber": 46,
      "hexagramName": "升",
      "poemText": "登几上輿，駕駟南遊。合從散衡，燕秦以強。",
      "sourceParagraphSha256": "sha256:7c541720611f1de5f9639ae6575b8a3f540deb934011c10e7a7cd157cca741fc",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:0d541f3bed4c28fd36369f08181eeade0d5c2cd40b6447472ef37e3d666cdd8d"
    },
    {
      "baseHexagramNumber": 17,
      "changedHexagramNumber": 47,
      "sourceEntryNumber": 47,
      "sourceIconHexagramNumber": 47,
      "hexagramName": "困",
      "poemText": "黯黯許許，仇禍相得。冰入炭室，消亡不息。",
      "sourceParagraphSha256": "sha256:cbbe726caad3d85b8c0c699eab75e247a6023285cc4c5b138b5e27bc20f38f65",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:907912af20e64b874258c065d970fdc0428b6bc76668eb92e954c532dd5f54bd"
    },
    {
      "baseHexagramNumber": 17,
      "changedHexagramNumber": 48,
      "sourceEntryNumber": 48,
      "sourceIconHexagramNumber": 48,
      "hexagramName": "井",
      "poemText": "鴟鴞破斧，邦人危殆。賴其忠德，轉禍為福。傾危復立。",
      "sourceParagraphSha256": "sha256:d35a1b49b6cc355a8b3a4aca2c4effb260d0955f35346a4e7cdb504533182b29",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:450931e8b84b4a41877bcb87223950fa09085c1b3fd21f40b1dcca5ec32d6d6c"
    },
    {
      "baseHexagramNumber": 17,
      "changedHexagramNumber": 49,
      "sourceEntryNumber": 49,
      "sourceIconHexagramNumber": 49,
      "hexagramName": "革",
      "poemText": "載金販狗，利棄我走。藏匿淵渠，悔折為咎。",
      "sourceParagraphSha256": "sha256:2e7331ea2a8862a67c8f2653ac2621a66e0c157a2e8cfcc17c173b27c9a46235",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:b100b7dc01ef7b5099e48db6ae486630826ffee8351d4cc9b12afe4d29800dc6"
    },
    {
      "baseHexagramNumber": 17,
      "changedHexagramNumber": 50,
      "sourceEntryNumber": 50,
      "sourceIconHexagramNumber": 50,
      "hexagramName": "鼎",
      "poemText": "淵坑復平，宇穴安寧。憂患解除，賴福長生。",
      "sourceParagraphSha256": "sha256:45b48423607d22db091e6ba000d69857ef3860650f5d6600188062c71561a547",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:34d86f53c2f8bda27f7aab35ec3b1aca5e83811a41a36287ec2bbacb591146da"
    },
    {
      "baseHexagramNumber": 17,
      "changedHexagramNumber": 51,
      "sourceEntryNumber": 51,
      "sourceIconHexagramNumber": 51,
      "hexagramName": "震",
      "poemText": "驪姬讒嬉，與二孽謀。譖我公子，賊害忠孝。駕出喜門，商伯有害。",
      "sourceParagraphSha256": "sha256:88771cb55a033afc91b854482046d4cb3a433f879d767842d2f4ab81733ee600",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:4d6fe165dac049327f9010fe0dcc07a7244ff3e055d038027005abfbbdd5294d"
    },
    {
      "baseHexagramNumber": 17,
      "changedHexagramNumber": 52,
      "sourceEntryNumber": 52,
      "sourceIconHexagramNumber": 52,
      "hexagramName": "艮",
      "poemText": "刲羊不當，血少無羹。女執空筐，不得採桑。",
      "sourceParagraphSha256": "sha256:705e87620edc6a6de7352a30de7b565705761a5eb62fcd459d10ea288a3eabfa",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:30ab3adbb65b5c21cec47f1a0e500ae432970a3486e527d765d5b59d81105035"
    },
    {
      "baseHexagramNumber": 17,
      "changedHexagramNumber": 53,
      "sourceEntryNumber": 53,
      "sourceIconHexagramNumber": 53,
      "hexagramName": "漸",
      "poemText": "牧羊稻園，聞虎喧嚷。畏懼悚息，終無禍患。",
      "sourceParagraphSha256": "sha256:82c3317f25ce26573a4546f656bc1d238b9458fc6db78ce6ef10af40f21ea530",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:22c01421d31f786e07f5d7c691587a8acb749be30988d0430561d22dffdb7924"
    },
    {
      "baseHexagramNumber": 17,
      "changedHexagramNumber": 54,
      "sourceEntryNumber": 54,
      "sourceIconHexagramNumber": 54,
      "hexagramName": "歸妹",
      "poemText": "明德隱伏，麟鳳遠匿。周室傾側，不知所息。",
      "sourceParagraphSha256": "sha256:c95eebb4deb5bbd48a23aa5ee1418320c0a7f8092018b5a05c68997ad6bbf9ba",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:4084b598111cf4a3134735c5f0fb281cdc555e8f9d0f12526f11965b45aa74c5"
    },
    {
      "baseHexagramNumber": 17,
      "changedHexagramNumber": 55,
      "sourceEntryNumber": 55,
      "sourceIconHexagramNumber": 55,
      "hexagramName": "豐",
      "poemText": "鄰不我顧，而求寶玉。身多禿癩，誰肯媚者。",
      "sourceParagraphSha256": "sha256:e809069184bb927bbbaf985b1188e9dc4357099ace5df6015ae087fe1141831b",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:da78a0916caf20d4560bd4c70a0d87913edb0285944a0b4cbe778651e11672e4"
    },
    {
      "baseHexagramNumber": 17,
      "changedHexagramNumber": 56,
      "sourceEntryNumber": 56,
      "sourceIconHexagramNumber": 56,
      "hexagramName": "旅",
      "poemText": "初雖無輿，後得載車。賴幸逢福，得離兵革。",
      "sourceParagraphSha256": "sha256:af81b7a284281879766644df73cf6f461431ab63edc9ec6fbb9dd63f69823497",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:3b905fd824dce7aa2a0804d1240b24ea1ebf9fac3a3e1a6459c771f4319733f9"
    },
    {
      "baseHexagramNumber": 17,
      "changedHexagramNumber": 57,
      "sourceEntryNumber": 57,
      "sourceIconHexagramNumber": 57,
      "hexagramName": "巽",
      "poemText": "水壞我里，東流為海。龜鳧懽囂，不堵王母。",
      "sourceParagraphSha256": "sha256:3b52a4d3281ba9a87e5ec52382da1a3bf8d0357b6ac177515df52be672a404d6",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:10d4090cbea6db67253f51c32fc44c40a47b8fb48bbbcb89e05e6613387526e6"
    },
    {
      "baseHexagramNumber": 17,
      "changedHexagramNumber": 58,
      "sourceEntryNumber": 58,
      "sourceIconHexagramNumber": 58,
      "hexagramName": "兌",
      "poemText": "兩心不同，或欲西東。明論終始，莫適所從。",
      "sourceParagraphSha256": "sha256:abc0b0ebe62e7f4065462604cc12cd857274c3f5ac5a82858c37bfda38de75df",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:d349b4c8b136b2ebc4b9b17b073058f34e18816ad84e0e3bde6658e7b58e55fb"
    },
    {
      "baseHexagramNumber": 17,
      "changedHexagramNumber": 59,
      "sourceEntryNumber": 59,
      "sourceIconHexagramNumber": 59,
      "hexagramName": "渙",
      "poemText": "天帝懸車，廢禮不朝。攘服不制，失寵其家。",
      "sourceParagraphSha256": "sha256:42b7dfe060fdb8fe580d25d0faddc638fd7cf780f47e0d9bec86f8b53cb401cf",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:f086997afd09b3835f3571d3dfe1276e391aa6b5a7ce960817b939dc06916307"
    },
    {
      "baseHexagramNumber": 17,
      "changedHexagramNumber": 60,
      "sourceEntryNumber": 60,
      "sourceIconHexagramNumber": 60,
      "hexagramName": "節",
      "poemText": "交川合浦，遠溼難處。水土不同，思吾皇祖。",
      "sourceParagraphSha256": "sha256:566c99733d144d91406490179fc4fad62fe741363ddc7ee03c829746c65b6d63",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:95a8a8101d6d6289c615d88c0affb13ccb46a1fb2847ea787408921ace2ed8cb"
    },
    {
      "baseHexagramNumber": 17,
      "changedHexagramNumber": 61,
      "sourceEntryNumber": 61,
      "sourceIconHexagramNumber": 61,
      "hexagramName": "中孚",
      "poemText": "勾踐之危，棲於會稽。太宰譏言，越國復存。",
      "sourceParagraphSha256": "sha256:59ca892d10ae637b03f794525647504c400228e3ecc95331dd82bb07a44889ad",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:2a91a66b4bd966b2b7a9ed627f40511aea3471b44bc4d718af1a4a147565283d"
    },
    {
      "baseHexagramNumber": 17,
      "changedHexagramNumber": 62,
      "sourceEntryNumber": 62,
      "sourceIconHexagramNumber": 62,
      "hexagramName": "小過",
      "poemText": "慈烏鳴鳩，執一無尤，寢門內治，君子悅喜。",
      "sourceParagraphSha256": "sha256:91253659c266d8b94ffd6c84da535268be3dfd9fc27eaea9c91a8653963bd3b9",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:6d6552e029766f9dfc6fb9af6d47ebd189bc45dd13ee6f9866541296c41d035f"
    },
    {
      "baseHexagramNumber": 17,
      "changedHexagramNumber": 63,
      "sourceEntryNumber": 63,
      "sourceIconHexagramNumber": 63,
      "hexagramName": "既濟",
      "poemText": "富年早寡，孤與獨居。雞鳴犬吠，無敢問者。我生不遇，獨罹寒苦。",
      "sourceParagraphSha256": "sha256:b5511f619e0930ff14106b1c37491c666c6b2db675eb0a67cd12058686bb4f21",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:c3d19b63f3eb884b5e4dd29d94ef3d1b495ce202c5cbab285ec1a2e1bd385e32"
    },
    {
      "baseHexagramNumber": 17,
      "changedHexagramNumber": 64,
      "sourceEntryNumber": 64,
      "sourceIconHexagramNumber": 64,
      "hexagramName": "未濟",
      "poemText": "江海變服，淫緬無測。高位顛崩，寵祿反覆。",
      "sourceParagraphSha256": "sha256:25da2049898950b0608c109e94ef937e2f2f40cf1cf9f03a72e3518f9230e2f2",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:b83b793a8425af8998b33fc10e947a5edc70b5c54ec67e463f903a70c97bdad2"
    }
  ]
}
