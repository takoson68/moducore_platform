  "attribution": "來源：《焦氏易林》，易學網《焦氏易林［四庫全書版］》（依據版本：《欽定四庫全書》子部術數類），https://www.eee-learning.com/book/giauii 。依來源要求標示出處及原網頁連結；本站僅整理林辭原文，並記錄收錄、標點及文字整理修改。",
  "entryCount": 64,
  "missingTargets": [],
  "entries": [
    {
      "baseHexagramNumber": 8,
      "changedHexagramNumber": 8,
      "sourceEntryNumber": 8,
      "sourceIconHexagramNumber": 8,
      "hexagramName": "比",
      "poemText": "鹿得美草，鳴呼其友。九族和睦，不憂飢乏。",
      "sourceParagraphSha256": "sha256:db91afa9fa7f9eacb29a0c5ecb3fc2371878ded88c71aa566c3d8359d7305191",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:b385daa75aee3e07fe7635c31f4b49bc74026c7d1eb1ab6c0d69049b2dae2b74"
    },
    {
      "baseHexagramNumber": 8,
      "changedHexagramNumber": 1,
      "sourceEntryNumber": 1,
      "sourceIconHexagramNumber": 1,
      "hexagramName": "乾",
      "poemText": "繼祖復宗，追用成康。光照萬國，亭世久長。",
      "sourceParagraphSha256": "sha256:bb76455f75e57ecb3850974f2b548c14376b6053ace8a9e3dd41267129712062",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:53fe56792967567ef53bcb93b24b4e44443239a2fd1c297a5ff83a7312a9f0f0"
    },
    {
      "baseHexagramNumber": 8,
      "changedHexagramNumber": 2,
      "sourceEntryNumber": 2,
      "sourceIconHexagramNumber": 2,
      "hexagramName": "坤",
      "poemText": "麟子鳳雛，生長嘉國。和氣所居，康樂無憂。邦多哲人。",
      "sourceParagraphSha256": "sha256:c3e7c43c43d8e57d51fa3a7767803cc2a66ca8266509e8fa8123cc2b8445c596",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:355da1f5b3ceb72eafbabcfe41a87da28f442eb408c28babd05c4e2e8094f40a"
    },
    {
      "baseHexagramNumber": 8,
      "changedHexagramNumber": 3,
      "sourceEntryNumber": 3,
      "sourceIconHexagramNumber": 3,
      "hexagramName": "屯",
      "poemText": "灼灼泉源，釣鯉山巔。魚不可得，火不肯燃。",
      "sourceParagraphSha256": "sha256:bb3fc4e10bc509a20d820722d85d1529f5bd6494b4194e1d90e63b61bb4ec61e",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:3e90e23ec35455e807dd6edbe4efa05c79c15cd353d9b96978145ccc156b54d2"
    },
    {
      "baseHexagramNumber": 8,
      "changedHexagramNumber": 4,
      "sourceEntryNumber": 4,
      "sourceIconHexagramNumber": 4,
      "hexagramName": "蒙",
      "poemText": "彭生為豕，白虎行菑。盜堯衣裳，桀跖荷兵。青禽照夜，三日夷傷。",
      "sourceParagraphSha256": "sha256:c1fdbff9b3713d0ea2ba85df57d0cd992422689ed0ec3295c34ac4a7c4cf1238",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:98ce613ac609fa0ee63d5a8605be6dd0294bd3e887b799ead5cc531d48bcd22f"
    },
    {
      "baseHexagramNumber": 8,
      "changedHexagramNumber": 5,
      "sourceEntryNumber": 5,
      "sourceIconHexagramNumber": 5,
      "hexagramName": "需",
      "poemText": "黍稷醇醴，敬奉山宗。神嗜飲食，甘雨嘉降。黎庶蕃殖，獨蒙福祉。時災不至。",
      "sourceParagraphSha256": "sha256:ba855a1ab89ad7cc20ee5579ce6b8cb4c9ad98d71974afec38c5e27d4be20a30",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:f703735220cef02ef7dad7e6a1d33f30539df118216dad5e7b439d14778839b0"
    },
    {
      "baseHexagramNumber": 8,
      "changedHexagramNumber": 6,
      "sourceEntryNumber": 6,
      "sourceIconHexagramNumber": 6,
      "hexagramName": "訟",
      "poemText": "李花再實，鴻卵降集。仁哲權輿，蔭國受福。",
      "sourceParagraphSha256": "sha256:7493b00e1b935d362a7303e38633e57d40c79d952167fef6d6b6115d5515504e",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:430e784c0ed1b89bd83944ee278a33d1ac8669960d765dd1fa87b86b860fad76"
    },
    {
      "baseHexagramNumber": 8,
      "changedHexagramNumber": 7,
      "sourceEntryNumber": 7,
      "sourceIconHexagramNumber": 7,
      "hexagramName": "師",
      "poemText": "千歲之墟，大兵所屠。不見子都，城空無家。",
      "sourceParagraphSha256": "sha256:89a4fbff4e24ff5b73c09ecfbf67d18ebd73ff0158092ba07531ff8f94010dd8",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:df1cef89bf2d1532eaeb81db901a26c169cd8324b26a16414f99f0d4fcbf3ebb"
    },
    {
      "baseHexagramNumber": 8,
      "changedHexagramNumber": 9,
      "sourceEntryNumber": 9,
      "sourceIconHexagramNumber": 9,
      "hexagramName": "小畜",
      "poemText": "公子王孫，把彈攝丸。發輒有得，家室饒足。",
      "sourceParagraphSha256": "sha256:56ffe8f142587e37614a195e3cdafadd4e04dd644d1916eda30f77f7a3949f29",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:955fbc8be24cdf50f1c077595494b7956df93c9f586b7a184f8d51ef62c7c3ee"
    },
    {
      "baseHexagramNumber": 8,
      "changedHexagramNumber": 10,
      "sourceEntryNumber": 10,
      "sourceIconHexagramNumber": 10,
      "hexagramName": "履",
      "poemText": "驪姬讒嬉，與二嬖謀。譖殺公子，賊害忠孝。申生以縊，重耳奔走。",
      "sourceParagraphSha256": "sha256:b9743500e532604ef5dffd99e1480cad7cd57417ad68d9e455336092a7252e01",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:fa963dc920c17ab00f6dcdaaf4abce48554db068c059cb482ef32c47de3c13ac"
    },
    {
      "baseHexagramNumber": 8,
      "changedHexagramNumber": 11,
      "sourceEntryNumber": 11,
      "sourceIconHexagramNumber": 11,
      "hexagramName": "泰",
      "poemText": "長生無極，子孫千億。柏柱載梁，堅固不傾。",
      "sourceParagraphSha256": "sha256:9a8932103a28456b21752e56a674c6687e9c2e8610af5f28df6ea50c59910c99",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:2932da6c06fac915562131b3b88ff1a0c6dfbbe212b0a10534dcd2c9e87d2ab5"
    },
    {
      "baseHexagramNumber": 8,
      "changedHexagramNumber": 12,
      "sourceEntryNumber": 12,
      "sourceIconHexagramNumber": 12,
      "hexagramName": "否",
      "poemText": "失意懷憂，如幽狴牢。亡子喪夫，托附寄居。",
      "sourceParagraphSha256": "sha256:7718a5236a6f7190ec7d7f7f8a205b2c508dd2cbc4ea527243ff700e3593b894",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:10f1605ab31f2f40ba866ba05225a89fe6c93c788ff4af1de920ab6459d18652"
    },
    {
      "baseHexagramNumber": 8,
      "changedHexagramNumber": 13,
      "sourceEntryNumber": 13,
      "sourceIconHexagramNumber": 13,
      "hexagramName": "同人",
      "poemText": "仁智隱伏，麟不可得。龍蛇潛藏，虛居堂室。",
      "sourceParagraphSha256": "sha256:b4dd3b18cfb1ba554225612bf60bb1481dc4aaf9adbd09a7a08bd5b78f9d346e",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:10f6638b7210fba42048e7638bab7098ef98be2f2227f4967de886f452b37ea7"
    },
    {
      "baseHexagramNumber": 8,
      "changedHexagramNumber": 14,
      "sourceEntryNumber": 14,
      "sourceIconHexagramNumber": 14,
      "hexagramName": "大有",
      "poemText": "列潔堁堁，締結難解。嫫母衒嫁，媒不得坐。自為身禍。",
      "sourceParagraphSha256": "sha256:ffccdeac7683fa7dccb1cd285c818211fb62a322de7334308777374bcfb931d8",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:09861a60533e66809bc76b7e461a8b546e429529bb25f32aa35bd9b850026d52"
    },
    {
      "baseHexagramNumber": 8,
      "changedHexagramNumber": 15,
      "sourceEntryNumber": 15,
      "sourceIconHexagramNumber": 15,
      "hexagramName": "謙",
      "poemText": "鳥飛墜木，不毀頭足。保我羽翼，復歸其室。",
      "sourceParagraphSha256": "sha256:d44b8bb1feb92e9a57decbd2d7c4e8f985df36cadb435f2bf42cca08a4e6058c",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:3cad7686404ca4114fff919f4a136543e370c9628b5b23fd2c3b0f0eb80a52c2"
    },
    {
      "baseHexagramNumber": 8,
      "changedHexagramNumber": 16,
      "sourceEntryNumber": 16,
      "sourceIconHexagramNumber": 16,
      "hexagramName": "豫",
      "poemText": "陳媯敬仲，兆興齊姜。乃適營丘，八世大昌。",
      "sourceParagraphSha256": "sha256:09a1796b29827b138a2a6e815239d6649b7820196992db4eb9b6d42ca6b50e57",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:5845f1c1170e79ab653d40cc5cbd70d6c52ac4c2b12d17298a14462a2c09be58"
    },
    {
      "baseHexagramNumber": 8,
      "changedHexagramNumber": 17,
      "sourceEntryNumber": 17,
      "sourceIconHexagramNumber": 17,
      "hexagramName": "隨",
      "poemText": "過時不歸，雌雄苦悲。徘徊外國，與母分離。",
      "sourceParagraphSha256": "sha256:f5a85919bac8d993be1a73387bd8440ea3ab578ce513e980780f411edcc44a6a",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:dd7ce76f843f6e834c8ad5da389388c8ff7a74391018c5af6e886ee21bfcfaf2"
    },
    {
      "baseHexagramNumber": 8,
      "changedHexagramNumber": 18,
      "sourceEntryNumber": 18,
      "sourceIconHexagramNumber": 18,
      "hexagramName": "蠱",
      "poemText": "齊魯爭言，戰於龍門。搆怨連禍，三世不寧。",
      "sourceParagraphSha256": "sha256:17c73303f73fa868943c8be1a584fbde91fd04ea395405686f2f8c065bf332e8",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:a5e17f4dda5620187912379d0e836bcdbf9f222ae4a99e7801d7bff53d1cece3"
    },
    {
      "baseHexagramNumber": 8,
      "changedHexagramNumber": 19,
      "sourceEntryNumber": 19,
      "sourceIconHexagramNumber": 19,
      "hexagramName": "臨",
      "poemText": "府藏之富，王以賑貸。捕魚河海，笱網多得。",
      "sourceParagraphSha256": "sha256:ea5f845692947f0df101a60775070cf10511d6f111fe54570dbfe5735e944e94",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:f6799ea2661520dde746eb09d112e5b401c2da0bd4f7c7999277088a42819954"
    },
    {
      "baseHexagramNumber": 8,
      "changedHexagramNumber": 20,
      "sourceEntryNumber": 20,
      "sourceIconHexagramNumber": 20,
      "hexagramName": "觀",
      "poemText": "鳴鶴北飛，下就稻池。鱣鮪鰋鯉，眾多饒有。一笱獲兩，利得過倍。",
      "sourceParagraphSha256": "sha256:10a8bd41b1fdd962f7da61b3650e4684380b87c40dfc8071983cfa9147580af1",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:3f08fab89bf840e995a25c8a42f9b9e6c330474ba6c03287467b4c696a803efe"
    },
    {
      "baseHexagramNumber": 8,
      "changedHexagramNumber": 21,
      "sourceEntryNumber": 21,
      "sourceIconHexagramNumber": 21,
      "hexagramName": "噬嗑",
      "poemText": "蒼梧鬱林，道易利通。元龜象齒，寶貝南金。為吾歸功。",
      "sourceParagraphSha256": "sha256:3d8050b1d5d4807933ee8858f6b4d4972890cdbfeb357568e34b2719bbc61b9d",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:1a9679306e93f2a5912c4b7f962a0604e135cffec5bd4cba741cd11b93235a8a"
    },
    {
      "baseHexagramNumber": 8,
      "changedHexagramNumber": 22,
      "sourceEntryNumber": 22,
      "sourceIconHexagramNumber": 22,
      "hexagramName": "賁",
      "poemText": "兩火爭明，雖鬥不傷。分離且忍，全我弟兄。",
      "sourceParagraphSha256": "sha256:d153e76b641a6d306cbad41cf7b286d4cefb0022366a976cf239b072031dd432",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:5454707cfd28b4b01225071f3b20dda501c5a077abbca1086cc9fa10ae945697"
    },
    {
      "baseHexagramNumber": 8,
      "changedHexagramNumber": 23,
      "sourceEntryNumber": 23,
      "sourceIconHexagramNumber": 23,
      "hexagramName": "剝",
      "poemText": "伯夷叔齊，貞廉之師。以德防患，憂禍不存。",
      "sourceParagraphSha256": "sha256:c839e2f8f3973ae21ad912dd2b49c87f37bd7aee7f2dbc3a6e685b5baaacbde4",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:78260c95cc8c3ad07b201a3259bd620299db12966d2d2aa4d9aab51fc9ea6943"
    },
    {
      "baseHexagramNumber": 8,
      "changedHexagramNumber": 24,
      "sourceEntryNumber": 24,
      "sourceIconHexagramNumber": 24,
      "hexagramName": "復",
      "poemText": "季去我東，髮櫛如蓬。展轉空床，內懷傷憂。",
      "sourceParagraphSha256": "sha256:84f81e1cadd80d16507d092b984aa3e13aab27865f9267a7dc078d3ce61a0a3a",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:d6f5872c9ee2b1a0f44df8649fa62c5a1c100005afa78154b8c911d57f940c7c"
    },
    {
      "baseHexagramNumber": 8,
      "changedHexagramNumber": 25,
      "sourceEntryNumber": 25,
      "sourceIconHexagramNumber": 25,
      "hexagramName": "无妄",
      "poemText": "百足俱行，相輔為強。三聖翼事，王室寵光。",
      "sourceParagraphSha256": "sha256:321227691709cacaa960c544d36a263f95f77f876ee17f07977397e83affc835",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:4221fcdd64d0e99b6d7af72fc92693523f255bc3f6c2f33822107d65a86a5469"
    },
    {
      "baseHexagramNumber": 8,
      "changedHexagramNumber": 26,
      "sourceEntryNumber": 26,
      "sourceIconHexagramNumber": 26,
      "hexagramName": "大畜",
      "poemText": "壅遏隄防，水不得行。火盛陽光，陰蜺伏藏。退還其鄉。",
      "sourceParagraphSha256": "sha256:778a255aae64a2fb0971374819620ce19683591605646e095da4cb63da44e009",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:e3b715922d69fcf6ee3a50fb76c6ae66d261b442ffe929303079b6c0321890fd"
    },
    {
      "baseHexagramNumber": 8,
      "changedHexagramNumber": 27,
      "sourceEntryNumber": 27,
      "sourceIconHexagramNumber": 27,
      "hexagramName": "頤",
      "poemText": "騰蛇乘龍，歲饑蓬蓬。年歲饑凶，民食草蓬。",
      "sourceParagraphSha256": "sha256:169e134fc5479d3a5808a7ed8c8af315434d26adafd31d8947e2cdea7a3fa95a",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:aa0f236a1f91c01609a3f1c51e85c923c04dc5b73a55d4b0b8dd7007e953bc5f"
    },
    {
      "baseHexagramNumber": 8,
      "changedHexagramNumber": 28,
      "sourceEntryNumber": 28,
      "sourceIconHexagramNumber": 28,
      "hexagramName": "大過",
      "poemText": "鉛刀攻玉，堅不可得。盡我筋力，眠繭為疾。",
      "sourceParagraphSha256": "sha256:b2e45c31fb6365c0fe71ab733c6090cefb2c162acf12299fa09b5e785750c903",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:c3cf503dbd1e8650a409e0fd2742d19451722605dcad2da605c7cdf0a50e7fdb"
    },
    {
      "baseHexagramNumber": 8,
      "changedHexagramNumber": 29,
      "sourceEntryNumber": 29,
      "sourceIconHexagramNumber": 29,
      "hexagramName": "坎",
      "poemText": "恆山浦泛，高邑具在。陰氣不淋，洪水弗處。牢人開戶。",
      "sourceParagraphSha256": "sha256:01739707cf10f1f4b0a6697e9313832af1ea39b780146aa2cf464b219b8941c3",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:af9efe5c6694eee36dfe98acdf98ce80c7fcb34248b9a59791c154d5ee6fdf6b"
    },
    {
      "baseHexagramNumber": 8,
      "changedHexagramNumber": 30,
      "sourceEntryNumber": 30,
      "sourceIconHexagramNumber": 30,
      "hexagramName": "離",
      "poemText": "比目四翼，來安我國。福善上堂，與我同床。",
      "sourceParagraphSha256": "sha256:85e769de74ce38584e0ce48f6d0e7857257cef8d438ce87966ee6b62afda34bd",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:5670e9d3b2e701e1a05dd0cc62c946fdc30d3ac6840e87e9cef00b1be5a4e69e"
    },
    {
      "baseHexagramNumber": 8,
      "changedHexagramNumber": 31,
      "sourceEntryNumber": 31,
      "sourceIconHexagramNumber": 31,
      "hexagramName": "咸",
      "poemText": "杜口結舌，心中怫鬱。去菑患生，莫所告冤。",
      "sourceParagraphSha256": "sha256:bd26964706c61f14d92bca54df19e70f580b5a968a8b304e25e920f7f2f95135",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:09fdd1ba425bc8b48f2d0ec1c434d7055c55051c610c79b58452e75618c2bad2"
    },
    {
      "baseHexagramNumber": 8,
      "changedHexagramNumber": 32,
      "sourceEntryNumber": 32,
      "sourceIconHexagramNumber": 32,
      "hexagramName": "恒",
      "poemText": "牽尾不前，逆理失臣。惠朔以奔。",
      "sourceParagraphSha256": "sha256:ca2a6525ed8626f67f884df8ffd295caeb441cfd63742bf8f9a8aaee81b4a1db",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:8de096bb7311fbc526817ecbc9979a3144d7f9f57ad04ab4348b31f5a41de20f"
    },
    {
      "baseHexagramNumber": 8,
      "changedHexagramNumber": 33,
      "sourceEntryNumber": 33,
      "sourceIconHexagramNumber": 33,
      "hexagramName": "遯",
      "poemText": "早霜晚雪，傷害禾麥。損功棄力，飢無所食。需之咸）",
      "sourceParagraphSha256": "sha256:b0a176cffd2100dfe14be9b513990934dadfcddb453d4d8b287cdbd29cf44884",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:346fb2acc6743e1dcd1da75ee48b5f23c33715755272d26d8be1346cf6372ca6"
    },
    {
      "baseHexagramNumber": 8,
      "changedHexagramNumber": 34,
      "sourceEntryNumber": 34,
      "sourceIconHexagramNumber": 34,
      "hexagramName": "大壯",
      "poemText": "適戍失期，患生無聊。懼以發憂，開藏閉塞。邦國窮愁。",
      "sourceParagraphSha256": "sha256:82ada5bbcbcae9d7d680782da835ab29d4a00912572eb84013097b11b26617f9",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:c078134aee1098675d75d33915f000d5d5514c00679db3141dd8e8df4422d084"
    },
    {
      "baseHexagramNumber": 8,
      "changedHexagramNumber": 35,
      "sourceEntryNumber": 35,
      "sourceIconHexagramNumber": 35,
      "hexagramName": "晉",
      "poemText": "昊天白日，照臨我國。萬民康樂，咸賴嘉福。",
      "sourceParagraphSha256": "sha256:bcafceb4084d3309a9f68a666e67775021c9cd271e9e5e03b79ee65473b268f9",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:d2cea1da01d134f7aba11104a2356216781b35acbf449f64d2b4ccc0b80756e6"
    },
    {
      "baseHexagramNumber": 8,
      "changedHexagramNumber": 36,
      "sourceEntryNumber": 36,
      "sourceIconHexagramNumber": 36,
      "hexagramName": "明夷",
      "poemText": "元吉無咎，安寧不殆。",
      "sourceParagraphSha256": "sha256:725204d7ac480b570605e4ba487c2abcc5d5f383e2f1581ea4039317b3e4df5d",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:836ad9918d28f50c0407b1cf1a7fa0d300d0585323632e0ada54d6705086b73e"
    },
    {
      "baseHexagramNumber": 8,
      "changedHexagramNumber": 37,
      "sourceEntryNumber": 37,
      "sourceIconHexagramNumber": 37,
      "hexagramName": "家人",
      "poemText": "懿公淺愚，不深受諫。無援失國，為狄所賊。",
      "sourceParagraphSha256": "sha256:fdaeb38403305c43a52a711cd3fb61eba979041896dc020800e5ab10ca6c0865",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:3e5abf4ed579af817aaba3cde67d8cd80c8a405e63ab305717f6c89fe16223e8"
    },
    {
      "baseHexagramNumber": 8,
      "changedHexagramNumber": 38,
      "sourceEntryNumber": 38,
      "sourceIconHexagramNumber": 38,
      "hexagramName": "睽",
      "poemText": "城上有鳥，自號破家。呼喚鳩毒，為國患災。",
      "sourceParagraphSha256": "sha256:6e92490486e4c73cdfb45e6d16bd9545e85a2a23e540ac17caeed4c0cbffd69d",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:58d9a70eca3974d725e81688e763aebb5f66d33156394773dad2a11e3868d247"
    },
    {
      "baseHexagramNumber": 8,
      "changedHexagramNumber": 39,
      "sourceEntryNumber": 39,
      "sourceIconHexagramNumber": 39,
      "hexagramName": "蹇",
      "poemText": "長股喜走，趨步千里。王良嘉善，伯樂在道。申生見母，下有由子。",
      "sourceParagraphSha256": "sha256:2f6ee2aef45dee172441fdb5397d579a2d303fced5d6a6a7619d03b51402f4ab",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:3f7eb9e477a51d9e1a1b74b58bb3849e882b2ad9666b9835584081e4f747bde7"
    },
    {
      "baseHexagramNumber": 8,
      "changedHexagramNumber": 40,
      "sourceEntryNumber": 40,
      "sourceIconHexagramNumber": 40,
      "hexagramName": "解",
      "poemText": "耕石山巔，費種家貧。無聊虛作，苗髮不生。",
      "sourceParagraphSha256": "sha256:da49ed07b40e242c789eeff1167facbbacc467628152fd014f72c181a3ab9789",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:93cda698426b0b9ed2cf23f9cdb8070d10c190674aff753382232fb35e741f70"
    },
    {
      "baseHexagramNumber": 8,
      "changedHexagramNumber": 41,
      "sourceEntryNumber": 41,
      "sourceIconHexagramNumber": 41,
      "hexagramName": "損",
      "poemText": "二人異路，東趨西步。千里之行，不相知處。",
      "sourceParagraphSha256": "sha256:433b7c5c05e3dad5a75540ed8bdfed56cd41ab8a791ecef41c93d7d896be813d",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:53147606e0d7547f6c9ffff1ce1577e1c81ff849198a99fd4ab0491f8167bb6c"
    },
    {
      "baseHexagramNumber": 8,
      "changedHexagramNumber": 42,
      "sourceEntryNumber": 42,
      "sourceIconHexagramNumber": 42,
      "hexagramName": "益",
      "poemText": "純服素裳，載主以興。德義茂生，天下歸仁。",
      "sourceParagraphSha256": "sha256:13962e7cf162c323ddf38dba9425536e0402afbf6e9fd4be33c94dae74f62805",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:128b46276a4e6b2156fd67e5be0b3f6a95fac503e23fd760ce5d0a224646e634"
    },
    {
      "baseHexagramNumber": 8,
      "changedHexagramNumber": 43,
      "sourceEntryNumber": 43,
      "sourceIconHexagramNumber": 43,
      "hexagramName": "夬",
      "poemText": "玉銳鐵頭，倉庫空虛。賈市為盈，與利為仇。",
      "sourceParagraphSha256": "sha256:144c562905160443152c028ee5915a3bb900d651d8e667c703cbb460a23a052b",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:01be7bb03df36c52013fea51f2950e1a5212ce40cf75b099a603506f4c9026d1"
    },
    {
      "baseHexagramNumber": 8,
      "changedHexagramNumber": 44,
      "sourceEntryNumber": 44,
      "sourceIconHexagramNumber": 44,
      "hexagramName": "姤",
      "poemText": "登崑崙，入天門。過糟丘，宿玉泉。開惠觀，見仁君。",
      "sourceParagraphSha256": "sha256:a3ecce1cb0e543176f2bd8e4f0172ef942e8d2849d101e42e21a82b02ed4d12e",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:d4c36279f1b312c4fc963791cd45a67a403c09a3eb2406050a3d064729273e1f"
    },
    {
      "baseHexagramNumber": 8,
      "changedHexagramNumber": 45,
      "sourceEntryNumber": 45,
      "sourceIconHexagramNumber": 45,
      "hexagramName": "萃",
      "poemText": "團團白日，為月所食。損上毀下，鄭昭走出。",
      "sourceParagraphSha256": "sha256:67c71c9c0211d716c813752b185541723df783b8420ed21e792576c866a4b291",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:78f43a72d22e8c4f6118820c50fd7f82ed98e61c11ba97003b4aff76a91d17bf"
    },
    {
      "baseHexagramNumber": 8,
      "changedHexagramNumber": 46,
      "sourceEntryNumber": 46,
      "sourceIconHexagramNumber": 46,
      "hexagramName": "升",
      "poemText": "倉盈庾億，宜稼黍稷。年豐歲熟，國家富有。",
      "sourceParagraphSha256": "sha256:a5117e523cee521e82c22388726a81a91b1f9d0e0d473c313ce8a68ff71edc97",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:34c224a1ad7c24e51c2d3e13d3ca76cd5358ca8288c2b1167623b5b4360c606e"
    },
    {
      "baseHexagramNumber": 8,
      "changedHexagramNumber": 47,
      "sourceEntryNumber": 47,
      "sourceIconHexagramNumber": 47,
      "hexagramName": "困",
      "poemText": "虎狼結謀，相聚為保。思嚼牛羊，道絕不通。傷我商人。",
      "sourceParagraphSha256": "sha256:9d462cdc6f9695e6d76738ba1eecd3de0195de3ba473e56d2d821888fff16f42",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:51bf5aff048fac353db67c45ef55c33f1947838df16f481098372522fa18b112"
    },
    {
      "baseHexagramNumber": 8,
      "changedHexagramNumber": 48,
      "sourceEntryNumber": 48,
      "sourceIconHexagramNumber": 48,
      "hexagramName": "井",
      "poemText": "中年摧拆，常恐不活。老賴福慶，光榮相輔。",
      "sourceParagraphSha256": "sha256:466f9fb7f0e92b30856e9285f17961b768108f9c6807fc8b188d4465515aded9",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:1e3b7a302bb5562dfb43cd0ab7b32cda942d61ecd4bd16d5acb6fbe55c94bcc1"
    },
    {
      "baseHexagramNumber": 8,
      "changedHexagramNumber": 49,
      "sourceEntryNumber": 49,
      "sourceIconHexagramNumber": 49,
      "hexagramName": "革",
      "poemText": "同載共車，中道分去。喪我元夫，獨與孤苦。",
      "sourceParagraphSha256": "sha256:298ae7ee8e186a50d55a4586ed051b6e6815183494fffba5337fde29018f8a24",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:980ed492e957abb5abc539b7e5c4c95c4738bb8505bd0444d2c996885cbbc44f"
    },
    {
      "baseHexagramNumber": 8,
      "changedHexagramNumber": 50,
      "sourceEntryNumber": 50,
      "sourceIconHexagramNumber": 50,
      "hexagramName": "鼎",
      "poemText": "飲酒醉酗，距跳爭鬥。伯傷叔僵，東家治喪。",
      "sourceParagraphSha256": "sha256:33453e3862a7ba04d536a429ba3c46572474715a34c51c8f0798d13b3547b98a",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ed2f2f55d30b0847c8046d75ec145e01e3b16c2cd5e4aae99393fb3fb93bc8c5"
    },
    {
      "baseHexagramNumber": 8,
      "changedHexagramNumber": 51,
      "sourceEntryNumber": 51,
      "sourceIconHexagramNumber": 51,
      "hexagramName": "震",
      "poemText": "出值凶災，逢五赤頭。跳言無祐，扶杖伏聽。不敢動搖。",
      "sourceParagraphSha256": "sha256:9066724d9b802ab49ad508893a009bf70c1f8cff5582484829d1ebc956dfe931",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:a63a9566f0c80cbace1e45ada0887cfc99e54c1e48142dd317ed3750393f0e8d"
    },
    {
      "baseHexagramNumber": 8,
      "changedHexagramNumber": 52,
      "sourceEntryNumber": 52,
      "sourceIconHexagramNumber": 52,
      "hexagramName": "艮",
      "poemText": "狼虎爭強，禮義不行。兼吞其國，齊魯無王。",
      "sourceParagraphSha256": "sha256:b9179618a9b60a635f144782a3ca52ff4a802d6ea6f5183c076c6ead2a954d0d",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ce750997eaf3e428a6bec5f30fed51fe86d80742fa4e2e0939b6df0f7fb38e83"
    },
    {
      "baseHexagramNumber": 8,
      "changedHexagramNumber": 53,
      "sourceEntryNumber": 53,
      "sourceIconHexagramNumber": 53,
      "hexagramName": "漸",
      "poemText": "南國少子，才略美好。求我長女，賤薄不與。反得醜惡，後乃大悔。",
      "sourceParagraphSha256": "sha256:81ff0445391102995b5807c319923e5776dc21aaaaa65264a63d95d24e810e5e",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:9c4d8488261a4bce7d864210320c617c2f4ce1b60340ab3a8ecee13d5d36b382"
    },
    {
      "baseHexagramNumber": 8,
      "changedHexagramNumber": 54,
      "sourceEntryNumber": 54,
      "sourceIconHexagramNumber": 54,
      "hexagramName": "歸妹",
      "poemText": "一身兩頭，莫通其軀。無見我心，亂不可治。",
      "sourceParagraphSha256": "sha256:41655baeac0537e19b7ae7d95330d3b285513397f26214a5f26add09eb8a2291",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:bc0a52bab0613637fd425870a8c05c4a06dc0421c8afd9ca2737248c0f167952"
    },
    {
      "baseHexagramNumber": 8,
      "changedHexagramNumber": 55,
      "sourceEntryNumber": 55,
      "sourceIconHexagramNumber": 55,
      "hexagramName": "豐",
      "poemText": "李耳橐鵲，更逢恐惜。擾余以腹，不能舉格。",
      "sourceParagraphSha256": "sha256:9f0364be62198342d089d0d8e704eb49e2e454b18a94ba27e1987adbc543f0d3",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:cdf17d66dbc878fa530ac13746cb45445e20a684d3507e8295b6bb3b4f4f9f25"
    },
    {
      "baseHexagramNumber": 8,
      "changedHexagramNumber": 56,
      "sourceEntryNumber": 56,
      "sourceIconHexagramNumber": 56,
      "hexagramName": "旅",
      "poemText": "柏桂棟梁，相輔為強。入敷五教，王室寧康。",
      "sourceParagraphSha256": "sha256:7f074af16f9acd486ccf8f59568988e40dd2063841259122f1eb713efd52890e",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:925b33d3df379c7cf979a207d1c2de869e314cff0f6fcd94029ab02aa83769a2"
    },
    {
      "baseHexagramNumber": 8,
      "changedHexagramNumber": 57,
      "sourceEntryNumber": 57,
      "sourceIconHexagramNumber": 57,
      "hexagramName": "巽",
      "poemText": "雀行求食，暮歸呼乳。反其屋室，安寧如故。",
      "sourceParagraphSha256": "sha256:5fe4be467741fd0a3969eea04d399100c511d4a49c1e3e31169ebc09bad19f7c",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:722ca8384ea9e1dd2f09fe15171eb5d0a7f98e616cece86a3a9dc1312363dc5b"
    },
    {
      "baseHexagramNumber": 8,
      "changedHexagramNumber": 58,
      "sourceEntryNumber": 58,
      "sourceIconHexagramNumber": 58,
      "hexagramName": "兌",
      "poemText": "四尾六頭，為凶作妖。陰不奉陽，上失其明。",
      "sourceParagraphSha256": "sha256:b643437bf7b319dd6b27ef4748452417dedbfee64a7b4c0861367df9c53fdbdd",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:55ed599a2d7b71d857a987318ab96d5997eed682c9ff29d8a5578a90d1faf2f3"
    },
    {
      "baseHexagramNumber": 8,
      "changedHexagramNumber": 59,
      "sourceEntryNumber": 59,
      "sourceIconHexagramNumber": 59,
      "hexagramName": "渙",
      "poemText": "一旅三關，結緝不便。岐道異路，日暮不到。",
      "sourceParagraphSha256": "sha256:b0870c380fd416072de81cf65d5db78c377990976d7724649d17bacb6df0d469",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:55d4b84329055767a7e6b525bda7a43e840554649a5681bb478077a2dc6dc68a"
    },
    {
      "baseHexagramNumber": 8,
      "changedHexagramNumber": 60,
      "sourceEntryNumber": 60,
      "sourceIconHexagramNumber": 60,
      "hexagramName": "節",
      "poemText": "牙 生齒，室堂啟戶。幽人利貞，鼓翼起舞。",
      "sourceParagraphSha256": "sha256:e391e7df0e49074c306bd3a009e63f4c0fa66a9c07f73e57618ec697c1456f5f",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:53fd1a22fba71eb5247726aa5d966cf25bda7bd7dabd312dccfc2ae311f1fea2"
    },
    {
      "baseHexagramNumber": 8,
      "changedHexagramNumber": 61,
      "sourceEntryNumber": 61,
      "sourceIconHexagramNumber": 61,
      "hexagramName": "中孚",
      "poemText": "春鴻飛東，以馬貨金。利得十倍，重載歸鄉。",
      "sourceParagraphSha256": "sha256:5dd875f75ddbdcd28e5810949c62196889dda224efe3724a7aace8530918bbcf",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:65b6b68871bf82ceee1c0035f1363d08c270af01c413728865f37b0b16472d8d"
    },
    {
      "baseHexagramNumber": 8,
      "changedHexagramNumber": 62,
      "sourceEntryNumber": 62,
      "sourceIconHexagramNumber": 62,
      "hexagramName": "小過",
      "poemText": "歡悅以喜，子孫俱在。守強能忍，不見殃咎。",
      "sourceParagraphSha256": "sha256:4b5d32f7625908404f7eda5bdce3b782932c2f6985a2513115b23364aa9ed33f",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:57b33f0f82c3f58de1e9daf76a92c2251c7238005c24ba13148dc23877926249"
    },
    {
      "baseHexagramNumber": 8,
      "changedHexagramNumber": 63,
      "sourceEntryNumber": 63,
      "sourceIconHexagramNumber": 63,
      "hexagramName": "既濟",
      "poemText": "精神消落，形骸醜惡。齟齬頓挫，枯槁腐蠹。",
      "sourceParagraphSha256": "sha256:a8db9d8a302407bfc38152f21869404f0282db2209d5f4ca4f0b4d8befab5e91",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:59f3baf1538311ca489427bdd65866f644dfdb60aa42eb8055551d0d5afab175"
    },
    {
      "baseHexagramNumber": 8,
      "changedHexagramNumber": 64,
      "sourceEntryNumber": 64,
      "sourceIconHexagramNumber": 64,
      "hexagramName": "未濟",
      "poemText": "登高上山，見王自言。申理我冤，得職蒙恩。",
      "sourceParagraphSha256": "sha256:08ea9bf0692843023a9b3eb71ea965b72ef596f26738dabbcabec8df213d5e4a",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:291dfb3fe95427a7b2fc58594872d47c921526cef40bb42734c5640232e728d4"
    }
  ]
}
