  "attribution": "來源：《焦氏易林》，易學網《焦氏易林［四庫全書版］》（依據版本：《欽定四庫全書》子部術數類），https://www.eee-learning.com/book/giauii 。依來源要求標示出處及原網頁連結；本站僅整理林辭原文，並記錄收錄、標點及文字整理修改。",
  "entryCount": 64,
  "missingTargets": [],
  "entries": [
    {
      "baseHexagramNumber": 10,
      "changedHexagramNumber": 10,
      "sourceEntryNumber": 10,
      "sourceIconHexagramNumber": 10,
      "hexagramName": "履",
      "poemText": "十鳥俱飛，羿射九雌。雄獨得全，雖驚不危。",
      "sourceParagraphSha256": "sha256:e2927caa07213efa34a2dbcdec0510d175f8e7f23db3d7fdfb261552fa0621ed",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:2ff727124b2d86106daf073d5237f900c190f0f962be9e51c868f30727112cd7"
    },
    {
      "baseHexagramNumber": 10,
      "changedHexagramNumber": 1,
      "sourceEntryNumber": 1,
      "sourceIconHexagramNumber": 1,
      "hexagramName": "乾",
      "poemText": "東向蕃垣，相與笑言。子般執鞭，樂人作歡。",
      "sourceParagraphSha256": "sha256:82ffc019c27fa0a737b417cfab20175f5faf995e68860e23c71a952d98844701",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ee8c2be727c080795388684d530932317c5754b4b940a22519bdcb99af2c747b"
    },
    {
      "baseHexagramNumber": 10,
      "changedHexagramNumber": 2,
      "sourceEntryNumber": 2,
      "sourceIconHexagramNumber": 2,
      "hexagramName": "坤",
      "poemText": "循河榜舟，旁淮東遊。漁父舉網，先得大魚。",
      "sourceParagraphSha256": "sha256:135c248f4ab9b3506cdbd4edb33f78cfed96f658df4e104f9af4586be749192a",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:9af54aac66600934e96d493e691bf3fda91da92a4ec32318866ff75d993626f8"
    },
    {
      "baseHexagramNumber": 10,
      "changedHexagramNumber": 3,
      "sourceEntryNumber": 3,
      "sourceIconHexagramNumber": 3,
      "hexagramName": "屯",
      "poemText": "轅折輪破，馬倚僕臥。後旅失宿，右足跌踒。",
      "sourceParagraphSha256": "sha256:dd3ab654d107f20f2bb64c40fd8fa8e6271368b5edf112c67ce27d52e40d4525",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:bdf718ebc83b8d9cda864cbdd1e71cc12063d172bfb36255e33dca718f0ebf83"
    },
    {
      "baseHexagramNumber": 10,
      "changedHexagramNumber": 4,
      "sourceEntryNumber": 4,
      "sourceIconHexagramNumber": 4,
      "hexagramName": "蒙",
      "poemText": "兩人相伴，相與悖戾。心乖不同，訟爭凶凶。",
      "sourceParagraphSha256": "sha256:89878aa4c1e0077242c79e7e71272624fc0c7a95f9a4439b66534c704ea335e5",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:19cc9b3448bd19aabb8ab366754878cbfd19f487e776eec8ac0d78bcfdd5e9ee"
    },
    {
      "baseHexagramNumber": 10,
      "changedHexagramNumber": 5,
      "sourceEntryNumber": 5,
      "sourceIconHexagramNumber": 5,
      "hexagramName": "需",
      "poemText": "北辰紫宮，衣冠在中。含和建德，常受天福。",
      "sourceParagraphSha256": "sha256:4362942a21b53ffc7f81ffc3f3176830f5ea894fb81e5982ab03ed080615c3db",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:8b905a62c9ef99ba7ff047a65db1c5f3fe95f730b935c4c052237dcc99cadfc2"
    },
    {
      "baseHexagramNumber": 10,
      "changedHexagramNumber": 6,
      "sourceEntryNumber": 6,
      "sourceIconHexagramNumber": 6,
      "hexagramName": "訟",
      "poemText": "遊居石門，祿祉安全。受福西鄰，歸飲玉泉。",
      "sourceParagraphSha256": "sha256:d071ff7279f61addc26459279211626506b0823dba9ad650abbc80b41699570e",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ed2b9bae50d8a71c0df37f80ee3f6386dae6e3c549499a66efd4be97ea826bdd"
    },
    {
      "baseHexagramNumber": 10,
      "changedHexagramNumber": 7,
      "sourceEntryNumber": 7,
      "sourceIconHexagramNumber": 7,
      "hexagramName": "師",
      "poemText": "羊腸九縈，相推併前。止須王孫，乃能上天。",
      "sourceParagraphSha256": "sha256:83fb490fe47d24cda041bb54c65a205a9786baf6d9ee6abd0f06b6ed6e0df189",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:3be11a9f3151dfd0d9ae146d2f30d0448c6a4ba4868e81281af3c4cccb75b36c"
    },
    {
      "baseHexagramNumber": 10,
      "changedHexagramNumber": 8,
      "sourceEntryNumber": 8,
      "sourceIconHexagramNumber": 8,
      "hexagramName": "比",
      "poemText": "爭訟相倍，和氣不處。陰陽俱否，谷風母子。",
      "sourceParagraphSha256": "sha256:a5bfef99f5fb6f7990e3b4e4560b8b945daf9014cff8bc588594e0ad1e1ebb29",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:dfb2c78170066f371dddb1308cad6885f19b256d52ac93c1832cf9bfded120c7"
    },
    {
      "baseHexagramNumber": 10,
      "changedHexagramNumber": 9,
      "sourceEntryNumber": 9,
      "sourceIconHexagramNumber": 9,
      "hexagramName": "小畜",
      "poemText": "郭叔距頤，為棘所拘。童顏重顙，禍不成殃。復歸其鄉。",
      "sourceParagraphSha256": "sha256:6324718acc54c661913fb6a6769263931bdd28f81f03a1386f75e2d28356b0bd",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:5792fa83356a99eb752ada82376b119b091a574f76bd8bccdac56358366fa47f"
    },
    {
      "baseHexagramNumber": 10,
      "changedHexagramNumber": 11,
      "sourceEntryNumber": 11,
      "sourceIconHexagramNumber": 11,
      "hexagramName": "泰",
      "poemText": "蠆室蜂戶，螫我手足。不得進止，為吾害賊。",
      "sourceParagraphSha256": "sha256:ba54d11dc5191f098b2ed143adce5e1819977276184971b2aa388dcb85bd4f39",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:c9116dcdfda279b7ed4ac65ce084cfd08c051404a203dc77900daed8691ba9d7"
    },
    {
      "baseHexagramNumber": 10,
      "changedHexagramNumber": 12,
      "sourceEntryNumber": 12,
      "sourceIconHexagramNumber": 12,
      "hexagramName": "否",
      "poemText": "怒非其願，因物有遷。貪妒腐鼠，而呼鴞鳶。自合失餌，倒被困患。",
      "sourceParagraphSha256": "sha256:cd686fadf7c7523adf23ffd66ddfa4ec2aab75a20fcf45b6f686baf16e32d5e9",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:6ca00ef8e2960686a1eba6cc5fe459da8a46766525fb8f8ba58f33f86c8d62a2"
    },
    {
      "baseHexagramNumber": 10,
      "changedHexagramNumber": 13,
      "sourceEntryNumber": 13,
      "sourceIconHexagramNumber": 13,
      "hexagramName": "同人",
      "poemText": "嬰孩求乳，母歸其子。黃麑悅喜。",
      "sourceParagraphSha256": "sha256:87e73fcefdd8a30e6ed3afeab31e2647aa284a6ed135aa67ace85eb2b94196a4",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:f1bf215b93cd252154ae9668bfcaf6addde57c783058588950413ab605b1aa83"
    },
    {
      "baseHexagramNumber": 10,
      "changedHexagramNumber": 14,
      "sourceEntryNumber": 14,
      "sourceIconHexagramNumber": 14,
      "hexagramName": "大有",
      "poemText": "鍼縷徒勞，錦繡不成。鷹逐雉兔，爪折不得。",
      "sourceParagraphSha256": "sha256:0bf149c0a94195743b4d71d50ef5ab45e34884e41e1c5930d5cc4625f1af6e57",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:bc438ac14bbaea69cff14d519713aaea02daca691d6134df266f4ec396f70eb8"
    },
    {
      "baseHexagramNumber": 10,
      "changedHexagramNumber": 15,
      "sourceEntryNumber": 15,
      "sourceIconHexagramNumber": 15,
      "hexagramName": "謙",
      "poemText": "雨潦集降，河渠不通。齊魯閉塞，破費市空。",
      "sourceParagraphSha256": "sha256:103e36fddb79838f0bc16d7803e9a7201a17489f52c3f8a050a4b2c4e7d50506",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:322831a13077cbf98af8ea347223a946685e84084a49aa9e8f0052d37a7b6122"
    },
    {
      "baseHexagramNumber": 10,
      "changedHexagramNumber": 16,
      "sourceEntryNumber": 16,
      "sourceIconHexagramNumber": 16,
      "hexagramName": "豫",
      "poemText": "封豕溝瀆，水潦空谷。客止宿舍，泥塗至腹。處無黍稷。",
      "sourceParagraphSha256": "sha256:7c5aa2c76ea432a6e7dc8b23c53f592b2f71c5586142b7996329c193d933336f",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:1a8d2a95672152ef4f0ce1c57f698047fa9b2d77aefbab756f8afbcb59f4d6fe"
    },
    {
      "baseHexagramNumber": 10,
      "changedHexagramNumber": 17,
      "sourceEntryNumber": 17,
      "sourceIconHexagramNumber": 17,
      "hexagramName": "隨",
      "poemText": "三姦相擾，桀跖為友。上下騷離，隔絕天道。",
      "sourceParagraphSha256": "sha256:0d05fd7b2f7d6c880ccce552505966d8251ab28ff46f0d88ad546869d772afdc",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:79cabe44bcd05e5993db3c84f99df4dddf6da0fff80f8d9cddf77ecc9bf60896"
    },
    {
      "baseHexagramNumber": 10,
      "changedHexagramNumber": 18,
      "sourceEntryNumber": 18,
      "sourceIconHexagramNumber": 18,
      "hexagramName": "蠱",
      "poemText": "齊景惑疑，為孺子午。嫡庶不明，賊 為患。",
      "sourceParagraphSha256": "sha256:affa855537310056f42a20409fa628f414addc071c4cbc4d43a516485118a243",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:e822fb4abb4e5c9c1662cde211b373a7b1977d887477f5eb5ec35f4647307bd9"
    },
    {
      "baseHexagramNumber": 10,
      "changedHexagramNumber": 19,
      "sourceEntryNumber": 19,
      "sourceIconHexagramNumber": 19,
      "hexagramName": "臨",
      "poemText": "三羊俱亡，奔走南行。會暮失跡，不知其藏。",
      "sourceParagraphSha256": "sha256:174b16c733e6e07988ec2a6ce449b4853458a17ab9dbb61f25bccd94a2211fd5",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:9eb468f14b83295c120a38eb92bfcc7e9fde06eccab454d1dc7b68273787f8f4"
    },
    {
      "baseHexagramNumber": 10,
      "changedHexagramNumber": 20,
      "sourceEntryNumber": 20,
      "sourceIconHexagramNumber": 20,
      "hexagramName": "觀",
      "poemText": "請伯行賈，岱山之野。犯歷險阻，不逢危殆。利如澆酒。",
      "sourceParagraphSha256": "sha256:ea9901a2ac60c8eb8001f64a031467d3ffafc73706df7577687c3b071c1d93cd",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:7624c53fe940ef474d1d7e286afa8a215e0063b21d4061e6f55c4824d6c971f3"
    },
    {
      "baseHexagramNumber": 10,
      "changedHexagramNumber": 21,
      "sourceEntryNumber": 21,
      "sourceIconHexagramNumber": 21,
      "hexagramName": "噬嗑",
      "poemText": "桑方將落，殞其黃葉。失勢傾側，而無所立。",
      "sourceParagraphSha256": "sha256:3bd830932ae76b156d5b03c6a85fb2a66c8b7e3b028899e65e9e17914da13273",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:c76753e16d88b3050a32dbe2df14748a3e6542b6fdbe59008d82b77a034dc3e2"
    },
    {
      "baseHexagramNumber": 10,
      "changedHexagramNumber": 22,
      "sourceEntryNumber": 22,
      "sourceIconHexagramNumber": 22,
      "hexagramName": "賁",
      "poemText": "山上求魚，入水捕兔。市非其歸，自令久留。",
      "sourceParagraphSha256": "sha256:68cf90047658c74e1f229e43458ba3d1fe2534777d32aad50bd8e0b32df8b58b",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:0f4a857961ff62e5401f692c98090d0fceea6f758c84338ada6630e88961a41a"
    },
    {
      "baseHexagramNumber": 10,
      "changedHexagramNumber": 23,
      "sourceEntryNumber": 23,
      "sourceIconHexagramNumber": 23,
      "hexagramName": "剝",
      "poemText": "名成德就，項領不試。景公耋老，尼父逝去。",
      "sourceParagraphSha256": "sha256:7d203142886f1e34f3fd5e5168b393bb883855eae617d7bf1c1c39ea97bc1380",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:2b216dee4e0a38b56e44209202913585c587276286e610cd060ee928d70b742d"
    },
    {
      "baseHexagramNumber": 10,
      "changedHexagramNumber": 24,
      "sourceEntryNumber": 24,
      "sourceIconHexagramNumber": 24,
      "hexagramName": "復",
      "poemText": "天之奧隅，堯舜所居。可以存身，保我邦國。",
      "sourceParagraphSha256": "sha256:da25b547633e0a6c2d82c210936279c4c6a06cf0d56aa94b8374827430b17f52",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:a49ae3ee2574a0720c7eaf58efda5560cc8652ef4140674c1f3e022cd102e521"
    },
    {
      "baseHexagramNumber": 10,
      "changedHexagramNumber": 25,
      "sourceEntryNumber": 25,
      "sourceIconHexagramNumber": 25,
      "hexagramName": "无妄",
      "poemText": "涉伯殉名，棄禮誅身。成子奔燕。",
      "sourceParagraphSha256": "sha256:497cd64c8379c0ae1084cdeec1cad66cb939c4f741b252518980a6a423a50fb1",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:d66a2c5a1f67f91346f7229b7cb7b20055200a4a04753da0651703b2fcbd786e"
    },
    {
      "baseHexagramNumber": 10,
      "changedHexagramNumber": 26,
      "sourceEntryNumber": 26,
      "sourceIconHexagramNumber": 26,
      "hexagramName": "大畜",
      "poemText": "兩人俱爭，莫能有定。心乖不同，訟言起凶。",
      "sourceParagraphSha256": "sha256:1300a1c73f4302068b0fc1a22c9f5f8d8aa830b970edcca83df961abe6c0af9e",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:4fa4706027fdaf87cb099f12ad4e51f618e7a64f2c8ef9e72f9091e3e5b3e30a"
    },
    {
      "baseHexagramNumber": 10,
      "changedHexagramNumber": 27,
      "sourceEntryNumber": 27,
      "sourceIconHexagramNumber": 27,
      "hexagramName": "頤",
      "poemText": "雎鳩淑女，聖賢配耦。宜家受福，吉善長久。",
      "sourceParagraphSha256": "sha256:86f9649272d1e92d75417660b2d71586f1e7bdb3367c0e528a657ca0a7b0deb2",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:76db7032b4c0a2f8ebd0380aeaaf7c45dc67472221b66c5e1b96fc64651e8031"
    },
    {
      "baseHexagramNumber": 10,
      "changedHexagramNumber": 28,
      "sourceEntryNumber": 28,
      "sourceIconHexagramNumber": 28,
      "hexagramName": "大過",
      "poemText": "踰河求橘，并得大栗。烹羊食炙，飯酒歌笑。",
      "sourceParagraphSha256": "sha256:088a93fb923013a8b7b4aebe32060d72fa8e39b8028d69d7dcaa476af67f194d",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:9741fe687d2abe00b8fad465e99a6b99a179071b99a463e2ddf0c3ea6b8bf9e3"
    },
    {
      "baseHexagramNumber": 10,
      "changedHexagramNumber": 29,
      "sourceEntryNumber": 29,
      "sourceIconHexagramNumber": 29,
      "hexagramName": "坎",
      "poemText": "山險難行， 中多石。車馳頻擊，重載折軸。擔負差躓，跌踒右足。",
      "sourceParagraphSha256": "sha256:93d3174f4bf1d19f36eeff14692c3e3cc9e4eb040c06b9576072c0af30fceb40",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:665eca3259a7546050f4856f32405aeeae1e6ebb8e0789cb943b1e3da35f5551"
    },
    {
      "baseHexagramNumber": 10,
      "changedHexagramNumber": 30,
      "sourceEntryNumber": 30,
      "sourceIconHexagramNumber": 30,
      "hexagramName": "離",
      "poemText": "允利孔福，神所子畜。般樂無苦，得其歡欲。",
      "sourceParagraphSha256": "sha256:8108683ec31d5d3b78dfc0962fdf66f077b511a13265732ae0c277014caa4e77",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:307cba06e60c27cc78f975ae79dd72a40f8aeafcd1cdfe734977b7ad3fba9149"
    },
    {
      "baseHexagramNumber": 10,
      "changedHexagramNumber": 31,
      "sourceEntryNumber": 31,
      "sourceIconHexagramNumber": 31,
      "hexagramName": "咸",
      "poemText": "鳥鵲食穀，張口受哺。蒙被恩福，長大成就。柔順利貞，君臣合德。",
      "sourceParagraphSha256": "sha256:6a8713985d0800dadacf30f8ae409a70e343840ddc6d26bcbf398d0dfc5e410a",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:4d61612e520d41034832700d6dfe0aa8c3047167fdf0bb6b67f7064eb108f4dd"
    },
    {
      "baseHexagramNumber": 10,
      "changedHexagramNumber": 32,
      "sourceEntryNumber": 32,
      "sourceIconHexagramNumber": 32,
      "hexagramName": "恒",
      "poemText": "潼滃蔚薈，膚寸來會。津液下降，流潦滂沛。",
      "sourceParagraphSha256": "sha256:7a7a03d10720a77befa1ea2864bf9f7c7a413613b573e9699366c01788691922",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:1bcfbb442df0263239e3397de615562457b87e940ac0d8b9424cffb0ee101926"
    },
    {
      "baseHexagramNumber": 10,
      "changedHexagramNumber": 33,
      "sourceEntryNumber": 33,
      "sourceIconHexagramNumber": 33,
      "hexagramName": "遯",
      "poemText": "路多枳棘，步刺我足。不利旅客，為心作毒。",
      "sourceParagraphSha256": "sha256:2d79ed1e06d046cb20f90e0c444d751fb88afb4046920b1ec472884031066de2",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:dca6d263900f80d6dc089138001f74b63022035639546540ce4616ddc40f4e6c"
    },
    {
      "baseHexagramNumber": 10,
      "changedHexagramNumber": 34,
      "sourceEntryNumber": 34,
      "sourceIconHexagramNumber": 34,
      "hexagramName": "大壯",
      "poemText": "虺蛇求聚，難以居處。毒螫痛甚，瘡不可愈。",
      "sourceParagraphSha256": "sha256:ae5d15da89b5d2508339b9d0a5cb3a07c1c533ff0242d7df368784044b8d385a",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:721080f2a79e1d7552d36d93b4f39141f6f65f523e9d35ffd3e247587d49a0d6"
    },
    {
      "baseHexagramNumber": 10,
      "changedHexagramNumber": 35,
      "sourceEntryNumber": 35,
      "sourceIconHexagramNumber": 35,
      "hexagramName": "晉",
      "poemText": "麟鳳相隨，察觀安危。東國聖人，后稷周公。君子攸同，利以居止。長無災凶。",
      "sourceParagraphSha256": "sha256:319fcca4d215f0d23022b14e30dafde558e2daf8cc785e4d3b4cd34c367446e0",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:9b49d1ae8540f2c14799e00f2cb6c6bd168ac6807887988ea985f2b6f505d1fc"
    },
    {
      "baseHexagramNumber": 10,
      "changedHexagramNumber": 36,
      "sourceEntryNumber": 36,
      "sourceIconHexagramNumber": 36,
      "hexagramName": "明夷",
      "poemText": "桀亂不時，使民恨憂。六祉為笑，君危臣羞。",
      "sourceParagraphSha256": "sha256:f7f755b4aa00f27fa0142308dc6ba0db0c32d5ea6b494ff0c1ea5ab14c0fd8a2",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:d65ce130fb7afcab6ed4ed2da0cf830ea7929469d079bc615be04dc1ede47139"
    },
    {
      "baseHexagramNumber": 10,
      "changedHexagramNumber": 37,
      "sourceEntryNumber": 37,
      "sourceIconHexagramNumber": 37,
      "hexagramName": "家人",
      "poemText": "黃帝所生，伏羲之宇。兵刃不至，利以居止。",
      "sourceParagraphSha256": "sha256:037b0a54de00bf5ffd217bef33a2b19b09aac53f6e5008a5a956b6a00ac6546f",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:0728eb454efb8079e862cbd6d632c7c926d25214827a3c4cc629e4f649a0a35b"
    },
    {
      "baseHexagramNumber": 10,
      "changedHexagramNumber": 38,
      "sourceEntryNumber": 38,
      "sourceIconHexagramNumber": 38,
      "hexagramName": "睽",
      "poemText": "雀行求粒，暮歸喔嚅。反其室舍，安寧如故。",
      "sourceParagraphSha256": "sha256:657bf248dd6aa80a8ef2c62575bc5f77bbecc0dfa74184ff948ea7537ee4a305",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:e08e4bd40350ea2e985dcc97711dc1e37a08767d0445ef4905e5e8b14eaa4f1e"
    },
    {
      "baseHexagramNumber": 10,
      "changedHexagramNumber": 39,
      "sourceEntryNumber": 39,
      "sourceIconHexagramNumber": 39,
      "hexagramName": "蹇",
      "poemText": "太倉積穀，天下饒食。陰陽調和，年歲時熟。",
      "sourceParagraphSha256": "sha256:e92d655db5cf32fc2cad7e8539c2ed613c519dce40863c13d96b17eadbdd0b11",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:eaccca0d90bd42ce4a2b0301d27379acf298e063fb90869916c098da55a82cae"
    },
    {
      "baseHexagramNumber": 10,
      "changedHexagramNumber": 40,
      "sourceEntryNumber": 40,
      "sourceIconHexagramNumber": 40,
      "hexagramName": "解",
      "poemText": "干旄旗旌，執幟在郊。雖有寶珠，無路致之。師之隨，豫之中孚）",
      "sourceParagraphSha256": "sha256:4cb8083b4b73f6fae55c055f4eeb2ed9c5405962fbb2fd70ba726c35b9a72b1c",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:3ac9a14a0e21f8ae491d2b3cee30c18f2e48969335efc420362c76753b728364"
    },
    {
      "baseHexagramNumber": 10,
      "changedHexagramNumber": 41,
      "sourceEntryNumber": 41,
      "sourceIconHexagramNumber": 41,
      "hexagramName": "損",
      "poemText": "履危蹈顛，墜入泉淵。蹇能不前，足踒不便。",
      "sourceParagraphSha256": "sha256:da3c951738e8663c4b6293b26ed4bd8c04a030f19e0f775319a8a7c84f00858c",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:6b9a17219557145d518e6da6045b7cc13a97c6b0ff316cc879ec5bcf4f5dceb9"
    },
    {
      "baseHexagramNumber": 10,
      "changedHexagramNumber": 42,
      "sourceEntryNumber": 42,
      "sourceIconHexagramNumber": 42,
      "hexagramName": "益",
      "poemText": "銜命上車，和合兩家。蛾眉皓齒，二國不殆。",
      "sourceParagraphSha256": "sha256:1d0bc43a24d940d4c59d7a36cf514a40422192678f180c6a17650f5e575e6acf",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:6b493f512d95f2116b7de39ca59baeb5958acc5fd3ff0342495d938022c4b141"
    },
    {
      "baseHexagramNumber": 10,
      "changedHexagramNumber": 43,
      "sourceEntryNumber": 43,
      "sourceIconHexagramNumber": 43,
      "hexagramName": "夬",
      "poemText": "吉日車攻，田弋獲禽。宣王飲酒，以告家功。",
      "sourceParagraphSha256": "sha256:a3c91995be306c68265870dff36fdfa81b2231e4953e49f78b19ab459a0d30c5",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:a3dfc21546bcd17768326b3db0a65dd743676437fdf8ebfa0a8bf19d8ce34f1f"
    },
    {
      "baseHexagramNumber": 10,
      "changedHexagramNumber": 44,
      "sourceEntryNumber": 44,
      "sourceIconHexagramNumber": 44,
      "hexagramName": "姤",
      "poemText": "金帛貴寶，宜與我市。嫁娶有恩，得利過倍。",
      "sourceParagraphSha256": "sha256:f5924fff4f78ab1653938c5fe76e9fc3943581e6cb2dae9406addb118b58328b",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ea4c221d8c837203c83e5fb8c3113ad020fb8e9111c8790c10d43c57e591f332"
    },
    {
      "baseHexagramNumber": 10,
      "changedHexagramNumber": 45,
      "sourceEntryNumber": 45,
      "sourceIconHexagramNumber": 45,
      "hexagramName": "萃",
      "poemText": "延頸望酒，不入我口。深以自喜，利得無有。",
      "sourceParagraphSha256": "sha256:93c44729143a99ce76e049366ca0b5e41e627f74cef9be9ef96fefb0b6dabd2e",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:8b5f6d93a527c9316187a209346e66acfa355cdfb0cf78726e40fe98148da04a"
    },
    {
      "baseHexagramNumber": 10,
      "changedHexagramNumber": 46,
      "sourceEntryNumber": 46,
      "sourceIconHexagramNumber": 46,
      "hexagramName": "升",
      "poemText": "牧為代守，饗養甘賜。得利士意，戰大破鹵。長安國家。",
      "sourceParagraphSha256": "sha256:b37807d038e814caafe5dadcbe44296bdcf895e76cf582f52186a05f21dcc555",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:658ceb5860a796e0f7c78970ee781c453cae21c670cb58c1d8e04590a56e2aa4"
    },
    {
      "baseHexagramNumber": 10,
      "changedHexagramNumber": 47,
      "sourceEntryNumber": 47,
      "sourceIconHexagramNumber": 47,
      "hexagramName": "困",
      "poemText": "日出溫谷，照臨萬國。高明淑人，虞夏配合。",
      "sourceParagraphSha256": "sha256:1692199beb5ff8a039151f9b821e04b91030ca1d5402c44eb2c47528e0093711",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:f8ec60a3c11c6b3449e09d7c51d9754f05fa850ef6877c78b9e05d689b5478f2"
    },
    {
      "baseHexagramNumber": 10,
      "changedHexagramNumber": 48,
      "sourceEntryNumber": 48,
      "sourceIconHexagramNumber": 48,
      "hexagramName": "井",
      "poemText": "逐兔索烏，破我弓車。日暮不及，失利後時。",
      "sourceParagraphSha256": "sha256:c4b8336af7f85aa801d65d2923d457e58f51d2c22b78773350adf3821d1a9671",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:72203f7d6170ba8da702ea8b5f74c39bb6826cc23a2193e4386eb2415d779257"
    },
    {
      "baseHexagramNumber": 10,
      "changedHexagramNumber": 49,
      "sourceEntryNumber": 49,
      "sourceIconHexagramNumber": 49,
      "hexagramName": "革",
      "poemText": "言妄語，傳相詿誤。道左失跡，不知戶處。",
      "sourceParagraphSha256": "sha256:cc0bd89a273f3da022e68b69bb239261c7350d98d28d3b4926c6eecd1de36b2d",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:662177c185dbbf9545b88dacac9795bac37026505665379e89938eb32fa6ae1c"
    },
    {
      "baseHexagramNumber": 10,
      "changedHexagramNumber": 50,
      "sourceEntryNumber": 50,
      "sourceIconHexagramNumber": 50,
      "hexagramName": "鼎",
      "poemText": "履虎躡尾，貶損我威。君子失否，去其國家。",
      "sourceParagraphSha256": "sha256:4b7ec1ca5d9e1bc044679fed4709b7778770ed70936eee960d6807488f709cc7",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:404f8c8983809683a125d4dc9ef1cd0468128a54310372ce5e7a441d7dba86d3"
    },
    {
      "baseHexagramNumber": 10,
      "changedHexagramNumber": 51,
      "sourceEntryNumber": 51,
      "sourceIconHexagramNumber": 51,
      "hexagramName": "震",
      "poemText": "本根不固，新花落去。更為孤嫗，不得相視。",
      "sourceParagraphSha256": "sha256:f139badf2b1cec1d5856612fb5e1ab0b45b5ff265c3391e2aea136df191f8e7e",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:3eb45a7be7e2b9c4f2b2e380f8b21b01309d0d851a4a33cadc9e64ece780f5f7"
    },
    {
      "baseHexagramNumber": 10,
      "changedHexagramNumber": 52,
      "sourceEntryNumber": 52,
      "sourceIconHexagramNumber": 52,
      "hexagramName": "艮",
      "poemText": "五軛四國，優得饒有。陳力就列，騶虞悅喜。",
      "sourceParagraphSha256": "sha256:96c082454533bf940e3f47cee25060a2e02aebf4f022cda5bf84ac7526b5b1ed",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:74d4095e449d6f98808b141ea6dfb94a12407fc6d60228e71c278d4a2fcc9087"
    },
    {
      "baseHexagramNumber": 10,
      "changedHexagramNumber": 53,
      "sourceEntryNumber": 53,
      "sourceIconHexagramNumber": 53,
      "hexagramName": "漸",
      "poemText": "黃帝紫雲，聖哲且神。光明見祥，告我無殃。",
      "sourceParagraphSha256": "sha256:294488f41d85eb71abadb0a19fbfb08209bb7e893824c311e6df96ced6394872",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:e46f2703e93d7d8744d7b696f5e740a563c1a66681c36cbfc7b81aa288dab4d3"
    },
    {
      "baseHexagramNumber": 10,
      "changedHexagramNumber": 54,
      "sourceEntryNumber": 54,
      "sourceIconHexagramNumber": 54,
      "hexagramName": "歸妹",
      "poemText": "五利四福，俱田高邑。黍稷盛茂，多獲槁稻。",
      "sourceParagraphSha256": "sha256:497bd823606f60af07350c37326a4509e7a67789d4808cce276158b6b566e07f",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:274b9d121b8e3225caef3aa6d61f13a4420befeaf1b084da73cb81cf24efb382"
    },
    {
      "baseHexagramNumber": 10,
      "changedHexagramNumber": 55,
      "sourceEntryNumber": 55,
      "sourceIconHexagramNumber": 55,
      "hexagramName": "豐",
      "poemText": "群虎入邑，求索肉食。大人衛守，君不失國。",
      "sourceParagraphSha256": "sha256:c732b77e24ebcd2502e87bacdbe222547ba2db61d1d4029336490520d1d008f5",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:22b5a1f0d40d263534e9a0d981a7884edc2d938bc64e87dbdcf8707fdcc0f65d"
    },
    {
      "baseHexagramNumber": 10,
      "changedHexagramNumber": 56,
      "sourceEntryNumber": 56,
      "sourceIconHexagramNumber": 56,
      "hexagramName": "旅",
      "poemText": "烏子鵲雛，常與母居。願慕群旅，不育其巢。",
      "sourceParagraphSha256": "sha256:2f1ccd7dd79bd1eb0c01e9d328fcb14f1ab286200fef4d14df5816490ada6fe3",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:f14e8c191d8b9863bcb57be75d519f6ab6eda29fa7d84339cdc9819afa276c61"
    },
    {
      "baseHexagramNumber": 10,
      "changedHexagramNumber": 57,
      "sourceEntryNumber": 57,
      "sourceIconHexagramNumber": 57,
      "hexagramName": "巽",
      "poemText": "蹇驢不材，駿驥失時。筋勞力盡，疲於沙丘。",
      "sourceParagraphSha256": "sha256:110bbf0f4b376ff247662541fc7863bc45344dae26c41d22beefa084288d3b1c",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:3c12da18e36e15fcfbc3b31ceb9084131ad2d526ccf8030b62042486edfe8324"
    },
    {
      "baseHexagramNumber": 10,
      "changedHexagramNumber": 58,
      "sourceEntryNumber": 58,
      "sourceIconHexagramNumber": 58,
      "hexagramName": "兌",
      "poemText": "元鬣黑顙，東歸高鄉。朱鳥導引，靈龜載莊。遂抵天門，見我貞君。人馬安全。",
      "sourceParagraphSha256": "sha256:4857f7d6921c50987e5a5664bb0420db9033171120ff7f775f7781d830a9200e",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:bc432c75acd75f10afd5862859514d31621da63f43b52391807148c7f37308a0"
    },
    {
      "baseHexagramNumber": 10,
      "changedHexagramNumber": 59,
      "sourceEntryNumber": 59,
      "sourceIconHexagramNumber": 59,
      "hexagramName": "渙",
      "poemText": "探巢得雛，鳩鵲俱來。使我欣娛。",
      "sourceParagraphSha256": "sha256:3cf39f128479f2eeaf520c82490ceeb7e9062b4bc1f23f89bb811d665c703686",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:52340b6d0bf7df860f2ed59647b5e22e1736a5ae74a270c171491e7215310421"
    },
    {
      "baseHexagramNumber": 10,
      "changedHexagramNumber": 60,
      "sourceEntryNumber": 60,
      "sourceIconHexagramNumber": 60,
      "hexagramName": "節",
      "poemText": "安上宜官，一日九遷。升擢超等，牧養常山。",
      "sourceParagraphSha256": "sha256:a05b61219e003ae50479062f830e4b9233e8b3090b0accbab4f1edb063d047cc",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:24cd03cc50ec8d1864389dfd901fd4f8d76ec922b17dd72d842cfd5d00498f46"
    },
    {
      "baseHexagramNumber": 10,
      "changedHexagramNumber": 61,
      "sourceEntryNumber": 61,
      "sourceIconHexagramNumber": 61,
      "hexagramName": "中孚",
      "poemText": "大頭明目，載受嘉福。三雀飛來，與祿相得。",
      "sourceParagraphSha256": "sha256:92a9aa6488c459ef2de35fa47ca0b683f61b26255a4458e257bec5450a929b49",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:e5155dc6406f0f61f9f1743963636ac774c83f40f11eb8a1fdfb8b585c1f8acf"
    },
    {
      "baseHexagramNumber": 10,
      "changedHexagramNumber": 62,
      "sourceEntryNumber": 62,
      "sourceIconHexagramNumber": 62,
      "hexagramName": "小過",
      "poemText": "遠視千里，不見黑子。離婁明視，移於小人。一作離婁之明，無益為光。",
      "sourceParagraphSha256": "sha256:380e1bd790e537a52118edfe39a706b45bdbd0359425f15db6579d5ea06f005c",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:1458d5fa37ff6ea4430ffa7fd1222e38e336f515ecb8987eab9a5dc012ad00bf"
    },
    {
      "baseHexagramNumber": 10,
      "changedHexagramNumber": 63,
      "sourceEntryNumber": 63,
      "sourceIconHexagramNumber": 63,
      "hexagramName": "既濟",
      "poemText": "三女成姦，背夫夜行。與伯笑言，不忍主母。為失醴酒，冤天誰告。",
      "sourceParagraphSha256": "sha256:b4c39f8a79f5b8f1eb532cb156f87fe8f5a3a4ac0d4acc57407a5cc941932225",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:3db7e6791680402501c2bd8645de3bb845e18c96541e2e23b0ca9ac6de4c9382"
    },
    {
      "baseHexagramNumber": 10,
      "changedHexagramNumber": 64,
      "sourceEntryNumber": 64,
      "sourceIconHexagramNumber": 64,
      "hexagramName": "未濟",
      "poemText": "日辰不良，強弱相振。一鳥兩雛，客勝主人。",
      "sourceParagraphSha256": "sha256:50182ff1ab513816193173c4eb53e35abbac96c4f1d949360b44010a9af13336",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:70d1ff6de5cb4fc19dd179bbdb9a8503cfcc85cda07e05e726daf073f1b84d22"
    }
  ]
}
