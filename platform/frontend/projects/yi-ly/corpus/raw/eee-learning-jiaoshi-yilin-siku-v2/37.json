  "entries": [
    {
      "baseHexagramNumber": 37,
      "changedHexagramNumber": 37,
      "sourceEntryNumber": 37,
      "sourceIconHexagramNumber": 37,
      "hexagramName": "家人",
      "poemText": "王命赤烏，與君徼期。征伐無道，誅其君傲。居止何憂。",
      "sourceParagraphSha256": "sha256:c05c73602bebcfedb7a7d735536ec7bf1c2c9aec6999c9fffbe7c493d6691007",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:00e71b0f29505cec985b8ebb244637e219cb39f48eccf5cdc1197815ae780534"
    },
    {
      "baseHexagramNumber": 37,
      "changedHexagramNumber": 1,
      "sourceEntryNumber": 1,
      "sourceIconHexagramNumber": 1,
      "hexagramName": "乾",
      "poemText": "千歲槐根，身多斧痕。傷夷倒掘，枝葉不存。",
      "sourceParagraphSha256": "sha256:eaac71033e5b95e213e1b0de4ae9c885cf79a4f2dafb0bab32f3b222166efaec",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:e800b50390ef4af148358aa03f9bfef6bbfe745da8ef81de16d71ee1962b6c1f"
    },
    {
      "baseHexagramNumber": 37,
      "changedHexagramNumber": 2,
      "sourceEntryNumber": 2,
      "sourceIconHexagramNumber": 2,
      "hexagramName": "坤",
      "poemText": "喭喭諤諤，虎豹相齰。畏懼悚息，終無難惡。",
      "sourceParagraphSha256": "sha256:03cd05a9080816b338a7628ab235583d6725414e4094dc2ebdb1b7b8f3009d34",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ad0f0612b4f619cc7bb7e6088ac9f43669e5a66472367218e5a1b4636dbb5e4d"
    },
    {
      "baseHexagramNumber": 37,
      "changedHexagramNumber": 3,
      "sourceEntryNumber": 3,
      "sourceIconHexagramNumber": 3,
      "hexagramName": "屯",
      "poemText": "娶於姜呂，駕迎新婦。少齊在門，夫子歡喜。",
      "sourceParagraphSha256": "sha256:920a10b4eef9907bf170e3fe4224aa5abf84c3adff410b056c3d8bc6326f1cb6",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:85d8e46e779ec41579a2dd4a3f5c26be9d865b5757413b4cb61985e48b4eba08"
    },
    {
      "baseHexagramNumber": 37,
      "changedHexagramNumber": 4,
      "sourceEntryNumber": 4,
      "sourceIconHexagramNumber": 4,
      "hexagramName": "蒙",
      "poemText": "高壤肥澤，民人孔樂。宜利居止，長安有福。",
      "sourceParagraphSha256": "sha256:6cce32bce11f8fbfec7edc39f3a7e8961f7eb5c80bfbb659ab3112903fdcce8a",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:c48bd2bae87a96c83d025ae52e1a54a9b7be3c0ff9ce1212ad5e929b0be12828"
    },
    {
      "baseHexagramNumber": 37,
      "changedHexagramNumber": 5,
      "sourceEntryNumber": 5,
      "sourceIconHexagramNumber": 5,
      "hexagramName": "需",
      "poemText": "主有聖德，上配太極。皇靈建中，授我以福。",
      "sourceParagraphSha256": "sha256:16b0ec65c1506dd931e7dd5a778dcf66a0b3b207c24264e8208b78e67bf89960",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:4c370ab5c57ae36fd1f438dda424e963050882129b614a9dd42cb3babc8a2330"
    },
    {
      "baseHexagramNumber": 37,
      "changedHexagramNumber": 6,
      "sourceEntryNumber": 6,
      "sourceIconHexagramNumber": 6,
      "hexagramName": "訟",
      "poemText": "耄老蒙鈍，不見東西。少者弗慕，君不與謀。懸輿致仕，退歸里居。",
      "sourceParagraphSha256": "sha256:51411756ed57572af062f1e8e9261df766b298f2213ef97f590f4d0345abfcc5",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:f399b444bff962153d7a14a38e53a5b7c746f4e4bede57da363c5e44901e94e8"
    },
    {
      "baseHexagramNumber": 37,
      "changedHexagramNumber": 7,
      "sourceEntryNumber": 7,
      "sourceIconHexagramNumber": 7,
      "hexagramName": "師",
      "poemText": "三狂北行，道逢大狼。暮宿患宅，為禍所傷。",
      "sourceParagraphSha256": "sha256:b5cfb22a8c7cbb47c1daf6d6f65a53dcf9fa644b6c7e704e3017933147001069",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:1249bf3817d0f94dfabc01381628955d9a1516fa3c154f1a96e2caaaeffa756b"
    },
    {
      "baseHexagramNumber": 37,
      "changedHexagramNumber": 8,
      "sourceEntryNumber": 8,
      "sourceIconHexagramNumber": 8,
      "hexagramName": "比",
      "poemText": "更旦初歲，振除禍敗。新衣元服，拜受利福。",
      "sourceParagraphSha256": "sha256:77ae993056022e2bdd27b50fd20c78b3ad207a2c7a99b96f5ef9e9ec7d480723",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:c9500384bf2bf305ebf22d45d36ad8d710c2e84278fb96e9d1f28782e6533811"
    },
    {
      "baseHexagramNumber": 37,
      "changedHexagramNumber": 9,
      "sourceEntryNumber": 9,
      "sourceIconHexagramNumber": 9,
      "hexagramName": "小畜",
      "poemText": "杲杲白日，為月所食。損上（一作下）毀上，鄭昭出走。",
      "sourceParagraphSha256": "sha256:967f9c3914cd70d94331f706a62739823fcb646a9573afdef56f171bbea65034",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:d423c3dada3d390a9e6ad75dd6c70b3fade0280fcfaecaec22f2786836b6468d"
    },
    {
      "baseHexagramNumber": 37,
      "changedHexagramNumber": 10,
      "sourceEntryNumber": 10,
      "sourceIconHexagramNumber": 10,
      "hexagramName": "履",
      "poemText": "君子失意，小人得志。亂憂並作，姦邪充塞。雖有百堯，顛不可救。",
      "sourceParagraphSha256": "sha256:753986e2136be98e13f35355ba6384e103bc7096c6db6ecd346f132f8881aa44",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:395a18dd616766d76487d5c4cb0a188874709013d0e67421780ea79ceb27b6b6"
    },
    {
      "baseHexagramNumber": 37,
      "changedHexagramNumber": 11,
      "sourceEntryNumber": 11,
      "sourceIconHexagramNumber": 11,
      "hexagramName": "泰",
      "poemText": "仁德優洽，恩及異域。澤被殊方，福慶隱伏。作蠶不織，寒無所得。",
      "sourceParagraphSha256": "sha256:753619eb7ddfe9b2cb152baa1dd75164575e8066be4951523242d706386a9746",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:1ab7fadd6698c7d0187a8f993d7f81e4c49d1a24c0222579cedc5cd23d254a9a"
    },
    {
      "baseHexagramNumber": 37,
      "changedHexagramNumber": 12,
      "sourceEntryNumber": 12,
      "sourceIconHexagramNumber": 12,
      "hexagramName": "否",
      "poemText": "東求金玉，反得敝石。名曰無宜，字曰醜惡。眾所賤薄。",
      "sourceParagraphSha256": "sha256:047b2b198ed9534b5be3bc0fbf27142b35a9ab596f2ef38addce94f222894179",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:3a1420be7b76baaa3f4c7f5d4c6fbaa675c478995c04d955cb51f4716cb595ee"
    },
    {
      "baseHexagramNumber": 37,
      "changedHexagramNumber": 13,
      "sourceEntryNumber": 13,
      "sourceIconHexagramNumber": 13,
      "hexagramName": "同人",
      "poemText": "擊鼓合戰，士怯叛亡。威令不行，敗我成功。",
      "sourceParagraphSha256": "sha256:028d8a5b1d4ecf69e3ee7236a8718198377d21781ac0a41ccdfcc54d49c2bbe3",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:68ef5bdf23a0ae0b3c9664e7db66c498f433302d659375d3e79867ddfcac29f9"
    },
    {
      "baseHexagramNumber": 37,
      "changedHexagramNumber": 14,
      "sourceEntryNumber": 14,
      "sourceIconHexagramNumber": 14,
      "hexagramName": "大有",
      "poemText": "仲春孟夏，和氣所舍。生我嘉福，國無殘賊。",
      "sourceParagraphSha256": "sha256:b9b3d1a45b8c0b1f9fd7cdc30af154948f4036da862b012f42f709eb2f6cf16f",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:845abd4c2ec8aad8af69438f13e45dafc5902fe3e40ae8cb2bb4d72843116030"
    },
    {
      "baseHexagramNumber": 37,
      "changedHexagramNumber": 15,
      "sourceEntryNumber": 15,
      "sourceIconHexagramNumber": 15,
      "hexagramName": "謙",
      "poemText": "尹氏伯奇，父子相離。無罪被辜，長舌為災。",
      "sourceParagraphSha256": "sha256:52f02cfe79de70cae351f73cc03656d77b24569f1470e2aebf57ca62714c2a13",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:32491d3fee0ceebebc3c13aa76b763d4e69f53c8f2935d61d3f7e7bce3d68956"
    },
    {
      "baseHexagramNumber": 37,
      "changedHexagramNumber": 16,
      "sourceEntryNumber": 16,
      "sourceIconHexagramNumber": 16,
      "hexagramName": "豫",
      "poemText": "五穀不熟，困民惡極。駕之新邑，嘉禾有得。",
      "sourceParagraphSha256": "sha256:0b70a88e3c7e476db90007da19047f3514708693af0bffaa5c286d13cb67cf04",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:32f096c6ca8d4f2263bfc8b8cef11b790159ebd7184a997c8323595b7b7f22d3"
    },
    {
      "baseHexagramNumber": 37,
      "changedHexagramNumber": 17,
      "sourceEntryNumber": 17,
      "sourceIconHexagramNumber": 17,
      "hexagramName": "隨",
      "poemText": "登虛望貧，暮食無飧。長子南戍，與我生分。",
      "sourceParagraphSha256": "sha256:d08ff639679294711f5c91d2fd230ff251bfea8aabad7dda91f6d12df13a96eb",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:eb0f45abeff569d121203996cb458a5b36fa3956a3e1356f9e10a4102e628e71"
    },
    {
      "baseHexagramNumber": 37,
      "changedHexagramNumber": 18,
      "sourceEntryNumber": 18,
      "sourceIconHexagramNumber": 18,
      "hexagramName": "蠱",
      "poemText": "東市齊魯，南賈荊楚。羽毛齒革，為吾利寶。",
      "sourceParagraphSha256": "sha256:4ef7b7aa3efe8ef40c983b2c562127f5aed68619e33da6c1aef9d264d5f94b37",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:6896edee3165c44f0bd451d20a9098e35a9f525a423120742ee6578b5f094602"
    },
    {
      "baseHexagramNumber": 37,
      "changedHexagramNumber": 19,
      "sourceEntryNumber": 19,
      "sourceIconHexagramNumber": 19,
      "hexagramName": "臨",
      "poemText": "節情省欲，賦斂有度。家給人足，公劉以富。",
      "sourceParagraphSha256": "sha256:d80868c632941e4c0a736bc80ffe7a32b95807f985daf9a84f3405fddcf7bc18",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:99cc7ed4f6f87146244f5744f80b47f5979bf6534454bf9c2b1079c8c0b435f8"
    },
    {
      "baseHexagramNumber": 37,
      "changedHexagramNumber": 20,
      "sourceEntryNumber": 20,
      "sourceIconHexagramNumber": 20,
      "hexagramName": "觀",
      "poemText": "恭寬信敏，功加四海。辟去不祥，喜來從母。",
      "sourceParagraphSha256": "sha256:4beddc6e089219adace2d509c913d6d78fdffc8fe98d0eb2d2e048ee0817215f",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:cfafa01d575df99986efdaa530227f89375b20fc8a7982e73e4c2266fe1b5545"
    },
    {
      "baseHexagramNumber": 37,
      "changedHexagramNumber": 21,
      "sourceEntryNumber": 21,
      "sourceIconHexagramNumber": 21,
      "hexagramName": "噬嗑",
      "poemText": "張狂妄行，與惡相逢。不得所欲，生我獨凶。",
      "sourceParagraphSha256": "sha256:1272555785984134844097ff1ee0a6cccff7baa97cab460635f58896a7d0694d",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:324c3fe9424d4daccb41587b39eb3ffe05e5c25945e92d250dcb16bf9f3775a8"
    },
    {
      "baseHexagramNumber": 37,
      "changedHexagramNumber": 22,
      "sourceEntryNumber": 22,
      "sourceIconHexagramNumber": 22,
      "hexagramName": "賁",
      "poemText": "畫龍頭頸，文章不成。甘言美語，詭辭無名。",
      "sourceParagraphSha256": "sha256:36d041b94c2e5c036e9048a013eeea272a5579051acb7c92bfefd18fe3541710",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:d0aafdb0ae899b09a21127e1c1f02ccb3dc4db24811405aae1a5a14be92623bc"
    },
    {
      "baseHexagramNumber": 37,
      "changedHexagramNumber": 23,
      "sourceEntryNumber": 23,
      "sourceIconHexagramNumber": 23,
      "hexagramName": "剝",
      "poemText": "騎龍乘鳳，上見神公。彭祖受制，王高贊通。巫咸就位，拜壽無窮。",
      "sourceParagraphSha256": "sha256:c2b2bd547532ea0e3ff5b20766d701e666d2f9960c779b05fc11c520459485c4",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:cf2bda28216eb77fac99ae54ac6ee08ce4cdb41e0051cd1bd3b61155b1177f51"
    },
    {
      "baseHexagramNumber": 37,
      "changedHexagramNumber": 24,
      "sourceEntryNumber": 24,
      "sourceIconHexagramNumber": 24,
      "hexagramName": "復",
      "poemText": "溫仁君子，忠孝所在。八國為鄰，禍災不起",
      "sourceParagraphSha256": "sha256:ac9e71265729015325061615c7c7f3809371209632fb24e0f89086bb801c586d",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:7999e16ed9802789d23b8272357cd708ddc0261273916b55b751d6e1c616e426"
    },
    {
      "baseHexagramNumber": 37,
      "changedHexagramNumber": 25,
      "sourceEntryNumber": 25,
      "sourceIconHexagramNumber": 25,
      "hexagramName": "无妄",
      "poemText": "威權分離，烏夜徘徊。群蔽月光，大人誅傷。",
      "sourceParagraphSha256": "sha256:d5dc3f03966fcaf54b810af9a10c3b0275eac0fb7cefe9ecf92e29d13f0633d8",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:798c04a8c137f1d1ad5ccd1429079c3a70a6a0dc6ab55e90b234d2120535bbd8"
    },
    {
      "baseHexagramNumber": 37,
      "changedHexagramNumber": 26,
      "sourceEntryNumber": 26,
      "sourceIconHexagramNumber": 26,
      "hexagramName": "大畜",
      "poemText": "學靈三年，聖且神明先知吉祥，言喜福慶神鳥來見，告我無窮。",
      "sourceParagraphSha256": "sha256:1e1a9ec3a85ed9572f8f1fe9182416f79520220b66abe05cff0f7952b16dd88e",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:9e7840664eb38116941848d535cabbd4a96e3125c10907671e80eee09afdf760"
    },
    {
      "baseHexagramNumber": 37,
      "changedHexagramNumber": 27,
      "sourceEntryNumber": 27,
      "sourceIconHexagramNumber": 27,
      "hexagramName": "頤",
      "poemText": "東山辭家，處婦思夫。伊威盈室，長股羸戶。歎我君子，役日未已。",
      "sourceParagraphSha256": "sha256:ea2be3d71bff99e7179a3e9e2e6a8e88f343c45f4ce3e09baeacd8cd287678be",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:1b57bf694a52fbf39a41843d2a44cc4fc6b0c37e4c99a15b0bf27830123b0105"
    },
    {
      "baseHexagramNumber": 37,
      "changedHexagramNumber": 28,
      "sourceEntryNumber": 28,
      "sourceIconHexagramNumber": 28,
      "hexagramName": "大過",
      "poemText": "張頷開口，舌直絕齒。然諾不行，政亂無緒。",
      "sourceParagraphSha256": "sha256:b5af34cc7e2c67ef17acec5c402f3b15b8ca77af0aef166ca30026e61a29f000",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:edccaf10c8797b3fbaa943637e6056ab505e69c4366759685536967d64b7ff7e"
    },
    {
      "baseHexagramNumber": 37,
      "changedHexagramNumber": 29,
      "sourceEntryNumber": 29,
      "sourceIconHexagramNumber": 29,
      "hexagramName": "坎",
      "poemText": "吹角高邦，有失牛羊。眾民驚惶，敬慎避咎。敕行不殃。",
      "sourceParagraphSha256": "sha256:b5081f77484c35577ffcae6db218f30ade0abc9da4342f47cfa24882c1f20eb6",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:fdd99d77473048261a47b730b5caf379407ae98e2c8aa00a2663b050236f2e95"
    },
    {
      "baseHexagramNumber": 37,
      "changedHexagramNumber": 30,
      "sourceEntryNumber": 30,
      "sourceIconHexagramNumber": 30,
      "hexagramName": "離",
      "poemText": "南行出城，世德福祉。三姬嫁齊，賴其所欲。",
      "sourceParagraphSha256": "sha256:2704aacf1473628ae680bdfc6ff5eaa70430a68ecd0512b2ea3de6f0bbc041ca",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:84b97ca87b3ad126500094357ad0df39e3406b4072a311ba74c7c9dc9ed9a3de"
    },
    {
      "baseHexagramNumber": 37,
      "changedHexagramNumber": 31,
      "sourceEntryNumber": 31,
      "sourceIconHexagramNumber": 31,
      "hexagramName": "咸",
      "poemText": "心狂志悖，耳聽從類。政令無常，下民多孽。",
      "sourceParagraphSha256": "sha256:da4173a9484fa8e25b8d0707ff0a1374be34cd16cc7d1747d475674f9a0e570c",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:f162f8f7729ad0b988b5e33dbe5ab13ebfe265adaad70f769b046ee24b8c298f"
    },
    {
      "baseHexagramNumber": 37,
      "changedHexagramNumber": 32,
      "sourceEntryNumber": 32,
      "sourceIconHexagramNumber": 32,
      "hexagramName": "恒",
      "poemText": "安上宜官，一日九遷。踰群越等，牧養常山。",
      "sourceParagraphSha256": "sha256:de6f63b38f544d939ebde473d424a086b62cdb3129499c8e2ec18d15f1028763",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:7a3ffda95a1075fb2668226ea8496db38fcf1b70627f62df3502a620f2218ad0"
    },
    {
      "baseHexagramNumber": 37,
      "changedHexagramNumber": 33,
      "sourceEntryNumber": 33,
      "sourceIconHexagramNumber": 33,
      "hexagramName": "遯",
      "poemText": "東鄰嫁女，為王妃后。莊公築館，以事主母。歸于京師，季姜悅喜。",
      "sourceParagraphSha256": "sha256:b3d89fa04b734bb7eb2fbbd5c3e7077418aad13f00e9356faedcf5e0a6e303f2",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:90f728ae646ea0d5f31dbd0bddba887df2ce0984cf81a7bf5f9914485e88f696"
    },
    {
      "baseHexagramNumber": 37,
      "changedHexagramNumber": 34,
      "sourceEntryNumber": 34,
      "sourceIconHexagramNumber": 34,
      "hexagramName": "大壯",
      "poemText": "六甲無子，以喪其戊。五丁不親，庚失曾孫。癸走出門。",
      "sourceParagraphSha256": "sha256:7bd6412d2ecfa5264145785a7e82a5b21c4d5d6129ceba7719a16a5830e2d713",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ed4e119b82cad67f25e7db28d157e8c9d90358f83f2dce50875c0850b0615c71"
    },
    {
      "baseHexagramNumber": 37,
      "changedHexagramNumber": 35,
      "sourceEntryNumber": 35,
      "sourceIconHexagramNumber": 35,
      "hexagramName": "晉",
      "poemText": "陰霧不清，濁政亂民。孟春季夏，水壞我居。",
      "sourceParagraphSha256": "sha256:805488f19a1f8852fc10fc95f8734550efdd067282e8d8e73bdf9d366d72fbfd",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:8e44f6cac4faab8b6e9d3f40fb1c6ed452b80074d64b7554dba6fa2dbe45b700"
    },
    {
      "baseHexagramNumber": 37,
      "changedHexagramNumber": 36,
      "sourceEntryNumber": 36,
      "sourceIconHexagramNumber": 36,
      "hexagramName": "明夷",
      "poemText": "騎肫逐羊，不見所望。徑涉虎廬，亡身失羊。",
      "sourceParagraphSha256": "sha256:acbf3501234049532bb8c04a35811624867cee071654a2a279b0d5c66e738f5d",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:e5cbe0fd67ae0bcc680428a8e4d362e319e9e0c90eaa097674a69c5f8e667289"
    },
    {
      "baseHexagramNumber": 37,
      "changedHexagramNumber": 38,
      "sourceEntryNumber": 38,
      "sourceIconHexagramNumber": 38,
      "hexagramName": "睽",
      "poemText": "安床厚褥，不得久宿。棄我喜宴，困於南國。投杼之憂，不成禍災。",
      "sourceParagraphSha256": "sha256:abbe00b1f8bebd3859e3f6f8cf0354dda5d1fef868865dfc301a42b61ae57f9b",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:3933c41f1b91344dc756fabc0959b1458c045acaa5c2deb75a87e4d269410f53"
    },
    {
      "baseHexagramNumber": 37,
      "changedHexagramNumber": 39,
      "sourceEntryNumber": 39,
      "sourceIconHexagramNumber": 39,
      "hexagramName": "蹇",
      "poemText": "五日四維，安平不危。利以居止，保有玉女。",
      "sourceParagraphSha256": "sha256:8115c65484ef940d85b166dd8182317f7620c25e87258c24c9b2e7bfdd8c8342",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:914f144e1abf29a0c8fcb959201d31ba8b146c0fc218fb6750a7f9a4607e40d3"
    },
    {
      "baseHexagramNumber": 37,
      "changedHexagramNumber": 40,
      "sourceEntryNumber": 40,
      "sourceIconHexagramNumber": 40,
      "hexagramName": "解",
      "poemText": "西賈巴蜀，寒雪至轂。欲前不得，反復其室。",
      "sourceParagraphSha256": "sha256:4c3412338c9d8e7d4baf9af1a689b1c3863d29a9dc1f4db7ac39a6ba50ee2c86",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:fa6e9ab4872d0a0beb908a3f2c1510480c0d5fc8b1b7905c47fde1f7c54d71a4"
    },
    {
      "baseHexagramNumber": 37,
      "changedHexagramNumber": 41,
      "sourceEntryNumber": 41,
      "sourceIconHexagramNumber": 41,
      "hexagramName": "損",
      "poemText": "剛柔相呼，二姓為家。霜降既同，惠我以仁。",
      "sourceParagraphSha256": "sha256:f72554465ac0ae13066cfc3bb855b1652d1979ab7a2d257d52493e5323424d90",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:d0e7bee824993c1d1d4f602f34c067bf30ead539dcd1e89621392e89cdb579e9"
    },
    {
      "baseHexagramNumber": 37,
      "changedHexagramNumber": 42,
      "sourceEntryNumber": 42,
      "sourceIconHexagramNumber": 42,
      "hexagramName": "益",
      "poemText": "天馬五道，夾大分處。往來上下，相隨哭歌。凶惡如何。",
      "sourceParagraphSha256": "sha256:87ced59d28cea4d3506327b3c1493748db1f77a0d4060944dc4a67ae47139279",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:682b955f435da115146a914346eab75b5f18169f84b3ac448fbcc28fe9f90ac8"
    },
    {
      "baseHexagramNumber": 37,
      "changedHexagramNumber": 43,
      "sourceEntryNumber": 43,
      "sourceIconHexagramNumber": 43,
      "hexagramName": "夬",
      "poemText": "出門懷憂，東上禍丘。與凶相遇，自為災患。",
      "sourceParagraphSha256": "sha256:119821cf3c8f209731edb567182112d0c5dfd12456536bce5e5ae52863cb184e",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:0b7592cfd672505892195e7f812e1a2917ecf8092c9c855379d9d775a013a1e9"
    },
    {
      "baseHexagramNumber": 37,
      "changedHexagramNumber": 44,
      "sourceEntryNumber": 44,
      "sourceIconHexagramNumber": 44,
      "hexagramName": "姤",
      "poemText": "西行求玉，冀得隋璞。反見凶惡，使我驚惑。",
      "sourceParagraphSha256": "sha256:6ed66ce9f20e061e429d5879d9fc8af31fc75eb460901b251c152b2fbd0d9afb",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:98ad25b3346579815f1252d6c910b0414dc586cf03b5a37fc5571e8d8d25e0f9"
    },
    {
      "baseHexagramNumber": 37,
      "changedHexagramNumber": 45,
      "sourceEntryNumber": 45,
      "sourceIconHexagramNumber": 45,
      "hexagramName": "萃",
      "poemText": "出門無至，動作失利。御憂懷禍，使我多悴。",
      "sourceParagraphSha256": "sha256:595fb86b045e1ec347e393ff9e25d275d54c7a5ccdd9ae04329d010d7b2e5b53",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:27c3ee50376a2ec880bc621b9633a86ade7eb5ff02977d5ff2586528d21b705b"
    },
    {
      "baseHexagramNumber": 37,
      "changedHexagramNumber": 46,
      "sourceEntryNumber": 46,
      "sourceIconHexagramNumber": 46,
      "hexagramName": "升",
      "poemText": "高樓無柱，顛僵不久。紂失三仁，身死牧野。",
      "sourceParagraphSha256": "sha256:46e74d361469d352f1ac379a210a781993b293269fc79673ac9fa84fdbb5d964",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:0ee18619d38861c396aca9e2f1397cddfca69836191cc6673a47d204330b0b3e"
    },
    {
      "baseHexagramNumber": 37,
      "changedHexagramNumber": 47,
      "sourceEntryNumber": 47,
      "sourceIconHexagramNumber": 47,
      "hexagramName": "困",
      "poemText": "避禍迯殃，身全不傷。高貴疾顛，華落墜亡。",
      "sourceParagraphSha256": "sha256:3e8b1bf840dc278252992f30c404f415f6b591f8a71b08e16e1343e901fd4839",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:833812a4de498babd52e1bca8099b6f07cf23492d8c67b34e5744b59422eff80"
    },
    {
      "baseHexagramNumber": 37,
      "changedHexagramNumber": 48,
      "sourceEntryNumber": 48,
      "sourceIconHexagramNumber": 48,
      "hexagramName": "井",
      "poemText": "張牙反目，怒齰忿怒。狂馬撓犬，道驚傷軫。",
      "sourceParagraphSha256": "sha256:b1c96fd03ead31d44fed261fbd9bac69feae27d9824f9eb5ef736c1f00216d6f",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:3027cc163c218dee31625b05dd223719d3929c844e51a8a47e7746639d05e5a8"
    },
    {
      "baseHexagramNumber": 37,
      "changedHexagramNumber": 49,
      "sourceEntryNumber": 49,
      "sourceIconHexagramNumber": 49,
      "hexagramName": "革",
      "poemText": "泉涸龍憂，箕子為奴。干叔隕命，殷破其家。",
      "sourceParagraphSha256": "sha256:e1bdb5fae7243a4a1c23374b0903da9ab44beb13cc7511469240bba6eb17b5e2",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:393cdd443c556c4b7c8e4142138924df69fa1a210e74631c466e916a2670dcde"
    },
    {
      "baseHexagramNumber": 37,
      "changedHexagramNumber": 50,
      "sourceEntryNumber": 50,
      "sourceIconHexagramNumber": 50,
      "hexagramName": "鼎",
      "poemText": "向食飲酒，嘉賓會聚。牂羊大豬，君子饒有。",
      "sourceParagraphSha256": "sha256:a74be8ae4be698bed01798e90a1a772c4106632d7b1b076efed692a26eed3956",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:46e6738dd45db8042e98f2f2f09f8941f1a0641007e62b22be11b6fc0e842316"
    },
    {
      "baseHexagramNumber": 37,
      "changedHexagramNumber": 51,
      "sourceEntryNumber": 51,
      "sourceIconHexagramNumber": 51,
      "hexagramName": "震",
      "poemText": "黃牛騂犢，東行折角。冀得百祥，反亡我囊。",
      "sourceParagraphSha256": "sha256:a2ed0bfc3727511957a8b6848adaecb450acc2288fe13983e4f0b9f98b701a12",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:7d60b38098106a791aedbd015667dd29c800645b63b98462e7602cd647823fda"
    },
    {
      "baseHexagramNumber": 37,
      "changedHexagramNumber": 52,
      "sourceEntryNumber": 52,
      "sourceIconHexagramNumber": 52,
      "hexagramName": "艮",
      "poemText": "路多枳棘，步刺我足。不利旅客，為心作毒。",
      "sourceParagraphSha256": "sha256:619a68ddc32afb4e151c1ddeac8a8f8bd9f28ef7db72e92f13740f6b377da4bd",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:dca6d263900f80d6dc089138001f74b63022035639546540ce4616ddc40f4e6c"
    },
    {
      "baseHexagramNumber": 37,
      "changedHexagramNumber": 53,
      "sourceEntryNumber": 53,
      "sourceIconHexagramNumber": 53,
      "hexagramName": "漸",
      "poemText": "執斧破薪，使媒求婦。和合二姓，親御斯酒。召彼鄰里，公姑悅喜。",
      "sourceParagraphSha256": "sha256:1c2b8c29c51ab980d44c455f3265520a5197719272c93cafb52bd383a5779cf0",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:24573f88d49b1b048689741583cd5fa0aa96aa0c0ded4b15ca6f40a3e752a544"
    },
    {
      "baseHexagramNumber": 37,
      "changedHexagramNumber": 54,
      "sourceEntryNumber": 54,
      "sourceIconHexagramNumber": 54,
      "hexagramName": "歸妹",
      "poemText": "駕車出門，順時宜西。福祐我身，安寧無患。",
      "sourceParagraphSha256": "sha256:b5dc0f61da490250b3c406fe5607737eef88221316b7355e56b3192fbdc34858",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:2e25011aa306e4b125fc1433f0618566a8c16135536548de02895fd56eded8e6"
    },
    {
      "baseHexagramNumber": 37,
      "changedHexagramNumber": 55,
      "sourceEntryNumber": 55,
      "sourceIconHexagramNumber": 55,
      "hexagramName": "豐",
      "poemText": "日新東升，魁杓為禍。漢臺為秦，使我久坐。",
      "sourceParagraphSha256": "sha256:ad322c572b9c0cc9d86eb21e6ac72654a50142a1f7c05550af35832b57f696c6",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:0b3ad254d4c97593b07786acea27f6bb7c7a0cff827bb90b370ce02c9f9c15ff"
    },
    {
      "baseHexagramNumber": 37,
      "changedHexagramNumber": 56,
      "sourceEntryNumber": 56,
      "sourceIconHexagramNumber": 56,
      "hexagramName": "旅",
      "poemText": "山陵丘墓，魂空室屋。精光竭盡，長臥無覺",
      "sourceParagraphSha256": "sha256:e4f962016267d7fed398da4174a40e4f214bd0ba34fdd97762cb276fcd561067",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:19c96f6f6ab2f3c2a7397c4b9eb66e8d1ad36bd80dd43128a3c3ea30a6fa47d6"
    },
    {
      "baseHexagramNumber": 37,
      "changedHexagramNumber": 57,
      "sourceEntryNumber": 57,
      "sourceIconHexagramNumber": 57,
      "hexagramName": "巽",
      "poemText": "孩子含餌，為利所悅。探釜把甑，爛其手臂。",
      "sourceParagraphSha256": "sha256:a7dd8173f0fddc4ef990c3f5655ec19ae1e8b8b9cd28b5368ed16aea9c8a91dc",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:fe773e67077ba5266a93677c75489ffd4bc747b43c4175c4b1eb7e783f0850cf"
    },
    {
      "baseHexagramNumber": 37,
      "changedHexagramNumber": 58,
      "sourceEntryNumber": 58,
      "sourceIconHexagramNumber": 58,
      "hexagramName": "兌",
      "poemText": "何村待時，門戶獨悲。蚯蚓冬行，解我無憂。桑蠶不得，女紅無成。",
      "sourceParagraphSha256": "sha256:03cda69617cf189b150b13d5b8f477e7f05601323eb20231de74528df04e7cf9",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:fbe3c0968e4aff3ea9e8817e5d092faf6b2252675debafecbd8b7c8a45ca627d"
    },
    {
      "baseHexagramNumber": 37,
      "changedHexagramNumber": 59,
      "sourceEntryNumber": 59,
      "sourceIconHexagramNumber": 59,
      "hexagramName": "渙",
      "poemText": "解傷驚惶，散我衣裳，君不安邦。",
      "sourceParagraphSha256": "sha256:0da8be3e47ccf3a19d94a4cdcb0859396ab78ee7a0c1a3eb0991ee9ac7df8f15",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:98f442a707496bc71734a9f51c816b14a25a68526b0c4aa7b6536f2fe3b358a6"
    },
    {
      "baseHexagramNumber": 37,
      "changedHexagramNumber": 60,
      "sourceEntryNumber": 60,
      "sourceIconHexagramNumber": 60,
      "hexagramName": "節",
      "poemText": "害政養賊，背主入愆。跛行不安，國為危患。",
      "sourceParagraphSha256": "sha256:9bad6f0782dcb5cb0766106610bf5539436b5ddf7b71856a3610d7cea39c75e8",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:5bb3b31fb282809b832d122b46b6f12b444eeca45c2fd60650e72fc4e238b163"
    },
    {
      "baseHexagramNumber": 37,
      "changedHexagramNumber": 61,
      "sourceEntryNumber": 61,
      "sourceIconHexagramNumber": 61,
      "hexagramName": "中孚",
      "poemText": "禍走患伏，喜為我福。凶惡消亡，災害不作。",
      "sourceParagraphSha256": "sha256:534ba3e279bd16e167355f0db3f942765976c096ac8018f039bf6a3b07d2c6c6",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ee6208ada22e3c9e47c90a89521d182f23d1991e3a249b7c2bd9ef48d143feeb"
    },
    {
      "baseHexagramNumber": 37,
      "changedHexagramNumber": 62,
      "sourceEntryNumber": 62,
      "sourceIconHexagramNumber": 62,
      "hexagramName": "小過",
      "poemText": "老馬為駒，病雞不雛。三雌獨宿，利在山北。",
      "sourceParagraphSha256": "sha256:96f5022c739a61a18da335dc887f362a5c0c52911aa36794cb6f0ed849247c70",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:972f91cf0dd2103451f869139e79b1d93d46bee4cc99fd2467a72ccdf8ecea80"
    },
    {
      "baseHexagramNumber": 37,
      "changedHexagramNumber": 63,
      "sourceEntryNumber": 63,
      "sourceIconHexagramNumber": 63,
      "hexagramName": "既濟",
      "poemText": "播天舞地，嘵亂神所，居樂無咎。",
      "sourceParagraphSha256": "sha256:ea349a3c2d46a42c540924b7738fbc2770a63ca1ab9c3e2ca4ad9db3b53dab47",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:6705a22d3a25ff79bc034e210d29af2fd0a0185edab72c5c538f38dd821e41da"
    },
    {
      "baseHexagramNumber": 37,
      "changedHexagramNumber": 64,
      "sourceEntryNumber": 64,
      "sourceIconHexagramNumber": 64,
      "hexagramName": "未濟",
      "poemText": "異國殊俗，情不相得。金木為仇，酋長擅役。",
      "sourceParagraphSha256": "sha256:0b96fc41ead282f28a2527b1030fa010c521063fb836f585865b4cd3bb408034",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:e40a3f502bca34b14599599eb0c8449523fd0b4ba0a62a1394308ebd1ec80a5d"
    }
  ]
}
