  "attribution": "來源：《焦氏易林》，易學網《焦氏易林［四庫全書版］》（依據版本：《欽定四庫全書》子部術數類），https://www.eee-learning.com/book/giauii 。依來源要求標示出處及原網頁連結；本站僅整理林辭原文，並記錄收錄、標點及文字整理修改。",
  "entryCount": 64,
  "missingTargets": [],
  "entries": [
    {
      "baseHexagramNumber": 48,
      "changedHexagramNumber": 48,
      "sourceEntryNumber": 48,
      "sourceIconHexagramNumber": 48,
      "hexagramName": "井",
      "poemText": "躓跛未起，失利後市，不得鹿子。",
      "sourceParagraphSha256": "sha256:1e12895d747e3061e9c87562007bb65dcc31916b418a37c5f33915afa3488d58",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:e4b0822a32894889c00a2081a8b79fa0c5bd5f5e4adf2c10ac72ea78cc9a4f70"
    },
    {
      "baseHexagramNumber": 48,
      "changedHexagramNumber": 1,
      "sourceEntryNumber": 1,
      "sourceIconHexagramNumber": 1,
      "hexagramName": "乾",
      "poemText": "左輔右弼，金玉滿堂。常盈不亡，富如廒倉。",
      "sourceParagraphSha256": "sha256:20a01c7abc4e846bf5448732666cd43deecab2cb4dc7e3c421c3345fc7b17211",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:5c3ff85839e5a1c6b5cd113eb40743a4f4ad748afad16ae68ea8357efdb4e8ae"
    },
    {
      "baseHexagramNumber": 48,
      "changedHexagramNumber": 2,
      "sourceEntryNumber": 2,
      "sourceIconHexagramNumber": 2,
      "hexagramName": "坤",
      "poemText": "雨師娶婦，黃巖季女。成禮既婚，相呼南上。膏澤下土，年歲大喜。",
      "sourceParagraphSha256": "sha256:fe45f8edbd84285c4b8d6de98c7d0af43612f6bfffacb55885248a9eaacaca01",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:7f178f1b5ead4e324e8bea80e45400c2535b273766ae73763a60574c361dcce1"
    },
    {
      "baseHexagramNumber": 48,
      "changedHexagramNumber": 3,
      "sourceEntryNumber": 3,
      "sourceIconHexagramNumber": 3,
      "hexagramName": "屯",
      "poemText": "螟蟲為賊，害我嘉榖。中留空虛，家無所食。",
      "sourceParagraphSha256": "sha256:5f3c97a0b4067e71610712262e74979d3bfa5d971ac0fe42504a708bc060eee7",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:a2609c2f3f55712e72bde7dd7aca8d8a2151ab711311e23a72c786a7e013bbbd"
    },
    {
      "baseHexagramNumber": 48,
      "changedHexagramNumber": 4,
      "sourceEntryNumber": 4,
      "sourceIconHexagramNumber": 4,
      "hexagramName": "蒙",
      "poemText": "跛躄難步，道不及舍。露宿澤陂，亡其襦褲。",
      "sourceParagraphSha256": "sha256:db7b264b1a0b3e4e8def9972650e27f0085de2ac7f394f5e704e5943215940ee",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:f9ca4c20d3a55be0a4206cf24553976eee69fa790befdcda2397a2098e543ecc"
    },
    {
      "baseHexagramNumber": 48,
      "changedHexagramNumber": 5,
      "sourceEntryNumber": 5,
      "sourceIconHexagramNumber": 5,
      "hexagramName": "需",
      "poemText": "大夫祈父，無地不涉。為吾相土，莫如韓樂。可以居止，長安富有。",
      "sourceParagraphSha256": "sha256:a97f2dace0938c9ee31431ecd6ed687257bf2d35ba35b9298801ce7ebf5f8a93",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:8692c567b7a6a56008c78f781447c43aecf7e684af148790dbe9b3437f6ab698"
    },
    {
      "baseHexagramNumber": 48,
      "changedHexagramNumber": 6,
      "sourceEntryNumber": 6,
      "sourceIconHexagramNumber": 6,
      "hexagramName": "訟",
      "poemText": "少孤無父，長失慈母。悖悖煢煢，莫與為耦。",
      "sourceParagraphSha256": "sha256:7436d47af94daf3c8d1ca4b2fb37dcd490116d84d1882e3c283192e0524b3a23",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:16285f0c567850576569dee8804ead8d025e90547f44c49685315aa147c3cd4c"
    },
    {
      "baseHexagramNumber": 48,
      "changedHexagramNumber": 7,
      "sourceEntryNumber": 7,
      "sourceIconHexagramNumber": 7,
      "hexagramName": "師",
      "poemText": "側弁醉客，長舌作凶。披髮夜行，迷亂相誤。亡失居處。",
      "sourceParagraphSha256": "sha256:2c1ce4ad613f488f63f8de365ac5c061af90ddaad755d89f61a5a1ec1d491745",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:9d88530b542a6cb5602c1f89b223052620444b68db4ed2ff27ac84effa7c1d35"
    },
    {
      "baseHexagramNumber": 48,
      "changedHexagramNumber": 8,
      "sourceEntryNumber": 8,
      "sourceIconHexagramNumber": 8,
      "hexagramName": "比",
      "poemText": "馬驚車破，王墜深津。身絕魂去，離其室廬。貞難無虞。",
      "sourceParagraphSha256": "sha256:312e88e737a649d8ed695c28ef882690976307695cbf60b79b13255b8b57f5d4",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:3d31e06375b423686a8b06a930a1792130e8a3c8600d39c5c4c2097512834a07"
    },
    {
      "baseHexagramNumber": 48,
      "changedHexagramNumber": 9,
      "sourceEntryNumber": 9,
      "sourceIconHexagramNumber": 9,
      "hexagramName": "小畜",
      "poemText": "東行述職，征討不服。侵齊伐陳，御璧為臣。大得意還。",
      "sourceParagraphSha256": "sha256:e004ee5b22b3fdd52a71d45dcc3600597216c0f501e291762e5c04049a8da1a7",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:a97bb4dd16e1092856764e2ef88aeed9697536c831d97e7b04720301b12e9ac6"
    },
    {
      "baseHexagramNumber": 48,
      "changedHexagramNumber": 10,
      "sourceEntryNumber": 10,
      "sourceIconHexagramNumber": 10,
      "hexagramName": "履",
      "poemText": "百足俱行，相輔為強。三聖翼事，王室寵光。",
      "sourceParagraphSha256": "sha256:c2b4f03db1506bab051eaa9507fdf69243cd143df7019eaa848d7ae69a13d6f1",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:4221fcdd64d0e99b6d7af72fc92693523f255bc3f6c2f33822107d65a86a5469"
    },
    {
      "baseHexagramNumber": 48,
      "changedHexagramNumber": 11,
      "sourceEntryNumber": 11,
      "sourceIconHexagramNumber": 11,
      "hexagramName": "泰",
      "poemText": "根本不固，華落葉去，更為孤嫗。",
      "sourceParagraphSha256": "sha256:9f4ea8797df8c221574c4ad0397b9dedbdff2db323e99333a71879b495a8e23c",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:571f3687bc1b5f932f5b529cc4db2001262b6be303e9e5e8e2dbbe9b2108c55d"
    },
    {
      "baseHexagramNumber": 48,
      "changedHexagramNumber": 12,
      "sourceEntryNumber": 12,
      "sourceIconHexagramNumber": 12,
      "hexagramName": "否",
      "poemText": "牧羊稻園，聞虎喧讙。畏懼怵惕，終無禍焉。",
      "sourceParagraphSha256": "sha256:8569c7ccd7e44ae75adb06ac93f2d7ce5c49e19117529bbaeaab62d84b46441b",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:af1d9b116bf952493a7b47607d7c297af270538cc8a4d667fbe23fda6005f5d7"
    },
    {
      "baseHexagramNumber": 48,
      "changedHexagramNumber": 13,
      "sourceEntryNumber": 13,
      "sourceIconHexagramNumber": 13,
      "hexagramName": "同人",
      "poemText": "履位乘勢，靡有絕弊。為隸所圖，與眾庶伍。",
      "sourceParagraphSha256": "sha256:875f21694778280d0bfafe8500a944e3ca67bba603fbf619731c316217bf7f8e",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:eaeb42931f41a85634a5236f1a48c8f1bd1adf333ef0699fc228c1237eb7dc2a"
    },
    {
      "baseHexagramNumber": 48,
      "changedHexagramNumber": 14,
      "sourceEntryNumber": 14,
      "sourceIconHexagramNumber": 14,
      "hexagramName": "大有",
      "poemText": "大輿多塵，小人傷賢。皇甫司徒，使君失家。",
      "sourceParagraphSha256": "sha256:768ac9d56a8e1bb704368f39dc832b1139abf29deef90a36e8752062167c08c6",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:97d2b0bcfe35ca608ac0a9266bd2754be8197622b514b493ee143668efe74857"
    },
    {
      "baseHexagramNumber": 48,
      "changedHexagramNumber": 15,
      "sourceEntryNumber": 15,
      "sourceIconHexagramNumber": 15,
      "hexagramName": "謙",
      "poemText": "安如泰山，福祿屢臻。雖有狼虎，不能危身。",
      "sourceParagraphSha256": "sha256:1db54cfae7ead0ea0733fc6e3b685eb4e94d548eb9d5bd085e539719481e8d34",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:d9bc1bc7c453acfe01f2edef405410e6edab05cb675992154d4da733497137fa"
    },
    {
      "baseHexagramNumber": 48,
      "changedHexagramNumber": 16,
      "sourceEntryNumber": 16,
      "sourceIconHexagramNumber": 16,
      "hexagramName": "豫",
      "poemText": "同氣異門，各別東西。南與凶遇，北傷其孫。",
      "sourceParagraphSha256": "sha256:fe13a430da0d94541089644b6d127f846c4c6ae3553ffb1d6ed85e144be68991",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:0ffdb6b2f6bd37951695fb402806fcf279a4b195c1a0ec642b44a6540707eb22"
    },
    {
      "baseHexagramNumber": 48,
      "changedHexagramNumber": 17,
      "sourceEntryNumber": 17,
      "sourceIconHexagramNumber": 17,
      "hexagramName": "隨",
      "poemText": "蜺見不祥，禍起我鄉。行人畏懼，使命不通。",
      "sourceParagraphSha256": "sha256:fba53139b0887a28c061749daa2a3cbeb1c2d5a938b81726adcfa7d038d31c4b",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:26a8f9b828e35d5595aaeec5435199d819c5af41bcaa68f77cef98421ec0eb23"
    },
    {
      "baseHexagramNumber": 48,
      "changedHexagramNumber": 18,
      "sourceEntryNumber": 18,
      "sourceIconHexagramNumber": 18,
      "hexagramName": "蠱",
      "poemText": "養虎畜狼，還自賊傷。無事招福，自取災殃。",
      "sourceParagraphSha256": "sha256:3757fb3aa20becb3a0cc531cc0cec78c415e50c730e9cbbbeed767ec8d6cef45",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ae0374d9d77f22c78b37a647d4b3d95f7b4d0989be8acd4ea894e5b858f2e43d"
    },
    {
      "baseHexagramNumber": 48,
      "changedHexagramNumber": 19,
      "sourceEntryNumber": 19,
      "sourceIconHexagramNumber": 19,
      "hexagramName": "臨",
      "poemText": "順風吹火，幸附驥尾。易為功力，因權受福。",
      "sourceParagraphSha256": "sha256:269daf7f6e07893798f3f6ef50d84d3d6af98040a1158409ab56aafc702a0f84",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:accce6c9b9b599ae3e0c3205e5e732fe340e82665f100f9d7303ba327491e06e"
    },
    {
      "baseHexagramNumber": 48,
      "changedHexagramNumber": 20,
      "sourceEntryNumber": 20,
      "sourceIconHexagramNumber": 20,
      "hexagramName": "觀",
      "poemText": "五嶽四瀆，沾濡為德。行不失理，民賴恩福。",
      "sourceParagraphSha256": "sha256:fd075ee1174c2b76f2bce9b740f3aa94727a4c2417e758f438326378e55e7e8d",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:06fb3baed84560cf59ee2bc6bb214f04d8557c1476ca05904f3563c12ad60a6f"
    },
    {
      "baseHexagramNumber": 48,
      "changedHexagramNumber": 21,
      "sourceEntryNumber": 21,
      "sourceIconHexagramNumber": 21,
      "hexagramName": "噬嗑",
      "poemText": "延陵聰敏，聽樂太史。雞鳴大國，姜氏受福。",
      "sourceParagraphSha256": "sha256:ee0084d79a5d73f965ed8c34df02706f7532b09921d38b7fd28cf96abda7cafe",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:23be11db91a81c806b16ac319953ecec24d1f8b9027dceda3e14ba56d2c1b090"
    },
    {
      "baseHexagramNumber": 48,
      "changedHexagramNumber": 22,
      "sourceEntryNumber": 22,
      "sourceIconHexagramNumber": 22,
      "hexagramName": "賁",
      "poemText": "神鳥五氣，鳳凰為主。集於王國，使君得所。",
      "sourceParagraphSha256": "sha256:0c96f9c167de9b5106576acd1642570fc7ffab7ba6f3830e69db5c79d3a5d44b",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:003bd5c6570a43e62ff08f4f67a7d364f61e7a481d4185f2c5b685d1edc14ad1"
    },
    {
      "baseHexagramNumber": 48,
      "changedHexagramNumber": 23,
      "sourceEntryNumber": 23,
      "sourceIconHexagramNumber": 23,
      "hexagramName": "剝",
      "poemText": "媒妁無明，雖期不行。齊女長子，亂我紀綱。",
      "sourceParagraphSha256": "sha256:5758c4032fa0642b7146d8daa4ff4fdd12d13dfad967614a47579483f07b22c1",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:836ef69988eb39c06ecbc70ef4b0d9eff4cf494559aa898f066a0ec3b4a4a304"
    },
    {
      "baseHexagramNumber": 48,
      "changedHexagramNumber": 24,
      "sourceEntryNumber": 24,
      "sourceIconHexagramNumber": 24,
      "hexagramName": "復",
      "poemText": "明月作書，大人失居。眾星宵亂，不知所據。",
      "sourceParagraphSha256": "sha256:1e88df8a38313edeff0c7fadc1bd7f98d4965f2eb7af7359f10bf1625c7ae5af",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:0f1273dd68b7d958de561cccd6413143fa44812c73972d0540a14de42936a8ef"
    },
    {
      "baseHexagramNumber": 48,
      "changedHexagramNumber": 25,
      "sourceEntryNumber": 25,
      "sourceIconHexagramNumber": 25,
      "hexagramName": "无妄",
      "poemText": "少康興起，誅澆復祖。微滅復明，宮祀大禹。",
      "sourceParagraphSha256": "sha256:825dd97e1405c01dce6b4b96cd699d457ab9c7a77a496545eb9af1f2eb71ed16",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:a5c3f20c85f5135f3c20877abaaa4aaa9a9b49b74c8a8eee56c992626c8c2e4a"
    },
    {
      "baseHexagramNumber": 48,
      "changedHexagramNumber": 26,
      "sourceEntryNumber": 26,
      "sourceIconHexagramNumber": 26,
      "hexagramName": "大畜",
      "poemText": "千門萬戶，大福所處。黃屋左纛，龍德獨右。",
      "sourceParagraphSha256": "sha256:ef426e1ab6f6f20d9b68893ea13ac0885052eea098647cf0b5b942aefdd57d50",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:31ce9d801049341e9aaca461781f725002cb14e7c846aed25dc9f18b6831f414"
    },
    {
      "baseHexagramNumber": 48,
      "changedHexagramNumber": 27,
      "sourceEntryNumber": 27,
      "sourceIconHexagramNumber": 27,
      "hexagramName": "頤",
      "poemText": "乾作聖男，坤為智女。配合成就，長住樂所。",
      "sourceParagraphSha256": "sha256:80440a0153edefd35bee91cea4bc13812e19445f54527122881d2bc2799fa69b",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:b7569bd07bf7bea062c3c4b2fb60d038b9c886de2e3805ea987f10f7b77988ba"
    },
    {
      "baseHexagramNumber": 48,
      "changedHexagramNumber": 28,
      "sourceEntryNumber": 28,
      "sourceIconHexagramNumber": 28,
      "hexagramName": "大過",
      "poemText": "羿張烏號，彀射驚狼。鐘鼓夜鳴，將軍壯心。趙國雄勇，鬥死滎陽。",
      "sourceParagraphSha256": "sha256:2cbf15879d30acff7bae82f44fcb1ec3f321625085a15d00fae100573b412eab",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:578d5713f4ce488a81666526e572fb9b88974777784b0b149931d70ff35e4be2"
    },
    {
      "baseHexagramNumber": 48,
      "changedHexagramNumber": 29,
      "sourceEntryNumber": 29,
      "sourceIconHexagramNumber": 29,
      "hexagramName": "坎",
      "poemText": "炙魚銅斗，張伺夜鼠。不忍香味，機發為祟。祟在頭頸。筰不得去。",
      "sourceParagraphSha256": "sha256:2803739a56770640a1f8eba526c21c29e88864196eadbf302f761f59104baa70",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:9080dd28c43514bf989283a3963d3400513e4e689a0725be0e8c9804133ef9ea"
    },
    {
      "baseHexagramNumber": 48,
      "changedHexagramNumber": 30,
      "sourceEntryNumber": 30,
      "sourceIconHexagramNumber": 30,
      "hexagramName": "離",
      "poemText": "高飛不視，貪饕所在。臭腐為患，自害其身。（一作竊位貪榮，內污外清。時時暫過，日日禍生。",
      "sourceParagraphSha256": "sha256:053c42f21e91a3e46982893b572202a0ff28ce2a29f05663f24ddddbf00cb6c7",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:2c4cf012a4ea32595fe1219d9581ea4dfd9fc444e851f96f0344a5b69b4c0d18"
    },
    {
      "baseHexagramNumber": 48,
      "changedHexagramNumber": 31,
      "sourceEntryNumber": 31,
      "sourceIconHexagramNumber": 31,
      "hexagramName": "咸",
      "poemText": "鉛刀攻玉，堅不可得。盡我觔力，胝胼為疾。",
      "sourceParagraphSha256": "sha256:30240327b7db85319f0822a5458f7cae7273c3178f6c6e6ce01ab742c19c7e44",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:081c9c114334a016914fb3fa2a53fd08ad9cd5c8d7fdd8945311b3aa89ef011b"
    },
    {
      "baseHexagramNumber": 48,
      "changedHexagramNumber": 32,
      "sourceEntryNumber": 32,
      "sourceIconHexagramNumber": 32,
      "hexagramName": "恒",
      "poemText": "方喙宣口，聖智仁厚。解釋倒懸，歷國安泰。",
      "sourceParagraphSha256": "sha256:ef113ff91a5c23cfefb8b2542e6b7a421e2b06dc2171a05ca1f43e297472db33",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:e0621ca7466939beda562ae9675e37253439493c321f7575e5004c9d3c8176ef"
    },
    {
      "baseHexagramNumber": 48,
      "changedHexagramNumber": 33,
      "sourceEntryNumber": 33,
      "sourceIconHexagramNumber": 33,
      "hexagramName": "遯",
      "poemText": "踟躕南北，誤入喪國。社季利兵，傷我心腹。",
      "sourceParagraphSha256": "sha256:6e055f37b5f732b69047991d8c34ca4b0520cc4b4ee3f6d864749ccb957de103",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:9bf609d5bd3459d338b1f2a318849ea5eb6562f2b366af6c42a0dd63ee355a90"
    },
    {
      "baseHexagramNumber": 48,
      "changedHexagramNumber": 34,
      "sourceEntryNumber": 34,
      "sourceIconHexagramNumber": 34,
      "hexagramName": "大壯",
      "poemText": "公孫之政，惠而不煩。喬子相國，終身無患。",
      "sourceParagraphSha256": "sha256:873fc56348ba19bfe614bbbe5c0c40e8305b2b07bd8cf3a3861533e150d820bb",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:fb45365fdb864d39f3460c6c6648697c986e3d2a08489006c034c4b5b8c5e3a4"
    },
    {
      "baseHexagramNumber": 48,
      "changedHexagramNumber": 35,
      "sourceEntryNumber": 35,
      "sourceIconHexagramNumber": 35,
      "hexagramName": "晉",
      "poemText": "弧矢大張，道絕不通。小人寇賊，君子塞壅。",
      "sourceParagraphSha256": "sha256:f688ab9929fd5cfdf6a37782491568560d7c0103f45f0a772f18593dfb5ce6f2",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:1afa3a4de1f3f70bb658bd8f626404832afeb0f3f4addbeb7cf8a02d04fb5506"
    },
    {
      "baseHexagramNumber": 48,
      "changedHexagramNumber": 36,
      "sourceEntryNumber": 36,
      "sourceIconHexagramNumber": 36,
      "hexagramName": "明夷",
      "poemText": "藏戟之室，封豕受福。充澤肥腯，子孫蕃息。",
      "sourceParagraphSha256": "sha256:67be74a6bd9ea9d65db475b53c492ee57336f6d55fb4c94369a1ee1e53cc6fad",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:2babc6722d8b474f19f40db17e9d7af574be2adeecc96515ded9408140ecd894"
    },
    {
      "baseHexagramNumber": 48,
      "changedHexagramNumber": 37,
      "sourceEntryNumber": 37,
      "sourceIconHexagramNumber": 37,
      "hexagramName": "家人",
      "poemText": "八子同巢，心勞相思，雉苦無憂。",
      "sourceParagraphSha256": "sha256:54c1cdba9858e7d1b8cb739538e3133b712192f67ae148b60dad02a13aa73afc",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:5b235a479f12e623c25d7e5140cf146236c625dadb251a7817f7608c52baa14c"
    },
    {
      "baseHexagramNumber": 48,
      "changedHexagramNumber": 38,
      "sourceEntryNumber": 38,
      "sourceIconHexagramNumber": 38,
      "hexagramName": "睽",
      "poemText": "循理舉手，典求相予。六休相磨，終無殃咎。",
      "sourceParagraphSha256": "sha256:fc8ce1899bf139ea7e3b30a0532d66917b7a9f20f3b5870c4c0896ad44d9e6b7",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:a4239ce7921f49d228eb9636cb6c61e22abbc250c7289d0ca8e09408ce09d0e9"
    },
    {
      "baseHexagramNumber": 48,
      "changedHexagramNumber": 39,
      "sourceEntryNumber": 39,
      "sourceIconHexagramNumber": 39,
      "hexagramName": "蹇",
      "poemText": "公子王孫，把彈攝丸。發輒有獲，室家饒足。",
      "sourceParagraphSha256": "sha256:b7edb39536f3d077da7732e7a177e6a92d0c711cf6df2718165a98b0dbacd7b0",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:6b5b210956168dd3a8422c028f873e672be48ca9fe8a6e9788fb959db0e068fd"
    },
    {
      "baseHexagramNumber": 48,
      "changedHexagramNumber": 40,
      "sourceEntryNumber": 40,
      "sourceIconHexagramNumber": 40,
      "hexagramName": "解",
      "poemText": "井渚有悔，渴蜺為怪。不亟徙鄉，家受其殃。",
      "sourceParagraphSha256": "sha256:6d17ac392f2642a584b92d616fcc898fba53ff37015d0a3569ef4b33917b8869",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:a096015e516f85e1254cc8fbd242530b4e488bcfc1ae7a81226bfd5545d288db"
    },
    {
      "baseHexagramNumber": 48,
      "changedHexagramNumber": 41,
      "sourceEntryNumber": 41,
      "sourceIconHexagramNumber": 41,
      "hexagramName": "損",
      "poemText": "鄭澮有聲，國亂失傾。弘明早見，止樂不能。",
      "sourceParagraphSha256": "sha256:e78b9fa8dc3788ec93dd7325ba8c1676c8a07fe3f5c9605b37bfc7f5b27892ab",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ca809e18866926ddedca9ecada00efd9d0e37866793668016e7c16f33eb741ac"
    },
    {
      "baseHexagramNumber": 48,
      "changedHexagramNumber": 42,
      "sourceEntryNumber": 42,
      "sourceIconHexagramNumber": 42,
      "hexagramName": "益",
      "poemText": "穿室鑿牆，不直生訟。褰衣涉河，雖勢無功。",
      "sourceParagraphSha256": "sha256:7e981c7bb0a9f1df84cee1284877e945f0c708c2814ba41f39c2a6f980db37fd",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:5415a043a8745256ae13c5efd9083218d4abeaac3343569d0d99277aa909b951"
    },
    {
      "baseHexagramNumber": 48,
      "changedHexagramNumber": 43,
      "sourceEntryNumber": 43,
      "sourceIconHexagramNumber": 43,
      "hexagramName": "夬",
      "poemText": "胎卵胞乳，長大成就。君子萬年，動有利得。",
      "sourceParagraphSha256": "sha256:1eef486112bb71d596e47d1c4593b97dbb6f8e7e4c7dd3e1047add715588d131",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:4020068e03b747b0c31427c39ca28e9932c5f17f559bfb16867be33a600cf75b"
    },
    {
      "baseHexagramNumber": 48,
      "changedHexagramNumber": 44,
      "sourceEntryNumber": 44,
      "sourceIconHexagramNumber": 44,
      "hexagramName": "姤",
      "poemText": "五心乖離，各引是非。莫適為主，道路塞壅。",
      "sourceParagraphSha256": "sha256:d9fd4bf12e5db28ceaf70ef66a35521f3661ef2f074104168887d8e8957953ce",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:36f8a39889ce4973b9ad6423bfb9f469a9e3423793a59af53d83c93b52876270"
    },
    {
      "baseHexagramNumber": 48,
      "changedHexagramNumber": 45,
      "sourceEntryNumber": 45,
      "sourceIconHexagramNumber": 45,
      "hexagramName": "萃",
      "poemText": "百柱載梁，千歲不僵。大願輔福，文武以昌。",
      "sourceParagraphSha256": "sha256:d2d7c680c970a54c539845fdfb7df9f5ecb65e3aeaa938d5393f12a057f4dfc6",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:868e62e643d23e163fb95ec9fed0c3838aea379567cc5f5f13e3d95813c5e080"
    },
    {
      "baseHexagramNumber": 48,
      "changedHexagramNumber": 46,
      "sourceEntryNumber": 46,
      "sourceIconHexagramNumber": 46,
      "hexagramName": "升",
      "poemText": "營城洛邑，周公所作。世連三十，年歷七百。福佑豐實，堅固不落。",
      "sourceParagraphSha256": "sha256:e8be204d71ffe4e5cedcae816422099a3ec77c812552e4144599c65cf4f9923a",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:90f662443b61e34cbc573051cb6a5b51d5dd3a5914cb62a2679599c05710e8ff"
    },
    {
      "baseHexagramNumber": 48,
      "changedHexagramNumber": 47,
      "sourceEntryNumber": 47,
      "sourceIconHexagramNumber": 47,
      "hexagramName": "困",
      "poemText": "從叔旅行，食於東昌。嘉伯悅喜，與我芝香。",
      "sourceParagraphSha256": "sha256:c6e0a98d8c63a7b13fe91334168ae0d1d47a1466453e97affc61f35c197070aa",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:54d724da6134f635a3cc8ef72b385528efbf05d757c10982b1973eec6405f492"
    },
    {
      "baseHexagramNumber": 48,
      "changedHexagramNumber": 49,
      "sourceEntryNumber": 49,
      "sourceIconHexagramNumber": 49,
      "hexagramName": "革",
      "poemText": "失耳聾蔽，不曉聲味。委以鼎俎，方始亂憒。",
      "sourceParagraphSha256": "sha256:a51540dd4925e3d97c645d040494bfb1c88d4fa81dd44321bea62445bc63f144",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:e4aa5c5fe18691b13dc916d0007dabc6a3db7c6eb35979e26b3d9e4537030ea8"
    },
    {
      "baseHexagramNumber": 48,
      "changedHexagramNumber": 50,
      "sourceEntryNumber": 50,
      "sourceIconHexagramNumber": 50,
      "hexagramName": "鼎",
      "poemText": "訾娵開門，鶴鳴彈冠。文章進用，舞韶和鸞。三仁翼政，國無災殃。",
      "sourceParagraphSha256": "sha256:d6a44ec81d6bfe7e2575dcad4ae67eb76655865cb946218b54640c77844ef0b1",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:bae817b5d3b5b9bc4e4484777a86b6434b9a16f7ce007fcc20e850f97128b7ba"
    },
    {
      "baseHexagramNumber": 48,
      "changedHexagramNumber": 51,
      "sourceEntryNumber": 51,
      "sourceIconHexagramNumber": 51,
      "hexagramName": "震",
      "poemText": "遊魂六子，百木所起。三男從父，三女從母。至己而足，各得其所。",
      "sourceParagraphSha256": "sha256:06e092e880b65eca308f9990fae8840792ce7fb15ef1cc7c31b2ed38a48adf94",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:8b1d01080813cae2a053a695f5b61af107bf6b89b6f05422f45c738e8016b304"
    },
    {
      "baseHexagramNumber": 48,
      "changedHexagramNumber": 52,
      "sourceEntryNumber": 52,
      "sourceIconHexagramNumber": 52,
      "hexagramName": "艮",
      "poemText": "南山藍蔵，使君媚好。皇女長婦，多孫眾子。",
      "sourceParagraphSha256": "sha256:1e4f7ad4af2967d360a1ceffb067cbb35c519bb33b78cd1aaddede1da0b8f21a",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:92271c2427ef235fb5ddde8e1febff5f94f6178b97e590363b3a4098c9ada3cc"
    },
    {
      "baseHexagramNumber": 48,
      "changedHexagramNumber": 53,
      "sourceEntryNumber": 53,
      "sourceIconHexagramNumber": 53,
      "hexagramName": "漸",
      "poemText": "黃虹之野，賢君所在。榮段為相，國無災殃。",
      "sourceParagraphSha256": "sha256:1a719eb525e162d526b0bcb58fe67a96d3056d12845ea935f45e337befe81c05",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:aad5bde6393991ed4d53c5e69ae9ef9ff92bf2c4828964cdf3d00a671da5819a"
    },
    {
      "baseHexagramNumber": 48,
      "changedHexagramNumber": 54,
      "sourceEntryNumber": 54,
      "sourceIconHexagramNumber": 54,
      "hexagramName": "歸妹",
      "poemText": "穿鑿道路，為君除舍。開闢福門，喜在我鄰。",
      "sourceParagraphSha256": "sha256:8e52a7d6469d12cfa812e9d770f3a6b86368d6c629f65f298aca9f501dfb570b",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:acb8eab82199f05a8c21fc40de9aaa43b3e3694e6ce47b0eefc76a7b9af02673"
    },
    {
      "baseHexagramNumber": 48,
      "changedHexagramNumber": 55,
      "sourceEntryNumber": 55,
      "sourceIconHexagramNumber": 55,
      "hexagramName": "豐",
      "poemText": "商風數起，天下昏晦。旱魃為虐，七凡兵作。",
      "sourceParagraphSha256": "sha256:d98da3f92cd00adc840415e67092e696375c7ee9a393feb1c8251a15c7847d2c",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:7433db188649fc558b5169ba4c003ce4539d016dd801f427b8cbe3927f7c3dd7"
    },
    {
      "baseHexagramNumber": 48,
      "changedHexagramNumber": 56,
      "sourceEntryNumber": 56,
      "sourceIconHexagramNumber": 56,
      "hexagramName": "旅",
      "poemText": "自衛反魯，時不我與。冰炭異室，仁道閉塞。",
      "sourceParagraphSha256": "sha256:52012df8329ca04d282d517f715d7d35d18c263bf4b27eaa8245207c315d3621",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:08f97d2d94e4dba4227200d870b6f409e5d828b065500e0e6cbb8afa6ea2d3bc"
    },
    {
      "baseHexagramNumber": 48,
      "changedHexagramNumber": 57,
      "sourceEntryNumber": 57,
      "sourceIconHexagramNumber": 57,
      "hexagramName": "巽",
      "poemText": "春陽生草，夏長條枝。萬物蕃滋，充實益有。",
      "sourceParagraphSha256": "sha256:0cb15c1579d58c5621731a546db7625efbbe9cf4243550512b1710b40b8e5dea",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:3e0704cfef82ea7d37c75fbfc425d30ae3ec49b51a935a9a2c55c8f6773eaf1f"
    },
    {
      "baseHexagramNumber": 48,
      "changedHexagramNumber": 58,
      "sourceEntryNumber": 58,
      "sourceIconHexagramNumber": 58,
      "hexagramName": "兌",
      "poemText": "大蛇奔走，奔入茂草。驚於長往，畏懼喙口。",
      "sourceParagraphSha256": "sha256:5167e3923873fc22b4e0725942cb77f86716608d30a07642544fb227ae89b75d",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:6334fadebaa55e769cd742937284a5e792e8c46bef8ff6c1a01b4f25ca1fdd63"
    },
    {
      "baseHexagramNumber": 48,
      "changedHexagramNumber": 59,
      "sourceEntryNumber": 59,
      "sourceIconHexagramNumber": 59,
      "hexagramName": "渙",
      "poemText": "明月照夜，使暗為晝。國有仁賢，君尊於故。",
      "sourceParagraphSha256": "sha256:33ce6005ec196d10cd681f96ab825fd3c8a113be5ea35a9f4a43fea30f801232",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:f513f1caeb7bd96b8bf478cd4de0e5d242118812f712f5a7eb22453d530a8365"
    },
    {
      "baseHexagramNumber": 48,
      "changedHexagramNumber": 60,
      "sourceEntryNumber": 60,
      "sourceIconHexagramNumber": 60,
      "hexagramName": "節",
      "poemText": "避地東走，反入虎口。制於爪牙，骨於灰土。",
      "sourceParagraphSha256": "sha256:50dea81bba57eb1bbdf0cfa0745ec41dcccf039b80156ccf912a8cb5fd9fd231",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:0b9cc719366750d88559ed5154694c1e429366e874cb45bf04a12ab06f295eab"
    },
    {
      "baseHexagramNumber": 48,
      "changedHexagramNumber": 61,
      "sourceEntryNumber": 61,
      "sourceIconHexagramNumber": 61,
      "hexagramName": "中孚",
      "poemText": "傾迭不行，弱走善僵。孟縶無良，失其寵光。",
      "sourceParagraphSha256": "sha256:a66d8c207600f7ac64f4dc55cd8bfd08291d5ba5eab7473bc6a0cf52cbee02bc",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:13e68c1d1cfdb82dfe1a6b5050fcedaac6cdf5e6efef4249bb7d37436dc8e964"
    },
    {
      "baseHexagramNumber": 48,
      "changedHexagramNumber": 62,
      "sourceEntryNumber": 62,
      "sourceIconHexagramNumber": 62,
      "hexagramName": "小過",
      "poemText": "十年俱見，黃頭為首。歲尾民安，國樂無咎。",
      "sourceParagraphSha256": "sha256:6526477d8118b13bde19347127d4ff80c68095ed22f8398166a47123cff8c22f",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:9f985e10a09a9c1ced67c9a561eb21940e71e3d32b4f0b557ea70124b0c858eb"
    },
    {
      "baseHexagramNumber": 48,
      "changedHexagramNumber": 63,
      "sourceEntryNumber": 63,
      "sourceIconHexagramNumber": 63,
      "hexagramName": "既濟",
      "poemText": "望風入門，來到我鄰，鋪吾養均。",
      "sourceParagraphSha256": "sha256:8c55a09df0bc63b4d1e03b3e4e747121905c3826f26d78ee3b619e2e7a7565e4",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:a08f6f053ba985cfa77fde5dc9a71be7170fc14e4919b95cdcec020af1d900c0"
    },
    {
      "baseHexagramNumber": 48,
      "changedHexagramNumber": 64,
      "sourceEntryNumber": 64,
      "sourceIconHexagramNumber": 64,
      "hexagramName": "未濟",
      "poemText": "登高連返，視失彌遠。虎口不張，害賊消亡。",
      "sourceParagraphSha256": "sha256:5e716d61fc34a5853b408bb1652f28ed33ee83bc9bbab74448609ea17bd53bfe",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:5af0634265d443e37356a6909a554f7bd80e29ae58bdc3d2c5cca56d7df93b5a"
    }
  ]
}
