  "entryCount": 64,
  "missingTargets": [],
  "entries": [
    {
      "baseHexagramNumber": 40,
      "changedHexagramNumber": 40,
      "sourceEntryNumber": 40,
      "sourceIconHexagramNumber": 40,
      "hexagramName": "解",
      "poemText": "駕言出遊，鳥鬥車前。更相捽滅，兵馬且來。回車亟還，可以無憂。",
      "sourceParagraphSha256": "sha256:06820a5001091701ff0f8287c27ab615b32c53412797bdfc72b8995d6d8b9638",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:8a6839b517c7e20b811092bb929a4eaa672fc865c3ec97205bf29341121345dc"
    },
    {
      "baseHexagramNumber": 40,
      "changedHexagramNumber": 1,
      "sourceEntryNumber": 1,
      "sourceIconHexagramNumber": 1,
      "hexagramName": "乾",
      "poemText": "大都之居，無物不具。抱布貿絲，所求必得。",
      "sourceParagraphSha256": "sha256:6d7f732135f0a387a597858ecc8f671eca53915c8c5779faed47f9f3c3eda3e6",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:8118e3886ff9332a141af69b37e0103e0514a1a7281feb1fcbef52f19c5bcbe1"
    },
    {
      "baseHexagramNumber": 40,
      "changedHexagramNumber": 2,
      "sourceEntryNumber": 2,
      "sourceIconHexagramNumber": 2,
      "hexagramName": "坤",
      "poemText": "膠著木連，不出牢關，家室相安。",
      "sourceParagraphSha256": "sha256:08ee1c6f6c7c7499ca7324a68b1116790176bbadd9baa39ddefeb2d64009e9ed",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ecc13804682a90c705ebf6759f4310e7b4c374b3ab8833347716138423d97022"
    },
    {
      "baseHexagramNumber": 40,
      "changedHexagramNumber": 3,
      "sourceEntryNumber": 3,
      "sourceIconHexagramNumber": 3,
      "hexagramName": "屯",
      "poemText": "孟伯食長，懼其畏王。賴四蒙五，抱福歸房。",
      "sourceParagraphSha256": "sha256:9fe4ef91e8ac35d1d599f5f1669e0b334f42143a0d08db4f69fed429e15e3f7a",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:444202301247c4cf4e38327866b8f02f97c03157ee4fce26726d74540946e6a8"
    },
    {
      "baseHexagramNumber": 40,
      "changedHexagramNumber": 4,
      "sourceEntryNumber": 4,
      "sourceIconHexagramNumber": 4,
      "hexagramName": "蒙",
      "poemText": "朽輿瘦駟，不任銜轡。君子服之，談何容易。",
      "sourceParagraphSha256": "sha256:c7691f5764bf042ed5d2776303aa0c16efed48c2bff0c332c5e0d8898239d8cc",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:a64f4a5b6451ee9f86e509e5b187a655cbc99164680f1faec4a84a85f46cb870"
    },
    {
      "baseHexagramNumber": 40,
      "changedHexagramNumber": 5,
      "sourceEntryNumber": 5,
      "sourceIconHexagramNumber": 5,
      "hexagramName": "需",
      "poemText": "許嫁既婚，利福在身。適惠生桓，為我魯君。",
      "sourceParagraphSha256": "sha256:faf7fd8407b6e5d77e5cade0ed25a8387bf2098baaa9310f175ed9f529064c22",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:2d83399a157c3c65e8c3119a4203e72d9917c23647117b657b31acfbeb1d5eb8"
    },
    {
      "baseHexagramNumber": 40,
      "changedHexagramNumber": 6,
      "sourceEntryNumber": 6,
      "sourceIconHexagramNumber": 6,
      "hexagramName": "訟",
      "poemText": "入門大喜，上堂見母。妻子俱在，兄弟饒有。",
      "sourceParagraphSha256": "sha256:e4635a246093c027cee6cf716611e89288f1ac2f345ef22a289af38a6e836076",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:be5d3a3041bf972e4c6825d64838a21eb48de524e5f8d6911c7cc80bd6b3bb10"
    },
    {
      "baseHexagramNumber": 40,
      "changedHexagramNumber": 7,
      "sourceEntryNumber": 7,
      "sourceIconHexagramNumber": 7,
      "hexagramName": "師",
      "poemText": "推車上山，力不能任。顛蹶蹉跌，傷我中心。",
      "sourceParagraphSha256": "sha256:eacbc95c50fb252a234b4af7d27e0629f713d7c93549dfb4834fa3c310d62cb0",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:763c749f4133019a489ed23cfb65f98d5dd96b65229d51c8b942043db9b3a716"
    },
    {
      "baseHexagramNumber": 40,
      "changedHexagramNumber": 8,
      "sourceEntryNumber": 8,
      "sourceIconHexagramNumber": 8,
      "hexagramName": "比",
      "poemText": "鷹飛退去，不食其雛。禽尚如此，何況人乎。",
      "sourceParagraphSha256": "sha256:97e462e333bd7e528a04809353bc13f69ffbf0fd0fbfba72ae218b72620fd0f8",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:d9c014cd6ce361b7d1c8bf815ea541a94633ebf11565739dbc35d6bec4dc8df9"
    },
    {
      "baseHexagramNumber": 40,
      "changedHexagramNumber": 9,
      "sourceEntryNumber": 9,
      "sourceIconHexagramNumber": 9,
      "hexagramName": "小畜",
      "poemText": "福棄我走，利不可得。幽人利貞，終無怨慝。",
      "sourceParagraphSha256": "sha256:580d9c14390e6a64a91326f49de5318e748d9c72939d4f99d65111ac2ec243a2",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:c161d9133d6269266fa5f7b808f23ba8ea8f4eb0363cb86c4ccd3fab3fa8c791"
    },
    {
      "baseHexagramNumber": 40,
      "changedHexagramNumber": 10,
      "sourceEntryNumber": 10,
      "sourceIconHexagramNumber": 10,
      "hexagramName": "履",
      "poemText": "夫妻反目，不能正室。公云子南，姬言還北。並后匹嫡，二政亂國。",
      "sourceParagraphSha256": "sha256:3e166229e3d8b34164a6582fe7428c7193286d1b0ea9678f7484e7c85f06363b",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:66779cca1bde81eb7ba9bb3248274c61f4fe771d6e04b27846cde8df98a71b78"
    },
    {
      "baseHexagramNumber": 40,
      "changedHexagramNumber": 11,
      "sourceEntryNumber": 11,
      "sourceIconHexagramNumber": 11,
      "hexagramName": "泰",
      "poemText": "陽衰伏匿，陰淫為賊。幸賴王孫，遂至家國。",
      "sourceParagraphSha256": "sha256:cbba7e273e6bd0bef33ec03394bded0e238326ea1eb1c6c296ce35a501f029bd",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:974e6f3a4a3ded1d707648eaeb6afd24ea3d20f99afba684c21949410680a965"
    },
    {
      "baseHexagramNumber": 40,
      "changedHexagramNumber": 12,
      "sourceEntryNumber": 12,
      "sourceIconHexagramNumber": 12,
      "hexagramName": "否",
      "poemText": "入水求玉，不見和璞。終日至暮，勞無所得。",
      "sourceParagraphSha256": "sha256:fee206aa7e9bc8c54f9b1d1cab93b1a08c16c4a49d55fa9b6d5ea919fdff5b1a",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:bdf4e13e7aaf604c09944a6b6af2f811c199c78dc9da3bf060f36e517c6f3cca"
    },
    {
      "baseHexagramNumber": 40,
      "changedHexagramNumber": 13,
      "sourceEntryNumber": 13,
      "sourceIconHexagramNumber": 13,
      "hexagramName": "同人",
      "poemText": "鳴鸞四牡，駕出行狩。合格有獲，獻公飲酒。",
      "sourceParagraphSha256": "sha256:0b60a10173703e10153c448d5c55cc8a0d06b6ec1ac74dcbe7115a29a760b641",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:39c9623b4ff414edc10cb57d0f3b2d59ce038efc23f7ce606d8a0ce1fe118cec"
    },
    {
      "baseHexagramNumber": 40,
      "changedHexagramNumber": 14,
      "sourceEntryNumber": 14,
      "sourceIconHexagramNumber": 14,
      "hexagramName": "大有",
      "poemText": "覆手齊犢，易為功力。正月元日，承平致福。",
      "sourceParagraphSha256": "sha256:c3192fdb6a1445db1fdeda686ecba84ca38394ce13fbfdeeb96ab3ecb64f9b7e",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:eb6627598c7a8cb8352d16ad5500223ae656cacdc5c145e88e324d2dbf38b527"
    },
    {
      "baseHexagramNumber": 40,
      "changedHexagramNumber": 15,
      "sourceEntryNumber": 15,
      "sourceIconHexagramNumber": 15,
      "hexagramName": "謙",
      "poemText": "三火起明，雨滅其光。高位疾顛，驕恣誅傷。",
      "sourceParagraphSha256": "sha256:3b52d73958168e085a3ca15a806ee26d106cb93c18fdd0d895ed33edd199ab77",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:41aa7cabe712a56035bdc438e848ea3a71bd4c4b7d80c4c8878c4c501b5ca09f"
    },
    {
      "baseHexagramNumber": 40,
      "changedHexagramNumber": 16,
      "sourceEntryNumber": 16,
      "sourceIconHexagramNumber": 16,
      "hexagramName": "豫",
      "poemText": "裹糗荷糧，與利相逢。高飛有得，君子獲福。",
      "sourceParagraphSha256": "sha256:b4f6f8f3fc548a235d16520ae3531e7b868314c33ce2115126967bb15d0105e9",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:33cc4c04b0251c7f9f878430dfe22c23a5b2b9ebb5a2cc6afa60e4c6a6783c39"
    },
    {
      "baseHexagramNumber": 40,
      "changedHexagramNumber": 17,
      "sourceEntryNumber": 17,
      "sourceIconHexagramNumber": 17,
      "hexagramName": "隨",
      "poemText": "水土相得，萬物蕃殖。膏澤優渥，君子有得。",
      "sourceParagraphSha256": "sha256:4180abbdc89f34d9b7c49c37d3c9ae003a220c20895144f08810f27bf53c2645",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:71934fa62e82f4ec8bfb9c32685d06ce63faf8bc5d4e7cf8471b8bc69b7a6dab"
    },
    {
      "baseHexagramNumber": 40,
      "changedHexagramNumber": 18,
      "sourceEntryNumber": 18,
      "sourceIconHexagramNumber": 18,
      "hexagramName": "蠱",
      "poemText": "道理和得，人不相賊。君子往之，樂有利福。",
      "sourceParagraphSha256": "sha256:0fe1b17e5d52187856be894fa48b20c3036637069faa2c4625209167f9ead1a2",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:43f3562675e46a189249218de2fed8b446e2650ccd07f9c86b0eddcb95abdbc5"
    },
    {
      "baseHexagramNumber": 40,
      "changedHexagramNumber": 19,
      "sourceEntryNumber": 19,
      "sourceIconHexagramNumber": 19,
      "hexagramName": "臨",
      "poemText": "天孫帝子，與日月處。光榮於世，福祿繁祉。",
      "sourceParagraphSha256": "sha256:61f5012b394120575d2cb0c2c6176b6d215ea59808b119d07c033d8ea4e3c5eb",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:c66325bc2cfd43ea64d271b8fd6a7f4f136908fa055774109fcdeef58207936d"
    },
    {
      "baseHexagramNumber": 40,
      "changedHexagramNumber": 20,
      "sourceEntryNumber": 20,
      "sourceIconHexagramNumber": 20,
      "hexagramName": "觀",
      "poemText": "布衣在位，乘非其器。折足覆餗，毀傷我玉。",
      "sourceParagraphSha256": "sha256:fb72cad8a827e7d9a83d6c7d7005a42032498c9cba1b8488c5be2c42af74db49",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:897b0e28e4731ce978ef854ca3e5a98bac3e9ce8651ac12a96824f3b352413d4"
    },
    {
      "baseHexagramNumber": 40,
      "changedHexagramNumber": 21,
      "sourceEntryNumber": 21,
      "sourceIconHexagramNumber": 21,
      "hexagramName": "噬嗑",
      "poemText": "鷁飛中退，舉事不遂。且守仁德，猶恐失墜。",
      "sourceParagraphSha256": "sha256:797855a74e70d10970f7ad3220e29de7e8c598fbecb5cf27a08aed38d73b1594",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:7125a4af7bc74d1a2d6f1ce1769714c2a16d3fc2519e21ddab1bf841ebda5ca1"
    },
    {
      "baseHexagramNumber": 40,
      "changedHexagramNumber": 22,
      "sourceEntryNumber": 22,
      "sourceIconHexagramNumber": 22,
      "hexagramName": "賁",
      "poemText": "經棗整冠，意盈不厭。桀紂迷惑，讒佞傷賢。使國亂傾。",
      "sourceParagraphSha256": "sha256:9f03754d6b5adc41070a5cb00228622021f23192e60a40a5c8edc64c3be25b04",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:e4fda93c6366511180b6a4f088373dfa84c136c44727a65852521235db2d53f4"
    },
    {
      "baseHexagramNumber": 40,
      "changedHexagramNumber": 23,
      "sourceEntryNumber": 23,
      "sourceIconHexagramNumber": 23,
      "hexagramName": "剝",
      "poemText": "申酉退跌，陰雨前作。柯條花枝，復泥不白。",
      "sourceParagraphSha256": "sha256:edea0526eca07b31250c7caf4739821826f8eefd7c7d0887dcaef9d2d9b006ef",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:d9bbe92f2107099a3fb08f3f9041fc782b709df6757bb0678605630a5accc3a7"
    },
    {
      "baseHexagramNumber": 40,
      "changedHexagramNumber": 24,
      "sourceEntryNumber": 24,
      "sourceIconHexagramNumber": 24,
      "hexagramName": "復",
      "poemText": "平正賤使，至服苦事。",
      "sourceParagraphSha256": "sha256:09de54ac2d0cb02f2b75149b00212df97c95497c7bd755bc219c0ce763cdd72d",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:c420effda07edabc34c9e9bee1cd7ffc47fc11df892390bb608737bab86b9ac2"
    },
    {
      "baseHexagramNumber": 40,
      "changedHexagramNumber": 25,
      "sourceEntryNumber": 25,
      "sourceIconHexagramNumber": 25,
      "hexagramName": "无妄",
      "poemText": "釣魴河湄，水泛無涯。振衣徒歸，上下昏迷。厲公經齊。",
      "sourceParagraphSha256": "sha256:497423662be89314c6325b9b0b29b56ee21223ca130a2ef8a94c81a15ad5ac1a",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:9a48b06dd57454fa79722c2135dfea74918ea0f94be02496ce704fcf9019ac6b"
    },
    {
      "baseHexagramNumber": 40,
      "changedHexagramNumber": 26,
      "sourceEntryNumber": 26,
      "sourceIconHexagramNumber": 26,
      "hexagramName": "大畜",
      "poemText": "胎養萌生，始見兆形。遭逢雷電，摧角折頸。采䖟山頭，終安不傾。",
      "sourceParagraphSha256": "sha256:6d55de10b9a22a88883c4b7b0a53094b629e056977d68488a41a08a295e7b76d",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:e879b38a364fdfb19b492561f05455b89c632601abb3b516e3ca315b927eee38"
    },
    {
      "baseHexagramNumber": 40,
      "changedHexagramNumber": 27,
      "sourceEntryNumber": 27,
      "sourceIconHexagramNumber": 27,
      "hexagramName": "頤",
      "poemText": "陽春枯槁，夏多水潦。雷雹俱擊，傷我禾黍。年歲困苦。",
      "sourceParagraphSha256": "sha256:d62af9ed5ffe0b02b982dd7e0ab67f124ef101b5957d31382e16e2c097454c92",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:a910b112a2be2b0fd4fce0b691c449bcc5e33227ef56d5e4ef15f31e41bd0b10"
    },
    {
      "baseHexagramNumber": 40,
      "changedHexagramNumber": 28,
      "sourceEntryNumber": 28,
      "sourceIconHexagramNumber": 28,
      "hexagramName": "大過",
      "poemText": "三耳六齒，痛疾不已。齲病蠹缺，墮落其宅。",
      "sourceParagraphSha256": "sha256:cd9ebbbf97f010d94e4b0f243cab6217610bad92442b8bfd1d7ff0d23cdf6056",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:d01fd06a081175042c8f390d6cbacd0a77e5050caa6784e55814882bf1ae89ef"
    },
    {
      "baseHexagramNumber": 40,
      "changedHexagramNumber": 29,
      "sourceEntryNumber": 29,
      "sourceIconHexagramNumber": 29,
      "hexagramName": "坎",
      "poemText": "失時無友，嘉偶出走，傫如喪狗。",
      "sourceParagraphSha256": "sha256:46187840739c6b0cad33cdee483e87475aa3b33b83370ef5c8bcbe63180b0b6b",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:f0d9b56d77846ec0c551109bf8909f19880daafeafe11df0c2678bd8ad6f2e95"
    },
    {
      "baseHexagramNumber": 40,
      "changedHexagramNumber": 30,
      "sourceEntryNumber": 30,
      "sourceIconHexagramNumber": 30,
      "hexagramName": "離",
      "poemText": "宜重微民，歲樂年豐。百國無咎，君子安喜。",
      "sourceParagraphSha256": "sha256:43a502f9e8e526d98c200ac2986b31954457d0611e560f140d606ab63a3f7596",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:c75e2b1bc97496ee755c7b2e8bf21ef0598a647ffbbafd12caeeb66e7a7c6a1b"
    },
    {
      "baseHexagramNumber": 40,
      "changedHexagramNumber": 31,
      "sourceEntryNumber": 31,
      "sourceIconHexagramNumber": 31,
      "hexagramName": "咸",
      "poemText": "登几上車，駕駟南遊。合散從橫，燕秦以彊。",
      "sourceParagraphSha256": "sha256:a652f381e2848d35c4df420cb35cac64d290d8fab0db9570e2efe1a9c5c40faf",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:900e5aa2457780e09400c8b90b70c71e9da731d6dda785c83570354d4088f18e"
    },
    {
      "baseHexagramNumber": 40,
      "changedHexagramNumber": 32,
      "sourceEntryNumber": 32,
      "sourceIconHexagramNumber": 32,
      "hexagramName": "恒",
      "poemText": "鳥集茂木，心樂願得。烏鵲食穀，張口受哺。柔順 利貞，感戴慈母。",
      "sourceParagraphSha256": "sha256:a7f7a65086665a5ce45fa2cea4ec58742af1461b9b9b9fc380f0a9174e5a7819",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:c9f036f82fe9528140055136fee6cdedcdefdee41d1569a9749c55c0e462ab89"
    },
    {
      "baseHexagramNumber": 40,
      "changedHexagramNumber": 33,
      "sourceEntryNumber": 33,
      "sourceIconHexagramNumber": 33,
      "hexagramName": "遯",
      "poemText": "啟蟄始生，萬物美榮。福祉未成，市買無贏。",
      "sourceParagraphSha256": "sha256:572dc122a6d3f94357fb278dd2c16b04a4df16231e43be5bd401db1cd51faf1e",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:338bdfa6cc875e54e6fbd721d65f45eaa148c24b024db83443cebc4a368d4058"
    },
    {
      "baseHexagramNumber": 40,
      "changedHexagramNumber": 34,
      "sourceEntryNumber": 34,
      "sourceIconHexagramNumber": 34,
      "hexagramName": "大壯",
      "poemText": "驕鹵火形，造惡作凶。無所能成，還自滅身。",
      "sourceParagraphSha256": "sha256:4be82d8034512c86a3ef4e4912e2a7f738b4372b7a8075fe9b7ce1f49633d8c9",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:861b227b43d5d67f37894665d5505053f60995e7aded5a0c5abd9236303eb9cc"
    },
    {
      "baseHexagramNumber": 40,
      "changedHexagramNumber": 35,
      "sourceEntryNumber": 35,
      "sourceIconHexagramNumber": 35,
      "hexagramName": "晉",
      "poemText": "異國他土，出良駿馬。去如奔䖟，害不能傷。",
      "sourceParagraphSha256": "sha256:20fc8da85df38bb743ac45778310beea5c447d67a7de08d745e771caf7f5a7ef",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ef63679bfbc48c08cd5a36e027c5eb4dc595198b69ef915dc2002ce35476a691"
    },
    {
      "baseHexagramNumber": 40,
      "changedHexagramNumber": 36,
      "sourceEntryNumber": 36,
      "sourceIconHexagramNumber": 36,
      "hexagramName": "明夷",
      "poemText": "恪敬競職，心不作慝。君明臣忠，民賴其福。",
      "sourceParagraphSha256": "sha256:50cbe42c86c895011b45d137bf174af48d2168d3690831549187fd141c1ede20",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:7f89c7585277e428d83eb84cab2fbdf944cf957f045b21c5ae6985f8d927053c"
    },
    {
      "baseHexagramNumber": 40,
      "changedHexagramNumber": 37,
      "sourceEntryNumber": 37,
      "sourceIconHexagramNumber": 37,
      "hexagramName": "家人",
      "poemText": "三女求夫，伺候山隅。不見復關，長思憂歎。",
      "sourceParagraphSha256": "sha256:ce0dcc7e21601d45cf728b58ffd240540c82e794c516fa8cc8c388507bccac1c",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:c0f5a84180a39dab35302b14d9744aa2d3c756a1fc05efb87da5f748fd8ad7f5"
    },
    {
      "baseHexagramNumber": 40,
      "changedHexagramNumber": 38,
      "sourceEntryNumber": 38,
      "sourceIconHexagramNumber": 38,
      "hexagramName": "睽",
      "poemText": "駕福乘喜，東至嘉國。戴慶南行，離家室居。",
      "sourceParagraphSha256": "sha256:92f7dd2e25a30eb3935d372c7979ceb21d16aae97a83d3990eb3078e3f367916",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:d62d5fcd094e4dbaa5b69b7028a92db1c5d02c846f4f7b42f5cffd777faf57ac"
    },
    {
      "baseHexagramNumber": 40,
      "changedHexagramNumber": 39,
      "sourceEntryNumber": 39,
      "sourceIconHexagramNumber": 39,
      "hexagramName": "蹇",
      "poemText": "四姦為殘，齊魯道難。前驅執役，戒守無患。",
      "sourceParagraphSha256": "sha256:271f3bb2e72637ec99e6e04b9cdee1f7f3e7ff65d791a46ca8aa48b90c04768b",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:780e5d7c0753f388942c8912f47dd739650e10327a9cf7bcb4ae7c4f2c4c555d"
    },
    {
      "baseHexagramNumber": 40,
      "changedHexagramNumber": 41,
      "sourceEntryNumber": 41,
      "sourceIconHexagramNumber": 41,
      "hexagramName": "損",
      "poemText": "下憂上煩，蠹政為患，歲饑無年。",
      "sourceParagraphSha256": "sha256:2072d12cda5ec7a48c85eebbe56bc3878ebf19c6a16534b142dddee3d5194bb1",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:166d78014f6ba979c0605cb8f3b8ff840a4b610ee583922110ddd8cd261c9ed3"
    },
    {
      "baseHexagramNumber": 40,
      "changedHexagramNumber": 42,
      "sourceEntryNumber": 42,
      "sourceIconHexagramNumber": 42,
      "hexagramName": "益",
      "poemText": "雞雉失雛，常畏狐狸。黃池要盟，越國以昌。",
      "sourceParagraphSha256": "sha256:c9925e0f957217804d9fd90717c33c6968aae4ffa189c525f565898410a93101",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:bb9bd2f49872c831a1aefac1c1f437a00a7e2a99e68c3a9b16aa583c6a0d75a0"
    },
    {
      "baseHexagramNumber": 40,
      "changedHexagramNumber": 43,
      "sourceEntryNumber": 43,
      "sourceIconHexagramNumber": 43,
      "hexagramName": "夬",
      "poemText": "堅冰黃鳥，常哀悲愁。不見米粒，但觀蓬蒿。數驚 鷙鳥，為我心憂。",
      "sourceParagraphSha256": "sha256:51728baea247192136eff9b78ee98bace4c5a6b91d54a8aa6fef501f6a91087a",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ba0b71816d977a02bd0a7eb2fa1fda4245e58b5e0eedc11d3bd58ec0857f2dd0"
    },
    {
      "baseHexagramNumber": 40,
      "changedHexagramNumber": 44,
      "sourceEntryNumber": 44,
      "sourceIconHexagramNumber": 44,
      "hexagramName": "姤",
      "poemText": "玉銳鐵頤，倉庫空虛。市賈為盈，與我為仇。",
      "sourceParagraphSha256": "sha256:aebebf350c34e5b4444ea0451dcb81d2194a90b7d089fd916b9acee9a891421c",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:9d767d4dcf76fddfa2891431fb18d72d882bb41a5c5c473afaa9be9dd6043a35"
    },
    {
      "baseHexagramNumber": 40,
      "changedHexagramNumber": 45,
      "sourceEntryNumber": 45,
      "sourceIconHexagramNumber": 45,
      "hexagramName": "萃",
      "poemText": "竊名盜位，居非其家。霜隕不實，為陰所賊。三年失室。",
      "sourceParagraphSha256": "sha256:edeee7642bdef2a14a017207709b40b2ce61ef276cb1fe9a26f46b9ffd83c49e",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:f60465f7de2bfd468b6ecc7b5a0722675df9c207e96f8d4bb3708530ffbee654"
    },
    {
      "baseHexagramNumber": 40,
      "changedHexagramNumber": 46,
      "sourceEntryNumber": 46,
      "sourceIconHexagramNumber": 46,
      "hexagramName": "升",
      "poemText": "賊仁傷德，天怒不福。斬刈家社，失其本域。",
      "sourceParagraphSha256": "sha256:7630e64beb2bcbe41d4c78dc3bae4923f96bc87cdd25ffec7fafd3de004d8bfc",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:5fb9c2ceb1137d2f7f0ca757910c0902f3b3b1afc3c5fe94f0d09687040c5512"
    },
    {
      "baseHexagramNumber": 40,
      "changedHexagramNumber": 47,
      "sourceEntryNumber": 47,
      "sourceIconHexagramNumber": 47,
      "hexagramName": "困",
      "poemText": "萬物和生，蟄蠱振起。益爵增福，日受其喜。",
      "sourceParagraphSha256": "sha256:801a9428613040fc96bd8caff4d784353c1df0ed8400b243a8a4e537ccd4eb15",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:b64dd28450affa084ace268634a23d9cdd381bf681adcb84902ff8e2867706f1"
    },
    {
      "baseHexagramNumber": 40,
      "changedHexagramNumber": 48,
      "sourceEntryNumber": 48,
      "sourceIconHexagramNumber": 48,
      "hexagramName": "井",
      "poemText": "和氣所生，物皆不朽。聖賢居位，國無凶咎。",
      "sourceParagraphSha256": "sha256:9eae145dcea944cc6e94f1c2f461eebcfe6fa512b74a759fdc1d66e138ab34e5",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ab12203324f14b028f92e1f63bcbc7ca921bdc66be74402e50e13ba3c692735f"
    },
    {
      "baseHexagramNumber": 40,
      "changedHexagramNumber": 49,
      "sourceEntryNumber": 49,
      "sourceIconHexagramNumber": 49,
      "hexagramName": "革",
      "poemText": "龍游鳳舞，歲樂民喜。",
      "sourceParagraphSha256": "sha256:e0becafaebfc6b1b1a34c49f70eaf33322f8b4f8548762c37db8817c76e9bec3",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:53dda51a14b8827db5a8d3f450e6358302870e48b4b0cdc8ed7d497f72f971b3"
    },
    {
      "baseHexagramNumber": 40,
      "changedHexagramNumber": 50,
      "sourceEntryNumber": 50,
      "sourceIconHexagramNumber": 50,
      "hexagramName": "鼎",
      "poemText": "鼎行窘步，次伯方舍。居安不懼，姬妾何憂。",
      "sourceParagraphSha256": "sha256:1a9d9bea3284a9c4e247d984b6d6cadf28d4e04e1fae90b570c6c785ebac401b",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ebc9def0168e451db0ebf085da1ef08bbf71ae7485ee95bf7e973cb54b9d0c8a"
    },
    {
      "baseHexagramNumber": 40,
      "changedHexagramNumber": 51,
      "sourceEntryNumber": 51,
      "sourceIconHexagramNumber": 51,
      "hexagramName": "震",
      "poemText": "水深難遊，霜寒難涉。商伯失利，旅人稽留。",
      "sourceParagraphSha256": "sha256:546aed16c7723b9eac7a8962186a147ddc3b0df461a33b63e3cb6b6a36ce9cba",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:9d07da25722595d576fc3859b67d1a757c17a8e10763ab41439be1043fd2fc83"
    },
    {
      "baseHexagramNumber": 40,
      "changedHexagramNumber": 52,
      "sourceEntryNumber": 52,
      "sourceIconHexagramNumber": 52,
      "hexagramName": "艮",
      "poemText": "跛踦相隨，日暮牛罷。陵原徙傷，失利亡雌。",
      "sourceParagraphSha256": "sha256:f5712a3331a5be675dd970d07c2b03368850fe408250db0296ec166d9c619f3b",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:510188cc1e2b3b30f52a3843c079db72eae7aabc621cdc0eb7a44ebd23f62a61"
    },
    {
      "baseHexagramNumber": 40,
      "changedHexagramNumber": 53,
      "sourceEntryNumber": 53,
      "sourceIconHexagramNumber": 53,
      "hexagramName": "漸",
      "poemText": "一牛九鎖，更相牽攣。案明如市，不得東西。請讞得報，日中被刑。",
      "sourceParagraphSha256": "sha256:93344478c7b5e380eb83d49176e9c3397cf77e33160413dcaf560ef7ac6cd10e",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:82863c2ea05b9457f68a58ea1fa76cee3f60533ea84c68d16f0ce13e17866670"
    },
    {
      "baseHexagramNumber": 40,
      "changedHexagramNumber": 54,
      "sourceEntryNumber": 54,
      "sourceIconHexagramNumber": 54,
      "hexagramName": "歸妹",
      "poemText": "春桃生花，季女宜家。受福孔多，男為邦君。",
      "sourceParagraphSha256": "sha256:e276ff7e782ca705946a0cc8dbee39e66935d16065c5ad8c97ab6ff6b4b8c4f4",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:176276652ea2912006fb3eeb94380c2e0583241052aefb1c97687760f9a3e112"
    },
    {
      "baseHexagramNumber": 40,
      "changedHexagramNumber": 55,
      "sourceEntryNumber": 55,
      "sourceIconHexagramNumber": 55,
      "hexagramName": "豐",
      "poemText": "雷鼓東行，稼穡凋傷。大夫執政，君贊其明。",
      "sourceParagraphSha256": "sha256:509bf83ee6ed014b73b3f229b642f7cd3d12468d4a21a9b0283b6544e814ce64",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:86c3cf76d53e373632f6ca74eb3ab0c2644c797652c8658563e2455a4fc36cf5"
    },
    {
      "baseHexagramNumber": 40,
      "changedHexagramNumber": 56,
      "sourceEntryNumber": 56,
      "sourceIconHexagramNumber": 56,
      "hexagramName": "旅",
      "poemText": "季世君憂，亂國淫遊。殃禍立至，民無以休。",
      "sourceParagraphSha256": "sha256:5cedcabdac6200efa4ae4ffd09865fdb92945919ecc2537689f6852315142f07",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:110c4ae62b1ecc9942b1205cdd187b44e9639bc71cc790e181189e52ca7c051a"
    },
    {
      "baseHexagramNumber": 40,
      "changedHexagramNumber": 57,
      "sourceEntryNumber": 57,
      "sourceIconHexagramNumber": 57,
      "hexagramName": "巽",
      "poemText": "發輗溫陽，過雨宿房。宜時布和，無所不通。",
      "sourceParagraphSha256": "sha256:3ba4dae4e91b2f3ae56b80eca76cbb9f18579e9256d9719b3622d4987f67f5f0",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:60adaacc6ef957bd3de645eaf4a8147ffb6a768fdcd00ea0b5930537c3cfcb10"
    },
    {
      "baseHexagramNumber": 40,
      "changedHexagramNumber": 58,
      "sourceEntryNumber": 58,
      "sourceIconHexagramNumber": 58,
      "hexagramName": "兌",
      "poemText": "水中大賈，求利十千。商人不至，市空無有。",
      "sourceParagraphSha256": "sha256:98ca6c5bbe238ed7f91d23789e68e8026534c24be58b6e8916230913eb8d98ce",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:1346b25e5013683bdacc7f5b7413673ad46005ff9320bce562a35224fb2e18c1"
    },
    {
      "baseHexagramNumber": 40,
      "changedHexagramNumber": 59,
      "sourceEntryNumber": 59,
      "sourceIconHexagramNumber": 59,
      "hexagramName": "渙",
      "poemText": "春草萌生，萬物敷榮。陰陽和暢，國樂無憂。",
      "sourceParagraphSha256": "sha256:8b3907ed6adcc3e6994b31431fc530e8467d005af872ab273b8ad09287ac2de7",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:42eb849fe0ca9ccadbd5eb04a544315deda24896c72fc5f84f808bff14b87e46"
    },
    {
      "baseHexagramNumber": 40,
      "changedHexagramNumber": 60,
      "sourceEntryNumber": 60,
      "sourceIconHexagramNumber": 60,
      "hexagramName": "節",
      "poemText": "左眇右盲，目視不明。下民多孽，君失其常。",
      "sourceParagraphSha256": "sha256:727907ef2f75510c75658f3204dc575c76d786e7ed5026eb94b9db88de2c2da8",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:4aab099ca69f332e867a0fa8e0bd73304ddfd9c186097853ca69a020823d15bb"
    },
    {
      "baseHexagramNumber": 40,
      "changedHexagramNumber": 61,
      "sourceEntryNumber": 61,
      "sourceIconHexagramNumber": 61,
      "hexagramName": "中孚",
      "poemText": "悅以內安，不利出門。憂禍消除，公孫何尤。",
      "sourceParagraphSha256": "sha256:47d9becb756e9da33e77bbbb541626b6953022628cf45f5aeb126ae0349f40ee",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:bd4467296e5bc865cad05bd172959eea2b15b3f1ee761e4a9b59db0f20505fc7"
    },
    {
      "baseHexagramNumber": 40,
      "changedHexagramNumber": 62,
      "sourceEntryNumber": 62,
      "sourceIconHexagramNumber": 62,
      "hexagramName": "小過",
      "poemText": "冊書之信，言不負語。易我驎驥，君子有德。",
      "sourceParagraphSha256": "sha256:b96edca3a07babebbcfadbff8647b957e5bbc4c8fc0988be580e79fcbf9e2547",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ff6b25b5085a3e01614e020e62ded35c1797ef5c5f5a2d39eac3ed089e31021e"
    },
    {
      "baseHexagramNumber": 40,
      "changedHexagramNumber": 63,
      "sourceEntryNumber": 63,
      "sourceIconHexagramNumber": 63,
      "hexagramName": "既濟",
      "poemText": "上政搖擾，蟲螟並起。害我嘉穀，年歲無稷。",
      "sourceParagraphSha256": "sha256:317a381a0c63eb593fd413c911d236b5b7d419d8a536a3a6168abf2aba3b9651",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:b83000bb716d892d0f17a0e3506dcf77c589800b9208c0738d0c4db154b31a21"
    },
    {
      "baseHexagramNumber": 40,
      "changedHexagramNumber": 64,
      "sourceEntryNumber": 64,
      "sourceIconHexagramNumber": 64,
      "hexagramName": "未濟",
      "poemText": "干旄旌旗，執在載郊。雖有寶玉，無路致之。",
      "sourceParagraphSha256": "sha256:9c3ed58b453b47331ec4b1df1b5587e4bcd72edd05f1414c438e1f61f851ba7f",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:2851dabe2b66dc7350ecaebcfa0a5348700e8c1409e26f1b5a40c71023b4ca6a"
    }
  ]
}
