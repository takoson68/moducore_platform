  "entryCount": 64,
  "missingTargets": [],
  "entries": [
    {
      "baseHexagramNumber": 57,
      "changedHexagramNumber": 57,
      "sourceEntryNumber": 57,
      "sourceIconHexagramNumber": 57,
      "hexagramName": "巽",
      "poemText": "溫山松柏，常茂不落。鸞鳳以芘，得其歡樂。",
      "sourceParagraphSha256": "sha256:83c5b893bd7326e5e7273ad06cd352699dc9f969039f76b3ac2b61417b187883",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ce52ed87afb1088a4363c9e42c4c229dc45048f7fe43298c5c2ec1493306a8a0"
    },
    {
      "baseHexagramNumber": 57,
      "changedHexagramNumber": 1,
      "sourceEntryNumber": 1,
      "sourceIconHexagramNumber": 1,
      "hexagramName": "乾",
      "poemText": "采唐沬鄉，要我桑中。失信不會，憂思鉤帶。",
      "sourceParagraphSha256": "sha256:923e7327e825919ed110ba43dc7f49fa28d1328a4d71b3a20a71b0dc794d987c",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:1490d82e4e6ff938d49afe97c13f2f488d23a1bd4b73b03e956bd78dcce0a490"
    },
    {
      "baseHexagramNumber": 57,
      "changedHexagramNumber": 2,
      "sourceEntryNumber": 2,
      "sourceIconHexagramNumber": 2,
      "hexagramName": "坤",
      "poemText": "有鳥飛來，集于宮樹。鳴聲畏惡，主將出去。",
      "sourceParagraphSha256": "sha256:6edf57091a387cb7e9d6359fbfb68b8e48634e994fa845222eec7945d1c0502b",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:c05eeb849e3e14e64cacee312a4932f71a2c2c3ea4b8406bdf5d3fd1a4d33759"
    },
    {
      "baseHexagramNumber": 57,
      "changedHexagramNumber": 3,
      "sourceEntryNumber": 3,
      "sourceIconHexagramNumber": 3,
      "hexagramName": "屯",
      "poemText": "仁政之德，參參日息。成都就邑，日受厥福。",
      "sourceParagraphSha256": "sha256:d45bc6ce6e14ab8edba71f02381bfd37b3b445b90c12e7bc6e8eb7c9d586d805",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:1f39b7ab0cbb03c840e9e2afed80c6b963d6df762dffe0284abdb36f432a6dcc"
    },
    {
      "baseHexagramNumber": 57,
      "changedHexagramNumber": 4,
      "sourceEntryNumber": 4,
      "sourceIconHexagramNumber": 4,
      "hexagramName": "蒙",
      "poemText": "他山之錯，與璆為仇。夾攻吾城，傷我肌膚。邦家搔擾",
      "sourceParagraphSha256": "sha256:b983c7ce63576c6414ae87149053973aba5f89d04a5884c2adcaf0ade7d6c8dc",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:31516a6a7d4b4b1a9e24c52d9fd5e1a4896e435aa3c293f03616514e22bc1e1d"
    },
    {
      "baseHexagramNumber": 57,
      "changedHexagramNumber": 5,
      "sourceEntryNumber": 5,
      "sourceIconHexagramNumber": 5,
      "hexagramName": "需",
      "poemText": "齎貝贖狸，不聽我辭。繫於虎鬚，牽不得來。",
      "sourceParagraphSha256": "sha256:651e8f88e4dd28815d3940654ce167707a3fd77d64b6c0941a09f6484094d5cd",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:5736044c886365c2eb3863a079c6a9b15ae50937e94ec18f59042eccb8aa90dc"
    },
    {
      "baseHexagramNumber": 57,
      "changedHexagramNumber": 6,
      "sourceEntryNumber": 6,
      "sourceIconHexagramNumber": 6,
      "hexagramName": "訟",
      "poemText": "一簧兩舌，佞言諂語。三奸成虎，曾母投杼。",
      "sourceParagraphSha256": "sha256:edb28daf5d233de2387c249d13e00949ccbbe4bf9a5f116fb29006afd1428e48",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:38d65324ef65fb9ac5c45e5f510ba0508482a6450e7b55f7bb8c18e2ec7b38b8"
    },
    {
      "baseHexagramNumber": 57,
      "changedHexagramNumber": 7,
      "sourceEntryNumber": 7,
      "sourceIconHexagramNumber": 7,
      "hexagramName": "師",
      "poemText": "薄行搔尾，逐雲涂水。污泥為陸，下田宜稷。",
      "sourceParagraphSha256": "sha256:fad2cd125d4778df3cd9e6f59db4e6081a5bab28e795edd4e96534d9c33fbe79",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:57d06699e001436e8b9dee41fddd47876d35f60890f66d50af7999ba292c7052"
    },
    {
      "baseHexagramNumber": 57,
      "changedHexagramNumber": 8,
      "sourceEntryNumber": 8,
      "sourceIconHexagramNumber": 8,
      "hexagramName": "比",
      "poemText": "天門九重，澤內難通。明登到暮，不見神公。",
      "sourceParagraphSha256": "sha256:fee625aa4302161a7773f8b9cde9769ee108365d934e8e861be144faed833ab1",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:fb0a5bba9c1334ee2218955fa42a694a3ad16fc7e29d96f291b2e833e339a87f"
    },
    {
      "baseHexagramNumber": 57,
      "changedHexagramNumber": 9,
      "sourceEntryNumber": 9,
      "sourceIconHexagramNumber": 9,
      "hexagramName": "小畜",
      "poemText": "闇昧不明，耳聾不聰。陷入深淵，滅頂成凶。",
      "sourceParagraphSha256": "sha256:584079738f04f5c198cafa8afd153a1c829e4a2924a8182ecff6566ac7b5713a",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:d4d8f5e52a407a7fe71a959a418da27e01cd66ff6d3603cf0cbb23eccaf91f25"
    },
    {
      "baseHexagramNumber": 57,
      "changedHexagramNumber": 10,
      "sourceEntryNumber": 10,
      "sourceIconHexagramNumber": 10,
      "hexagramName": "履",
      "poemText": "霧露早霜，日暗不明。陰陽孽疾，年穀大傷。",
      "sourceParagraphSha256": "sha256:0ab619e7fe23cbd6b70d588d1c79db91852acc39cf890284b757853c9dd0c3af",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:9f82eba6537a982aeedfcfc0ebe00694c6f6ac56cd4384e7a6ce89ede42b9bfe"
    },
    {
      "baseHexagramNumber": 57,
      "changedHexagramNumber": 11,
      "sourceEntryNumber": 11,
      "sourceIconHexagramNumber": 11,
      "hexagramName": "泰",
      "poemText": "三階土廓，德義明堂。交讓往來，享燕相承。箕伯朝王，錫我元黃。",
      "sourceParagraphSha256": "sha256:e2b6fbf86634a7d4a333a0f90e74e3c9acd5a5b7045c1b89b0a6c535326533bc",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:065081edf375f35f529cc99be87d22b2d3adcce6da60ca7a594a5905184daa78"
    },
    {
      "baseHexagramNumber": 57,
      "changedHexagramNumber": 12,
      "sourceEntryNumber": 12,
      "sourceIconHexagramNumber": 12,
      "hexagramName": "否",
      "poemText": "爭雞失羊，利得不長。陳蔡之患，賴楚以安。",
      "sourceParagraphSha256": "sha256:a060af97aa397b92c0778dda6e9fd36c3fb0c007d59253ae30689638a8b601bd",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:24f4fd21bf25f064573cf26383805f4f8c3664d91f8433d9c11195f0cbfe3f6f"
    },
    {
      "baseHexagramNumber": 57,
      "changedHexagramNumber": 13,
      "sourceEntryNumber": 13,
      "sourceIconHexagramNumber": 13,
      "hexagramName": "同人",
      "poemText": "天旱水涸，枯槁無澤，未有所獲。",
      "sourceParagraphSha256": "sha256:315bd09b9adaaf8888536f5352553642bafbb9bf09be5b93702b9bc1cbe93d4a",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:283f27959b217859dd6617446ca0ad4eba683d96d579ac913a008aaa182a4c55"
    },
    {
      "baseHexagramNumber": 57,
      "changedHexagramNumber": 14,
      "sourceEntryNumber": 14,
      "sourceIconHexagramNumber": 14,
      "hexagramName": "大有",
      "poemText": "陶朱白圭，善賈息貲。公子王孫，富利不貧。",
      "sourceParagraphSha256": "sha256:d8c9139f87483270da5b4d31330aec0386c3532d86339e5b55e43c2e936ca72d",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:8091573b37f64c0097e6857972ecc02a95edbfee5d7a35f7afccc793e581d66f"
    },
    {
      "baseHexagramNumber": 57,
      "changedHexagramNumber": 15,
      "sourceEntryNumber": 15,
      "sourceIconHexagramNumber": 15,
      "hexagramName": "謙",
      "poemText": "龜厭江海，陸行不止。自令枯槁，失其都市。憂悔無咎。",
      "sourceParagraphSha256": "sha256:02e082f044cdb81f46595b3660e3e79043e94859e48a816c74fa982fd2cf099a",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:d7f35e274bec070b7ee8094430ed651632605d46e04a1afd9106614cfba3c71b"
    },
    {
      "baseHexagramNumber": 57,
      "changedHexagramNumber": 16,
      "sourceEntryNumber": 16,
      "sourceIconHexagramNumber": 16,
      "hexagramName": "豫",
      "poemText": "黃鳥採蓄，既嫁不答。念吾父兄，思復邦國。",
      "sourceParagraphSha256": "sha256:27684cba00eb57abe7e5459473c781ad50c95819be7112091be1aed948f1ccd5",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:e9ffc3a5d7eb0297d963c8dc3d98da3a1ec1534ad291167c1221635a5df55c22"
    },
    {
      "baseHexagramNumber": 57,
      "changedHexagramNumber": 17,
      "sourceEntryNumber": 17,
      "sourceIconHexagramNumber": 17,
      "hexagramName": "隨",
      "poemText": "田鼠野雛，意常欲逃。拘制籠檻，不得動搖。夬之謙）",
      "sourceParagraphSha256": "sha256:717e1b63ecb36ae2002ba1debf8e5a03194389827ce2e8c1a10e4f810bf5b6d0",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:b912790b84567ea6b99f441a37033052c92625e402832c63edd91e5fe265ec60"
    },
    {
      "baseHexagramNumber": 57,
      "changedHexagramNumber": 18,
      "sourceEntryNumber": 18,
      "sourceIconHexagramNumber": 18,
      "hexagramName": "蠱",
      "poemText": "平國不君，夏氏作亂。烏號竊發，靈公殞命。",
      "sourceParagraphSha256": "sha256:d1e43a62e1cc753d2857ab1a1edfc5398be085375baf46296b1b591627bb56c2",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:47a6e286b42466d96b667ece877e8dc8b2d97552a52f809cd1a00af8233c4235"
    },
    {
      "baseHexagramNumber": 57,
      "changedHexagramNumber": 19,
      "sourceEntryNumber": 19,
      "sourceIconHexagramNumber": 19,
      "hexagramName": "臨",
      "poemText": "巨蛇大鰌，戰於國郊。上下閉塞，君遁走逃。",
      "sourceParagraphSha256": "sha256:ce3035cd3f8379bfa78e55016377b1894edfa698cde29a36687f10a52b017994",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:468874d199f4a90037562af9b637c58d1ba03b055e427b7a88336be9224d7c53"
    },
    {
      "baseHexagramNumber": 57,
      "changedHexagramNumber": 20,
      "sourceEntryNumber": 20,
      "sourceIconHexagramNumber": 20,
      "hexagramName": "觀",
      "poemText": "讒言亂國，覆是為非。伯奇流離，恭子憂哀。",
      "sourceParagraphSha256": "sha256:4defa3599d0b70bd1e862dd1bfda27a263175ab9b6b95bafe8b01b18993c0213",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:506dca67e9189365c09ee0b5eedd9b5c93e59373f11145d82cfad25c36b742f5"
    },
    {
      "baseHexagramNumber": 57,
      "changedHexagramNumber": 21,
      "sourceEntryNumber": 21,
      "sourceIconHexagramNumber": 21,
      "hexagramName": "噬嗑",
      "poemText": "鬱怏不明，為陰所傷。眾霧集聚，共奪日光。",
      "sourceParagraphSha256": "sha256:4e49224a6895e404f9dd6679cac4bc1f83c5ddfcf82c6443447a2862acf4aaf4",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:e2ebc71cae39cc7a3c5fb1e882651ca37666b95131101797ae23631cb4fd7ebe"
    },
    {
      "baseHexagramNumber": 57,
      "changedHexagramNumber": 22,
      "sourceEntryNumber": 22,
      "sourceIconHexagramNumber": 22,
      "hexagramName": "賁",
      "poemText": "望城抱子，見邑不殆。公孫上堂，大君歡喜。",
      "sourceParagraphSha256": "sha256:e08f5439b30443e31406d23900c53bb205616c77138c34ca6f8a523108252c52",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:23057eaa50376397629131a3b82f532f05cb2281b5c136c94dc83921537e482e"
    },
    {
      "baseHexagramNumber": 57,
      "changedHexagramNumber": 23,
      "sourceEntryNumber": 23,
      "sourceIconHexagramNumber": 23,
      "hexagramName": "剝",
      "poemText": "三虫為蠱，划跡無與。勝母盜泉，君子弗處。",
      "sourceParagraphSha256": "sha256:263763e4951f46157c0a313b4eacf3ff0b584fab23edc5908839a3b6e5c5c16b",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:1c849acf65bba0ff8737a786ddccac0ec056dae45949a9766ab55309346d839b"
    },
    {
      "baseHexagramNumber": 57,
      "changedHexagramNumber": 24,
      "sourceEntryNumber": 24,
      "sourceIconHexagramNumber": 24,
      "hexagramName": "復",
      "poemText": "車馳人趨，卷甲相求。齊魯寇戰，敗於犬丘。",
      "sourceParagraphSha256": "sha256:d62b31932f3dfb5bb3f2dee827041369183f4b21f6ce47a56a8faaaaf44f6470",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:bf5f03c0942ed28e64022e3a1f2b10c77eaca16110ff453f8627399b736b3ffc"
    },
    {
      "baseHexagramNumber": 57,
      "changedHexagramNumber": 25,
      "sourceEntryNumber": 25,
      "sourceIconHexagramNumber": 25,
      "hexagramName": "无妄",
      "poemText": "欲訪子車，善相欺紿。桓叔相迎，不見所期。",
      "sourceParagraphSha256": "sha256:255957e1694ab42269fcda153239e9110da5fc4843d274e2fedcb8442dc2c81b",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:afcf44f0483ceff8086fad8304df0b57a7d2a9d691fd7af0d5132eed7ad46225"
    },
    {
      "baseHexagramNumber": 57,
      "changedHexagramNumber": 26,
      "sourceEntryNumber": 26,
      "sourceIconHexagramNumber": 26,
      "hexagramName": "大畜",
      "poemText": "爭雉失羊，亡其金囊。利得不長，陳蔡之患。賴楚以安。",
      "sourceParagraphSha256": "sha256:de0f87b9b638ad820a8acabae2e5a796479244ee29ba7273a6c6c8a6362788c5",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:d45e508137f360083b4be92eff393fd4cabc155cbd20c001dfae2cdb7e2ff69d"
    },
    {
      "baseHexagramNumber": 57,
      "changedHexagramNumber": 27,
      "sourceEntryNumber": 27,
      "sourceIconHexagramNumber": 27,
      "hexagramName": "頤",
      "poemText": "歲莫花落，陽入陰室。萬物伏匿，利不可得。",
      "sourceParagraphSha256": "sha256:a579604044f60deb030e6f69af8ab2b26db83cce36f78c0ff5390824afed7ef6",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:3ac263a1ed0fa53cc7a458a62fce9eb0bb6c7c9d3d49fc6b4c57092a0fa710d2"
    },
    {
      "baseHexagramNumber": 57,
      "changedHexagramNumber": 28,
      "sourceEntryNumber": 28,
      "sourceIconHexagramNumber": 28,
      "hexagramName": "大過",
      "poemText": "晨風文翰，大舉就溫。過我成邑，羿無所得。",
      "sourceParagraphSha256": "sha256:75806de3d9ccea502d4dc1b3ea84b2890eee45b4f62a7d6cb4ffed800b28eb3d",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:b25c84931fdcc1dc3cebbf38d0095c48876fd5b69dc492958da73a2756f80e0d"
    },
    {
      "baseHexagramNumber": 57,
      "changedHexagramNumber": 29,
      "sourceEntryNumber": 29,
      "sourceIconHexagramNumber": 29,
      "hexagramName": "坎",
      "poemText": "持鵠抱子，見蛇何咎。室家俱在，不失其所。",
      "sourceParagraphSha256": "sha256:bdf1938db546ead3f6a32bd506f419ce38b68ef62d1b548015ccf2c07ecc7a00",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:e18b24206bb2b928789c2144934b4dbaf9bf64aefd22964a26a85fce28ca5d24"
    },
    {
      "baseHexagramNumber": 57,
      "changedHexagramNumber": 30,
      "sourceEntryNumber": 30,
      "sourceIconHexagramNumber": 30,
      "hexagramName": "離",
      "poemText": "隱隱大雷， 霶霈為雨。有女癡狂，驚駭鄰里。",
      "sourceParagraphSha256": "sha256:9660bc2c70c80eade00c981f984dd1199d80a20d7fd490cc9ccad342cbd9309f",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:0c67224d0e2528f46140494d57e4b1357d3f6c97ea3a838a6647d99e872cb1cd"
    },
    {
      "baseHexagramNumber": 57,
      "changedHexagramNumber": 31,
      "sourceEntryNumber": 31,
      "sourceIconHexagramNumber": 31,
      "hexagramName": "咸",
      "poemText": "無足斷跟，居處不安，凶惡為患。",
      "sourceParagraphSha256": "sha256:892686ec488a076af7978ef28726901d3dfe2eff1e9d16171462124fc6bdbc5a",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:dae0ecba137beb46d93abe145e8ead7952b35fa208971280016df404138425bf"
    },
    {
      "baseHexagramNumber": 57,
      "changedHexagramNumber": 32,
      "sourceEntryNumber": 32,
      "sourceIconHexagramNumber": 32,
      "hexagramName": "恒",
      "poemText": "破筐敝筥，棄捐於道，不復為寶。",
      "sourceParagraphSha256": "sha256:6a5f98e7e75cf8186b497b4e805802e79940527f009cefdf21aaf3b06bfa975e",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:e8d8319384fb8e99dcdf6dc6a1affdb9f5ca303e2727b8c5a1cea87933ede4da"
    },
    {
      "baseHexagramNumber": 57,
      "changedHexagramNumber": 33,
      "sourceEntryNumber": 33,
      "sourceIconHexagramNumber": 33,
      "hexagramName": "遯",
      "poemText": "三雞啄粟，十雛從食。飢鳶卒擊，凶其兩叔。",
      "sourceParagraphSha256": "sha256:aff0ad205415784aae255545e52c96a4e491623d73d15a6247b7a2b31ed4bb73",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:7f9c8b51b0b0156812739d3261945df326481b8536e1f3036b1d64031b741f4c"
    },
    {
      "baseHexagramNumber": 57,
      "changedHexagramNumber": 34,
      "sourceEntryNumber": 34,
      "sourceIconHexagramNumber": 34,
      "hexagramName": "大壯",
      "poemText": "乘車七百，以明文德。踐土葵丘，齊晉受福。",
      "sourceParagraphSha256": "sha256:af20489eb0a50fb04d8c3b58b1689e42e843ffdb36f3b3663670c967e24ae271",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:b03b5ede1f6079e6b3b655366639e872d90a2b327f687f6e7e27290fcaf0e11e"
    },
    {
      "baseHexagramNumber": 57,
      "changedHexagramNumber": 35,
      "sourceEntryNumber": 35,
      "sourceIconHexagramNumber": 35,
      "hexagramName": "晉",
      "poemText": "百足俱行，相輔為強。三聖翼事，王室寵光。",
      "sourceParagraphSha256": "sha256:4607e60de2090fae65b293b9312a42f83740c9234a9cc0f89f0c10ad939bd944",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:4221fcdd64d0e99b6d7af72fc92693523f255bc3f6c2f33822107d65a86a5469"
    },
    {
      "baseHexagramNumber": 57,
      "changedHexagramNumber": 36,
      "sourceEntryNumber": 36,
      "sourceIconHexagramNumber": 36,
      "hexagramName": "明夷",
      "poemText": "典策法書，藏在蘭臺。雖遭潰亂，獨不遇災。",
      "sourceParagraphSha256": "sha256:2e0516e3809b487d34a6cff488785413a931b5e9b7d6442fbf5be59cafd83d8e",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:9fdf93132e7dbc529cbef80560cc80d684b5817b62668869079a5f86f038a908"
    },
    {
      "baseHexagramNumber": 57,
      "changedHexagramNumber": 37,
      "sourceEntryNumber": 37,
      "sourceIconHexagramNumber": 37,
      "hexagramName": "家人",
      "poemText": "西誅不服，恃強負力。倍道奔敵，師徒敗覆。",
      "sourceParagraphSha256": "sha256:aa709928762e2c303ed014716e33dceb5d801e728b86434f29e55f550c4271d7",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:e8033cda42bd3d4ab06cf9f2bb5a8a23be4bc0804fef992c017b787e361c4e06"
    },
    {
      "baseHexagramNumber": 57,
      "changedHexagramNumber": 38,
      "sourceEntryNumber": 38,
      "sourceIconHexagramNumber": 38,
      "hexagramName": "睽",
      "poemText": "春陽生草，夏長條肄。萬物蕃滋，充實益有。",
      "sourceParagraphSha256": "sha256:56bae03351788ec57c93180b6781a92147eb4fa984b6d43365b82dfb58da66c7",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:b1dcdc5b65b77c7c8406f7d7a1e8ba0feafafc1f072932273abec7b135659693"
    },
    {
      "baseHexagramNumber": 57,
      "changedHexagramNumber": 39,
      "sourceEntryNumber": 39,
      "sourceIconHexagramNumber": 39,
      "hexagramName": "蹇",
      "poemText": "磝磽禿白，不生黍稷。無以供祭，祗靈代祀。",
      "sourceParagraphSha256": "sha256:d99cc7a59c81d60d6a1bbe0d70e5a9d5e5afb11476bec99f15161645cc293ddf",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:73a0457944139905a8267acbd316800d039d26a305f9ac76b1f9e985b6c09c28"
    },
    {
      "baseHexagramNumber": 57,
      "changedHexagramNumber": 40,
      "sourceEntryNumber": 40,
      "sourceIconHexagramNumber": 40,
      "hexagramName": "解",
      "poemText": "褰衣涉河，澗流浚多。幸賴舟子，濟脫無他。",
      "sourceParagraphSha256": "sha256:9a4b04404fdff160ffe407e2e5f35856bbf9ca3851bd450151307566d7002241",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ec183c45c41858f0bccda80da3d1e88b75612a125fbc9c13affbb8a0f6180d0b"
    },
    {
      "baseHexagramNumber": 57,
      "changedHexagramNumber": 41,
      "sourceEntryNumber": 41,
      "sourceIconHexagramNumber": 41,
      "hexagramName": "損",
      "poemText": "宜行賈市，所求必倍。載喜抱子，與利為友。",
      "sourceParagraphSha256": "sha256:6b27db2400aa1c7f574be418b68c73d5320bd09805e047dfb1361272b84946d4",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ef846a9f555bd243520ba0123ed407808f604808cc95bce436f2f3ad6ca05656"
    },
    {
      "baseHexagramNumber": 57,
      "changedHexagramNumber": 42,
      "sourceEntryNumber": 42,
      "sourceIconHexagramNumber": 42,
      "hexagramName": "益",
      "poemText": "兄征東燕，弟伐遼西。大克勝還，封君河間。",
      "sourceParagraphSha256": "sha256:92e778919daf4ce68cbba9548173f13a66753ca3d824ff3737c6708e11f7ba9b",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:40882343af6d14a524e60720f1301d4475ab36ba2553b381f93ea89f1f683804"
    },
    {
      "baseHexagramNumber": 57,
      "changedHexagramNumber": 43,
      "sourceEntryNumber": 43,
      "sourceIconHexagramNumber": 43,
      "hexagramName": "夬",
      "poemText": "初雖驚惶，後乃無傷。受其福慶，相孝為王。",
      "sourceParagraphSha256": "sha256:5a03906ac301953800c6671870572abbbbbad51ed1786bf6a50ae5c2dd66fe0a",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:25c6050d1b3d5cb560e8c07fee4083b22e772fe93fa80eaf4f6fc3568bb8852e"
    },
    {
      "baseHexagramNumber": 57,
      "changedHexagramNumber": 44,
      "sourceEntryNumber": 44,
      "sourceIconHexagramNumber": 44,
      "hexagramName": "姤",
      "poemText": "隨風乘龍，與利相逢。田獲三倍，商旅有功。憧憧之邑，長安無他。",
      "sourceParagraphSha256": "sha256:197200f2fd2b1bdb9901d3f4bc2727c74ed8183ef4a6a9dfe4dd6eb9a1005967",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:f7b2f84cf38405b0421dfe3cacf5d4961bb86ea40fe9e8156759548af65a3201"
    },
    {
      "baseHexagramNumber": 57,
      "changedHexagramNumber": 45,
      "sourceEntryNumber": 45,
      "sourceIconHexagramNumber": 45,
      "hexagramName": "萃",
      "poemText": "魚擾水濁，寇圍吾邑。城危不安，驚恐狂惑。",
      "sourceParagraphSha256": "sha256:5c5949c009b9d11d0dbefb408ec47552a190f289ba39bb7187608102a03da1ef",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:2ca6de203a4dde5be0141bb5bb7607f8d79bb6e2bf68cdf60a91802addd615c6"
    },
    {
      "baseHexagramNumber": 57,
      "changedHexagramNumber": 46,
      "sourceEntryNumber": 46,
      "sourceIconHexagramNumber": 46,
      "hexagramName": "升",
      "poemText": "雖塞復通，履危不凶。保其明功，以道立宗。",
      "sourceParagraphSha256": "sha256:f980b83e66e8e327a8baa8f42f55561efaa4ae241843dc21a8adbd86cead0205",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:c596841d38b94f19687e7186411967e3f1e62f455cfcb79755613cbe9bce9cee"
    },
    {
      "baseHexagramNumber": 57,
      "changedHexagramNumber": 47,
      "sourceEntryNumber": 47,
      "sourceIconHexagramNumber": 47,
      "hexagramName": "困",
      "poemText": "坤厚地德，庶物蕃植。平康正直，以綏大福。泰之解，賁之履，渙之解，漸之復）",
      "sourceParagraphSha256": "sha256:fbc3e08508ffdb5b36cfc737da170ac5757da42685ac0645db7e1f924195e3dd",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:f0da147d0ebad2e9f130332db94766e8eae1d4ecadec5024f3757b753432fae8"
    },
    {
      "baseHexagramNumber": 57,
      "changedHexagramNumber": 48,
      "sourceEntryNumber": 48,
      "sourceIconHexagramNumber": 48,
      "hexagramName": "井",
      "poemText": "山木暴怒，壞梁折柱。稽難行旅，留連愁苦。",
      "sourceParagraphSha256": "sha256:31ee44a8f379e4df80ea1fc5a3089310ad152ad4cc038dc0d7edc50a01cb25e9",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:875c0d01c2f3842135aa9cdd3358b01c826a58b83a40edb1a8c1043a1713644d"
    },
    {
      "baseHexagramNumber": 57,
      "changedHexagramNumber": 49,
      "sourceEntryNumber": 49,
      "sourceIconHexagramNumber": 49,
      "hexagramName": "革",
      "poemText": "使燕築室，身不庇宿。家無聊賴，織我衣服。",
      "sourceParagraphSha256": "sha256:8d0a05c9c2032fc46d69bb755ff979a66f78f966df1c51dff1bef04ab902c012",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:d044cccd9b63fba7cf41b6483dc1880759becf97c5dec9c6226cb020229b1bf3"
    },
    {
      "baseHexagramNumber": 57,
      "changedHexagramNumber": 50,
      "sourceEntryNumber": 50,
      "sourceIconHexagramNumber": 50,
      "hexagramName": "鼎",
      "poemText": "矢石所射，襄公痢據。吳子巢門，傷病不治。",
      "sourceParagraphSha256": "sha256:6202d4e6fb1321a94eedbfc06b2885871082eeed2c326881d7e9aeb347837a15",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:08ada43a7c407069945cb10d57cdf512c5551da3b2073db4e9e72d64e0abff56"
    },
    {
      "baseHexagramNumber": 57,
      "changedHexagramNumber": 51,
      "sourceEntryNumber": 51,
      "sourceIconHexagramNumber": 51,
      "hexagramName": "震",
      "poemText": "日月運行，一寒一暑。榮寵赫赫，不可得保。顛隕墜墮，更為士伍。",
      "sourceParagraphSha256": "sha256:d4930baccf67979dc75385d94ce95bfa5535bf4daaf0c07eaca23d3fd6811800",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:272c9aed36eff9b2cbcd20364c9bfad8c1d7dac2460cad7989afdab4e6f0a78b"
    },
    {
      "baseHexagramNumber": 57,
      "changedHexagramNumber": 52,
      "sourceEntryNumber": 52,
      "sourceIconHexagramNumber": 52,
      "hexagramName": "艮",
      "poemText": "宮門悲鳴，臣圍其君，不得東西。",
      "sourceParagraphSha256": "sha256:5f7340fdba8d6e99dfa19fd9e91e305a4358f133313f00d215b8b3f6c980b49a",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:2af44858d58f632b5047216cc1f6f8bd9bdcb4e1cc4f6565a712b8e123de0634"
    },
    {
      "baseHexagramNumber": 57,
      "changedHexagramNumber": 53,
      "sourceEntryNumber": 53,
      "sourceIconHexagramNumber": 53,
      "hexagramName": "漸",
      "poemText": "戴盆望天，不見星辰。顧小失大，福逃牆外。",
      "sourceParagraphSha256": "sha256:22b6f25cc70137576c132d3924cb5075156fd40d652e9a0834476f56553b51ae",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:fe8782e845cee3a102df8eda98571f3d64b2765621a57de25fc106fca35b6b1c"
    },
    {
      "baseHexagramNumber": 57,
      "changedHexagramNumber": 54,
      "sourceEntryNumber": 54,
      "sourceIconHexagramNumber": 54,
      "hexagramName": "歸妹",
      "poemText": "天之所明，禍不遇家。反目相逐，終得和美。",
      "sourceParagraphSha256": "sha256:e5ceb36cf737fb0266961856fd4a930294bbcfbe1dc0f1cbd4d5b1d403bff419",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:7deeb6ebf3e340ffecc3ab4e54f19ebc18ad1341e9fd2b51778a415aa39669d0"
    },
    {
      "baseHexagramNumber": 57,
      "changedHexagramNumber": 55,
      "sourceEntryNumber": 55,
      "sourceIconHexagramNumber": 55,
      "hexagramName": "豐",
      "poemText": "天陰霖雨，塗行泥潦。商人休止，市無所有。",
      "sourceParagraphSha256": "sha256:f198adddef5994de26f9664e005c66dcf6bc49033f129b31b4c446134dffba07",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:d92d388b00aa1645534b58d1a416e7556f5f6921b2aa232101e4b742dbdd226d"
    },
    {
      "baseHexagramNumber": 57,
      "changedHexagramNumber": 56,
      "sourceEntryNumber": 56,
      "sourceIconHexagramNumber": 56,
      "hexagramName": "旅",
      "poemText": "善門福喜，增累盛熾。日就有得，宜其家國。",
      "sourceParagraphSha256": "sha256:5bf04a30feb5b18e20ac44f557d7a8c99365ab8462a5240d0853d6d69883dd70",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:2ff52ced995997b943fed0975f5e63a73047f74a8eb77e5fe9f3724c5bf66646"
    },
    {
      "baseHexagramNumber": 57,
      "changedHexagramNumber": 58,
      "sourceEntryNumber": 58,
      "sourceIconHexagramNumber": 58,
      "hexagramName": "兌",
      "poemText": "南山之陽，華葉將將。嘉樂君子，為國寵光。",
      "sourceParagraphSha256": "sha256:57512f977f4e5a9bb28648c9436e0575be560e99dd38f065b2d16de6d3203afc",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:7552cd639da6a91a9a89ab6cd7112c30e0756b8b0b5785435ecb6aa9cfd4c831"
    },
    {
      "baseHexagramNumber": 57,
      "changedHexagramNumber": 59,
      "sourceEntryNumber": 59,
      "sourceIconHexagramNumber": 59,
      "hexagramName": "渙",
      "poemText": "晝龍頭頸，文章未成。甘言美語，詭辭無名。",
      "sourceParagraphSha256": "sha256:1a13d1a2009fd6153b18eb9b451eefe0503023a4e0fea9c88a64ee29f2de311c",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:d3adc55484bddd699a6c9af71e4a09c49017b62cd7fbe55dc13faca6d096661c"
    },
    {
      "baseHexagramNumber": 57,
      "changedHexagramNumber": 60,
      "sourceEntryNumber": 60,
      "sourceIconHexagramNumber": 60,
      "hexagramName": "節",
      "poemText": "嬰兒孩子，未有知識。彼童而角，亂我政事。",
      "sourceParagraphSha256": "sha256:a1145f6b4751ae138dae0fbbb5c961f0474eaaee4425bd60bcae05ab7c1177e3",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:3647edba17df3c57fd05236197e3b107b87cc8fb571f7620fab0bdcbabc3dca5"
    },
    {
      "baseHexagramNumber": 57,
      "changedHexagramNumber": 61,
      "sourceEntryNumber": 61,
      "sourceIconHexagramNumber": 61,
      "hexagramName": "中孚",
      "poemText": "陰作大奸，欲君勿言。鴻鵠利口，發其禍亂。荊季懷憂，張伯被患。",
      "sourceParagraphSha256": "sha256:7e50bfb88195cf913dad12b5b303ee957e71640d70cc1750178e127010f819ad",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:1d8e2bb826b6815820fcbbc04b1fa4c2d14e2a265a08514908e2c869176413cf"
    },
    {
      "baseHexagramNumber": 57,
      "changedHexagramNumber": 62,
      "sourceEntryNumber": 62,
      "sourceIconHexagramNumber": 62,
      "hexagramName": "小過",
      "poemText": "德之流行，利之四鄉。雨師灑道，風伯逐殃。巡狩封禪，以告成功。",
      "sourceParagraphSha256": "sha256:35e76a9d1e6165ce35d024890b6832bba3d46197fd99b74aa0abad9feebf3abd",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:108a5d6ceb18f9f2ec536382a880e797d7a8bec92d6df86d7973dec590701f77"
    },
    {
      "baseHexagramNumber": 57,
      "changedHexagramNumber": 63,
      "sourceEntryNumber": 63,
      "sourceIconHexagramNumber": 63,
      "hexagramName": "既濟",
      "poemText": "禹將為君，裝入崑崙。稍進陽光，登見溫湯。功德昭明。",
      "sourceParagraphSha256": "sha256:6ae906a1c1d17595194b81f4771bcbb52bae0a9fd1bee3e9337767e034a58962",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:61d3b77c18acf9ccea9d95bf25eff1dfb87e73e5c66ec696904f4d063fb083af"
    },
    {
      "baseHexagramNumber": 57,
      "changedHexagramNumber": 64,
      "sourceEntryNumber": 64,
      "sourceIconHexagramNumber": 64,
      "hexagramName": "未濟",
      "poemText": "五岳四瀆，含潤為德。行不失理，民賴恩福。",
      "sourceParagraphSha256": "sha256:8898beca1e7b361dd6f09ce5ebdaeb10e8e2f2e54c16cb4c45eefcf63ae1c8a0",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ee5ba74800d0ead5cae03e6a66b35309e0a552e2c4926a1d2f4bb590e55adb57"
    }
  ]
}
