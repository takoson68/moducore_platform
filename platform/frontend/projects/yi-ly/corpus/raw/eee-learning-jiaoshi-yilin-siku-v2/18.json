  "attribution": "來源：《焦氏易林》，易學網《焦氏易林［四庫全書版］》（依據版本：《欽定四庫全書》子部術數類），https://www.eee-learning.com/book/giauii 。依來源要求標示出處及原網頁連結；本站僅整理林辭原文，並記錄收錄、標點及文字整理修改。",
  "entryCount": 64,
  "missingTargets": [],
  "entries": [
    {
      "baseHexagramNumber": 18,
      "changedHexagramNumber": 18,
      "sourceEntryNumber": 18,
      "sourceIconHexagramNumber": 18,
      "hexagramName": "蠱",
      "poemText": "紡生江淮，一轉為百。周流四浸，無有難惡。",
      "sourceParagraphSha256": "sha256:b5da16b6b0b9feb7d9c35b551513c6e526e11f9beee2e804a370b35036f4d77a",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:040411ec43f0cbb2368e77b5bd43cbdf3e3edf6ef85a8e5d45ffb4d39f8931e0"
    },
    {
      "baseHexagramNumber": 18,
      "changedHexagramNumber": 1,
      "sourceEntryNumber": 1,
      "sourceIconHexagramNumber": 1,
      "hexagramName": "乾",
      "poemText": "首釋與目，載受福慶。我有好爵，與喜相迎。",
      "sourceParagraphSha256": "sha256:1afb5542160fe1b356ae039e1c42089f1d589283028daf2eb3b6e113a74771c1",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:e3ab73d1c6ae063583b8dcbdb91f23b8b9a83c40690c2dd2229305551e760486"
    },
    {
      "baseHexagramNumber": 18,
      "changedHexagramNumber": 2,
      "sourceEntryNumber": 2,
      "sourceIconHexagramNumber": 2,
      "hexagramName": "坤",
      "poemText": "軥軥轠轠，歲暮編敝。寵名棄捐，君襄在位。",
      "sourceParagraphSha256": "sha256:d7208f704066525937904efae7638468e0fd1338cb1ed092a1452942b488dc35",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:daff5c326273a6aac82444e9a1db40e30c0938c2bfa67a9391efc308dc7f6e29"
    },
    {
      "baseHexagramNumber": 18,
      "changedHexagramNumber": 3,
      "sourceEntryNumber": 3,
      "sourceIconHexagramNumber": 3,
      "hexagramName": "屯",
      "poemText": "折箬蔽日，屏遮王目。司馬無良，平子沒傷。",
      "sourceParagraphSha256": "sha256:d497d7d08bbe051406f9631a43cced100f9f6671e8e1151b8e17c853f12acb6b",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:96d5250cf730e51cd79487516eee9a87b05af88595bf06fb5f0f85dd0cc0b628"
    },
    {
      "baseHexagramNumber": 18,
      "changedHexagramNumber": 4,
      "sourceEntryNumber": 4,
      "sourceIconHexagramNumber": 4,
      "hexagramName": "蒙",
      "poemText": "家在海隅，繞旋深流。王孫單行，無妄以趨。固陰沍寒，常冰不溫。凌人惰怠，大雹為害。",
      "sourceParagraphSha256": "sha256:b0826a53f2d0c8bb78b674e1249da74ff708fd9bb8fba04f5b3cce29e27d9e89",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:e250afbbe3a2f68539c01c7663ef98c5cbf23d0037c495501d5f4b0120b62d81"
    },
    {
      "baseHexagramNumber": 18,
      "changedHexagramNumber": 5,
      "sourceEntryNumber": 5,
      "sourceIconHexagramNumber": 5,
      "hexagramName": "需",
      "poemText": "執義秉德，不危不殆。延頸盤桓，安其室垣。屯耗未得，終無大恤。",
      "sourceParagraphSha256": "sha256:63a767661beac3a4e548a0772e402f0356cd2ec63c56e3b9a0f47a3c99857ad0",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:5386039b52bff3120043ec3f82a1f11c7be7bbc891edb7b16e18e65cf525202b"
    },
    {
      "baseHexagramNumber": 18,
      "changedHexagramNumber": 6,
      "sourceEntryNumber": 6,
      "sourceIconHexagramNumber": 6,
      "hexagramName": "訟",
      "poemText": "長舌亂國，大斧破車。陰陽不順，姬姜衰憂。",
      "sourceParagraphSha256": "sha256:2d48b9265515b9c14e6bb39b89f06b2a22c8e8ca63606e90220e50602b6badce",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:45f97c8caeb77f8a9d1c6c61b017068c466d9075ad5b056bbb0ff49b81e22cf4"
    },
    {
      "baseHexagramNumber": 18,
      "changedHexagramNumber": 7,
      "sourceEntryNumber": 7,
      "sourceIconHexagramNumber": 7,
      "hexagramName": "師",
      "poemText": "二人共路，東趨西步。千里之外，不相知處。",
      "sourceParagraphSha256": "sha256:ce58d091145a37cf80750ebd3e604d6d5ba06ae5b81e15f71f20e3d702b214e8",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:3587f2e436af01cc5f114ff4a094014f07104b80439e7246457ad34deb238764"
    },
    {
      "baseHexagramNumber": 18,
      "changedHexagramNumber": 8,
      "sourceEntryNumber": 8,
      "sourceIconHexagramNumber": 8,
      "hexagramName": "比",
      "poemText": "視暗不明，雲蔽日光。不見子都，鄭人心傷。",
      "sourceParagraphSha256": "sha256:fdd061e2faca45374dee4154172e33650aa29cad14dad2f22085bdb168ec538d",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:6d94417375c80b186483e6acd750ff41274da6f97170830bfa1b976a6233e084"
    },
    {
      "baseHexagramNumber": 18,
      "changedHexagramNumber": 9,
      "sourceEntryNumber": 9,
      "sourceIconHexagramNumber": 9,
      "hexagramName": "小畜",
      "poemText": "初憂後喜，與福為市。八佾列陳，飲御嘉友。",
      "sourceParagraphSha256": "sha256:347e6fab2f0ea1e73e2f1351b106161f1b5bd7b06aebc9f3253d78407811112a",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:f08ad1a89e6243e9d36b000da1dd03f99271156215bb65915e6639cbda664850"
    },
    {
      "baseHexagramNumber": 18,
      "changedHexagramNumber": 10,
      "sourceEntryNumber": 10,
      "sourceIconHexagramNumber": 10,
      "hexagramName": "履",
      "poemText": "僮妾獨宿，長女未室，利無所得。",
      "sourceParagraphSha256": "sha256:1f9bf70e741f70d6e9fb8e30f373a98cb80780d56bfcb5218b740fb4d3044c24",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:9c4c99e836d65d4af4c02f12eb3f76dbf936f49584a0fca8077429e17c41352f"
    },
    {
      "baseHexagramNumber": 18,
      "changedHexagramNumber": 11,
      "sourceEntryNumber": 11,
      "sourceIconHexagramNumber": 11,
      "hexagramName": "泰",
      "poemText": "元黃四塞，陰雌伏謀。呼為墻屋，為巫所識。",
      "sourceParagraphSha256": "sha256:39cf3ecb065d35bde365ea14cec7a95a2ed03a03c9877269ec0d0bfaf6ed160b",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:4df22b53d37959ca83f230021ade60ff03ce09bf1e90df99c362ce790ca8807c"
    },
    {
      "baseHexagramNumber": 18,
      "changedHexagramNumber": 12,
      "sourceEntryNumber": 12,
      "sourceIconHexagramNumber": 12,
      "hexagramName": "否",
      "poemText": "中歲摧隤，常恐衰微。老復賴慶，五羖為相。",
      "sourceParagraphSha256": "sha256:3dfa6a14d24686a1dcb38e94d23db278ab9f2eb39ca442d011ef746f448afb2b",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:1149c5546bde75167675ca47e007ef5d4b62b43d49527af0590b7ec548667fde"
    },
    {
      "baseHexagramNumber": 18,
      "changedHexagramNumber": 13,
      "sourceEntryNumber": 13,
      "sourceIconHexagramNumber": 13,
      "hexagramName": "同人",
      "poemText": "伯氏殺牛，行悖天時。亳社夷燒，朝歌丘墟。",
      "sourceParagraphSha256": "sha256:f54a5dddd35bbe828aa6cc63206e4fc7604cc8fdd6cc83dbaef028aa9ac87a23",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:9be80347b9c85193f31d10025f1aba56c380fbebb83feca50c36dca0a3e1fb6f"
    },
    {
      "baseHexagramNumber": 18,
      "changedHexagramNumber": 14,
      "sourceEntryNumber": 14,
      "sourceIconHexagramNumber": 14,
      "hexagramName": "大有",
      "poemText": "日短夜長，祿命不光。早離父兄，免見分張。",
      "sourceParagraphSha256": "sha256:a73ed3937b6a16cda8d8aee4819c6749a7d2f279c008232a45aeb1795e6ffca1",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:4c3df8e823e2ed88adab7234c5af7b574db8a47b99182bdee725e19cd530030f"
    },
    {
      "baseHexagramNumber": 18,
      "changedHexagramNumber": 15,
      "sourceEntryNumber": 15,
      "sourceIconHexagramNumber": 15,
      "hexagramName": "謙",
      "poemText": "采唐沫鄉，徼期桑中。失心不會，憂思忡忡。",
      "sourceParagraphSha256": "sha256:577ccbe051232e2c9f345d60a4955570db4c5252b023694dd9d39a1aae7652b9",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:01d3723317e95f7108e3ad7f8834b93080d47c12fa5535f2ef869a48c9c623ac"
    },
    {
      "baseHexagramNumber": 18,
      "changedHexagramNumber": 16,
      "sourceEntryNumber": 16,
      "sourceIconHexagramNumber": 16,
      "hexagramName": "豫",
      "poemText": "昧視無光，夜不見明。冥抵空牀，季葉逃亡。",
      "sourceParagraphSha256": "sha256:a2c54b12513195e9abcdd4a54d9127d72eca8a9f14cd040cc42af51fce838b06",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:7c66ac288f4953768b3f286aeb3c1fb6110590c898d18724a53785f0f76f7a62"
    },
    {
      "baseHexagramNumber": 18,
      "changedHexagramNumber": 17,
      "sourceEntryNumber": 17,
      "sourceIconHexagramNumber": 17,
      "hexagramName": "隨",
      "poemText": "舉趾振翼，南至嘉國。見我伯姊，與惠相得。",
      "sourceParagraphSha256": "sha256:82ee113790e4caa1cc07a29b3f0aee02149b8b6b5f667b9630dd587502506082",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:5e03761d69ad4541c3336a700a7064de1972a7af93d5c6b7bb61ebebf5b74f34"
    },
    {
      "baseHexagramNumber": 18,
      "changedHexagramNumber": 19,
      "sourceEntryNumber": 19,
      "sourceIconHexagramNumber": 19,
      "hexagramName": "臨",
      "poemText": "則天順時，周流其墟。與樂並居，無有咎憂。",
      "sourceParagraphSha256": "sha256:3d7f2908be92218602c3395ac3c84ab41a10ffc0b68c31816a337950e0190fb5",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:0f1a5b0e5bae73b72e0963475394a96597a911524185cdcf8f2bc24ed0036696"
    },
    {
      "baseHexagramNumber": 18,
      "changedHexagramNumber": 20,
      "sourceEntryNumber": 20,
      "sourceIconHexagramNumber": 20,
      "hexagramName": "觀",
      "poemText": "蠆室蜂戶，螫我手足。不可進取，為我害咎。",
      "sourceParagraphSha256": "sha256:dac65c8eb45232b8553b9ea2af81987a918bb0c9f162963b6e1a672e074886cb",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:31a1039661ed4431437387b681930f2ab62a0f689d79e0b2c0c2abdb0501098d"
    },
    {
      "baseHexagramNumber": 18,
      "changedHexagramNumber": 21,
      "sourceEntryNumber": 21,
      "sourceIconHexagramNumber": 21,
      "hexagramName": "噬嗑",
      "poemText": "公孫駕驪，載遊東齊。延陵悅產，遺季紵衣。",
      "sourceParagraphSha256": "sha256:e0a18efd6d209d58a05656c91be866a3e19088748b26cf12e9a6bab34518851c",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:1c0c0c5d3396116b9be5340298f755e4b3e0a2f3943e0beb1e648115a6a35b7d"
    },
    {
      "baseHexagramNumber": 18,
      "changedHexagramNumber": 22,
      "sourceEntryNumber": 22,
      "sourceIconHexagramNumber": 22,
      "hexagramName": "賁",
      "poemText": "轉作驪山，大失元心。劉季發怒，命滅子嬰。",
      "sourceParagraphSha256": "sha256:fbf38a0931387426c39f6519eececb7539d426323b16644bddceff5f057ee5a5",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:2b4c01ace744e9d415c8b5676527b715904d0cc7c386fd8764345ed5eea0b4f6"
    },
    {
      "baseHexagramNumber": 18,
      "changedHexagramNumber": 23,
      "sourceEntryNumber": 23,
      "sourceIconHexagramNumber": 23,
      "hexagramName": "剝",
      "poemText": "羊腸九縈，相推稍前。止須王孫，乃得上天。",
      "sourceParagraphSha256": "sha256:b21bb7471a3382f0e5f64dc9b77b8c3040deda3711e4f03cfc5e8475568b3ce8",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ad1552deb2be71a03ffd59395411774da1d32959d55078e50f8a28085585ce31"
    },
    {
      "baseHexagramNumber": 18,
      "changedHexagramNumber": 24,
      "sourceEntryNumber": 24,
      "sourceIconHexagramNumber": 24,
      "hexagramName": "復",
      "poemText": "螮蝀充側，佞人傾惑。女謁橫行，正道壅塞。",
      "sourceParagraphSha256": "sha256:9746c1d0afb25eb00fc32f2fd4bd35257592cce0c2abeec33609adbd402fc09c",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:fb7476a9c0cd798bf89616974fad47a0ac77fee9a0b162eb57dd99c0c837c1f2"
    },
    {
      "baseHexagramNumber": 18,
      "changedHexagramNumber": 25,
      "sourceEntryNumber": 25,
      "sourceIconHexagramNumber": 25,
      "hexagramName": "无妄",
      "poemText": "福祿不遂，家多怪祟。麋鹿悲鳴，思其大雄。",
      "sourceParagraphSha256": "sha256:1778a945cad3fa2a5c7200a54dd1048a5f05571423738b4888acd288ff6d9161",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:3cb4dcfac780f1710da2c22acb81170ac2120d16daf47896e767d76b678ddcb6"
    },
    {
      "baseHexagramNumber": 18,
      "changedHexagramNumber": 26,
      "sourceEntryNumber": 26,
      "sourceIconHexagramNumber": 26,
      "hexagramName": "大畜",
      "poemText": "雲雷因積，大雨重疊。久不見日，使我心悒。",
      "sourceParagraphSha256": "sha256:c782a785a24c7d44d364d01e513b46dfa340c4533ac1be986c38ccc0f188ccaf",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ca3d5fce753e2c2fce44f6d4d954425e56c52f57b761d03f90fa81971404c703"
    },
    {
      "baseHexagramNumber": 18,
      "changedHexagramNumber": 27,
      "sourceEntryNumber": 27,
      "sourceIconHexagramNumber": 27,
      "hexagramName": "頤",
      "poemText": "三河俱合，水怒踴躍。壞我王室，民困無食。",
      "sourceParagraphSha256": "sha256:877b68012ce7660d092895bd5fd2ead837927e40d0ebc7912c978968272ecc74",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:bce0f2e26d7306c487259c68744d5ea74ba1b4a34a93d702a2515602d5dae4a6"
    },
    {
      "baseHexagramNumber": 18,
      "changedHexagramNumber": 28,
      "sourceEntryNumber": 28,
      "sourceIconHexagramNumber": 28,
      "hexagramName": "大過",
      "poemText": "旦雨夜行，早遍都城。更相覆傾，終無所成。三頭兩眼，不見其真。",
      "sourceParagraphSha256": "sha256:16a56823cbdc9effec03e4d0ef2f0fcdaa089e38fed3bc95635649614aefdfec",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:4b84226e6ff8328d933a011c51884f41f91c998f0d0fe0d7f567487a57e28066"
    },
    {
      "baseHexagramNumber": 18,
      "changedHexagramNumber": 29,
      "sourceEntryNumber": 29,
      "sourceIconHexagramNumber": 29,
      "hexagramName": "坎",
      "poemText": "褒后生蛇，經老育微。側跌哀公，酒減黃離。",
      "sourceParagraphSha256": "sha256:1d085226410f67298e80cbae1fca52f0bfca9760bd070857e3cb13d0573b6804",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:f7f6194b57324fbd97a80ef257eb7c645c0ffea7c184e20941310cdbc2c40163"
    },
    {
      "baseHexagramNumber": 18,
      "changedHexagramNumber": 30,
      "sourceEntryNumber": 30,
      "sourceIconHexagramNumber": 30,
      "hexagramName": "離",
      "poemText": "鴻雁南飛，隨陽休息。轉送天和，千里不哀。",
      "sourceParagraphSha256": "sha256:0afe73023a1c2f8c61b2bd4943c8d421853a41885377412a14f242ca6222b765",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:bbca7c9b8deea4c5782a723219585db1e77069eee83a87853e42d03f22677628"
    },
    {
      "baseHexagramNumber": 18,
      "changedHexagramNumber": 31,
      "sourceEntryNumber": 31,
      "sourceIconHexagramNumber": 31,
      "hexagramName": "咸",
      "poemText": "後時失利，不得所欲。",
      "sourceParagraphSha256": "sha256:e3ad6a35a465fa5e3978e77f1fc678152c462c3af73be770ab2c5ec3912e8c57",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:44834b6d9dad90221489bf79cf111c7e24bc60e4d63caa6a5f9e31c1f865601d"
    },
    {
      "baseHexagramNumber": 18,
      "changedHexagramNumber": 32,
      "sourceEntryNumber": 32,
      "sourceIconHexagramNumber": 32,
      "hexagramName": "恒",
      "poemText": "心多恨悔，出言為怪。梟鳴室北，聲醜可惡。請謁不得。",
      "sourceParagraphSha256": "sha256:903556f7653b0276f5b0baef80bdd794783bd35b93479434de386c5d9dc82fa4",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:490ab3f9f62f6048c7032d7939954d7c87d508ddca1c0dace27fcaf0ac0cb9da"
    },
    {
      "baseHexagramNumber": 18,
      "changedHexagramNumber": 33,
      "sourceEntryNumber": 33,
      "sourceIconHexagramNumber": 33,
      "hexagramName": "遯",
      "poemText": "四馬過隙，時難再得。尼父孔聖，繫而不食。",
      "sourceParagraphSha256": "sha256:d757f0a21fd2f3ea17f837dbb6e7e3b074bd1633002c1cb7b46788037aca655c",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:36a3b431e86be6afb04f07d5606718f58b5f0a68f29e37837c09060b9aa01ddd"
    },
    {
      "baseHexagramNumber": 18,
      "changedHexagramNumber": 34,
      "sourceEntryNumber": 34,
      "sourceIconHexagramNumber": 34,
      "hexagramName": "大壯",
      "poemText": "陰變為陽，女化為男。治道得通，君臣相承。",
      "sourceParagraphSha256": "sha256:6267f111d246020816e1a9e3aa83654883404ce72a0f2a47ef578b22777bd883",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:d871286f96cffb87cfbc1422016237123437b5c54dc6cd43c4dafbb914141b8a"
    },
    {
      "baseHexagramNumber": 18,
      "changedHexagramNumber": 35,
      "sourceEntryNumber": 35,
      "sourceIconHexagramNumber": 35,
      "hexagramName": "晉",
      "poemText": "崑崙源口，流行不止。鯀伊砥柱，民不安處。母歸扶子，黃塵悅喜。",
      "sourceParagraphSha256": "sha256:cc951f473d57ddfb4e47a44f86e5d2ec0831b0b8501ab0bb01b570c758019a2a",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:d7131eff19b4d1b2ced845838e5db17f4fde32a25b5e3ed317226f4b82f71bf8"
    },
    {
      "baseHexagramNumber": 18,
      "changedHexagramNumber": 36,
      "sourceEntryNumber": 36,
      "sourceIconHexagramNumber": 36,
      "hexagramName": "明夷",
      "poemText": "葛藟蒙棘，華不得實。讒佞亂政，使恩壅塞。",
      "sourceParagraphSha256": "sha256:b27e0b0a9d7ff67b6c1a49c22b91724383a0d3adea957c2740847880f237548a",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:1d7c30d8feff922b2e8b27d8e83730436c3cd5649f57c5daa3a62f5187f3ff20"
    },
    {
      "baseHexagramNumber": 18,
      "changedHexagramNumber": 37,
      "sourceEntryNumber": 37,
      "sourceIconHexagramNumber": 37,
      "hexagramName": "家人",
      "poemText": "公無長詢，天王駁馬。非其所當，傷折為患。",
      "sourceParagraphSha256": "sha256:87162246531cad8954fc2b0c2c39eb8f3adc11afc32eaffc4b3e9b18407b5d26",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:cecf5466189c687f351899964200a3407aa75fb3367b6ef1f1c577e8157c7b66"
    },
    {
      "baseHexagramNumber": 18,
      "changedHexagramNumber": 38,
      "sourceEntryNumber": 38,
      "sourceIconHexagramNumber": 38,
      "hexagramName": "睽",
      "poemText": "太倉充盈，萬物蕃成，年歲熟榮。",
      "sourceParagraphSha256": "sha256:f138f9b57dff84d28ce3fd5efbbfa35bd26d29bad6efae5c1c8538d4d0e302ee",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:6eabb4aab6ba8095ce04a57209c59e5ceccb16922f0080e255b03a023edfe5e4"
    },
    {
      "baseHexagramNumber": 18,
      "changedHexagramNumber": 39,
      "sourceEntryNumber": 39,
      "sourceIconHexagramNumber": 39,
      "hexagramName": "蹇",
      "poemText": "執簧炤犧，為風所吹。火滅無光，不見玄黃。",
      "sourceParagraphSha256": "sha256:2a69dd9c779b4417aeb25836a91bd60236fa959c4b522083f9cb32c3a4133777",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:f6d27c686ef50e7ad84c554e83b402f80d798d49cd53c3c844597f2e1f5dd396"
    },
    {
      "baseHexagramNumber": 18,
      "changedHexagramNumber": 40,
      "sourceEntryNumber": 40,
      "sourceIconHexagramNumber": 40,
      "hexagramName": "解",
      "poemText": "鳥反故巢，歸其室家。心平意正，與叔相鳴。登高殞墜，失其寵貴。",
      "sourceParagraphSha256": "sha256:6b256bd7d217ff19db69feadeaa55b4c82bbccb11c588a863e1d755facd07e1a",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:1254bab3ff117417179d4cf440d13530cae707b705bda3efa60e5696ed98954d"
    },
    {
      "baseHexagramNumber": 18,
      "changedHexagramNumber": 41,
      "sourceEntryNumber": 41,
      "sourceIconHexagramNumber": 41,
      "hexagramName": "損",
      "poemText": "弩弛弓藏，良犬不烹。內無怨女，征夫在堂。",
      "sourceParagraphSha256": "sha256:513dfe87463d7500defae1b05e73f4bcb6dc57de56c0d724c4f9740c4d7823ef",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ca762e6517aa1dffc785ca085ba2079ebf4d29f5f4bf228280b32a9999c8f1a8"
    },
    {
      "baseHexagramNumber": 18,
      "changedHexagramNumber": 42,
      "sourceEntryNumber": 42,
      "sourceIconHexagramNumber": 42,
      "hexagramName": "益",
      "poemText": "牡犧孔博，日新其德。文君出獵，姜氏受福。",
      "sourceParagraphSha256": "sha256:783d0556f9852a167de77d12af85e3b097de96fc679e5caa3e8c2727dbd563f0",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:79a0268f3c87e37442e76f8736822a44b9268ec28b38846e36e9a528f1103584"
    },
    {
      "baseHexagramNumber": 18,
      "changedHexagramNumber": 43,
      "sourceEntryNumber": 43,
      "sourceIconHexagramNumber": 43,
      "hexagramName": "夬",
      "poemText": "秋季冬孟，寒露霜降。大陰在庭，庶物不生。雞鳴犬吠，家憂數驚。",
      "sourceParagraphSha256": "sha256:ec686de288d3864c94499cb46897401c1dc69e22dbaf0c433a6c9113dd9e102c",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:805531fcc39e8de9f10f070d3f6d4ac6aa52469e49ceb22b8bd446406099ed63"
    },
    {
      "baseHexagramNumber": 18,
      "changedHexagramNumber": 44,
      "sourceEntryNumber": 44,
      "sourceIconHexagramNumber": 44,
      "hexagramName": "姤",
      "poemText": "心多恨悔，出門見怪。反蛇三足，醜聲可惡。嫫母為媒，請求不得。",
      "sourceParagraphSha256": "sha256:4065b076990a344bae535f11fc71eef25a894450a5ed84c8116c86186cbb765b",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:703436c7c35fd23c19aedcf9f7ec29fb3795062c7caadf1cae2e63bc34f17469"
    },
    {
      "baseHexagramNumber": 18,
      "changedHexagramNumber": 45,
      "sourceEntryNumber": 45,
      "sourceIconHexagramNumber": 45,
      "hexagramName": "萃",
      "poemText": "虎豹爭強，道閉不通。小人懽訟，貪天之功。",
      "sourceParagraphSha256": "sha256:1b820f9d71cc5cbc43d56f537406e6ca8c9c1550403438a7c4e8cac48c7db987",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:2394876f30bd0e97a201f311a5fc178e1af81bee896b1e8f38b4057f11ac8725"
    },
    {
      "baseHexagramNumber": 18,
      "changedHexagramNumber": 46,
      "sourceEntryNumber": 46,
      "sourceIconHexagramNumber": 46,
      "hexagramName": "升",
      "poemText": "雞方啄粟，為狐所逐。走不得食，惶怖惕息。",
      "sourceParagraphSha256": "sha256:f17154e37a659650c0880ca79b882ebf7eba8077603df116a503b0e283d53c6e",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:9788ea7a8c5b7a407f49b4383accd164386e7510b9753a630a388455ca665818"
    },
    {
      "baseHexagramNumber": 18,
      "changedHexagramNumber": 47,
      "sourceEntryNumber": 47,
      "sourceIconHexagramNumber": 47,
      "hexagramName": "困",
      "poemText": "陳媯敬仲，兆興齊姜。乃適營丘，八世大昌。",
      "sourceParagraphSha256": "sha256:28d54557a1b01d9c1edd61715606db2422535706317a4b515275fe618258d84a",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:5845f1c1170e79ab653d40cc5cbd70d6c52ac4c2b12d17298a14462a2c09be58"
    },
    {
      "baseHexagramNumber": 18,
      "changedHexagramNumber": 48,
      "sourceEntryNumber": 48,
      "sourceIconHexagramNumber": 48,
      "hexagramName": "井",
      "poemText": "昊天白日，照臨我國。萬民康寧，咸賴嘉福。",
      "sourceParagraphSha256": "sha256:702bee0352981106dc8bc010dec96c92e5ac96c3012e6f604cb4257aff52dbb6",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:7ade7c484f0d7d7b0e71e9d1bdaa8781eea833614e56509ba5d4e2c5fdabfd27"
    },
    {
      "baseHexagramNumber": 18,
      "changedHexagramNumber": 49,
      "sourceEntryNumber": 49,
      "sourceIconHexagramNumber": 49,
      "hexagramName": "革",
      "poemText": "雲夢大藪，索有所在。虞人共職，驪駒樂喜。",
      "sourceParagraphSha256": "sha256:27b25a29690824e94b4fbd6acb5f82e929e6481bf14565acf9c2b512f65dbd54",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ea13c984ce86d9537cb699434726e27f81234175e43bb2909fad3db2780e9954"
    },
    {
      "baseHexagramNumber": 18,
      "changedHexagramNumber": 50,
      "sourceEntryNumber": 50,
      "sourceIconHexagramNumber": 50,
      "hexagramName": "鼎",
      "poemText": "獐鹿雉兔，群聚東國。蘆黃白脊，俱往追逐。九齚十得，主君有喜。",
      "sourceParagraphSha256": "sha256:42790daa46decec4490fd74afe5c0b3f0d7dc0a0a06e3bc9d6d1514310847d7e",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:6160fe44abf66af2bd7611c8a933c88dbd49c8a445dd15d8e0a7666f0122b9b0"
    },
    {
      "baseHexagramNumber": 18,
      "changedHexagramNumber": 51,
      "sourceEntryNumber": 51,
      "sourceIconHexagramNumber": 51,
      "hexagramName": "震",
      "poemText": "德惠孔明，主君復章，保其室堂。",
      "sourceParagraphSha256": "sha256:0001586b9964fca416509ecd9e2dc11f07a5f48581dcbc8c9c09db4134c9b65e",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:5c275de683c6162bc19d31ab167dd8a18aad0e9f19d4d625b9d8873804de9585"
    },
    {
      "baseHexagramNumber": 18,
      "changedHexagramNumber": 52,
      "sourceEntryNumber": 52,
      "sourceIconHexagramNumber": 52,
      "hexagramName": "艮",
      "poemText": "天之所壞，不可強支。眾口嘈嘈，雖貴必危。",
      "sourceParagraphSha256": "sha256:37370b99750ed899068e43b605e8041a23c3044d59a661d315175bcbf50c1840",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:62ef60fad23b804544d4c4271b4d014d679986d7fb2c2c9ea2f1c0f34a60a25f"
    },
    {
      "baseHexagramNumber": 18,
      "changedHexagramNumber": 53,
      "sourceEntryNumber": 53,
      "sourceIconHexagramNumber": 53,
      "hexagramName": "漸",
      "poemText": "天之奧隅，堯舜所居。可以全身，保我邦家。",
      "sourceParagraphSha256": "sha256:8d6aff1ed50a3fd08d6473d7cc00fe38aa67185314ad57918ab39531ce4f28a3",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:a04ef6b82467b83d4438355d813194eceb30ea0a8964d30accf548f54ffc9542"
    },
    {
      "baseHexagramNumber": 18,
      "changedHexagramNumber": 54,
      "sourceEntryNumber": 54,
      "sourceIconHexagramNumber": 54,
      "hexagramName": "歸妹",
      "poemText": "下泉苞稂，十年九王。邭伯遇時，憂念周京。",
      "sourceParagraphSha256": "sha256:e98cee1ca3264246d56955caaf1fc7f13b749777dddab9b8b6b65314c46493cf",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:39cdd2a528cba3a687d5ac708a481769d0e4f816aa2cf5473de592833cb91c56"
    },
    {
      "baseHexagramNumber": 18,
      "changedHexagramNumber": 55,
      "sourceEntryNumber": 55,
      "sourceIconHexagramNumber": 55,
      "hexagramName": "豐",
      "poemText": "江淮海隅，眾利聚居。可以遨遊，卒歲無憂。",
      "sourceParagraphSha256": "sha256:a42e41e322c02ee5ce637d2f33dc02dbcc8ea89610978b61cf3916e3b860a738",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:f8bbba960a2771493a061f9e2aea67fcfd0e2ee1be4b9b1839d160361a3ef166"
    },
    {
      "baseHexagramNumber": 18,
      "changedHexagramNumber": 56,
      "sourceEntryNumber": 56,
      "sourceIconHexagramNumber": 56,
      "hexagramName": "旅",
      "poemText": "南山黃竹，三身六目。出入制命，東皇宣政。主尊君安，鄭國無患。",
      "sourceParagraphSha256": "sha256:94aefa4c505a6199c8417e47178f46d0760cfd01b03a644081f8aae632450cef",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:0d368ba81ec5ee9d412e6b5f8e056a160f957b2474aa869a4807c4178dc316a5"
    },
    {
      "baseHexagramNumber": 18,
      "changedHexagramNumber": 57,
      "sourceEntryNumber": 57,
      "sourceIconHexagramNumber": 57,
      "hexagramName": "巽",
      "poemText": "重譯置之，來除我憂，喜樂俱居。",
      "sourceParagraphSha256": "sha256:87c91bab4b9acf955f970a3497e8a675e51115626a49850079b811d58752bbc9",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:68b5f0196d55d70c89f0bd3f90666c7c468c1fea32ab112407e4f0520be7a21f"
    },
    {
      "baseHexagramNumber": 18,
      "changedHexagramNumber": 58,
      "sourceEntryNumber": 58,
      "sourceIconHexagramNumber": 58,
      "hexagramName": "兌",
      "poemText": "南山高岡，麟鳳室堂。含和履中，國無災殃。",
      "sourceParagraphSha256": "sha256:2b3ced44be3ad1913f55d422bb2d2477df9f84e88870f6b9c2506c2cc00254bd",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:56e7b3a14304dc033ac66526dbf67bcb1bcdc366078b7a5071165f8dce7196ad"
    },
    {
      "baseHexagramNumber": 18,
      "changedHexagramNumber": 59,
      "sourceEntryNumber": 59,
      "sourceIconHexagramNumber": 59,
      "hexagramName": "渙",
      "poemText": "紫芝朱草，生長和氣。公尸侑食，福祿來下。",
      "sourceParagraphSha256": "sha256:2625f00d9949475868a1e8d5b7c9f17b0425f42d9e40bb58c97ce6ea8ad29720",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:daa4946746abd57e2fe2e105394f12f1b808294301063c3618d67b56fcf34e55"
    },
    {
      "baseHexagramNumber": 18,
      "changedHexagramNumber": 60,
      "sourceEntryNumber": 60,
      "sourceIconHexagramNumber": 60,
      "hexagramName": "節",
      "poemText": "宮成室就，進樂相舞。英俊在堂，福祿光明。",
      "sourceParagraphSha256": "sha256:6a30e05b81809025247e10508de1199573c83d90b52fddf97419c708290824df",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:1a641f478e648bf05115a465754abf64bb74756e94994cb4f620b8fc4f1a6f0e"
    },
    {
      "baseHexagramNumber": 18,
      "changedHexagramNumber": 61,
      "sourceEntryNumber": 61,
      "sourceIconHexagramNumber": 61,
      "hexagramName": "中孚",
      "poemText": "商之子孫，資無所食。貪貝逐狐，留連都市。還轅內鄉，嘉喜何咎。",
      "sourceParagraphSha256": "sha256:94b5a07030433bf1b4eb278bdb47773c38d62cee8a841c032b9911f25d5e3f7a",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:44c6dcfd7015c0bb3c0df727d588b717fd827876255baa2950d38aac1b957749"
    },
    {
      "baseHexagramNumber": 18,
      "changedHexagramNumber": 62,
      "sourceEntryNumber": 62,
      "sourceIconHexagramNumber": 62,
      "hexagramName": "小過",
      "poemText": "執贄入朝，獻其狐裘。元戎燮安，沙漠以懽。",
      "sourceParagraphSha256": "sha256:54e8dd404c0d69e247e3e021292548f90d2381efc0d6424b0afc57fc92e10403",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ac134aa5210e79ab20766e7ee3a36a20e44a0943cee15b93f69f6825bcd55ceb"
    },
    {
      "baseHexagramNumber": 18,
      "changedHexagramNumber": 63,
      "sourceEntryNumber": 63,
      "sourceIconHexagramNumber": 63,
      "hexagramName": "既濟",
      "poemText": "湧泉汨汨，南流不絕。洿為淮海，敗壞邑里。家無所處。",
      "sourceParagraphSha256": "sha256:3ee55df8fc633dcb3cd00c99a67c13ce33fdba194fb10d8d0edcad5fbf1085f1",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:a2bd3d88bed0189579bc4182b9c128a876d652360ec0544f387963e00ccde948"
    },
    {
      "baseHexagramNumber": 18,
      "changedHexagramNumber": 64,
      "sourceEntryNumber": 64,
      "sourceIconHexagramNumber": 64,
      "hexagramName": "未濟",
      "poemText": "固陰沍寒，常冰不溫。凌人惰怠，大雹為災。",
      "sourceParagraphSha256": "sha256:be485a58c58840b1bd8536b4de0f1cdd94f8ed1d85484a37e42b72a3d4cd4310",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:7fce86ec8e4566cb37ade1f7dfe2afb248707ba256e80ab0ec3fa3061696006a"
    }
  ]
}
