  "entryCount": 64,
  "missingTargets": [],
  "entries": [
    {
      "baseHexagramNumber": 30,
      "changedHexagramNumber": 30,
      "sourceEntryNumber": 30,
      "sourceIconHexagramNumber": 30,
      "hexagramName": "離",
      "poemText": "時乘六龍，為帝使東。達命宣旨，無所不通。",
      "sourceParagraphSha256": "sha256:ca03c5732995d4d7748fc9dc1f2840d5e9ae46fe1e43e3b6b92ca777b30460d0",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:e85cc2900e1fd2e4a2aaa644cfb1dd72ca4ab9bdc2fdc55647e5121924c444aa"
    },
    {
      "baseHexagramNumber": 30,
      "changedHexagramNumber": 1,
      "sourceEntryNumber": 1,
      "sourceIconHexagramNumber": 1,
      "hexagramName": "乾",
      "poemText": "執轡四驪，王以為師。陰陽之明，載受東齊。",
      "sourceParagraphSha256": "sha256:3ecc354f5d0ead526f6834ad3e50f552fbee7eef0a03c67c49dd7447f383522f",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:e6eb2b6693b5826d27e818f25517e492f50a5d9f65b03ecb2900ba7f7006a163"
    },
    {
      "baseHexagramNumber": 30,
      "changedHexagramNumber": 2,
      "sourceEntryNumber": 2,
      "sourceIconHexagramNumber": 2,
      "hexagramName": "坤",
      "poemText": "春秋禱祀，解禍除憂，君子無咎。",
      "sourceParagraphSha256": "sha256:1f967ea5fe913596fd3a6dee51b4a3d6e562b2eeb086214b3ef9ba2ba7428edc",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:904e4ffe495e443d7a067988ce1b751fcdfb58c20c6adecbe789a2045fcd6c95"
    },
    {
      "baseHexagramNumber": 30,
      "changedHexagramNumber": 3,
      "sourceEntryNumber": 3,
      "sourceIconHexagramNumber": 3,
      "hexagramName": "屯",
      "poemText": "坐朝乘軒，据國子民。虞叔受命，和合六親。",
      "sourceParagraphSha256": "sha256:6e71afe422e6f3d50d492a33036442505411bcebda6db6ffcfeeaf4f79d1f8e7",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:c2026111b0f36e855b5ea3601c3211c42809feb1e67546405f6d35edca5008e5"
    },
    {
      "baseHexagramNumber": 30,
      "changedHexagramNumber": 4,
      "sourceEntryNumber": 4,
      "sourceIconHexagramNumber": 4,
      "hexagramName": "蒙",
      "poemText": "門戶下堂，與福相迎。祿於公室，曾孫以昌。",
      "sourceParagraphSha256": "sha256:eb225fb0917b4a79389ea36dd3406a83e09599e6bf6534bf3d7bd1472ea9c0c9",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:85f2e13efc3a2443302697c4ffecc320a5b2b333c76b541090d84e54d893b1c7"
    },
    {
      "baseHexagramNumber": 30,
      "changedHexagramNumber": 5,
      "sourceEntryNumber": 5,
      "sourceIconHexagramNumber": 5,
      "hexagramName": "需",
      "poemText": "高木腐巢，漏濕難居。不去甘棠，使我無憂。",
      "sourceParagraphSha256": "sha256:9c1f372e121b647a434440c89b295464c369367aa1826b8cf7453996613d074b",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:0d0b7435281f2e44b1a6d6f81d0ade5b6b732adb36fbd56e9200ae1c92ae310b"
    },
    {
      "baseHexagramNumber": 30,
      "changedHexagramNumber": 6,
      "sourceEntryNumber": 6,
      "sourceIconHexagramNumber": 6,
      "hexagramName": "訟",
      "poemText": "三女為姦，俱行高園。倍室夜行，與伯笑言。不認主母，為設歡酒，冤尤誰禱。",
      "sourceParagraphSha256": "sha256:87c6f3b75eeb7d095c02990c184c5ebce45d075c5a7d94cb7415ec15e1690cf9",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:9105b32c45bcb6f2809a16a402a28c3743e3663673a4d52513fcadc38d89d2c9"
    },
    {
      "baseHexagramNumber": 30,
      "changedHexagramNumber": 7,
      "sourceEntryNumber": 7,
      "sourceIconHexagramNumber": 7,
      "hexagramName": "師",
      "poemText": "漏卮盛酒，無以養老。春貸黍稷，年歲實有。履道坦坦，平安無咎。",
      "sourceParagraphSha256": "sha256:7c986398e9c559ed7042d072b3b3beaedec69b2fd46348b187f37321f7490d61",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:c100a348be41f9303c1da072ea21fc6a85accc145e132e0b4de947d022136964"
    },
    {
      "baseHexagramNumber": 30,
      "changedHexagramNumber": 8,
      "sourceEntryNumber": 8,
      "sourceIconHexagramNumber": 8,
      "hexagramName": "比",
      "poemText": "松柏枝葉，常茂不落。君子懽寧，日富求樂。",
      "sourceParagraphSha256": "sha256:0bdf9665ff4173cd662dbf8622fcdeceb30ef8729dfc7095a4e2d42051b1c87c",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:50aa430551283add20b9266f60db7c9995c0ddb4530f60ca73676cb631a036ac"
    },
    {
      "baseHexagramNumber": 30,
      "changedHexagramNumber": 9,
      "sourceEntryNumber": 9,
      "sourceIconHexagramNumber": 9,
      "hexagramName": "小畜",
      "poemText": "夫婦不諧，為燕攻齊。良弓不張，騎劫憂亡。",
      "sourceParagraphSha256": "sha256:3932c49b871422487a8649f6dcf9d7d1f5892c674a1cc7337fe6350e29326b6a",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:7b2d8eae879c1892160cff5068bb5ff15866b42d4a08383d3a2e5034bb256870"
    },
    {
      "baseHexagramNumber": 30,
      "changedHexagramNumber": 10,
      "sourceEntryNumber": 10,
      "sourceIconHexagramNumber": 10,
      "hexagramName": "履",
      "poemText": "出令不勝，反為大災。強不克弱，君受其憂。",
      "sourceParagraphSha256": "sha256:2798fa271a1622f4dd1657337df86ebcaa57bd0746d423c0060b25e7ab9aa29f",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:4d785f929b79cdc058cb7a806de64bf77a0a9d868203d8a6f8d2748b24d5acf3"
    },
    {
      "baseHexagramNumber": 30,
      "changedHexagramNumber": 11,
      "sourceEntryNumber": 11,
      "sourceIconHexagramNumber": 11,
      "hexagramName": "泰",
      "poemText": "奔走相錯，敗亂諸緒，民不得作。",
      "sourceParagraphSha256": "sha256:e20ab832b8119b843150c3ab8ff3dad7fab97b6cc20c799789abc79a7141a9e7",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:fa2bc22366c16c05e92687e3bd11966f524f4e55b49f717c8179203d73072c60"
    },
    {
      "baseHexagramNumber": 30,
      "changedHexagramNumber": 12,
      "sourceEntryNumber": 12,
      "sourceIconHexagramNumber": 12,
      "hexagramName": "否",
      "poemText": "載璧秉珪，請命於河。周公克敏，沖人瘳愈。",
      "sourceParagraphSha256": "sha256:73c3c1dd6f09c02b8301240f591aadc7b8d2d422a8cf972e0f67f7e75bc09916",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:f0e4d80ca6a748e5747ff94ed39ec924dd55953d382eca61b7fbbb7e0985354d"
    },
    {
      "baseHexagramNumber": 30,
      "changedHexagramNumber": 13,
      "sourceEntryNumber": 13,
      "sourceIconHexagramNumber": 13,
      "hexagramName": "同人",
      "poemText": "素車為馬，不任重負。王侯出征，憂危為咎。",
      "sourceParagraphSha256": "sha256:6861f59275e898417a6e52eb70722e785232fe675e1006dde87c225e93e4e0fd",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:3732650edd51d1462c462b7839e7eaf7ac0b41f184a56cebb9f2154bb82e9989"
    },
    {
      "baseHexagramNumber": 30,
      "changedHexagramNumber": 14,
      "sourceEntryNumber": 14,
      "sourceIconHexagramNumber": 14,
      "hexagramName": "大有",
      "poemText": "大樹之子，百條共母。比之火中，枝葉盛茂。",
      "sourceParagraphSha256": "sha256:a73316dad610d0df1bb775e910f75b274799e9f62eb2e8ad352e3a4ab216966a",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:21cfc41ad09eec948f5525a1a8159ffaca5cbf835595d83415fbdffe427c31fb"
    },
    {
      "baseHexagramNumber": 30,
      "changedHexagramNumber": 15,
      "sourceEntryNumber": 15,
      "sourceIconHexagramNumber": 15,
      "hexagramName": "謙",
      "poemText": "壅遏隄防，水不得行。火盛陽光，陰蜺伏藏。走歸其鄉。",
      "sourceParagraphSha256": "sha256:394f8a2376d24d7fe6641bfdd31dd4a902769706cf29529898f0c893ca17205d",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:0ec5239f8f7880e7e35b5408dba581783eecf41f8afe5dae78e28177755cf5e3"
    },
    {
      "baseHexagramNumber": 30,
      "changedHexagramNumber": 16,
      "sourceEntryNumber": 16,
      "sourceIconHexagramNumber": 16,
      "hexagramName": "豫",
      "poemText": "五嶽四瀆，合潤為德。行不失理，民賴恩福。",
      "sourceParagraphSha256": "sha256:f3a736645e6d71d6959f2ce98bedd0678e179877d362d2891175fd7e0af8a732",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:0c38b746898674a018c8a7cdbca9c5249c0bdfc6c9f96a4ddc03525d73277d0b"
    },
    {
      "baseHexagramNumber": 30,
      "changedHexagramNumber": 17,
      "sourceEntryNumber": 17,
      "sourceIconHexagramNumber": 17,
      "hexagramName": "隨",
      "poemText": "駕駿南遊，虎驚我牛。陰不奉陽，其光滅蹴。訾之謙謙，奉義解患。",
      "sourceParagraphSha256": "sha256:7b69eceb3ffe4c6c970b7638bc108fc0722b1775d36dc03e487830c6e77910da",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:4d6a3b2c63a0c1ec26ca4e22a346ea07ee6aad574b6ace20d4fb0ee00f84937d"
    },
    {
      "baseHexagramNumber": 30,
      "changedHexagramNumber": 18,
      "sourceEntryNumber": 18,
      "sourceIconHexagramNumber": 18,
      "hexagramName": "蠱",
      "poemText": "早霜晚雪，傷害禾麥。損功棄力，飢無所食。",
      "sourceParagraphSha256": "sha256:6aa450abff79d59adb028de97bf0e126f0d096dfaf49dcafe4b351de10cd620d",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:80ba30f4220bcde4f9cb37677c8464535e80be4194ad2fafdd9f43a911f0ad35"
    },
    {
      "baseHexagramNumber": 30,
      "changedHexagramNumber": 19,
      "sourceEntryNumber": 19,
      "sourceIconHexagramNumber": 19,
      "hexagramName": "臨",
      "poemText": "岐周海隅，獨樂無憂。可以避難，全身保財。",
      "sourceParagraphSha256": "sha256:ab47fa15f96f0deda6feeeec7c91208b946c4e6bbf4e75526fe686434e748a5c",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:b2c33344e5221289ed40466504fbbb6b98c87f74a37476a0a9a0e2c7418db41b"
    },
    {
      "baseHexagramNumber": 30,
      "changedHexagramNumber": 20,
      "sourceEntryNumber": 20,
      "sourceIconHexagramNumber": 20,
      "hexagramName": "觀",
      "poemText": "陰蔽其陽，目暗不明。君憂其國，求騂得黃。駒犢從行。",
      "sourceParagraphSha256": "sha256:fc47132854f123000a0fe2c2f31c4269f150fc44b20fce0516d868df0c4713ed",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:3dfba5cb36b8907d3b03db85af9dad4947f7773a42415ad95068a9d73fbf7205"
    },
    {
      "baseHexagramNumber": 30,
      "changedHexagramNumber": 21,
      "sourceEntryNumber": 21,
      "sourceIconHexagramNumber": 21,
      "hexagramName": "噬嗑",
      "poemText": "金城鐵廓，上下仝力。政平民歡，寇不敢賊。",
      "sourceParagraphSha256": "sha256:bba286378db928ec395ec16370e75390fbbcdcef38fba29543130f5ab146c372",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:25e409625a6f626795e3db4a66253e2febeef910d691cd2cab600f1f0f1e3737"
    },
    {
      "baseHexagramNumber": 30,
      "changedHexagramNumber": 22,
      "sourceEntryNumber": 22,
      "sourceIconHexagramNumber": 22,
      "hexagramName": "賁",
      "poemText": "平公有疾，迎醫秦國。和不能治，晉人疑惑。",
      "sourceParagraphSha256": "sha256:e323165305f12f5102be97c0b7303effbe6c07828b511bda0bde6b5e57b5a2ce",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:6acc7ad7088f0e5ece2ec6333bbee62120c62c6bf52591c707770a295543adba"
    },
    {
      "baseHexagramNumber": 30,
      "changedHexagramNumber": 23,
      "sourceEntryNumber": 23,
      "sourceIconHexagramNumber": 23,
      "hexagramName": "剝",
      "poemText": "載堯扶禹，從喬彭祖。西遇王母，道路夷易。無敢難者。",
      "sourceParagraphSha256": "sha256:ac5da05568117d654b5843f096319656001916db776e86b5de76d58688764b26",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:2335013c768aeeaa33c1e2287ec129eb56747d896ab271f5fa206f87e3067873"
    },
    {
      "baseHexagramNumber": 30,
      "changedHexagramNumber": 24,
      "sourceEntryNumber": 24,
      "sourceIconHexagramNumber": 24,
      "hexagramName": "復",
      "poemText": "羔羊皮革，君子朝服。輔政天德，以合萬國。",
      "sourceParagraphSha256": "sha256:9d4128abaa006f5276db5bee19a5db63389a36f3c9cf293edc8c0466b2687473",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:70cb3ac41ad557f31fa144805aab10322d047435361748840ac4ede16afe0e12"
    },
    {
      "baseHexagramNumber": 30,
      "changedHexagramNumber": 25,
      "sourceEntryNumber": 25,
      "sourceIconHexagramNumber": 25,
      "hexagramName": "无妄",
      "poemText": "振鐘鼓樂，將軍受福。安帖之家，虎狼為憂。履危不殆，師行何咎。",
      "sourceParagraphSha256": "sha256:4810f3fda7352880e7385251887477046b7d01b0f06ad9498a4ede3401be578a",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:1f9a572e3e50b20c06ee74278323398cc741035bd8c0b5fbee91d9ebbdcb0ac6"
    },
    {
      "baseHexagramNumber": 30,
      "changedHexagramNumber": 26,
      "sourceEntryNumber": 26,
      "sourceIconHexagramNumber": 26,
      "hexagramName": "大畜",
      "poemText": "嫡庶不明，孽亂生殃，陳失其邦。",
      "sourceParagraphSha256": "sha256:63376d0dee8b33d2b0824ec106b7ce536ebe822783daa7237ad9a396b729b382",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ab68eaa32464eaed04f18706f3dc7366e9696b23fffa9c376d330c2fe4b07e43"
    },
    {
      "baseHexagramNumber": 30,
      "changedHexagramNumber": 27,
      "sourceEntryNumber": 27,
      "sourceIconHexagramNumber": 27,
      "hexagramName": "頤",
      "poemText": "鳥驚孤鴻，亂國不寧。上弱下強，為陰所行。",
      "sourceParagraphSha256": "sha256:fc4667d4f3885c19c55a08c659de9dc6e8083c8ea4ed9b10ff562069f17a02fa",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:0ba9b3e97f05e327fb9b4800066f6fafad496202c774673b3a86be1db0fc3b2a"
    },
    {
      "baseHexagramNumber": 30,
      "changedHexagramNumber": 28,
      "sourceEntryNumber": 28,
      "sourceIconHexagramNumber": 28,
      "hexagramName": "大過",
      "poemText": "被繡夜行，不見文章。安坐於堂，乃無咎殃。長子帥師，得其正常。",
      "sourceParagraphSha256": "sha256:dc1bc5d009c0f58415e374af97b2d89718bac433f018cbe90f820119c10fafef",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:439c18c7c54f532341652c74664edbfafeb67b8c804b02eced7059ae20165a46"
    },
    {
      "baseHexagramNumber": 30,
      "changedHexagramNumber": 29,
      "sourceEntryNumber": 29,
      "sourceIconHexagramNumber": 29,
      "hexagramName": "坎",
      "poemText": "六月采芑，征伐無道。張仲方叔，克勝飲酒。",
      "sourceParagraphSha256": "sha256:397adfbeb740e7ae31effca72964914310849e1e9e417b499ad0b889e2f390f4",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:6e94a4931ef3f97b2bb9032d537070c59345ceb791199107fafd8146c0176d8f"
    },
    {
      "baseHexagramNumber": 30,
      "changedHexagramNumber": 31,
      "sourceEntryNumber": 31,
      "sourceIconHexagramNumber": 31,
      "hexagramName": "咸",
      "poemText": "昧暮乘車，東至伯家。踰梁越河，濟脫無他。",
      "sourceParagraphSha256": "sha256:c5f9f23de2d41514c3d470f83c78edf679a27970fd66be16a2f945fc3d098ac1",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ac1fcacf0bd8c42590f779f875edfc435a4f921bea39e42a52be0d8a3f4c4030"
    },
    {
      "baseHexagramNumber": 30,
      "changedHexagramNumber": 32,
      "sourceEntryNumber": 32,
      "sourceIconHexagramNumber": 32,
      "hexagramName": "恒",
      "poemText": "東風解凍，和氣兆升，年歲豐登。",
      "sourceParagraphSha256": "sha256:2b45d6ef7d222cf7f6860c3e1715b0ab522ae7ffd768990af6515923007f7acc",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:37d5c1a91129deda55ec9ce97210f081d593fea44eb879aac7e81a290588cbfc"
    },
    {
      "baseHexagramNumber": 30,
      "changedHexagramNumber": 33,
      "sourceEntryNumber": 33,
      "sourceIconHexagramNumber": 33,
      "hexagramName": "遯",
      "poemText": "三狸搏鼠，遮遏前後。死於圜域，不得脫走。",
      "sourceParagraphSha256": "sha256:25a7abf244b6cee5845eceea0ffb169734be7b666192f4f1977d652798014da8",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:886784eb1023c5a832b164d46437611bd25b135d4658cc6d61314f7b3c4c2cfe"
    },
    {
      "baseHexagramNumber": 30,
      "changedHexagramNumber": 34,
      "sourceEntryNumber": 34,
      "sourceIconHexagramNumber": 34,
      "hexagramName": "大壯",
      "poemText": "綏德孔明，履祿久長。貴且有光，疾病憂傷。",
      "sourceParagraphSha256": "sha256:445dbeed6a63f99480f6e294c0df92c68934725e7991e90602d1f7693ccaa063",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:27bad0c722cd55557dbbfdab421acc96079f77678db01dc2089ff035d6faf46f"
    },
    {
      "baseHexagramNumber": 30,
      "changedHexagramNumber": 35,
      "sourceEntryNumber": 35,
      "sourceIconHexagramNumber": 35,
      "hexagramName": "晉",
      "poemText": "三虎搏狼，力不相當。如摧腐枯，一擊破亡。",
      "sourceParagraphSha256": "sha256:9a628e18e82d329a77bf6f7d74f66b1fab5ecdb5d86de97147df39ad6273f809",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:79dcd01b4412a4785218f763fa37d5eb55ea0064b0b27ca02d1ca76f35d34ddc"
    },
    {
      "baseHexagramNumber": 30,
      "changedHexagramNumber": 36,
      "sourceEntryNumber": 36,
      "sourceIconHexagramNumber": 36,
      "hexagramName": "明夷",
      "poemText": "使伯采桑，狠不肯行。與叔爭訟，更相毀傷。",
      "sourceParagraphSha256": "sha256:2614a6ea1bd049308718fcc61aadf446b59aee80225fccfc8709db96e9855985",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:41fa9f1c4ca69aad6e2827fdc25b62dccd40b39de85dc83eceecb5c6c5026b23"
    },
    {
      "baseHexagramNumber": 30,
      "changedHexagramNumber": 37,
      "sourceEntryNumber": 37,
      "sourceIconHexagramNumber": 37,
      "hexagramName": "家人",
      "poemText": "抱空握虛，鴞驚我雛，利去不來。",
      "sourceParagraphSha256": "sha256:dc5e4c5182e5015140b30020cb5ec6d3d002bde0b6fd5c5b2e25d7fa308ef5ec",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:cea3367f195de6e033b7a0317c05f4c948d042bf12b058faf67a518daccadbd9"
    },
    {
      "baseHexagramNumber": 30,
      "changedHexagramNumber": 38,
      "sourceEntryNumber": 38,
      "sourceIconHexagramNumber": 38,
      "hexagramName": "睽",
      "poemText": "李花再實，鴻卵降集。仁哲以興，隆國不賊。",
      "sourceParagraphSha256": "sha256:d9afcc681aef1a70caf603d2f72c635e9dcd43be7511d45a310ac6f41b566495",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:36aefddd0b0d0c81c65fe82a6dd095a550d98741f41b963ef2accdef578f677e"
    },
    {
      "baseHexagramNumber": 30,
      "changedHexagramNumber": 39,
      "sourceEntryNumber": 39,
      "sourceIconHexagramNumber": 39,
      "hexagramName": "蹇",
      "poemText": "東山皋落，勇悍不服。金瑛玩好，衣為身賊。絲麻不作。",
      "sourceParagraphSha256": "sha256:ee3938824f748e822129535798ff65b28bf255a52b4d7ce591e9f134132aca32",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:81d990f58036f8b5486cacc0c88b46324f80b260ae97c9f379e9e7166b628c5a"
    },
    {
      "baseHexagramNumber": 30,
      "changedHexagramNumber": 40,
      "sourceEntryNumber": 40,
      "sourceIconHexagramNumber": 40,
      "hexagramName": "解",
      "poemText": "飛蚊污身，為邪所率。青蠅分白，真孝放逐。",
      "sourceParagraphSha256": "sha256:95c6b816f1047ad5c0b9826bf30b1f1ce686511e3636e211c011c034e6a1b3df",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:9699fb126905aeb1a7f1d255af29fe8f7f5c1ebb237e6803ccbd0d11cb1bcdb7"
    },
    {
      "baseHexagramNumber": 30,
      "changedHexagramNumber": 41,
      "sourceEntryNumber": 41,
      "sourceIconHexagramNumber": 41,
      "hexagramName": "損",
      "poemText": "南山大木，丈身六目。制命出文，東里宣敷。尊主安居，鄭國無患。",
      "sourceParagraphSha256": "sha256:29a2aecc7d522bf91e91efc159a8ff53d4ead57d22f7f154f31d4474e45e2028",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:5ec7e1d929b63e8687564c5c1d4fde2c767b8b02cfbf1b450d37b6ea9f505ae2"
    },
    {
      "baseHexagramNumber": 30,
      "changedHexagramNumber": 42,
      "sourceEntryNumber": 42,
      "sourceIconHexagramNumber": 42,
      "hexagramName": "益",
      "poemText": "泉起崑崙，西出玉門。流為九河，無有憂患。",
      "sourceParagraphSha256": "sha256:b4c3b6f7647b2e3e2336537cad0fc181d4b1fd1f7acc25fd9f4aaed3cebeeca2",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:607f6baee26dbcf2912bfa586e9bea0f7bf330b64ff2469bbbbca42bc8b4b0db"
    },
    {
      "baseHexagramNumber": 30,
      "changedHexagramNumber": 43,
      "sourceEntryNumber": 43,
      "sourceIconHexagramNumber": 43,
      "hexagramName": "夬",
      "poemText": "命短不長，中年夭傷。思及哭堂，哀其子亡。",
      "sourceParagraphSha256": "sha256:feb231df8cccaf7a9110db9cd02e71c704220ede60f07a1f2ce42759f6bd3255",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ea8d9f786db909b949761c228cafa210e52e806bd55796c0fa4124893af0e231"
    },
    {
      "baseHexagramNumber": 30,
      "changedHexagramNumber": 44,
      "sourceEntryNumber": 44,
      "sourceIconHexagramNumber": 44,
      "hexagramName": "姤",
      "poemText": "君臣不和，上下失宜，宗子哀歌。",
      "sourceParagraphSha256": "sha256:a1df22bfc9b8cddb8b89e438f3bcb0358a1a5c275c31ad1a437bddf8fa9536d3",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:69f83e7fb4341ad521e603958dc83756908ce572746a06eb614bea4c932a1a7f"
    },
    {
      "baseHexagramNumber": 30,
      "changedHexagramNumber": 45,
      "sourceEntryNumber": 45,
      "sourceIconHexagramNumber": 45,
      "hexagramName": "萃",
      "poemText": "苛政日作，螟食華葉。割下啖上，民被其賊。秋無所得。",
      "sourceParagraphSha256": "sha256:4cb7ef8766d7658c9212fd25736597b90106f007602147bdef9a5c086c71b8bf",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:fa565b4050137ff76e2d8307791429fdc1c1c4a5546d432598039daab3803d84"
    },
    {
      "baseHexagramNumber": 30,
      "changedHexagramNumber": 46,
      "sourceEntryNumber": 46,
      "sourceIconHexagramNumber": 46,
      "hexagramName": "升",
      "poemText": "南行載鎧，登履九魁。車傷牛罷，日暮嗟咨。",
      "sourceParagraphSha256": "sha256:f12156c300f944a3e84a696cb0eebac33304654a198295e6a25d48dda1aadb07",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ad8fba5adf271aa9470b247f8bdcd6782d58f421885bbe745696ed0f39bf3bd9"
    },
    {
      "baseHexagramNumber": 30,
      "changedHexagramNumber": 47,
      "sourceEntryNumber": 47,
      "sourceIconHexagramNumber": 47,
      "hexagramName": "困",
      "poemText": "春東夏南，隨陽有功，與利相逢。",
      "sourceParagraphSha256": "sha256:9250bebb736356bdd0120354d29476d472eec410e947bbf9b96624bb681ddab7",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:3f3a37afac7696934fd090a44c2c96d1cb1b3ed2ef0ad9733ca187ba29e293d1"
    },
    {
      "baseHexagramNumber": 30,
      "changedHexagramNumber": 48,
      "sourceEntryNumber": 48,
      "sourceIconHexagramNumber": 48,
      "hexagramName": "井",
      "poemText": "頭尾顛倒，不知緒處，君失其國。",
      "sourceParagraphSha256": "sha256:46b9464b794b7056ca3579a1e45e280283a49285736efae6f3109f421335c75d",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ba35106eefe50c22f0f8ae447b35c8c084e5e56af0a69f0f4ee37fbae83c31da"
    },
    {
      "baseHexagramNumber": 30,
      "changedHexagramNumber": 49,
      "sourceEntryNumber": 49,
      "sourceIconHexagramNumber": 49,
      "hexagramName": "革",
      "poemText": "言無要約，不成券契。殷叔季姬，公孫爭之。強入委命，不悅子南。",
      "sourceParagraphSha256": "sha256:00c0e3c38462f306ba160689a9a69a10b83aa9890c482fa942631711e964c4fd",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ef21edac17843485e3e6af0fc8cb7989e79252edde09d42df468cd7289a50055"
    },
    {
      "baseHexagramNumber": 30,
      "changedHexagramNumber": 50,
      "sourceEntryNumber": 50,
      "sourceIconHexagramNumber": 50,
      "hexagramName": "鼎",
      "poemText": "缺陷不成，胎卵不生，不見其形。",
      "sourceParagraphSha256": "sha256:d405c510b5ee91ec0c2396f7d599ff83b4464c993f32b71cc2df00331e8f5290",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:759b41b4968c634b39054d3b3be012d82bb802f04d07a5e2995650fdb1ee9d01"
    },
    {
      "baseHexagramNumber": 30,
      "changedHexagramNumber": 51,
      "sourceEntryNumber": 51,
      "sourceIconHexagramNumber": 51,
      "hexagramName": "震",
      "poemText": "見蛇交臥，惜蜒畏惡，心乃無悔。",
      "sourceParagraphSha256": "sha256:29f05d5461c0bbd6c4013e02dfb0f2e489bd119dbdeea359bd46563e17f072ca",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:dedee722872392a47054a3922728c2cf0d0f67bf1969d0451efcf428e478f14e"
    },
    {
      "baseHexagramNumber": 30,
      "changedHexagramNumber": 52,
      "sourceEntryNumber": 52,
      "sourceIconHexagramNumber": 52,
      "hexagramName": "艮",
      "poemText": "河水孔穴，壞敗我室。水深無涯，魚鱉傾倒。",
      "sourceParagraphSha256": "sha256:f8aa55dfbcd5400bd13c7d5a8fdc800eecb4a49b2608d2805f5d28af9e382bd9",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:0ceab56a7e0fca8a55df7129dda06f657ca9bda8318d683c9514840d7059017e"
    },
    {
      "baseHexagramNumber": 30,
      "changedHexagramNumber": 53,
      "sourceEntryNumber": 53,
      "sourceIconHexagramNumber": 53,
      "hexagramName": "漸",
      "poemText": "五嶽四瀆，地得以安。高而不危，驚懼避患。",
      "sourceParagraphSha256": "sha256:d1ca3fe7cf4b59c4e744e8d96128963f52e1fab738cfc445c39bccac529a7b00",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:44d2072c029c2b2e1fec3f7ffdecfc1b8c5db9fb2fce01375d36794d5aaffe19"
    },
    {
      "baseHexagramNumber": 30,
      "changedHexagramNumber": 54,
      "sourceEntryNumber": 54,
      "sourceIconHexagramNumber": 54,
      "hexagramName": "歸妹",
      "poemText": "南至之日，陽消不息。北風冽寒，萬物藏伏。",
      "sourceParagraphSha256": "sha256:2a0fe8529b8c043b57efa24efb49e207d1c9d004ff044a2ff9f90c05e7299068",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:a22f4cb37abc4f0aa4e312784a32bb7c9ac3ab317801f7c39225b038124ab2f6"
    },
    {
      "baseHexagramNumber": 30,
      "changedHexagramNumber": 55,
      "sourceEntryNumber": 55,
      "sourceIconHexagramNumber": 55,
      "hexagramName": "豐",
      "poemText": "五利四福，俱田高邑。黍稷盛茂，多獲高稻。",
      "sourceParagraphSha256": "sha256:ba1fe1ae6b593e75b8cffa8e3cc6c66671d1d8565532644e696e3224ba09e5d7",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:3736f0113c1ad60169bc72daa7e17deab082663838d77f74f8d742e4170e0284"
    },
    {
      "baseHexagramNumber": 30,
      "changedHexagramNumber": 56,
      "sourceEntryNumber": 56,
      "sourceIconHexagramNumber": 56,
      "hexagramName": "旅",
      "poemText": "公孫駕車，載遊東齊。延陵子產，遺我紵衣。疾病哀悲。",
      "sourceParagraphSha256": "sha256:cb72f14a4c8ef5c83af8f128af7d229f5375fc84c109edb9d42c34d3c5b577ea",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:fd98533f651efde00631146ed6acd0db17cd5a43a7cd43275774d35892ce15b4"
    },
    {
      "baseHexagramNumber": 30,
      "changedHexagramNumber": 57,
      "sourceEntryNumber": 57,
      "sourceIconHexagramNumber": 57,
      "hexagramName": "巽",
      "poemText": "蛟虯當道，民困愁苦。望羊置群，長子在門。",
      "sourceParagraphSha256": "sha256:8c12e7d48a637ba899a4b338c4f04e82b8b9f45e6eff4f4cf0330397c9c53b7d",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:677b069119b7b36423ed8ed78e73016f2a010795eafa290967df48360845d752"
    },
    {
      "baseHexagramNumber": 30,
      "changedHexagramNumber": 58,
      "sourceEntryNumber": 58,
      "sourceIconHexagramNumber": 58,
      "hexagramName": "兌",
      "poemText": "金玉滿堂，忠直乘危。三老凍餓，鬼奪我室。求魚河海，網舉必得。",
      "sourceParagraphSha256": "sha256:d3b9095f342fb4d0be1458a4445be8f969b35cb60c5f8df60ef344e1a131f3d0",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:2f573ab0e0dea68416d68079bc78c4a638be0c02228b871032d4f85d3e4763dc"
    },
    {
      "baseHexagramNumber": 30,
      "changedHexagramNumber": 59,
      "sourceEntryNumber": 59,
      "sourceIconHexagramNumber": 59,
      "hexagramName": "渙",
      "poemText": "日入明匿，陽精隱伏。小人心勞，求事不得。",
      "sourceParagraphSha256": "sha256:ef41174d2de9391bb377cfb9bb2f7f44ed9f507f910c5991b20dcc041d00cde5",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:80cbfe186905c81f6736637d45f0e62303492c4187b3745b48f96cff03624812"
    },
    {
      "baseHexagramNumber": 30,
      "changedHexagramNumber": 60,
      "sourceEntryNumber": 60,
      "sourceIconHexagramNumber": 60,
      "hexagramName": "節",
      "poemText": "頻逢招飲，失利後福。不如子息，舊器故杵。申請必得，乃無大悔。",
      "sourceParagraphSha256": "sha256:8e1b33fa303b6c7cb16f6361906d9e35c882f95dab111fb7752f2c7d92a372dc",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:1563c33c074b9a47940d2fb4ca95cab4287855a12f60d83942fd2dc6c8036977"
    },
    {
      "baseHexagramNumber": 30,
      "changedHexagramNumber": 61,
      "sourceEntryNumber": 61,
      "sourceIconHexagramNumber": 61,
      "hexagramName": "中孚",
      "poemText": "南有嘉魚，驚黃取遊。魴鱮詡詡，利來無憂。",
      "sourceParagraphSha256": "sha256:0a68017a6717a44ce88fc4224c79bb2a4e5c3827d8a304a8b50c7287765420d4",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:3ffc2e79f112a52d250c89a2c93d104bfa9bbc47d2042369e8627610dd7fb345"
    },
    {
      "baseHexagramNumber": 30,
      "changedHexagramNumber": 62,
      "sourceEntryNumber": 62,
      "sourceIconHexagramNumber": 62,
      "hexagramName": "小過",
      "poemText": "黃裳建元，文德在身。祿佑洋溢，封為齊君。",
      "sourceParagraphSha256": "sha256:7b1b905b7aaa3bd9824d208216dbcfb69936edc653ae4ed577082de20dfc1f94",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:0f54ea6e67c4adb5910ff4200fe7b28dfd39185ba4056c159cde172747ecfea4"
    },
    {
      "baseHexagramNumber": 30,
      "changedHexagramNumber": 63,
      "sourceEntryNumber": 63,
      "sourceIconHexagramNumber": 63,
      "hexagramName": "既濟",
      "poemText": "口不從心，欲東反西。與意乖戾，動舉失便。",
      "sourceParagraphSha256": "sha256:5cc735e45f0600f69cb5a9ca6ccf2000310645d9a183521645232e75be4a863a",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:8b7f7122159bc33bc746048289c086e710440af479b67a18a3b15479c5d2d9a4"
    },
    {
      "baseHexagramNumber": 30,
      "changedHexagramNumber": 64,
      "sourceEntryNumber": 64,
      "sourceIconHexagramNumber": 64,
      "hexagramName": "未濟",
      "poemText": "虎狼之鄉，日爭凶訟。叨爾為長，不能定証。",
      "sourceParagraphSha256": "sha256:0a2281b9ba41777ff56f39d97be7ec175a22e2fb0f312aae9bedb79bee7ffcaa",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:65a090078590b5b020958c12477f036634f1f7ebd3fc2d10924da3852ade0659"
    }
  ]
}
