  "attribution": "來源：《焦氏易林》，易學網《焦氏易林［四庫全書版］》（依據版本：《欽定四庫全書》子部術數類），https://www.eee-learning.com/book/giauii 。依來源要求標示出處及原網頁連結；本站僅整理林辭原文，並記錄收錄、標點及文字整理修改。",
  "entryCount": 64,
  "missingTargets": [],
  "entries": [
    {
      "baseHexagramNumber": 11,
      "changedHexagramNumber": 11,
      "sourceEntryNumber": 11,
      "sourceIconHexagramNumber": 11,
      "hexagramName": "泰",
      "poemText": "有求陳國，留連東域。須我王孫，四月來復。主君有德，蒙恩受福。",
      "sourceParagraphSha256": "sha256:a1b85d6f0a98027eda378c90cc5834904ef135c087aa4b6e44f4edccb47e2d2c",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ff82dc0db2034e5d8a3e687d4ee2b6fb170c2f9830977aa354c63812805cb58b"
    },
    {
      "baseHexagramNumber": 11,
      "changedHexagramNumber": 1,
      "sourceEntryNumber": 1,
      "sourceIconHexagramNumber": 1,
      "hexagramName": "乾",
      "poemText": "伯夷叔齊，貞廉之師。以德防患，憂禍不存。",
      "sourceParagraphSha256": "sha256:b2036eb74eb0147a497feebd07a3106bb09aa1cfb6a630bff4136417f3a2ecf8",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:78260c95cc8c3ad07b201a3259bd620299db12966d2d2aa4d9aab51fc9ea6943"
    },
    {
      "baseHexagramNumber": 11,
      "changedHexagramNumber": 2,
      "sourceEntryNumber": 2,
      "sourceIconHexagramNumber": 2,
      "hexagramName": "坤",
      "poemText": "濟深難渡，濡我衣褲。五子善擢，脫無他故。",
      "sourceParagraphSha256": "sha256:2134cd90397b9f9b00393a229e3f7185d3621102b08070e8e39869e8e17be889",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:a663333fb3b94071a869dc38e2125d1f0d56082a27fd0f957513a94a4cf37f84"
    },
    {
      "baseHexagramNumber": 11,
      "changedHexagramNumber": 3,
      "sourceEntryNumber": 3,
      "sourceIconHexagramNumber": 3,
      "hexagramName": "屯",
      "poemText": "倚立相望，適我道通。驅駕奔馳，比目同床。",
      "sourceParagraphSha256": "sha256:7f5e374695ca423ab947d1bca67950750cc2169ac8d4166ebb784f620a6b5f16",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:f4c6c3c768b93469055e082953a3b67f827e5c3596bd1f467f06158f22d39743"
    },
    {
      "baseHexagramNumber": 11,
      "changedHexagramNumber": 4,
      "sourceEntryNumber": 4,
      "sourceIconHexagramNumber": 4,
      "hexagramName": "蒙",
      "poemText": "葛藟蒙棘，華不得實。讒佞為政，使恩壅塞。",
      "sourceParagraphSha256": "sha256:bae974d2c7d9e7aa18173ac006d35bb64e58ba788bb71c3ff22989d3a66ad556",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:1c78e32e4fdb2f32a63c8f931ea388c3a8b6a83e6e2c05ac745a95bce2fe028d"
    },
    {
      "baseHexagramNumber": 11,
      "changedHexagramNumber": 5,
      "sourceEntryNumber": 5,
      "sourceIconHexagramNumber": 5,
      "hexagramName": "需",
      "poemText": "四牡兼用，君子所服。南征述職，與福同德。",
      "sourceParagraphSha256": "sha256:83889f28a476280ddf7ca5a187237a1071603774dc895e50cfcd021f31beb83c",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ab38307d662ec28f48a2e83c592e0824f9904ffbd83ad0700c72eb0058bfd0b5"
    },
    {
      "baseHexagramNumber": 11,
      "changedHexagramNumber": 6,
      "sourceEntryNumber": 6,
      "sourceIconHexagramNumber": 6,
      "hexagramName": "訟",
      "poemText": "踝踵足傷，大指病癰。失旅後時，利走不來。",
      "sourceParagraphSha256": "sha256:def6ecf1537be5758dab8909987e132c77ee3f830999e565486d900a7bafd9e8",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:78f6bfdfedf6e95d1d618fc26d146e41406659b080031867cdc944026408b944"
    },
    {
      "baseHexagramNumber": 11,
      "changedHexagramNumber": 7,
      "sourceEntryNumber": 7,
      "sourceIconHexagramNumber": 7,
      "hexagramName": "師",
      "poemText": "春城夏國，長生之域。可以服食，保全家國。",
      "sourceParagraphSha256": "sha256:b722c2cfcae29ad0cf920f14b7963cad904016961072fb7177799cee23d34003",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:e483eb4c2ae8259de431d5a35ee2011c91a2f5106181b91791aba7903f49922b"
    },
    {
      "baseHexagramNumber": 11,
      "changedHexagramNumber": 8,
      "sourceEntryNumber": 8,
      "sourceIconHexagramNumber": 8,
      "hexagramName": "比",
      "poemText": "望驥不來，拘蹇為憂。雨驚我心，風感我肌。",
      "sourceParagraphSha256": "sha256:ea2ad380824eaef91732c73bf3dc71b654a8a969679e2e1afa0e4ba068b435c6",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:9748ab66e60eb50bd65237ea4a224c192bcb1d6da35119308dda97d8e8dbe670"
    },
    {
      "baseHexagramNumber": 11,
      "changedHexagramNumber": 9,
      "sourceEntryNumber": 9,
      "sourceIconHexagramNumber": 9,
      "hexagramName": "小畜",
      "poemText": "久客無床，思歸我鄉。雷雨浸盈，道不得通。",
      "sourceParagraphSha256": "sha256:4cc57d48d224fb9a18ae4abff1056e3c6daaff529748032168002d9c5302e39c",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:4924a6eb728297b4d81409b5b3f349b41b3e1759188676607fd9837891197a0c"
    },
    {
      "baseHexagramNumber": 11,
      "changedHexagramNumber": 10,
      "sourceEntryNumber": 10,
      "sourceIconHexagramNumber": 10,
      "hexagramName": "履",
      "poemText": "方船備水，傍河燃火。積善有徵，終身無禍。天福吉昌，永得安康。",
      "sourceParagraphSha256": "sha256:5b62dd782e6292ffe956130a73bc45893f0794864a22d8c6422714000bc730c8",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:e68f2c39cf60dd56fb9b1b86b57fbbf956e23fddbd9f0ad804513e647e0a1085"
    },
    {
      "baseHexagramNumber": 11,
      "changedHexagramNumber": 12,
      "sourceEntryNumber": 12,
      "sourceIconHexagramNumber": 12,
      "hexagramName": "否",
      "poemText": "陟岵望母，役事不已。王政靡盬，不得相保。",
      "sourceParagraphSha256": "sha256:b258e36d243e9c9d5197f1cdba27c7f9d3433d0fb25d41184dac3a2f0a8cff66",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:3e14ef623dab4c8e99b86d6cdfbc5fa47e67664c80ca03be359b632d3c84d39e"
    },
    {
      "baseHexagramNumber": 11,
      "changedHexagramNumber": 13,
      "sourceEntryNumber": 13,
      "sourceIconHexagramNumber": 13,
      "hexagramName": "同人",
      "poemText": "多載負重，捐棄於野。王母離子，思勞自苦。",
      "sourceParagraphSha256": "sha256:a641e74be25bc4c67ce978154d7ab65e2ea4114d9e066eabd429cff55bb55068",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:7abb9ae10ccda6d9fda5b7a33c64fe11d258e8f7ef4deeac73008cd667d38117"
    },
    {
      "baseHexagramNumber": 11,
      "changedHexagramNumber": 14,
      "sourceEntryNumber": 14,
      "sourceIconHexagramNumber": 14,
      "hexagramName": "大有",
      "poemText": "生值地乳，上皇大喜。賜我福祉，壽算無極。賓于作命。",
      "sourceParagraphSha256": "sha256:bae5e1d68ef5a4bfdd6a3fb855a90f61f209350263046a397df9c9e3abc154db",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:9118b1b384c9871020a550a9424267d1a2276200eeb8769ce719cad83b00eed9"
    },
    {
      "baseHexagramNumber": 11,
      "changedHexagramNumber": 15,
      "sourceEntryNumber": 15,
      "sourceIconHexagramNumber": 15,
      "hexagramName": "謙",
      "poemText": "翕翕，隕墜山顛。滅我令名，長沒不存。",
      "sourceParagraphSha256": "sha256:8e6fb79964c8db38fddb4e834dcc5b4e2301cbbf1421fc709e7cd24b4bd22b89",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:8719e82b4853b434776208d5f1411a0b40df04ada9d14a61a0a43c65c97fef51"
    },
    {
      "baseHexagramNumber": 11,
      "changedHexagramNumber": 16,
      "sourceEntryNumber": 16,
      "sourceIconHexagramNumber": 16,
      "hexagramName": "豫",
      "poemText": "東鄰嫁女，為王妃后。莊公築館，以尊主母。歸于京師，季姜喜悅。",
      "sourceParagraphSha256": "sha256:5e79be4a2f06458de7e41170a0fa8e90da6b24d4198781074024039503351f8d",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:c40b573af4c41f3b5800fbc4c64b88c1694387e986b13ba4ddccda257d0700b5"
    },
    {
      "baseHexagramNumber": 11,
      "changedHexagramNumber": 17,
      "sourceEntryNumber": 17,
      "sourceIconHexagramNumber": 17,
      "hexagramName": "隨",
      "poemText": "伯虎仲熊，德義淵閎。使布五教，陰陽順序。",
      "sourceParagraphSha256": "sha256:cfad6850f9c1159331b66e5d77afe931aad42f342d525c91f0e6e11fd75b5d7f",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:e7c4c705452513feaede52b696ff93b6dd36c151378b7829927589d16b3d63b0"
    },
    {
      "baseHexagramNumber": 11,
      "changedHexagramNumber": 18,
      "sourceEntryNumber": 18,
      "sourceIconHexagramNumber": 18,
      "hexagramName": "蠱",
      "poemText": "敏教勁疾，如猿升木。彤弓雖調，終不能獲。",
      "sourceParagraphSha256": "sha256:642f5fc41269a56625ab45c462bbed30cd5aa8852464394b6185b7fcb621acba",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:718e63ebbfe1d3b41a393d628f3f0f4ec9779438e281c1ba643d998821898612"
    },
    {
      "baseHexagramNumber": 11,
      "changedHexagramNumber": 19,
      "sourceEntryNumber": 19,
      "sourceIconHexagramNumber": 19,
      "hexagramName": "臨",
      "poemText": "舉袂覆目，不見日月。衣裘簟席，就長夜室。",
      "sourceParagraphSha256": "sha256:2bd6dada11ef8f8f9d1acae3a5270f6d338622ff1fa4bda9c5043ae93a02d102",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:db095e29699a004b0116a852478f315dc29790c1dd95323e7553f78e71023796"
    },
    {
      "baseHexagramNumber": 11,
      "changedHexagramNumber": 20,
      "sourceEntryNumber": 20,
      "sourceIconHexagramNumber": 20,
      "hexagramName": "觀",
      "poemText": "忍醜少羞，無面有頭。耗減寡虛，日以削消。",
      "sourceParagraphSha256": "sha256:565b0fd30fb4112458a244ef89e3aeb95158137b3f7d99a7a1c5b7d460757f49",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:c08a80eac4df464f4de6fdac49bf31db367735491ec8d1c52905386a3069b600"
    },
    {
      "baseHexagramNumber": 11,
      "changedHexagramNumber": 21,
      "sourceEntryNumber": 21,
      "sourceIconHexagramNumber": 21,
      "hexagramName": "噬嗑",
      "poemText": "固陰沍寒，常冰不溫，令人墮怠。庖火為災，電火為蕃。",
      "sourceParagraphSha256": "sha256:722ba96fc0c009676b472f1608d774676b3e562757b8f133d255a14f0c619e3c",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:7521f84319bcdaac22faedf54f2224b00841670c598a110f18010d41a66de0e4"
    },
    {
      "baseHexagramNumber": 11,
      "changedHexagramNumber": 22,
      "sourceEntryNumber": 22,
      "sourceIconHexagramNumber": 22,
      "hexagramName": "賁",
      "poemText": "夏麥麩 ，霜擊其芒。疾君敗國，使我夭傷。",
      "sourceParagraphSha256": "sha256:6fbce336e51b74d1372e0c45e207ee01ac03d88974d725c5cf1f246c534379c4",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:4d8a7a85bbdfdb3edbc313eac9ca50001fe243c4f7f5adaf7468e06e465de65e"
    },
    {
      "baseHexagramNumber": 11,
      "changedHexagramNumber": 23,
      "sourceEntryNumber": 23,
      "sourceIconHexagramNumber": 23,
      "hexagramName": "剝",
      "poemText": "淵涸龍憂，箕子為奴。干叔隕命，殷破其家。",
      "sourceParagraphSha256": "sha256:0bd720588054168d7d121d71ca299834ade2ea1f00042fe31bcd23ccebf27e3d",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:be54240e281b3e4961838997cdff4f40fc6ab4e3191fbff8022f06b1c4407fe3"
    },
    {
      "baseHexagramNumber": 11,
      "changedHexagramNumber": 24,
      "sourceEntryNumber": 24,
      "sourceIconHexagramNumber": 24,
      "hexagramName": "復",
      "poemText": "跛踦相隨，日暮牛罷。陵遲後旅，失利亡雌。",
      "sourceParagraphSha256": "sha256:6b8076a9628a8d79d4c493e776188bb76e1f38ba55d0f05c4056f7396ce61128",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:095b7fb7675a591a34da18a59e826c06bfd2ebeeda96b63a9251140d9dd18bda"
    },
    {
      "baseHexagramNumber": 11,
      "changedHexagramNumber": 25,
      "sourceEntryNumber": 25,
      "sourceIconHexagramNumber": 25,
      "hexagramName": "无妄",
      "poemText": "桑方將落，隕其黃葉。失勢傾倒，如無所立。",
      "sourceParagraphSha256": "sha256:10e3de424c02ea5e94e7b060e8f305222b05ef711725162eae9056b10364e34a",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:05d5612b46f011ca42d469172cedb1bb2418d972a1ea46cd54189451c47b6c42"
    },
    {
      "baseHexagramNumber": 11,
      "changedHexagramNumber": 26,
      "sourceEntryNumber": 26,
      "sourceIconHexagramNumber": 26,
      "hexagramName": "大畜",
      "poemText": "長生以時，長柱根本。陰陽相和，歲樂無憂。",
      "sourceParagraphSha256": "sha256:feb0740bf6e18df1771f25eb496e256f9f5231fd485ea676aaed16757a3a2338",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:23bd7aabdcf7a8449b5457696c09d804dc769ab7307e3b6f331a1cb8b175dec1"
    },
    {
      "baseHexagramNumber": 11,
      "changedHexagramNumber": 27,
      "sourceEntryNumber": 27,
      "sourceIconHexagramNumber": 27,
      "hexagramName": "頤",
      "poemText": "童女無室，未有配合。陰陽不和，空坐獨宿。",
      "sourceParagraphSha256": "sha256:37d79bf1cc3279b7086dabc278d74818fca7d5791c23f5404faa75d8b07d3cce",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:08324c032a9333d4ad12f33bdfa6e9d67ff6e27ee644153ec9a9f740b7777377"
    },
    {
      "baseHexagramNumber": 11,
      "changedHexagramNumber": 28,
      "sourceEntryNumber": 28,
      "sourceIconHexagramNumber": 28,
      "hexagramName": "大過",
      "poemText": "春令原宥，仁德不周。三聖攸同，周國茂興。",
      "sourceParagraphSha256": "sha256:b8e3be69cdf32ff4c1d5a58e1f9f436c4ad06c9cae791fb204b9c8384e5e406b",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:49f5de64ec482e173706f6ac7a9f8f7cbaa196d8d015f1b64f2184fe58edee43"
    },
    {
      "baseHexagramNumber": 11,
      "changedHexagramNumber": 29,
      "sourceEntryNumber": 29,
      "sourceIconHexagramNumber": 29,
      "hexagramName": "坎",
      "poemText": "金精躍怒，帶劍過午。兩虎相妒，雖驚不咎。",
      "sourceParagraphSha256": "sha256:fbe25ea3db297ce2e9c37e61a80dea5f3425d4dba506f9a5fd419b1eac68d170",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:b904140ee96c65ec7a154a8256083c5c62fac2e6c02f36aca12d98795fee6b66"
    },
    {
      "baseHexagramNumber": 11,
      "changedHexagramNumber": 30,
      "sourceEntryNumber": 30,
      "sourceIconHexagramNumber": 30,
      "hexagramName": "離",
      "poemText": "危坐至暮，謀求不得。膏澤不降，政戾民忒。",
      "sourceParagraphSha256": "sha256:5db9642e9c086843817bf8eeaeba0f54c229bb9d63f6edc00abeed7ebb49c782",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:9d5688dbce5ffbb28d6bc35c87d4b6e42725b20196c3df53076d7de5821549d2"
    },
    {
      "baseHexagramNumber": 11,
      "changedHexagramNumber": 31,
      "sourceEntryNumber": 31,
      "sourceIconHexagramNumber": 31,
      "hexagramName": "咸",
      "poemText": "老楊日衰，條多枯枝。爵級不進，日下摧頹。",
      "sourceParagraphSha256": "sha256:69dfaee7d44d0dd3e1c31f7cd6815cf08103a85527cefbad98b5215b94751365",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:7314d72a6df5a165dcecda3999725930867544b20f74504a2117335186dd7c8c"
    },
    {
      "baseHexagramNumber": 11,
      "changedHexagramNumber": 32,
      "sourceEntryNumber": 32,
      "sourceIconHexagramNumber": 32,
      "hexagramName": "恒",
      "poemText": "蔡侯適楚，留連江湖。踰日歷月，思其后君。",
      "sourceParagraphSha256": "sha256:39b38e6efc677ce1c3252051f5685a2fae4f0641a2f0c3b903bd27c5f128425a",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:0649718369ebafd8d6833897a893be262349db4a9ccb948b54d05a745e3a6c4b"
    },
    {
      "baseHexagramNumber": 11,
      "changedHexagramNumber": 33,
      "sourceEntryNumber": 33,
      "sourceIconHexagramNumber": 33,
      "hexagramName": "遯",
      "poemText": "右撫劍佩，左援勾帶。凶訟不止，相與爭戾。失利市肆。",
      "sourceParagraphSha256": "sha256:0d1c181046460bab2520e24e6fc35c8d8a6b8407b3a3126578d52a43bd0620a9",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:e2798caca6c981564d5a60e72c73097abc801c5becf591bd128b0039c83c7221"
    },
    {
      "baseHexagramNumber": 11,
      "changedHexagramNumber": 34,
      "sourceEntryNumber": 34,
      "sourceIconHexagramNumber": 34,
      "hexagramName": "大壯",
      "poemText": "水流趨下，遠至東海。求我所有，買鮪得鯉。訟之比）",
      "sourceParagraphSha256": "sha256:059ff07865afc36f56c75172867b6335ad590ebce5f50da4f34cb07eab329216",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:2ce0410f43bed3af2211fdb84bce028f7dd7d1d0384ff27472512230804b603c"
    },
    {
      "baseHexagramNumber": 11,
      "changedHexagramNumber": 35,
      "sourceEntryNumber": 35,
      "sourceIconHexagramNumber": 35,
      "hexagramName": "晉",
      "poemText": "登几上輿，駕駟南遊。合縱散衡，燕秦治強。",
      "sourceParagraphSha256": "sha256:dd283970e28a6d76aa1ecec106e365fb6403009821b45818627946f04fca2533",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:54bb3da917a64a2a00559c33bd2d96adc3addc579f531422d60d25c2fccdf3b5"
    },
    {
      "baseHexagramNumber": 11,
      "changedHexagramNumber": 36,
      "sourceEntryNumber": 36,
      "sourceIconHexagramNumber": 36,
      "hexagramName": "明夷",
      "poemText": "求兔得獐，過其所望。歡以相迎，高位夷傷。",
      "sourceParagraphSha256": "sha256:b942937a043d3eb218a3999a3db809da87729526e32955c1f0ad4a8280e35210",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:052d2477b0d867a847561159d488dfd153a954402a633f6d4673abc584e060c9"
    },
    {
      "baseHexagramNumber": 11,
      "changedHexagramNumber": 37,
      "sourceEntryNumber": 37,
      "sourceIconHexagramNumber": 37,
      "hexagramName": "家",
      "poemText": "人家人） 過時不歸，道遠且迷。旅人心悲，使我徘徊。",
      "sourceParagraphSha256": "sha256:6ded7d8e1faeca0d1dcb5aa5e23a2e3a2277d4295f14e842e0460361b53bb734",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:37d410837a3a5590ab5514f408bd2bca2d0350a5d77b48d786ca5eb279218867"
    },
    {
      "baseHexagramNumber": 11,
      "changedHexagramNumber": 38,
      "sourceEntryNumber": 38,
      "sourceIconHexagramNumber": 38,
      "hexagramName": "睽",
      "poemText": "魂孤無室，御宿舍食。盜張民潰，見敵失內。",
      "sourceParagraphSha256": "sha256:2784bd49e99c67a6b2c723fd13ec93ef6ea53a80b79a87f5a31098eb7b504e68",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:70492d7c33052cd469366a9c42b69f7022cd2de5e3cedc13e8d8aa84d11aeb91"
    },
    {
      "baseHexagramNumber": 11,
      "changedHexagramNumber": 39,
      "sourceEntryNumber": 39,
      "sourceIconHexagramNumber": 39,
      "hexagramName": "蹇",
      "poemText": "居如轉丸，危不得安。東西不寧，動生憂患。",
      "sourceParagraphSha256": "sha256:abe3447687e7670d2aa0ab70b0995f93952a09c9d1416eb4507438c199e66c57",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:55378239c7b0898bf7d2d57069953de5ca14eecb226e23f6e744511486b25625"
    },
    {
      "baseHexagramNumber": 11,
      "changedHexagramNumber": 40,
      "sourceEntryNumber": 40,
      "sourceIconHexagramNumber": 40,
      "hexagramName": "解",
      "poemText": "坤厚地載，庶物蕃息。平康正直，以綏百福。",
      "sourceParagraphSha256": "sha256:37f52d0e5d6ad199d17c478616d867e4d5ee3526e2c57269ebaaecda1d5aaa8f",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:c71d5d4a98c5794b0579f167bd7912aa0369ad361f28b1ff756994a6bbd65e75"
    },
    {
      "baseHexagramNumber": 11,
      "changedHexagramNumber": 41,
      "sourceEntryNumber": 41,
      "sourceIconHexagramNumber": 41,
      "hexagramName": "損",
      "poemText": "冽敝牡荊，生賢止侮。讎敵背憎，孰肯相迎。上下有眚。",
      "sourceParagraphSha256": "sha256:7e684f7accb6c536145517f7e50001965f260dbc279c6e50464ecece49508c51",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:cf453ccd67d348dab229cab6bf885ebb0db40369453a00afc245ca340ac8cc75"
    },
    {
      "baseHexagramNumber": 11,
      "changedHexagramNumber": 42,
      "sourceEntryNumber": 42,
      "sourceIconHexagramNumber": 42,
      "hexagramName": "益",
      "poemText": "鳳凰御書，元珪賜我。封為晉侯。",
      "sourceParagraphSha256": "sha256:73337ac851cce5f949e846c1aa7708b94c0698f01c8d9bfab1f2cc8537a4536c",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:be03f80abbd5e63bdb0c544fb7c40b84d55733e97877c6a513b253df6fb80f4e"
    },
    {
      "baseHexagramNumber": 11,
      "changedHexagramNumber": 43,
      "sourceEntryNumber": 43,
      "sourceIconHexagramNumber": 43,
      "hexagramName": "夬",
      "poemText": "作凶不善，相牽入井。溺陷辜罪，禍生憂滋。",
      "sourceParagraphSha256": "sha256:fff24438921e89a88f3da7109cc9865c3bb5e218063a75e2b191cb7130038dc3",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ea750bb453746934752f8cfca8bee3edc1515d09d3e27b67afa7ef7e26dfb040"
    },
    {
      "baseHexagramNumber": 11,
      "changedHexagramNumber": 44,
      "sourceEntryNumber": 44,
      "sourceIconHexagramNumber": 44,
      "hexagramName": "姤",
      "poemText": "悲鳴北行，失其長兄。伯仲不幸，骸骨敗亡。",
      "sourceParagraphSha256": "sha256:9dd78e4e3177dab90a833060e7df4fa1e5ec65274efc742966930e732ce8b381",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:60b931bae751827db8ed96beaeea8dfe7d9acd970efaab5869ac3b62fe60cf38"
    },
    {
      "baseHexagramNumber": 11,
      "changedHexagramNumber": 45,
      "sourceEntryNumber": 45,
      "sourceIconHexagramNumber": 45,
      "hexagramName": "萃",
      "poemText": "羔衣豹裘，高易我宇。君子維新。",
      "sourceParagraphSha256": "sha256:81ba55b77794e691f8cf37b27ac65e0e91002a688785079fbb73efc7b3aaf62d",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:6428c4827af817bbacba1d095201e1a6a5903a0b6e41edaf030859a9f683b2dc"
    },
    {
      "baseHexagramNumber": 11,
      "changedHexagramNumber": 46,
      "sourceEntryNumber": 46,
      "sourceIconHexagramNumber": 46,
      "hexagramName": "升",
      "poemText": "日中為市，各抱所有。交易貨貲，含珠懷寶。心悅歡喜。",
      "sourceParagraphSha256": "sha256:a52d08366e953eba1cbf89942354d0fc98a15f4f3f465d25d5a939619b61ff87",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:6a456e654a3ed4f202fb75dfc7a8436fcb1f7bce7157e3193a2dfb1c5142009b"
    },
    {
      "baseHexagramNumber": 11,
      "changedHexagramNumber": 47,
      "sourceEntryNumber": 47,
      "sourceIconHexagramNumber": 47,
      "hexagramName": "困",
      "poemText": "振急絕理，恆陽不雨。物病焦乾，華實無有。",
      "sourceParagraphSha256": "sha256:0748f710d7e492b335e9b17f9e3e0f9a2269234bd05920b92782a5df95a2ddd1",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:e2f72c319d9ef3fb0979d718d06cb55bab8b34cb2d9b86bd617926de149281f2"
    },
    {
      "baseHexagramNumber": 11,
      "changedHexagramNumber": 48,
      "sourceEntryNumber": 48,
      "sourceIconHexagramNumber": 48,
      "hexagramName": "井",
      "poemText": "狐貉載剝，凌溫翠蓐。寒棘為疾，何所不足。",
      "sourceParagraphSha256": "sha256:70932d3c7a4ee0a91dbdf83a117f1d0b163a687dd1f9ad587cbab7e7df7d440b",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:32ca7d0550324d0a3a67d1db538a821f6bb976a3ad4b472958c7faea22af6524"
    },
    {
      "baseHexagramNumber": 11,
      "changedHexagramNumber": 49,
      "sourceEntryNumber": 49,
      "sourceIconHexagramNumber": 49,
      "hexagramName": "革",
      "poemText": "履踐危難，脫執去患。入福喜門，見誨大君。",
      "sourceParagraphSha256": "sha256:c1f7129530fd262d51c9deb8891783423e5c3d1415b872dc6e5ca6d3be4e7081",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:fc424fe6120f092abcaab762578115a0aa185c98137c9549a353476a558849c4"
    },
    {
      "baseHexagramNumber": 11,
      "changedHexagramNumber": 50,
      "sourceEntryNumber": 50,
      "sourceIconHexagramNumber": 50,
      "hexagramName": "鼎",
      "poemText": "四亂不安，東西為患。退止我足，無出國城。乃得全完，賴其生福。",
      "sourceParagraphSha256": "sha256:82cff25f3e9229d5eb10d52939548fc597b114ccf6e875cffab0e2602ed95389",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:d2158535875f7bc7688fb6cca4fdbbfddc5c12a9c99d134bf7e2fb20e845d94d"
    },
    {
      "baseHexagramNumber": 11,
      "changedHexagramNumber": 51,
      "sourceEntryNumber": 51,
      "sourceIconHexagramNumber": 51,
      "hexagramName": "震",
      "poemText": "南國少子，才略美好。求我長女，賤薄不與。反得醜惡，後乃大悔。",
      "sourceParagraphSha256": "sha256:4d05483950a65c419274f41ad00187b5755bc1bab850dc96267c93556a0cf383",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:9c4d8488261a4bce7d864210320c617c2f4ce1b60340ab3a8ecee13d5d36b382"
    },
    {
      "baseHexagramNumber": 11,
      "changedHexagramNumber": 52,
      "sourceEntryNumber": 52,
      "sourceIconHexagramNumber": 52,
      "hexagramName": "艮",
      "poemText": "妄怒失理，陽孤無輔。物病焦枯，年饑於黍。",
      "sourceParagraphSha256": "sha256:84845f708031b8797029618639c7d8a08ab146f40b3238ae6e2aec1c190e68cc",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:882abf38e16711f6cd58847bb7dd900aec7ca03399089740fc9d90f5dcb08a5f"
    },
    {
      "baseHexagramNumber": 11,
      "changedHexagramNumber": 53,
      "sourceEntryNumber": 53,
      "sourceIconHexagramNumber": 53,
      "hexagramName": "漸",
      "poemText": "倬然遠咎，辟害早阜。田獲三狐，巨貝為寶。",
      "sourceParagraphSha256": "sha256:6b0d964df309f0aebc030bb811c21d72f0b501aeecdb86309202e19193243fe6",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:41497c59776c2a5b30e8fe213805669ad13cc9cdc434df76393f26309de4ab9c"
    },
    {
      "baseHexagramNumber": 11,
      "changedHexagramNumber": 54,
      "sourceEntryNumber": 54,
      "sourceIconHexagramNumber": 54,
      "hexagramName": "歸妹",
      "poemText": "逐鹿山巔，利去我西。雖祁南北，無所不得。",
      "sourceParagraphSha256": "sha256:76797834e50a71f86a290db5f009303a8a554e4428f256f069bbfd9ba77004b6",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:5a52bce3cba974439494eed0c71456e93f26d90482c075d1498c0f6c43090904"
    },
    {
      "baseHexagramNumber": 11,
      "changedHexagramNumber": 55,
      "sourceEntryNumber": 55,
      "sourceIconHexagramNumber": 55,
      "hexagramName": "豐",
      "poemText": "龍蛇所聚，大水樂處。滑滑沛沛，使我無賴。",
      "sourceParagraphSha256": "sha256:3fccfad5d3211ecbef148e529f21b6b9ceda074cca8c40ced4596c3f80a0a820",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:17a50f23bf3d924418d4006fffc1fe9fa03b22cdb1380eaa4d725dfdb46fb35e"
    },
    {
      "baseHexagramNumber": 11,
      "changedHexagramNumber": 56,
      "sourceEntryNumber": 56,
      "sourceIconHexagramNumber": 56,
      "hexagramName": "旅",
      "poemText": "從風吹火，牽騏驥尾。易為之功，因摧受福。",
      "sourceParagraphSha256": "sha256:dee5dcbf935077bbe14ed852e6ee3f933b7ffa024ccda4b408101198ae78e67e",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:4c2502b9a62e2ade00dc7b156f0155345414e41b2b346380836d62259fa6fe46"
    },
    {
      "baseHexagramNumber": 11,
      "changedHexagramNumber": 57,
      "sourceEntryNumber": 57,
      "sourceIconHexagramNumber": 57,
      "hexagramName": "巽",
      "poemText": "澤狗水鳧，難畜少雛。不為家饒，心其亟逋。",
      "sourceParagraphSha256": "sha256:da117af2fcb4e3c38b962f7a87aaacb9a93f324402c55847697311384789f3ec",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:0825caca4d494220cfa5e005084594e583b7d614d832f8a0e5511ec0d0f6e78b"
    },
    {
      "baseHexagramNumber": 11,
      "changedHexagramNumber": 58,
      "sourceEntryNumber": 58,
      "sourceIconHexagramNumber": 58,
      "hexagramName": "兌",
      "poemText": "水壞我里，東流為海。龜鳧驩囂，不見慈母。",
      "sourceParagraphSha256": "sha256:30664672f446d40320c7812fc5d0638a124fba1c1824856b4f48bf52b5ab2554",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:f860cf904efb130990dacad684a4c0bc70ee244a0f6ebb86874443febecd8679"
    },
    {
      "baseHexagramNumber": 11,
      "changedHexagramNumber": 59,
      "sourceEntryNumber": 59,
      "sourceIconHexagramNumber": 59,
      "hexagramName": "渙",
      "poemText": "褰衣涉水，深漬請罷。賴幸舟者，濟脫無他。",
      "sourceParagraphSha256": "sha256:eb066e4fe0bf8288777cb5a2fe85b72e7fd0d1df15c262a431cf71c489a90a9c",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:25be78c257ed0b3f07fb10252313d1c5b53425216a97a35e20577441435bdc43"
    },
    {
      "baseHexagramNumber": 11,
      "changedHexagramNumber": 60,
      "sourceEntryNumber": 60,
      "sourceIconHexagramNumber": 60,
      "hexagramName": "節",
      "poemText": "龜戢河海，陸行不止。自令枯槁，失其都市。憂害無咎。",
      "sourceParagraphSha256": "sha256:fd476a9352a7bb34654c9d8f35377d5430f30f6b027e335cbf8940b1f36211ec",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:1bc91dda6248f7a1a3cc4fe201806a8c911aea99a911a0b3bab140b20c088fca"
    },
    {
      "baseHexagramNumber": 11,
      "changedHexagramNumber": 61,
      "sourceEntryNumber": 61,
      "sourceIconHexagramNumber": 61,
      "hexagramName": "中孚",
      "poemText": "同本異葉，樂仁正德。東鄰慕義，來興我國。",
      "sourceParagraphSha256": "sha256:fd01225bb693bc072d5f5667c583d564282040c16f4f3bbf087b9508c7922366",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:596d807ed07f19583e301e1a84dddd09a6674dca2e18c86b784dc9be5c9e8ba0"
    },
    {
      "baseHexagramNumber": 11,
      "changedHexagramNumber": 62,
      "sourceEntryNumber": 62,
      "sourceIconHexagramNumber": 62,
      "hexagramName": "小過",
      "poemText": "桃李花實，纍纍日息。長大成熟，甘美可食。為我利福。",
      "sourceParagraphSha256": "sha256:f1918d1429ebc047558d82d3717ad3741fb14ca2ddc5b401594ffb5fab90a96f",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:f31cd703e969abb43197900d0206e8042c0ab801f63577a6103690730c296cb4"
    },
    {
      "baseHexagramNumber": 11,
      "changedHexagramNumber": 63,
      "sourceEntryNumber": 63,
      "sourceIconHexagramNumber": 63,
      "hexagramName": "既濟",
      "poemText": "重瞳四乳，聰明順理。無隱不形，微視千里。災害不作，君子集聚。",
      "sourceParagraphSha256": "sha256:597339641487ab8dedcd06995528897c557a502cac2b0d6e27739f460a2e47d7",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:8f4a3bc840869b6a7f39c6be08dddc7e23d434c8c2602be5273fd8db76bb0b9d"
    },
    {
      "baseHexagramNumber": 11,
      "changedHexagramNumber": 64,
      "sourceEntryNumber": 64,
      "sourceIconHexagramNumber": 64,
      "hexagramName": "未濟",
      "poemText": "實沈參墟，以義討尤。次止結盟，以成霸功。",
      "sourceParagraphSha256": "sha256:b8d63acc0eb6f15338b37cb37d41ac5503ba3a692dc99a62fa5e9b0c9ab70d07",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:1b33d35fbd9705128de02a7c09150ae3087e1db6bc669c634f4fcc6de7639721"
    }
  ]
}
