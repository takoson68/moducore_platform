  "entryCount": 64,
  "missingTargets": [],
  "entries": [
    {
      "baseHexagramNumber": 58,
      "changedHexagramNumber": 58,
      "sourceEntryNumber": 58,
      "sourceIconHexagramNumber": 58,
      "hexagramName": "兌",
      "poemText": "班馬還師，以息勞疲。役夫嘉言，入戶見妻。",
      "sourceParagraphSha256": "sha256:664b47721ccc814807effc112feeadb83afd1487242c7a96250abc09c9cbb6bb",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:a8d85925c818d6ae78cce0fb576724b93901c15bea61926ee4072a293d79f3ba"
    },
    {
      "baseHexagramNumber": 58,
      "changedHexagramNumber": 1,
      "sourceEntryNumber": 1,
      "sourceIconHexagramNumber": 1,
      "hexagramName": "乾",
      "poemText": "踐履危難，脫去厄患。入福嘉門，見誨大君。",
      "sourceParagraphSha256": "sha256:05769b3dc916d0c9d47cd6111beb9c314e7e7983e7ac7c002ef21209cd6ee1b9",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:587d52ac78534b02f264a384581b0ef2cc611c1d4e1c6536327c888aca23385a"
    },
    {
      "baseHexagramNumber": 58,
      "changedHexagramNumber": 2,
      "sourceEntryNumber": 2,
      "sourceIconHexagramNumber": 2,
      "hexagramName": "坤",
      "poemText": "子鉏執麟，春秋作經。元聖將終，尼父悲心。",
      "sourceParagraphSha256": "sha256:2f10bf7347a3cd56be9a19f848917610ad71d1c8374e7ed0befc604d1b236124",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:bf65933fbe73ea50a7302a68428c6611a9120fae42f611a36d5a787aed75bffa"
    },
    {
      "baseHexagramNumber": 58,
      "changedHexagramNumber": 3,
      "sourceEntryNumber": 3,
      "sourceIconHexagramNumber": 3,
      "hexagramName": "屯",
      "poemText": "夾河為婚，期至無船。婬心失望，不見所歡。",
      "sourceParagraphSha256": "sha256:3cb5c41eeadf31b25dd38e6dd67339799608096d45d062e16c4fb596a5069175",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:64452f016e8617577bdc8ab95b9e0268de9e2ecd038bf85e6112afc238e49d7c"
    },
    {
      "baseHexagramNumber": 58,
      "changedHexagramNumber": 4,
      "sourceEntryNumber": 4,
      "sourceIconHexagramNumber": 4,
      "hexagramName": "蒙",
      "poemText": "天孫帝子，與日月處。光榮於世，福祿繁祉。",
      "sourceParagraphSha256": "sha256:8cf5e12fd750c25ea22d615f9240fd634b083159846a7c260359715662f6ac10",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:c66325bc2cfd43ea64d271b8fd6a7f4f136908fa055774109fcdeef58207936d"
    },
    {
      "baseHexagramNumber": 58,
      "changedHexagramNumber": 5,
      "sourceEntryNumber": 5,
      "sourceIconHexagramNumber": 5,
      "hexagramName": "需",
      "poemText": "三年爭妻，相隨奔馳。終日不食，精氣勞疲。",
      "sourceParagraphSha256": "sha256:fe5bc81546a6747312d0b89d36d66c393fef81dbebfe6b3e1f3be58f1796d3e6",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:adbddb8b6a20c8220b9390b30c4392885e63bf25ed6fd4a58618e6752a724e1a"
    },
    {
      "baseHexagramNumber": 58,
      "changedHexagramNumber": 6,
      "sourceEntryNumber": 6,
      "sourceIconHexagramNumber": 6,
      "hexagramName": "訟",
      "poemText": "禹召諸神，會稽南山。執玉萬國，天下安寧。",
      "sourceParagraphSha256": "sha256:3237093f332acb06cf1e0d394953a431037ab7deb5f8997722ce3eabe233ca06",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:856d7c30dfd7e424c72429ac9700aa75de64e9bdebcd720e4ba079affd21989d"
    },
    {
      "baseHexagramNumber": 58,
      "changedHexagramNumber": 7,
      "sourceEntryNumber": 7,
      "sourceIconHexagramNumber": 7,
      "hexagramName": "師",
      "poemText": "早霜晚雪，傷害禾麥。損功棄力，飢無所食。",
      "sourceParagraphSha256": "sha256:fc8b3531cb1799264b62471afdb31c321d5b3867ae600eea23bc9f66f2a617e9",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:80ba30f4220bcde4f9cb37677c8464535e80be4194ad2fafdd9f43a911f0ad35"
    },
    {
      "baseHexagramNumber": 58,
      "changedHexagramNumber": 8,
      "sourceEntryNumber": 8,
      "sourceIconHexagramNumber": 8,
      "hexagramName": "比",
      "poemText": "嵩融持戟，杜伯荷弩。降觀下國，誅逐無道。憂商之季，失福逃走",
      "sourceParagraphSha256": "sha256:5ec673c9fdac29147e22d83648dc08a2d8be66070a682e8a2553bd2ef6616424",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:1110e9700afc27e49f99d7a26e90e0b7b4ccb34bfeaee6bab039b1d8e618ee1c"
    },
    {
      "baseHexagramNumber": 58,
      "changedHexagramNumber": 9,
      "sourceEntryNumber": 9,
      "sourceIconHexagramNumber": 9,
      "hexagramName": "小畜",
      "poemText": "生有聖德，上配太極。皇靈建中，受我以福。",
      "sourceParagraphSha256": "sha256:aaed6a29f7e064657e889ac92e05510af66bfc9bd40ee6e6b471ceaa560e0e00",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:06c1e5e9ea5a532508da373225f09340897b2dddf7e6fb71aac139b9e86c6874"
    },
    {
      "baseHexagramNumber": 58,
      "changedHexagramNumber": 10,
      "sourceEntryNumber": 10,
      "sourceIconHexagramNumber": 10,
      "hexagramName": "履",
      "poemText": "下田陸黍，萬華生齒。大雨霖集，波病漬腐。",
      "sourceParagraphSha256": "sha256:9715c8a6161aa8bef08b149e8d35e36c1add881a418565d9bb94aabbd12b1b10",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:179a0e7d28f9a4e984a1f25667f21e7e53246e926c1343850d72aae151a0cb53"
    },
    {
      "baseHexagramNumber": 58,
      "changedHexagramNumber": 11,
      "sourceEntryNumber": 11,
      "sourceIconHexagramNumber": 11,
      "hexagramName": "泰",
      "poemText": "子畏於匡，困厄陳蔡。明德不危，竟克免害。",
      "sourceParagraphSha256": "sha256:f40cb3d984e46fe0faaf9a4713a2a862ce3db620dd2cddd10a0e285d1870e932",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ab70749039b675e6ea36d90e0548628a7722bf3e1bced0f3cd2c764e915ef9f7"
    },
    {
      "baseHexagramNumber": 58,
      "changedHexagramNumber": 12,
      "sourceEntryNumber": 12,
      "sourceIconHexagramNumber": 12,
      "hexagramName": "否",
      "poemText": "有兩赤頭，從五岳遊。淫言無祐，趍爾之林。俯伏聽命，不敢動搖。",
      "sourceParagraphSha256": "sha256:a73e655f334a502c9568867e0d2285d5f2fb6a3e400ff84f65d0e33ae1bb479f",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:f1d72f754e9ac36f8794055166b66a409f4a677382436ba398a50b067d40430e"
    },
    {
      "baseHexagramNumber": 58,
      "changedHexagramNumber": 13,
      "sourceEntryNumber": 13,
      "sourceIconHexagramNumber": 13,
      "hexagramName": "同人",
      "poemText": "當得自知，不逢凶災。衰來復興，終得福來。",
      "sourceParagraphSha256": "sha256:c1a4e8f71998cb0ad42ee28a15405e769a9c26beaae4e93807e12b44108daaf9",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:dcbf5c1e9cf66dbd13aefb5de91cee4b0cdc19267161743cae8da6f910d6c4b2"
    },
    {
      "baseHexagramNumber": 58,
      "changedHexagramNumber": 14,
      "sourceEntryNumber": 14,
      "sourceIconHexagramNumber": 14,
      "hexagramName": "大有",
      "poemText": "朽根枯樹，華葉落去。卒降火焱，隨風僵仆。",
      "sourceParagraphSha256": "sha256:704072518bcd6cb4e260c949ebdb4613d859490778374af9c1c0b1558f1ddef9",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:54f4e4aeb8a6adaff6b5548a720eb03e923d077ce703a8111bff3c526dd7ddbf"
    },
    {
      "baseHexagramNumber": 58,
      "changedHexagramNumber": 15,
      "sourceEntryNumber": 15,
      "sourceIconHexagramNumber": 15,
      "hexagramName": "謙",
      "poemText": "葛生衍蔓，絺綌為願。家道篤厚，父兄悅喜。",
      "sourceParagraphSha256": "sha256:25dba3576214f5fe59821d7ad87604c2db504b7a4164c98d2771df2ed06efbca",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:78e56a7d32d9a6731b1ab6d4de803dd797dff1b3be5350d5db84a7fd530fe84e"
    },
    {
      "baseHexagramNumber": 58,
      "changedHexagramNumber": 16,
      "sourceEntryNumber": 16,
      "sourceIconHexagramNumber": 16,
      "hexagramName": "豫",
      "poemText": "東行求玉，反得弊石。名曰無直，字曰醜惡。眾所賤薄。",
      "sourceParagraphSha256": "sha256:20d9e124365eb6420b6e381cb01ce32b5b7202a32b83868a21ca53e5828e2f45",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:4c1e8a0b0e99e79e2c9d59289a631193bf57c1ffdfa15275a18d3551f903ee87"
    },
    {
      "baseHexagramNumber": 58,
      "changedHexagramNumber": 17,
      "sourceEntryNumber": 17,
      "sourceIconHexagramNumber": 17,
      "hexagramName": "隨",
      "poemText": "瞻白用弦，駑孱恐怯。任力隨身，如蝟見鵲。偃視怒腸，不敢拒格。",
      "sourceParagraphSha256": "sha256:e3e1b63a25050b067cbc49b18f1a46a8af739efe44d5b377f4bc89a459398abd",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:c08d603c9ea17d7f1fb1d4116a1fffcae356ae4bd93a1d8f66a058f71f9e1379"
    },
    {
      "baseHexagramNumber": 58,
      "changedHexagramNumber": 18,
      "sourceEntryNumber": 18,
      "sourceIconHexagramNumber": 18,
      "hexagramName": "蠱",
      "poemText": "瘡痍多病，宋公危殆。吳子巢門，無命失所。",
      "sourceParagraphSha256": "sha256:2ee6fe7378ebf75837e53ec749e8f26663fb73339b8ed424cad9cd78778d51bd",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:5d819709e8e6854630a3a2059219868baa7b802a69571ddb57b26040f5c066c1"
    },
    {
      "baseHexagramNumber": 58,
      "changedHexagramNumber": 19,
      "sourceEntryNumber": 19,
      "sourceIconHexagramNumber": 19,
      "hexagramName": "臨",
      "poemText": "東山西岳，會合俱食。為吳從送，以成恩福。",
      "sourceParagraphSha256": "sha256:08dbb684c85d622fe93dff39a66befafa71dc5924d47950b933973e38adbf6f9",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:29fa9ba4d4ff5e9e44f981ee63ab049f734d6fd9377ef282afd2b593506c296c"
    },
    {
      "baseHexagramNumber": 58,
      "changedHexagramNumber": 20,
      "sourceEntryNumber": 20,
      "sourceIconHexagramNumber": 20,
      "hexagramName": "觀",
      "poemText": "舞非其處，失節多悔，不合我意。",
      "sourceParagraphSha256": "sha256:c56c98c83b755d84e5d39c0d01233fe5d4e3a9ef6ccb2c3bcaf86386e8dbe658",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:b1e51c898fe2fc10f630c5d853551828ab19d6ef6827478844516a037fee233a"
    },
    {
      "baseHexagramNumber": 58,
      "changedHexagramNumber": 21,
      "sourceEntryNumber": 21,
      "sourceIconHexagramNumber": 21,
      "hexagramName": "噬嗑",
      "poemText": "南循汝水，伐樹斬枝。過時不遇，惄如周飢。",
      "sourceParagraphSha256": "sha256:f7398ae479a5ff37c6a446b0a0a87aad5a150dcc0df46b915f7eccf70571ec09",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:d95af77257af4febcf314b0cd52843d5d5b086f42d3d3da33ef9bf41576d1e83"
    },
    {
      "baseHexagramNumber": 58,
      "changedHexagramNumber": 22,
      "sourceEntryNumber": 22,
      "sourceIconHexagramNumber": 22,
      "hexagramName": "賁",
      "poemText": "公孫駕驪，載遊東齊。延陵說產，遺季紵衣。",
      "sourceParagraphSha256": "sha256:cceeeccb296213b2c1fb3b7660cf34748ab063a2a17af22cfed40e0c44372a00",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:e72fcdee01dd776b9f147e581355485782ef3b7f0f9ad018b3a56650899b90bf"
    },
    {
      "baseHexagramNumber": 58,
      "changedHexagramNumber": 23,
      "sourceEntryNumber": 23,
      "sourceIconHexagramNumber": 23,
      "hexagramName": "剝",
      "poemText": "乘輿八百，以明文德。踐土葵丘，齊魯受福。",
      "sourceParagraphSha256": "sha256:e3af709e33f6549fe80678c4c2b019e02f8326c2a763619e9080e2d16882c612",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:702c6df90e1c4bfe6c49a476f285bb1cc8b9a6fb0ca20bb8dd41289b7f1b4f81"
    },
    {
      "baseHexagramNumber": 58,
      "changedHexagramNumber": 24,
      "sourceEntryNumber": 24,
      "sourceIconHexagramNumber": 24,
      "hexagramName": "復",
      "poemText": "雄處弱水，雌在海邊。別離將食，哀悲於心。",
      "sourceParagraphSha256": "sha256:baa5be8b1cb31af58cd5a5e50666cd48874ebdf486d044c1701e3816ef70007e",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:bba7c61b4f279ff156290a4fedf9b7e76b3f502193649a50c7d516d6a486bc88"
    },
    {
      "baseHexagramNumber": 58,
      "changedHexagramNumber": 25,
      "sourceEntryNumber": 25,
      "sourceIconHexagramNumber": 25,
      "hexagramName": "无妄",
      "poemText": "結網得鮮，受福安坐，終無患禍。",
      "sourceParagraphSha256": "sha256:404b78f159005a412983ff7168345f8b60f81600fc93c4bfa051a1936e3aa148",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:cce432628f9d94ceb7e75b8a0b61ec3da8c31624fd3e9061c639f9918e5b1dee"
    },
    {
      "baseHexagramNumber": 58,
      "changedHexagramNumber": 26,
      "sourceEntryNumber": 26,
      "sourceIconHexagramNumber": 26,
      "hexagramName": "大畜",
      "poemText": "秋南春北，隨時休息。處和履中，無有憂凶。",
      "sourceParagraphSha256": "sha256:5369c1103e6315166f161e5ef30001b2a6ab7ad9756b3ce128fe3daa93fbd853",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:cab265ed3053d4083acb1a7f2e61ec27b28f221b81ec341e345a3e146f45f9ef"
    },
    {
      "baseHexagramNumber": 58,
      "changedHexagramNumber": 27,
      "sourceEntryNumber": 27,
      "sourceIconHexagramNumber": 27,
      "hexagramName": "頤",
      "poemText": "啟戶閉門，巡狩釋冤。夏臺羑里，湯文喜悅。",
      "sourceParagraphSha256": "sha256:0b03ce4896e7a7e5f4baf5c3729dd63f7ebd17ce5ca59598f55820ae3ba0baa2",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:655b7d90e860b91e899e42d2e772c9dd8de1aaa3dbce1f897cd30ccc779d6b87"
    },
    {
      "baseHexagramNumber": 58,
      "changedHexagramNumber": 28,
      "sourceEntryNumber": 28,
      "sourceIconHexagramNumber": 28,
      "hexagramName": "大過",
      "poemText": "符左契右，相與合屬。乾坤利貞，乳生六子。長大成就，夙言如母。",
      "sourceParagraphSha256": "sha256:979945add067666bb235afcc71f9f10a4e716a6d1c1d751c04e8d7b01023b07e",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:19cced0e3db3067d8752feee1a8d36bb0b0b1cc47c2a0a36e59617647744a84b"
    },
    {
      "baseHexagramNumber": 58,
      "changedHexagramNumber": 29,
      "sourceEntryNumber": 29,
      "sourceIconHexagramNumber": 29,
      "hexagramName": "坎",
      "poemText": "飢蠶作室，絲多亂緒，端不可得。",
      "sourceParagraphSha256": "sha256:476c486bc1ad6521534f0ff5399ec123b2b1d0c2d331bd79e204625795409911",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:5d9e7e5c296434ad7a779187a3c466f2307d14cc1e30157ebe586a023d8bac42"
    },
    {
      "baseHexagramNumber": 58,
      "changedHexagramNumber": 30,
      "sourceEntryNumber": 30,
      "sourceIconHexagramNumber": 30,
      "hexagramName": "離",
      "poemText": "東壁餘光，數暗不明。主母嫉妒，亂我事業。",
      "sourceParagraphSha256": "sha256:dadf54b29c49b195a54b233274f8373222e4e8b8639c92fc8c628b1db98bf284",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:d5c879c121134cad8dc515ed001bbae86235ce5cca5d9807e80f6e77eeda3c0e"
    },
    {
      "baseHexagramNumber": 58,
      "changedHexagramNumber": 31,
      "sourceEntryNumber": 31,
      "sourceIconHexagramNumber": 31,
      "hexagramName": "咸",
      "poemText": "白茅漉酒，靈巫拜禱。神嗜飲食，使君壽考。",
      "sourceParagraphSha256": "sha256:9b2fa19b5bef3dcac5b144152cf3e8b7c4bb7cbfb8e9f528e901a40019762712",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:9817dae8a43e6d6b9cb2d5497e921aa6b9d5a78715d48a83136e7e6e7c0fd5dd"
    },
    {
      "baseHexagramNumber": 58,
      "changedHexagramNumber": 32,
      "sourceEntryNumber": 32,
      "sourceIconHexagramNumber": 32,
      "hexagramName": "恒",
      "poemText": "范公陶朱，巧賈貨資。東之營丘，易字子皮。抱珠載金，多得利歸。",
      "sourceParagraphSha256": "sha256:b96d810b11b38bbb5ade70ec3129947e66cd0a08942cc5db819baa732c657caf",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:0feb50c62b1cea1b52e2f7614d1ec7578c96cc62002dce22067a03397244f8ad"
    },
    {
      "baseHexagramNumber": 58,
      "changedHexagramNumber": 33,
      "sourceEntryNumber": 33,
      "sourceIconHexagramNumber": 33,
      "hexagramName": "遯",
      "poemText": "三羖五牂，相隨俱行。迷入空澤，經涉虎廬。循谷直北，經涉六駁。為所傷賊，死於牙腹。",
      "sourceParagraphSha256": "sha256:54f9e24bbbb9ecda1fd708d0ebd95b1aec4ff75910f0ae03ae03179de8c7568f",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:3052d625048302de0fa13224c4fbe85b211550de430bcf22902c9408eee86502"
    },
    {
      "baseHexagramNumber": 58,
      "changedHexagramNumber": 34,
      "sourceEntryNumber": 34,
      "sourceIconHexagramNumber": 34,
      "hexagramName": "大壯",
      "poemText": "雄鵠延頸，欲飛入關。雨師洒道， 我袍裘。車重難前，侍者稽首。",
      "sourceParagraphSha256": "sha256:5c3bef25f61df755cccd11aa8131b8dc2e17657129a6d49846d253b8c9d2bc55",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:f619c924eaadd0014258dff4f77d6ac8d05c754318b74cb4536cde640340159e"
    },
    {
      "baseHexagramNumber": 58,
      "changedHexagramNumber": 35,
      "sourceEntryNumber": 35,
      "sourceIconHexagramNumber": 35,
      "hexagramName": "晉",
      "poemText": "中年蒙慶，今歲受福，必有所得。",
      "sourceParagraphSha256": "sha256:8d4b247550271008f8e40dfaac578d3a02caaacadb3e07d29e2650f6d5937995",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:93b1bdea631faaeb42935729062b6a82d2ad01e57dcafd479686fb63995db3a8"
    },
    {
      "baseHexagramNumber": 58,
      "changedHexagramNumber": 36,
      "sourceEntryNumber": 36,
      "sourceIconHexagramNumber": 36,
      "hexagramName": "明夷",
      "poemText": "祿如周公，建國洛東，父子俱封。革之明夷）",
      "sourceParagraphSha256": "sha256:5d582a1b28aaf967d0d7a4fbb9efda600f925a214a9d0900b5f42236a65f756f",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:06bc1e170a91ec3c849faa63a402eacb4bd115c9aa746a577b7b3c52e2461785"
    },
    {
      "baseHexagramNumber": 58,
      "changedHexagramNumber": 37,
      "sourceEntryNumber": 37,
      "sourceIconHexagramNumber": 37,
      "hexagramName": "家人",
      "poemText": "安床厚褥，不得久宿。棄我嘉讌，困於東國。投杼之憂，不成禍災。",
      "sourceParagraphSha256": "sha256:e9f3e1b1af095d6648d2aeaca30a2ccee67ea04dec19714f8a12fd5530c2f644",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:6c93a2fbfcb69fa55b655f65fa3880932d610c5b00812e22710014941569c5f9"
    },
    {
      "baseHexagramNumber": 58,
      "changedHexagramNumber": 38,
      "sourceEntryNumber": 38,
      "sourceIconHexagramNumber": 38,
      "hexagramName": "睽",
      "poemText": "蓄積有餘，糞土不居，利有所得。",
      "sourceParagraphSha256": "sha256:d60d8cbbba26bc9adbfb0c24ffb2d7fcc4b10b7d03c977ae1feaf16e2f7b0102",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:91f7bffdf96bc6286acbaf43960fee8fe1c1c85f4fc2b8c5e1d828fa93382f95"
    },
    {
      "baseHexagramNumber": 58,
      "changedHexagramNumber": 39,
      "sourceEntryNumber": 39,
      "sourceIconHexagramNumber": 39,
      "hexagramName": "蹇",
      "poemText": "心願所喜，乃今逢時。我得利福，不離兵革。",
      "sourceParagraphSha256": "sha256:bb5dce439ae3cf30aaf648157262abed0a89a28da9e4699a97a0a80b1951cc24",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:b85811921d0c37f327ea1e04785e9ac24d5cd6a9f34604bea52ca7a6d2b7cf33"
    },
    {
      "baseHexagramNumber": 58,
      "changedHexagramNumber": 40,
      "sourceEntryNumber": 40,
      "sourceIconHexagramNumber": 40,
      "hexagramName": "解",
      "poemText": "目不可合，憂來搔足。怵惕危懼，去其邦族。",
      "sourceParagraphSha256": "sha256:7f2b8e841d989b536b4c2b87413c4fb40ad96204d01cc052e37e951a15516b23",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:06a1d41434855ec02dc220f34a7b3a6f575f77602bb67a87cea7dffda7cf4894"
    },
    {
      "baseHexagramNumber": 58,
      "changedHexagramNumber": 41,
      "sourceEntryNumber": 41,
      "sourceIconHexagramNumber": 41,
      "hexagramName": "損",
      "poemText": "福德之士，懽悅日喜。夷吾相桓，三歸為臣。賞流子孫。",
      "sourceParagraphSha256": "sha256:cbb9ba5a8e46511f703b27075b7786472c69992b0a30e2c7471adaea945d8dea",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:a2c5ef1d30f953ae8f547d1221b074b5726f909a4e26efe10f286885409ec06f"
    },
    {
      "baseHexagramNumber": 58,
      "changedHexagramNumber": 42,
      "sourceEntryNumber": 42,
      "sourceIconHexagramNumber": 42,
      "hexagramName": "益",
      "poemText": "憂姬附耳，心聽悅喜，利後搏取。",
      "sourceParagraphSha256": "sha256:87d6533d99f6cbbac8c3fe0d52886e61491dd99498702bee9b43f9785f1a37b6",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:c45c91611bff32c177758311b5a58e9db81636f3e4bd64dc714962fc528ba3ff"
    },
    {
      "baseHexagramNumber": 58,
      "changedHexagramNumber": 43,
      "sourceEntryNumber": 43,
      "sourceIconHexagramNumber": 43,
      "hexagramName": "夬",
      "poemText": "叔迎兄弟，遇巷在陽。君子季姬，並坐鼓簧。",
      "sourceParagraphSha256": "sha256:62cce6b1dcf3d881347a6fb1099942d72fba4560b75d2ee46faf26bd9d72115c",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:a507cba97f0f813bb4b58efb3033a226c2c76ed7d7aeb3413d3c8ba8628978ca"
    },
    {
      "baseHexagramNumber": 58,
      "changedHexagramNumber": 44,
      "sourceEntryNumber": 44,
      "sourceIconHexagramNumber": 44,
      "hexagramName": "姤",
      "poemText": "徙巢去家，南遇白鳥。東西受福，與喜相得。",
      "sourceParagraphSha256": "sha256:8546d0b498d86811ad2ba42d99b93d03c3b4ca91696d34afc95d670bd9ca0a6d",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:f46e3d4125f0388c4a6aac9365e993fbcf78b90c50e2b63494e400b60de74ee6"
    },
    {
      "baseHexagramNumber": 58,
      "changedHexagramNumber": 45,
      "sourceEntryNumber": 45,
      "sourceIconHexagramNumber": 45,
      "hexagramName": "萃",
      "poemText": "舜登大禹，石夷之野。徵詣王庭，拜治水土。",
      "sourceParagraphSha256": "sha256:e79e1b6e384f476460d49a1e201268f3a7c45ab6acc78612be319252f07a92cd",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:9f19d24d33a80267cb35504db988e8860ded74399d025e6c429c35dfaee58395"
    },
    {
      "baseHexagramNumber": 58,
      "changedHexagramNumber": 46,
      "sourceEntryNumber": 46,
      "sourceIconHexagramNumber": 46,
      "hexagramName": "升",
      "poemText": "江河淮海，天之都市。商人受福，國家富有。",
      "sourceParagraphSha256": "sha256:42fa92bc22f7678a53e893368762bae4e946ee589f1920e59eea854fce44a41b",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:b042aa1c384ad1ffb8d746204c93035ce2a1e3096ddc590687a983de86677750"
    },
    {
      "baseHexagramNumber": 58,
      "changedHexagramNumber": 47,
      "sourceEntryNumber": 47,
      "sourceIconHexagramNumber": 47,
      "hexagramName": "困",
      "poemText": "隱隱煩煩，火燒山根。下潤我鄰，獨不蒙恩。",
      "sourceParagraphSha256": "sha256:e4e0975c98e6a5ae42442ad8806d3527697cf19b4cffb97ca943256b77f01716",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:fcd0770f6c823edfcee45e5091fe9da18c98908b94509d91791e4bd3583e2a16"
    },
    {
      "baseHexagramNumber": 58,
      "changedHexagramNumber": 48,
      "sourceEntryNumber": 48,
      "sourceIconHexagramNumber": 48,
      "hexagramName": "井",
      "poemText": "闇昧不明，耳聾不聰。陷入深淵，滅頂憂凶。",
      "sourceParagraphSha256": "sha256:9dd9ea539a5e1b3dd91d132d4b7fb3826b77aafaeb6ad87fdc261bc308606fb4",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:0019875ee37f524f82fb7cbc9e46eac9f4fa902aab63b42f218a1fcd64092f6d"
    },
    {
      "baseHexagramNumber": 58,
      "changedHexagramNumber": 49,
      "sourceEntryNumber": 49,
      "sourceIconHexagramNumber": 49,
      "hexagramName": "革",
      "poemText": "鳥鳴喈喈，天火將下。燔我館舍，災及妃后。",
      "sourceParagraphSha256": "sha256:c3cb7ee899316ed25625777e939793122b54c8918055cafc5a8d2570e7ba6b3a",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:bfc8361bacadb03d987f75ee0b1a28f7ca05a6ac9e8ff2f60d5b7f9845b64ec7"
    },
    {
      "baseHexagramNumber": 58,
      "changedHexagramNumber": 50,
      "sourceEntryNumber": 50,
      "sourceIconHexagramNumber": 50,
      "hexagramName": "鼎",
      "poemText": "十雉百雛，常與母俱。抱虎搏雞，誰敢難者。",
      "sourceParagraphSha256": "sha256:e55b51d396631cc6dba40a1ad32d59f3579b79d437d86864db73d1d085554a4c",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:656474f1d246bbd7aca8cb7804abb7e0bb32b9e5c0f69e65e41361dabfa90061"
    },
    {
      "baseHexagramNumber": 58,
      "changedHexagramNumber": 51,
      "sourceEntryNumber": 51,
      "sourceIconHexagramNumber": 51,
      "hexagramName": "震",
      "poemText": "營城洛邑，周公所作。世建三十，年歷八百。福祐盤結，堅固不落。",
      "sourceParagraphSha256": "sha256:1236e5ba92a5748a5df37c522f2dc69a0806319d8a69d9b907f36654a5ffaac8",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:1518cf0d3c7614312b7b5df6d64c5c60c3ac0845e54863293e6f34064a16f244"
    },
    {
      "baseHexagramNumber": 58,
      "changedHexagramNumber": 52,
      "sourceEntryNumber": 52,
      "sourceIconHexagramNumber": 52,
      "hexagramName": "艮",
      "poemText": "三人俱行，別離將食。一身五心，反覆迷惑。",
      "sourceParagraphSha256": "sha256:808bd3fdefaf09ae90fbd519bed2444e125fc47cebf132637716b36a4b506a20",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:19715c8fa491c0fba36108181aa68bd6383350c73f64dbf862196e376f6ae886"
    },
    {
      "baseHexagramNumber": 58,
      "changedHexagramNumber": 53,
      "sourceEntryNumber": 53,
      "sourceIconHexagramNumber": 53,
      "hexagramName": "漸",
      "poemText": "三虎搏狼，力不相當。如鷹格雉，一擊破亡。",
      "sourceParagraphSha256": "sha256:328b65d8ce4185269c0b7e2813b65aa6fcfac30a5154b81006d88a4ce42bae46",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:6d2268513f1b63bf0f8941e5fa3c0d36cf6518638eff29246bb78736894e0ceb"
    },
    {
      "baseHexagramNumber": 58,
      "changedHexagramNumber": 54,
      "sourceEntryNumber": 54,
      "sourceIconHexagramNumber": 54,
      "hexagramName": "歸妹",
      "poemText": "養虎畜狼，還自賊傷。年歲息長，疾君拜禱。雖危不凶。",
      "sourceParagraphSha256": "sha256:340b1f84b22ff548722b6cd41301ab7799c32857f6ff5af48942dc5f3dadb2c0",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:2d3f815d928d5520e9f9c3a99ddf028b174110030c97c05dc15c091e9560a47f"
    },
    {
      "baseHexagramNumber": 58,
      "changedHexagramNumber": 55,
      "sourceEntryNumber": 55,
      "sourceIconHexagramNumber": 55,
      "hexagramName": "豐",
      "poemText": "後時失利，不得所欲。",
      "sourceParagraphSha256": "sha256:42f24422f10487c27df06876842dcd3ade44a555cf42a12f28ead846eb92d404",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:44834b6d9dad90221489bf79cf111c7e24bc60e4d63caa6a5f9e31c1f865601d"
    },
    {
      "baseHexagramNumber": 58,
      "changedHexagramNumber": 56,
      "sourceEntryNumber": 56,
      "sourceIconHexagramNumber": 56,
      "hexagramName": "旅",
      "poemText": "雉兔之東，以野為場。見鷹奔走，死於谷口。",
      "sourceParagraphSha256": "sha256:4928698062c23f4da68887c50074357fa884e13489d604e400da97c9e992a148",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ecd71df42d429c0f660fb6f567924d8e15eb6f2460dca3a3152ea646630e140e"
    },
    {
      "baseHexagramNumber": 58,
      "changedHexagramNumber": 57,
      "sourceEntryNumber": 57,
      "sourceIconHexagramNumber": 57,
      "hexagramName": "巽",
      "poemText": "秋蛇見穴，不失其節。夫人姜氏，自齊復入。",
      "sourceParagraphSha256": "sha256:18b4f05ae76dc020e3025d3060130011339d5a6ad54f882d8bff759999bd4837",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ef1dded7b6fb1ccc1185030bf7b9eb8c2868d2fefe2259f83203b4966bc0504b"
    },
    {
      "baseHexagramNumber": 58,
      "changedHexagramNumber": 59,
      "sourceEntryNumber": 59,
      "sourceIconHexagramNumber": 59,
      "hexagramName": "渙",
      "poemText": "鳥鳴巢端，一呼三顛。搖動東西，危嵬不安。",
      "sourceParagraphSha256": "sha256:d2fffb431194d91ade7524d866ed8606dd1be565c0d102378afbc6bd9303845b",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:13e0a9ca35f16d3103858c48fdc38c6e561daa7a5ec58e5cd21fa2bc665857b8"
    },
    {
      "baseHexagramNumber": 58,
      "changedHexagramNumber": 60,
      "sourceEntryNumber": 60,
      "sourceIconHexagramNumber": 60,
      "hexagramName": "節",
      "poemText": "命夭不遂，死多為祟。妻子啼喑，早失其雄。",
      "sourceParagraphSha256": "sha256:cc22c3fa96074732c347dbd5ab2bcf41aae6dc1de58ed7a61b668779f0aa9d16",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:8c67ca9db247a52e1923766e6f5814ecbb98503194131ebdadc96267aac1edde"
    },
    {
      "baseHexagramNumber": 58,
      "changedHexagramNumber": 61,
      "sourceEntryNumber": 61,
      "sourceIconHexagramNumber": 61,
      "hexagramName": "中孚",
      "poemText": "茆屋結席，祟我文德。三辰 旗，家受其福。",
      "sourceParagraphSha256": "sha256:4d9441fb52c75866cba02b6cc20b9d0b10a4a242f319f14b5e99cb201c887129",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:b825c285256c4497dff67df75743917cc3962238284918b8859283a2984b65e3"
    },
    {
      "baseHexagramNumber": 58,
      "changedHexagramNumber": 62,
      "sourceEntryNumber": 62,
      "sourceIconHexagramNumber": 62,
      "hexagramName": "小過",
      "poemText": "羅網一張，鳥無一翔。征伐困極，飢窮不食。",
      "sourceParagraphSha256": "sha256:369d5ce9ea6fc1637e1ba0a9e66fc1063273e8f29ccc4ac82926f02e691a19fc",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:14ae2620ec5c6720e006ed199cf55d105f7625d89e7702be9b3744bab6674da3"
    },
    {
      "baseHexagramNumber": 58,
      "changedHexagramNumber": 63,
      "sourceEntryNumber": 63,
      "sourceIconHexagramNumber": 63,
      "hexagramName": "既濟",
      "poemText": "天成地安，積石為山。潤給萬里，人賴其歡。",
      "sourceParagraphSha256": "sha256:0f67354d13bfeea7c5b2d8a58d4a3538739f1668ee2690699cfc0222d6126f82",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:37ba7fba710043e67616cd611148a754879c010dd70b1ec0c4ce0e2846ed9a08"
    },
    {
      "baseHexagramNumber": 58,
      "changedHexagramNumber": 64,
      "sourceEntryNumber": 64,
      "sourceIconHexagramNumber": 64,
      "hexagramName": "未濟",
      "poemText": "銅人銕柱，暴露勞苦。終月卒歲，無有休止。",
      "sourceParagraphSha256": "sha256:064a87b428ec0526ac52875826280e6ce80b015594d540f4a2aadd798816939c",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:605c389d72a730eea6ea8e5c162d0d0a521dc2a5ae6cec0b6bf1883f8de2b51f"
    }
  ]
}
