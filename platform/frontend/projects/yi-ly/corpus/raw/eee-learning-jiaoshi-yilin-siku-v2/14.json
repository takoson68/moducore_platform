  "entryCount": 64,
  "missingTargets": [],
  "entries": [
    {
      "baseHexagramNumber": 14,
      "changedHexagramNumber": 14,
      "sourceEntryNumber": 14,
      "sourceIconHexagramNumber": 14,
      "hexagramName": "大有",
      "poemText": "白虎張牙，征伐東華。朱鳥前驅，贊導悅辭。敵人請服，御璧而趨。",
      "sourceParagraphSha256": "sha256:db245566936f4659b2eeec96771fe171483ac66d1c8c6806610b33bfec139d72",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:2f925ed44a8caddfb95e0036805addfda5e1f29ec0a0647f68d38eac7d2c30bc"
    },
    {
      "baseHexagramNumber": 14,
      "changedHexagramNumber": 1,
      "sourceEntryNumber": 1,
      "sourceIconHexagramNumber": 1,
      "hexagramName": "乾",
      "poemText": "南山大行，困於空桑。老沙為石，牛馬無食。",
      "sourceParagraphSha256": "sha256:c10d3a76f7cd46275f10d7003a2ae1d919501b039e8f10e9f0b66774d8bd2f03",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:9aac7b32a0549b4d80afac6daf5d10f404be0bc1b0e25a99330806c62fba7ed7"
    },
    {
      "baseHexagramNumber": 14,
      "changedHexagramNumber": 2,
      "sourceEntryNumber": 2,
      "sourceIconHexagramNumber": 2,
      "hexagramName": "坤",
      "poemText": "蟠枝失岐，與母別離，絕不相知。",
      "sourceParagraphSha256": "sha256:77941006763d8b60b9388e32e5fa27ef3665e9166777bbf71babe908f99372ee",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:4dbd2ace049829b00bf93cd069c720abadc8d5c1b3bcfb5f3d97fab82deb6a86"
    },
    {
      "baseHexagramNumber": 14,
      "changedHexagramNumber": 3,
      "sourceEntryNumber": 3,
      "sourceIconHexagramNumber": 3,
      "hexagramName": "屯",
      "poemText": "噂噂所言，莫如我垣。懽樂堅固，可以長安。",
      "sourceParagraphSha256": "sha256:5ef4a8b59909a5e17098e1beefdc1305fe9bfb01f9403d18d5a97701b85aa9a3",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:f0e0d8d1b99f793459f97f9cec3628d6872220781164f28ce3b3b69e6efb8480"
    },
    {
      "baseHexagramNumber": 14,
      "changedHexagramNumber": 4,
      "sourceEntryNumber": 4,
      "sourceIconHexagramNumber": 4,
      "hexagramName": "蒙",
      "poemText": "李梅零墜，心思積憒。懽憂小愧，亂我魂氣。",
      "sourceParagraphSha256": "sha256:e4e095053b675c99d1dd80ea82a344bad32939f4a8f0fe7b865d0094dafc5e44",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:c91c6d01b8a5e1f0375ab12cbe5b00689c407beef0487878ad444de8b244f5fa"
    },
    {
      "baseHexagramNumber": 14,
      "changedHexagramNumber": 5,
      "sourceEntryNumber": 5,
      "sourceIconHexagramNumber": 5,
      "hexagramName": "需",
      "poemText": "火雖熾，在吾後。寇雖多，在吾右。身安吉，不危殆。",
      "sourceParagraphSha256": "sha256:07827719ac52b56d8ac128c194fe7303533a365bd334420eb3997222288c7c0b",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:633436d769e7058c75910d88ff94e8beaeeb5b4bc7793d6aa57cd30e73c807db"
    },
    {
      "baseHexagramNumber": 14,
      "changedHexagramNumber": 6,
      "sourceEntryNumber": 6,
      "sourceIconHexagramNumber": 6,
      "hexagramName": "訟",
      "poemText": "虎臥山隅，鹿過後胊。弓矢復張， 為功曹。伏不敢起，遂至洋野。得我美草。",
      "sourceParagraphSha256": "sha256:673d90398c4d71350ae2643e1f1415f74fb6c1fa433b8b87607d27744cfdd5fb",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:87dac9037cdd4355a9737b96f6e929fc5a7f91d1cbf3d90a9386958a382276e7"
    },
    {
      "baseHexagramNumber": 14,
      "changedHexagramNumber": 7,
      "sourceEntryNumber": 7,
      "sourceIconHexagramNumber": 7,
      "hexagramName": "師",
      "poemText": "三火起明，雨滅其光。高位疾顛，驕恣深傷。",
      "sourceParagraphSha256": "sha256:89fc9dedf31daecfd66f84075446568fc0308312d293a98087bc119840e0dbe8",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:12e8daec7ffaa4fd6f72ee4cfe38bdc3f1447923725fac8dc9cb35fab555061a"
    },
    {
      "baseHexagramNumber": 14,
      "changedHexagramNumber": 8,
      "sourceEntryNumber": 8,
      "sourceIconHexagramNumber": 8,
      "hexagramName": "比",
      "poemText": "匹居楚鳥，遇讒無辜，久散離憂。",
      "sourceParagraphSha256": "sha256:ecbded880352fd8c12808c4eac0950746ce7bf3d181224b0fde8484876d84d37",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:9b4ea7278f8b5ab5baad6cf6edb30056dd29940c00406ff1e1297239cda6c331"
    },
    {
      "baseHexagramNumber": 14,
      "changedHexagramNumber": 9,
      "sourceEntryNumber": 9,
      "sourceIconHexagramNumber": 9,
      "hexagramName": "小畜",
      "poemText": "一室十子，同心異母。以義防患，禍災不起。",
      "sourceParagraphSha256": "sha256:8f3ef39cf8952e864839311058d1d48a2e13450acc50d187f426d71c92841d4b",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:7f0126cb80fb5d72ce0a11daf058c8058dcdf120ab5281ca0ca08ff8557b170c"
    },
    {
      "baseHexagramNumber": 14,
      "changedHexagramNumber": 10,
      "sourceEntryNumber": 10,
      "sourceIconHexagramNumber": 10,
      "hexagramName": "履",
      "poemText": "人行旅，資無所有。貪貝利珠，留連王市。還家內顧，公子何咎。",
      "sourceParagraphSha256": "sha256:6c8aa14e87c31b6c924c995372b6c0ef5d75094eaccc17d1c91124b5103768ed",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:c38981cb7c1043331dfcad0f6916bbfb41f8e76f7881c348edbd39f5bc683761"
    },
    {
      "baseHexagramNumber": 14,
      "changedHexagramNumber": 11,
      "sourceEntryNumber": 11,
      "sourceIconHexagramNumber": 11,
      "hexagramName": "泰",
      "poemText": "禹將為君，北入崑崙。稍進陽光，登入溫湯。功德昭明。",
      "sourceParagraphSha256": "sha256:a4f0ef3ba0605349f0b9d3661f5782cde7ab4d49bbe1a7a7b7d858a259e2d9d0",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:050e9ccc819478523c909264a37b165da4890ad1db0e66efa7dd48fda6af0b02"
    },
    {
      "baseHexagramNumber": 14,
      "changedHexagramNumber": 12,
      "sourceEntryNumber": 12,
      "sourceIconHexagramNumber": 12,
      "hexagramName": "否",
      "poemText": "乾行大德，覆幬無極。嘔呼享熟，使各自得。",
      "sourceParagraphSha256": "sha256:a56336599bbea764d62c0b42a2e6f9a8d3f224004b95436e48bdf5122113282c",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:e8f68139008d5ff4710b08fcde200f64857103d00deb00310831dcbb8ae0d4b1"
    },
    {
      "baseHexagramNumber": 14,
      "changedHexagramNumber": 13,
      "sourceEntryNumber": 13,
      "sourceIconHexagramNumber": 13,
      "hexagramName": "同人",
      "poemText": "南國茂盛，黍稷醲酒。可以享老，樂我嘉友。",
      "sourceParagraphSha256": "sha256:c8115bf94f2b09377d36a6a668d559446a0f9f06a333234ab2e0287253609999",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:e1394c271f22a8b0e25549a28b52d88eb2be0c438776abcf9cdaf41fe1909305"
    },
    {
      "baseHexagramNumber": 14,
      "changedHexagramNumber": 15,
      "sourceEntryNumber": 15,
      "sourceIconHexagramNumber": 15,
      "hexagramName": "謙",
      "poemText": "方船備水，傍河然火。終身為禍，與夫吉昌。永得安康。",
      "sourceParagraphSha256": "sha256:0124e5f32e0156a1f501a02e591c7c6b12a0d9da5e114306f783331f0e70e630",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:353474414e2c8e7778bf647fbfd009ee6d57fb1f7ae61dfff459900f37c25820"
    },
    {
      "baseHexagramNumber": 14,
      "changedHexagramNumber": 16,
      "sourceEntryNumber": 16,
      "sourceIconHexagramNumber": 16,
      "hexagramName": "豫",
      "poemText": "雷行相逐，無有休息。戰於平陸，為夷所覆。",
      "sourceParagraphSha256": "sha256:8c874bd2758a10f178f55bb1a9b8b1968396a3601bdbf927696627c932158f83",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:331c5812ca044fe9079bcf309795dd046bdb50cd68b9ba064011e9fbcbecb945"
    },
    {
      "baseHexagramNumber": 14,
      "changedHexagramNumber": 17,
      "sourceEntryNumber": 17,
      "sourceIconHexagramNumber": 17,
      "hexagramName": "隨",
      "poemText": "躑躅踟躕，撫心搔頭。五晝四夜，賭我齊侯。",
      "sourceParagraphSha256": "sha256:f2e38d67b50b41812fd7cb13f67da8d9881167c8d936610e86ced47aa1bb7ab5",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:6e8e089528664f204461e3af239ee92731e647df61577413438a0cef84548dcd"
    },
    {
      "baseHexagramNumber": 14,
      "changedHexagramNumber": 18,
      "sourceEntryNumber": 18,
      "sourceIconHexagramNumber": 18,
      "hexagramName": "蠱",
      "poemText": "大口宣唇，神使伸言。黃龍景星，出應德門。與福上堂，天下安昌。",
      "sourceParagraphSha256": "sha256:1ef02af49cf8052b710390d874b0c798cfb2b6475c7c1cedf9f8239ff0026176",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:16f8bbd36bd12ed4f074174bb7cc9908ec97551a5f570759ed747a32c5f26343"
    },
    {
      "baseHexagramNumber": 14,
      "changedHexagramNumber": 19,
      "sourceEntryNumber": 19,
      "sourceIconHexagramNumber": 19,
      "hexagramName": "臨",
      "poemText": "陰衰老極，陽建其德。離載陽光，天下昭明。",
      "sourceParagraphSha256": "sha256:5aaa99c50c01637677f1803ec5fa748585186f4a67164939918273b97fc232d0",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ee178e4720cf0ff2be7e28c62e6493aa83574b11b28b5bb07dbd065375f1347d"
    },
    {
      "baseHexagramNumber": 14,
      "changedHexagramNumber": 20,
      "sourceEntryNumber": 20,
      "sourceIconHexagramNumber": 20,
      "hexagramName": "觀",
      "poemText": "三塗五岳，陽城大室。神明所伏，獨無兵革。下有保國。",
      "sourceParagraphSha256": "sha256:48a98213ca6b6662ecc6d9f11b6fd0ef23ca6b84b437cebe55098a3bc46b81e6",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:80c8154587ae113427156cd7c84dc010a364f1f45d5d2f82622255c4e8aa25ba"
    },
    {
      "baseHexagramNumber": 14,
      "changedHexagramNumber": 21,
      "sourceEntryNumber": 21,
      "sourceIconHexagramNumber": 21,
      "hexagramName": "噬嗑",
      "poemText": "年豐歲熟，仁政民樂。利以居止，旅人獲福。",
      "sourceParagraphSha256": "sha256:635536b63fcd8ce13892cae38ecf6940b08a13c7449b3c75248addf3ea0667ce",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:d2972dfaf115565923afbb81e5d18e99b011bfbef908295f1119a51f8b4de18e"
    },
    {
      "baseHexagramNumber": 14,
      "changedHexagramNumber": 22,
      "sourceEntryNumber": 22,
      "sourceIconHexagramNumber": 22,
      "hexagramName": "賁",
      "poemText": "楚鳥逢矢，不可久放。離居無辜，作此哀詩。以告孔憂。",
      "sourceParagraphSha256": "sha256:30edb1f8c50ead6b514c5b76f41e6e78a330498a252e506669ce738c8510b307",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:9182be5be46ea508e9b99773035745359fb5447c5811fadadfefff0caa8cd92f"
    },
    {
      "baseHexagramNumber": 14,
      "changedHexagramNumber": 23,
      "sourceEntryNumber": 23,
      "sourceIconHexagramNumber": 23,
      "hexagramName": "剝",
      "poemText": "出門大步，與兄惡忤。詈公詈母，為我憂趾。",
      "sourceParagraphSha256": "sha256:a8699664a2b4718d50005b2880a89b158a614889abc04d07a903bf6a2e017f71",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:3adab18210d00fd93bc13914b840b45d6fa55f3fb5762c4c3e7e46441393d829"
    },
    {
      "baseHexagramNumber": 14,
      "changedHexagramNumber": 24,
      "sourceEntryNumber": 24,
      "sourceIconHexagramNumber": 24,
      "hexagramName": "復",
      "poemText": "火之并谷，楊芒生角。犯歷天市，闚觀太極。登上玉床，家易六公。",
      "sourceParagraphSha256": "sha256:9d4b30b0dea3f191493fa57d4e254c1d746f0feee23f577e7f6892b0dc91bf94",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:3aac66e11322ab8d8df36816083a47b9fae3a08582db9fd54fc7dda58abe4b16"
    },
    {
      "baseHexagramNumber": 14,
      "changedHexagramNumber": 25,
      "sourceEntryNumber": 25,
      "sourceIconHexagramNumber": 25,
      "hexagramName": "无妄",
      "poemText": "牧羊逢狼，雖憂不傷。畏怖惕息，終無禍殃。",
      "sourceParagraphSha256": "sha256:09a55b94fa09659186c781e3a9e9c1e8e4d1a984d9027c8caef4323d3504b064",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:a611c3b339caa5b9c7d23efa59592b930eee46f2ba5dd548af124eeacb7f77eb"
    },
    {
      "baseHexagramNumber": 14,
      "changedHexagramNumber": 26,
      "sourceEntryNumber": 26,
      "sourceIconHexagramNumber": 26,
      "hexagramName": "大畜",
      "poemText": "繭栗犧牲，敬事鬼神。神嗜飲食，受福多孫。望季不來，孔聖厄陳。",
      "sourceParagraphSha256": "sha256:6c8c64e46a82434c163a8139a897c7d3d659fce9ab6b7ebe033a8341efdc913f",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:54c8c24f00ef7221eb6261db53853da7efb1d07f1362b3b889da76630b8bc402"
    },
    {
      "baseHexagramNumber": 14,
      "changedHexagramNumber": 27,
      "sourceEntryNumber": 27,
      "sourceIconHexagramNumber": 27,
      "hexagramName": "頤",
      "poemText": "大澤治妝，南販牧牂。長伯為我，多得牛馬。利於徙居。",
      "sourceParagraphSha256": "sha256:4e30f1f7e81e7dc78cb5790b4ebf344f0f09191f8635376a89c65ea4509445fe",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:28100c3e93fb35e9dada421c43a48e472f1267f6f2b91bb62c13f88505284a41"
    },
    {
      "baseHexagramNumber": 14,
      "changedHexagramNumber": 28,
      "sourceEntryNumber": 28,
      "sourceIconHexagramNumber": 28,
      "hexagramName": "大過",
      "poemText": "枯樹無枝，與子分離。飢寒莫養，獨立哀悲。",
      "sourceParagraphSha256": "sha256:9b7ca5ebc5bb5738e6e01f06b2de9e23a875837cbc0756802d952d6accd19dc5",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:936de186789a82802515b643f4ce413957858ea51d713ceb8ee50621e8e3e85b"
    },
    {
      "baseHexagramNumber": 14,
      "changedHexagramNumber": 29,
      "sourceEntryNumber": 29,
      "sourceIconHexagramNumber": 29,
      "hexagramName": "坎",
      "poemText": "天地九重，堯舜治中。正冠衣裳，宇宙平康。",
      "sourceParagraphSha256": "sha256:c28337b6b19db3703031526bd1ab1fcfdb83f7720212bbc219283991c7c00dc1",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:69215e34895573610e71072456f2d95069999d4f268da4ccb920e9fd8214c1c6"
    },
    {
      "baseHexagramNumber": 14,
      "changedHexagramNumber": 30,
      "sourceEntryNumber": 30,
      "sourceIconHexagramNumber": 30,
      "hexagramName": "離",
      "poemText": "鳧鷖遊涇，君子以寧。復德不愆，福祿來成。",
      "sourceParagraphSha256": "sha256:102a049e3be13b93a5e540408a1cfcee141dd5bfe40e9044c33d080c84dd55e3",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:8175b3cde2592a59fe0411202a0c03ea82f6bbeea7066436a09fdeb465db2bd5"
    },
    {
      "baseHexagramNumber": 14,
      "changedHexagramNumber": 31,
      "sourceEntryNumber": 31,
      "sourceIconHexagramNumber": 31,
      "hexagramName": "咸",
      "poemText": "裸裎逐狐，為人所笑。牝雞司晨，主作亂根。",
      "sourceParagraphSha256": "sha256:fd071681c3f829fd4155b6ff08a64f358d439c12a00d9c4e11f070697b1a030e",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:24b2e5c5b5efe7a47f5a1e148781e003f9031269c90b90c74b68ce670bab6256"
    },
    {
      "baseHexagramNumber": 14,
      "changedHexagramNumber": 32,
      "sourceEntryNumber": 32,
      "sourceIconHexagramNumber": 32,
      "hexagramName": "恒",
      "poemText": "典冊法言，藏在蘭臺。雖遭禍潰，獨不遇災。",
      "sourceParagraphSha256": "sha256:c702418bcecc80d3a7a2cf77995daa1c54764fa21ef506596d36696bbcbf07a9",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:9d84201602a7fb511331aec79d3346cff828001fe340cd2ace095f10ea6a9355"
    },
    {
      "baseHexagramNumber": 14,
      "changedHexagramNumber": 33,
      "sourceEntryNumber": 33,
      "sourceIconHexagramNumber": 33,
      "hexagramName": "遯",
      "poemText": "三癡且狂，欲之平鄉。迷惑失道，不知昏明。",
      "sourceParagraphSha256": "sha256:538d91f7a8e6086d8b32ce0b4e0828688013a66f00849567d57ce48f1c6c02ab",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:428db50c46eb830c8a2de961c00a3f622c9b0f706362d15d85a7e1893a6747b5"
    },
    {
      "baseHexagramNumber": 14,
      "changedHexagramNumber": 34,
      "sourceEntryNumber": 34,
      "sourceIconHexagramNumber": 34,
      "hexagramName": "大壯",
      "poemText": "癭瘤瘍疹，為身瘡患。疾病癃痾，常不危殆。",
      "sourceParagraphSha256": "sha256:65f6153fba8bce3c13eaf2401b750c1c6b4f6af7f44d0ccd66acae57a7893b31",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:742f01b7636e9b42582931cd346ce9c1b82d6427b4fc3a6b6db660317d196c3e"
    },
    {
      "baseHexagramNumber": 14,
      "changedHexagramNumber": 35,
      "sourceEntryNumber": 35,
      "sourceIconHexagramNumber": 35,
      "hexagramName": "晉",
      "poemText": "三豕俱走，鬥於谷口。白豕不勝，死於 下。",
      "sourceParagraphSha256": "sha256:8d4233bcbad6275c3488a8c60162299f73acdae63875138c69782b8b45ae59d5",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:68ed1953bb6dc63c778c92c0b5badbf55598c16095323b0adb2f31ba09adb891"
    },
    {
      "baseHexagramNumber": 14,
      "changedHexagramNumber": 36,
      "sourceEntryNumber": 36,
      "sourceIconHexagramNumber": 36,
      "hexagramName": "明夷",
      "poemText": "賴主之光，受德之佑。雖造顛沛，獨不凶咎。",
      "sourceParagraphSha256": "sha256:aa74ef1fd41f92ab5b0b83cb4faa6ebd96a7d49a0f75cea514bab8441aef38a8",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:549cbbc1f993495e96e6db5d684e7e7eb409075a456e94aa2d392d008e9edee4"
    },
    {
      "baseHexagramNumber": 14,
      "changedHexagramNumber": 37,
      "sourceEntryNumber": 37,
      "sourceIconHexagramNumber": 37,
      "hexagramName": "家人",
      "poemText": "上義崇德，以建大福。吉宜詰旦，周武功立。",
      "sourceParagraphSha256": "sha256:89001137c082c1ef8eb9be10a46e61bbef39f958b7cbe3e64c855f78f93cbda7",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:c901eddd8723c33c4bb1cf43fd62d19f448385845cd908d1008f0e6893cde517"
    },
    {
      "baseHexagramNumber": 14,
      "changedHexagramNumber": 38,
      "sourceEntryNumber": 38,
      "sourceIconHexagramNumber": 38,
      "hexagramName": "睽",
      "poemText": "四亂不安，東西為恨。身止無功，不出國城。乃得完全，賴其生福。",
      "sourceParagraphSha256": "sha256:b54e513d64bb1a70372a3c3398d172533f9a8584a325eb44e21e03a3be0ae5b8",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:243e8ee6432f2a8ff9cebbd965d5fbd023363e04e144427cab0e74f423da1475"
    },
    {
      "baseHexagramNumber": 14,
      "changedHexagramNumber": 39,
      "sourceEntryNumber": 39,
      "sourceIconHexagramNumber": 39,
      "hexagramName": "蹇",
      "poemText": "金牙鐵齒，西王母子。無有患殆，涉道大利。",
      "sourceParagraphSha256": "sha256:8cdd75253b3771896789e1dcbd193fba7c0ea41221f480d7d39c76362b4cf2cd",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:0f7f73e535abede918c57171ecc70c56f33d064ffa59e4921a59dad138633d0c"
    },
    {
      "baseHexagramNumber": 14,
      "changedHexagramNumber": 40,
      "sourceEntryNumber": 40,
      "sourceIconHexagramNumber": 40,
      "hexagramName": "解",
      "poemText": "賀喜從福，日利蕃息，歡樂有得。",
      "sourceParagraphSha256": "sha256:c951501fefbc25d41c87da82eb4620b35c9cb3d21d1fd99dbc356e02e04abeea",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:c29b16e8e1789cc027379e2b28dffc60c6e3c9faf2e46b0d8829039c1369e322"
    },
    {
      "baseHexagramNumber": 14,
      "changedHexagramNumber": 41,
      "sourceEntryNumber": 41,
      "sourceIconHexagramNumber": 41,
      "hexagramName": "損",
      "poemText": "昊天白日，照臨我國。萬民康寧，咸賴受福。",
      "sourceParagraphSha256": "sha256:5236b96011c3e9fc3f880f14ef17cf161785ec8cd477c70d2cbb52342a6ba24e",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:482e2a027d96e1215aef41fa9dfe59c18621085a776f958c7f22e01e8323b4da"
    },
    {
      "baseHexagramNumber": 14,
      "changedHexagramNumber": 42,
      "sourceEntryNumber": 42,
      "sourceIconHexagramNumber": 42,
      "hexagramName": "益",
      "poemText": "左眇右盲，視闇不明。下民多孽，君失其常。",
      "sourceParagraphSha256": "sha256:6de44fc0b3d09d75f50d7a34cec11ce4afb27cbd893058bbc9bcbe73a076481f",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:3ee0b4eb48378f4e66cc56f505ecce22462f8223ed00dc92bd1f0e872c45d91f"
    },
    {
      "baseHexagramNumber": 14,
      "changedHexagramNumber": 43,
      "sourceEntryNumber": 43,
      "sourceIconHexagramNumber": 43,
      "hexagramName": "夬",
      "poemText": "吾有黍粱，委積道傍。有架服箱，運到我鄉。藏於嘉倉。",
      "sourceParagraphSha256": "sha256:b943871b1f8640aa3cf0fafc4090046765d2a338ac31f005c3dafeb278dffe8c",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ce2c08065af6a1be154e74ce20b3d83d06ad08bdde02e0018874dfec01c75e30"
    },
    {
      "baseHexagramNumber": 14,
      "changedHexagramNumber": 44,
      "sourceEntryNumber": 44,
      "sourceIconHexagramNumber": 44,
      "hexagramName": "姤",
      "poemText": "殊類異路，心不相慕。牝豕無豭，鰥居室家。",
      "sourceParagraphSha256": "sha256:fb1fab1d6c9d95e1a4a77a3b7835c475a80eab5ba39709b141025cd118f7c5df",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:41d0f611339115f6fa49d48dde8123e2373deebbe06e1e4d527c34cb59a42e3c"
    },
    {
      "baseHexagramNumber": 14,
      "changedHexagramNumber": 45,
      "sourceEntryNumber": 45,
      "sourceIconHexagramNumber": 45,
      "hexagramName": "萃",
      "poemText": "雀行求食，出門見鷂。顛蹶上下，幾無所處。",
      "sourceParagraphSha256": "sha256:8aaee9aa362a12aa15a61a537cdad4aebf793997b8818d4fd53aeabe114b687e",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:c94a86d9085d3a12eed560879226a7a568baead213a91f62ab19766948c11a86"
    },
    {
      "baseHexagramNumber": 14,
      "changedHexagramNumber": 46,
      "sourceEntryNumber": 46,
      "sourceIconHexagramNumber": 46,
      "hexagramName": "升",
      "poemText": "野有積庾，穡人駕取。不逢狼虎，暮歸其宇。",
      "sourceParagraphSha256": "sha256:08cd9ced1dbf721cf2081604873c0745868a152f38212eeb29c26152c4d59548",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:9c66242e7546b7142b611e8d30671b209d306d8f88aa2a1a1d1158ae9380f84f"
    },
    {
      "baseHexagramNumber": 14,
      "changedHexagramNumber": 47,
      "sourceEntryNumber": 47,
      "sourceIconHexagramNumber": 47,
      "hexagramName": "困",
      "poemText": "膚敏之德，發憤忘食。虜豹禽越，為王求福。",
      "sourceParagraphSha256": "sha256:ed5f98b1e1df787ff088e96da5b51cf2b6cfdf68c16055e096e9bdf22afcfdc2",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:3ebf667739cad7afaf6e726e8a5d13affb22487c49e40376beeca9239f1a9b6f"
    },
    {
      "baseHexagramNumber": 14,
      "changedHexagramNumber": 48,
      "sourceEntryNumber": 48,
      "sourceIconHexagramNumber": 48,
      "hexagramName": "井",
      "poemText": "光禮春成，陳項雞鳴。陽明失道，不能自守。消亡為咎。",
      "sourceParagraphSha256": "sha256:78bf65ae0ea69ca25c96b300715d13d2ea64b3dbc8bf37cf5d162766898711a9",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:1c4188bb7b5a0d8dedcdeca7ae8eb98b2318babda1fa851cf6cfd2ca6e23661e"
    },
    {
      "baseHexagramNumber": 14,
      "changedHexagramNumber": 49,
      "sourceEntryNumber": 49,
      "sourceIconHexagramNumber": 49,
      "hexagramName": "革",
      "poemText": "左抱金玉，右得熊足。常盈不亡，獲心所欲。",
      "sourceParagraphSha256": "sha256:038ec4e5f60e2dfa8ca8258935fdff341f715a7f11fe0b4003824936f0b0062a",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:00631562d90e3130698f387612ca0c3244f261dbfa9071ba9e2480ee3eb18d18"
    },
    {
      "baseHexagramNumber": 14,
      "changedHexagramNumber": 50,
      "sourceEntryNumber": 50,
      "sourceIconHexagramNumber": 50,
      "hexagramName": "鼎",
      "poemText": "履泥汙足，名困身辱。兩仇相得，身其為虐。",
      "sourceParagraphSha256": "sha256:dc5fa7068f9c7ccc79b39aa14c146cbbac3ae7276fea3e8f2995148383f4c06a",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:18e9c3b2c81c9175155fb92a514df39a115212c50cec33d712b0e8516e7a1ebf"
    },
    {
      "baseHexagramNumber": 14,
      "changedHexagramNumber": 51,
      "sourceEntryNumber": 51,
      "sourceIconHexagramNumber": 51,
      "hexagramName": "震",
      "poemText": "安居重遷，不去其廛。禾米相聞，樂得常產。",
      "sourceParagraphSha256": "sha256:6abe2e00a27cbbc2106f1d4e9f6d3a30f29fe75953727430895fa14a66d2feae",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:9c803d1ffc4296965dda5bfbf6df307081555515e47751cadbb6cd5b75c1b2f3"
    },
    {
      "baseHexagramNumber": 14,
      "changedHexagramNumber": 52,
      "sourceEntryNumber": 52,
      "sourceIconHexagramNumber": 52,
      "hexagramName": "艮",
      "poemText": "天災所遊，凶不可居。轉徙獲福，留止憂危。",
      "sourceParagraphSha256": "sha256:766ac2eb84e0f4f677e133c04438e89d5ab79944514cacc30fc73eec824e1a1d",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:62742dcd9cd66619b52472cdb829eb5efc88e256172a95b9fa84bfdc949b1968"
    },
    {
      "baseHexagramNumber": 14,
      "changedHexagramNumber": 53,
      "sourceEntryNumber": 53,
      "sourceIconHexagramNumber": 53,
      "hexagramName": "漸",
      "poemText": "昧昧默默，不知白日。景雲亂擾，光明隱伏。幽王失國。",
      "sourceParagraphSha256": "sha256:8a1d19d3a17513260c8002bbc31ef07e904f13ae18e23a825be4db47cdd2e6b0",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:a35ba97d855bd8ad01df0923eb26ebc182bd49643bcc713dbb00ea03acbaf5b2"
    },
    {
      "baseHexagramNumber": 14,
      "changedHexagramNumber": 54,
      "sourceEntryNumber": 54,
      "sourceIconHexagramNumber": 54,
      "hexagramName": "歸妹",
      "poemText": "鳧雁啞啞，以水為宅。雌雄相和，常共娛樂。得其所欲。",
      "sourceParagraphSha256": "sha256:f8f6df0fa758acc04046f0c8fffb340edef415d6214c923df2e2006b679d3b0a",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:4d1d84ad89f8a1915ad18b62a3803f43e2dd1f83099a1315534b583cc63cfcc5"
    },
    {
      "baseHexagramNumber": 14,
      "changedHexagramNumber": 55,
      "sourceEntryNumber": 55,
      "sourceIconHexagramNumber": 55,
      "hexagramName": "豐",
      "poemText": "長生無極，子孫千億。柏柱載梁，堅固不傾。",
      "sourceParagraphSha256": "sha256:ce526b242e46ea5326dab305084d120cead3a31de3e9c38b2de9ed43c58d8b47",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:2932da6c06fac915562131b3b88ff1a0c6dfbbe212b0a10534dcd2c9e87d2ab5"
    },
    {
      "baseHexagramNumber": 14,
      "changedHexagramNumber": 56,
      "sourceEntryNumber": 56,
      "sourceIconHexagramNumber": 56,
      "hexagramName": "旅",
      "poemText": "麒麟鳳凰，善政得祥。陰陽和調，國無災殃。",
      "sourceParagraphSha256": "sha256:e26874177b53dd4c5e58a9f36af14bb0a1cf12cf1915311669072c63ddd17ae7",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:f560265add2dc2fd57cb98b0ff06081e7122d18f8935109ec55a95aaadcedd45"
    },
    {
      "baseHexagramNumber": 14,
      "changedHexagramNumber": 57,
      "sourceEntryNumber": 57,
      "sourceIconHexagramNumber": 57,
      "hexagramName": "巽",
      "poemText": "天之奧隅，堯舜所居。可以存身，保我家室。",
      "sourceParagraphSha256": "sha256:ade37c0002a2a52020b8d771985763ccbe177d6c6f41edd40b5db7d045a85e03",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:d1efe439a5ab87c2c29dbc7fe917d34d3f1dd98ac182d2535fbda008f4e668c0"
    },
    {
      "baseHexagramNumber": 14,
      "changedHexagramNumber": 58,
      "sourceEntryNumber": 58,
      "sourceIconHexagramNumber": 58,
      "hexagramName": "兌",
      "poemText": "配合相迎，利之四鄉。昏以為期，與福喜笑。",
      "sourceParagraphSha256": "sha256:448ea2b351a610daa2f923ff5b1123af4e25e76de024b3e0e99024804e1990cc",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:22f2f5c229e3fa17ccaa9673767af8ef2b631758e90e3339d901124b5bc04bec"
    },
    {
      "baseHexagramNumber": 14,
      "changedHexagramNumber": 59,
      "sourceEntryNumber": 59,
      "sourceIconHexagramNumber": 59,
      "hexagramName": "渙",
      "poemText": "砥德礪材，果當成周。拜受大命，封為齊侯。",
      "sourceParagraphSha256": "sha256:97c3d3d0ffa7ce37a4cab03abe00bd52b5d80b8e9c539ac5e2049ab41a55e814",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:b4bc6bf941265d1b6423e86a50050f088d8edf67046ebfecabb4ef75224e4139"
    },
    {
      "baseHexagramNumber": 14,
      "changedHexagramNumber": 60,
      "sourceEntryNumber": 60,
      "sourceIconHexagramNumber": 60,
      "hexagramName": "節",
      "poemText": "與福俱坐，畜水備火，終無災禍。",
      "sourceParagraphSha256": "sha256:9a5fb577de8eeb34682398a57ed524cbf43fb6540b35c0eef293250c737d8fd0",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ba85b391d117fc987fc5498a795a59894ff9441c33be06cbd08a42c8828434ad"
    },
    {
      "baseHexagramNumber": 14,
      "changedHexagramNumber": 61,
      "sourceEntryNumber": 61,
      "sourceIconHexagramNumber": 61,
      "hexagramName": "中孚",
      "poemText": "晨昏潛處，候時煦煦。卒逢白日，為世榮主。",
      "sourceParagraphSha256": "sha256:372e60a48fb450eabc9da4b311d233410f4b5be197ee3a315cc49fe08502d673",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:6f1934e9bbc9a4212f2afa798456414ef6f4e754b3eb96675cb8db8b6e6249e3"
    },
    {
      "baseHexagramNumber": 14,
      "changedHexagramNumber": 62,
      "sourceEntryNumber": 62,
      "sourceIconHexagramNumber": 62,
      "hexagramName": "小過",
      "poemText": "視日再光，與天相望。長生懽悅，與福為兄。",
      "sourceParagraphSha256": "sha256:ad78539b6cfa8d38cc1971606276f8aa429123e38315ec91d7e9f845b31ff73d",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:4433995fced213ae39a98eb19d94faf7dda32fdcf5a733711e33916d8cfc0a6c"
    },
    {
      "baseHexagramNumber": 14,
      "changedHexagramNumber": 63,
      "sourceEntryNumber": 63,
      "sourceIconHexagramNumber": 63,
      "hexagramName": "既濟",
      "poemText": "大頭明目，再受喜福。二雀飛來，與祿相觸。",
      "sourceParagraphSha256": "sha256:675c342f4d6b27697a52fd9b93fa9ae52b11fb0020875bea7a4fb5cb6528e10f",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:36b0a30a54c7c89128d15223a2f073106181def3571cee4a20a13e0954cfd6e2"
    },
    {
      "baseHexagramNumber": 14,
      "changedHexagramNumber": 64,
      "sourceEntryNumber": 64,
      "sourceIconHexagramNumber": 64,
      "hexagramName": "未濟",
      "poemText": "楩生荊山，命屬輸班。袍衣剝脫，夏熱冬寒。立成枯槁，眾人莫憐。",
      "sourceParagraphSha256": "sha256:a32326416e013d632ebb2a8a1e3fb63bafa0145dea22c6d68bd3cae6dd5795f9",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:1cfe5eaa38f509ff7247c6b6d2939d6c0fbfb278da4fd2044e796b11280f3031"
    }
  ]
}
