  "attribution": "來源：《焦氏易林》，易學網《焦氏易林［四庫全書版］》（依據版本：《欽定四庫全書》子部術數類），https://www.eee-learning.com/book/giauii 。依來源要求標示出處及原網頁連結；本站僅整理林辭原文，並記錄收錄、標點及文字整理修改。",
  "entryCount": 64,
  "missingTargets": [],
  "entries": [
    {
      "baseHexagramNumber": 1,
      "changedHexagramNumber": 1,
      "sourceEntryNumber": 1,
      "sourceIconHexagramNumber": 1,
      "hexagramName": "乾",
      "poemText": "道陟多阪，胡言連蹇，譯瘠且聾，莫使道通，請謁不行，求事無功。",
      "sourceParagraphSha256": "sha256:ffbf3e9d10f61fac90111d4988dfa29f22488d853676965b36fda130985437df",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:696f38b34f301afca5acb65034d6fbd8d72cbc2dcb4ead0418dbe8c482ed1afc"
    },
    {
      "baseHexagramNumber": 1,
      "changedHexagramNumber": 2,
      "sourceEntryNumber": 2,
      "sourceIconHexagramNumber": 2,
      "hexagramName": "坤",
      "poemText": "招殃來螫，害我邦國。病傷手足，不得安息。",
      "sourceParagraphSha256": "sha256:f7dc5c5229ca6f7747435e7655f8ba810c144ddd064b75a23da07c7dd6f31031",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:5f139ffce398065e3fcdebe6ed1df216977b8cc7cfa5873d6eecf41bc4a1242b"
    },
    {
      "baseHexagramNumber": 1,
      "changedHexagramNumber": 3,
      "sourceEntryNumber": 3,
      "sourceIconHexagramNumber": 3,
      "hexagramName": "屯",
      "poemText": "陽孤亢極，多所恨惑。車傾蓋亡，身常憂惶，乃得其願，雌雄相從。",
      "sourceParagraphSha256": "sha256:939d378ad2fb852cf0edc28af7aac0e28d365f169aa8b64ff4591ee0030d8b7e",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:52bf0597915335f9be199259a0403875f94486fe6853838a5fff511fa12565f4"
    },
    {
      "baseHexagramNumber": 1,
      "changedHexagramNumber": 4,
      "sourceEntryNumber": 4,
      "sourceIconHexagramNumber": 4,
      "hexagramName": "蒙",
      "poemText": "鴶鵴鳲鳩，專一無尤，君子是則，長受嘉福。",
      "sourceParagraphSha256": "sha256:69a400caa6526708a3fe573fde7c9df8255abae9fa360df2df2c970980af4288",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:134c3ab345d1af31989eceb17d3860c579520e25c279834c9ee33386454b2227"
    },
    {
      "baseHexagramNumber": 1,
      "changedHexagramNumber": 5,
      "sourceEntryNumber": 5,
      "sourceIconHexagramNumber": 5,
      "hexagramName": "需",
      "poemText": "目瞤足動。喜如其願，舉家蒙寵。",
      "sourceParagraphSha256": "sha256:ea4514a412e2315f7f531ef77249f0f308ab640eef60febfce92b70e6ee633a0",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:11169f0c8f3188bdbd0a21356af3ef0bfc72dd59679c38466fa8cc3d73f12a53"
    },
    {
      "baseHexagramNumber": 1,
      "changedHexagramNumber": 6,
      "sourceEntryNumber": 6,
      "sourceIconHexagramNumber": 6,
      "hexagramName": "訟",
      "poemText": "龍馬上山，絕無水泉，喉焦唇乾，舌不能言。",
      "sourceParagraphSha256": "sha256:b591ca4c9411b92807c68a5057ca772ff96fdc20cb78f2ef26659198317e26d9",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:390ac32c8799ae0fccbf918696dc718f8e4235c1abd95e00499b841009f993ba"
    },
    {
      "baseHexagramNumber": 1,
      "changedHexagramNumber": 7,
      "sourceEntryNumber": 7,
      "sourceIconHexagramNumber": 7,
      "hexagramName": "師",
      "poemText": "倉盈庚億，宜種黍稷，年豐歲熟，民人安息。",
      "sourceParagraphSha256": "sha256:b05fef95f75790ab360080b33fd52aec4d252b16fef7d73b5844cb3909e7661c",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:1c38a024341f3a44ca78082cd5582da51a1a42dcf35e5dfe3feb6590aa660c92"
    },
    {
      "baseHexagramNumber": 1,
      "changedHexagramNumber": 8,
      "sourceEntryNumber": 8,
      "sourceIconHexagramNumber": 8,
      "hexagramName": "比",
      "poemText": "中夜犬吠，盜在墻外，神明祐助，銷散皆去。",
      "sourceParagraphSha256": "sha256:44135ef021a527a12fcb64dc156bda6b85f2215e3e7fe6682d7c395bc73e973e",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:735a83df58aa302d3ca2ff121de267f12c64d9395aca6669d14259aaf6cfe213"
    },
    {
      "baseHexagramNumber": 1,
      "changedHexagramNumber": 9,
      "sourceEntryNumber": 9,
      "sourceIconHexagramNumber": 9,
      "hexagramName": "小畜",
      "poemText": "据斗運樞，順天無憂，所行造德，與樂並居。",
      "sourceParagraphSha256": "sha256:590a5537d1cb23830c13574181e3752763e021b3bcc8209b70d1127e89841782",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:5ba7904e617edddf2e7a851750b59ca9069381f3515aa6413fd3c40a1bb44c23"
    },
    {
      "baseHexagramNumber": 1,
      "changedHexagramNumber": 10,
      "sourceEntryNumber": 10,
      "sourceIconHexagramNumber": 10,
      "hexagramName": "履",
      "poemText": "空拳握手，委地更起，富饒豐衍，快樂無已。",
      "sourceParagraphSha256": "sha256:259e30f2f2a17112fd3e182569b6a3dbd62c46055b391e5dcd255d28976759cd",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:3ef6ad9c11699a61ac5eeec1a76a2096499c7ed6d2de75177d33dab77f1e2c34"
    },
    {
      "baseHexagramNumber": 1,
      "changedHexagramNumber": 11,
      "sourceEntryNumber": 11,
      "sourceIconHexagramNumber": 11,
      "hexagramName": "泰",
      "poemText": "不風不雨，白日皎皎，宜出驅馳，通理大道。",
      "sourceParagraphSha256": "sha256:d6b0181cc423ff1906a495ba4a63d69f1ee8a3cc35739bca396543e0c308aba4",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:3ac95c53d46db399358f600dd39e7148a9101b1ecc6ecbf5d5a605479c70cc9f"
    },
    {
      "baseHexagramNumber": 1,
      "changedHexagramNumber": 12,
      "sourceEntryNumber": 12,
      "sourceIconHexagramNumber": 12,
      "hexagramName": "否",
      "poemText": "載日晶光，驂駕六龍，祿命徹天，封為燕王。",
      "sourceParagraphSha256": "sha256:08dc9545eebaf14f1d60b5160ebade693105422928abf4333ae0035bc62a15d2",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:636d4069d4f5cbc3bb6db51630a526e80b8ee13ad5872d1bfc201a2fa4ad18eb"
    },
    {
      "baseHexagramNumber": 1,
      "changedHexagramNumber": 13,
      "sourceEntryNumber": 13,
      "sourceIconHexagramNumber": 13,
      "hexagramName": "同人",
      "poemText": "子號索哺，母行求食，反見空巢，訾我長息。",
      "sourceParagraphSha256": "sha256:8fde8886bb39eafff1ffae36f557886631c6b76de3458e6ae715f71c6ebad2a7",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:6870ab8f27452608b37960e1cdbe4eda25f5d0d9f124f0589c5b9fc5df9e4b64"
    },
    {
      "baseHexagramNumber": 1,
      "changedHexagramNumber": 14,
      "sourceEntryNumber": 14,
      "sourceIconHexagramNumber": 14,
      "hexagramName": "大有",
      "poemText": "上帝之生，福祐日成，修德行惠，樂安且寧。",
      "sourceParagraphSha256": "sha256:2da53df5228301e75ad59e5309b2ff9bfd15a5065191d1b1f794c18cc747b650",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:13c2a3d9c4e1e6f7b0ad8425d8f584d9db0fcea6ed349f313407242447024ff7"
    },
    {
      "baseHexagramNumber": 1,
      "changedHexagramNumber": 15,
      "sourceEntryNumber": 15,
      "sourceIconHexagramNumber": 15,
      "hexagramName": "謙",
      "poemText": "山險難登，澗中多石，車馳轊擊，載重傷軸，擔負差躓，踠跌右足。",
      "sourceParagraphSha256": "sha256:5bc9493cbaad57fc479a315902511aefe6bb5922da6ba0a5fe37c6f3469c9c33",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:9e9e05e8d533de0128c0c6e32a7497ca99a02a708709d25909f739be8009fcd6"
    },
    {
      "baseHexagramNumber": 1,
      "changedHexagramNumber": 16,
      "sourceEntryNumber": 16,
      "sourceIconHexagramNumber": 16,
      "hexagramName": "豫",
      "poemText": "禹鑿龍門，通利水源，東注滄海，民得安從。",
      "sourceParagraphSha256": "sha256:9203046410844f95be68fc2db39fc3db8751794d8a7cde9eb8043babfd8e2a99",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:4a4a6b4bea6a6f16d41374767cf28db662212f80f504e048e14a04be5d277ba7"
    },
    {
      "baseHexagramNumber": 1,
      "changedHexagramNumber": 17,
      "sourceEntryNumber": 17,
      "sourceIconHexagramNumber": 17,
      "hexagramName": "隨",
      "poemText": "乘龍上天，兩蛇為輔，湧躍雲中，遊觀滄海，安樂長處。",
      "sourceParagraphSha256": "sha256:67848788a821595cc454a33ac83da0d75cafd85e2bd2c54e63c80a2325c75fd5",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:a714e886aca57a128b2e7f10a0a53e72ad58772e524efba262f28dd3eee8e3bd"
    },
    {
      "baseHexagramNumber": 1,
      "changedHexagramNumber": 18,
      "sourceEntryNumber": 18,
      "sourceIconHexagramNumber": 18,
      "hexagramName": "蠱",
      "poemText": "彭祖九子，據德不殆，南山松栢，長受嘉福。",
      "sourceParagraphSha256": "sha256:6a1d25ab8157f247246ebca164531b9c3295467c332e0447e8e78ff0111e3bbc",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:dfec8290d9a19510ca509645fbc277bba22f4a86f4072c2b34c40bafb9f7441b"
    },
    {
      "baseHexagramNumber": 1,
      "changedHexagramNumber": 19,
      "sourceEntryNumber": 19,
      "sourceIconHexagramNumber": 19,
      "hexagramName": "臨",
      "poemText": "南山昊天，刺政閔身，疾悲無辜，背憎為仇。",
      "sourceParagraphSha256": "sha256:6a7e0850da55c5929ed912636494ac9ff615d48f0d88ac94621defb8397781fd",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:a2d6a055cccc5b3480ce124fe7af20b9c11af6c6950f363f7a0da71028a739d7"
    },
    {
      "baseHexagramNumber": 1,
      "changedHexagramNumber": 20,
      "sourceEntryNumber": 20,
      "sourceIconHexagramNumber": 20,
      "hexagramName": "觀",
      "poemText": "江河淮海，天之奧府，眾利所聚，可以饒有，樂我君子。",
      "sourceParagraphSha256": "sha256:7ba4047eeafe66fb1baebd5e157d89b4de347c008f5e1269078b76f03a41c27a",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:27e193a24d246c1bddc586cf98b4a1abdc258f944eec810e266b0c554083b285"
    },
    {
      "baseHexagramNumber": 1,
      "changedHexagramNumber": 21,
      "sourceEntryNumber": 21,
      "sourceIconHexagramNumber": 21,
      "hexagramName": "噬嗑",
      "poemText": "堅冰黃鳥，啼哀悲愁，不見甘粒，但見藜蒿，數驚鷙鳥，為我心憂。",
      "sourceParagraphSha256": "sha256:735a975d519e77a1452295cc179a7badbbf3a501ec5589572b51126d23730947",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:dac07dac40cd171301d207287b928b096c0c22acbdb72a2f573f04bc820d4b2e"
    },
    {
      "baseHexagramNumber": 1,
      "changedHexagramNumber": 22,
      "sourceEntryNumber": 22,
      "sourceIconHexagramNumber": 22,
      "hexagramName": "賁",
      "poemText": "室如懸磐，既危且殆，早見之士，依山谷處。",
      "sourceParagraphSha256": "sha256:892a12f8e68a711983d7de0347199e39536fa06c7152ffcf4a51bbdda6f0d432",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:e4b35b95cf31bb9be1016cbef6a45d35cf93b54368046e968e9b23b82818fc64"
    },
    {
      "baseHexagramNumber": 1,
      "changedHexagramNumber": 23,
      "sourceEntryNumber": 23,
      "sourceIconHexagramNumber": 23,
      "hexagramName": "剝",
      "poemText": "大禹戒路，蚩尤除道，周匝萬里，不危不殆，見其所使，無所不在。",
      "sourceParagraphSha256": "sha256:b62af10b88d8ad5ef622fd933a237eb8bf7e8ae258a4a1af2c218b8a795a531c",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:21d32646a4a92c604535695e3b82656a383f0ad388b8d6ea4a7a9efba80ee323"
    },
    {
      "baseHexagramNumber": 1,
      "changedHexagramNumber": 24,
      "sourceEntryNumber": 24,
      "sourceIconHexagramNumber": 24,
      "hexagramName": "復",
      "poemText": "三人為旅，俱歸北海，入門上堂，拜謁主母，飲勞我酒。",
      "sourceParagraphSha256": "sha256:d076c217d4a251a18767da4094cc2271c547e04401e6669e87881be0990aad3b",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:70d5059c5de5c5a9a4171c8b403d4f06504a90b198221dd38c3a32fa6f7e8d28"
    },
    {
      "baseHexagramNumber": 1,
      "changedHexagramNumber": 25,
      "sourceEntryNumber": 25,
      "sourceIconHexagramNumber": 25,
      "hexagramName": "无妄",
      "poemText": "傳言相誤，非于徑路，鳴鼓逐狐，不知跡處。",
      "sourceParagraphSha256": "sha256:3ce4f22ac4141e4ee00389586e1389a577babe84bb137abcfdf4cae513d300c1",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:553e9270fec74f89e0cbc0f19efee395077aae87ff337ccfb73d550402df397d"
    },
    {
      "baseHexagramNumber": 1,
      "changedHexagramNumber": 26,
      "sourceEntryNumber": 26,
      "sourceIconHexagramNumber": 26,
      "hexagramName": "大畜",
      "poemText": "三年爭妻，相逐奔馳，終日不食，精氣勞疲。",
      "sourceParagraphSha256": "sha256:9c9c13041501129dc1aeca42980a6db216304ca8b3d9e1a5e65629848d4dbd1d",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:4fb9510e604abc722cc8eb852f7ae841d95922194c68f3b15df61a15029208f0"
    },
    {
      "baseHexagramNumber": 1,
      "changedHexagramNumber": 27,
      "sourceEntryNumber": 27,
      "sourceIconHexagramNumber": 27,
      "hexagramName": "頤",
      "poemText": "純服黃裳，戴上以興，德義既生，天下歸仁。",
      "sourceParagraphSha256": "sha256:2af3607307122d837b26b3bbc58557e6db7ca538f5c9e357afa9a6960929cfa0",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:3e917672104484718913aadd6a463f1a03a79e396283ac1db4b2a73d35e5b633"
    },
    {
      "baseHexagramNumber": 1,
      "changedHexagramNumber": 28,
      "sourceEntryNumber": 28,
      "sourceIconHexagramNumber": 28,
      "hexagramName": "大過",
      "poemText": "桀跖並處，人民愁苦，擁兵荷糧，戰於齊魯。",
      "sourceParagraphSha256": "sha256:49e24a7629f99bd9f2c9b2ccbaa4a2c017f95b3445ef4a9020468f2ed79726bd",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:f5ee1f7e642117824b1c35034fc7042648f140a0b7590ff8d9df6f68f254c567"
    },
    {
      "baseHexagramNumber": 1,
      "changedHexagramNumber": 29,
      "sourceEntryNumber": 29,
      "sourceIconHexagramNumber": 29,
      "hexagramName": "坎",
      "poemText": "黃鳥來集，既嫁不荅，念我父兄，思復邦國。",
      "sourceParagraphSha256": "sha256:f8344dd918bfb56f1ac5c30c55801cc868865ace9696f42508420726ee72f3b9",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:93f87e6d5c141665cd0b6c7b5957bf73c2aed2ecf09e7e6aaea558094461273f"
    },
    {
      "baseHexagramNumber": 1,
      "changedHexagramNumber": 30,
      "sourceEntryNumber": 30,
      "sourceIconHexagramNumber": 30,
      "hexagramName": "離",
      "poemText": "胎生孚乳，長息成就，充滿帝室，家國昌富。",
      "sourceParagraphSha256": "sha256:5dfd898ed631752879d3838849048e195bb6015f1aaf0c4581ea63a421e1b403",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ae7e6b1d9208dd8d3a0763ad6ff5fd99d8abe6b5c0ac275feb50c2403007036c"
    },
    {
      "baseHexagramNumber": 1,
      "changedHexagramNumber": 31,
      "sourceEntryNumber": 31,
      "sourceIconHexagramNumber": 31,
      "hexagramName": "咸",
      "poemText": "三人求橘，反得大栗，女青以富，黃金百鎰。",
      "sourceParagraphSha256": "sha256:ef67551dae0dc1aacd18f7072e80cfee211e8a3087bb01ee2ae7a144dc5be078",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:6cefdc5660c1ccca0007372a5b0cb9dabd6861ce872e4574082ab739082fd34d"
    },
    {
      "baseHexagramNumber": 1,
      "changedHexagramNumber": 32,
      "sourceEntryNumber": 32,
      "sourceIconHexagramNumber": 32,
      "hexagramName": "恒",
      "poemText": "東山西岳，會合俱食，百家送從，以成恩福。",
      "sourceParagraphSha256": "sha256:bb288c89f45b1be8c54a4049d0d65c1a0c9e740c8a3fd1e883a6ef8258538b22",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:a537b28ff70922a7a563ca90c9f2c3e7d40882082f1f13d05faa7b7a3fbd30b9"
    },
    {
      "baseHexagramNumber": 1,
      "changedHexagramNumber": 33,
      "sourceEntryNumber": 33,
      "sourceIconHexagramNumber": 33,
      "hexagramName": "遯",
      "poemText": "眵雞無距，與鵲交鬪，翅折目盲，為鳩所傷。",
      "sourceParagraphSha256": "sha256:663d6de06eee15a7c9450b84952883846b017edecfae83b343f44b1398827db9",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:fda413682dd9e0e5ad5796cba9ab529d074ce3f290b97876e1d0bcfc629897d8"
    },
    {
      "baseHexagramNumber": 1,
      "changedHexagramNumber": 34,
      "sourceEntryNumber": 34,
      "sourceIconHexagramNumber": 34,
      "hexagramName": "大壯",
      "poemText": "郤大墻壤，蠹眾目折，狼虎為政，天降罪罰，高弒望夷，胡亥以斃。",
      "sourceParagraphSha256": "sha256:b7d97c1dd3ee531bdb3c9319401964b77a233b197255d4ec512a7ef0284aa995",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:2c5b22e2cfa0ebe2b0ad41904f2df0c9b81c9a9050319a0f4d2a1a7f0551235b"
    },
    {
      "baseHexagramNumber": 1,
      "changedHexagramNumber": 35,
      "sourceEntryNumber": 35,
      "sourceIconHexagramNumber": 35,
      "hexagramName": "晉",
      "poemText": "三癡俱走，迷路失道，惑不知歸，反入患口。",
      "sourceParagraphSha256": "sha256:846dd2a3d313be8620c957a873884f43cfc368428d719517843d336b69578c98",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:0db8b60c6a423e08d35c60787b52b65b298ca666800d06583bc5a3489bb244d3"
    },
    {
      "baseHexagramNumber": 1,
      "changedHexagramNumber": 36,
      "sourceEntryNumber": 36,
      "sourceIconHexagramNumber": 36,
      "hexagramName": "明夷",
      "poemText": "弓矢俱張，把彈折絃，丸發不至，道遇害患。",
      "sourceParagraphSha256": "sha256:32a54a0fb437ae4b52be84fcc78e339611e8be77733b4c4ff8437c2b2f01581e",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ad2644ccbcc5f2bb78e809e534f59526f3d3e28e9c3c99ee729ddd20aac222f4"
    },
    {
      "baseHexagramNumber": 1,
      "changedHexagramNumber": 37,
      "sourceEntryNumber": 37,
      "sourceIconHexagramNumber": 37,
      "hexagramName": "家人",
      "poemText": "三女求夫，不見復關，伺候山隅，長思憂歎。",
      "sourceParagraphSha256": "sha256:52815ace56f9bb9c6696e43ac537de564f2f7bcaa86d212a62607e957d9c559a",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:37996e5804a748bd0d757fdadbae28d8de6d0a73293fd4e368cfc9d4c2bf47e2"
    },
    {
      "baseHexagramNumber": 1,
      "changedHexagramNumber": 38,
      "sourceEntryNumber": 38,
      "sourceIconHexagramNumber": 38,
      "hexagramName": "睽",
      "poemText": "陽旱炎炎，傷害禾穀，穡人無食，耕夫歎息。",
      "sourceParagraphSha256": "sha256:cb585d83c426b491ec95e78677a26649f049ab1fc4c7c2c45357a8da0b51afde",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:5e397aec342255c8afcdf0a53e72892ba1ff10954266b74abe2f14f79f666a1d"
    },
    {
      "baseHexagramNumber": 1,
      "changedHexagramNumber": 39,
      "sourceEntryNumber": 39,
      "sourceIconHexagramNumber": 39,
      "hexagramName": "蹇",
      "poemText": "騎㹠逐羊，不見所望，徑涉虎廬，亡羝失羔。",
      "sourceParagraphSha256": "sha256:c6428c85ab2cf137bc4b10ac0ae7560eaa9cd08dc1a4eddb76d54297bcb2ba9a",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ebd5f8addb2c0692137a4c16796736acb50a8c509e96c086c199be4da8dc8877"
    },
    {
      "baseHexagramNumber": 1,
      "changedHexagramNumber": 40,
      "sourceEntryNumber": 40,
      "sourceIconHexagramNumber": 40,
      "hexagramName": "解",
      "poemText": "暗昧冥語，相傳詿誤，鬼魅所舍，誰知臥處。",
      "sourceParagraphSha256": "sha256:5574d3dad23bc14857df4c438aacf6e8a997da838590e3abb38d294080c15245",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:bcc949feee03fc684a7127ef3c0f87d5e0fc6ebf051fdf7fdd9928cf2fc96051"
    },
    {
      "baseHexagramNumber": 1,
      "changedHexagramNumber": 41,
      "sourceEntryNumber": 41,
      "sourceIconHexagramNumber": 41,
      "hexagramName": "損",
      "poemText": "姬姜祥淑，二人偶食，論仁議福，以安王室。",
      "sourceParagraphSha256": "sha256:c30af2f99dcd2120f44a6acfba2a0c360d50764ecbdaa8ec782807e92cbad9e1",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:6a035a2acda78b5e3aaf5c000e05b4f56c3383dc0e29452bf67bcd58e0cacf25"
    },
    {
      "baseHexagramNumber": 1,
      "changedHexagramNumber": 42,
      "sourceEntryNumber": 42,
      "sourceIconHexagramNumber": 42,
      "hexagramName": "益",
      "poemText": "公孫架驪，載聘東齊，延陵說產，遺季紵衣。",
      "sourceParagraphSha256": "sha256:9d274c54c5208d5ccba3325f629c17be17e09d2d34261861df0cc1aa7118bd29",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:b96924d00376bc77fb80c50e3debfdcc1353d08a11bd027dc8ced471e4b9cce6"
    },
    {
      "baseHexagramNumber": 1,
      "changedHexagramNumber": 43,
      "sourceEntryNumber": 43,
      "sourceIconHexagramNumber": 43,
      "hexagramName": "夬",
      "poemText": "孤竹之墟，失婦亡夫，商於蒺藜，不見少妻，東郭棠姜，武氏以亡。",
      "sourceParagraphSha256": "sha256:8c7c4239865e9c85bd8be362a3f7d84f48ddc919b4afc2e6f0233d2f4b947ae7",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:f3ac27f7c496610012ec3ab5960bd7e62b41f4c80498f678b8ea870a4d84a384"
    },
    {
      "baseHexagramNumber": 1,
      "changedHexagramNumber": 44,
      "sourceEntryNumber": 44,
      "sourceIconHexagramNumber": 44,
      "hexagramName": "姤",
      "poemText": "仁政不暴，鳳凰來舍，四時順節，民安其處。",
      "sourceParagraphSha256": "sha256:ace2f2b93253d57252daa49aaaca4018230e3b68e3b2d8e4bd9b431997799497",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:374253254ac5689d06654a8beddfa17351f05cc778c2280e48dc08e00d3c8a3c"
    },
    {
      "baseHexagramNumber": 1,
      "changedHexagramNumber": 45,
      "sourceEntryNumber": 45,
      "sourceIconHexagramNumber": 45,
      "hexagramName": "萃",
      "poemText": "任劣力薄，孱駑恐怯，如蝟見鵲，不敢拒格。",
      "sourceParagraphSha256": "sha256:43ca9b8b6596cad89e32f41c376563e53cb86adb2936a298e8a136d339a4ef35",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:9292e817555a158571e80f7df09d91a23fe7ff03ed6dd79e93bc95f515c236af"
    },
    {
      "baseHexagramNumber": 1,
      "changedHexagramNumber": 46,
      "sourceEntryNumber": 46,
      "sourceIconHexagramNumber": 46,
      "hexagramName": "升",
      "poemText": "衛侯東遊，惑於少姬，亡我考妣，又逝不來。",
      "sourceParagraphSha256": "sha256:128f95b7f6a10afc3fe7bb54691c052b593f48230c99d9687a0e87482d48a8a4",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:faa38a53d9438e39d501ac7e1dfdfaf87325a16cbc3dd1da1fb0337a1ebbc52f"
    },
    {
      "baseHexagramNumber": 1,
      "changedHexagramNumber": 47,
      "sourceEntryNumber": 47,
      "sourceIconHexagramNumber": 47,
      "hexagramName": "困",
      "poemText": "噂噂所言，莫如我垣，歡喜堅固，可以長安。",
      "sourceParagraphSha256": "sha256:270e10e80a199db5943f60cfaca65a83c66b1d52d811dae0dfd8cd7ae1ac9c3f",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:c02964d8324ed2b4d189a8fd67959d8d27b7c60adaa3bb8067738bd142c88836"
    },
    {
      "baseHexagramNumber": 1,
      "changedHexagramNumber": 48,
      "sourceEntryNumber": 48,
      "sourceIconHexagramNumber": 48,
      "hexagramName": "井",
      "poemText": "黿鳴岐山，鼈應山淵，男女媾精，萬物化生，文王以成，為周開庭。",
      "sourceParagraphSha256": "sha256:0fff6360d9085fd534d123a54e752b5b2062ec9b23fc2bb9992a5522968e3e56",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:4281eee4383a86b7d19d412cb017fad8a6b3a0b2edde9a1fb520b2972c9cbd01"
    },
    {
      "baseHexagramNumber": 1,
      "changedHexagramNumber": 49,
      "sourceEntryNumber": 49,
      "sourceIconHexagramNumber": 49,
      "hexagramName": "革",
      "poemText": "玄黃虺隤，行者勞疲，役夫憔悴，踰時不歸。",
      "sourceParagraphSha256": "sha256:f401176e6b99e9999b5f020bdcc9e2c54a43cd43e0a94ff8989e10d75cd632f9",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:6625323e271a14a71d4ff9218f6d15db38dcf65c4c703665385e5462222b3887"
    },
    {
      "baseHexagramNumber": 1,
      "changedHexagramNumber": 50,
      "sourceEntryNumber": 50,
      "sourceIconHexagramNumber": 50,
      "hexagramName": "鼎",
      "poemText": "弱足刖跟，不私出門，市賈不利，折亡為患。",
      "sourceParagraphSha256": "sha256:3a3681df273da683cfdec14a0f78517873503bf76d8082d1747e27081a616326",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:74090342c2582a5f0700da8c4e85c743d83640a90cfcf6165f597198c18c4031"
    },
    {
      "baseHexagramNumber": 1,
      "changedHexagramNumber": 51,
      "sourceEntryNumber": 51,
      "sourceIconHexagramNumber": 51,
      "hexagramName": "震",
      "poemText": "懸貆素餐，居非其安，失輿剝廬，休坐徙居。",
      "sourceParagraphSha256": "sha256:03c65187428834071995104a98b311033ec5af20b7aba8c31c291be973dc4ee7",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:2bf645e7e03c70eabd5e2fc75bba9ee2fce3ca8190f8c2b07beae954a088c9b2"
    },
    {
      "baseHexagramNumber": 1,
      "changedHexagramNumber": 52,
      "sourceEntryNumber": 52,
      "sourceIconHexagramNumber": 52,
      "hexagramName": "艮",
      "poemText": "民怯伐惡，姦人所伏，寇賊大至，入我邦郭，妻子係獲。",
      "sourceParagraphSha256": "sha256:60b0cde1e3f7bd04b581e279239611ddb93c2642d5a0fe52ecfcd796744f468f",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:a2be3b7b56d5f3c3a27eec37fc180a86583bad47b620b26d749512bb9eb80a63"
    },
    {
      "baseHexagramNumber": 1,
      "changedHexagramNumber": 53,
      "sourceEntryNumber": 53,
      "sourceIconHexagramNumber": 53,
      "hexagramName": "漸",
      "poemText": "陽低頭，陰仰首，水為凶，傷我寶，進不利，生其子。",
      "sourceParagraphSha256": "sha256:a5c98f2a97ec4fbf232aafd3d84994b0b2ab014cb271646ee0b859c7cff531ed",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:1d340426053b8faec6cb454819c3172ba178000147d6b0ad8948f4fbb792dc67"
    },
    {
      "baseHexagramNumber": 1,
      "changedHexagramNumber": 54,
      "sourceEntryNumber": 54,
      "sourceIconHexagramNumber": 54,
      "hexagramName": "歸妹",
      "poemText": "背北相憎，心意不同，如火與金。",
      "sourceParagraphSha256": "sha256:4d400dda20cf7c1fc335cb8542da02315d46ba4a6a6095acdb294465dc023557",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:1b6a1758264ec17eb4426238138dad0605598cb034bbb63a79bd9e042bba6f3c"
    },
    {
      "baseHexagramNumber": 1,
      "changedHexagramNumber": 55,
      "sourceEntryNumber": 55,
      "sourceIconHexagramNumber": 55,
      "hexagramName": "豐",
      "poemText": "太微帝室，黃帝所值，藩屏固衛，不可得入，常安無患。",
      "sourceParagraphSha256": "sha256:982d3db96509e28cc1cef241ec82ce463b00fff6c2da50e53072bcdada7cc5c3",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ac87bf279f667de89e5d5b762c1e68734944bb468818bbee45f859d93ee43ba7"
    },
    {
      "baseHexagramNumber": 1,
      "changedHexagramNumber": 56,
      "sourceEntryNumber": 56,
      "sourceIconHexagramNumber": 56,
      "hexagramName": "旅",
      "poemText": "繭栗犧牲，敬享鬼神，神嗜飲食，受福多孫。",
      "sourceParagraphSha256": "sha256:de4438ac94dcd2be3351651a9933af3c00a0b7b2d243811610050496be17cba4",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:87276f13f8d8a78e4329c3c3641b2a20d9a643ea95a9634a6ff6ba00c6579cf4"
    },
    {
      "baseHexagramNumber": 1,
      "changedHexagramNumber": 57,
      "sourceEntryNumber": 57,
      "sourceIconHexagramNumber": 57,
      "hexagramName": "巽",
      "poemText": "出門逢惡，與禍為怨，更相擊刺，傷我手端。",
      "sourceParagraphSha256": "sha256:c248fd92d5a3c00c23a1353b0cf9aba7793ac29c963e62c970c6da061dccd027",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:3d7e2ead5c0129709c822b0a9fd05cf53ac50c5448c099fd8b39322613374f8e"
    },
    {
      "baseHexagramNumber": 1,
      "changedHexagramNumber": 58,
      "sourceEntryNumber": 58,
      "sourceIconHexagramNumber": 58,
      "hexagramName": "兌",
      "poemText": "鷧飛中退，舉事不進，宋人亂潰。",
      "sourceParagraphSha256": "sha256:2a23677f9a75c62b2abe92b2f0ac2d0e6df1aee6a7c31045124b7c641ed5b701",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:b59210b6435dbae2f03e4a0725f2a85a1bb203ccae57a5e7cfd3c65ae72868d5"
    },
    {
      "baseHexagramNumber": 1,
      "changedHexagramNumber": 59,
      "sourceEntryNumber": 59,
      "sourceIconHexagramNumber": 59,
      "hexagramName": "渙",
      "poemText": "跛踦相隨，日暮牛罷，陵遲後旅，失利亡雌。",
      "sourceParagraphSha256": "sha256:e10feb277b27c26b82b110fbe0f3f87f129b91d9f0dc8c32f03a9fab21e8b787",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:0db440497389beafa442d552ae2ab8ca2565f270cc577102458a7bfe16f7c871"
    },
    {
      "baseHexagramNumber": 1,
      "changedHexagramNumber": 60,
      "sourceEntryNumber": 60,
      "sourceIconHexagramNumber": 60,
      "hexagramName": "節",
      "poemText": "龍角博顙，位至公傾，世祿久長，起動安寧。",
      "sourceParagraphSha256": "sha256:6bbb642fc1e63ef9e47b3c99d101c8d7a1e04d4306a5fc533342cff796389236",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:3bac561414298c942e91106aaf53d3161df38bd98258aad03fc4ec46424a6d2d"
    },
    {
      "baseHexagramNumber": 1,
      "changedHexagramNumber": 61,
      "sourceEntryNumber": 61,
      "sourceIconHexagramNumber": 61,
      "hexagramName": "中孚",
      "poemText": "舜升大禹，石夷之野，徵詣王庭，拜治水土。",
      "sourceParagraphSha256": "sha256:d64ddb9f0c7395da855c5011dd48dc2b8654651cc48527f6bfdd87e4b2b6be31",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:8f56c2ecf226a45f0f927094cf80c2a3f3b13eaec3b34158d13de07c288ef7b5"
    },
    {
      "baseHexagramNumber": 1,
      "changedHexagramNumber": 62,
      "sourceEntryNumber": 62,
      "sourceIconHexagramNumber": 62,
      "hexagramName": "小過",
      "poemText": "從風放火，荻芝俱死，三害集亡，叔子中傷。",
      "sourceParagraphSha256": "sha256:9663f38198d0ee7df4f3a870b59fa49b9c1733ac6d4db8267ff7ca9d504431d8",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:b56a4dbdb32d6152e9c132db036e1de6f8535b69e08c431e33cc7a614cfafa10"
    },
    {
      "baseHexagramNumber": 1,
      "changedHexagramNumber": 63,
      "sourceEntryNumber": 63,
      "sourceIconHexagramNumber": 63,
      "hexagramName": "既濟",
      "poemText": "梗生荊山，命制輸班，袍衣剝脫，夏熱冬寒，飢餓枯槁，眾人莫憐。",
      "sourceParagraphSha256": "sha256:a2e0aa19e58287b09ffeb689acb0fe6b7934589d8c55274e3a3beeb39dc883a2",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:089f00f01393410275830991cb680af381650eb6591fd745dec2e0e1ab09ac46"
    },
    {
      "baseHexagramNumber": 1,
      "changedHexagramNumber": 64,
      "sourceEntryNumber": 64,
      "sourceIconHexagramNumber": 64,
      "hexagramName": "未濟",
      "poemText": "長面大鼻，來解己憂，遺吾福子，惠我嘉喜。",
      "sourceParagraphSha256": "sha256:90dd6e0ee49cd7c4cc39b3122ddbf966264ae244a210976de68e0103730eee2f",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ff1bdf75d9d3d88dcf3a0b980b1ba1ef176e2796a48aca1dc7f2b04552a07b6b"
    }
  ]
}
