  "entryCount": 64,
  "missingTargets": [],
  "entries": [
    {
      "baseHexagramNumber": 63,
      "changedHexagramNumber": 63,
      "sourceEntryNumber": 63,
      "sourceIconHexagramNumber": 63,
      "hexagramName": "既濟",
      "poemText": "元兔捐掌，與足相視。證訊詰問，詿情自侶。死誣難告，口為身禍。",
      "sourceParagraphSha256": "sha256:ea310a79a860fbb6b45db3135b6b26852978e3919116b19df856199c268c271f",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:dbff6b55c6c64c803bc7bf0ff433addfd7a7ff57cc37b5f78f465de684bd54b9"
    },
    {
      "baseHexagramNumber": 63,
      "changedHexagramNumber": 1,
      "sourceEntryNumber": 1,
      "sourceIconHexagramNumber": 1,
      "hexagramName": "乾",
      "poemText": "游駒石門，騄耳安全。受福西鄰，歸隱玉泉。",
      "sourceParagraphSha256": "sha256:65a9a513c692b21ccbf1a1e2d3f39a31e87e0efc62490d78353731d2d2247fa9",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ccfa9915d158a2c92acd3c69bb53b0fb2921a0b847bf2892ab07b2361e87ac38"
    },
    {
      "baseHexagramNumber": 63,
      "changedHexagramNumber": 2,
      "sourceEntryNumber": 2,
      "sourceIconHexagramNumber": 2,
      "hexagramName": "坤",
      "poemText": "陽春草生，萬物風興。君子所居，禍災不到。",
      "sourceParagraphSha256": "sha256:61228d56d9e967abe9cdca50782a83da6191b86811115194eff06b5a889909ac",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:56c50f34756d3cba8904a83f5ea04dab3cb86e1f8d3aa38dd10ea049652f1551"
    },
    {
      "baseHexagramNumber": 63,
      "changedHexagramNumber": 3,
      "sourceEntryNumber": 3,
      "sourceIconHexagramNumber": 3,
      "hexagramName": "屯",
      "poemText": "人無足法，紱除牛出。雄走羊驚，不失其家。",
      "sourceParagraphSha256": "sha256:c20e9d4b82e5d4140f442a630ed24e69908f262fc6911385baa829151afcf8dd",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:1dff12805891f2a3b83dc9f378ea45286a8e4b93f21a5b3ac4a980370c223e64"
    },
    {
      "baseHexagramNumber": 63,
      "changedHexagramNumber": 4,
      "sourceEntryNumber": 4,
      "sourceIconHexagramNumber": 4,
      "hexagramName": "蒙",
      "poemText": "太山上奔，變見太傲。陳吾廢忽，作為禍患。",
      "sourceParagraphSha256": "sha256:96f2bfbec7df04904382f61c25b384f2ec857738f0b131e36687c13978a13e6d",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:fb247add7efb7009507bb4bff594f4c52aebbd45e068bbb7c99d88fc95473108"
    },
    {
      "baseHexagramNumber": 63,
      "changedHexagramNumber": 5,
      "sourceEntryNumber": 5,
      "sourceIconHexagramNumber": 5,
      "hexagramName": "需",
      "poemText": "乘龍光土，先暗後明。燎獵大得，太師以昌。",
      "sourceParagraphSha256": "sha256:5cccc134fee030b31e9618f35bf1464ba3bfcb8a058baaef5dbf69ee9bb8a1a2",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:c6d39f115d3ff24c96f408fe51ac4584117372007f0e08f6f027d99cec19b37e"
    },
    {
      "baseHexagramNumber": 63,
      "changedHexagramNumber": 6,
      "sourceEntryNumber": 6,
      "sourceIconHexagramNumber": 6,
      "hexagramName": "訟",
      "poemText": "羊頭兔足，羸瘦少肉。漏囊貯粟，利無所得。",
      "sourceParagraphSha256": "sha256:25b99155ed6b7192cfb46c2710b559917287f50438fa93d87f4c42075b9c27b5",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:769eeb83955762c0efac4413a57531f946cb6ddcc5456f7d365e25baf5905fc3"
    },
    {
      "baseHexagramNumber": 63,
      "changedHexagramNumber": 7,
      "sourceEntryNumber": 7,
      "sourceIconHexagramNumber": 7,
      "hexagramName": "師",
      "poemText": "因禍受福，喜盈其室。螟蟲不作，君無苛惑。",
      "sourceParagraphSha256": "sha256:2786512f447474a9bf6159906f02a1e02a0f42968d726eb256781a68d54f90f9",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:0ceb85bf7fdc5b061397f20fb9bf03c7d211dfa98236bd0b2d4ff2abf2813ff8"
    },
    {
      "baseHexagramNumber": 63,
      "changedHexagramNumber": 8,
      "sourceEntryNumber": 8,
      "sourceIconHexagramNumber": 8,
      "hexagramName": "比",
      "poemText": "舜升大禹，石夷之野。徵詣黃門，拜治水土。",
      "sourceParagraphSha256": "sha256:0b01d07437b067f1e6b88b5df316b0a2a6950b3522b988dc3a444ab82b8c032c",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:df2cb4a21f0abd3b5731905273a6eb9bd13e713cd76c4673bae0e8d79af6ef75"
    },
    {
      "baseHexagramNumber": 63,
      "changedHexagramNumber": 9,
      "sourceEntryNumber": 9,
      "sourceIconHexagramNumber": 9,
      "hexagramName": "小畜",
      "poemText": "烏子鵲雛，常與母居。顧類群聚，不離其巢。",
      "sourceParagraphSha256": "sha256:093c141efccea84d41cdf0c147179e867a60a4343c70d4347d2bd7c85a027dc4",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:18a6a5812f205b43737840db3a009993cff627b1de1a69d0a41cf34e7b48b7da"
    },
    {
      "baseHexagramNumber": 63,
      "changedHexagramNumber": 10,
      "sourceEntryNumber": 10,
      "sourceIconHexagramNumber": 10,
      "hexagramName": "履",
      "poemText": "夷羿所射，發輒有獲。增加倉鷹，雙鳥俱得。",
      "sourceParagraphSha256": "sha256:cd45e34189527d2976b57722e7ff312886649b38448326e8bbc599d55bfbb819",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:244714fd5df7bc8949f14dba9b76c21bd05a4f4131541bf93d6c65d5cbd5233d"
    },
    {
      "baseHexagramNumber": 63,
      "changedHexagramNumber": 11,
      "sourceEntryNumber": 11,
      "sourceIconHexagramNumber": 11,
      "hexagramName": "泰",
      "poemText": "晨風文翰，火舉就溫。昧過我邑，羿無所得。",
      "sourceParagraphSha256": "sha256:a7958f2e4bb21879b1c65cb9d91548238fd117a47d179bb4c94a1816c68155de",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:9e5aa2cf884a508a8ebed3d907d30afa23cbcbef2f5ab6025b4bdcd3b724cf2c"
    },
    {
      "baseHexagramNumber": 63,
      "changedHexagramNumber": 12,
      "sourceEntryNumber": 12,
      "sourceIconHexagramNumber": 12,
      "hexagramName": "否",
      "poemText": "六喜三福，南至歡國。與喜同樂，嘉我潔德。",
      "sourceParagraphSha256": "sha256:88515e0633fe32ca0c1cbdf1c1ef02e6600de9f99d0afcc85539c8c6d263c1a6",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:37a6e6afc9da17f621c446d3f27ab48fd6915478f603a29371a7707c785c388c"
    },
    {
      "baseHexagramNumber": 63,
      "changedHexagramNumber": 13,
      "sourceEntryNumber": 13,
      "sourceIconHexagramNumber": 13,
      "hexagramName": "同人",
      "poemText": "鬥龍股折，日就遂明。自外為主，弟伐其兄。",
      "sourceParagraphSha256": "sha256:58eed94ade8be62ea2ca5d4d1a8226bbf36d9c7f8ec05354199152055ba1fff3",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:6ddff86d31a066639abe5a0de69370d4b037670b6934ced6b6130bc5bf98581c"
    },
    {
      "baseHexagramNumber": 63,
      "changedHexagramNumber": 14,
      "sourceEntryNumber": 14,
      "sourceIconHexagramNumber": 14,
      "hexagramName": "大有",
      "poemText": "蒙慶受福，有所獲得，不利出域。",
      "sourceParagraphSha256": "sha256:25de95cf831a91d1e187bee5450677f349a28c7637f11c7768cfab886bb8a0ed",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ae6ee3000cde97e0234a9ba8a0ce36a94b3d65e1e3231081bd1e7b06f6dbcbf8"
    },
    {
      "baseHexagramNumber": 63,
      "changedHexagramNumber": 15,
      "sourceEntryNumber": 15,
      "sourceIconHexagramNumber": 15,
      "hexagramName": "謙",
      "poemText": "蠻夷戎狄，太陰所積。涸水沍寒，君子不存。",
      "sourceParagraphSha256": "sha256:664e429ad08a1fd030c85471752167a1d876396ac17e7dc3f579aa0d1fa15244",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:05d88957fba9cd2e3e00e9c38d9c784c4fc62ed9604861e7ca63943d9457f82c"
    },
    {
      "baseHexagramNumber": 63,
      "changedHexagramNumber": 16,
      "sourceEntryNumber": 16,
      "sourceIconHexagramNumber": 16,
      "hexagramName": "豫",
      "poemText": "畏昏潛處，候時昭明。卒遭白日，為榮祿主。",
      "sourceParagraphSha256": "sha256:9f658bd9e49dc74f38c3c38b1cf73271fa80b2113d97d0ea83a3997b92bd7d21",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ebf83b8e76bacbd05da7642c7b019c6acd91c6f49c8b7af8983a82978e172d30"
    },
    {
      "baseHexagramNumber": 63,
      "changedHexagramNumber": 17,
      "sourceEntryNumber": 17,
      "sourceIconHexagramNumber": 17,
      "hexagramName": "隨",
      "poemText": "水流趍下，欲至東海。求我所有，買鮪與鯉。",
      "sourceParagraphSha256": "sha256:e155113d6e0429e2ee80df20d72480138b0895d7c51ce462faf147c0d9dd400e",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:71915525b6e0b06586e1cb2aa7bfc5d36816ebb29988e37be0a27e6f02ef670d"
    },
    {
      "baseHexagramNumber": 63,
      "changedHexagramNumber": 18,
      "sourceEntryNumber": 18,
      "sourceIconHexagramNumber": 18,
      "hexagramName": "蠱",
      "poemText": "冠帶南行，與福喜期。徼為嘉國，釋為逢時。",
      "sourceParagraphSha256": "sha256:9a43956c4c61034b791fb7ef1726300cab27c0b98b9186141d830fde7eb4e220",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:6b946b789c28f45ba157ceb73ac2adcd5a8faa25dc7a9a7c3b50d1a6198949f8"
    },
    {
      "baseHexagramNumber": 63,
      "changedHexagramNumber": 19,
      "sourceEntryNumber": 19,
      "sourceIconHexagramNumber": 19,
      "hexagramName": "臨",
      "poemText": "莎雞振羽，為季門戶。新沐彈冠，仲父悅喜。",
      "sourceParagraphSha256": "sha256:8a72b493820c8f6abd18b11b3fcec097bcd8066e6b488ec3a2884cf31235b3e8",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:9da1f64bff81854020eddf937707afb2c41355d06e683d135bd4209f65b6d53b"
    },
    {
      "baseHexagramNumber": 63,
      "changedHexagramNumber": 20,
      "sourceEntryNumber": 20,
      "sourceIconHexagramNumber": 20,
      "hexagramName": "觀",
      "poemText": "結衿流溺，遭讒桎梏。周召述職，身受大福。",
      "sourceParagraphSha256": "sha256:6eeec7ac8262ba3ae4f383076939faef868490a7dd9b45f9d68c15358d394e4f",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:1f8eb364ef71935771550188549019e7212fb83bff775fc380b65bb340561152"
    },
    {
      "baseHexagramNumber": 63,
      "changedHexagramNumber": 21,
      "sourceEntryNumber": 21,
      "sourceIconHexagramNumber": 21,
      "hexagramName": "噬嗑",
      "poemText": "田鼠野雞，意常欲逃。拘制籠檻，不得動搖。",
      "sourceParagraphSha256": "sha256:2c6bf523963a97d503682ae4229a0c66a4045a3fe356bd76d71e174a3fed857b",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:0dd401497cc31715ea20a4c3241d3f473c048d48aba0dfc91ad3660ee323fcfe"
    },
    {
      "baseHexagramNumber": 63,
      "changedHexagramNumber": 22,
      "sourceEntryNumber": 22,
      "sourceIconHexagramNumber": 22,
      "hexagramName": "賁",
      "poemText": "居華山巔，遊觀浮雲。有雨不濡，心樂無憂。",
      "sourceParagraphSha256": "sha256:573365d5ae89acf07023b1dc16f5c3c72242f93a85e19aa1b56179e359a620d8",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:854c569e01c274ae5e3476c56767447276999d3d71e6d071fc654cec63572c9a"
    },
    {
      "baseHexagramNumber": 63,
      "changedHexagramNumber": 23,
      "sourceEntryNumber": 23,
      "sourceIconHexagramNumber": 23,
      "hexagramName": "剝",
      "poemText": "傾倚將顛，亂不能存。英雄作業，家困無年。",
      "sourceParagraphSha256": "sha256:d74bf61acd6b8c73ffd5a87dd74c01297d3744fd729d802808b18fe327a7edfd",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:948ea33af737ca8edd66479a7a72c69ab5eaf869579436b9da8e7259c636ae26"
    },
    {
      "baseHexagramNumber": 63,
      "changedHexagramNumber": 24,
      "sourceEntryNumber": 24,
      "sourceIconHexagramNumber": 24,
      "hexagramName": "復",
      "poemText": "心願所喜，乃今逢時。保我利福，不離兵革。",
      "sourceParagraphSha256": "sha256:359298abc77a96fec0530032e50a2bbbcaa5f07f9e7c016e3bbca45b01ba64ab",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:9be838ebf41e0543b579fd723abaf6d4e5e339d0645f269d805d724758d537b0"
    },
    {
      "baseHexagramNumber": 63,
      "changedHexagramNumber": 25,
      "sourceEntryNumber": 25,
      "sourceIconHexagramNumber": 25,
      "hexagramName": "无妄",
      "poemText": "靈龜陸處，盤桓失所。阿衡退耕，夏封於國。",
      "sourceParagraphSha256": "sha256:1a6eeee12da4248bc8a81f60deebc79599bfe330f294ff8a37bc3fa1e3129d62",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:2efbad930f69665080375692c621af51c06b06a924b8457af5a9d16c3b6cf81c"
    },
    {
      "baseHexagramNumber": 63,
      "changedHexagramNumber": 26,
      "sourceEntryNumber": 26,
      "sourceIconHexagramNumber": 26,
      "hexagramName": "大畜",
      "poemText": "弱水之右，有西王母。生不知老，與天相保。不利行旅。",
      "sourceParagraphSha256": "sha256:9ea0e18954eef6054041bda39d7a63f7e75dbdc94d0a46a40c0d6a3f59b78045",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:759b6186fc3ccd910b10d6f07914ae8dd067340806036b62d94d1edf7d825a4e"
    },
    {
      "baseHexagramNumber": 63,
      "changedHexagramNumber": 27,
      "sourceEntryNumber": 27,
      "sourceIconHexagramNumber": 27,
      "hexagramName": "頤",
      "poemText": "抱瑰求金，日暮坐吟。終身卒歲，竟無成功。",
      "sourceParagraphSha256": "sha256:c9ffee4a1ec57ed43d1b0bb3646d0edcfbeea57f94cd011eaab825e2b269c040",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:35d07b66a9848dbfdb274671cb29217656b97c173184e32a73cc5cfe54161b1b"
    },
    {
      "baseHexagramNumber": 63,
      "changedHexagramNumber": 28,
      "sourceEntryNumber": 28,
      "sourceIconHexagramNumber": 28,
      "hexagramName": "大過",
      "poemText": "言笑未畢，憂來暴卒。身加檻纜，囚繫縛束。",
      "sourceParagraphSha256": "sha256:8a42281d5f1a1cb5f65d6eba7a6327e947970d66ccdee437d8587c9d6107e204",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:911fcb27537665c678c49d3ff608ba106655af3adc1e305db2e455e152aa9802"
    },
    {
      "baseHexagramNumber": 63,
      "changedHexagramNumber": 29,
      "sourceEntryNumber": 29,
      "sourceIconHexagramNumber": 29,
      "hexagramName": "坎",
      "poemText": "望幸不至，文章未成。王子逐兔，犬踦不得。",
      "sourceParagraphSha256": "sha256:3e529cf6b02ad21e6d4e5ed576bbf93fda5787113b49fbf0164dae5776437649",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:7e9a97299814bd1a457a3a889fa09e95ca2d4cacd44513390d2ff67e5ff96f9a"
    },
    {
      "baseHexagramNumber": 63,
      "changedHexagramNumber": 30,
      "sourceEntryNumber": 30,
      "sourceIconHexagramNumber": 30,
      "hexagramName": "離",
      "poemText": "震悚恐懼，多所畏忌。行道留難，不可以步。",
      "sourceParagraphSha256": "sha256:426aa51ab4a4281ea4ba298bcff3b979845c61d23f61efb180196bbba9a8433c",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:9d7c636e253757065501ba091a8ef3793cbd8f6452e2b95ce3580f28cead41de"
    },
    {
      "baseHexagramNumber": 63,
      "changedHexagramNumber": 31,
      "sourceEntryNumber": 31,
      "sourceIconHexagramNumber": 31,
      "hexagramName": "咸",
      "poemText": "雄狐綏綏，登山崔嵬。昭告顯功，大福允興。",
      "sourceParagraphSha256": "sha256:8f28f5a3914acdfd9fa10fe68cb734acf5aaf00ead116c4b3760ff375ef5e698",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:dc262ae300e75996f956af0fa2ea733338b213dcefb008117aa2b3a4d21a7886"
    },
    {
      "baseHexagramNumber": 63,
      "changedHexagramNumber": 32,
      "sourceEntryNumber": 32,
      "sourceIconHexagramNumber": 32,
      "hexagramName": "恒",
      "poemText": "火起吾後，喜炙我廡。倉龍含水，深潠吾柱，雖憂無咎。",
      "sourceParagraphSha256": "sha256:b465478ecc11087119b5a8f43799e126455aced437baa1585518c3a8e211645e",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:657079b5f60f988c96620f45b4282176fa7405b20c28fc3c909adcb3951a31b6"
    },
    {
      "baseHexagramNumber": 63,
      "changedHexagramNumber": 33,
      "sourceEntryNumber": 33,
      "sourceIconHexagramNumber": 33,
      "hexagramName": "遯",
      "poemText": "危坐至暮，請求不得。膏澤不降，政戾民忒。剝之頤，需之頤，漸之坎）",
      "sourceParagraphSha256": "sha256:c03347a67b530804157871a834da12bd839297e077b32545f2522257c2c8a8e3",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:e1ccf620124c57d6913e54190ed1560b8dd7c3c03c4eb83c2c46cef6ff52b0ec"
    },
    {
      "baseHexagramNumber": 63,
      "changedHexagramNumber": 34,
      "sourceEntryNumber": 34,
      "sourceIconHexagramNumber": 34,
      "hexagramName": "大壯",
      "poemText": "孟春和氣，鷹隼搏鷙，眾雀憂潰。",
      "sourceParagraphSha256": "sha256:580f68d8a234b558cc8ff40b014b32cce4e1d55281415683e953c3d7133eae4f",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:494cbb36f7e82b7d13a537ec6f06481c7d06312cd6d0ad7e20b53fa761f9f787"
    },
    {
      "baseHexagramNumber": 63,
      "changedHexagramNumber": 35,
      "sourceEntryNumber": 35,
      "sourceIconHexagramNumber": 35,
      "hexagramName": "晉",
      "poemText": "緩法長奸，不能理冤。沉湎失節，君受其患。",
      "sourceParagraphSha256": "sha256:0d4da7b058359c394bb4dd785b9ff12f1de7e7b55a05f30c438e1f01970aec72",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:de5e8a4ec1ee1504328c733ed6bd67a52ab21cd325abe1804888ffdb556f401f"
    },
    {
      "baseHexagramNumber": 63,
      "changedHexagramNumber": 36,
      "sourceEntryNumber": 36,
      "sourceIconHexagramNumber": 36,
      "hexagramName": "明夷",
      "poemText": "魚鱉貪餌，死於網釣。受危因寵，為身殃咎。",
      "sourceParagraphSha256": "sha256:838c1b4693d228f7b412c37c4d544dcede4720069bcab16543842d3229ae8f4e",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:a43e1248087bc5a4b519b390a61a1bb24381ba661f2e6ee6dfc5a98968792c16"
    },
    {
      "baseHexagramNumber": 63,
      "changedHexagramNumber": 37,
      "sourceEntryNumber": 37,
      "sourceIconHexagramNumber": 37,
      "hexagramName": "家人",
      "poemText": "金精耀怒，帶劍過午。徘徊高原，宿於山谷。兩虎相距，弓矢滿野。",
      "sourceParagraphSha256": "sha256:9f910486e5dacdebe2834d2e5ed2901065230b383195a1cf551fd2ab3ae6dad1",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:defa9e6cb7e015cceee08c1193cdf7d1409cba137d26ec7ec0bc4a1b6a7e1521"
    },
    {
      "baseHexagramNumber": 63,
      "changedHexagramNumber": 38,
      "sourceEntryNumber": 38,
      "sourceIconHexagramNumber": 38,
      "hexagramName": "睽",
      "poemText": "四目相望，精近同光，並坐鼓簧。",
      "sourceParagraphSha256": "sha256:102ae945a29f3b365faf90feb2989a3125b1684464e398fa519b27b304fc69cb",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:541ab2a3d28b312ae5480ed5294afcdf110ecab2fd950a9e039489d1a7fa6299"
    },
    {
      "baseHexagramNumber": 63,
      "changedHexagramNumber": 39,
      "sourceEntryNumber": 39,
      "sourceIconHexagramNumber": 39,
      "hexagramName": "蹇",
      "poemText": "茹芝餌黃，飲酒玉漿。與神流通，長無憂凶。",
      "sourceParagraphSha256": "sha256:0d68d1742ac842739fea5aff4a2039b73d2c60bee1f540c314214ba6d836dc47",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:4d6434551a8d82ce31b8e14f9eb6523356a18da8f6827292a9c263265eccc0f4"
    },
    {
      "baseHexagramNumber": 63,
      "changedHexagramNumber": 40,
      "sourceEntryNumber": 40,
      "sourceIconHexagramNumber": 40,
      "hexagramName": "解",
      "poemText": "求獐嘉鄉，惡蛇不行。豳岐口還，復反其床。",
      "sourceParagraphSha256": "sha256:eb13fba0f1a8fd3d46b42360a81bac1ba15ca1e8cda433c91d715390e0145176",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:76c853334c643b2c8fd9dc2c7bf9baa29e5b6c5b960702ea2a47e3713ca37f93"
    },
    {
      "baseHexagramNumber": 63,
      "changedHexagramNumber": 41,
      "sourceEntryNumber": 41,
      "sourceIconHexagramNumber": 41,
      "hexagramName": "損",
      "poemText": "天門地戶，幽冥不觀，不知所在。",
      "sourceParagraphSha256": "sha256:c9dd2693a87a93396693be43c9237ad83e81cf63d55a24e562d4002bc3d051c8",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:563a934e321603b03bf1f89a072c252e9a7905103221d57020b6a09e046b9af9"
    },
    {
      "baseHexagramNumber": 63,
      "changedHexagramNumber": 42,
      "sourceEntryNumber": 42,
      "sourceIconHexagramNumber": 42,
      "hexagramName": "益",
      "poemText": "跛足息肩，有所忌難。金城鐵郭，以銅為關。藩屏息衛，安止無患。遯之旅）",
      "sourceParagraphSha256": "sha256:83ccb328d32cfe62e172235823c8fa03e8cf0773689d17a75b3544ae921a0ab3",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:7031511f6b3b366ca0d7bb741e7c2246e434c4ff14c3185ebc29d7819bfbc9ad"
    },
    {
      "baseHexagramNumber": 63,
      "changedHexagramNumber": 43,
      "sourceEntryNumber": 43,
      "sourceIconHexagramNumber": 43,
      "hexagramName": "夬",
      "poemText": "三雁俱飛，欲歸稻池。經涉山澤，為矢所射。",
      "sourceParagraphSha256": "sha256:f4b46ec8538403d72c2145c708427c990c0e702c65816d3ba73c17799800b70e",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:f8d62fa9cc3f5c53bece8ae3a4491c9fc3ef794136beb4b3b344becf1016ef5f"
    },
    {
      "baseHexagramNumber": 63,
      "changedHexagramNumber": 44,
      "sourceEntryNumber": 44,
      "sourceIconHexagramNumber": 44,
      "hexagramName": "姤",
      "poemText": "濟深難渡，濡我衣褲。王子善濯，決無他故。",
      "sourceParagraphSha256": "sha256:41374bc9327faa88b097439823a2f7f39f1f3a60c8c5412c10e857867274e28f",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:590a3b93c20015639b584185f64ef28c3a17e05eb850ca9ad5554b6efe4f5c9d"
    },
    {
      "baseHexagramNumber": 63,
      "changedHexagramNumber": 45,
      "sourceEntryNumber": 45,
      "sourceIconHexagramNumber": 45,
      "hexagramName": "萃",
      "poemText": "飲酒醉飽，跳趨爭鬥。伯傷叔僵，東家治喪。",
      "sourceParagraphSha256": "sha256:6e139797b6bcaf35f3a0a27daa0673a5c9a7ab0708715d5221748a70eeca11f4",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:404d44f4b8573ba2c471674600aa58ff883e7599e126aca98105609bc5608065"
    },
    {
      "baseHexagramNumber": 63,
      "changedHexagramNumber": 46,
      "sourceEntryNumber": 46,
      "sourceIconHexagramNumber": 46,
      "hexagramName": "升",
      "poemText": "跛躓未起，失利後市。蒙被殃咎，不得鹿子。",
      "sourceParagraphSha256": "sha256:7f5fa8a79479f23da8cf759a564cd9e7b1614f59f0814f094c25ed207ee22ce3",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:31c0e4cbf5e3d883ef466e8e58de65d1f93e51b7697de213e102ed2261d2e2a6"
    },
    {
      "baseHexagramNumber": 63,
      "changedHexagramNumber": 47,
      "sourceEntryNumber": 47,
      "sourceIconHexagramNumber": 47,
      "hexagramName": "困",
      "poemText": "辰次降婁，建星中堅。子無遠行，外顛霄陷，遂合訖終。",
      "sourceParagraphSha256": "sha256:dd884d2d2b09d72e4cfe70739b193e669b12d5cfdb161b2261cd4029ad5c0258",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:e9458ab3a32cd4968eefc74d05e27c2ffd606959add9990c5d80dcbdee87d75a"
    },
    {
      "baseHexagramNumber": 63,
      "changedHexagramNumber": 48,
      "sourceEntryNumber": 48,
      "sourceIconHexagramNumber": 48,
      "hexagramName": "井",
      "poemText": "商風召寇，來呼外盜。間諜內應，與我爭鬥。殫己寶藏，主人不勝。",
      "sourceParagraphSha256": "sha256:c9024b14b0d41cafa03986f148e1b77b811339076930efc24b37065d38abee0d",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:bdae0df8579898bf23a9c61d4adf791d6718d0bb82c3657631f0a39530e4a8dd"
    },
    {
      "baseHexagramNumber": 63,
      "changedHexagramNumber": 49,
      "sourceEntryNumber": 49,
      "sourceIconHexagramNumber": 49,
      "hexagramName": "革",
      "poemText": "甘露醴泉，太平機關。仁德感應，歲樂民安。",
      "sourceParagraphSha256": "sha256:82990b2ee297ade1fca753a704252ef232f7da0b6e71a558822054c086124844",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:3470f5fbb8955747676dfa44a292e438454755f30e88f79f7bf02df9d64cbe92"
    },
    {
      "baseHexagramNumber": 63,
      "changedHexagramNumber": 50,
      "sourceEntryNumber": 50,
      "sourceIconHexagramNumber": 50,
      "hexagramName": "鼎",
      "poemText": "蔡仲子突，要門逐急。禍起子傷，弟伐其兄，鄭文不昌。",
      "sourceParagraphSha256": "sha256:52d7a0e72d1882fb4a02e8fbe9cfa5cd857d0fb1bb0dbc36a2bc31fb286dfe01",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:da9fc6789a46a42cd1e4ba1673f555d7e78171f7d3f6d50bba1562dfa169414b"
    },
    {
      "baseHexagramNumber": 63,
      "changedHexagramNumber": 51,
      "sourceEntryNumber": 51,
      "sourceIconHexagramNumber": 51,
      "hexagramName": "震",
      "poemText": "反孽難步，留不及舍。露宿澤陂，亡其襦褲。",
      "sourceParagraphSha256": "sha256:4eb3bf40e96bd8be9d39aec92ec5483ba3c50887b5b6388091b25507a4f59ee8",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:09517e330e3c8cd5b4994e2382eae339f07e7010866002d0ae454be763d751ee"
    },
    {
      "baseHexagramNumber": 63,
      "changedHexagramNumber": 52,
      "sourceEntryNumber": 52,
      "sourceIconHexagramNumber": 52,
      "hexagramName": "艮",
      "poemText": "狼虎結謀，相聚為保。伺候牛羊，病我商人。",
      "sourceParagraphSha256": "sha256:939312f56fd8970f1311fb0b2be48f5996321b0f98cc1ac65ae4eb05248fa1f2",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:c5013788a4696392846d14f365d1e418a753bc82abfb7bbac04a51ab5ace1655"
    },
    {
      "baseHexagramNumber": 63,
      "changedHexagramNumber": 53,
      "sourceEntryNumber": 53,
      "sourceIconHexagramNumber": 53,
      "hexagramName": "漸",
      "poemText": "明德克敏，乘興貢舉。放勳御用，乂哲蒙祐。",
      "sourceParagraphSha256": "sha256:f20f33eaee6fbfafaa1e82480d97b72740a0e08fda3d297fd15cbe123b6a457e",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:d9de75d88dc589a896f586c8692d8a80a910e3e129498d4e27c21fb84b250b9d"
    },
    {
      "baseHexagramNumber": 63,
      "changedHexagramNumber": 54,
      "sourceEntryNumber": 54,
      "sourceIconHexagramNumber": 54,
      "hexagramName": "歸妹",
      "poemText": "貧鬼守門，日破我盆。毀罌破甕，空虛無子。",
      "sourceParagraphSha256": "sha256:8867307273124119c65c5e600d576e34fcafdcefa4290c3781281e791b160bd2",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:182a382cc04634e35d97a1169014cf6af10057a4f0586722af50efdddffecf4e"
    },
    {
      "baseHexagramNumber": 63,
      "changedHexagramNumber": 55,
      "sourceEntryNumber": 55,
      "sourceIconHexagramNumber": 55,
      "hexagramName": "豐",
      "poemText": "天命赤烏，與兵徼期。征伐無道，箕子遨遊。",
      "sourceParagraphSha256": "sha256:18fb7ec9d514dd2643944ca9afc0ea9787e939209e755df431bbf773ab22018c",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ef920ecd2269d8362040f60db7d67e508db85e3c08f544a22476995d0d9ecefc"
    },
    {
      "baseHexagramNumber": 63,
      "changedHexagramNumber": 56,
      "sourceEntryNumber": 56,
      "sourceIconHexagramNumber": 56,
      "hexagramName": "旅",
      "poemText": "威約拘囚，為人所誣。皋陶平理，剖械出牢，脫歸家閭。",
      "sourceParagraphSha256": "sha256:fecdbfb485cd04c3e635bf55afea94669a8a0343af597559ff3e917b75ec51e3",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:572727f6952b4476b5a2aa289046c49511b34d83f873df580ced4b11e99ebffa"
    },
    {
      "baseHexagramNumber": 63,
      "changedHexagramNumber": 57,
      "sourceEntryNumber": 57,
      "sourceIconHexagramNumber": 57,
      "hexagramName": "巽",
      "poemText": "羊驚虎狼，聳耳群聚。無益威僵，為齒所傷。",
      "sourceParagraphSha256": "sha256:f96380846c288d4dfffeeae3c3883ab3d0adfc6aed8d587861ed251ebf42a406",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:4a54c334234eef31152892050b61aed68626fedfc929b40fd79fd68cf63d98c9"
    },
    {
      "baseHexagramNumber": 63,
      "changedHexagramNumber": 58,
      "sourceEntryNumber": 58,
      "sourceIconHexagramNumber": 58,
      "hexagramName": "兌",
      "poemText": "初雖啼號，後必慶笑。光明照耀，百嘉如意。",
      "sourceParagraphSha256": "sha256:d085a46ae40557ec49ffd94bde61d987c17a89809d8a009bb9cb694ad029ea8a",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:649c4010342ce78a878f7abf789aa09061216c50eb8f70346430b9820afbe0a1"
    },
    {
      "baseHexagramNumber": 63,
      "changedHexagramNumber": 59,
      "sourceEntryNumber": 59,
      "sourceIconHexagramNumber": 59,
      "hexagramName": "渙",
      "poemText": "馬服長股，宜行善市。蒙祐諧耦，獲金五倍。",
      "sourceParagraphSha256": "sha256:f866262dd3270eacf4118be6311e5f00c39b5b5353ab28f1c3c28f4410d71009",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:c77a5087bc0a69a3dfd0a8cd94691e49aefe7ba1f62e85feda51f650f6920563"
    },
    {
      "baseHexagramNumber": 63,
      "changedHexagramNumber": 60,
      "sourceEntryNumber": 60,
      "sourceIconHexagramNumber": 60,
      "hexagramName": "節",
      "poemText": "應門內崩，誅賢殺暴。上下咸愜，景公失位。長歸元洹，望妻不來。",
      "sourceParagraphSha256": "sha256:bebb63759f35c8c08e4b61646f3658804068e6da6f3bf9b27a056279ab794844",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:08e6c88659d3e05974bc9c6583f6f96233d5bb7918cab35f1e5a9be2c0131dca"
    },
    {
      "baseHexagramNumber": 63,
      "changedHexagramNumber": 61,
      "sourceEntryNumber": 61,
      "sourceIconHexagramNumber": 61,
      "hexagramName": "中孚",
      "poemText": "執斧破薪，使媒求婦。好合二姓，親御斯酒。色比毛嬙，姑悅公喜。",
      "sourceParagraphSha256": "sha256:71b24b8e378236616b112b3fba6d0f7466336f8cf4ad143d1eb13574459d32ac",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ae183d4523450d66e4344b149c14c98695857eca6b3da2c5d1d8c48a0f167c82"
    },
    {
      "baseHexagramNumber": 63,
      "changedHexagramNumber": 62,
      "sourceEntryNumber": 62,
      "sourceIconHexagramNumber": 62,
      "hexagramName": "小過",
      "poemText": "兩輪日轉，南上大阪。四馬共轅，無有險難，與禹笑言。",
      "sourceParagraphSha256": "sha256:3a5a13aa28690beba4ea4c2ff3344c5ef7793ec2831576d42a2c70405fecd5cf",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:18deae0d5730e5e5f4cb3b26d7f45064d1317f547a13d2986cd25c746cd0e57b"
    },
    {
      "baseHexagramNumber": 63,
      "changedHexagramNumber": 64,
      "sourceEntryNumber": 64,
      "sourceIconHexagramNumber": 64,
      "hexagramName": "未濟",
      "poemText": "千柱百梁，終不傾僵，周家寧康。",
      "sourceParagraphSha256": "sha256:ad648173d49e284ea8c4af8ce6e9d8d0660e56d24a30df49826a3cf6380be220",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:e5ae14d15814675ebabf1341fd93fe295f2c4d6b2001caea616357cc79aae7de"
    }
  ]
}
