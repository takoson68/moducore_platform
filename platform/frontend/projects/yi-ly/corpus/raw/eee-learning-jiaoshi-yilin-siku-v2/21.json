  "entryCount": 64,
  "missingTargets": [],
  "entries": [
    {
      "baseHexagramNumber": 21,
      "changedHexagramNumber": 21,
      "sourceEntryNumber": 21,
      "sourceIconHexagramNumber": 21,
      "hexagramName": "噬嗑",
      "poemText": "麒麟鳳凰，善政得祥。陰陽和調，國無災殃。",
      "sourceParagraphSha256": "sha256:a3c42378157e8d041042cdbf6d7db82c99999cebcd4c3d5cc31574c6d60bcb2f",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:f560265add2dc2fd57cb98b0ff06081e7122d18f8935109ec55a95aaadcedd45"
    },
    {
      "baseHexagramNumber": 21,
      "changedHexagramNumber": 1,
      "sourceEntryNumber": 1,
      "sourceIconHexagramNumber": 1,
      "hexagramName": "乾",
      "poemText": "北風相牽，提笑語言。伯歌叔舞，燕樂以喜。",
      "sourceParagraphSha256": "sha256:c39a70daa25a57541c37992928fe7757a6e6d49fc1cb92fc8874d107e1121d23",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:b6cbab699f537f9d13aa8866f145be207cf4215af465467091d2212108012362"
    },
    {
      "baseHexagramNumber": 21,
      "changedHexagramNumber": 2,
      "sourceEntryNumber": 2,
      "sourceIconHexagramNumber": 2,
      "hexagramName": "坤",
      "poemText": "甲戊己庚，隨時運行。不失常節，咸逢出生。各樂其類，達性任情。",
      "sourceParagraphSha256": "sha256:106f7dddb5bf9fb0a89508cf4a7907a532f7d8b0d2915723653b5c904e2fbb1f",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:305123af25eb115ade9264e867b2dbd8bb944ff8994e9110a274dbca955f76c6"
    },
    {
      "baseHexagramNumber": 21,
      "changedHexagramNumber": 3,
      "sourceEntryNumber": 3,
      "sourceIconHexagramNumber": 3,
      "hexagramName": "屯",
      "poemText": "破亡之虛，神所憂衰。進德無光，留止有慶。",
      "sourceParagraphSha256": "sha256:41ae9c4336ef53b720e5e9bcc793030726f8cce1a747e941cf15736693a9553d",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ad893da8d73365f89a91c6c50a42d4dd42e8afce1b7b4f224a176c699587fd96"
    },
    {
      "baseHexagramNumber": 21,
      "changedHexagramNumber": 4,
      "sourceEntryNumber": 4,
      "sourceIconHexagramNumber": 4,
      "hexagramName": "蒙",
      "poemText": "注斯膏澤，祈衛百毒。防以江南，虺不能螫。",
      "sourceParagraphSha256": "sha256:2433eb48d7936dc36ac4620695b09c2b461453e5617db557984bc1162513b37d",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:a7df9b73457b90701d1a6d7b23e8dc4613fb985eacf775a07105ec980b5b3d41"
    },
    {
      "baseHexagramNumber": 21,
      "changedHexagramNumber": 5,
      "sourceEntryNumber": 5,
      "sourceIconHexagramNumber": 5,
      "hexagramName": "需",
      "poemText": "日月相望，光輝盛昌。三聖成功，仁德大降。",
      "sourceParagraphSha256": "sha256:3217e0ac4e91a720f537d956143aa839340de93aced4b7a6968dca5ad18e744c",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:5958524a8ec4c0796ba17c8359c39b2b6efa4e9a4eb5dda750cd21ccecbf5a61"
    },
    {
      "baseHexagramNumber": 21,
      "changedHexagramNumber": 6,
      "sourceEntryNumber": 6,
      "sourceIconHexagramNumber": 6,
      "hexagramName": "訟",
      "poemText": "大蛇巨魚，戰於國郊。上下濟塞，衛侯廬漕。",
      "sourceParagraphSha256": "sha256:910a962e67cb479ce35847d091f75f8054c1b51d3c2279d36e8577f7a136dcbf",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:e28ad38b6ef5c562278db35633cd2dea76f520f65e90e42b1e2a61957f7b7fb5"
    },
    {
      "baseHexagramNumber": 21,
      "changedHexagramNumber": 7,
      "sourceEntryNumber": 7,
      "sourceIconHexagramNumber": 7,
      "hexagramName": "師",
      "poemText": "龍入天關，經歷九山。登高上下，道里險難。日晏不食，絕無甘酸。",
      "sourceParagraphSha256": "sha256:4b69ac5b7f31981d00a7ccf667c163982e4589d259177aee09790c8041dbbe2e",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ee98acb8a612d914d7c199f3d73aafad17e9f6defbb58745f46df853143cc634"
    },
    {
      "baseHexagramNumber": 21,
      "changedHexagramNumber": 8,
      "sourceEntryNumber": 8,
      "sourceIconHexagramNumber": 8,
      "hexagramName": "比",
      "poemText": "沙漠北塞，純無水泉。君子征凶，役夫力殫。",
      "sourceParagraphSha256": "sha256:cd5516d5e6bdfa045f4b34498cd16445cbb04d4ab103367bc8df9055b28e93d8",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:03da56ae7f7e924bc76c8c38da8fba332700c6e74680856a6f2c0270b7dca486"
    },
    {
      "baseHexagramNumber": 21,
      "changedHexagramNumber": 9,
      "sourceEntryNumber": 9,
      "sourceIconHexagramNumber": 9,
      "hexagramName": "小畜",
      "poemText": "關柝門啟，衿帶解墮。福與善生，憂不為禍。",
      "sourceParagraphSha256": "sha256:150d2ec15053a9beb42f84c737d324aa99a91d668eb4c4aab8bf7da631247890",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:df805d40dd62656122cc64f256d3cbb0afdf2ed4f266ed1e755b7f7e84b3de49"
    },
    {
      "baseHexagramNumber": 21,
      "changedHexagramNumber": 10,
      "sourceEntryNumber": 10,
      "sourceIconHexagramNumber": 10,
      "hexagramName": "履",
      "poemText": "狼虎所嗥，患害必遭。不利有為，宜以遁逃。",
      "sourceParagraphSha256": "sha256:7691d18f6cddee9972b80d84fac1cd9fb4626846b62ef99382ce703432ca0fbc",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:dfa9e13ec995b63a61f685e6aba06736fd6b231c4d131671caf0d005ca97415a"
    },
    {
      "baseHexagramNumber": 21,
      "changedHexagramNumber": 11,
      "sourceEntryNumber": 11,
      "sourceIconHexagramNumber": 11,
      "hexagramName": "泰",
      "poemText": "金精耀怒，帶劍過午。兩虎相距，弓弩滿野，雖憂無咎。",
      "sourceParagraphSha256": "sha256:8bb7487c5f5d100a11931991f55820e05142dbf7a75f4597f3be129cd99dd037",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:0c41d5229d883964886d75aabf5183bce8afec10c7a02a16b82eb48cffbb6da5"
    },
    {
      "baseHexagramNumber": 21,
      "changedHexagramNumber": 12,
      "sourceEntryNumber": 12,
      "sourceIconHexagramNumber": 12,
      "hexagramName": "否",
      "poemText": "朽根枯樹，華葉落去。卒逢火焱，相隨偃仆。",
      "sourceParagraphSha256": "sha256:120df90b63514a18c0276b0ab3b06ceea77c44305da5b4187647f207ac9c805f",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:26d97f95a0c473e152e7420ef0f199a9ccc6c3f9c4b4b06ae38434b74e8e4d72"
    },
    {
      "baseHexagramNumber": 21,
      "changedHexagramNumber": 13,
      "sourceEntryNumber": 13,
      "sourceIconHexagramNumber": 13,
      "hexagramName": "同人",
      "poemText": "入和出暗，動作有光。轉運休息，常樂允康。",
      "sourceParagraphSha256": "sha256:3a7f0756d8c9b83c108b8c5120a9e48fffe9dc9fe78386b014300443293b9ab7",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:83f1b202f9d568c6f76207448e046d5f957ebdcb348ecd3ca5c35d000c87d231"
    },
    {
      "baseHexagramNumber": 21,
      "changedHexagramNumber": 14,
      "sourceEntryNumber": 14,
      "sourceIconHexagramNumber": 14,
      "hexagramName": "大有",
      "poemText": "國多忌諱，大人恆畏。結口無患，可以長存。",
      "sourceParagraphSha256": "sha256:fd30ea7f75dcb33b1adc0f7aa23321f6818a9f1da849a12dc318ef3ef3dd627b",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:d9e21b694990ca95f815d1ba60f1fe15ec2b9a87f355e7b9b83f43533f1c1913"
    },
    {
      "baseHexagramNumber": 21,
      "changedHexagramNumber": 15,
      "sourceEntryNumber": 15,
      "sourceIconHexagramNumber": 15,
      "hexagramName": "謙",
      "poemText": "天地淳亨，六合光明。陰序陽順，厥功以成。",
      "sourceParagraphSha256": "sha256:9bd329a7c3f77af7d34cd36d5e6b3794b9e2a59108eab8e089d8ce59bbe54f9a",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:8cb47024f3277f877dbfec2805d69db244603b44f035346018b08077b044b91b"
    },
    {
      "baseHexagramNumber": 21,
      "changedHexagramNumber": 16,
      "sourceEntryNumber": 16,
      "sourceIconHexagramNumber": 16,
      "hexagramName": "豫",
      "poemText": "裸裎逐狐，為人觀笑。牝雞鳴晨，主作亂妖。",
      "sourceParagraphSha256": "sha256:5f230aaa1f09d6fe66c312cd746f2d6efaab50782b68e7c4df22c0ed893d9932",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:c4650bf3e4ae43a34e426774b3829f94f6a8d79578ff8621ed46f5a80ec76c07"
    },
    {
      "baseHexagramNumber": 21,
      "changedHexagramNumber": 17,
      "sourceEntryNumber": 17,
      "sourceIconHexagramNumber": 17,
      "hexagramName": "隨",
      "poemText": "陰失陽復，桀失其室，相餧不食。",
      "sourceParagraphSha256": "sha256:5330c9229a9fae4c399b5f1fb0ff252aac5dd22c76660a0207d49f1fdd4865cd",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:365c53bd534f4584a881fe41de71fc2acb6ec7f32afe581711de7b181b1105ed"
    },
    {
      "baseHexagramNumber": 21,
      "changedHexagramNumber": 18,
      "sourceEntryNumber": 18,
      "sourceIconHexagramNumber": 18,
      "hexagramName": "蠱",
      "poemText": "蜎飛蠢動，各有配偶。大小相保，咸得其所。",
      "sourceParagraphSha256": "sha256:90d551f3d133f11a07d2cd149bcc7fb68a4b822d82bfbf9627bdcde7fd124af3",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:5d3246bacd1b10ca20b8e06c2cd51cdd0a9e5894b3563c8ca5b5503369b8c090"
    },
    {
      "baseHexagramNumber": 21,
      "changedHexagramNumber": 19,
      "sourceEntryNumber": 19,
      "sourceIconHexagramNumber": 19,
      "hexagramName": "臨",
      "poemText": "鬼守我廬，欲呼伯去。曾孫壽考，司命不許。與生相保。",
      "sourceParagraphSha256": "sha256:2cebbf933204eafbd73266c38e70a17fa6c30a20b21397bc1bb2f5b580df9b5f",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:aacf883bf3bf716b0031159576512098363671e7e05ff968f31c751d70eb42e0"
    },
    {
      "baseHexagramNumber": 21,
      "changedHexagramNumber": 20,
      "sourceEntryNumber": 20,
      "sourceIconHexagramNumber": 20,
      "hexagramName": "觀",
      "poemText": "禍走患伏，喜為我福。凶惡消亡，災害不作。",
      "sourceParagraphSha256": "sha256:23d881a4f79c24cec79e144bb556be55e9b27f766dcd613d9055ef329f0a8b76",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ee6208ada22e3c9e47c90a89521d182f23d1991e3a249b7c2bd9ef48d143feeb"
    },
    {
      "baseHexagramNumber": 21,
      "changedHexagramNumber": 22,
      "sourceEntryNumber": 22,
      "sourceIconHexagramNumber": 22,
      "hexagramName": "賁",
      "poemText": "智不別揚，張誑妄行。陷淵仆顛，傷殺伯身。",
      "sourceParagraphSha256": "sha256:fe3b984a8356233b480c052702b6cce52ec47c67813701c1ddfab6eaca18e5ad",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ad2a9681c5f1e583454f184614ba5fe8605e759643bf5663620003a6bac10038"
    },
    {
      "baseHexagramNumber": 21,
      "changedHexagramNumber": 23,
      "sourceEntryNumber": 23,
      "sourceIconHexagramNumber": 23,
      "hexagramName": "剝",
      "poemText": "凶憂災殃，日益明章。禍不可救，三都夷傷。",
      "sourceParagraphSha256": "sha256:7a48c67d7b49690e2355764e012af8bd83ada85a14ddd674948318c6440a1135",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:d585b220737b40bcfe5a9c36dd2d10226e61b9f5eb92dba0ee52b62c7c9c851a"
    },
    {
      "baseHexagramNumber": 21,
      "changedHexagramNumber": 24,
      "sourceEntryNumber": 24,
      "sourceIconHexagramNumber": 24,
      "hexagramName": "復",
      "poemText": "長尾蜲蛇，畫地為河。深不可涉，絕無以北。悵然憤息。",
      "sourceParagraphSha256": "sha256:e0df7d94337832c48174b8d367c24a317932d7bc4b8d1142e11129c5baad14e4",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:2e016342b78ab1d4f6cb0c44785cb57c53681a5b0761a3ebd10c28f7ed2e4e8e"
    },
    {
      "baseHexagramNumber": 21,
      "changedHexagramNumber": 25,
      "sourceEntryNumber": 25,
      "sourceIconHexagramNumber": 25,
      "hexagramName": "无妄",
      "poemText": "愛我嬰女，牽引不與。冀幸高貴，反曰下賤。",
      "sourceParagraphSha256": "sha256:6c496c2b23b268ed021861640e87548e461697c1e3b4f2c241534ddd1e630e2b",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:4b2154f85f91a487f454667802ce0e7bf49f77a093c75736d0e573412bc0a49e"
    },
    {
      "baseHexagramNumber": 21,
      "changedHexagramNumber": 26,
      "sourceEntryNumber": 26,
      "sourceIconHexagramNumber": 26,
      "hexagramName": "大畜",
      "poemText": "鳧游江湖，甘樂其餌。既不近人，雖驚不駭。",
      "sourceParagraphSha256": "sha256:ea0b7fa81f21239bfb3286309007732069d178ae1707a7444074f02e880e5367",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:8bc1a4cbd1f83a8fd73e4cf4e53faaa1b7b4d67a0abfbce4929909b9c67a3fa8"
    },
    {
      "baseHexagramNumber": 21,
      "changedHexagramNumber": 27,
      "sourceEntryNumber": 27,
      "sourceIconHexagramNumber": 27,
      "hexagramName": "頤",
      "poemText": "明滅光息，不能復食。精魄既喪，以夜為室。",
      "sourceParagraphSha256": "sha256:1e4902380b2e39ec84f4f730f218fe5f2d61a859c74bcc8b34650c6ad49b71eb",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:f8172eb3f1a7d113a7ea8821b7dc5a47b63225c833e188d3972eb8c004697e9b"
    },
    {
      "baseHexagramNumber": 21,
      "changedHexagramNumber": 28,
      "sourceEntryNumber": 28,
      "sourceIconHexagramNumber": 28,
      "hexagramName": "大過",
      "poemText": "奇適無偶，習靜獨處。所願不從，心思勞苦。",
      "sourceParagraphSha256": "sha256:37f1cf613c93fbf95f9291e108961e28064988fb7afcc8698bd7d547a2184e68",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:a7bc11a6fbddd9ffe9c256b311bcd236d6d96e6f00576350bb894d17891aae61"
    },
    {
      "baseHexagramNumber": 21,
      "changedHexagramNumber": 29,
      "sourceEntryNumber": 29,
      "sourceIconHexagramNumber": 29,
      "hexagramName": "坎",
      "poemText": "葛藟蒙棘，花不得實。讒 亂政，使忠壅塞。",
      "sourceParagraphSha256": "sha256:14a633f2f47220ab90c8c304ff200b8d21a8d56e64511ce1ac7a27918121133a",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:0fed106823fa35b6b5e1a66c577f4836394bbf44e3b8bbbb2a3199316eebd890"
    },
    {
      "baseHexagramNumber": 21,
      "changedHexagramNumber": 30,
      "sourceEntryNumber": 30,
      "sourceIconHexagramNumber": 30,
      "hexagramName": "離",
      "poemText": "鵲笑鳩舞，來遺我酒。大喜在後，授我龜紐。龍喜張口，超拜福祉。",
      "sourceParagraphSha256": "sha256:2767167bcd4bc9e3b7a672912aea71dd62395d32397f968b679ba2d5925bb9e8",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:5b44d7c7df980890901edae0a3fb33b2236d5f5de2981b966d228f260ee1ab8f"
    },
    {
      "baseHexagramNumber": 21,
      "changedHexagramNumber": 31,
      "sourceEntryNumber": 31,
      "sourceIconHexagramNumber": 31,
      "hexagramName": "咸",
      "poemText": "搖尾逐災，雲孽辟除。洿泥生粱，下為田主。",
      "sourceParagraphSha256": "sha256:486f536cea9198f24b689ce6c302b0968e5cf6624c76bfc01f0d6636e71b6874",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:fd1d6f8cd6d4d82e7215b1f3c3c71cc5d829b353b27bc839e2d31f0cc0b1bfd1"
    },
    {
      "baseHexagramNumber": 21,
      "changedHexagramNumber": 32,
      "sourceEntryNumber": 32,
      "sourceIconHexagramNumber": 32,
      "hexagramName": "恒",
      "poemText": "白鶴銜珠，夜食為明。膏潤優渥，國歲年豐。",
      "sourceParagraphSha256": "sha256:c2b5a5c63f370a2fdb3f75784cf6d0effff2accae94262dafee9730d709109a1",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:5a57ad906429cbc35228f54854219786335904e95fd9641f5be85b8624d40ab5"
    },
    {
      "baseHexagramNumber": 21,
      "changedHexagramNumber": 33,
      "sourceEntryNumber": 33,
      "sourceIconHexagramNumber": 33,
      "hexagramName": "遯",
      "poemText": "內執柔德，止訟以默。宗邑賴德，禍災不作。",
      "sourceParagraphSha256": "sha256:f63bd0839cdd3a327fbcea3844e3963921886619dfbf1bd7a20131f9f3e6ceda",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:92f1a95c3ad18b118baf57872cb1f99c51138578ecf22c2a6d28a671fe9ac2d9"
    },
    {
      "baseHexagramNumber": 21,
      "changedHexagramNumber": 34,
      "sourceEntryNumber": 34,
      "sourceIconHexagramNumber": 34,
      "hexagramName": "大壯",
      "poemText": "犬吠驚駭，公拔戈起。元冥厭火，消散瓦解。",
      "sourceParagraphSha256": "sha256:45ea4676e7dbd404a16db064ab0e1f4eb8427962e4b0073b2510510f87758024",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:d25c75ee9c478dbb9d7bff2068835691a4f56acc31ff2574c4974a030a198ee7"
    },
    {
      "baseHexagramNumber": 21,
      "changedHexagramNumber": 35,
      "sourceEntryNumber": 35,
      "sourceIconHexagramNumber": 35,
      "hexagramName": "晉",
      "poemText": "公悅嫗喜，子孫俱在。榮譽日登，福祿來處。",
      "sourceParagraphSha256": "sha256:2e205d597649c0f605ddc63aef86c122ff267566d728669c8c585924656e3c79",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:33730716cf915e9a207fe71b5295aa4cc0862a8a8d0033f24319ed76d055dd84"
    },
    {
      "baseHexagramNumber": 21,
      "changedHexagramNumber": 36,
      "sourceEntryNumber": 36,
      "sourceIconHexagramNumber": 36,
      "hexagramName": "明夷",
      "poemText": "鳥鳴捕 ，長欲飛去。循枝上下，適與風遇。顛損樹根，命不可救。",
      "sourceParagraphSha256": "sha256:9349f54132c27654cbff0dea3fcd5b8a3f6fc4179387ae092046c8f200bf0ae3",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:367221c6bf90a5672372be6eaee2ecb7e8a9b38a137e094dfef591218e93f250"
    },
    {
      "baseHexagramNumber": 21,
      "changedHexagramNumber": 37,
      "sourceEntryNumber": 37,
      "sourceIconHexagramNumber": 37,
      "hexagramName": "家人",
      "poemText": "析薪熾酒，使媒求婦。和合齊宋，姜子悅喜。",
      "sourceParagraphSha256": "sha256:e396e00fba27f3df2f1520ad742c08103ccf5295cd76f9e3770de8df43e2a861",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:29834248a98fee4e158e39ec2c262cd1a2309bc091b985ebdd09a73faeefeffa"
    },
    {
      "baseHexagramNumber": 21,
      "changedHexagramNumber": 38,
      "sourceEntryNumber": 38,
      "sourceIconHexagramNumber": 38,
      "hexagramName": "睽",
      "poemText": "鄰不我顧，而望玉女。身多疣癩，誰當媚者。",
      "sourceParagraphSha256": "sha256:24cee0a0456cc7f25ba1aa0ee86c246a239cd4e4f30125d2e80bc2e020e0a720",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:60072e9757bf1de6caf152c86cebc28ce81f6f1b011b9c03574487f5d98b4f7c"
    },
    {
      "baseHexagramNumber": 21,
      "changedHexagramNumber": 39,
      "sourceEntryNumber": 39,
      "sourceIconHexagramNumber": 39,
      "hexagramName": "蹇",
      "poemText": "遠視無光，不知青黃。黈纊塞耳，使君闇聾。",
      "sourceParagraphSha256": "sha256:6827fb942cadda22b89394ffc3cf27b9a67e3eae9d695341e12e3eea956382a2",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:3c8e1f36ffbb87977cc8473541de5511de535247f38d46da6d3841d53b80664b"
    },
    {
      "baseHexagramNumber": 21,
      "changedHexagramNumber": 40,
      "sourceEntryNumber": 40,
      "sourceIconHexagramNumber": 40,
      "hexagramName": "解",
      "poemText": "剋身整己，逢禹巡狩。賜我元圭，蒙受福祐。",
      "sourceParagraphSha256": "sha256:285497c470a0959cf941b4b25caf1b7aad055e782968751096ca9f20611241b7",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:3f424e468db50583f0aa41b9cf0e6d8609473ab2921c1d8f2fca93eeb8ea641b"
    },
    {
      "baseHexagramNumber": 21,
      "changedHexagramNumber": 41,
      "sourceEntryNumber": 41,
      "sourceIconHexagramNumber": 41,
      "hexagramName": "損",
      "poemText": "遠望千里，不見黑子。離婁之明，無益於光。",
      "sourceParagraphSha256": "sha256:40107fcdafa616be29713507bd7ce44ed78a910f23e78a67081d021e8bbb6170",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:643572e34a06906c654a427552b49e2ded0231185d622ad959b674756667b771"
    },
    {
      "baseHexagramNumber": 21,
      "changedHexagramNumber": 42,
      "sourceEntryNumber": 42,
      "sourceIconHexagramNumber": 42,
      "hexagramName": "益",
      "poemText": "斧斤所斫，瘡疣不息。鍼口不施，下即空室。",
      "sourceParagraphSha256": "sha256:0342e008f9cdb34c3c0ed7bd374b724e788e17ea904e4d4c9fc68c8371fe901e",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:6cd0b18c2a9e4901827dd9b9ac62712dd849c1f30cc96ca243292d811dc11eaf"
    },
    {
      "baseHexagramNumber": 21,
      "changedHexagramNumber": 43,
      "sourceEntryNumber": 43,
      "sourceIconHexagramNumber": 43,
      "hexagramName": "夬",
      "poemText": "齊侯少子，才略美好。求我長女，賤薄不與。反得醜陋，後乃大悔。",
      "sourceParagraphSha256": "sha256:4f02b9503e48d1b0f94fe582a3ff1d730df6a62abea3d4793971748ad24bbbd5",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:0de0775c9bc89364d66e15d5a47bdb5b4e8b210efd19863a622710501dd27feb"
    },
    {
      "baseHexagramNumber": 21,
      "changedHexagramNumber": 44,
      "sourceEntryNumber": 44,
      "sourceIconHexagramNumber": 44,
      "hexagramName": "姤",
      "poemText": "失儷後旅，天門地戶。不知所在，安止無咎。",
      "sourceParagraphSha256": "sha256:d6f12fa2ac657bc74cd445f38dbd9dc04e9c4c871592089c1154c4ef4ce4b676",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:0b542f91a39453ddee347499e17557787642623ee066083ebd5abba3d9470688"
    },
    {
      "baseHexagramNumber": 21,
      "changedHexagramNumber": 45,
      "sourceEntryNumber": 45,
      "sourceIconHexagramNumber": 45,
      "hexagramName": "萃",
      "poemText": "烏孫氏女，深目黑醜。嗜欲不同，過時無咎。",
      "sourceParagraphSha256": "sha256:8a81b19c1b29f41a0b8c55201445f3a34df45890672d17151f29bb1c7f3dc1e8",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:08b973bf3d84ce5a1f3edcd6489edb1f6288ef79947fac07c3d1190458ed4864"
    },
    {
      "baseHexagramNumber": 21,
      "changedHexagramNumber": 46,
      "sourceEntryNumber": 46,
      "sourceIconHexagramNumber": 46,
      "hexagramName": "升",
      "poemText": "伯駕純騮，南至東華。求索車馬，道闕中止。",
      "sourceParagraphSha256": "sha256:b2eb3b008f42ffea8cb3061fea12532eba17e6422faa3636c5b6e18ce3ee9228",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:f8fb5253cb23abe96522ed4028b6e672b9b34527b1470070b989aa5f008ba555"
    },
    {
      "baseHexagramNumber": 21,
      "changedHexagramNumber": 47,
      "sourceEntryNumber": 47,
      "sourceIconHexagramNumber": 47,
      "hexagramName": "困",
      "poemText": "二女寶珠，誤鄭大夫。君父無禮，自為作笑。",
      "sourceParagraphSha256": "sha256:553b3ef74b4280837ec3e766a03a8d0c32af6c24f8db1f99dad5b31634eefe70",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:10d2c9c54155b248e01851e0d04598afa87f9a77c24470184be869c8cdb0060a"
    },
    {
      "baseHexagramNumber": 21,
      "changedHexagramNumber": 48,
      "sourceEntryNumber": 48,
      "sourceIconHexagramNumber": 48,
      "hexagramName": "井",
      "poemText": "陽城太室，神明所息。仁者之君，獨無兵革。",
      "sourceParagraphSha256": "sha256:1f6b10a2295dafafed56ba56d5431c95744257494e2d47c450dbf6165b705e98",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:9d57eebbfd36863f3995eccaefc7f320052983a90f8f9861014e9d1f1404239e"
    },
    {
      "baseHexagramNumber": 21,
      "changedHexagramNumber": 49,
      "sourceEntryNumber": 49,
      "sourceIconHexagramNumber": 49,
      "hexagramName": "革",
      "poemText": "反（一作大）蛇為殃，使道不通。歲收甚少，年穀敗傷。",
      "sourceParagraphSha256": "sha256:b3e7aef02cdacc60082a11a63b3a33f522be7d66a62f501fb2c3ac0972b3b70c",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:f166ed08b40e42dc93190f2d0f70b58205e6124a6717b1c3059d55f231ab57eb"
    },
    {
      "baseHexagramNumber": 21,
      "changedHexagramNumber": 50,
      "sourceEntryNumber": 50,
      "sourceIconHexagramNumber": 50,
      "hexagramName": "鼎",
      "poemText": "三足孤鳥，靈明為御。司過罰惡，自殘其家。毀敗為憂。",
      "sourceParagraphSha256": "sha256:5837f87f8ce17269322badc02f8c69f4fe55098b86c158542d15ea410e291c9f",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:d8b7fae817a4ab9d4e07f82df4aa8cada65ef0d8d456677e621d979fc3b6e644"
    },
    {
      "baseHexagramNumber": 21,
      "changedHexagramNumber": 51,
      "sourceEntryNumber": 51,
      "sourceIconHexagramNumber": 51,
      "hexagramName": "震",
      "poemText": "車駕兩靷，絕馬欲步。雙輪脫行，至道遇害。",
      "sourceParagraphSha256": "sha256:29f7b1e81f53eb3f9bc51eca47ac2f261759fc6133576fea302ae913aa9bac1d",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ce44a5ef020af2a7e38fd16a8bd46429dca0d5aeceea94225aa4c116ccf3ee40"
    },
    {
      "baseHexagramNumber": 21,
      "changedHexagramNumber": 52,
      "sourceEntryNumber": 52,
      "sourceIconHexagramNumber": 52,
      "hexagramName": "艮",
      "poemText": "鬱映不明，為陰所傷。眾霧麗集，共奪日光。",
      "sourceParagraphSha256": "sha256:566f2fd00dc93d7397d9006d6db3e175c46136291ea60e30d94decb867e26157",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:1028a4632d593396d23459ce5d5aeba03507452ca716bdd0257ced70933a8687"
    },
    {
      "baseHexagramNumber": 21,
      "changedHexagramNumber": 53,
      "sourceEntryNumber": 53,
      "sourceIconHexagramNumber": 53,
      "hexagramName": "漸",
      "poemText": "鸇 梟，治城禦災。周公勤勞，綏得安家。",
      "sourceParagraphSha256": "sha256:e8a714dfe04ab700ce2195f6b53064830c94ed0a0d569f71dd98b13715db38a2",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:88b5cb9fa148e6991b403c39651e1424955d4914bf137cbfa5350e1adf4b72b2"
    },
    {
      "baseHexagramNumber": 21,
      "changedHexagramNumber": 54,
      "sourceEntryNumber": 54,
      "sourceIconHexagramNumber": 54,
      "hexagramName": "歸妹",
      "poemText": "名成德就，項領不試。景公耄老，尼父逝去。",
      "sourceParagraphSha256": "sha256:5d87113f013e126be871738f801089049d1a1d6f57833850bc464c7f952c4de9",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:39348240463affc8b9801e5760554a7aa800975f9645372a727d096f8b90ac2c"
    },
    {
      "baseHexagramNumber": 21,
      "changedHexagramNumber": 55,
      "sourceEntryNumber": 55,
      "sourceIconHexagramNumber": 55,
      "hexagramName": "豐",
      "poemText": "一夫兩心，岐刺不深。所為無功，求事不成。",
      "sourceParagraphSha256": "sha256:70c6d5fe963d624fc77fe354c8ebaab0ac4c1bc5600b38b155db49603d233a6d",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:e1ea9425adba36712c70c0e658f8d41f88369aca846bd73a028bf82a1c6ab592"
    },
    {
      "baseHexagramNumber": 21,
      "changedHexagramNumber": 56,
      "sourceEntryNumber": 56,
      "sourceIconHexagramNumber": 56,
      "hexagramName": "旅",
      "poemText": "羿張烏號，彀射天狼。趙國雄勇，敗於滎陽。",
      "sourceParagraphSha256": "sha256:689a85762b7547b31a6d297174e5777817ff29ce014a6bc811beaa8764a743da",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:4674946efb4c1aaf91677342e968092b652b15b8810b25f9d7e603c79537d0a9"
    },
    {
      "baseHexagramNumber": 21,
      "changedHexagramNumber": 57,
      "sourceEntryNumber": 57,
      "sourceIconHexagramNumber": 57,
      "hexagramName": "巽",
      "poemText": "東家殺牛，污臭腥臊。神皆西顧，命衰絕周。",
      "sourceParagraphSha256": "sha256:1d61855814afc2841d08373f145e50806796ceed5e288ef94dfc93e046d1ca72",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:3d2d0127b1ae495f2596d7c506804f2c327b55185fff2f88e244d06c4840dade"
    },
    {
      "baseHexagramNumber": 21,
      "changedHexagramNumber": 58,
      "sourceEntryNumber": 58,
      "sourceIconHexagramNumber": 58,
      "hexagramName": "兌",
      "poemText": "火起我後，喜炙吾廬。蒼龍銜水，泉噀屋柱，雖難無咎。",
      "sourceParagraphSha256": "sha256:684e6432f3a0c7e7a07f64ebc34344df80601c742ccf640896d8fa79fb339895",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:03be8d7e409f182adbcdfb6527914833cea2bdf40e9950a581686739f1f81adb"
    },
    {
      "baseHexagramNumber": 21,
      "changedHexagramNumber": 59,
      "sourceEntryNumber": 59,
      "sourceIconHexagramNumber": 59,
      "hexagramName": "渙",
      "poemText": "桃雀竊脂，巢於小枝。搖動不安，為風所吹。寒心飄搖，常憂殆危。",
      "sourceParagraphSha256": "sha256:0bfe361980c6723f82fad234fccff093cb23785749b1251a27fb06449b0e5a79",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:602f51aedf29c518c99ba405d75b20dee8204c2a409772307a2c034a77c9c99c"
    },
    {
      "baseHexagramNumber": 21,
      "changedHexagramNumber": 60,
      "sourceEntryNumber": 60,
      "sourceIconHexagramNumber": 60,
      "hexagramName": "節",
      "poemText": "徒足去域，飛入東國。有所畏避，深藏遠匿。",
      "sourceParagraphSha256": "sha256:fe7a58953065466c8170c324356a48c0f665df0a32f7ca5a5fd31623a60b7f8a",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:9d4410c83076c8110ffcc7e39ca61d2f6a5da0805d9ef5364650b14fc00d9b21"
    },
    {
      "baseHexagramNumber": 21,
      "changedHexagramNumber": 61,
      "sourceEntryNumber": 61,
      "sourceIconHexagramNumber": 61,
      "hexagramName": "中孚",
      "poemText": "璚英朱草，仁政得道。鳧鷖在渚，福祿來下。",
      "sourceParagraphSha256": "sha256:b446c7703add1abe4fbe977381160602e76b52f9a3a900bc04a5964adf2cf59a",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:3ebf3ef5ea991239d84d4eee499f32ca7aed7c20cea71e9776fa26e0eff3d7a7"
    },
    {
      "baseHexagramNumber": 21,
      "changedHexagramNumber": 62,
      "sourceEntryNumber": 62,
      "sourceIconHexagramNumber": 62,
      "hexagramName": "小過",
      "poemText": "陳蔡之厄，從者飢瘦。明德上通，憂不為凶。",
      "sourceParagraphSha256": "sha256:0cd075bc407fe04a801c99fe583723c613c8220a0eff4d50c7118920193adb9b",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:eaea31a6210f228f7e7f6fc4b6634309807f1cdd242f857316513a61a13d8a41"
    },
    {
      "baseHexagramNumber": 21,
      "changedHexagramNumber": 63,
      "sourceEntryNumber": 63,
      "sourceIconHexagramNumber": 63,
      "hexagramName": "既濟",
      "poemText": "春桃生花，季女宜家。受福多年，男為邦君。",
      "sourceParagraphSha256": "sha256:eaa71f5df5130c8de013e72bcf8602bcc1d21e7d58c1e567398dc132e13c6c7f",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:96f48e9ef2eec19db6c297fffddad2b44fc1350e32ed7a2909d1b9ce9a3760ad"
    },
    {
      "baseHexagramNumber": 21,
      "changedHexagramNumber": 64,
      "sourceEntryNumber": 64,
      "sourceIconHexagramNumber": 64,
      "hexagramName": "未濟",
      "poemText": "徑邪賊田，政惡傷民。夫婦咒詛，太山覆顛。",
      "sourceParagraphSha256": "sha256:ed9e89d9e4ebe35b8f98545b09858b37f85d05600ac3252cc20124fcd8a681c3",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:fdcb5e3a4888e0cc7722f5cbe2d077f5391633e74f5ff89441b51acf62b49783"
    }
  ]
}
