  "attribution": "來源：《焦氏易林》，易學網《焦氏易林［四庫全書版］》（依據版本：《欽定四庫全書》子部術數類），https://www.eee-learning.com/book/giauii 。依來源要求標示出處及原網頁連結；本站僅整理林辭原文，並記錄收錄、標點及文字整理修改。",
  "entryCount": 64,
  "missingTargets": [],
  "entries": [
    {
      "baseHexagramNumber": 9,
      "changedHexagramNumber": 9,
      "sourceEntryNumber": 9,
      "sourceIconHexagramNumber": 9,
      "hexagramName": "小畜",
      "poemText": "白鳥御餌，鳴呼其子。旋枝張翅，來從其母。伯仲季叔，元賀舉手。",
      "sourceParagraphSha256": "sha256:8c3a1fb6afa833d436c376d157849f39f490051c18d910a4ba187787bebf948b",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:5fda3e482725660698229c9af14c6507b15bfa3931988199b07472afb1391c1f"
    },
    {
      "baseHexagramNumber": 9,
      "changedHexagramNumber": 1,
      "sourceEntryNumber": 1,
      "sourceIconHexagramNumber": 1,
      "hexagramName": "乾",
      "poemText": "東遇虎蛇，牛馬奔驚。道絕不通，商困無功。",
      "sourceParagraphSha256": "sha256:5efb908d749f18cd925c049a5f9c2c7f7e7b5662ac0f5700f6b81f9327ba7f82",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:be4c41e599df62b7b35910e91f61f1f83d96df5db75198f13145f73766329a97"
    },
    {
      "baseHexagramNumber": 9,
      "changedHexagramNumber": 2,
      "sourceEntryNumber": 2,
      "sourceIconHexagramNumber": 2,
      "hexagramName": "坤",
      "poemText": "子鉏獲麟，庶士開元。豪雄爭名，都邑倍遊。",
      "sourceParagraphSha256": "sha256:6aee2fb4cd13b7fd28efb2a5950c2258fa705d5030a2e3fe198f2741607795e1",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:20c159d64d75f757b2610c8547ee8a3826d83472afbf9dccbdcb3c6458fa8974"
    },
    {
      "baseHexagramNumber": 9,
      "changedHexagramNumber": 3,
      "sourceEntryNumber": 3,
      "sourceIconHexagramNumber": 3,
      "hexagramName": "屯",
      "poemText": "灼火泉源，釣魚山巔。魚不可得，火不肯燃。",
      "sourceParagraphSha256": "sha256:ecbc323a12fe8f202e16b82b3d8e9bb35831ea89545f19a699d0f7d45c1b7f3d",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:72f6c363b0b5f9e0f7c89ae7d9f20cb745c876ea01a8fb34622ce97ca1ea5c0e"
    },
    {
      "baseHexagramNumber": 9,
      "changedHexagramNumber": 4,
      "sourceEntryNumber": 4,
      "sourceIconHexagramNumber": 4,
      "hexagramName": "蒙",
      "poemText": "機關不便，不能出言。精誠不通，為人所冤。",
      "sourceParagraphSha256": "sha256:74c9ed4d79674360bc811444247d458ddb48a4e33794f36b4fa7fd8a6b6ea2d8",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:d4527e0e66e9e3776f6c838a6db38747351873fde0c5c17c81b4d18561afd178"
    },
    {
      "baseHexagramNumber": 9,
      "changedHexagramNumber": 5,
      "sourceEntryNumber": 5,
      "sourceIconHexagramNumber": 5,
      "hexagramName": "需",
      "poemText": "故室舊廬，稍蔽紱組。不如新巢，可以樂居。",
      "sourceParagraphSha256": "sha256:4c46c9fd6589168b915b31a6b81005f096f37f2de8adee593feaf70b5e53115d",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:84ce661726353113c631f49e08455463e4193ebc76edee45fdb7ba72de4b22ac"
    },
    {
      "baseHexagramNumber": 9,
      "changedHexagramNumber": 6,
      "sourceEntryNumber": 6,
      "sourceIconHexagramNumber": 6,
      "hexagramName": "訟",
      "poemText": "蜲蛇循流，東求大魚。預且舉網，庖人歌謳。",
      "sourceParagraphSha256": "sha256:1ddb5429f3fed75d7d394a7688acab6a3add987792b375149cb5860ba2efd32d",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:d7fddee19547c6575ed3b4ed33f8f10729bd60b330d56ec13e4b557cfd699cb1"
    },
    {
      "baseHexagramNumber": 9,
      "changedHexagramNumber": 7,
      "sourceEntryNumber": 7,
      "sourceIconHexagramNumber": 7,
      "hexagramName": "師",
      "poemText": "鑿山通道，南至嘉國。周公所祝，襄適荊楚。",
      "sourceParagraphSha256": "sha256:a95387f4edb3fc9ab1e6b3bc7f5846784b30e6bb77081b5bc9a4a6cf3c9192b8",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:f73734e0bbbf77adcff6e33b2566d5862bef43df97fc10cf8f85fd17f5054aed"
    },
    {
      "baseHexagramNumber": 9,
      "changedHexagramNumber": 8,
      "sourceEntryNumber": 8,
      "sourceIconHexagramNumber": 8,
      "hexagramName": "比",
      "poemText": "鵲足卻縮，不見頭目。日久困急，不能自復。",
      "sourceParagraphSha256": "sha256:cd46dc07dd21809e70095dd6fe87aab29c6c700f803f2b60adec83f5fdc9b617",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:70ee06e1ffc4458bc04a6e8baafa3def239818e1c6298da1815d3956c86e17fd"
    },
    {
      "baseHexagramNumber": 9,
      "changedHexagramNumber": 10,
      "sourceEntryNumber": 10,
      "sourceIconHexagramNumber": 10,
      "hexagramName": "履",
      "poemText": "五舌啄難，各自有言。異國殊俗，使心迷惑。所求不得。",
      "sourceParagraphSha256": "sha256:29e5e449076de897051490a67e2570dcf7fdc3f94f75e5361b0b1886bc16a324",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ee616a9128f17aee73585899030560c8b96e0686aab81eafbd0f9a602e7acbea"
    },
    {
      "baseHexagramNumber": 9,
      "changedHexagramNumber": 11,
      "sourceEntryNumber": 11,
      "sourceIconHexagramNumber": 11,
      "hexagramName": "泰",
      "poemText": "天門開闢，牢戶寥廓。桎梏解脫，拘困縱釋。",
      "sourceParagraphSha256": "sha256:d1d43994b7e6e1873d4762cffefd92c1d2e56ef6ac75a22db60447067ae1c3b8",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:eac3be5b7c4fbcda13178fcb329b6c2a6dfdd6f55afa1810a9de638d2e174453"
    },
    {
      "baseHexagramNumber": 9,
      "changedHexagramNumber": 12,
      "sourceEntryNumber": 12,
      "sourceIconHexagramNumber": 12,
      "hexagramName": "否",
      "poemText": "堅冰黃鳥，啼哀悲愁。數驚鷙鷂，飄為我憂。",
      "sourceParagraphSha256": "sha256:5baf56bd8f99c04250c64c91aa9926c04383c45b56a2f9305dea8cf1b5ed7f8a",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:927026f2921bb67fafd63dee3a86aaffc09478242250a3a19cd35c25c28ace22"
    },
    {
      "baseHexagramNumber": 9,
      "changedHexagramNumber": 13,
      "sourceEntryNumber": 13,
      "sourceIconHexagramNumber": 13,
      "hexagramName": "同人",
      "poemText": "日走月步，趣不同舍。夫妻反目，主君失居。",
      "sourceParagraphSha256": "sha256:137ab7543bcb902d08a6ac88b9087daf02724c94446667a8b956907d80ef7e73",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:3582adb1b05672710ea530df339342fdf97cb6b2e0c3604240bdc4ecf4a0dbeb"
    },
    {
      "baseHexagramNumber": 9,
      "changedHexagramNumber": 14,
      "sourceEntryNumber": 14,
      "sourceIconHexagramNumber": 14,
      "hexagramName": "大有",
      "poemText": "金牙鐵齒，西王母子。無有禍殃，候舍涉道。別來不久。",
      "sourceParagraphSha256": "sha256:4e929bc455cb0d9fa5190cdbabd7bb227d249dbf41affb7bb441d7b32057853d",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:5d8781f72df0a682b1246b35526e414afc83b3e70573ab46ce1a8759cf836be4"
    },
    {
      "baseHexagramNumber": 9,
      "changedHexagramNumber": 15,
      "sourceEntryNumber": 15,
      "sourceIconHexagramNumber": 15,
      "hexagramName": "謙",
      "poemText": "式微式微，憂禍相絆。隔以巖山，室家分散。",
      "sourceParagraphSha256": "sha256:cef4ca4f358b684c56675a034198fe8a200bdc9aa1392c6f3badb3ca0b1aa8d8",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:0e16203ade2357199354135451b6cf00f729d0e50a360b4dd20cc8fcacbd6ffb"
    },
    {
      "baseHexagramNumber": 9,
      "changedHexagramNumber": 16,
      "sourceEntryNumber": 16,
      "sourceIconHexagramNumber": 16,
      "hexagramName": "豫",
      "poemText": "眾神集聚。相與議語。南國虐亂，百姓勞苦。興師征伐，別立賢主。",
      "sourceParagraphSha256": "sha256:d55cf541876600a4d7494938d00f9fd63c8211ff4dfb98bd308123a2bafbd17a",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:bb3ca0406590b83e7288a16e0032ece503aa64521271a59a0f3c919c9add3a03"
    },
    {
      "baseHexagramNumber": 9,
      "changedHexagramNumber": 17,
      "sourceEntryNumber": 17,
      "sourceIconHexagramNumber": 17,
      "hexagramName": "隨",
      "poemText": "虎狼爭食，禮讓不能。兼吞其國，齊晉無主。",
      "sourceParagraphSha256": "sha256:51cae29596d073f0e0badb15d77407f68137fa59c2656270dad9c2d7013c0188",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:96c708969d91c938a2886b383732f3159aac9d22ee37c9631e9494ec73432abe"
    },
    {
      "baseHexagramNumber": 9,
      "changedHexagramNumber": 18,
      "sourceEntryNumber": 18,
      "sourceIconHexagramNumber": 18,
      "hexagramName": "蠱",
      "poemText": "寄生無根，如過浮雲。本立不固，斯須落去。更為枯樹。",
      "sourceParagraphSha256": "sha256:ca1f5f9d696c54391107378c9cde963d2b934f53110d442902c83c1587f1863b",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:b6c75778a13c80913ab3bcfd070630db6122a92f7439b5abbc4165876eddd945"
    },
    {
      "baseHexagramNumber": 9,
      "changedHexagramNumber": 19,
      "sourceEntryNumber": 19,
      "sourceIconHexagramNumber": 19,
      "hexagramName": "臨",
      "poemText": "子啼索哺，母行取食。反見空巢，紫弋長息。",
      "sourceParagraphSha256": "sha256:d7a440e43f08e9ebe9b27b1c09d91b53cb01cefa22389afac8a4d5fc0cc730b6",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:7dab70763616e79157b7e84b5208a56560af6d547ffa6782040b61a68ec198aa"
    },
    {
      "baseHexagramNumber": 9,
      "changedHexagramNumber": 20,
      "sourceEntryNumber": 20,
      "sourceIconHexagramNumber": 20,
      "hexagramName": "觀",
      "poemText": "駕駟逐狐，輪掛荊棘。車不結轍，公子無得。",
      "sourceParagraphSha256": "sha256:d7cafe563e3ccc7ffab47bc7dc1fc6a5a9c968cb808ccd641f13851785c9edef",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:e5af764b46691b04662672ce410e4c0f265a339f054f56d7fb5f789adc2b0756"
    },
    {
      "baseHexagramNumber": 9,
      "changedHexagramNumber": 21,
      "sourceEntryNumber": 21,
      "sourceIconHexagramNumber": 21,
      "hexagramName": "噬嗑",
      "poemText": "方喙廣口，仁智聖厚。釋解倒懸，唐國大安。",
      "sourceParagraphSha256": "sha256:3d0369d86695567819a81ccb3ea3de955be95e2c0aa5e6c65fc418cf1e17221f",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:b94c58bf88ecbabf0e4e8074ea8880354a857863e4f9bf1a93c66c919ec103f8"
    },
    {
      "baseHexagramNumber": 9,
      "changedHexagramNumber": 22,
      "sourceEntryNumber": 22,
      "sourceIconHexagramNumber": 22,
      "hexagramName": "賁",
      "poemText": "駕福乘喜，東至嘉國。戴慶南行，移居安宅。",
      "sourceParagraphSha256": "sha256:9724110e527fef13e01704ded072e7b0abaa17c4d8e149ce3769236e1aa5c492",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:bdd341aae13e72122d8f760a5a2b11e8664f529bb877b6f843aa487895a5967c"
    },
    {
      "baseHexagramNumber": 9,
      "changedHexagramNumber": 23,
      "sourceEntryNumber": 23,
      "sourceIconHexagramNumber": 23,
      "hexagramName": "剝",
      "poemText": "孔鯉伯魚，北至高奴。木馬金車，駕遊大都。王母送我，騋牝牸駒。",
      "sourceParagraphSha256": "sha256:43556e094f3ac205857ea0a34ef269ac905200a03624f032b2111463a812cdf6",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:b3065078f492403ba0242c1ea46f183550cc92c8f5414dfd9fb33ba89e48f576"
    },
    {
      "baseHexagramNumber": 9,
      "changedHexagramNumber": 24,
      "sourceEntryNumber": 24,
      "sourceIconHexagramNumber": 24,
      "hexagramName": "復",
      "poemText": "三足無頭，不知所之。心狂精傷，莫使為明。不見日光。",
      "sourceParagraphSha256": "sha256:db4f8319b2d7db514163acb3bb0fa65b61709ce9c53a76fb7c94c583193c8b00",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:669008f066c09e16ba9d140db735294cb6f6429dadc49c7a8ae8b02f9057858c"
    },
    {
      "baseHexagramNumber": 9,
      "changedHexagramNumber": 25,
      "sourceEntryNumber": 25,
      "sourceIconHexagramNumber": 25,
      "hexagramName": "无妄",
      "poemText": "騋牝龍身，日越三千。南上蒼梧，與福為婚。道里夷易，安全無患。",
      "sourceParagraphSha256": "sha256:80e1f5d4947643045c6d260763ee89a7ac4e22008d43fffffd8e3d2d4f356e4c",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ffbfc47f3dd973913fc6a39cd1b45256c58491d8f7c75f5050df5b935d764b02"
    },
    {
      "baseHexagramNumber": 9,
      "changedHexagramNumber": 26,
      "sourceEntryNumber": 26,
      "sourceIconHexagramNumber": 26,
      "hexagramName": "大畜",
      "poemText": "辰次降婁，王駕巡狩。廣佑施惠，國安無憂。望季不來。",
      "sourceParagraphSha256": "sha256:d2260475d7db0f9e5db53f0276a2a70d48c2c2a874488ab89fae6b054eb76573",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:c12b413913001845ef1b59f2df3d06e3c1887097b7566d12f6e6f4d57be361c4"
    },
    {
      "baseHexagramNumber": 9,
      "changedHexagramNumber": 27,
      "sourceEntryNumber": 27,
      "sourceIconHexagramNumber": 27,
      "hexagramName": "頤",
      "poemText": "望車不到，王子逐走。馬騎銜傷，失跡不得。曷其有常。",
      "sourceParagraphSha256": "sha256:877c6f875afde6bf7693b8602c44c2a00c55a4db37c9b08017f337b598c5b815",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ce6ccdda3bf6c4132873446ad7dce08e6abae54705986e484209adb5c748144d"
    },
    {
      "baseHexagramNumber": 9,
      "changedHexagramNumber": 28,
      "sourceEntryNumber": 28,
      "sourceIconHexagramNumber": 28,
      "hexagramName": "大過",
      "poemText": "中原有菽，以待饔食。飲御諸友，所求大得。",
      "sourceParagraphSha256": "sha256:a5d201cd5fe28ca888f10abbe4c477b87c8173fe348f9da6fa92785f0b0bc37d",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:797e73aa4a90b89ba2652ee8f924f64f6f32acf372d8470b14fcbb1b0ba8caaf"
    },
    {
      "baseHexagramNumber": 9,
      "changedHexagramNumber": 29,
      "sourceEntryNumber": 29,
      "sourceIconHexagramNumber": 29,
      "hexagramName": "坎",
      "poemText": "亂茅縮酒，靈巫拜禱。神怒不許，瘁盡愁苦。",
      "sourceParagraphSha256": "sha256:9635f062e22534de9faeb190be1b0e831e66d1187f83b7bc5e6b4e8dfc81d4ae",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:7f8bab49491bd4eab32d79ca46e050c744761b67fb779f02878007f4bddb3a32"
    },
    {
      "baseHexagramNumber": 9,
      "changedHexagramNumber": 30,
      "sourceEntryNumber": 30,
      "sourceIconHexagramNumber": 30,
      "hexagramName": "離",
      "poemText": "李華再實，鴻卵降集。仁哲以興，蔭國受福。",
      "sourceParagraphSha256": "sha256:18f43f5f7d94e09cc8ab7d4dfa9acd4d3f0a71e2f658d83c6ce9f091891ee9fe",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:26ff2492d6a5362af43023ec16228d0ac3c42a15548e3664c3bbec39cc6f46ad"
    },
    {
      "baseHexagramNumber": 9,
      "changedHexagramNumber": 31,
      "sourceEntryNumber": 31,
      "sourceIconHexagramNumber": 31,
      "hexagramName": "咸",
      "poemText": "原出陵足，行於山趾。不為暴害，民得安居。",
      "sourceParagraphSha256": "sha256:56e631bd23059f14682bc05fc514d7c84d4d554f814a777a179f83216d7cc692",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:cd88b404efc9726f90b6011b4dda47dbeab132e7fcb56fe31f3bcb0299649a00"
    },
    {
      "baseHexagramNumber": 9,
      "changedHexagramNumber": 32,
      "sourceEntryNumber": 32,
      "sourceIconHexagramNumber": 32,
      "hexagramName": "恒",
      "poemText": "客入其門，奔走東西。童女不織，士棄耕畝。暴骨千里，歲饑民苦。",
      "sourceParagraphSha256": "sha256:50c1ed935f681684a1623e2c5b12d86632392178f2b8250bfb5d245330eb8be0",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:2b4817e87e93f4da79dc07d73f9a2467c598100bd7806199190ca63516268454"
    },
    {
      "baseHexagramNumber": 9,
      "changedHexagramNumber": 33,
      "sourceEntryNumber": 33,
      "sourceIconHexagramNumber": 33,
      "hexagramName": "遯",
      "poemText": "天之所予，福祿常在。不憂危殆。",
      "sourceParagraphSha256": "sha256:fa08021f7a2635264e6c05cb669b22c6363bc683e5659e9b21089cfb94d13c6b",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:fe6153a879b7374f251468c1ec23394be675f01379fd389e3e2e6ecafd59125a"
    },
    {
      "baseHexagramNumber": 9,
      "changedHexagramNumber": 34,
      "sourceEntryNumber": 34,
      "sourceIconHexagramNumber": 34,
      "hexagramName": "大壯",
      "poemText": "蝗食我稻，驅不可去。實穗無有，但見空槁。",
      "sourceParagraphSha256": "sha256:5c3974a7bb67b94adf663ac1f7884fcf07b8094a84141463dd442fb965630294",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:416e15e1174e537b8e2a396190238c54a03dd2b6b88890b1e2a8df638841320c"
    },
    {
      "baseHexagramNumber": 9,
      "changedHexagramNumber": 35,
      "sourceEntryNumber": 35,
      "sourceIconHexagramNumber": 35,
      "hexagramName": "晉",
      "poemText": "牛驥同堂，郭氏以亡。國破空虛，君奔走逃。",
      "sourceParagraphSha256": "sha256:03178c319572a4c36cbf3f60f66d3d1993edb9401abeebfc20a5ba43318e2a71",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:e8e0744855653f8c548c525ddd80a64fa67d413131b38230037adee71c8ba2ec"
    },
    {
      "baseHexagramNumber": 9,
      "changedHexagramNumber": 36,
      "sourceEntryNumber": 36,
      "sourceIconHexagramNumber": 36,
      "hexagramName": "明夷",
      "poemText": "狗無前足，陰謀其比。為身賊害，何以安息。",
      "sourceParagraphSha256": "sha256:72b9017b0ef0b95ee821f46e6c3e8e9399889b5d73aa5337801114472a67ed99",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:b82cec278336ee69ce5916579a7542dfced7b67a89284ae635aab1af5de0caa1"
    },
    {
      "baseHexagramNumber": 9,
      "changedHexagramNumber": 37,
      "sourceEntryNumber": 37,
      "sourceIconHexagramNumber": 37,
      "hexagramName": "家人",
      "poemText": "兩輪自轉，南上大阪。四馬共轅，無有重難。與禹笑言。",
      "sourceParagraphSha256": "sha256:84dec45b56545231f8c7e78d0733e1edb7627a669daff59e76051210fb042a60",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:3f008d6bfb0d13388373ccd16a0f5f61f3740a5e3463b6befbc57155e7ed3973"
    },
    {
      "baseHexagramNumber": 9,
      "changedHexagramNumber": 38,
      "sourceEntryNumber": 38,
      "sourceIconHexagramNumber": 38,
      "hexagramName": "睽",
      "poemText": "芽 生達，陽昌於外。左手執籥，公言錫爵。",
      "sourceParagraphSha256": "sha256:bbd8b99f7e68c124f2bb26d831e4955e52c269a16ae1fbaf3319cd5d360da845",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:bb6b95c9925a2fbae215180a7cf2082a5c5a64746d2c5d7f74dd38f019129d36"
    },
    {
      "baseHexagramNumber": 9,
      "changedHexagramNumber": 39,
      "sourceEntryNumber": 39,
      "sourceIconHexagramNumber": 39,
      "hexagramName": "蹇",
      "poemText": "秋花冬萼，數被嚴霜。甲兵當庭，萬物不生。雄火夜明，民擾大驚。",
      "sourceParagraphSha256": "sha256:6f1ab636a23241f37ed30a916cac4a3cf4abb9eb208d039ac7282950a814f84c",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:39b906ceeeb4c9b703d6d67d134403f3741229126f0c6762d781d0287f831364"
    },
    {
      "baseHexagramNumber": 9,
      "changedHexagramNumber": 40,
      "sourceEntryNumber": 40,
      "sourceIconHexagramNumber": 40,
      "hexagramName": "解",
      "poemText": "霜降閉戶，蟄蟲隱處。不見日月，與死為伍。",
      "sourceParagraphSha256": "sha256:e25c711bdcbb8f9a286e9add44aac899566a0dcf4b190c17118aed5548cad878",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:015c88d1e2a7e8741fadd778ea3186da2118aea7c19bf4fac44bceb5c90abb33"
    },
    {
      "baseHexagramNumber": 9,
      "changedHexagramNumber": 41,
      "sourceEntryNumber": 41,
      "sourceIconHexagramNumber": 41,
      "hexagramName": "損",
      "poemText": "身載百里，功加四海。為文開基，武立天柱。",
      "sourceParagraphSha256": "sha256:de2e3142aa049c23588ca9d8d87f6cfa6d42cf0081d34023bb23fc2949fd4442",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:24533d47b2d0b215695c154494ee909f47f61e56cd61cb75232f4acfee507a8d"
    },
    {
      "baseHexagramNumber": 9,
      "changedHexagramNumber": 42,
      "sourceEntryNumber": 42,
      "sourceIconHexagramNumber": 42,
      "hexagramName": "益",
      "poemText": "禹作神鼎，伯益銜指。斧斤高閣，幢立獨坐。賣賈不售，讎困為害。",
      "sourceParagraphSha256": "sha256:1822b8676e3dae17285a3c0f1916a78e51abc7db723978b6d693584276a179bb",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:f596a1685bffcc06da1bb941d166109351932acf643520d30dea54d34c4d5311"
    },
    {
      "baseHexagramNumber": 9,
      "changedHexagramNumber": 43,
      "sourceEntryNumber": 43,
      "sourceIconHexagramNumber": 43,
      "hexagramName": "夬",
      "poemText": "福祚之聚，喜至憂除。如魚逢水，長樂受庇。",
      "sourceParagraphSha256": "sha256:e0a56e031ed465d39a059c88f043a34149b8eb8c31d4ee6f7e540d7001e4324f",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:466c496ebbbb4962ca1865e7c47c2502edbffbe1183caa422c1d73637ecaa14b"
    },
    {
      "baseHexagramNumber": 9,
      "changedHexagramNumber": 44,
      "sourceEntryNumber": 44,
      "sourceIconHexagramNumber": 44,
      "hexagramName": "姤",
      "poemText": "蒼龍隱伏，麟鳳遠匿。寇賊同處，未得安息。",
      "sourceParagraphSha256": "sha256:a3a9600a4286482fc2499ff14130944a976541afe97ed6d05dc7cf36d86d4e16",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:b19fcb4803e33ec2ff176e6131efdd9436ac4c3b4bac1feb9f1c5c6a863a33d9"
    },
    {
      "baseHexagramNumber": 9,
      "changedHexagramNumber": 45,
      "sourceEntryNumber": 45,
      "sourceIconHexagramNumber": 45,
      "hexagramName": "萃",
      "poemText": "白鶴銜珠，夜食待明。懷胡德音，身受光榮。",
      "sourceParagraphSha256": "sha256:b126f9043011ef654336c9fbff6a1bd640ed7f6cd0ae47893a4a76efa3e68ddc",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:91a6af5edab7815586cf66c329249b51a4883fe710110cda4423522427b7dba2"
    },
    {
      "baseHexagramNumber": 9,
      "changedHexagramNumber": 46,
      "sourceEntryNumber": 46,
      "sourceIconHexagramNumber": 46,
      "hexagramName": "升",
      "poemText": "朝生夕死，名曰嬰鬼。不可得祀。",
      "sourceParagraphSha256": "sha256:df5b578b633abed674941c7736c6f3aa61310956cf249e422c99f3c6939c34dd",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:243e12a38eea470e9ae1bd3b6af61d29da408c6b1c55edbc68c93f18fbc5182b"
    },
    {
      "baseHexagramNumber": 9,
      "changedHexagramNumber": 47,
      "sourceEntryNumber": 47,
      "sourceIconHexagramNumber": 47,
      "hexagramName": "困",
      "poemText": "行役未已，新事復起。姬姜勞苦，不得安息。",
      "sourceParagraphSha256": "sha256:f2f0f3b98d355f95f806032ca9ad19ccfc18460508996586262c6122e45c513a",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:915b549baae893a518a000b9ff1b1975c3bc6333a1d6a673ca77e626ad8bad10"
    },
    {
      "baseHexagramNumber": 9,
      "changedHexagramNumber": 48,
      "sourceEntryNumber": 48,
      "sourceIconHexagramNumber": 48,
      "hexagramName": "井",
      "poemText": "憂患解除，喜至慶來。坐立懽忻，與樂為鄰。",
      "sourceParagraphSha256": "sha256:0186a1e3029844269e89dc758b0daf0feacf0ce92c2307ab552dd43b4e6c7d34",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:747b24add0bcc605d149520aadd5006fe731c08a4f2b81365e93f236d8ffeceb"
    },
    {
      "baseHexagramNumber": 9,
      "changedHexagramNumber": 49,
      "sourceEntryNumber": 49,
      "sourceIconHexagramNumber": 49,
      "hexagramName": "革",
      "poemText": "晨風天翰，火舉就溫。昧過我邑，羿無所得。",
      "sourceParagraphSha256": "sha256:94ad6821dd69ab93da3f91ec5e4182d803fe9a8fb3af21638fda351494dfc353",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:e7ef6c044160e3bdbb616ef419d3acef3992c6582921f1d4d16d4080c02d3a96"
    },
    {
      "baseHexagramNumber": 9,
      "changedHexagramNumber": 50,
      "sourceEntryNumber": 50,
      "sourceIconHexagramNumber": 50,
      "hexagramName": "鼎",
      "poemText": "下田種黍，芳花當齒。大雨淋集，紛榮滿壅。",
      "sourceParagraphSha256": "sha256:adabf1bf043a43b3ef8c0ff278d32aeff1e12db054aff11362684dbc66321276",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:e65ac4983ec95b606a79585dd47758c331a1dfd2cd5eee598ca6e555982a9714"
    },
    {
      "baseHexagramNumber": 9,
      "changedHexagramNumber": 51,
      "sourceEntryNumber": 51,
      "sourceIconHexagramNumber": 51,
      "hexagramName": "震",
      "poemText": "鳥庇茂林，君子碌碌。心樂願得，見者有穀。",
      "sourceParagraphSha256": "sha256:86a181340703781f86517edbbdb17024a2e9d553bc66c48e3caac44d106a2617",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:003e97b7a9b46e4c55206026fa1a3fc304639da3388767514e0ca96633290754"
    },
    {
      "baseHexagramNumber": 9,
      "changedHexagramNumber": 52,
      "sourceEntryNumber": 52,
      "sourceIconHexagramNumber": 52,
      "hexagramName": "艮",
      "poemText": "折臂踒足，不能進酒。祠祀闊曠，神怨不喜。",
      "sourceParagraphSha256": "sha256:34f2f4a8c487f7310e050b392f630501821dfd0c60ed8f17980ee52ae2bae572",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:b1c7705cfe11f6d87ff25fea7318e3c2d1ef399b7a19b34d258014adf0aa01cc"
    },
    {
      "baseHexagramNumber": 9,
      "changedHexagramNumber": 53,
      "sourceEntryNumber": 53,
      "sourceIconHexagramNumber": 53,
      "hexagramName": "漸",
      "poemText": "學靈三年，仁聖且神。明見善祥，吉喜福慶。鳴鳩飛來，告我無憂。一作鹿鳴鴻飛，鳴見善祥）",
      "sourceParagraphSha256": "sha256:1d65740c98af307f477331399e309948eabf042f7e8f62d1be88409b8ece05bd",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:48b88372d3b22b224edb5201428ca003434f9cf93563265a6f7159f8d77fa86c"
    },
    {
      "baseHexagramNumber": 9,
      "changedHexagramNumber": 54,
      "sourceEntryNumber": 54,
      "sourceIconHexagramNumber": 54,
      "hexagramName": "歸妹",
      "poemText": "三婦同夫，志不相思。心懷不平，至常愁悲。",
      "sourceParagraphSha256": "sha256:7623246d1bb19fb311c335877ddd309cc035dd2e8f35ba6cb3177a42ee922743",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:4dad96d20c88b4a9a9c37f35b60d8424fe21d0c06fc94059a3cab24b0a22706e"
    },
    {
      "baseHexagramNumber": 9,
      "changedHexagramNumber": 55,
      "sourceEntryNumber": 55,
      "sourceIconHexagramNumber": 55,
      "hexagramName": "豐",
      "poemText": "中田高黍，以享王母。受福千億，所求大得。",
      "sourceParagraphSha256": "sha256:1c3b1e7f4971198f7eeb69a9297d8f5a8b4f895be972dfd3fd8c8662c276d9f0",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:6ce60d0608ea6860cf013957f5409c044757f1bed9a525288cb609b369e09e61"
    },
    {
      "baseHexagramNumber": 9,
      "changedHexagramNumber": 56,
      "sourceEntryNumber": 56,
      "sourceIconHexagramNumber": 56,
      "hexagramName": "旅",
      "poemText": "陽火不憂，二耕喜至。慶來降福，為我鼓瑟。歌謠送喜。",
      "sourceParagraphSha256": "sha256:aa5f326a702daacf4762c5bac94968c2ef2a5b7da8e1cb5a1b30155fbd83f0e8",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:118e1caa08d9733d84300d3c7f26d3b128d6ec826789eef2878af403bc6c6cb9"
    },
    {
      "baseHexagramNumber": 9,
      "changedHexagramNumber": 57,
      "sourceEntryNumber": 57,
      "sourceIconHexagramNumber": 57,
      "hexagramName": "巽",
      "poemText": "燕雀銜茅，以生孚乳。兄弟六人，交好孝悌。各得其願，和悅相樂。",
      "sourceParagraphSha256": "sha256:081741181a7b47210ab81e3706a55b174954ae88a0bd4fd2420b351c81f6ee08",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:098e0675f28fa2d2cf3b5796e6f5bf4012ade70d500e1ad850d9d51916b85534"
    },
    {
      "baseHexagramNumber": 9,
      "changedHexagramNumber": 58,
      "sourceEntryNumber": 58,
      "sourceIconHexagramNumber": 58,
      "hexagramName": "兌",
      "poemText": "陽明不息，君無恩德。伯氏失利，民喪其力。",
      "sourceParagraphSha256": "sha256:2e7fdf1ddbbae34b0c6704f4dd294089fbe806729873116345abc2ca4e31c9b3",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:45833c329a20c457be273135bbf99642a633ebd4eff4c11a038d88b099c9a99a"
    },
    {
      "baseHexagramNumber": 9,
      "changedHexagramNumber": 59,
      "sourceEntryNumber": 59,
      "sourceIconHexagramNumber": 59,
      "hexagramName": "渙",
      "poemText": "鶉尾奔奔，火中戍軍。虢叔出奔，下失其君。",
      "sourceParagraphSha256": "sha256:cfded0e27b3faf1204cb0699798c76f7d72cc82cb64638938656358cb2d64ed8",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:f924d6ad5e83f7749e0e185d8575c5e47163b6905bf999a240c84025970eb075"
    },
    {
      "baseHexagramNumber": 9,
      "changedHexagramNumber": 60,
      "sourceEntryNumber": 60,
      "sourceIconHexagramNumber": 60,
      "hexagramName": "節",
      "poemText": "兩人相距，止不同舍。夫妻離散，衛侯失居。",
      "sourceParagraphSha256": "sha256:829919fc10e048eeafd98f862c6b18bba6d8259475fa9bf44ef1a064bedc79b8",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ff182d8f07431b9edbfe9261594380570bed6b0b77028bfaf82715d7a54c7cb2"
    },
    {
      "baseHexagramNumber": 9,
      "changedHexagramNumber": 61,
      "sourceEntryNumber": 61,
      "sourceIconHexagramNumber": 61,
      "hexagramName": "中孚",
      "poemText": "魃為菑虐，風吹雲卻。欲止不得，反歸其宅。",
      "sourceParagraphSha256": "sha256:884996cf7ee2645123674e290b4425c855fc983dd1ddc5fc3cda17b9ba7601cc",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:90e48b4353b0e662df5a83ff7e56389b9e4993a2b6385fdae26aa108d9b94cef"
    },
    {
      "baseHexagramNumber": 9,
      "changedHexagramNumber": 62,
      "sourceEntryNumber": 62,
      "sourceIconHexagramNumber": 62,
      "hexagramName": "小過",
      "poemText": "關雎淑女，配我君子。少姜在門，君子嘉喜。",
      "sourceParagraphSha256": "sha256:b9a3dfe653fe305df298db6e288498f5f916f519d2e76d4dbccac7bd9525adfc",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:234ddef5d3fa0e85e4871859b14251f24d18d3481efaa4294bd459ba683edb6d"
    },
    {
      "baseHexagramNumber": 9,
      "changedHexagramNumber": 63,
      "sourceEntryNumber": 63,
      "sourceIconHexagramNumber": 63,
      "hexagramName": "既濟",
      "poemText": "慈母赤子，饗賜得土。夷狄服降，以安王室。",
      "sourceParagraphSha256": "sha256:0da0743c299d5168b387aaaa6d1d10758834f311f36a220e179e4fa07c49533e",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:52f0cc8dd5a7e1b91abb1b4e74dc2031cfcc3ef26c1fe7e1567ff0dab599ef18"
    },
    {
      "baseHexagramNumber": 9,
      "changedHexagramNumber": 64,
      "sourceEntryNumber": 64,
      "sourceIconHexagramNumber": 64,
      "hexagramName": "未濟",
      "poemText": "三足狐鳴，靈鳴督郵。思過罰惡，自賊其家。",
      "sourceParagraphSha256": "sha256:4f623416bd084e5ebe82ad15de31d8910781c85f1a4e1840a0f70f08eab80a13",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:aa02786ec3799367a6d1073d3467bce011eeb33a69aa5f2f733fe61dd9406f16"
    }
  ]
}
