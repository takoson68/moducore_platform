  "attribution": "來源：《焦氏易林》，易學網《焦氏易林［四庫全書版］》（依據版本：《欽定四庫全書》子部術數類），https://www.eee-learning.com/book/giauii 。依來源要求標示出處及原網頁連結；本站僅整理林辭原文，並記錄收錄、標點及文字整理修改。",
  "entryCount": 64,
  "missingTargets": [],
  "entries": [
    {
      "baseHexagramNumber": 19,
      "changedHexagramNumber": 19,
      "sourceEntryNumber": 19,
      "sourceIconHexagramNumber": 19,
      "hexagramName": "臨",
      "poemText": "弱水之西，有西王母。生不知老，與天相保。行者危殆，利居善喜。",
      "sourceParagraphSha256": "sha256:81b5f4eff29789f1c7338ffe3e5600814fdd88da23940fbe1a2aa067845699ed",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ed7a51fa81cc983002132f9d969a355b940ddd8747b66e0e5b62f1844f473f3a"
    },
    {
      "baseHexagramNumber": 19,
      "changedHexagramNumber": 1,
      "sourceEntryNumber": 1,
      "sourceIconHexagramNumber": 1,
      "hexagramName": "乾",
      "poemText": "黃獹生子，白戌為母。晉師在郊，虞公出走。",
      "sourceParagraphSha256": "sha256:5d8386e8277f12c75659168e78a3050ed53a5370b0317ba4eb3b487d0a9ad657",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:a1963279d5c7b660c6636b069f8b1ae46e837f8a2ec512ca288ac1b9230f061b"
    },
    {
      "baseHexagramNumber": 19,
      "changedHexagramNumber": 2,
      "sourceEntryNumber": 2,
      "sourceIconHexagramNumber": 2,
      "hexagramName": "坤",
      "poemText": "倉皇奉使，中山以孝。文侯悅喜，繫子徵召。",
      "sourceParagraphSha256": "sha256:4ef07b84206c6df31d48fbc0de64008c791988787c740abc6f5dc49370108adb",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:2941f1d693cb42a20b59f2b9ab9d6f5052c7c76ef907a97d2d6075a060dbd3f8"
    },
    {
      "baseHexagramNumber": 19,
      "changedHexagramNumber": 3,
      "sourceEntryNumber": 3,
      "sourceIconHexagramNumber": 3,
      "hexagramName": "屯",
      "poemText": "機關不便，不能出言。精誠不通，為人所冤。",
      "sourceParagraphSha256": "sha256:c47ae754c1e688fbcd877f55838e6c1734608ccbf98d551ede49d82a4889e147",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:d4527e0e66e9e3776f6c838a6db38747351873fde0c5c17c81b4d18561afd178"
    },
    {
      "baseHexagramNumber": 19,
      "changedHexagramNumber": 4,
      "sourceEntryNumber": 4,
      "sourceIconHexagramNumber": 4,
      "hexagramName": "蒙",
      "poemText": "白茅醴酒，靈巫拜禱。神嗜飲食，使君壽考。",
      "sourceParagraphSha256": "sha256:e9c59518fec9492623d96c9f79da472a3d156f211347b4d277874d9ecb889cf2",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:d483e2c20c287e478908f62e15953173b8b61defe9dc7403501b2c0117ae67db"
    },
    {
      "baseHexagramNumber": 19,
      "changedHexagramNumber": 5,
      "sourceEntryNumber": 5,
      "sourceIconHexagramNumber": 5,
      "hexagramName": "需",
      "poemText": "重瞳四乳，目聰耳明。普仁表聖，為作元輔。",
      "sourceParagraphSha256": "sha256:272d6c4e235f640f124fab0c895ff06f81d92ad379d5a31e85e432265a1e6cb6",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:0dfb06827896ccba79dccf07a925946be792c98f780af1d4ab63194631a70d26"
    },
    {
      "baseHexagramNumber": 19,
      "changedHexagramNumber": 6,
      "sourceEntryNumber": 6,
      "sourceIconHexagramNumber": 6,
      "hexagramName": "訟",
      "poemText": "水漲無船，破城壞堤，大夫從役。一朝亡殞，不見少妻。",
      "sourceParagraphSha256": "sha256:c839e8022390fb2d8c0879d3946d812b2f4a2d2b112848488ffefdd3f9a3d853",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:515aff966edc45576012b8ea9930532fafb3674a4f3963d87bed04c6103daa48"
    },
    {
      "baseHexagramNumber": 19,
      "changedHexagramNumber": 7,
      "sourceEntryNumber": 7,
      "sourceIconHexagramNumber": 7,
      "hexagramName": "師",
      "poemText": "六人俱行，各遺其囊。鴻鵠失珠，無以為明。",
      "sourceParagraphSha256": "sha256:a95eaa1a33783f0a1086e2a6aaabf675d1a8d24ca537fb036c527654b829a13e",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:d80841385fa66e618c587c3f0a332e750d4a22fa73359c39d45cd13cb5521072"
    },
    {
      "baseHexagramNumber": 19,
      "changedHexagramNumber": 8,
      "sourceEntryNumber": 8,
      "sourceIconHexagramNumber": 8,
      "hexagramName": "比",
      "poemText": "隨時轉行，不失其常。各樂厥類，身無咎殃。",
      "sourceParagraphSha256": "sha256:88b103a199ffd4e25030557042cb0f5c238ba1b206ebbfa5e9bf51b1ae9e1dd6",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:3f30e71711d893c353162f768d2bfe9aeee174314b547d2946eaf4588f67371c"
    },
    {
      "baseHexagramNumber": 19,
      "changedHexagramNumber": 9,
      "sourceEntryNumber": 9,
      "sourceIconHexagramNumber": 9,
      "hexagramName": "小畜",
      "poemText": "蔡女蕩舟，為國患憂。褒后在側，屏蔽王目。早衰六畜。",
      "sourceParagraphSha256": "sha256:fe217b6a233ba1cf93ff4225c9875cc97aac1b48f25c31af14f4baf4a43bc8d9",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:57d02485a2690d4c19ca567e0f98d728545fd92147525e1b9c56c693bc957202"
    },
    {
      "baseHexagramNumber": 19,
      "changedHexagramNumber": 10,
      "sourceEntryNumber": 10,
      "sourceIconHexagramNumber": 10,
      "hexagramName": "履",
      "poemText": "駕龍騎虎，周遍天下。為神人使，西見王母。不憂危殆。",
      "sourceParagraphSha256": "sha256:56fd85b28480f606c5503de7c30b82b7c9ace921f13c6211156fbdc57cb6ddc7",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:18df28c8a7d284a103af381e10cefc8f10dae452ffe9b6cc20ca7f8f582564aa"
    },
    {
      "baseHexagramNumber": 19,
      "changedHexagramNumber": 11,
      "sourceEntryNumber": 11,
      "sourceIconHexagramNumber": 11,
      "hexagramName": "泰",
      "poemText": "胥恐之吳，畫策闔閭。鞭平服荊，除大咎殃。威震敵國，還受上卿。",
      "sourceParagraphSha256": "sha256:84c6caa097c7083818d8e2697b0a9b8b4faf2901c7a862ce06b14c4752347bd7",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:cf0d60736a67ae5badf30ed4b885925492cc83f5dd74cff82b8891ff798d76ac"
    },
    {
      "baseHexagramNumber": 19,
      "changedHexagramNumber": 12,
      "sourceEntryNumber": 12,
      "sourceIconHexagramNumber": 12,
      "hexagramName": "否",
      "poemText": "唐邑之廬，晉人以居。虞叔受福，實貺是國。世載其樂。",
      "sourceParagraphSha256": "sha256:8f2725500f519d76c77d202f9d02534c8a099d5360b750de6127b3f053cd7729",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:4ffb940591aa234be8e6da598fa96030a622db9b29714015d9ce5e508456f255"
    },
    {
      "baseHexagramNumber": 19,
      "changedHexagramNumber": 13,
      "sourceEntryNumber": 13,
      "sourceIconHexagramNumber": 13,
      "hexagramName": "同人",
      "poemText": "管鮑相知，至德不離。三言於桓，齊國以安。",
      "sourceParagraphSha256": "sha256:cfce5cef2991faa81ec7fc1a713ce2a2b55d6af4c76eb8857748423f3c5b1fbb",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:29462fcdf793dceb48396b8bc00ca5a417a730c9bfb3b8427b094cf88ede2f06"
    },
    {
      "baseHexagramNumber": 19,
      "changedHexagramNumber": 14,
      "sourceEntryNumber": 14,
      "sourceIconHexagramNumber": 14,
      "hexagramName": "大有",
      "poemText": "三十無室，長女獨宿。心勞未得，憂在胸臆。",
      "sourceParagraphSha256": "sha256:0faa418f57b6b121b57cf92b032acaef01352a73e4332100df19f03bbb01a270",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:1bf5db281516c6aefc4bf20abf899bbf731c9b33ecfcc47b2f2c873f589f197d"
    },
    {
      "baseHexagramNumber": 19,
      "changedHexagramNumber": 15,
      "sourceEntryNumber": 15,
      "sourceIconHexagramNumber": 15,
      "hexagramName": "謙",
      "poemText": "散渙水長，風吹我鄉。火滅無光，隳敗桓功。",
      "sourceParagraphSha256": "sha256:c58e4f4415444e30dddbf237d3151e02790de456c8abb183ead0800b93930f71",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:c97eb3cc9a59e3cddd63faee7e53a8be42b74faa0b527d0396f3970d3e086574"
    },
    {
      "baseHexagramNumber": 19,
      "changedHexagramNumber": 16,
      "sourceEntryNumber": 16,
      "sourceIconHexagramNumber": 16,
      "hexagramName": "豫",
      "poemText": "蜎飛蠕動，各有配偶。大小相保，咸得其所。",
      "sourceParagraphSha256": "sha256:28d98653bed825ecb87f9aa01f0f7b16591763f48196d30d87680c2a90d0a3ef",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:59d6283a44846a9c87ddaa67e2d7ea27253eaf3cae658425b72fb4baf4999187"
    },
    {
      "baseHexagramNumber": 19,
      "changedHexagramNumber": 17,
      "sourceEntryNumber": 17,
      "sourceIconHexagramNumber": 17,
      "hexagramName": "隨",
      "poemText": "安樂几筵，未出王門。",
      "sourceParagraphSha256": "sha256:54fa416f6bd5b202c8f9711f038b3e6a1a2b161283bdeb016f045464f15026ae",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:8bd9fead77fae5a997b9ddb0f4f4a7155558665dd82bc2c68476a98fdc6a6dce"
    },
    {
      "baseHexagramNumber": 19,
      "changedHexagramNumber": 18,
      "sourceEntryNumber": 18,
      "sourceIconHexagramNumber": 18,
      "hexagramName": "蠱",
      "poemText": "大生災禍，下土恩塞，觝亂我國。",
      "sourceParagraphSha256": "sha256:bf1074f31fa9176a37a02922158dc88a1f553ba8586c0aeaddec6570cd1945a8",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:349c3777c312695c90241273c4d6cce2e6d6445d3b70bbf4a99bdef0ab4c5e62"
    },
    {
      "baseHexagramNumber": 19,
      "changedHexagramNumber": 20,
      "sourceEntryNumber": 20,
      "sourceIconHexagramNumber": 20,
      "hexagramName": "觀",
      "poemText": "長生無極，子孫千億。柏柱載梁，堅固不傾。",
      "sourceParagraphSha256": "sha256:b23af69c98feb7a34a79c209c6bf70a590e3993798b80a515e332e26124c81ec",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:2932da6c06fac915562131b3b88ff1a0c6dfbbe212b0a10534dcd2c9e87d2ab5"
    },
    {
      "baseHexagramNumber": 19,
      "changedHexagramNumber": 21,
      "sourceEntryNumber": 21,
      "sourceIconHexagramNumber": 21,
      "hexagramName": "噬嗑",
      "poemText": "欽敬昊天，曆象星辰。宜受民時，陰陽和調。",
      "sourceParagraphSha256": "sha256:7b79e4fb229d5b6eb63a38fe16e606f8d9f6b12eca05b1a62500709c4025ec01",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:a687ebbec43a1d1aa29bf76fc5662f19aafd84d080c874aa4f2952722342b3a7"
    },
    {
      "baseHexagramNumber": 19,
      "changedHexagramNumber": 22,
      "sourceEntryNumber": 22,
      "sourceIconHexagramNumber": 22,
      "hexagramName": "賁",
      "poemText": "三河俱合，水怒踴躍。壞我王室，民困於食。",
      "sourceParagraphSha256": "sha256:5feb8c94541e5c6f43b2ac502d5e7bcbcf54c34e53aff2eff2ffaa2ab7608685",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:87b5b175c2d11e590931719bcc171e346699b191d7281cf73bc7189c6be28010"
    },
    {
      "baseHexagramNumber": 19,
      "changedHexagramNumber": 23,
      "sourceEntryNumber": 23,
      "sourceIconHexagramNumber": 23,
      "hexagramName": "剝",
      "poemText": "壽如松喬，與日月俱。常安康樂，不離禍憂。",
      "sourceParagraphSha256": "sha256:58b517bb6ac756aea5d9dce75d6663a7145619d3e0280bfe150bb0c797cb8250",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:e8095c61c6cd5da10cea511e808a18cab4336126d2b858e07eaaaba4ee9bc0d4"
    },
    {
      "baseHexagramNumber": 19,
      "changedHexagramNumber": 24,
      "sourceEntryNumber": 24,
      "sourceIconHexagramNumber": 24,
      "hexagramName": "復",
      "poemText": "天之所予，福祿常在，不憂危殆。",
      "sourceParagraphSha256": "sha256:9d15255f59e760887acc5c2d15bc3bd114633efc88339a9ffeaa06fcfe9d2381",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:e79c0ee11f1c19b6162be713b6a61c55c7b5d78f786d6dddeb0d1d79e879d005"
    },
    {
      "baseHexagramNumber": 19,
      "changedHexagramNumber": 25,
      "sourceEntryNumber": 25,
      "sourceIconHexagramNumber": 25,
      "hexagramName": "无妄",
      "poemText": "受讖六符，招搖室虛。雖跌無憂，保我命則。",
      "sourceParagraphSha256": "sha256:67c1b6483569be6d6194092b868b7069f36bfc44b2e06be262a3d8a965023951",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:d8349df87cadc956ce178ddf28d5ae0b038ce88368fa9ef1d8a254a012929916"
    },
    {
      "baseHexagramNumber": 19,
      "changedHexagramNumber": 26,
      "sourceEntryNumber": 26,
      "sourceIconHexagramNumber": 26,
      "hexagramName": "大畜",
      "poemText": "金買車，失道後時，勞罷為憂。",
      "sourceParagraphSha256": "sha256:beb0370192b51388b974c671b954a70fcdc679213b141d80e515382eb77ce277",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:88b8b2407ca2659a596f6886efe0321cbffe98674f5d58556db8c61e8a7d94b6"
    },
    {
      "baseHexagramNumber": 19,
      "changedHexagramNumber": 27,
      "sourceEntryNumber": 27,
      "sourceIconHexagramNumber": 27,
      "hexagramName": "頤",
      "poemText": "華首山頭，仙道所遊。利於居止，長無咎憂。",
      "sourceParagraphSha256": "sha256:73186e50b303b33518297d7408cb471f7292ab5daca088b0acbeb50934d9fda3",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:6be46b14921ad41bdf0e976a7154bf0ad7f91732776303312cd704167e48b927"
    },
    {
      "baseHexagramNumber": 19,
      "changedHexagramNumber": 28,
      "sourceEntryNumber": 28,
      "sourceIconHexagramNumber": 28,
      "hexagramName": "大過",
      "poemText": "采唐沫鄉，徼期桑中。失信不會，憂思約帶。",
      "sourceParagraphSha256": "sha256:be037a9e01936499168d383c88824194a3ea82910713d54608457c0499f77329",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:757c8a6dab526314b6d1c25cb7f90aa249178142bab53da6d0a369e4feda821d"
    },
    {
      "baseHexagramNumber": 19,
      "changedHexagramNumber": 29,
      "sourceEntryNumber": 29,
      "sourceIconHexagramNumber": 29,
      "hexagramName": "坎",
      "poemText": "人面九口，長舌為斧。斲破瑚璉，殷商絕後。",
      "sourceParagraphSha256": "sha256:ce7d175c162df6dc2ec6831fe1e8104603b946e09f472db424eb7141bcb437d8",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:252c2b830fedf0f48b1e5b8755f47cb6c3ca03761c3166eaf0756fae6308aba1"
    },
    {
      "baseHexagramNumber": 19,
      "changedHexagramNumber": 30,
      "sourceEntryNumber": 30,
      "sourceIconHexagramNumber": 30,
      "hexagramName": "離",
      "poemText": "臨溪橋疚，雖恐不危，樂以笑歌。",
      "sourceParagraphSha256": "sha256:ce6bdacbd0ada5c560075a65d06708f6c49d0f5e8931665aa7552ad419e28b7b",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:473612b96bb4e6f32ff7b3647094688f9ee46601514a2db31235cae2195a43b6"
    },
    {
      "baseHexagramNumber": 19,
      "changedHexagramNumber": 31,
      "sourceEntryNumber": 31,
      "sourceIconHexagramNumber": 31,
      "hexagramName": "咸",
      "poemText": "泱泱沸溢，水泉為害，使我無賴。",
      "sourceParagraphSha256": "sha256:56ea590858eed9fd928873b1813f9b4f70f7b726b6ee93d01850a4d23df1415b",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ad6b2cca3cddfe8e9c8cdcfa01abb91d80447275363348fef40f1e27b25ecf68"
    },
    {
      "baseHexagramNumber": 19,
      "changedHexagramNumber": 32,
      "sourceEntryNumber": 32,
      "sourceIconHexagramNumber": 32,
      "hexagramName": "恒",
      "poemText": "蝗螟為賊，害我稼穡。秋饑於年，農夫鮮食。",
      "sourceParagraphSha256": "sha256:570637927cc9e538d3f8ab0661229035f67637904a09ed555f5b99928d4bac2c",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ae3f6a0994ba966648ec3c6cef97b1f357e9171006699eaa10dfd1455bf375aa"
    },
    {
      "baseHexagramNumber": 19,
      "changedHexagramNumber": 33,
      "sourceEntryNumber": 33,
      "sourceIconHexagramNumber": 33,
      "hexagramName": "遯",
      "poemText": "八百諸侯，不期同時。慕西文德，興我宗族。家門雍睦。",
      "sourceParagraphSha256": "sha256:a2ad2486386b391c3ab9d400f22cea58b09b9cc820de93b1de73270230b63a7f",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:a92b1e4c6d481785f3fddae7d11a21e3a05095649cc4c9ab8597bbbb0124531e"
    },
    {
      "baseHexagramNumber": 19,
      "changedHexagramNumber": 34,
      "sourceEntryNumber": 34,
      "sourceIconHexagramNumber": 34,
      "hexagramName": "大壯",
      "poemText": "長男少女，相向笑語。來歡致福，和悅樂喜。",
      "sourceParagraphSha256": "sha256:65956208d4ad854381021b7f5ca2affe77d50fe093d4a89caa3b1aff80e9f88e",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:b132b6ae1bef580050fa4a938b8996b89a86da5c3ed79e3ca33ee2d120c8cba4"
    },
    {
      "baseHexagramNumber": 19,
      "changedHexagramNumber": 35,
      "sourceEntryNumber": 35,
      "sourceIconHexagramNumber": 35,
      "hexagramName": "晉",
      "poemText": "平國不君，夏氏作亂。烏號竊發，靈公殞命。",
      "sourceParagraphSha256": "sha256:9a53b624fd729190edc0c25f4552d8a51608c78e47788cb84f8b513b83e117ac",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:47a6e286b42466d96b667ece877e8dc8b2d97552a52f809cd1a00af8233c4235"
    },
    {
      "baseHexagramNumber": 19,
      "changedHexagramNumber": 36,
      "sourceEntryNumber": 36,
      "sourceIconHexagramNumber": 36,
      "hexagramName": "明夷",
      "poemText": "春多膏澤，夏潤優渥。稼穡成熟，畝獲百斛。",
      "sourceParagraphSha256": "sha256:7780f58ce75918c2bfb25e90ce116ffa8ae99eece9fece21012fe8dbf5168bc9",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:c33e9f025dc5fbd141e27bf9bd07e65a733040700d8ac944e5807ee81e606152"
    },
    {
      "baseHexagramNumber": 19,
      "changedHexagramNumber": 37,
      "sourceEntryNumber": 37,
      "sourceIconHexagramNumber": 37,
      "hexagramName": "家人",
      "poemText": "客宿臥寒，席蓐不安。行為危害，留不得歡。",
      "sourceParagraphSha256": "sha256:559396721aafc9ce88524952bd6f5f77fb2d6c5fbbe2585197a2f1f416aa7cd3",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:74bb9fc050fcccd9ed4ab9651acb2f4455325a267139be4e9b3120a43ba54cf2"
    },
    {
      "baseHexagramNumber": 19,
      "changedHexagramNumber": 38,
      "sourceEntryNumber": 38,
      "sourceIconHexagramNumber": 38,
      "hexagramName": "睽",
      "poemText": "乘槎浮海，雖懼不殆。母載其子，終焉何咎。",
      "sourceParagraphSha256": "sha256:d24891758be6bc10c4f5039641ab8afa8b79d697ab2912859b13c81ff58e776d",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:a80762cddb4a55f51110b2471d55fb68abbe452ae8cae90b32e1f00b45269f1d"
    },
    {
      "baseHexagramNumber": 19,
      "changedHexagramNumber": 39,
      "sourceEntryNumber": 39,
      "sourceIconHexagramNumber": 39,
      "hexagramName": "蹇",
      "poemText": "手拙不便，不能伐檀。車無軸轅，行者苦難。",
      "sourceParagraphSha256": "sha256:515e79394346a42a9d529357c09af77cbda2f7f7c39d1ebf9322e5ab396efba2",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:c2d7b3951062128de9bb5cee9a21c0b209c76f10ebfebd39d9d232e62fce5234"
    },
    {
      "baseHexagramNumber": 19,
      "changedHexagramNumber": 40,
      "sourceEntryNumber": 40,
      "sourceIconHexagramNumber": 40,
      "hexagramName": "解",
      "poemText": "唐虞相輔，鳥獸率無。民安無事，國家富有。",
      "sourceParagraphSha256": "sha256:646e7d5058da8b9d827f21a489c2d749f6763971e11696b073827dccb0fe2ed8",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ff20147892cf8d4abb667b5a6b9c5284785ea7692dea07701426fea0bf195ad1"
    },
    {
      "baseHexagramNumber": 19,
      "changedHexagramNumber": 41,
      "sourceEntryNumber": 41,
      "sourceIconHexagramNumber": 41,
      "hexagramName": "損",
      "poemText": "秋蛇向穴，不失其節。夫人姜氏，自齊復入。",
      "sourceParagraphSha256": "sha256:39708572901a50f0cf1b6cddd45acded5935843c21bd666beb00d270b17e7246",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:4a6db575a3cc37ae149d58c7a6d0359c06cd86845904fe92915173d8ad11e03a"
    },
    {
      "baseHexagramNumber": 19,
      "changedHexagramNumber": 42,
      "sourceEntryNumber": 42,
      "sourceIconHexagramNumber": 42,
      "hexagramName": "益",
      "poemText": "病篤難醫，和不能治。命終永訖，下即蒿蘆。",
      "sourceParagraphSha256": "sha256:a5a55868bd936ce332799c8d906ff2b0423d4afb7a6e15bdd49fb6070736dd32",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:d905f086416a35b42330c02b631377691abf6018c1c5c23e9c44a8293d0fa84f"
    },
    {
      "baseHexagramNumber": 19,
      "changedHexagramNumber": 43,
      "sourceEntryNumber": 43,
      "sourceIconHexagramNumber": 43,
      "hexagramName": "夬",
      "poemText": "青蛉如雲，城邑閉門。國君御守，民困於患。",
      "sourceParagraphSha256": "sha256:e7c8c959d1fa82f1fb2161beff6b52dccb79ce07981c031d778ed4126aa9ceac",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:b4d009e8cefe3014090ca2c4c483fdcfe7dc3436738d3b32c79565c1a343a7a1"
    },
    {
      "baseHexagramNumber": 19,
      "changedHexagramNumber": 44,
      "sourceEntryNumber": 44,
      "sourceIconHexagramNumber": 44,
      "hexagramName": "姤",
      "poemText": "牙孽生齒，室堂啟戶。出入利貞，鼓翼起舞。",
      "sourceParagraphSha256": "sha256:c74efc7b1f4c4f9e890be32beb7f0a18dbc18b8014e28f79a669f197fa5939f8",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:e3a806c095f1686cb65cc8c266a1abdf3f823065b03f4d219530e604a0262696"
    },
    {
      "baseHexagramNumber": 19,
      "changedHexagramNumber": 45,
      "sourceEntryNumber": 45,
      "sourceIconHexagramNumber": 45,
      "hexagramName": "萃",
      "poemText": "鳧游江湖，役行千里。以為死亡，復見空桑，長生樂鄉。",
      "sourceParagraphSha256": "sha256:51d38f69371686ca751180109c41651dd1ec3fd4f59043d7643adc518b97eb8e",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:beaedb35218d9eaf7a145387c1b5277ca205f77cab1c07e785254d5f673c537d"
    },
    {
      "baseHexagramNumber": 19,
      "changedHexagramNumber": 46,
      "sourceEntryNumber": 46,
      "sourceIconHexagramNumber": 46,
      "hexagramName": "升",
      "poemText": "黃帝出遊，駕龍乘鳳。東上泰山，南遊齊魯。邦國咸喜。",
      "sourceParagraphSha256": "sha256:6d66c0d679018c55ff3b9934a3e360b6ee95a836dbeb07106e6c2930d811d841",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:32ca0c0e7583f3c2e23158e73cf721c5e5c5aec04818826564698226344d1ba5"
    },
    {
      "baseHexagramNumber": 19,
      "changedHexagramNumber": 47,
      "sourceEntryNumber": 47,
      "sourceIconHexagramNumber": 47,
      "hexagramName": "困",
      "poemText": "履危不止，與鬼相視。驚恐失氣，如騎虎尾。",
      "sourceParagraphSha256": "sha256:0b1a887a1e7aafd30be7e46ebe30392c28b7f011bc68f59f88c565cdf2a87023",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:04b5e5bc37dde5d261398e9ad115a1615ad0e89b4aff7631466e8b9bdbfe29ba"
    },
    {
      "baseHexagramNumber": 19,
      "changedHexagramNumber": 48,
      "sourceEntryNumber": 48,
      "sourceIconHexagramNumber": 48,
      "hexagramName": "井",
      "poemText": "秋南春北，不失消息。涉和履中，時無陰匿。",
      "sourceParagraphSha256": "sha256:01fecf8a54b92043ca7e60f067a78c239be5a7dc2dcfc85621484eed10c1590c",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:0999805630bd1e070db6dce4ceca567bb87e96c0bbe2ea70119007a265762088"
    },
    {
      "baseHexagramNumber": 19,
      "changedHexagramNumber": 49,
      "sourceEntryNumber": 49,
      "sourceIconHexagramNumber": 49,
      "hexagramName": "革",
      "poemText": "龍門砥柱，通利水道。百川順流，民安其居。",
      "sourceParagraphSha256": "sha256:4660e9f35e59cbff9b5a017827581ed7f263999682108cc6f277913adec3a3d8",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:34024f32da2dea8b9131d707b0ee7e20d048efca7bcea5f5a9a28a96973a6dc8"
    },
    {
      "baseHexagramNumber": 19,
      "changedHexagramNumber": 50,
      "sourceEntryNumber": 50,
      "sourceIconHexagramNumber": 50,
      "hexagramName": "鼎",
      "poemText": "千歲廟堂，棟橈傾僵。天厭周德，失其寵光。",
      "sourceParagraphSha256": "sha256:ddd6b129f0d11558b088f3e47bd0d10e9dc15f7764cc4072cc2a18d4034591f3",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:6009aaf4a06bd35e7f7049fb560bc4a2fbcdde0b2da2a35e7c9c3575952d6bb2"
    },
    {
      "baseHexagramNumber": 19,
      "changedHexagramNumber": 51,
      "sourceEntryNumber": 51,
      "sourceIconHexagramNumber": 51,
      "hexagramName": "震",
      "poemText": "折箬蔽目，不見稚叔。五足孤鳥，遠離室家。",
      "sourceParagraphSha256": "sha256:f081510b9ea676a0f8630946de09b7a0b36d4445bef88e936f44625c1735cb3d",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:425a7c8a3ff03575bc3695032394027e17dbf3c84d3c55ea89e99e2361b2362b"
    },
    {
      "baseHexagramNumber": 19,
      "changedHexagramNumber": 52,
      "sourceEntryNumber": 52,
      "sourceIconHexagramNumber": 52,
      "hexagramName": "艮",
      "poemText": "望叔山北，陵隔我目。不見所得，使我心惑。",
      "sourceParagraphSha256": "sha256:c89d711cfddb6ea853263d9d67375dd10fe54d9d63bd2c6338eb01df6a7e4895",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:b6b680066769dceda81507d09db6bf7d25a5f3b7b081772fc8bd577735daa56e"
    },
    {
      "baseHexagramNumber": 19,
      "changedHexagramNumber": 53,
      "sourceEntryNumber": 53,
      "sourceIconHexagramNumber": 53,
      "hexagramName": "漸",
      "poemText": "匏瓠之息，一畝十室。萬國都邑，北門有福。",
      "sourceParagraphSha256": "sha256:826d249243427d3762b4e9b7d51d20847142ccfb2fd720648d0c3d10ea4e9081",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:f82a4089cf31ef4735e5cc2acd72d4487e39a91cde539a795f4eb6706b033875"
    },
    {
      "baseHexagramNumber": 19,
      "changedHexagramNumber": 54,
      "sourceEntryNumber": 54,
      "sourceIconHexagramNumber": 54,
      "hexagramName": "歸妹",
      "poemText": "域域牧牧，憂和相伴。隔我巖山，室家分散。",
      "sourceParagraphSha256": "sha256:9f2265dc025ea40d95f745ab1b9168fc6f10b17e42352f9262ebaf77d12d9e8d",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:30456db2f9413bad58e7a1350158745ba05010ad8d139b16b1341b4380461ea7"
    },
    {
      "baseHexagramNumber": 19,
      "changedHexagramNumber": 55,
      "sourceEntryNumber": 55,
      "sourceIconHexagramNumber": 55,
      "hexagramName": "豐",
      "poemText": "麒麟騄耳，遊食萍草。逍遙石門，循山上下。不失其子。",
      "sourceParagraphSha256": "sha256:bd3b500ce2338408ada2b4a2cea426e84872e5bb4e538839322197855a1ef10e",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:fbdfa9dacc7a9b1883bc6708ecfbbc5af58378de68b5dd9d85a87a0532419b9b"
    },
    {
      "baseHexagramNumber": 19,
      "changedHexagramNumber": 56,
      "sourceEntryNumber": 56,
      "sourceIconHexagramNumber": 56,
      "hexagramName": "旅",
      "poemText": "天所祚昌，文以為良。篤生武王，姬受其福。",
      "sourceParagraphSha256": "sha256:55a28f7ceafc4fbd2a9784710463845620174b5d3ce268e30624d5362eb75db2",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:d609381a11e10ea8d67bcbe23be6dff49cbd51a103b9b1294d2e4aa2c4ec223f"
    },
    {
      "baseHexagramNumber": 19,
      "changedHexagramNumber": 57,
      "sourceEntryNumber": 57,
      "sourceIconHexagramNumber": 57,
      "hexagramName": "巽",
      "poemText": "羊腸九縈，相推稍前。止須王孫，乃能上天。",
      "sourceParagraphSha256": "sha256:ba1b710068f5bd5f34af450de4291a4125eb2aba102c95cca45f01023b715f25",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:9927d47dc2b547bd6066ba12527fa7fd99a45c7de81398d91620107a7a22d335"
    },
    {
      "baseHexagramNumber": 19,
      "changedHexagramNumber": 58,
      "sourceEntryNumber": 58,
      "sourceIconHexagramNumber": 58,
      "hexagramName": "兌",
      "poemText": "貧鬼守門，日破我盆。孤牝不駒，雞不成雛。",
      "sourceParagraphSha256": "sha256:e1ca9204c6d9666abb6f24a564a9aba6ecfbc513042bb1ab775d1d11c6609215",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:90896bf9e59ddd0c45dc907bb90080683a11a6254a5353e9692a75026aa18d86"
    },
    {
      "baseHexagramNumber": 19,
      "changedHexagramNumber": 59,
      "sourceEntryNumber": 59,
      "sourceIconHexagramNumber": 59,
      "hexagramName": "渙",
      "poemText": "飽食從容，入門上堂。不失其常，家無咎殃。",
      "sourceParagraphSha256": "sha256:da7e2ecc7da6f0d90c247cbcd558091111186b86cec8f6cf51e90614394d1783",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:c5db9a9da35cd3fd019c0f9b4851a0ec29aa9fb31481960a9e7c3dde310eca4d"
    },
    {
      "baseHexagramNumber": 19,
      "changedHexagramNumber": 60,
      "sourceEntryNumber": 60,
      "sourceIconHexagramNumber": 60,
      "hexagramName": "節",
      "poemText": "陰淫不止，白馬為海。澤皋之子，就高而處。",
      "sourceParagraphSha256": "sha256:0f167146c3e0dd8afa4dd6435d48ead3d8ec1c1fe24439c06559f545d1858ecb",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:63a305d811870d2a3de5e1d304e751eb423e0783e1a03f15f3523d2e3f7c1074"
    },
    {
      "baseHexagramNumber": 19,
      "changedHexagramNumber": 61,
      "sourceEntryNumber": 61,
      "sourceIconHexagramNumber": 61,
      "hexagramName": "中孚",
      "poemText": "執戈俱立，以備暴急。千人舉龍，困危得海。終安何畏。",
      "sourceParagraphSha256": "sha256:e5e23ad5b511bab272af1c5913f02866bba64d40eb9750ed256f15159fd987a3",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:b215ba093a1e304c41d835f70a3113b326cdacb6d3f4182c2d2c0a5465e75652"
    },
    {
      "baseHexagramNumber": 19,
      "changedHexagramNumber": 62,
      "sourceEntryNumber": 62,
      "sourceIconHexagramNumber": 62,
      "hexagramName": "小過",
      "poemText": "夾河為婚，水漲無船。追心失望，不見歡君。",
      "sourceParagraphSha256": "sha256:c03ebdc18ee40aa11bf510040004af4881dd55ce17aa22cc26102f56cfd467bd",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:cd0148f6a08c01fd093a5c362d6079deaac22fdcec72ceccc4d83dfcb935fb1c"
    },
    {
      "baseHexagramNumber": 19,
      "changedHexagramNumber": 63,
      "sourceEntryNumber": 63,
      "sourceIconHexagramNumber": 63,
      "hexagramName": "既濟",
      "poemText": "陰陽變化，各得其宜。上下順通，奏為膚功。",
      "sourceParagraphSha256": "sha256:7b632ddda16ef761615569ba38f82c2a900c383276fbc1b6fc4e3e55a516da89",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:94cf59549e121ca5a38c6d0d3b43f5811c49a86c05ab5d438b8c4e340fe51f71"
    },
    {
      "baseHexagramNumber": 19,
      "changedHexagramNumber": 64,
      "sourceEntryNumber": 64,
      "sourceIconHexagramNumber": 64,
      "hexagramName": "未濟",
      "poemText": "狂劣德薄，失其臣妾。田不見禽，犬無所得。",
      "sourceParagraphSha256": "sha256:0a974b33a7eacd84d24d0647ed23a44f7b49b416f2a7e8bfc49bb14cdb771f3b",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:d3104487c2de0b6569b58994ff94c2552c252fc4eff543d89089f095b28eb928"
    }
  ]
}
