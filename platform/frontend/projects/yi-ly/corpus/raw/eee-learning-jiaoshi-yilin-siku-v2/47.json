  "entryCount": 64,
  "missingTargets": [],
  "entries": [
    {
      "baseHexagramNumber": 47,
      "changedHexagramNumber": 47,
      "sourceEntryNumber": 47,
      "sourceIconHexagramNumber": 47,
      "hexagramName": "困",
      "poemText": "席多針刺，不可以臥，動而有悔，言行俱過。",
      "sourceParagraphSha256": "sha256:fd5ff5492e3fdaf69152a56050b8a84587ce2f46e30c6dd4db5faa0205f971d3",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:3c5785b0bd30347bd37d09f426af4ca7626a58d451fdead0fde64cdb67c47e30"
    },
    {
      "baseHexagramNumber": 47,
      "changedHexagramNumber": 1,
      "sourceEntryNumber": 1,
      "sourceIconHexagramNumber": 1,
      "hexagramName": "乾",
      "poemText": "烏鵲食穀，張口受哺，蒙被恩德，長大成就。柔順利貞，君臣合好。",
      "sourceParagraphSha256": "sha256:92efb71619c72e3692b1667c58332829e73374b0d4cf87a20700ef31f63bdebf",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:17d9c6e500138cb6202e37effc6abb2721f7e411feb0692d064ffd6a551e1c59"
    },
    {
      "baseHexagramNumber": 47,
      "changedHexagramNumber": 2,
      "sourceEntryNumber": 2,
      "sourceIconHexagramNumber": 2,
      "hexagramName": "坤",
      "poemText": "六鷁退飛，為襄敗祥，陳師合戰，右股夷傷，遂以薨崩，霸功不終。",
      "sourceParagraphSha256": "sha256:1eefa804135c0c25ba4c1b7850d23e4183006546a3093190148d558ef8e14031",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:9362d1996c8670d288ad569dab5a7fa4e86d6bd6c96f15f9582fc2febaefcec0"
    },
    {
      "baseHexagramNumber": 47,
      "changedHexagramNumber": 3,
      "sourceEntryNumber": 3,
      "sourceIconHexagramNumber": 3,
      "hexagramName": "屯",
      "poemText": "匍匐出走，驚惶悼恐，白虎王孫，蓐收在後，居中无咎。",
      "sourceParagraphSha256": "sha256:234b666889f56c5161fcfb99f25c331a7f6ca1ee5d25c9c2357ca6251afa10c5",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:d2051fd0a5fff70cd75c52fdf7ec2be34f625e00c400987954ea41c6dfc7bae8"
    },
    {
      "baseHexagramNumber": 47,
      "changedHexagramNumber": 4,
      "sourceEntryNumber": 4,
      "sourceIconHexagramNumber": 4,
      "hexagramName": "蒙",
      "poemText": "庇盧不明，使孔德妨，女孽亂國，虐政傷仁。",
      "sourceParagraphSha256": "sha256:25bc961858b8f81bcb2e400df4129bb25f3521b5406d334c59d109bfe344fa84",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:20b26555d517c6c715b641d1ad40137e6958133eabfba3aa0f1a9fb4d7b3fd0f"
    },
    {
      "baseHexagramNumber": 47,
      "changedHexagramNumber": 5,
      "sourceEntryNumber": 5,
      "sourceIconHexagramNumber": 5,
      "hexagramName": "需",
      "poemText": "石屬四足，不能上屋，顏氏淑德，未有爵祿。",
      "sourceParagraphSha256": "sha256:e7aa309d81abe3e7f8ec59f1dbcb14aa0103ada27b07006926047c74d7c22cd9",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:126aa9422105683a909141cf0e2fcc7475865d31e7b32853285ce374ad61d92b"
    },
    {
      "baseHexagramNumber": 47,
      "changedHexagramNumber": 6,
      "sourceEntryNumber": 6,
      "sourceIconHexagramNumber": 6,
      "hexagramName": "訟",
      "poemText": "襄送季女，至於蕩道，齊子旦夕，留連久處。",
      "sourceParagraphSha256": "sha256:c14e66fb54db6f40da2814246e893804be18f9b85930d6f5fccbf55c43715870",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:d347d88eab456b6dae13bb79c6d943dd417c5b2cb03448d3d8bce337ede997c4"
    },
    {
      "baseHexagramNumber": 47,
      "changedHexagramNumber": 7,
      "sourceEntryNumber": 7,
      "sourceIconHexagramNumber": 7,
      "hexagramName": "師",
      "poemText": "麞鹿逐牧，飽歸其居，還反次舍，樂得自如。",
      "sourceParagraphSha256": "sha256:c21f4552403281a48205c108da285f685983fd30236dbc13e8fff16eba0a2b1d",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:bb2dcf4a46971f20809cb0d5cc0dd38e9965cc6346992e572bfbd3f4b73d909a"
    },
    {
      "baseHexagramNumber": 47,
      "changedHexagramNumber": 8,
      "sourceEntryNumber": 8,
      "sourceIconHexagramNumber": 8,
      "hexagramName": "比",
      "poemText": "望尚阿衡，太宰周公，藩屏湯武，立為侯王。",
      "sourceParagraphSha256": "sha256:e2a3582f8ad6c7b9098889af91290672f170f3bbccd31eefa491587fb0f42314",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:0e8d29367ae7acc9e80405f13548e9fcbd82a1f32d75eaafe34e3af6786936ae"
    },
    {
      "baseHexagramNumber": 47,
      "changedHexagramNumber": 9,
      "sourceEntryNumber": 9,
      "sourceIconHexagramNumber": 9,
      "hexagramName": "小畜",
      "poemText": "開廓洪緒，王迹所基，報以八子，功得俟時。",
      "sourceParagraphSha256": "sha256:ef2ba708653f29dde4f4f252f5af5a0de45adeadd70d4aa6f7e9ec0c4d724cd9",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:a8d755ed02cf4e42de3cb09f2d71786271a23ff5184720df96b64988c0cf9af4"
    },
    {
      "baseHexagramNumber": 47,
      "changedHexagramNumber": 10,
      "sourceEntryNumber": 10,
      "sourceIconHexagramNumber": 10,
      "hexagramName": "履",
      "poemText": "八會大都，饒富有餘，安民利國，可以長居。",
      "sourceParagraphSha256": "sha256:ac94edd45d3321fa4e0fdb250ff6859ef4b672b8bbeb8df490838be183817d5a",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:370c2e475e287a41fa34630b9e839f05ab0ab7623c47f9d663a3531393c4d855"
    },
    {
      "baseHexagramNumber": 47,
      "changedHexagramNumber": 11,
      "sourceEntryNumber": 11,
      "sourceIconHexagramNumber": 11,
      "hexagramName": "泰",
      "poemText": "陰雲四方，日在中央，人雖昏霧，我獨昭明。",
      "sourceParagraphSha256": "sha256:c68ad5b7d89654eeba9dd95711ffe7b774dcc14a63087d87067dbdd1cbcb40c2",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:0ac47ef55b234e52bef8ad749f9c384233d1b7bb8595c1c50004013f80e0f76a"
    },
    {
      "baseHexagramNumber": 47,
      "changedHexagramNumber": 12,
      "sourceEntryNumber": 12,
      "sourceIconHexagramNumber": 12,
      "hexagramName": "否",
      "poemText": "薄為災虐，風吹雲卻，欲上不得，復規其宅。",
      "sourceParagraphSha256": "sha256:3bbd33b9704569c2076f5f8c40617f89aa83d00e9b2b0593242e206a9244fac7",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:4f9ae748de4a4ae0f9621ee545c2f85f7a8fc62705f3e40e7eace9fbffbddf17"
    },
    {
      "baseHexagramNumber": 47,
      "changedHexagramNumber": 13,
      "sourceEntryNumber": 13,
      "sourceIconHexagramNumber": 13,
      "hexagramName": "同人",
      "poemText": "昭昭略略，非忠信客，言語反覆，以黑為白。",
      "sourceParagraphSha256": "sha256:6347be6bccd3dbe936b24d1feede4507f37b65792f6258e4900037e5170cb31a",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:4d3580c9a127e0141b6a5fcea5c24540df948f8158da47a6052ff34df1affa41"
    },
    {
      "baseHexagramNumber": 47,
      "changedHexagramNumber": 14,
      "sourceEntryNumber": 14,
      "sourceIconHexagramNumber": 14,
      "hexagramName": "大有",
      "poemText": "三女為姦，俱遊高園，背室夜行，與伯笑言，禍及乃身，冤死誰禱。",
      "sourceParagraphSha256": "sha256:9fd890ceeb1ecd37ee9bf15db6ce5d5976d0a401e7e9b81a9f376d0d0113ea9e",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ee9bd01063189c918bea82a7a0c3fec82687af491a66921f7e7ceacec5cdb863"
    },
    {
      "baseHexagramNumber": 47,
      "changedHexagramNumber": 15,
      "sourceEntryNumber": 15,
      "sourceIconHexagramNumber": 15,
      "hexagramName": "謙",
      "poemText": "涉尸留鬼，大斧所視，文昌司過，簡公亂死。",
      "sourceParagraphSha256": "sha256:ceb1a66204f36a06a235913cd84d52e63fde202a0fcd082e3cf4a57fcd45d2aa",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:a78ea494b5f95c7e7ba2560dce3c078fd98024ee8653ce951eb4ed91b01a0c55"
    },
    {
      "baseHexagramNumber": 47,
      "changedHexagramNumber": 16,
      "sourceEntryNumber": 16,
      "sourceIconHexagramNumber": 16,
      "hexagramName": "豫",
      "poemText": "大足長股，利出行道，困倉充盈，疏齒善市，宜錢富家，事得萬倍。",
      "sourceParagraphSha256": "sha256:f9da8351d63149b57643f72ff4b66820555e20157f990eaa6ca44bc602b23e8f",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:1f97f3eac6f6862260004f9e8b33dff1b5aa7c83ad8328abb6d12941b651b670"
    },
    {
      "baseHexagramNumber": 47,
      "changedHexagramNumber": 17,
      "sourceEntryNumber": 17,
      "sourceIconHexagramNumber": 17,
      "hexagramName": "隨",
      "poemText": "筐筥錡釜，可活百口，伊氏鼎俎，大福所起。",
      "sourceParagraphSha256": "sha256:650772fbfc180bdf43578eed50c42a8ef2b219e10e4a65df72b2afe4c736df0a",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:3f6eafff7e07068e99b4b1f3eb357df3f63cebcb00c4f8241b392741dcc270f0"
    },
    {
      "baseHexagramNumber": 47,
      "changedHexagramNumber": 18,
      "sourceEntryNumber": 18,
      "sourceIconHexagramNumber": 18,
      "hexagramName": "蠱",
      "poemText": "升高登虛，欲有望侯，駕之北邑，與喜相扶。",
      "sourceParagraphSha256": "sha256:94de293186e64f687b9feb076229008e1b1b5e37b244291008781588a4085247",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:68474e565ea3f215e257acc9fafdc71d23e58745678ff4d265710c26705787de"
    },
    {
      "baseHexagramNumber": 47,
      "changedHexagramNumber": 19,
      "sourceEntryNumber": 19,
      "sourceIconHexagramNumber": 19,
      "hexagramName": "臨",
      "poemText": "用彼嘉賓，政平且均，螟蟲不作，民得安寧。",
      "sourceParagraphSha256": "sha256:fe173e0ac0803d0df7c9888e0fbdb01adbc32eaed54b722335f7c6145c41abbb",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:5b01ee00c03c8159b3311461c4e93fd791043494a279aead7a80bffa8b12f38c"
    },
    {
      "baseHexagramNumber": 47,
      "changedHexagramNumber": 20,
      "sourceEntryNumber": 20,
      "sourceIconHexagramNumber": 20,
      "hexagramName": "觀",
      "poemText": "桃夭少葉，婚悅宜家，君子樂胥，長利止居。",
      "sourceParagraphSha256": "sha256:365cd5737699a01f3d5095592fd914c13032c1c68ae4b09dc49ba43214ae6681",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:916590f24abca3a74e997b860b518278327d9af84b3f839e58450c781cfb0198"
    },
    {
      "baseHexagramNumber": 47,
      "changedHexagramNumber": 21,
      "sourceEntryNumber": 21,
      "sourceIconHexagramNumber": 21,
      "hexagramName": "噬嗑",
      "poemText": "東行失旅，不知所處，西歸无妃，莫與笑語。",
      "sourceParagraphSha256": "sha256:a8eac1362e6f5e495fd2a4cc0d93ec0e02be59b251ce9d4a314c5f6d3071392b",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:a9e59954e4b85bc35450e1be55cb92bf0cf39839ebfc28d6aa2260614377fd27"
    },
    {
      "baseHexagramNumber": 47,
      "changedHexagramNumber": 22,
      "sourceEntryNumber": 22,
      "sourceIconHexagramNumber": 22,
      "hexagramName": "賁",
      "poemText": "玩好亂目，巧聲迷耳，賊敗貞良，君受其咎。",
      "sourceParagraphSha256": "sha256:4664db0a1b064fff597bbdc3c616afd3fce7db73e4578dd15d007f7c7b73a47e",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:5538b4f6ef0fed14eb280189de59034bff1fea562fea6f97180a475c4328eca7"
    },
    {
      "baseHexagramNumber": 47,
      "changedHexagramNumber": 23,
      "sourceEntryNumber": 23,
      "sourceIconHexagramNumber": 23,
      "hexagramName": "剝",
      "poemText": "明德孔嘉，萬歲无虧，駕龍巡狩，王得安所。",
      "sourceParagraphSha256": "sha256:ffd2caccbd899c700819c9d73e69f2e4dd72e3bcb0f6e3f2993112ac04f14750",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:18078b7939cac2552af5d968060fd732e24a556ce474b436cfef7cf613c7bf34"
    },
    {
      "baseHexagramNumber": 47,
      "changedHexagramNumber": 24,
      "sourceEntryNumber": 24,
      "sourceIconHexagramNumber": 24,
      "hexagramName": "復",
      "poemText": "同本巽葉，樂仁尚德，東鄰慕義，來興吾國。",
      "sourceParagraphSha256": "sha256:31d74aa182fe95be0fcbedc1179bf7a6251bdaf94e89400d895fe19f5befc4ee",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:89599080ef011a8715ba598c26087078df8aed59a5872ad743215f1d0960a627"
    },
    {
      "baseHexagramNumber": 47,
      "changedHexagramNumber": 25,
      "sourceEntryNumber": 25,
      "sourceIconHexagramNumber": 25,
      "hexagramName": "无妄",
      "poemText": "戴山崔嵬，曰高无頹，軍主好德，賜以家國。",
      "sourceParagraphSha256": "sha256:b77df9000cf5151e17ed5e58d4f13c6302b99a9eadc3769447c00137c3cf5bba",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:f16b9d91e27ac79da9f868015847abe0a834eed8a28f19377f4611d903aefb65"
    },
    {
      "baseHexagramNumber": 47,
      "changedHexagramNumber": 26,
      "sourceEntryNumber": 26,
      "sourceIconHexagramNumber": 26,
      "hexagramName": "大畜",
      "poemText": "築室合歡，千里无患，周公萬年，佑我二人。",
      "sourceParagraphSha256": "sha256:f5f03e552e4f023701d2661bd0a5413a50dfe35728bf33bdc06c780a6512f172",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:9017588b173de8c134fb34dac564ba3b30f8df46a67ae92877bd3769d67fadfd"
    },
    {
      "baseHexagramNumber": 47,
      "changedHexagramNumber": 27,
      "sourceEntryNumber": 27,
      "sourceIconHexagramNumber": 27,
      "hexagramName": "頤",
      "poemText": "養雞生雛，畜馬得駒，明堂太學，君子所居。",
      "sourceParagraphSha256": "sha256:cad1ba849886b69d8a13b00b3b1742452012adc909e05b67da0ecde47b49a258",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:40e89f60b0820bc4b83e3ac0696a1858466b1bc775f37d54c1021cda39c113d6"
    },
    {
      "baseHexagramNumber": 47,
      "changedHexagramNumber": 28,
      "sourceEntryNumber": 28,
      "sourceIconHexagramNumber": 28,
      "hexagramName": "大過",
      "poemText": "雷行相逐，无有休息，戰于平陸，為夷所覆。",
      "sourceParagraphSha256": "sha256:1892c3fd6ba8bd0fa161b56be1cee58733be709cf9698d1da65f21f3e4d8af3c",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:3b5cb92481be6f7d0fa3a8d1ed4db4206cba9874cf3ce7eea4837b291b6264f8"
    },
    {
      "baseHexagramNumber": 47,
      "changedHexagramNumber": 29,
      "sourceEntryNumber": 29,
      "sourceIconHexagramNumber": 29,
      "hexagramName": "坎",
      "poemText": "委蛇循河，北至海涯，涉歷要荒，君世无他。",
      "sourceParagraphSha256": "sha256:f8f57ab6a950675db8e4806d3fb4c81fd550a4a1b172cc8b51b29abe7bb1f8fc",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:deec946cddc94fc552382722319b88ffb6efea604a61f1d4dd31ecd70b3987ff"
    },
    {
      "baseHexagramNumber": 47,
      "changedHexagramNumber": 30,
      "sourceEntryNumber": 30,
      "sourceIconHexagramNumber": 30,
      "hexagramName": "離",
      "poemText": "鴻聲大視，高舉神化，背昧向明，以道福功。",
      "sourceParagraphSha256": "sha256:a639a44ad3d1bb7fc387b068411096740af1f568f148a43d08036f56b09fdf90",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ff431c06827c72451b62a43a66b81b767c7f2346eebad6b75e21ecaeb330887a"
    },
    {
      "baseHexagramNumber": 47,
      "changedHexagramNumber": 31,
      "sourceEntryNumber": 31,
      "sourceIconHexagramNumber": 31,
      "hexagramName": "咸",
      "poemText": "比目四翼，來安吾國，福善上堂，與我同床。",
      "sourceParagraphSha256": "sha256:f9f24448bc6d9821ff210b950501f803cd588063c03077db0e06cc0dbaee3035",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:58d93f0f67cf2403756547197f0dbd2f27cee3d486215fa4b48fede2aff93793"
    },
    {
      "baseHexagramNumber": 47,
      "changedHexagramNumber": 32,
      "sourceEntryNumber": 32,
      "sourceIconHexagramNumber": 32,
      "hexagramName": "恒",
      "poemText": "先縠彘季，反謀桓子，不從元帥，遂行挑戰，為荊所敗。",
      "sourceParagraphSha256": "sha256:c7ba32a5c2eca668d107bb284dae6fabefc27686ece976b182aeea01d0979c09",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:b56927563135f05ad52d8891f004c799daa7c9509435f0dfefb520c1aada5a50"
    },
    {
      "baseHexagramNumber": 47,
      "changedHexagramNumber": 33,
      "sourceEntryNumber": 33,
      "sourceIconHexagramNumber": 33,
      "hexagramName": "遯",
      "poemText": "三頭六足，欲盜東國，顏子在邇，禍滅不成。",
      "sourceParagraphSha256": "sha256:aceb6949e6a066e294594558d53859b109a49d762bc42f945e15885f20e23e1a",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:4a2103de6220690b7752ed8642447d5dc8516efac387246af82ff737a9c5609e"
    },
    {
      "baseHexagramNumber": 47,
      "changedHexagramNumber": 34,
      "sourceEntryNumber": 34,
      "sourceIconHexagramNumber": 34,
      "hexagramName": "大壯",
      "poemText": "緣山升木，中墮於谷，子輿失勞，黃鳥哀作。",
      "sourceParagraphSha256": "sha256:df66970c99241160982402c7469088737fa11ff9758fa2b2731291b39f1b809a",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:43d1e67fc78f128ccf62504a55dfc98e70d7d75839e640f9bd45e21130517f3a"
    },
    {
      "baseHexagramNumber": 47,
      "changedHexagramNumber": 35,
      "sourceEntryNumber": 35,
      "sourceIconHexagramNumber": 35,
      "hexagramName": "晉",
      "poemText": "南有嘉魚，駕黃娶鱗，魴鯉瀰瀰，利來无憂。",
      "sourceParagraphSha256": "sha256:682a15e75e7dc35e75b91f385bdd4023b6d0bca6c493695da639e5a63447db16",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:3d3a10823c7c8e65a51582a925b60826b33f4342d6bf0ef49e69ce7e7b30844c"
    },
    {
      "baseHexagramNumber": 47,
      "changedHexagramNumber": 36,
      "sourceEntryNumber": 36,
      "sourceIconHexagramNumber": 36,
      "hexagramName": "明夷",
      "poemText": "邃氣作雲，蒙覆大君，塞聰閉明，殷人賈傷。",
      "sourceParagraphSha256": "sha256:a5f1b6f450f18da4e044cfc93f3376046ee934a0b86750cf9a7a073a5d34b061",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:5e1a500c0da866b366e2f189da137b660a2e4929696f7143eecb09c828c8a01e"
    },
    {
      "baseHexagramNumber": 47,
      "changedHexagramNumber": 37,
      "sourceEntryNumber": 37,
      "sourceIconHexagramNumber": 37,
      "hexagramName": "家人",
      "poemText": "舉翅櫖翼，跂望南國，延頸卻縮，未有所得。",
      "sourceParagraphSha256": "sha256:8cdef8973c07f8b3c1b2c8d42d85b266e967ab2f37a88120870c0e2a78b3fb32",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:28c4e14d5d0683ee4a0e8b458bad407ff59b7e5402ce6b2cfca8af36b061458e"
    },
    {
      "baseHexagramNumber": 47,
      "changedHexagramNumber": 38,
      "sourceEntryNumber": 38,
      "sourceIconHexagramNumber": 38,
      "hexagramName": "睽",
      "poemText": "坎中蝦蟆，乍盈乍虛，三夕二朝，形消无餘。",
      "sourceParagraphSha256": "sha256:c9e4d0cbeb0ca8027840aa50cda6eee5d924550025eff6c0588b8e8c6f7f0428",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:3b20577efc9838f4725dc4516797806c205b6a39f0a030836ade2264aaa95762"
    },
    {
      "baseHexagramNumber": 47,
      "changedHexagramNumber": 39,
      "sourceEntryNumber": 39,
      "sourceIconHexagramNumber": 39,
      "hexagramName": "蹇",
      "poemText": "僮子射御，不知所定，質疑蓍龜，孰知所避。國安土樂，宜利止居，兵蔻不至，民无騷擾。",
      "sourceParagraphSha256": "sha256:8f321a8bcd10643ef1612b22a12b3c2e670cfbb612a378fb8d8bee2d86016872",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:daf2dda99424b855010742a253c68a9e7c850b87dbe4ff0f82dec0ecac7ccd3f"
    },
    {
      "baseHexagramNumber": 47,
      "changedHexagramNumber": 40,
      "sourceEntryNumber": 40,
      "sourceIconHexagramNumber": 40,
      "hexagramName": "解",
      "poemText": "陰淫寒疾，水離其室，舟楫大作，傷害黍稷。民飢於食，不无病厄。",
      "sourceParagraphSha256": "sha256:1bbf0504e0402d6d3a137132770c446fb5b036130e28443fd18506e81bc27387",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:fc56161e27cfe25d017ba36554a7cb13a8307fdde04c76f00a18d824095634d1"
    },
    {
      "baseHexagramNumber": 47,
      "changedHexagramNumber": 41,
      "sourceEntryNumber": 41,
      "sourceIconHexagramNumber": 41,
      "hexagramName": "損",
      "poemText": "離友絕朋，巧言纏匿，覆白污玉，顏叔哀哭。",
      "sourceParagraphSha256": "sha256:1bbe0c954742f9d3d84f3e93cbaf187225c9d3dd5291b956fb21e79b21e68cc0",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:f525e7db6223132e21ecdd70e267ea569f66db9cb31944ff28ea653c3cdb9bd5"
    },
    {
      "baseHexagramNumber": 47,
      "changedHexagramNumber": 42,
      "sourceEntryNumber": 42,
      "sourceIconHexagramNumber": 42,
      "hexagramName": "益",
      "poemText": "童女无媒，不宜動搖，安其室廬，傅母何憂。",
      "sourceParagraphSha256": "sha256:544fd919f4f60fb6fb83f5dadf53d8b9cb923ae176327b72592353b3067a458f",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:6294af8e1cf2e183801c8f4d548e2761ad35a0bed0d9dd624f00dfb6287417bc"
    },
    {
      "baseHexagramNumber": 47,
      "changedHexagramNumber": 43,
      "sourceEntryNumber": 43,
      "sourceIconHexagramNumber": 43,
      "hexagramName": "夬",
      "poemText": "作凶作患，北檄困貧，東與禍連，傷我老根。",
      "sourceParagraphSha256": "sha256:bba4a7f64866b4ee4c6d15eb7d8d76affed41ae768fed6a75b5819b3e7c78cfa",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:49fca2fd742428fefe567fd6a00b880f6deeea51e8c78ed7ac16c23f966b5ccb"
    },
    {
      "baseHexagramNumber": 47,
      "changedHexagramNumber": 44,
      "sourceEntryNumber": 44,
      "sourceIconHexagramNumber": 44,
      "hexagramName": "姤",
      "poemText": "東南其戶，風雨不處，曣晲仁人，父子相保。",
      "sourceParagraphSha256": "sha256:6eb76b551137e737788598ae9af35ed007f451393ae941d6b5aeab0e68adad03",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:c488d699314132a41a72893647a5d1ea0ebb54f54ba6f3521db2ad5f634679e0"
    },
    {
      "baseHexagramNumber": 47,
      "changedHexagramNumber": 45,
      "sourceEntryNumber": 45,
      "sourceIconHexagramNumber": 45,
      "hexagramName": "萃",
      "poemText": "被髮獸心，難與比鄰，來如飄風，去似絕絃，為狼所殘。",
      "sourceParagraphSha256": "sha256:5a51efc0257f67f154860c2dce4ab9d597b930ff30b36a33337402559019b14a",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:96c934fdc816f2156b48b220ba98619fcf43ba6ed181b1107df883f2cb395163"
    },
    {
      "baseHexagramNumber": 47,
      "changedHexagramNumber": 46,
      "sourceEntryNumber": 46,
      "sourceIconHexagramNumber": 46,
      "hexagramName": "升",
      "poemText": "天覆地載，日月運照。陰陽允作，方內四富。",
      "sourceParagraphSha256": "sha256:4d067b075620f7552fcfb117a7323758a78df673442bb89e2a83ab7ae2e52e96",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ebf8100efa83772c3572297b24fc7239d83dd477f6925b3b29f69492e5480ed8"
    },
    {
      "baseHexagramNumber": 47,
      "changedHexagramNumber": 48,
      "sourceEntryNumber": 48,
      "sourceIconHexagramNumber": 48,
      "hexagramName": "井",
      "poemText": "桀亂无道，民散不聚。背室棄家，君孤出走。",
      "sourceParagraphSha256": "sha256:f67f1b987c6c112ed2bcdc97863f83492d906984478793e3a9259a4debf2f443",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:3162a9bf931873e2db9dfefcf33670fec1b293fcd030f7b47b1cad05bd31e204"
    },
    {
      "baseHexagramNumber": 47,
      "changedHexagramNumber": 49,
      "sourceEntryNumber": 49,
      "sourceIconHexagramNumber": 49,
      "hexagramName": "革",
      "poemText": "申酉稷射，陰慝萌作。柯葭載牧，泥塗不白。",
      "sourceParagraphSha256": "sha256:d61ef522405a2c35557173cd18805b0e3d7ea119d7af6aa24d895d477f52950a",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:38ffab974c02e1b36a71b6f3d246e74d7daa9c9f7a1786c553746147576b3625"
    },
    {
      "baseHexagramNumber": 47,
      "changedHexagramNumber": 50,
      "sourceEntryNumber": 50,
      "sourceIconHexagramNumber": 50,
      "hexagramName": "鼎",
      "poemText": "踝踵足傷，右指病瘍。失旅後時，利走不來。",
      "sourceParagraphSha256": "sha256:8fe231438a0538ed8ee725ca4ab497ef34eccce47dcda07302c03060d81a06e4",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:cda389b2e878e6b3f2b2c26b08bc42beb5fa4e859adbb714f2a9d36c205a8ebe"
    },
    {
      "baseHexagramNumber": 47,
      "changedHexagramNumber": 51,
      "sourceEntryNumber": 51,
      "sourceIconHexagramNumber": 51,
      "hexagramName": "震",
      "poemText": "四足俱走，駑疲在後。戰既不勝，敗於東野。",
      "sourceParagraphSha256": "sha256:cff5bcf10b35415b87cffbbf7748882c505786507283026d635851d432d8df3f",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:0dfbdc5e190a082cf28c0c0fbd862e9e327b8db4dc57f0591c0aa02830b4e8fd"
    },
    {
      "baseHexagramNumber": 47,
      "changedHexagramNumber": 52,
      "sourceEntryNumber": 52,
      "sourceIconHexagramNumber": 52,
      "hexagramName": "艮",
      "poemText": "塗行破車，醜女无媒。莫適為耦，孤困獨居。",
      "sourceParagraphSha256": "sha256:7efc175fda484d1c3e5ee4fc6c30e3474c6e446d19f01307a382b206fffc1328",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:0586a92034821aa09609141057e51aff05c7c021ab856364b37d89a0b960bf43"
    },
    {
      "baseHexagramNumber": 47,
      "changedHexagramNumber": 53,
      "sourceEntryNumber": 53,
      "sourceIconHexagramNumber": 53,
      "hexagramName": "漸",
      "poemText": "搏髀大笑，不知憂懼。開立大路，為主所召。",
      "sourceParagraphSha256": "sha256:1ef940ae9f2131d6f4b3a75e5069cd5f7182faf25a091388384c891cc70833b7",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:2cb55e70f499380fa175703d998d8fe1dc6ebbc2a6c9644ffe6e8e0e34c05be6"
    },
    {
      "baseHexagramNumber": 47,
      "changedHexagramNumber": 54,
      "sourceEntryNumber": 54,
      "sourceIconHexagramNumber": 54,
      "hexagramName": "歸妹",
      "poemText": "伯圭東行，與利相逢。出既遭昧，孰不相知，憂不成凶。",
      "sourceParagraphSha256": "sha256:f75b86cf32ba52320831b38d2ff3388e4c86e766ca6c6581cb00943ebdc0a4d0",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:3abde352cdbeaf3c3321460f6de573ab08ac340850d4f2ab8403688f0c77067b"
    },
    {
      "baseHexagramNumber": 47,
      "changedHexagramNumber": 55,
      "sourceEntryNumber": 55,
      "sourceIconHexagramNumber": 55,
      "hexagramName": "豐",
      "poemText": "東行賊家，鄭伯失辭。國无貞良，居受其殃。",
      "sourceParagraphSha256": "sha256:4249eea2940feb1ca7b7f97650017b5f2e236029e16e8dde4cfb4d54c616a2bf",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:533587905200e8320c176959762697aea93825e97bfdb75af8d5ec29fdda1a1b"
    },
    {
      "baseHexagramNumber": 47,
      "changedHexagramNumber": 56,
      "sourceEntryNumber": 56,
      "sourceIconHexagramNumber": 56,
      "hexagramName": "旅",
      "poemText": "前屈後曲，形體飭急。絞黑大索，困於清室。",
      "sourceParagraphSha256": "sha256:87841678d2905370b951dab76a269acad0299afe9adbca8ce8345ef10a89580d",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:060fa18b18a75967fedba90dd33c62e3b6a881c7d605146c2b4d087775365ac1"
    },
    {
      "baseHexagramNumber": 47,
      "changedHexagramNumber": 57,
      "sourceEntryNumber": 57,
      "sourceIconHexagramNumber": 57,
      "hexagramName": "巽",
      "poemText": "鼓腋大喜，行婚飲酒。嘉彼諸姜，樂我皇考。",
      "sourceParagraphSha256": "sha256:b6c9a44e3701a70f644943eb400ac12be198510025f65ada06a4c557e4250062",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:8e2feab94adc8a6914f1d4e53744f9e6635064ad065cdab5d60eace33eb206c9"
    },
    {
      "baseHexagramNumber": 47,
      "changedHexagramNumber": 58,
      "sourceEntryNumber": 58,
      "sourceIconHexagramNumber": 58,
      "hexagramName": "兌",
      "poemText": "國將有事，狐嘈向城。三日悲鳴，邑主大驚。",
      "sourceParagraphSha256": "sha256:8474cba634ad3208825b80f7dd5841ba73907267632d181f1728a9f4f4580736",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:a2140b6f572c2e7af8bec82f6370e0f7b6c25f50c37677cb3f8254774b8fa531"
    },
    {
      "baseHexagramNumber": 47,
      "changedHexagramNumber": 59,
      "sourceEntryNumber": 59,
      "sourceIconHexagramNumber": 59,
      "hexagramName": "渙",
      "poemText": "明德克敏，重華貢舉。放勳徵用，公哲蒙佑。",
      "sourceParagraphSha256": "sha256:34730cdfe7fd86e0be0ddb2fc78486d4e824523ace50687da65af31793681eeb",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:c06ed819ef2257701e0e5617649f7bcf0e370e4b579f7733640385666dba4229"
    },
    {
      "baseHexagramNumber": 47,
      "changedHexagramNumber": 60,
      "sourceEntryNumber": 60,
      "sourceIconHexagramNumber": 60,
      "hexagramName": "節",
      "poemText": "秋隼冬翔，數被嚴霜。甲兵充庭，萬物不生。雄父夜鳴，民大擾驚。",
      "sourceParagraphSha256": "sha256:b7856ed81b7a4d631c1cc4a370be1df37e74d9b674fd090b78ec94418f68aa37",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:2ebd9c021ef3e1a3072893efe14f9f6902b6b4135edf9265ffbf59a9e0cf9e1e"
    },
    {
      "baseHexagramNumber": 47,
      "changedHexagramNumber": 61,
      "sourceEntryNumber": 61,
      "sourceIconHexagramNumber": 61,
      "hexagramName": "中孚",
      "poemText": "絲紵布帛，人所衣服。掺掺女手，紡績善織，南國饒足，取之有息。",
      "sourceParagraphSha256": "sha256:58e0f2141219220c8e211001af6234394e95edcb628c592413e1305d6619e74b",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:6f0d94bb425a8c99bcce6711aec18f465de6cd26197c9fe8a34e839a3428fa9c"
    },
    {
      "baseHexagramNumber": 47,
      "changedHexagramNumber": 62,
      "sourceEntryNumber": 62,
      "sourceIconHexagramNumber": 62,
      "hexagramName": "小過",
      "poemText": "鳳有十子，同巢共母。仁聖在位，懽以相保，興彼周魯。",
      "sourceParagraphSha256": "sha256:f4faed70fcaab4a7cc3395222765c049eac5217a43e337c336720583fb0538fc",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:dd3ddd9dfbef1a7c0b8df244a3a786f91bdc0721a631b4893820d1dc991ee197"
    },
    {
      "baseHexagramNumber": 47,
      "changedHexagramNumber": 63,
      "sourceEntryNumber": 63,
      "sourceIconHexagramNumber": 63,
      "hexagramName": "既濟",
      "poemText": "雄雞不晨，雌雞且伸。志庇心離，三旅出哀。",
      "sourceParagraphSha256": "sha256:d78af891a24b595e881b453748b90c09e1f916c29588f57ff74038a6027a4131",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:00fb28d1190663ca296e0d552c65472c2def0dc4695e18fd48e285f6b1279a94"
    },
    {
      "baseHexagramNumber": 47,
      "changedHexagramNumber": 64,
      "sourceEntryNumber": 64,
      "sourceIconHexagramNumber": 64,
      "hexagramName": "未濟",
      "poemText": "光祀春成，陳寶雞鳴。陽鳥失道，不能自守，消亡無咎。",
      "sourceParagraphSha256": "sha256:64f7c433e4a3cfc0128c152dd66fd978633e8051ca773d82290c84a5f6295a81",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:837d9ec7b0d5b3f3ba6f57873f0e4764696c5ddc803f4a90efbb4cd87a5d3328"
    }
  ]
}
