  "attribution": "來源：《焦氏易林》，易學網《焦氏易林［四庫全書版］》（依據版本：《欽定四庫全書》子部術數類），https://www.eee-learning.com/book/giauii 。依來源要求標示出處及原網頁連結；本站僅整理林辭原文，並記錄收錄、標點及文字整理修改。",
  "entryCount": 64,
  "missingTargets": [],
  "entries": [
    {
      "baseHexagramNumber": 36,
      "changedHexagramNumber": 36,
      "sourceEntryNumber": 36,
      "sourceIconHexagramNumber": 36,
      "hexagramName": "明夷",
      "poemText": "他山之錯，與璆為仇。來攻吾城，傷我肌膚。邦家騷憂。",
      "sourceParagraphSha256": "sha256:8dba935d727e1c0974b940fd4b9a3956701682bb1a286dca62c573371690308a",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:256a02cc70f90c15f5162e1569d0f90f4884efdfba1ee4c380f35a8ae431fb86"
    },
    {
      "baseHexagramNumber": 36,
      "changedHexagramNumber": 1,
      "sourceEntryNumber": 1,
      "sourceIconHexagramNumber": 1,
      "hexagramName": "乾",
      "poemText": "踐履寒冰，十步九尋。惟有苦痛，不為病憂。",
      "sourceParagraphSha256": "sha256:72b05b00cda0b678125715b182a58e6cedab3d7af3876f9c09b257f461aad34c",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:f6bd5ed05d938033acdd9ec118639e5c5066caca74028b02d5f077f53831265b"
    },
    {
      "baseHexagramNumber": 36,
      "changedHexagramNumber": 2,
      "sourceEntryNumber": 2,
      "sourceIconHexagramNumber": 2,
      "hexagramName": "坤",
      "poemText": "太公避紂，七十隱處。卒逢聖文，為王室輔。",
      "sourceParagraphSha256": "sha256:ae543f573fce377f4efdd39f1163d374c2b5cb355e717e0203c88f6f78b70b83",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:4d7689666c1dff684b437461dea2d51e33c478d9b840da2e503dda9c1f9cf9cc"
    },
    {
      "baseHexagramNumber": 36,
      "changedHexagramNumber": 3,
      "sourceEntryNumber": 3,
      "sourceIconHexagramNumber": 3,
      "hexagramName": "屯",
      "poemText": "日月之塗，所行必到，無有患悔。",
      "sourceParagraphSha256": "sha256:89263ae41bb0341313d3e0bbe6118703bbe5f243cbafbf153c0021a41b2edfdb",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ec5445cae99d57ec41105da0aa5680167f7bdda30bf85c3befb221d68ac135d4"
    },
    {
      "baseHexagramNumber": 36,
      "changedHexagramNumber": 4,
      "sourceEntryNumber": 4,
      "sourceIconHexagramNumber": 4,
      "hexagramName": "蒙",
      "poemText": "諷德誦功，美風盛隆。旦輔成周，光濟沖人。",
      "sourceParagraphSha256": "sha256:b944f913280c856db1f76d2f158d5473cd98eda1ade3fd0c12cf618c3fc7392b",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:4029cfd683688b11c241cf8ac38fefddfb6255c0e99a6cf4535885ddd341df03"
    },
    {
      "baseHexagramNumber": 36,
      "changedHexagramNumber": 5,
      "sourceEntryNumber": 5,
      "sourceIconHexagramNumber": 5,
      "hexagramName": "需",
      "poemText": "童子無室，未有配合，空坐獨宿。",
      "sourceParagraphSha256": "sha256:57c3725c4fd2de8aa252b00a5fb877230a8fecf843914d2c623a313cbc45a7b0",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:d013461bf6998430d1ddb07dce36fb8fe3ac6217f8676eb1662610a542d7c468"
    },
    {
      "baseHexagramNumber": 36,
      "changedHexagramNumber": 6,
      "sourceEntryNumber": 6,
      "sourceIconHexagramNumber": 6,
      "hexagramName": "訟",
      "poemText": "穿鼻繫株，為虎所拘。王母祝祠，禍不成災。遂然脫來。",
      "sourceParagraphSha256": "sha256:3029d4af949b23b9a89d91555fe0022e0e0b8d95f61d5abdb29460976fa48b12",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:63a68b7303588d22df117934710fc4818b3abc8b1daa9b7db9b0b43739f3ddb6"
    },
    {
      "baseHexagramNumber": 36,
      "changedHexagramNumber": 7,
      "sourceEntryNumber": 7,
      "sourceIconHexagramNumber": 7,
      "hexagramName": "師",
      "poemText": "黃帝神明，八子聖聰。佚受大福，天下平康。",
      "sourceParagraphSha256": "sha256:f028c2db495609d9df15a04fc3caa766e2a0611bc6990a0a8f498ea4dc1352bd",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:5b715b930de12bfe2baf3f3f4a2d93e972b7e9486dcd86a45038741a3b091317"
    },
    {
      "baseHexagramNumber": 36,
      "changedHexagramNumber": 8,
      "sourceEntryNumber": 8,
      "sourceIconHexagramNumber": 8,
      "hexagramName": "比",
      "poemText": "深谷為陵，衰者復興。亂傾之國，民德安息。中婦病困，遂入冥室。",
      "sourceParagraphSha256": "sha256:c5faf07966bc3327cddf53a570faaa42d70f96d4521aa9a973e412ffcc205d46",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:f7afa0fd41b33d67636e6371915ae9c42fce37ae3eaf6ad8bd2587916cabda1e"
    },
    {
      "baseHexagramNumber": 36,
      "changedHexagramNumber": 9,
      "sourceEntryNumber": 9,
      "sourceIconHexagramNumber": 9,
      "hexagramName": "小畜",
      "poemText": "道遠遼絕，路宿多悔。頑嚚相聚，生我畏忌。",
      "sourceParagraphSha256": "sha256:3dcff82f7209a7610a0e3ce04d11b2c28a3c550220cab6b04eca73dfdf0d6dcc",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:5aea3a477f6fd36a62581eee0ce110decfb7809f14d9dd59b99c15e9722c72c5"
    },
    {
      "baseHexagramNumber": 36,
      "changedHexagramNumber": 10,
      "sourceEntryNumber": 10,
      "sourceIconHexagramNumber": 10,
      "hexagramName": "履",
      "poemText": "旦樹菽豆，暮成藿羹。心之所樂，志快心歡。",
      "sourceParagraphSha256": "sha256:26647fc1e65da6ab75a548eb5a90d0eba4f1fc3810e84ed4cdeabe59d455c64f",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:7857aab2256cfda785119b4b77e7b4dd6c8a7fb55f72ca97cecf9abfbd06c238"
    },
    {
      "baseHexagramNumber": 36,
      "changedHexagramNumber": 11,
      "sourceEntryNumber": 11,
      "sourceIconHexagramNumber": 11,
      "hexagramName": "泰",
      "poemText": "切切之患，凶憂不成。虎不敢囓，利當我身。",
      "sourceParagraphSha256": "sha256:36b81c3fe295d16158553a7bec0aa054fe9cafc63166677b8af0d71c5cf55949",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:708d2d8472baa878e67584af10ac3e65de78ea7d13928ebffe2ad9d8f8465914"
    },
    {
      "baseHexagramNumber": 36,
      "changedHexagramNumber": 12,
      "sourceEntryNumber": 12,
      "sourceIconHexagramNumber": 12,
      "hexagramName": "否",
      "poemText": "王伯遠宿，長婦在室。異庖待食，所求不得。",
      "sourceParagraphSha256": "sha256:9c1e17414e64f112cc3043df81d850517fe4075ddd7bd871b6e5f7793f4db46a",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:d8af3ded2decc65257c747dfa538c893a6fe6e9d25dfc155cbb28b145fbc793e"
    },
    {
      "baseHexagramNumber": 36,
      "changedHexagramNumber": 13,
      "sourceEntryNumber": 13,
      "sourceIconHexagramNumber": 13,
      "hexagramName": "同人",
      "poemText": "寒燠失時，陽旱為災，雖耗無憂。",
      "sourceParagraphSha256": "sha256:c6c28a2b5deb5e9cb1c7d37568aca1f83bb7e419ce554e890337f8cf448386bf",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:48bc6d0092006ec2f847b3ad642ab9b43043ae0d4b6032bc1aac574189951a49"
    },
    {
      "baseHexagramNumber": 36,
      "changedHexagramNumber": 14,
      "sourceEntryNumber": 14,
      "sourceIconHexagramNumber": 14,
      "hexagramName": "大有",
      "poemText": "雖窮復通，履危不凶，得其明功。",
      "sourceParagraphSha256": "sha256:fbcfad075a11d4305a98dd39ef9ccd6dae113afdd26fea7973de4f442cfd0e89",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:3a65a4c358de2181e60b8279fabf8e4c50d5f09508a3cd3ebc2d821820f84ab8"
    },
    {
      "baseHexagramNumber": 36,
      "changedHexagramNumber": 15,
      "sourceEntryNumber": 15,
      "sourceIconHexagramNumber": 15,
      "hexagramName": "謙",
      "poemText": "狼虎所宅，不可以居，為我患憂。",
      "sourceParagraphSha256": "sha256:e4701a2292d944146593fcda447fc4559c972cbdeb91f541304bfab85f76032b",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ff317ef95d6bd001d47242b8a30d59d3fa419fc92a0d332a5b1663fb4f27f4b1"
    },
    {
      "baseHexagramNumber": 36,
      "changedHexagramNumber": 16,
      "sourceEntryNumber": 16,
      "sourceIconHexagramNumber": 16,
      "hexagramName": "豫",
      "poemText": "喋囁處耀，明昧相傳。多言少實，語無成事。",
      "sourceParagraphSha256": "sha256:610098542f1ee8775ff5b35ad0c1c85843325c6b2d92f1cc05fe07adcdf8634e",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:a501199f0b61a4cf69eb62da132b75726325e68e6da2bc588cf796e763d04200"
    },
    {
      "baseHexagramNumber": 36,
      "changedHexagramNumber": 17,
      "sourceEntryNumber": 17,
      "sourceIconHexagramNumber": 17,
      "hexagramName": "隨",
      "poemText": "履冰蹈凌，雖困不窮。播鼓登巖，卒無憂凶。",
      "sourceParagraphSha256": "sha256:3bd4a49dfe3ee33b3efea3b651692c53aeb47abe8303481925cddb6d3e509afc",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:aec81acaf753ab5df57e9c7f05ebb8e98f7dc2f4b2d406211f339bbaf775dc90"
    },
    {
      "baseHexagramNumber": 36,
      "changedHexagramNumber": 18,
      "sourceEntryNumber": 18,
      "sourceIconHexagramNumber": 18,
      "hexagramName": "蠱",
      "poemText": "文墨且墨，禍福相雜。南北失志，東西不得。一云文墨且黑，禍福相雜。",
      "sourceParagraphSha256": "sha256:6cbc865b012f119b91bfa56f78056f2023ea0b8632cabaaeff3d5aa9974017e3",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:4d0587ed24b41dbb3aa15b364a7290bef8361ff468e3881608e59ab1923b8217"
    },
    {
      "baseHexagramNumber": 36,
      "changedHexagramNumber": 19,
      "sourceEntryNumber": 19,
      "sourceIconHexagramNumber": 19,
      "hexagramName": "臨",
      "poemText": "爭訟不已，更相談詢。張季弱口，被髮北走。",
      "sourceParagraphSha256": "sha256:67b8452f1228c2a640f4646a952cc28a110618558e71b50f28f86e0555767313",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:9a5df67c36f8d0753ae53e10212d425cb423c9d3770911361a61144b8fbe59d8"
    },
    {
      "baseHexagramNumber": 36,
      "changedHexagramNumber": 20,
      "sourceEntryNumber": 20,
      "sourceIconHexagramNumber": 20,
      "hexagramName": "觀",
      "poemText": "德積逢時，宜其美才。相明輔聖，拜受福休。長女不嫁，後為大悔。",
      "sourceParagraphSha256": "sha256:f93b60c0612a53feb746c301295fefdc223013c04f17803752f7def2e6ea6878",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:af8ecc3173ffc0bb44152483f4291e69f3363b761a7f4660988a7c69aa57e6f5"
    },
    {
      "baseHexagramNumber": 36,
      "changedHexagramNumber": 21,
      "sourceEntryNumber": 21,
      "sourceIconHexagramNumber": 21,
      "hexagramName": "噬嗑",
      "poemText": "江水沱汜，思附君子。仲氏愛歸，不我肯顧。姪娣恨悔。",
      "sourceParagraphSha256": "sha256:a63a0ef73a3b33d0c87989f251b4ad11b285b4787b1e8fab587192a22db3db6c",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:e1680a7e057012b897b2e6f415b2edebf832dda4f1cc3a75c98de434ee7537d5"
    },
    {
      "baseHexagramNumber": 36,
      "changedHexagramNumber": 22,
      "sourceEntryNumber": 22,
      "sourceIconHexagramNumber": 22,
      "hexagramName": "賁",
      "poemText": "光禮春成，陳室雞鳴。師明失道，不能自守。消亡為咎。",
      "sourceParagraphSha256": "sha256:fe6eadad5eb25aa296ed5a15026c6e4f0a6ff2794c304eed774013ee6c12eb31",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:0810c91b06a8eb5f81e812be286133c33d9160a160dcbae12c0b69cf411cfb40"
    },
    {
      "baseHexagramNumber": 36,
      "changedHexagramNumber": 23,
      "sourceEntryNumber": 23,
      "sourceIconHexagramNumber": 23,
      "hexagramName": "剝",
      "poemText": "驚虎無患，虞為我言，賴得以安。",
      "sourceParagraphSha256": "sha256:ad0e0e1780772d74d8c99e236203e689375c9d6e0ab2761c482429e81669f539",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:11bbd0c5ee699f7e23b7a25059bd05331beac64858c2b506531ba440bf63e84d"
    },
    {
      "baseHexagramNumber": 36,
      "changedHexagramNumber": 24,
      "sourceEntryNumber": 24,
      "sourceIconHexagramNumber": 24,
      "hexagramName": "復",
      "poemText": "偽言妄語，轉為詿誤，不知狼虎。",
      "sourceParagraphSha256": "sha256:7a91bfaa03b54912ea321b5c315cf4533db3d937e168d2814106a30f62d82331",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:51d3dbb30fad536c6cf09ddf3f38c56ce138f764b2e9ec2e75df6cd3ccb1fa4b"
    },
    {
      "baseHexagramNumber": 36,
      "changedHexagramNumber": 25,
      "sourceEntryNumber": 25,
      "sourceIconHexagramNumber": 25,
      "hexagramName": "无妄",
      "poemText": "履 自敵，凶憂來到，痛不死哭。",
      "sourceParagraphSha256": "sha256:2a0893fec240b0fe423408a89d60639d231f38e16d039db08c1ea0530277c856",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:9f5821afab67bdd90dde74bb74e5ea8ad453bfbffec8d9fbc8cc42f7903126b6"
    },
    {
      "baseHexagramNumber": 36,
      "changedHexagramNumber": 26,
      "sourceEntryNumber": 26,
      "sourceIconHexagramNumber": 26,
      "hexagramName": "大畜",
      "poemText": "牽尾不前，逆理失臣，惠朔以奔。",
      "sourceParagraphSha256": "sha256:dbb55357bd254e7cc5d3d0819bc0137fe02d3c28ac6e5c69db64060ab5cce270",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:bfb417d306daf0295e012b1547608a9584dabf32e85e784a77689b77d7100a26"
    },
    {
      "baseHexagramNumber": 36,
      "changedHexagramNumber": 27,
      "sourceEntryNumber": 27,
      "sourceIconHexagramNumber": 27,
      "hexagramName": "頤",
      "poemText": "三狸捕鼠，遮遏我後。死於還城，不得脫走。",
      "sourceParagraphSha256": "sha256:4e36d81de6fafe59ae070a875877c978e364a7391f96e793201e46a7818404aa",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:cb836644a5b1fb60e89493253a9fc6dc9340ae3e13a344a78fbc79cc2e97f15a"
    },
    {
      "baseHexagramNumber": 36,
      "changedHexagramNumber": 28,
      "sourceEntryNumber": 28,
      "sourceIconHexagramNumber": 28,
      "hexagramName": "大過",
      "poemText": "言笑未畢，憂來暴卒。身墨丹索，檻內裝米。",
      "sourceParagraphSha256": "sha256:e4b08f731014b866a2f6c9662635eee2b59a348c41bbdb2fac5d134b8df328fa",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:f9cfd5fb53f3993df03661dbc291197c4c620cdd1548ca165b028534c1adfaec"
    },
    {
      "baseHexagramNumber": 36,
      "changedHexagramNumber": 29,
      "sourceEntryNumber": 29,
      "sourceIconHexagramNumber": 29,
      "hexagramName": "坎",
      "poemText": "陰積不已，雲作淫雨。傷害平陸，民無室屋。",
      "sourceParagraphSha256": "sha256:5119f1bc63e1ebfd27a21557e31497cf59c3312bb0da175441e1ddbe97c8c7f0",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:580b56e6c1a22fb2611e9bce168303a857e8a8be4851b1d9617de10218dd7b34"
    },
    {
      "baseHexagramNumber": 36,
      "changedHexagramNumber": 30,
      "sourceEntryNumber": 30,
      "sourceIconHexagramNumber": 30,
      "hexagramName": "離",
      "poemText": "山林麓藪，非人所處。鳥獸無禮，使我心苦。",
      "sourceParagraphSha256": "sha256:882d8a0c68c9cec2395950df7fa45dc8720f644ff210c206f789725793af43e6",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:b61710330da234b0bab9acdc7c0d90a5422aaaf18e604eb87f6061108e2482c2"
    },
    {
      "baseHexagramNumber": 36,
      "changedHexagramNumber": 31,
      "sourceEntryNumber": 31,
      "sourceIconHexagramNumber": 31,
      "hexagramName": "咸",
      "poemText": "新作初陵，踰陷難登。三駒推車，跌損傷頤。",
      "sourceParagraphSha256": "sha256:3342540586be73f5bb32d4716c8ac618312845332824b4a013e628723cd2339e",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:6ea8076e5bf48a0eb6f9e4b0dfbe1800f3c7279594701eee50939905aa140442"
    },
    {
      "baseHexagramNumber": 36,
      "changedHexagramNumber": 32,
      "sourceEntryNumber": 32,
      "sourceIconHexagramNumber": 32,
      "hexagramName": "恒",
      "poemText": "魂微惙惙，屬纊聽絕。擴然大通，復更生活。",
      "sourceParagraphSha256": "sha256:9811c386c29734477eeb506d7eb08b85c8ccd2dec3c061d20972c3294c95cd59",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ce5ebed8a979d550b19d0258a4821a1afa4795e7d4c50840c9b6bd12188a8c5f"
    },
    {
      "baseHexagramNumber": 36,
      "changedHexagramNumber": 33,
      "sourceEntryNumber": 33,
      "sourceIconHexagramNumber": 33,
      "hexagramName": "遯",
      "poemText": "欒子作殃，伯氏誅傷。州吁奔楚，去其邑鄉。",
      "sourceParagraphSha256": "sha256:60ae6cc8772ea59ad0d373f2787ea7396e01e0d84bfc256065f01966c2b2c653",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:2a3d2bed5331062d9a7034c8d0eb40313472248da226e98646f94f2acef5b8f1"
    },
    {
      "baseHexagramNumber": 36,
      "changedHexagramNumber": 34,
      "sourceEntryNumber": 34,
      "sourceIconHexagramNumber": 34,
      "hexagramName": "大壯",
      "poemText": "驕鹵奇形，造惡作凶。無所能成，還自滅身。",
      "sourceParagraphSha256": "sha256:509848e3d18e2c7c9fa8e410e52a240aa346e3a2e30c41134213442330463ead",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:a9b60042f6fc4301a6016e45b7107a86717fc9d4b12edccf87ae27bcaeab7a16"
    },
    {
      "baseHexagramNumber": 36,
      "changedHexagramNumber": 35,
      "sourceEntryNumber": 35,
      "sourceIconHexagramNumber": 35,
      "hexagramName": "晉",
      "poemText": "陳辭達情，使安不傾。增榮益譽，以成功名。",
      "sourceParagraphSha256": "sha256:2143e68d06e346fad169e29f9425c2c579c0021b1abb6563b0c3bdc4adfb9e66",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:20bd2d0c90e480f8e6fce47418954cdd7e1c72cbd5d9856e289c86c65c78fd55"
    },
    {
      "baseHexagramNumber": 36,
      "changedHexagramNumber": 37,
      "sourceEntryNumber": 37,
      "sourceIconHexagramNumber": 37,
      "hexagramName": "家人",
      "poemText": "三杞無棗，家無積莠。使鳩求婦，頑不我許。",
      "sourceParagraphSha256": "sha256:3eea3ffb0fd77d4dce40e31a438465aa4b6c296c277cb90178d22d890b69ae8f",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:3870b78b6f11e0b40dca29517a73df46f6cf3fe68da43ecca55ca41f5e072c18"
    },
    {
      "baseHexagramNumber": 36,
      "changedHexagramNumber": 38,
      "sourceEntryNumber": 38,
      "sourceIconHexagramNumber": 38,
      "hexagramName": "睽",
      "poemText": "慎禍重患，顏子為尤，乃能安存。牢戶繫羊，乃能受福。",
      "sourceParagraphSha256": "sha256:1b4958d48c6be0aa14e8a7db7b9975e4a1038ed995713b7aeb857e8ede7f9884",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:61419aa23563334c29214ef876fbc8bce077ccf2aeaf41ea6bca7ee83d89c4fd"
    },
    {
      "baseHexagramNumber": 36,
      "changedHexagramNumber": 39,
      "sourceEntryNumber": 39,
      "sourceIconHexagramNumber": 39,
      "hexagramName": "蹇",
      "poemText": "鹿得美草，鳴喚其友。九族和睦，不憂飢乏。",
      "sourceParagraphSha256": "sha256:b9c9070fccf0cae072e00ca12469ca786a684723b11c117acf4fa15cfcf0d718",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:2436acefb1ca9549c276391340a13df70368e5a2dc433ec9681b56ee5b38841b"
    },
    {
      "baseHexagramNumber": 36,
      "changedHexagramNumber": 40,
      "sourceEntryNumber": 40,
      "sourceIconHexagramNumber": 40,
      "hexagramName": "解",
      "poemText": "亡玉失鹿，不知所伏。利以避危，全我生福。甘雨時降，年穀有得。",
      "sourceParagraphSha256": "sha256:4affd8f925af18e6160e61daecbce0f20af907a0e0c16c0484158558e519b138",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:97b03a4bbdd24917b127e7c431d6a88d4a601d0b63103953b157af80e29fde42"
    },
    {
      "baseHexagramNumber": 36,
      "changedHexagramNumber": 41,
      "sourceEntryNumber": 41,
      "sourceIconHexagramNumber": 41,
      "hexagramName": "損",
      "poemText": "逢時積德，身受福慶。",
      "sourceParagraphSha256": "sha256:5ea7387658288b85930a9f49ccc45907ccd7efa7fcd85ad429f7e49279959109",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:904d973adb820192398ed5506ff270ed05e54b8b7b586d02f817284c25d54593"
    },
    {
      "baseHexagramNumber": 36,
      "changedHexagramNumber": 42,
      "sourceEntryNumber": 42,
      "sourceIconHexagramNumber": 42,
      "hexagramName": "益",
      "poemText": "鵠思其雄，欲隨鳳東。順理羽翼，出次日中。須留北邑，復反其室。",
      "sourceParagraphSha256": "sha256:360df1e3e9cf6f184075ec91daad1ccc302a674c21b7659f51a522178738dff1",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:f84aa2a91966cf06aba38ad3307a93b16d486c62739cd9d346ce83eb48d8aacf"
    },
    {
      "baseHexagramNumber": 36,
      "changedHexagramNumber": 43,
      "sourceEntryNumber": 43,
      "sourceIconHexagramNumber": 43,
      "hexagramName": "夬",
      "poemText": "環緒倚鉏，斗升屬口。貧賤所處，心寒悲苦。",
      "sourceParagraphSha256": "sha256:ba7f7bf554ebdbe1f9eeb2e367019b18f38827ddba394911f3fea3136545359f",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:de0e20d0b1b80d4e1b2cba52aef710ce1a537a4ed37f346cdf661d998796e594"
    },
    {
      "baseHexagramNumber": 36,
      "changedHexagramNumber": 44,
      "sourceEntryNumber": 44,
      "sourceIconHexagramNumber": 44,
      "hexagramName": "姤",
      "poemText": "孤獨特處，莫依為輔，心勞志苦。",
      "sourceParagraphSha256": "sha256:edcb4b73fd1011a1366c386acf6e9559c289ae0e3deb9213f8c6ef37eed3d0a8",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:e3161dd82066e6b9c8542d5b87cdb4b07cc2ca66d6dea32e2c63da6cac1633ac"
    },
    {
      "baseHexagramNumber": 36,
      "changedHexagramNumber": 45,
      "sourceEntryNumber": 45,
      "sourceIconHexagramNumber": 45,
      "hexagramName": "萃",
      "poemText": "稷為堯使，西見王母。拜請百福，賜我喜子，長樂富有。",
      "sourceParagraphSha256": "sha256:c2ec06930332065cdcf012274ed98517e4a08d90ba886785e4b04028af434818",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:e005e844d1b9602b0db882b714519b1cb12ef40b2251bb4f32b2e2dabfcde66d"
    },
    {
      "baseHexagramNumber": 36,
      "changedHexagramNumber": 46,
      "sourceEntryNumber": 46,
      "sourceIconHexagramNumber": 46,
      "hexagramName": "升",
      "poemText": "鳴條之災，北奔於胡。左衽為長，國號匈奴。主君旄頭，立為單于。",
      "sourceParagraphSha256": "sha256:294ef6c790ea9958cadb49e833c0011a8d69beaf8dc13676b8f4f6cc2e750aa7",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:4aad6fe3a63a0a267fd5cb7872fafdb60ef4f8314f61ed2118eb7414aa50cc5e"
    },
    {
      "baseHexagramNumber": 36,
      "changedHexagramNumber": 47,
      "sourceEntryNumber": 47,
      "sourceIconHexagramNumber": 47,
      "hexagramName": "困",
      "poemText": "絕而復通，雖危不窮。終得其願，姬姜相從。",
      "sourceParagraphSha256": "sha256:15557dd6e426a5577f544b61632fb846d357c642595f1e5e7ea71c2ef36a6186",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:5154e11105b002e5ed7dc4d9efaf6994c8d694e2cdd9a3e18a888523880ef558"
    },
    {
      "baseHexagramNumber": 36,
      "changedHexagramNumber": 48,
      "sourceEntryNumber": 48,
      "sourceIconHexagramNumber": 48,
      "hexagramName": "井",
      "poemText": "陽并悖狂，拔劍自傷，為身生殃。",
      "sourceParagraphSha256": "sha256:bf9c2a0506963bd44c8e20eb48000042181c2a459267dfd23f81c32e3603da19",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:e215337fa94aacfe9d960d02ce7d0e3036db421592f33363b5f30ae7e03a598f"
    },
    {
      "baseHexagramNumber": 36,
      "changedHexagramNumber": 49,
      "sourceEntryNumber": 49,
      "sourceIconHexagramNumber": 49,
      "hexagramName": "革",
      "poemText": "方圓不同，剛柔異鄉。掘井得石，勞而無功。",
      "sourceParagraphSha256": "sha256:b7e8afbc8eff4d3d90a94c967bc3cf94a48ac3d75cb617de10fb1e91aefc6203",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:1a9c2f84f761c50951cc22d4d2808b15b72f7374876840c617d7c95570682d38"
    },
    {
      "baseHexagramNumber": 36,
      "changedHexagramNumber": 50,
      "sourceEntryNumber": 50,
      "sourceIconHexagramNumber": 50,
      "hexagramName": "鼎",
      "poemText": "乘風駕雨，與鳴鳥俱。動舉千里，見我愛母。",
      "sourceParagraphSha256": "sha256:f92635ac8c71ebde028e18f4e0de19b57f5ccc8bcf6f100174942b7f71bc30ee",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:75cfed6eb34e0a0626c4a7452cc2fab3b4d8f492f85f0b5a0697bef11cd9ad34"
    },
    {
      "baseHexagramNumber": 36,
      "changedHexagramNumber": 51,
      "sourceEntryNumber": 51,
      "sourceIconHexagramNumber": 51,
      "hexagramName": "震",
      "poemText": "三塗五岳，陽城太室。神明所扶，獨無兵革。",
      "sourceParagraphSha256": "sha256:f621dab4e16bd63f0fb929de28ba2f1027fe3f13a7bed79dafdfb8072d4c509b",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:e9623a8b18be288fc679bb49dff363a667d241d2dd47f14ac706198fc19ab259"
    },
    {
      "baseHexagramNumber": 36,
      "changedHexagramNumber": 52,
      "sourceEntryNumber": 52,
      "sourceIconHexagramNumber": 52,
      "hexagramName": "艮",
      "poemText": "鴟鴞娶婦，深目窌身。折腰不媚，與伯相悖。",
      "sourceParagraphSha256": "sha256:cccad292c71db922ff6bfad4c73e9b0fb4a115b5eaf8cbee0a4e8b891e491913",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:a31ab96724a1d316fe3a78241d8a8c663bdc9a977caff8a8c14d54428f01fd19"
    },
    {
      "baseHexagramNumber": 36,
      "changedHexagramNumber": 53,
      "sourceEntryNumber": 53,
      "sourceIconHexagramNumber": 53,
      "hexagramName": "漸",
      "poemText": "轉行軌軌，行近不遠。旦夕入門，與君笑言。",
      "sourceParagraphSha256": "sha256:f83ca1a8ed692839e4d89ec9e2a437cd4e36e609814c3955f2eca8576b17fd02",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ac8d7a62a89bd1b937d2a0cc036a8b24af45b50f460d32057dc38cfba744bc2d"
    },
    {
      "baseHexagramNumber": 36,
      "changedHexagramNumber": 54,
      "sourceEntryNumber": 54,
      "sourceIconHexagramNumber": 54,
      "hexagramName": "歸妹",
      "poemText": "求利難國，迯去我北。復歸其城，不為吾賊。",
      "sourceParagraphSha256": "sha256:c67baa682bbc8064c1da880b2b4087b381b616f89c429ca99207c62644741a67",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:7e686ced0f0b3a33e1e528f1589dc76262093193359442a17a0e95519bc0fbe9"
    },
    {
      "baseHexagramNumber": 36,
      "changedHexagramNumber": 55,
      "sourceEntryNumber": 55,
      "sourceIconHexagramNumber": 55,
      "hexagramName": "豐",
      "poemText": "日月之塗，所行必到。無凶無咎，安寧不殆。",
      "sourceParagraphSha256": "sha256:578d5119b27143abdfad08f6b4e600a3e4a50c60355843e481c264a28f7b35c4",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:9a28fb198c41865fd3af138923d6d9d10f8782ba7bb7096a7e24de6f2a05d5c9"
    },
    {
      "baseHexagramNumber": 36,
      "changedHexagramNumber": 56,
      "sourceEntryNumber": 56,
      "sourceIconHexagramNumber": 56,
      "hexagramName": "旅",
      "poemText": "管叔遇桓，得其願歡。膠日殺糾，振冠無憂。笑喜不莊，空言妄行。",
      "sourceParagraphSha256": "sha256:66b95e3aa0cf24ba69bfee6f1c8c3a87a8c9d75b84e7cc218e3ca891b6959973",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:a35a6444f14d8070be0642a761bb89ac1a870178b6c20289c16ad5317fa1a2c9"
    },
    {
      "baseHexagramNumber": 36,
      "changedHexagramNumber": 57,
      "sourceEntryNumber": 57,
      "sourceIconHexagramNumber": 57,
      "hexagramName": "巽",
      "poemText": "出入蹈踐，動順天時。俯仰有節，禍災不來。",
      "sourceParagraphSha256": "sha256:6a61d2f6ee56374a9a4f218a16d06804be67eb10173670719fc538120961eaac",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:05f8c1703218c48f7b3425217bdffe4a7bd1efb7aec6cf9be26d6f6e7d74f0d2"
    },
    {
      "baseHexagramNumber": 36,
      "changedHexagramNumber": 58,
      "sourceEntryNumber": 58,
      "sourceIconHexagramNumber": 58,
      "hexagramName": "兌",
      "poemText": "內崩中傷，上亂無常。雖有米粟，我不得食。",
      "sourceParagraphSha256": "sha256:b14984f993752463965378277302b07243d72be95742fa29a675b973fc2008f2",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:05d1bfc173fbb7741b80fe06ac551023d780f72814a16da873977291e1c2b5b4"
    },
    {
      "baseHexagramNumber": 36,
      "changedHexagramNumber": 59,
      "sourceEntryNumber": 59,
      "sourceIconHexagramNumber": 59,
      "hexagramName": "渙",
      "poemText": "逐禍除患，道德神仙。過惡萬里，福常在前。身樂以安。",
      "sourceParagraphSha256": "sha256:a950dca97763a580e1de75aa0b8f5db548541c3a36b44d34c6c2fab43a6d8e73",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:f4e46a809f3845716fe4a87ab9c32fa9bb4a27b4f1db78747cbac914aefa6aad"
    },
    {
      "baseHexagramNumber": 36,
      "changedHexagramNumber": 60,
      "sourceEntryNumber": 60,
      "sourceIconHexagramNumber": 60,
      "hexagramName": "節",
      "poemText": "牛驚馬走，上下渾擾。鼓音不絕，項公奔敗。",
      "sourceParagraphSha256": "sha256:1562f63b187fd85513b1e1eab9963723dad4a0f39e2cf5a579640e7e97571595",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:7a27423ae84ada93080c243390fe65f2c5de0330c943d8191b46f7a525d8781e"
    },
    {
      "baseHexagramNumber": 36,
      "changedHexagramNumber": 61,
      "sourceEntryNumber": 61,
      "sourceIconHexagramNumber": 61,
      "hexagramName": "中孚",
      "poemText": "西上九陂，往來留連。心須時日，靈與有德。",
      "sourceParagraphSha256": "sha256:d23d945f5e0d0e338aea9d96a49135218a8b3efbe4453666ef1b54a10baac79a",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:d70baf9ab1ad684fc2857b896d3175d363a0fa4c9067be35a713171a38405730"
    },
    {
      "baseHexagramNumber": 36,
      "changedHexagramNumber": 62,
      "sourceEntryNumber": 62,
      "sourceIconHexagramNumber": 62,
      "hexagramName": "小過",
      "poemText": "虎怒捕羊，猬不能攘。",
      "sourceParagraphSha256": "sha256:127d3e087cec0b55da2236b85ed9cd18469c6ae23eca2a0df85558af47cc62c7",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:37825b3e9118446f7109da1b1b4b669b6e2c858220c1be1f1533a6856e7a5c58"
    },
    {
      "baseHexagramNumber": 36,
      "changedHexagramNumber": 63,
      "sourceEntryNumber": 63,
      "sourceIconHexagramNumber": 63,
      "hexagramName": "既濟",
      "poemText": "湧泉涓涓，南流不絕。卒為江海，將帥襲戰，獲其醜虜。",
      "sourceParagraphSha256": "sha256:a40c1f53c5fcdf40aa5bc98f19209da61c1431bcd359ee81134e54b1149bc6ab",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:85895b787e9b16cb6d3762751e5dcad507265ccdf4547504953d2e74993eefe8"
    },
    {
      "baseHexagramNumber": 36,
      "changedHexagramNumber": 64,
      "sourceEntryNumber": 64,
      "sourceIconHexagramNumber": 64,
      "hexagramName": "未濟",
      "poemText": "桃弓葦戟，除殘去惡，敵人執服。",
      "sourceParagraphSha256": "sha256:0f561d3d4b1c57c009cad895a6fdcb63eca9bd02e8863478d25d99653230eefb",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:f6fc3950baee390306bc2f2c486de88fcf8ea629724f1ea80ac0a9f1d89ce16c"
    }
  ]
}
