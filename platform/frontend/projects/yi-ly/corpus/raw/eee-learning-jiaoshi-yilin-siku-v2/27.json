  "attribution": "來源：《焦氏易林》，易學網《焦氏易林［四庫全書版］》（依據版本：《欽定四庫全書》子部術數類），https://www.eee-learning.com/book/giauii 。依來源要求標示出處及原網頁連結；本站僅整理林辭原文，並記錄收錄、標點及文字整理修改。",
  "entryCount": 64,
  "missingTargets": [],
  "entries": [
    {
      "baseHexagramNumber": 27,
      "changedHexagramNumber": 27,
      "sourceEntryNumber": 27,
      "sourceIconHexagramNumber": 27,
      "hexagramName": "頤",
      "poemText": "家給人足，頌聲並作。四夷賓服，干戈卷閣。",
      "sourceParagraphSha256": "sha256:244822e1958c4d4e86023011bcbdef89b8ae27f1d9ea66b6daeb0a08f1ea76d0",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:5c462b73432bc494c963bcd3ee19078528d15082302aa8c42a4bb3c4f6d8d7d3"
    },
    {
      "baseHexagramNumber": 27,
      "changedHexagramNumber": 1,
      "sourceEntryNumber": 1,
      "sourceIconHexagramNumber": 1,
      "hexagramName": "乾",
      "poemText": "思初道古，哀吟無輔。陽明不制，上失其所。",
      "sourceParagraphSha256": "sha256:907ad453520e9c8d1caaed5e040c6e954e9bd08e835ae4943a0f051417182c91",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:efe1bd2fd2185f99b452f298e3b19f9eb59db7a3758182a7e082ef2625072589"
    },
    {
      "baseHexagramNumber": 27,
      "changedHexagramNumber": 2,
      "sourceEntryNumber": 2,
      "sourceIconHexagramNumber": 2,
      "hexagramName": "坤",
      "poemText": "江淮河海，天之奧府。眾利所聚，可以饒有。樂我君子。",
      "sourceParagraphSha256": "sha256:98cfda47360d051d2974e2edd912c804287701b3548e1daa74f524da814bb5fb",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:6e8a82b3c9d20a4eca554a97bb5c92f7a0a33336d9e432d2f757197ca44f9846"
    },
    {
      "baseHexagramNumber": 27,
      "changedHexagramNumber": 3,
      "sourceEntryNumber": 3,
      "sourceIconHexagramNumber": 3,
      "hexagramName": "屯",
      "poemText": "三雁俱飛，避暑就涼。適與矰遇，為繳所傷。",
      "sourceParagraphSha256": "sha256:f413a1484c6922194fadf4c5a855b34c2d470005ff8b1b6782760f9ce413ded5",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:d0413ce769727f6028c9b64e9fb292c4ac57973ca76ff80e9cb4699767758392"
    },
    {
      "baseHexagramNumber": 27,
      "changedHexagramNumber": 4,
      "sourceEntryNumber": 4,
      "sourceIconHexagramNumber": 4,
      "hexagramName": "蒙",
      "poemText": "秋南春北，隨時休息。處和履中，安無憂凶。",
      "sourceParagraphSha256": "sha256:4bf79ffa2965215e229087d1fa21972600e8edb0d6fd10f454da1124228ce255",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:7831678c0e0d84bd7cbf6ad19d3a7ca41789f868acb4c9612c682f6c71fbd257"
    },
    {
      "baseHexagramNumber": 27,
      "changedHexagramNumber": 5,
      "sourceEntryNumber": 5,
      "sourceIconHexagramNumber": 5,
      "hexagramName": "需",
      "poemText": "履危無患，逃脫獨全。不利出門，傷我左膝。疾病不食，鬼哭其室。",
      "sourceParagraphSha256": "sha256:17f74fbfb1725b81564d7d0ff64557d1e42c16f7e6dc4a0fb356a862ce0b1138",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:84dc8951338cef22ed4647c481ac728311731019f7c5c47ea8e41d42e881397c"
    },
    {
      "baseHexagramNumber": 27,
      "changedHexagramNumber": 6,
      "sourceEntryNumber": 6,
      "sourceIconHexagramNumber": 6,
      "hexagramName": "訟",
      "poemText": "東家凶婦，怨其公姥。毀盤破盆，棄其飯餐。使我困貧。",
      "sourceParagraphSha256": "sha256:d0e3cc3151fe9a6c9e5cb36be44f016da5bda5a9b9713fd7c27c8795aa81e318",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:2e78be2c2ace6e70a059e0f8b399b8b52ce1d68b503e7af5a6d5656cb8579038"
    },
    {
      "baseHexagramNumber": 27,
      "changedHexagramNumber": 7,
      "sourceEntryNumber": 7,
      "sourceIconHexagramNumber": 7,
      "hexagramName": "師",
      "poemText": "泥滓汙辱，棄捐溝瀆。眾所笑哭，終不顯錄。",
      "sourceParagraphSha256": "sha256:81d8474fbc76c1630ddc6d3990efde8f3ffd6c3243927317eff3795ac3ef25dd",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:8046f97802c843f18a40fa0e16dc72450a5ae795f7ffdde2df0c7b3cd4f241f5"
    },
    {
      "baseHexagramNumber": 27,
      "changedHexagramNumber": 8,
      "sourceEntryNumber": 8,
      "sourceIconHexagramNumber": 8,
      "hexagramName": "比",
      "poemText": "旦往暮還，吝與相存，身無患凶。",
      "sourceParagraphSha256": "sha256:57192ae4044e243a210f6ac06bcba5f204af8028b90d08a5f5ced0528108b638",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ac6f8fee3d684e4c6ae4aa560ee1b0583c8ffac86d197135b3484ddf9a9b373c"
    },
    {
      "baseHexagramNumber": 27,
      "changedHexagramNumber": 9,
      "sourceEntryNumber": 9,
      "sourceIconHexagramNumber": 9,
      "hexagramName": "小畜",
      "poemText": "六翮長翼，夜過射國，羿氏無得。",
      "sourceParagraphSha256": "sha256:fdccfc65a9fde2eeafffce54b16b75c7b5047c3b800d2396bf2ef8601bc8b810",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:2f0ca23c56c55d5fee4e1768810e9368785aa9342c27f6bc95e5a7702522bb49"
    },
    {
      "baseHexagramNumber": 27,
      "changedHexagramNumber": 10,
      "sourceEntryNumber": 10,
      "sourceIconHexagramNumber": 10,
      "hexagramName": "履",
      "poemText": "蜂蠆之國，難以止息。嘉媚之士，為王所食。從去其室。",
      "sourceParagraphSha256": "sha256:b8be33774728c5f5a0f6fd64de4a2daaeb348f9c51c9160455a16f02393bcd35",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:7976f4d8b071a2b092a637cdd7f23033c01c1b643bfbf7d0fff51723282a37e7"
    },
    {
      "baseHexagramNumber": 27,
      "changedHexagramNumber": 11,
      "sourceEntryNumber": 11,
      "sourceIconHexagramNumber": 11,
      "hexagramName": "泰",
      "poemText": "被 乘龍，為王道東。過時不返，使我憂聾。",
      "sourceParagraphSha256": "sha256:506cc79f30637ca531cb0b87b6c2a87010bfa01346e58982fedfbedcfb929458",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:43f8ee6270f6e291f510244b0d3f46486780e2c301001682668afd510ebf1cb0"
    },
    {
      "baseHexagramNumber": 27,
      "changedHexagramNumber": 12,
      "sourceEntryNumber": 12,
      "sourceIconHexagramNumber": 12,
      "hexagramName": "否",
      "poemText": "雪梅零墜，心思憒憒。懷憂少愧，亂我魂氣。",
      "sourceParagraphSha256": "sha256:128e0d6f4892cff77e4201547e2707123477975b2754c476cddfae93bd146fa0",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:9610f2d19501cd5a69ea8c26609fdbdb1e832f4a78d491086ffeab52e69b6245"
    },
    {
      "baseHexagramNumber": 27,
      "changedHexagramNumber": 13,
      "sourceEntryNumber": 13,
      "sourceIconHexagramNumber": 13,
      "hexagramName": "同人",
      "poemText": "長女三嫁，進退多態。牝狐作妖，夜行離憂。",
      "sourceParagraphSha256": "sha256:62256723c01b420c601ce879a4efc338377ffae24d1b36056e916c65a9b03ed7",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:b1092406704374f99a0b458ee3070c57c623178a5f604265b3b0b92853a05f82"
    },
    {
      "baseHexagramNumber": 27,
      "changedHexagramNumber": 14,
      "sourceEntryNumber": 14,
      "sourceIconHexagramNumber": 14,
      "hexagramName": "大有",
      "poemText": "轟轟 ，驅東向西。盛盈必毀，高位崩顛。",
      "sourceParagraphSha256": "sha256:054079728fd2005f08830c471ae467a54fda16c9107d08de6b9466547cc295d8",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:33b2dd084c3ba84f730b5af2689daf85178ad37cea49751a471df532edf52711"
    },
    {
      "baseHexagramNumber": 27,
      "changedHexagramNumber": 15,
      "sourceEntryNumber": 15,
      "sourceIconHexagramNumber": 15,
      "hexagramName": "謙",
      "poemText": "乘船涉濟，載水逢火。賴得無患，蒙我全生。",
      "sourceParagraphSha256": "sha256:a937775d24a56d80ba65276140c6d62da0fbe029648cefd39aaa6fed89cbad7a",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:2a5164c19b010a1a4f1b3f52c0b95a017bd90df2be383aea66304f4b08cdf728"
    },
    {
      "baseHexagramNumber": 27,
      "changedHexagramNumber": 16,
      "sourceEntryNumber": 16,
      "sourceIconHexagramNumber": 16,
      "hexagramName": "豫",
      "poemText": "德至之君，政仁且溫。伊呂股肱，國富民安。",
      "sourceParagraphSha256": "sha256:a579bb55f4accc5772047a4661efc593ea537df5ba0f4b53117e341b35b9c460",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:353611f51a853de4b455a9f3c5508ad28296dabc81cd7ac2f6e9ffff2bef1cdd"
    },
    {
      "baseHexagramNumber": 27,
      "changedHexagramNumber": 17,
      "sourceEntryNumber": 17,
      "sourceIconHexagramNumber": 17,
      "hexagramName": "隨",
      "poemText": "生不逢時，困且多憂。無有冬夏，心常悲愁。",
      "sourceParagraphSha256": "sha256:31671af8d34c029161880b5a8c30f66188778f44b1b119c88996f7a24112250d",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:b16f8be480b96a65876654fa90d34709ab421d816ddf6260972dd777324f9848"
    },
    {
      "baseHexagramNumber": 27,
      "changedHexagramNumber": 18,
      "sourceEntryNumber": 18,
      "sourceIconHexagramNumber": 18,
      "hexagramName": "蠱",
      "poemText": "南歷玉山，東入生門。登福上堂，飲萬歲漿。",
      "sourceParagraphSha256": "sha256:ca6a5de2dfec14d99adca48431aad415c16ce4ece9793f9e66bdea7a2f09a122",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:4e6dda15629b1655fbe57e8d48a68ff5c2597add34ac2e76b699c631ac546b77"
    },
    {
      "baseHexagramNumber": 27,
      "changedHexagramNumber": 19,
      "sourceEntryNumber": 19,
      "sourceIconHexagramNumber": 19,
      "hexagramName": "臨",
      "poemText": "大斧斫木，讒人敗國。東關二五，禍及三子。晉人亂危，懷公出走。",
      "sourceParagraphSha256": "sha256:b83d3849997dcccc0ffca2e585da736d4e148d8e312e173ef92e7f645156adaf",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:26cff27a7ad51330982a1652f344d85dc1bdf706810fb55df8025356ab6b973a"
    },
    {
      "baseHexagramNumber": 27,
      "changedHexagramNumber": 20,
      "sourceEntryNumber": 20,
      "sourceIconHexagramNumber": 20,
      "hexagramName": "觀",
      "poemText": "一室百孫，公悅嫗歡。相與笑言，家樂以安。",
      "sourceParagraphSha256": "sha256:629a710ba8206a233f3be495b60e5ee906390340a98aa75a34b7878106cf76c7",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:34d25363c4d8d36d02e2591785fd9d4588f6af26307072a5ffb5b29ca603c040"
    },
    {
      "baseHexagramNumber": 27,
      "changedHexagramNumber": 21,
      "sourceEntryNumber": 21,
      "sourceIconHexagramNumber": 21,
      "hexagramName": "噬嗑",
      "poemText": "隨陽轉行，不失其常。君安於鄉，國無咎殃。",
      "sourceParagraphSha256": "sha256:8b953674c8f8df3d5ad36c9a2147c154fbc5e6c2b3e01af728e766f6aeece96b",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:bc4ba115db7f63481fa534794e8272215380642b9035e3c7d9d3cc62e962da20"
    },
    {
      "baseHexagramNumber": 27,
      "changedHexagramNumber": 22,
      "sourceEntryNumber": 22,
      "sourceIconHexagramNumber": 22,
      "hexagramName": "賁",
      "poemText": "群虎入邑，求索肉食。大人禦守，君不失國。",
      "sourceParagraphSha256": "sha256:3ced61006ae8f2666af653aaf1d89072894f8add854925cb8466a54c6a418e24",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:8e4e80a14316b022e14031b498082ad7a7dbd4ae4a1338b05da280bf16f64fe4"
    },
    {
      "baseHexagramNumber": 27,
      "changedHexagramNumber": 23,
      "sourceEntryNumber": 23,
      "sourceIconHexagramNumber": 23,
      "hexagramName": "剝",
      "poemText": "弱足刖跟，不利出門。商賈無贏，折崩為患。湯火之憂，轉解喜來。",
      "sourceParagraphSha256": "sha256:0798f04b3c59d9e693cccc41e4d371e9f3487b4ad93a5226d3a48128d6f11387",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:b420fa71e1e47eb27de2f83899c18667f13717aba6ca1694d499021430d1f647"
    },
    {
      "baseHexagramNumber": 27,
      "changedHexagramNumber": 24,
      "sourceEntryNumber": 24,
      "sourceIconHexagramNumber": 24,
      "hexagramName": "復",
      "poemText": "夏臺幽戶，文王厄處。鬼侯飲食，岐人悅喜。",
      "sourceParagraphSha256": "sha256:8502763ebc4bc6aa5ec3ff5d4b968f28237420b7125bc402147f635d862932d4",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:152febe120dc23d7bc46a779831e054f73926bf5d655b71bf250e95b3830f162"
    },
    {
      "baseHexagramNumber": 27,
      "changedHexagramNumber": 25,
      "sourceEntryNumber": 25,
      "sourceIconHexagramNumber": 25,
      "hexagramName": "无妄",
      "poemText": "棟撓壤壞，廊屋大敗。宮闕空廓，如冬枯樹。",
      "sourceParagraphSha256": "sha256:cc0150e64ec73cd5778717bec3a78d823ee9f0ab09f2c028a9a11eb8b6018a63",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:8ccc3abc66be49bf58d9376e338c1ae4cac3cd58422ef5b05da75758a5506b7f"
    },
    {
      "baseHexagramNumber": 27,
      "changedHexagramNumber": 26,
      "sourceEntryNumber": 26,
      "sourceIconHexagramNumber": 26,
      "hexagramName": "大畜",
      "poemText": "讒以內安，不利其國。室家大懼，幽囚重閉。疾病多求，罪亂憤憒。",
      "sourceParagraphSha256": "sha256:cb2e577b7cedbea1ccfcff1f58c19c803ceaa3aa146e6cdf226e76161364c4e4",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:b84773edb50629c01f26706faf1afc1e60c6da66ff947dae2591c37160e991b4"
    },
    {
      "baseHexagramNumber": 27,
      "changedHexagramNumber": 28,
      "sourceEntryNumber": 28,
      "sourceIconHexagramNumber": 28,
      "hexagramName": "大過",
      "poemText": "六龍俱怒，戰於陂下。蒼黃不勝，旅人艱苦。",
      "sourceParagraphSha256": "sha256:98342f03cc0b8ad9c1c1b811618d72baedad0a81f9d9fec143a14bec0aa7bf65",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:d0afa8dfdb9697b00f50aed0bd76fe120b88aa883def69a8e51c71f36703971f"
    },
    {
      "baseHexagramNumber": 27,
      "changedHexagramNumber": 29,
      "sourceEntryNumber": 29,
      "sourceIconHexagramNumber": 29,
      "hexagramName": "坎",
      "poemText": "天下雷行，塵起不明。市空無羊，疾人憂凶。三木不喜，脫歸家邦。",
      "sourceParagraphSha256": "sha256:939c0578d58b0ddfbb6b69ae681cd73091a5ead11c8a67f5f8f960ef6b74fac3",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:3fa0b530782e49f6e9dabf099fc7f1c330357fe2626c193726207f3e6718a957"
    },
    {
      "baseHexagramNumber": 27,
      "changedHexagramNumber": 30,
      "sourceEntryNumber": 30,
      "sourceIconHexagramNumber": 30,
      "hexagramName": "離",
      "poemText": "一指食肉，口無所得。染其鼎鼐，舌饞於腹。",
      "sourceParagraphSha256": "sha256:65c26d967ab3e5c9c44765be6c17c357d9196e26b5a144e53a9cf40597b301fb",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:c55cef463687194b2447a553c08b702ea149abc1f4a7e621f73036e89d7811ab"
    },
    {
      "baseHexagramNumber": 27,
      "changedHexagramNumber": 31,
      "sourceEntryNumber": 31,
      "sourceIconHexagramNumber": 31,
      "hexagramName": "咸",
      "poemText": "喜笑不常，失其福慶。口辨言疥，行者畏忌。",
      "sourceParagraphSha256": "sha256:96917c26deb5c576cb07a7b1aa8e4896da33a16f28d1705a029a34c56a9fc707",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:fd8190fec90a6e7d11368617efd4510163176a0d45fff876da1ae6596e287152"
    },
    {
      "baseHexagramNumber": 27,
      "changedHexagramNumber": 32,
      "sourceEntryNumber": 32,
      "sourceIconHexagramNumber": 32,
      "hexagramName": "恒",
      "poemText": "毛生毫背，國樂民富，侯王有德。",
      "sourceParagraphSha256": "sha256:ad320a9e096c0e90caeba46b0c64d76a2eb01609f77399c1c48e1b79e12c7fc8",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:d59db5240fe0f1e3478f2d2ee50b53fbaab16947236076848c69f277e37d33c4"
    },
    {
      "baseHexagramNumber": 27,
      "changedHexagramNumber": 33,
      "sourceEntryNumber": 33,
      "sourceIconHexagramNumber": 33,
      "hexagramName": "遯",
      "poemText": "豶豕童牛，害傷不來。三光同堂，生我福仁。",
      "sourceParagraphSha256": "sha256:a1165925cffa9ae6bb4158540f1f01cc0b8a51ea55c202bc2546357961f785a1",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:0e00e4b2c25b6072d0cb2dd95a31195e5eba13033539fa7fff7ac83ff946d3ef"
    },
    {
      "baseHexagramNumber": 27,
      "changedHexagramNumber": 34,
      "sourceEntryNumber": 34,
      "sourceIconHexagramNumber": 34,
      "hexagramName": "大壯",
      "poemText": "江河淮濟，盈溢為害。邑被其癩，年困無歲。",
      "sourceParagraphSha256": "sha256:72c5ead42e4733ae995e3dc3d4c39f18e6a1d3901dafab2912c884cb4a52db49",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:e0357ce66ec382b1f262143c0bd66210ce7882b5d85832bf215b68283e1aeb8d"
    },
    {
      "baseHexagramNumber": 27,
      "changedHexagramNumber": 35,
      "sourceEntryNumber": 35,
      "sourceIconHexagramNumber": 35,
      "hexagramName": "晉",
      "poemText": "兩虎爭鬥，股瘡無處。不成仇讎，行解卻去。",
      "sourceParagraphSha256": "sha256:a504eb7508619f2dd8bfd3f21eca0001a37a789efab3e852dff224b8fb44fdb4",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:72e81f6b5aa456e5a0bb50d8210e9c1b189344ca4c31f486732308765b3a0d4d"
    },
    {
      "baseHexagramNumber": 27,
      "changedHexagramNumber": 36,
      "sourceEntryNumber": 36,
      "sourceIconHexagramNumber": 36,
      "hexagramName": "明夷",
      "poemText": "五嶽四瀆，潤洽為德。行不失理，民賴恩福。",
      "sourceParagraphSha256": "sha256:d5e188755b854040dd0d80bb9b9d294fb2809c05f594c80c0399856ffde98ccb",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:5fec51a7616276addba3da7a3d2cb0a38dcfb665adbc16e936be6c5dd2e218bc"
    },
    {
      "baseHexagramNumber": 27,
      "changedHexagramNumber": 37,
      "sourceEntryNumber": 37,
      "sourceIconHexagramNumber": 37,
      "hexagramName": "家人",
      "poemText": "載車乘馬，南逄君子。與我嘉福，離憂無咎。",
      "sourceParagraphSha256": "sha256:ab091de4d2156bb575ffdca7c346f507ecb3c1bba92dc20b2c89bd2533e7b91a",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:172bc78c7f10079dfedc86c5adff30d8c5c664d8eabfae9f9e7c30310deda06a"
    },
    {
      "baseHexagramNumber": 27,
      "changedHexagramNumber": 38,
      "sourceEntryNumber": 38,
      "sourceIconHexagramNumber": 38,
      "hexagramName": "睽",
      "poemText": "缺囊破筐，空無黍粱。不媚始公，棄於糞場。",
      "sourceParagraphSha256": "sha256:b12a7e13dfe570e24eb02ba7daaca8eb45118534811f880176bd79e4b299242e",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:ec0f5a698b28a8981cc7bde5791ad0aba18ec3ba101de8659037aa46f8203304"
    },
    {
      "baseHexagramNumber": 27,
      "changedHexagramNumber": 39,
      "sourceEntryNumber": 39,
      "sourceIconHexagramNumber": 39,
      "hexagramName": "蹇",
      "poemText": "殺行桃園，見虎東還。螳螂之敵，使我無患。",
      "sourceParagraphSha256": "sha256:9d9fe0193088a2ab9f472b6e4c131681a2a9d20a11d418fa37d4aba6c9e8d31f",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:4319897f92ed34b885a8ef800e4a4f667a43586fd2db378128beb7af55f7ca7d"
    },
    {
      "baseHexagramNumber": 27,
      "changedHexagramNumber": 40,
      "sourceEntryNumber": 40,
      "sourceIconHexagramNumber": 40,
      "hexagramName": "解",
      "poemText": "箕仁入室，政衰弊極。抱其彝器，奔於他國。因禍受福。",
      "sourceParagraphSha256": "sha256:2cccd39c5a4f3447e494e2aea9fcaec35272df8e33d89bf5653a70782c71595d",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:3343d25421dcf43a84ea0411451f44fe264326929b7a8f8ab5f22177845646d1"
    },
    {
      "baseHexagramNumber": 27,
      "changedHexagramNumber": 41,
      "sourceEntryNumber": 41,
      "sourceIconHexagramNumber": 41,
      "hexagramName": "損",
      "poemText": "庭燎夜明，追古傷今。陽弱不制，陰雄坐戾。",
      "sourceParagraphSha256": "sha256:b4ae8e560bcfc342f4e26feab33efea7adfbdb820c519d3d3f5273b4245c2cc5",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:8d782c0bad592818f01dde94ed4a0bee51c1f7ee333a9ea6ccd2624de66af2c7"
    },
    {
      "baseHexagramNumber": 27,
      "changedHexagramNumber": 42,
      "sourceEntryNumber": 42,
      "sourceIconHexagramNumber": 42,
      "hexagramName": "益",
      "poemText": "懸貆素餐，食非其任。失輿剝廬，休坐徙居。",
      "sourceParagraphSha256": "sha256:ed7d07da20ac1a2597f9d3ba8e00d13c06b6012939dd3d316683ffe2c332e740",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:68a25e913ea084a9284521e32eb3988eceb4000f3f2a83513640b519b9cde8a5"
    },
    {
      "baseHexagramNumber": 27,
      "changedHexagramNumber": 43,
      "sourceEntryNumber": 43,
      "sourceIconHexagramNumber": 43,
      "hexagramName": "夬",
      "poemText": "嘉聞福喜，繒帛盛織，日就為得。",
      "sourceParagraphSha256": "sha256:0f69cec73d1870b5f97a0bdf0ade74c7c27c664841ce0996d5fa24ade1452897",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:f97ad7a78acdd2d13c8bac1095f5f343a6a303b6a910d1c05102b5904559ddf4"
    },
    {
      "baseHexagramNumber": 27,
      "changedHexagramNumber": 44,
      "sourceEntryNumber": 44,
      "sourceIconHexagramNumber": 44,
      "hexagramName": "姤",
      "poemText": "執綏登車，驂乘東遊。說齊解燕，霸國以安。",
      "sourceParagraphSha256": "sha256:2446e6a0c70b7e728aa4eada4d6e82da23e1bc2b2daf52da18ad48490726a60e",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:d9f61f9d51536fcf41983adf1f64ca7e621b1b9a98189c198dfe23f3f5e16cd9"
    },
    {
      "baseHexagramNumber": 27,
      "changedHexagramNumber": 45,
      "sourceEntryNumber": 45,
      "sourceIconHexagramNumber": 45,
      "hexagramName": "萃",
      "poemText": "水深無桴，蹇難何游。商伯失利，庶人愁憂。",
      "sourceParagraphSha256": "sha256:7da885885197c49446ed849b7c1dcb865bea90d92dd6b20c825229b1ce7c40c5",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:917fedcca542d8e3f474a7232aa20229a3898c127fa3bcb8c4370de4f416fc46"
    },
    {
      "baseHexagramNumber": 27,
      "changedHexagramNumber": 46,
      "sourceEntryNumber": 46,
      "sourceIconHexagramNumber": 46,
      "hexagramName": "升",
      "poemText": "三鳥鴛鴦，相隨俱行。南到饒澤，食魚與粱。君子長樂，見惡不傷。",
      "sourceParagraphSha256": "sha256:1dbb6be48febfc7c0b858ef91afface19cff56a879d964ca2dec812b797b9d4f",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:d64136c787182a63b89e9b819fbb9b5a21e21f537ece00b966d83a25e0ed1c85"
    },
    {
      "baseHexagramNumber": 27,
      "changedHexagramNumber": 47,
      "sourceEntryNumber": 47,
      "sourceIconHexagramNumber": 47,
      "hexagramName": "困",
      "poemText": "遠視目盻，臨深苦眩。不離越都，旅人留難。",
      "sourceParagraphSha256": "sha256:80bcf6609d2b81522e169d89fc59ff45de79f6919c470d1b16b0de3d0a96b781",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:05eeaae1e629edf96a6a9d19edd7bfd3d7c49503d718221dd566a685fad32e1d"
    },
    {
      "baseHexagramNumber": 27,
      "changedHexagramNumber": 48,
      "sourceEntryNumber": 48,
      "sourceIconHexagramNumber": 48,
      "hexagramName": "井",
      "poemText": "終風東西，渙散四方。終日至暮，不見子懽。",
      "sourceParagraphSha256": "sha256:1dec6cdd877b068065fa44373df1b0e119fa7f212a69ce377117735e74637c44",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:fa907c9913e101c9f075adbfc2f66a08a11995e308ce0ad5e07e15f2bdb174d2"
    },
    {
      "baseHexagramNumber": 27,
      "changedHexagramNumber": 49,
      "sourceEntryNumber": 49,
      "sourceIconHexagramNumber": 49,
      "hexagramName": "革",
      "poemText": "言無要約，不成券契。殷叔季姬，公孫爭之。彊入委命，不悅我心。",
      "sourceParagraphSha256": "sha256:9f22cf581837ead6805356587274af79ca4e9aec80b281fc4cb1be10a4da264b",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:8da55eb258553da7b22200465e50e8138220ff26ee48241d308b09a22c3b5f4c"
    },
    {
      "baseHexagramNumber": 27,
      "changedHexagramNumber": 50,
      "sourceEntryNumber": 50,
      "sourceIconHexagramNumber": 50,
      "hexagramName": "鼎",
      "poemText": "牛馬聾聵，不知聲味。遠賢賤仁，自令亂憒。疾病無患，生福在門。",
      "sourceParagraphSha256": "sha256:90b071e536125a66a031f631c6e03e60832e2a6dffcd1fe5bde3b20adbef57b3",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:f5b48640396feadc02414570868d0c5edecb8ebbfac40ef16293797125f20ee5"
    },
    {
      "baseHexagramNumber": 27,
      "changedHexagramNumber": 51,
      "sourceEntryNumber": 51,
      "sourceIconHexagramNumber": 51,
      "hexagramName": "震",
      "poemText": "從商近遊，食飽無憂。囹圄之困，中子見囚。",
      "sourceParagraphSha256": "sha256:358cec341eab159f656020ad0acde4f0bdbac6ea83e7bb33fa35ec0e89866a5f",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:dd206b374f752b9bf485605f3b298d837b092c0a7629587096d81dd1022bb16b"
    },
    {
      "baseHexagramNumber": 27,
      "changedHexagramNumber": 52,
      "sourceEntryNumber": 52,
      "sourceIconHexagramNumber": 52,
      "hexagramName": "艮",
      "poemText": "据斗運樞，順天無憂，與樂並居。",
      "sourceParagraphSha256": "sha256:ec7f8277b4f7f1ab2852f47a0ba1c6c06707ea8fc837c70ae0f049edccb7f28c",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:72337707ac5ade82391576c0d497440de9eec9deac559bb4614c6f4d09ac856e"
    },
    {
      "baseHexagramNumber": 27,
      "changedHexagramNumber": 53,
      "sourceEntryNumber": 53,
      "sourceIconHexagramNumber": 53,
      "hexagramName": "漸",
      "poemText": "姬奭姜望，為武守邦。藩屏燕齊，周室以彊。子孫億昌。",
      "sourceParagraphSha256": "sha256:39c9b329d28b66cf220caa05090aab6537c3ed5a2865f5fc55fdc7fa30c2a503",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:90f7c23cfbd3acf20ce23e3c899133ab4539fe2d7d5a1adeb743ff76a84c0cef"
    },
    {
      "baseHexagramNumber": 27,
      "changedHexagramNumber": 54,
      "sourceEntryNumber": 54,
      "sourceIconHexagramNumber": 54,
      "hexagramName": "歸妹",
      "poemText": "亡羊東澤，循隄直北。子思其母，隨返其所。",
      "sourceParagraphSha256": "sha256:8434d1f714b71bc0e02ad319bafd98498273d4077f52fb405d612ce1bd696010",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:933828b11660422a084b1217c303c5967238afa1b45584af5abee233baee2444"
    },
    {
      "baseHexagramNumber": 27,
      "changedHexagramNumber": 55,
      "sourceEntryNumber": 55,
      "sourceIconHexagramNumber": 55,
      "hexagramName": "豐",
      "poemText": "張鳥開口，舌直距齒。然諾不行，政亂無緒。",
      "sourceParagraphSha256": "sha256:a0cceaa077a8f50904e9cd20d97f27054fb0dd024f44dc93dbcdc8fe89489649",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:7912a0496513bbb34462f25789d9a64767f05acdfccdcc496811852dfe5be662"
    },
    {
      "baseHexagramNumber": 27,
      "changedHexagramNumber": 56,
      "sourceEntryNumber": 56,
      "sourceIconHexagramNumber": 56,
      "hexagramName": "旅",
      "poemText": "載船逢火，憂不為禍。家在山東，入門見公。",
      "sourceParagraphSha256": "sha256:f33c48d32e7320426ee050d2cc61df749905b062079a2fe92aeb4398514dcc7e",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:c87bbc0c41d597dcc894e5bb7d22b9cdb23a0aa85dd9ce9e4674fba853046e90"
    },
    {
      "baseHexagramNumber": 27,
      "changedHexagramNumber": 57,
      "sourceEntryNumber": 57,
      "sourceIconHexagramNumber": 57,
      "hexagramName": "巽",
      "poemText": "絕國異路，心不相慕。蛇子兩角，使我相惡。",
      "sourceParagraphSha256": "sha256:bec56010cc9a8ad56299ac92472db08f98549151f1bd1f94e8c905ccd31e9f4a",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:5f963cdaa67272fe27f35af4f2a4f9199ddbc73506ab271252a16a20e57f6543"
    },
    {
      "baseHexagramNumber": 27,
      "changedHexagramNumber": 58,
      "sourceEntryNumber": 58,
      "sourceIconHexagramNumber": 58,
      "hexagramName": "兌",
      "poemText": "鼻項移徙，居不安坐。枯竹後生，失其寵榮。",
      "sourceParagraphSha256": "sha256:2ebc902b704b467f148dbb9eafb259ce1abd9be3beac6588237af678ec6590e2",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:8834075ed90dc445a406a17f3a6b34312a9e4f25e02d04094254092c7e67a975"
    },
    {
      "baseHexagramNumber": 27,
      "changedHexagramNumber": 59,
      "sourceEntryNumber": 59,
      "sourceIconHexagramNumber": 59,
      "hexagramName": "渙",
      "poemText": "火息無光，千歲不長，殷湯遠明。",
      "sourceParagraphSha256": "sha256:51e679b47a7e793a1677afaea675a7d119695a1709bc0954758eb9d6d5d4b414",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:09313bde104088ffc6fbc3bd4d89d9bbf48713148e8074d3edbaa6e8106d434e"
    },
    {
      "baseHexagramNumber": 27,
      "changedHexagramNumber": 60,
      "sourceEntryNumber": 60,
      "sourceIconHexagramNumber": 60,
      "hexagramName": "節",
      "poemText": "文王四乳，仁孝篤厚。子蓄十男，無有折夭。",
      "sourceParagraphSha256": "sha256:bb1b1dc0ee074a42d697e5542cd5a31ea3d3e250cb01cb8bfb0cf687da895997",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:3817eb0a0f7001a7059800f7013ec8ccef40a3b6edf75379576187cdf1911f9b"
    },
    {
      "baseHexagramNumber": 27,
      "changedHexagramNumber": 61,
      "sourceEntryNumber": 61,
      "sourceIconHexagramNumber": 61,
      "hexagramName": "中孚",
      "poemText": "熊羆豺狼，在山陰陽。伺鹿取麞，道伏畏難。",
      "sourceParagraphSha256": "sha256:acffa6f92abf274ed990af50731de03bc9b54fe8d7029eab4f762f2b14dcf9d2",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:258c27d6cd62e446c820654bf0cdd74cd2f5957c8a13353b48e9b7215c6b459e"
    },
    {
      "baseHexagramNumber": 27,
      "changedHexagramNumber": 62,
      "sourceEntryNumber": 62,
      "sourceIconHexagramNumber": 62,
      "hexagramName": "小過",
      "poemText": "彫葉被霜，獨蔽不傷。駕入喜門，與福為婚。",
      "sourceParagraphSha256": "sha256:b3da19c2ba9e4c2f2140a566c686744a66721a7e8a4121c0bded50e3c3fdfb47",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:678ae459a097bade0b794fa52c69c9dbc7a0bfe07159a24aa148d5e76d19f66f"
    },
    {
      "baseHexagramNumber": 27,
      "changedHexagramNumber": 63,
      "sourceEntryNumber": 63,
      "sourceIconHexagramNumber": 63,
      "hexagramName": "既濟",
      "poemText": "黃離白日，照我四國。元首昭明，民賴為福。一下有漢有游女，人不可得。",
      "sourceParagraphSha256": "sha256:71b415f1c65012f2a18f4d157856ac14330ef2dfabeb7db134c31285f88c3c53",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:1e9d58c38b03121ad3862a1795708e72b840c5e3dc73c31d3f005c3c1bee4700"
    },
    {
      "baseHexagramNumber": 27,
      "changedHexagramNumber": 64,
      "sourceEntryNumber": 64,
      "sourceIconHexagramNumber": 64,
      "hexagramName": "未濟",
      "poemText": "順風直北，與歡相得。歲熟年豐，邑無寇賊。一下有長女行嫁，子孫不昌，棄疾為殃。",
      "sourceParagraphSha256": "sha256:3d4c20b5f478c4256fa43a76923ed75935e79127a43f6fa6dbd49bc49a977b6d",
      "sourceLabelIconMismatch": false,
      "textSha256": "sha256:8135a8b891c355be1dc1ea67c2c4d5d025aa47170f31c95fd4cd912d06746ad4"
    }
  ]
}
