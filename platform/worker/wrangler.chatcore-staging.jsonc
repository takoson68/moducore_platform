{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "chatcore-staging",
  "main": "src/private-chat-lab.js",
  "compatibility_date": "2026-10-19",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": ".assets/chatcore-staging",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/ws/private-chat-lab"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "PRIVATE_CHAT_LAB", "class_name": "PrivateChatLabRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PrivateChatLabRoom"] }
  ]
}
