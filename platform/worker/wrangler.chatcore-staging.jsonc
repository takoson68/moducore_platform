{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "chatcore-staging",
  "main": "src/private-chat-lab.js",
  "compatibility_date": "2026-10-19",
  "workers_dev": true,
  "vars": {
    "CHATCORE_MEMBER_USERNAMES": "admin1,admin2,admin3"
  },
  "services": [
    { "binding": "AUTH_SERVICE", "service": "dinecore-staging" }
  ],
  "preview_urls": false,
  "assets": {
    "directory": ".assets/chatcore-staging",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/ws/private-chat-lab", "/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "PRIVATE_CHAT_LAB", "class_name": "PrivateChatLabRoom" },
      { "name": "CHATCORE_AUTH", "class_name": "ChatCoreAuth" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PrivateChatLabRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["ChatCoreAuth"] }
  ]
}
