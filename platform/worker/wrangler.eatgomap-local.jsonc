{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "eatgomap-local-api",
  "main": "src/index.js",
  "compatibility_date": "2026-10-19",
  "workers_dev": false,
  "vars": { "PROJECT_ID": "eatGoMap", "SERVICE_NAME": "eatgomap-local-api" },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "eatgomap-local-db",
    "database_id": "00000000-0000-4000-8000-000000000001",
    "migrations_dir": "migrations/eatgomap"
  }]
}
