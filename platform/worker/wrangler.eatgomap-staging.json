{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "eatgomap-staging",
  "main": "src/index.js",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "vars": { "PROJECT_ID": "eatGoMap", "SERVICE_NAME": "eatgomap-staging" },
  "assets": {
    "directory": ".assets/eatgomap-staging",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "eatgomap-staging-db",
    "database_id": "2ee1ccf9-2f66-4a80-ada5-64a3c0fc78ae",
    "migrations_dir": "migrations/eatgomap"
  }]
}
