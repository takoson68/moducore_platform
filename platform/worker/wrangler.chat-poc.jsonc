{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "moducore-chat-poc-staging",
  "main": "src/chat-poc.js",
  "compatibility_date": "2026-10-21",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "PROJECT_ID": "magic-siege",
    "CHAT_NAMESPACE_VERSION": "2",
    "AUTH_ORIGIN": "https://dinecore-staging.takoson68.workers.dev",
    "AUTH_PROJECT_ID": "dineCore"
  },
  "services": [
    { "binding": "AUTH_SERVICE", "service": "dinecore-staging" }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PUBLIC_CHAT",
        "class_name": "PublicChat"
      },
      {
        "name": "CHAT_DIRECTORY",
        "class_name": "ChatDirectory"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PublicChat"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["ChatDirectory"]
    }
  ]
}
